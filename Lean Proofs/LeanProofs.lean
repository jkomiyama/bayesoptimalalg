noncomputable section

theorem nonterminal_hinge_gain_lower (T q t n : ℕ) (CU : ℝ)
    (p : MeanPath) (c : Counts)
    (hT : T = 2 * q + 1) (ht : 4 ≤ t) (hpre : t < T)
    (hc : horizonConsistent t c) (hW : newW T q CU p c)
    (hn : 1 ≤ n) (hnT : n < T) :
    (gainConstant * lowerConstant) * invPower 176 T ≤
      ∫ x : ℝ, hingeLoss |x| (updateVariance (n : ℝ≥0))
        ∂balancedPredictiveLaw (T - t) c (terminalGap p c) := by
  have h5 : 5 ≤ T := by omega
  have hmass := new_lemma18_fixed_tie170 T q t CU p c hT ht hpre hc hW
  rw [balancedPredictiveLaw_gaussian] at hmass ⊢
  have hband := BayesOptimal.Foundations.DynamicGain.gaussian_integral_band_lower
    (absolute_hinge_gaussian_integrable (terminalGap p c) (accumulatedVariance (T - t) c)
      (updateVariance (n : NNReal)))
    (fun x => hingeLoss_nonnegative |x| _) (r := 6)
    (fun x hx => by
      have hx0 : 0 ≤ x := (invPower_nonneg 2 T).trans hx.1
      have hsmall : |x| ≤ 2 * invPower 2 T := by rw [abs_of_nonneg hx0]; exact hx.2
      have hg := lemma14_sample_count_lower T n x 0 h5 hn hnT hsmall
      rw [oneStepImprovement_eq_hinge] at hg
      exact hg)
  have hp := mul_le_mul_of_nonneg_left hmass
    (mul_nonneg gainConstant_positive.le (invPower_nonneg 6 T))
  have he : (gainConstant * invPower 6 T) * (lowerConstant * invPower 170 T) =
      (gainConstant * lowerConstant) * invPower 176 T := by
    rw [← invPower_product 6 170 T]; ring
  rw [he] at hp
  exact hp.trans hband

theorem nonterminal_hinge_difference_lower (T q t ni nj : ℕ) (CU : ℝ)
    (p : MeanPath) (c : Counts)
    (hT : T = 2 * q + 1) (ht : 4 ≤ t) (hpre : t < T)
    (hc : horizonConsistent t c) (hW : newW T q CU p c)
    (hj : 1 ≤ nj) (hstrict : nj < ni) (hiT : ni < T) :
    (comparisonConstant * lowerConstant) * invPower 178 T ≤
      ∫ x : ℝ, (hingeLoss |x| (updateVariance (nj : ℝ≥0)) -
        hingeLoss |x| (updateVariance (ni : ℝ≥0)))
        ∂balancedPredictiveLaw (T - t) c (terminalGap p c) := by
  have h5 : 5 ≤ T := by omega
  have hip : 0 < (ni : ℝ≥0) := by exact_mod_cast (show 0 < ni by omega)
  have hjp : 0 < (nj : ℝ≥0) := by exact_mod_cast (show 0 < nj by omega)
  have hv := updateVariance_strictAntitone (nj : ℝ≥0) (ni : ℝ≥0) hjp
    (by exact_mod_cast hstrict)
  have hi : Integrable (fun x : ℝ => hingeLoss |x| (updateVariance (nj : ℝ≥0)) -
      hingeLoss |x| (updateVariance (ni : ℝ≥0)))
      (balancedPredictiveLaw (T - t) c (terminalGap p c)) := by
    rw [balancedPredictiveLaw_gaussian]
    exact (absolute_hinge_gaussian_integrable _ _ _).sub
      (absolute_hinge_gaussian_integrable _ _ _)
  have hmass := new_lemma18_fixed_tie170 T q t CU p c hT ht hpre hc hW
  rw [balancedPredictiveLaw_gaussian] at hmass ⊢
  rw [balancedPredictiveLaw_gaussian] at hi
  have hband := BayesOptimal.Foundations.DynamicGain.gaussian_integral_band_lower hi
    (fun x => sub_nonneg.mpr (hingeLoss_strictMono_variance |x| (abs_nonneg _) _ _ hv).le)
    (r := 8) (fun x hx => by
      have hx0 : 0 ≤ x := (invPower_nonneg 2 T).trans hx.1
      have hsmall : |x| ≤ 2 * invPower 2 T := by rw [abs_of_nonneg hx0]; exact hx.2
      have hg := lemma15_terminal_action_gap_conservative T ni nj x h5 hj hstrict hiT hsmall
      rw [terminal_actionLoss_difference_eq x (ni : NNReal) (nj : NNReal) hjp hip] at hg
      exact hg)
  have hp := mul_le_mul_of_nonneg_left hmass
    (mul_nonneg comparisonConstant_positive.le (invPower_nonneg 8 T))
  have he : (comparisonConstant * invPower 8 T) * (lowerConstant * invPower 170 T) =
      (comparisonConstant * lowerConstant) * invPower 178 T := by
    rw [← invPower_product 8 170 T]; ring
  rw [he] at hp
  exact hp.trans hband

theorem preterminal_variance (q k : ℕ) (c : Counts) (hq : 0 < q)
    (hcap1 : c.n1 ≤ q) (hcap2 : c.n2 ≤ q)
    (hs : c.n1 + c.n2 + k = 2 * q - 1) :
    BayesOptimal.Foundations.TwoArmBellman.variance (balancedRun k c) = posteriorVariance (q : ℝ≥0) ((q - 1 : ℕ) : ℝ≥0) := by
  have hf := equation22_terminal_counts q k c hq hcap1 hcap2 hs
  unfold BayesOptimal.Foundations.TwoArmBellman.variance
  by_cases h : c.n2 = q
  · simp only [if_pos h] at hf
    rw [hf.1, hf.2, posteriorVariance_comm]
  · simp only [if_neg h] at hf
    rw [hf.1, hf.2]

theorem forced_left_final_counts (q k : ℕ) (c : Counts) (hq : 0 < q)
    (hcap1 : c.n1 ≤ q) (hcap2 : c.n2 ≤ q)
    (hs : c.n1 + c.n2 + k = 2 * q - 1) :
    ((balancedRun k (leftStep c)).n1 = if c.n1 = q then q + 1 else q) ∧
    ((balancedRun k (leftStep c)).n2 = if c.n1 = q then q - 1 else q) := by
  by_cases h : c.n1 = q
  · have hr : (leftStep c).n2 + k ≤ (leftStep c).n1 := by simp only [leftStep]; omega
    rw [balancedRun_right_only k (leftStep c) hr]
    simp only [leftStep, if_pos h]
    constructor <;> omega
  · have h1 : (leftStep c).n1 ≤ q := by simp only [leftStep]; omega
    have h2 : (leftStep c).n2 ≤ q := hcap2
    have hsum : (leftStep c).n1 + (leftStep c).n2 + k = 2 * q := by simp only [leftStep]; omega
    simpa only [if_neg h] using balancedRun_final_counts q k (leftStep c) h1 h2 hsum

theorem forced_right_final_counts (q k : ℕ) (c : Counts) (hq : 0 < q)
    (hcap1 : c.n1 ≤ q) (hcap2 : c.n2 ≤ q)
    (hs : c.n1 + c.n2 + k = 2 * q - 1) :
    ((balancedRun k (rightStep c)).n1 = if c.n2 = q then q - 1 else q) ∧
    ((balancedRun k (rightStep c)).n2 = if c.n2 = q then q + 1 else q) := by
  by_cases h : c.n2 = q
  · have hl : (rightStep c).n1 + k ≤ (rightStep c).n2 := by simp only [rightStep]; omega
    rw [balancedRun_left_only k (rightStep c) hl]
    simp only [rightStep, if_pos h]
    constructor <;> omega
  · have h1 : (rightStep c).n1 ≤ q := hcap1
    have h2 : (rightStep c).n2 ≤ q := by simp only [rightStep]; omega
    have hsum : (rightStep c).n1 + (rightStep c).n2 + k = 2 * q := by simp only [rightStep]; omega
    simpa only [if_neg h] using balancedRun_final_counts q k (rightStep c) h1 h2 hsum

theorem forced_left_variance_lower (q k : ℕ) (c : Counts) (hq : 2 ≤ q)
    (h1 : 0 < c.n1) (h2 : 0 < c.n2) (hcap1 : c.n1 ≤ q) (hcap2 : c.n2 ≤ q)
    (hs : c.n1 + c.n2 + k = 2 * q - 1) :
    cumulativeVariance k c + updateVariance (q : ℝ≥0) ≤
      updateVariance c.n1 + cumulativeVariance k (leftStep c) := by
  have hp := preterminal_variance q k c (by omega) hcap1 hcap2 hs
  have hf := forced_left_final_counts q k c (by omega) hcap1 hcap2 hs
  have ha := leftAction_variance_decomposition k c h1 h2
  have hb := cumulativeVariance_decomposition k c h1 h2
  by_cases h : c.n1 = q
  · simp only [if_pos h] at hf
    rw [BayesOptimal.Foundations.TwoArmBellman.variance, hf.1, hf.2] at ha
    rw [hp] at hb
    have hv := posteriorVariance_after_draw (q : ℝ≥0) ((q - 1 : ℕ) : ℝ≥0)
      (by exact_mod_cast (show 0 < q by omega))
    have hv' : posteriorVariance (q : ℝ≥0) ((q - 1 : ℕ) : ℝ≥0) =
        updateVariance (q : ℝ≥0) +
          posteriorVariance ((q + 1 : ℕ) : ℝ≥0) ((q - 1 : ℕ) : ℝ≥0) := by
      simpa only [Nat.cast_add, Nat.cast_one] using hv
    rw [hv', ← add_assoc] at hb
    exact (add_right_cancel (ha.trans hb.symm)).symm.le
  · simp only [if_neg h] at hf
    rw [BayesOptimal.Foundations.TwoArmBellman.variance, hf.1, hf.2] at ha
    rw [hp] at hb
    have hv := posteriorVariance_after_draw ((q - 1 : ℕ) : ℝ≥0) (q : ℝ≥0)
      (by exact_mod_cast (show 0 < q - 1 by omega))
    have hvs := updateVariance_strictAntitone ((q - 1 : ℕ) : ℝ≥0) (q : ℝ≥0)
      (by exact_mod_cast (show 0 < q - 1 by omega))
      (by exact_mod_cast (show q - 1 < q by omega))
    have he : updateVariance c.n1 + cumulativeVariance k (leftStep c) =
        cumulativeVariance k c + updateVariance ((q - 1 : ℕ) : ℝ≥0) := by
      have hqa : (((q - 1 : ℕ) : ℝ≥0) + 1) = (q : ℝ≥0) := by
        exact_mod_cast (show q - 1 + 1 = q by omega)
      rw [hqa] at hv
      rw [posteriorVariance_comm (q : ℝ≥0) ((q - 1 : ℕ) : ℝ≥0), hv, ← add_assoc] at hb
      exact add_right_cancel (ha.trans hb.symm)
    rw [he]
    exact add_le_add_left hvs.le _

theorem forced_right_variance_lower (q k : ℕ) (c : Counts) (hq : 2 ≤ q)
    (h1 : 0 < c.n1) (h2 : 0 < c.n2) (hcap1 : c.n1 ≤ q) (hcap2 : c.n2 ≤ q)
    (hs : c.n1 + c.n2 + k = 2 * q - 1) :
    cumulativeVariance k c + updateVariance (q : ℝ≥0) ≤
      updateVariance c.n2 + cumulativeVariance k (rightStep c) := by
  have hp := preterminal_variance q k c (by omega) hcap1 hcap2 hs
  have hf := forced_right_final_counts q k c (by omega) hcap1 hcap2 hs
  have ha := rightAction_variance_decomposition k c h1 h2
  have hb := cumulativeVariance_decomposition k c h1 h2
  by_cases h : c.n2 = q
  · simp only [if_pos h] at hf
    rw [BayesOptimal.Foundations.TwoArmBellman.variance, hf.1, hf.2, posteriorVariance_comm] at ha
    rw [hp] at hb
    have hv := posteriorVariance_after_draw (q : ℝ≥0) ((q - 1 : ℕ) : ℝ≥0)
      (by exact_mod_cast (show 0 < q by omega))
    have hv' : posteriorVariance (q : ℝ≥0) ((q - 1 : ℕ) : ℝ≥0) =
        updateVariance (q : ℝ≥0) +
          posteriorVariance ((q + 1 : ℕ) : ℝ≥0) ((q - 1 : ℕ) : ℝ≥0) := by
      simpa only [Nat.cast_add, Nat.cast_one] using hv
    rw [hv', ← add_assoc] at hb
    exact (add_right_cancel (ha.trans hb.symm)).symm.le
  · simp only [if_neg h] at hf
    rw [BayesOptimal.Foundations.TwoArmBellman.variance, hf.1, hf.2] at ha
    rw [hp] at hb
    have hv := posteriorVariance_after_draw ((q - 1 : ℕ) : ℝ≥0) (q : ℝ≥0)
      (by exact_mod_cast (show 0 < q - 1 by omega))
    have hvs := updateVariance_strictAntitone ((q - 1 : ℕ) : ℝ≥0) (q : ℝ≥0)
      (by exact_mod_cast (show 0 < q - 1 by omega))
      (by exact_mod_cast (show q - 1 < q by omega))
    have he : updateVariance c.n2 + cumulativeVariance k (rightStep c) =
        cumulativeVariance k c + updateVariance ((q - 1 : ℕ) : ℝ≥0) := by
      have hqa : (((q - 1 : ℕ) : ℝ≥0) + 1) = (q : ℝ≥0) := by
        exact_mod_cast (show q - 1 + 1 = q by omega)
      rw [hqa] at hv
      rw [posteriorVariance_comm (q : ℝ≥0) ((q - 1 : ℕ) : ℝ≥0), hv, ← add_assoc] at hb
      exact add_right_cancel (ha.trans hb.symm)
    rw [he]
    exact add_le_add_left hvs.le _

theorem left_gain_integral_lower (q k : ℕ) (m1 m2 : ℝ) (c : Counts)
    (hq : 2 ≤ q) (h1 : 0 < c.n1) (h2 : 0 < c.n2)
    (hcap1 : c.n1 ≤ q) (hcap2 : c.n2 ≤ q)
    (hs : c.n1 + c.n2 + k = 2 * q - 1) :
    (∫ x : ℝ, hingeLoss |x| (updateVariance (q : ℝ≥0))
      ∂balancedPredictiveLaw k c (m1 - m2)) ≤
      leftAction k m1 m2 c - payoff k m1 m2 c := by
  have hv := forced_left_variance_lower q k c hq h1 h2 hcap1 hcap2 hs
  have hm := hingeLoss_mono_variance (m2 - m1) _ _ hv
  rw [leftAction_eq, payoff_eq]
  have he := hinge_variance_increment_integral (m2 - m1)
    (cumulativeVariance k c) (updateVariance (q : ℝ≥0))
  rw [cumulativeVariance_eq_accumulatedVariance k c h1 h2] at he
  rw [balancedPredictiveLaw_gaussian]
  have hneg : -(m2 - m1) = m1 - m2 := by ring
  rw [hneg] at he
  rw [cumulativeVariance_eq_accumulatedVariance k c h1 h2] at hm ⊢
  linarith only [he, hm]

theorem right_gain_integral_lower (q k : ℕ) (m1 m2 : ℝ) (c : Counts)
    (hq : 2 ≤ q) (h1 : 0 < c.n1) (h2 : 0 < c.n2)
    (hcap1 : c.n1 ≤ q) (hcap2 : c.n2 ≤ q)
    (hs : c.n1 + c.n2 + k = 2 * q - 1) :
    (∫ x : ℝ, hingeLoss |x| (updateVariance (q : ℝ≥0))
      ∂balancedPredictiveLaw k c (m1 - m2)) ≤
      rightAction k m1 m2 c - payoff k m1 m2 c := by
  have hv := forced_right_variance_lower q k c hq h1 h2 hcap1 hcap2 hs
  have hm := hingeLoss_mono_variance (m2 - m1) _ _ hv
  rw [rightAction_eq, payoff_eq]
  have he := hinge_variance_increment_integral (m2 - m1)
    (cumulativeVariance k c) (updateVariance (q : ℝ≥0))
  rw [cumulativeVariance_eq_accumulatedVariance k c h1 h2] at he
  rw [balancedPredictiveLaw_gaussian]
  have hneg : -(m2 - m1) = m1 - m2 := by ring
  rw [hneg] at he
  rw [cumulativeVariance_eq_accumulatedVariance k c h1 h2] at hm ⊢
  linarith only [he, hm]

theorem lemma19_individual_gains (T q t : ℕ) (CU : ℝ) (p : MeanPath) (c : Counts)
    (hT : T = 2 * q + 1) (ht : 4 ≤ t) (hpre : t < T)
    (hc : horizonConsistent t c) (hW : newW T q CU p c) :
    (gainConstant * lowerConstant) * invPower 176 T ≤
      leftAction (T - t) (p 1 c.n1) (p 2 c.n2) c -
        payoff (T - t) (p 1 c.n1) (p 2 c.n2) c ∧
    (gainConstant * lowerConstant) * invPower 176 T ≤
      rightAction (T - t) (p 1 c.n1) (p 2 c.n2) c -
        payoff (T - t) (p 1 c.n1) (p 2 c.n2) c := by
  have hq : 2 ≤ q := by omega
  have h1 : 0 < c.n1 := by have := hc.1; omega
  have h2 : 0 < c.n2 := by have := hc.2.1; omega
  have hs : c.n1 + c.n2 + (T - t) = 2 * q - 1 := by
    have := hc.2.2.2; have := hc.2.2.1; omega
  have hcap1 := hW.2.2.2.2.2.1
  have hcap2 := hW.2.2.2.2.2.2.1
  have hg := nonterminal_hinge_gain_lower T q t q CU p c hT ht hpre hc hW
    (by omega) (by omega)
  exact ⟨hg.trans (left_gain_integral_lower q (T - t) _ _ c hq h1 h2 hcap1 hcap2 hs),
    hg.trans (right_gain_integral_lower q (T - t) _ _ c hq h1 h2 hcap1 hcap2 hs)⟩

theorem lemma19_saturated_left_gap (T q t : ℕ) (CU : ℝ) (p : MeanPath) (c : Counts)
    (hT : T = 2 * q + 1) (ht : 4 ≤ t) (hpre : t < T)
    (hc : horizonConsistent t c) (hW : newW T q CU p c) (hsat : c.n1 = q) :
    (comparisonConstant * lowerConstant) * invPower 178 T ≤
      rightAction (T - t) (p 1 c.n1) (p 2 c.n2) c -
        leftAction (T - t) (p 1 c.n1) (p 2 c.n2) c := by
  have hq : 2 ≤ q := by omega
  have h1 : 0 < c.n1 := by have := hc.1; omega
  have h2 : 0 < c.n2 := by have := hc.2.1; omega
  have hs : c.n1 + c.n2 + (T - t) = 2 * q - 1 := by
    have := hc.2.2.2; have := hc.2.2.1; omega
  have hsmall : c.n2 < c.n1 := by omega
  rw [← smaller_count_right_optimal (T - t) _ _ c h1 h2 hsmall,
    saturated_left_gap_preterminal q (T - t) _ _ c (by omega) h1 h2 hsat hs]
  exact nonterminal_hinge_difference_lower T q t q (q - 1) CU p c hT ht hpre hc hW
    (by omega) (by omega) (by omega)

theorem lemma19_saturated_right_gap (T q t : ℕ) (CU : ℝ) (p : MeanPath) (c : Counts)
    (hT : T = 2 * q + 1) (ht : 4 ≤ t) (hpre : t < T)
    (hc : horizonConsistent t c) (hW : newW T q CU p c) (hsat : c.n2 = q) :
    (comparisonConstant * lowerConstant) * invPower 178 T ≤
      leftAction (T - t) (p 1 c.n1) (p 2 c.n2) c -
        rightAction (T - t) (p 1 c.n1) (p 2 c.n2) c := by
  have hq : 2 ≤ q := by omega
  have h1 : 0 < c.n1 := by have := hc.1; omega
  have h2 : 0 < c.n2 := by have := hc.2.1; omega
  have hs : c.n1 + c.n2 + (T - t) = 2 * q - 1 := by
    have := hc.2.2.2; have := hc.2.2.1; omega
  have hsmall : c.n1 ≤ c.n2 := by omega
  rw [← smaller_count_left_optimal (T - t) _ _ c h1 h2 hsmall,
    saturated_right_gap_preterminal q (T - t) _ _ c (by omega) h1 h2 hsat hs]
  exact nonterminal_hinge_difference_lower T q t q (q - 1) CU p c hT ht hpre hc hW
    (by omega) (by omega) (by omega)

end
end BayesOptimal.Dynamic

end

/-! ## Exclusion -/
section

open MeasureTheory ProbabilityTheory
open scoped NNReal ENNReal

namespace BayesOptimal.Exclusion

open BayesOptimal.Foundations.BayesianModel BayesOptimal.Foundations.PosteriorLaw BayesOptimal.Foundations.PosteriorRegret
open BayesOptimal.Foundations.Gaussian BayesOptimal.Foundations.ThreeArmComparison

noncomputable section

def otherMinimum (i : Arm) (u : Means) : ℝ :=
  if i = 0 then min (u 1) (u 2)
  else if i = 1 then min (u 0) (u 2) else min (u 0) (u 1)

/-- The revised paper's actual posterior exclusion loss. -/
def exclusion (c : Counts) (m : Means) (i : Arm) : ℝ :=
  ∫ u : Means, max (u i - otherMinimum i u) 0 ∂posteriorLaw c m

def pairIntegral (c : Counts) (m : Means) (i j : Arm) : ℝ :=
  ∫ u : Means, max (u i - u j) 0 ∂posteriorLaw c m

def pairSlack (c : Counts) (m : Means) (i j : Arm) : ℝ :=
  hingeLoss (m j - m i) ((c i : ℝ≥0)⁻¹ + (c j : ℝ≥0)⁻¹)

theorem otherMinimum_integrable (c : Counts) (m : Means) (i : Arm) :
    Integrable (otherMinimum i) (posteriorLaw c m) := by
  have hmin (a b : Arm) : Integrable (fun u : Means => min (u a) (u b))
      (posteriorLaw c m) := by
    have h := ((posterior_coordinate_integrable c m a).sub
      ((posterior_coordinate_integrable c m a).sub
        (posterior_coordinate_integrable c m b)).pos_part)
    convert h using 1
    funext u
    dsimp
    by_cases hab : u a ≤ u b
    · rw [min_eq_left hab, max_eq_right (by linarith : u a - u b ≤ 0), sub_zero]
    · rw [min_eq_right (by linarith : u b ≤ u a),
        max_eq_left (by linarith : 0 ≤ u a - u b)]
      ring
  fin_cases i <;> simpa [otherMinimum] using hmin _ _

theorem exclusion_integrable (c : Counts) (m : Means) (i : Arm) :
    Integrable (fun u : Means => max (u i - otherMinimum i u) 0) (posteriorLaw c m) :=
  ((posterior_coordinate_integrable c m i).sub (otherMinimum_integrable c m i)).pos_part

theorem pair_integrable (c : Counts) (m : Means) (i j : Arm) :
    Integrable (fun u : Means => max (u i - u j) 0) (posteriorLaw c m) :=
  ((posterior_coordinate_integrable c m i).sub (posterior_coordinate_integrable c m j)).pos_part

theorem otherMinimum_le (i j : Arm) (u : Means) (hij : j ≠ i) :
    otherMinimum i u ≤ u j := by
  fin_cases i <;> fin_cases j <;> simp_all [otherMinimum]

theorem pairIntegral_le_exclusion (c : Counts) (m : Means) (i j : Arm) (hij : j ≠ i) :
    pairIntegral c m i j ≤ exclusion c m i := by
  exact integral_mono (pair_integrable c m i j) (exclusion_integrable c m i)
    (fun u => max_le_max (sub_le_sub_left (otherMinimum_le i j u hij) _) le_rfl)

theorem exclusion_nonnegative (c : Counts) (m : Means) (i : Arm) :
    0 ≤ exclusion c m i := integral_nonneg (fun _ => le_max_right _ _)

theorem positive_part_const_sub_integral (a : ℝ) (v : ℝ≥0) :
    (∫ x : ℝ, max (a - x) 0 ∂gaussianReal 0 v) = hingeLoss (-a) v := by
  have hm : (gaussianReal 0 v).map (fun x : ℝ => -x) = gaussianReal 0 v := by
    simpa using gaussianReal_map_neg (μ := (0 : ℝ)) (v := v)
  have he : (∫ x : ℝ, max (x - (-a)) 0 ∂(gaussianReal 0 v).map (fun x : ℝ => -x)) =
      ∫ x : ℝ, max (a - x) 0 ∂gaussianReal 0 v := by
    rw [integral_map (by fun_prop) (by fun_prop)]
    congr 1
    funext x
    congr 1
    ring
  rw [hm] at he
  exact he.symm

theorem positive_pair_double_integral (a b : ℝ) (v w : ℝ≥0) :
    (∫ x : ℝ, ∫ y : ℝ, max ((a + x) - (b + y)) 0
      ∂gaussianReal 0 w ∂gaussianReal 0 v) = hingeLoss (b - a) (v + w) := by
  have he (x : ℝ) : (∫ y : ℝ, max ((a + x) - (b + y)) 0 ∂gaussianReal 0 w) =
      hingeLoss (b - a - x) w := by
    have h := positive_part_const_sub_integral (a + x - b) w
    convert h using 1
    · congr 1
      funext y
      congr 1
      ring
    · congr 1
      ring
  simp_rw [he]
  exact hingeLoss_shift_tower (b - a) v w

theorem pair_integral_triple (c : Counts) (m : Means) (i j : Arm) :
    pairIntegral c m i j = ∫ x : Triple,
      max (tripleShift m x i - tripleShift m x j) 0 ∂centeredTripleLaw c := by
  unfold pairIntegral posteriorLaw
  rw [integral_map (tripleShift_measurable m).aemeasurable (by fun_prop)]

theorem pair_integrable_triple (c : Counts) (m : Means) (i j : Arm) :
    Integrable (fun x : Triple => max (tripleShift m x i - tripleShift m x j) 0)
      (centeredTripleLaw c) := by
  have h := pair_integrable c m i j
  unfold posteriorLaw at h
  exact h.comp_measurable (tripleShift_measurable m)

theorem pairIntegral_01 (c : Counts) (m : Means) :
    pairIntegral c m 0 1 = pairSlack c m 0 1 := by
  rw [pair_integral_triple]
  have hi := pair_integrable_triple c m 0 1
  simp [tripleShift, shift, Fin.ext_iff] at hi ⊢
  unfold centeredTripleLaw at hi ⊢
  rw [integral_prod _ hi]
  dsimp only [Prod.fst, Prod.snd]
  have hf (x : ℝ) : (∫ y : ℝ × ℝ, max ((m 0 + x) - (m 1 + y.1)) 0
      ∂(gaussianReal 0 (c 1 : ℝ≥0)⁻¹).prod (gaussianReal 0 (c 2 : ℝ≥0)⁻¹)) =
      ∫ y : ℝ, max ((m 0 + x) - (m 1 + y)) 0 ∂gaussianReal 0 (c 1 : ℝ≥0)⁻¹ := by
    simpa using integral_fun_fst (μ := gaussianReal 0 (c 1 : ℝ≥0)⁻¹)
      (ν := gaussianReal 0 (c 2 : ℝ≥0)⁻¹) (fun y : ℝ => max ((m 0 + x) - (m 1 + y)) 0)
  simp_rw [hf]
  exact positive_pair_double_integral _ _ _ _

theorem pairIntegral_02 (c : Counts) (m : Means) :
    pairIntegral c m 0 2 = pairSlack c m 0 2 := by
  rw [pair_integral_triple]
  have hi := pair_integrable_triple c m 0 2
  simp [tripleShift, shift, Fin.ext_iff] at hi ⊢
  unfold centeredTripleLaw at hi ⊢
  rw [integral_prod _ hi]
  dsimp only [Prod.fst, Prod.snd]
  have hf (x : ℝ) : (∫ y : ℝ × ℝ, max ((m 0 + x) - (m 2 + y.2)) 0
      ∂(gaussianReal 0 (c 1 : ℝ≥0)⁻¹).prod (gaussianReal 0 (c 2 : ℝ≥0)⁻¹)) =
      ∫ y : ℝ, max ((m 0 + x) - (m 2 + y)) 0 ∂gaussianReal 0 (c 2 : ℝ≥0)⁻¹ := by
    simpa using integral_fun_snd (μ := gaussianReal 0 (c 1 : ℝ≥0)⁻¹)
      (ν := gaussianReal 0 (c 2 : ℝ≥0)⁻¹) (fun y : ℝ => max ((m 0 + x) - (m 2 + y)) 0)
  simp_rw [hf]
  exact positive_pair_double_integral _ _ _ _

theorem pairIntegral_10 (c : Counts) (m : Means) :
    pairIntegral c m 1 0 = pairSlack c m 1 0 := by
  rw [pair_integral_triple]
  have hi := pair_integrable_triple c m 1 0
  simp [tripleShift, shift, Fin.ext_iff] at hi ⊢
  unfold centeredTripleLaw at hi ⊢
  rw [integral_prod _ hi]
  dsimp only [Prod.fst, Prod.snd]
  have hf (x : ℝ) : (∫ y : ℝ × ℝ, max ((m 1 + y.1) - (m 0 + x)) 0
      ∂(gaussianReal 0 (c 1 : ℝ≥0)⁻¹).prod (gaussianReal 0 (c 2 : ℝ≥0)⁻¹)) =
      ∫ y : ℝ, max ((m 1 + y) - (m 0 + x)) 0 ∂gaussianReal 0 (c 1 : ℝ≥0)⁻¹ := by
    simpa using integral_fun_fst (μ := gaussianReal 0 (c 1 : ℝ≥0)⁻¹)
      (ν := gaussianReal 0 (c 2 : ℝ≥0)⁻¹) (fun y : ℝ => max ((m 1 + y) - (m 0 + x)) 0)
  simp_rw [hf]
  have he (x : ℝ) : (∫ y : ℝ, max ((m 1 + y) - (m 0 + x)) 0
      ∂gaussianReal 0 (c 1 : ℝ≥0)⁻¹) = hingeLoss (m 0 - m 1 + x) (c 1 : ℝ≥0)⁻¹ := by
    unfold hingeLoss
    congr 1
    funext y
    congr 1
    ring
  simp_rw [he]
  rw [hingeLoss_add_tower]
  unfold pairSlack
  rw [add_comm]

theorem pairIntegral_20 (c : Counts) (m : Means) :
    pairIntegral c m 2 0 = pairSlack c m 2 0 := by
  rw [pair_integral_triple]
  have hi := pair_integrable_triple c m 2 0
  simp [tripleShift, shift, Fin.ext_iff] at hi ⊢
  unfold centeredTripleLaw at hi ⊢
  rw [integral_prod _ hi]
  dsimp only [Prod.fst, Prod.snd]
  have hf (x : ℝ) : (∫ y : ℝ × ℝ, max ((m 2 + y.2) - (m 0 + x)) 0
      ∂(gaussianReal 0 (c 1 : ℝ≥0)⁻¹).prod (gaussianReal 0 (c 2 : ℝ≥0)⁻¹)) =
      ∫ y : ℝ, max ((m 2 + y) - (m 0 + x)) 0 ∂gaussianReal 0 (c 2 : ℝ≥0)⁻¹ := by
    simpa using integral_fun_snd (μ := gaussianReal 0 (c 1 : ℝ≥0)⁻¹)
      (ν := gaussianReal 0 (c 2 : ℝ≥0)⁻¹) (fun y : ℝ => max ((m 2 + y) - (m 0 + x)) 0)
  simp_rw [hf]
  have he (x : ℝ) : (∫ y : ℝ, max ((m 2 + y) - (m 0 + x)) 0
      ∂gaussianReal 0 (c 2 : ℝ≥0)⁻¹) = hingeLoss (m 0 - m 2 + x) (c 2 : ℝ≥0)⁻¹ := by
    unfold hingeLoss
    congr 1
    funext y
    congr 1
    ring
  simp_rw [he]
  rw [hingeLoss_add_tower]
  unfold pairSlack
  rw [add_comm]

theorem pairIntegral_12 (c : Counts) (m : Means) :
    pairIntegral c m 1 2 = pairSlack c m 1 2 := by
  rw [pair_integral_triple]
  have hi := pair_integrable_triple c m 1 2
  simp [tripleShift, shift, Fin.ext_iff] at hi ⊢
  unfold centeredTripleLaw at hi ⊢
  have hp : Integrable (fun x : ℝ × ℝ => max ((m 1 + x.1) - (m 2 + x.2)) 0)
      ((gaussianReal 0 (c 1 : ℝ≥0)⁻¹).prod (gaussianReal 0 (c 2 : ℝ≥0)⁻¹)) :=
    hi.of_comp_snd (by exact MeasureTheory.IsProbabilityMeasure.ne_zero _)
  have he := integral_fun_snd (μ := gaussianReal 0 (c 0 : ℝ≥0)⁻¹)
    (ν := (gaussianReal 0 (c 1 : ℝ≥0)⁻¹).prod (gaussianReal 0 (c 2 : ℝ≥0)⁻¹))
    (fun x : ℝ × ℝ => max ((m 1 + x.1) - (m 2 + x.2)) 0)
  simp only [measureReal_univ_eq_one, one_smul] at he
  rw [he, integral_prod _ hp]
  exact positive_pair_double_integral _ _ _ _

theorem pairIntegral_21 (c : Counts) (m : Means) :
    pairIntegral c m 2 1 = pairSlack c m 2 1 := by
  rw [pair_integral_triple]
  have hi := pair_integrable_triple c m 2 1
  simp [tripleShift, shift, Fin.ext_iff] at hi ⊢
  unfold centeredTripleLaw at hi ⊢
  have hp : Integrable (fun x : ℝ × ℝ => max ((m 2 + x.2) - (m 1 + x.1)) 0)
      ((gaussianReal 0 (c 1 : ℝ≥0)⁻¹).prod (gaussianReal 0 (c 2 : ℝ≥0)⁻¹)) :=
    hi.of_comp_snd (by exact MeasureTheory.IsProbabilityMeasure.ne_zero _)
  have he := integral_fun_snd (μ := gaussianReal 0 (c 0 : ℝ≥0)⁻¹)
    (ν := (gaussianReal 0 (c 1 : ℝ≥0)⁻¹).prod (gaussianReal 0 (c 2 : ℝ≥0)⁻¹))
    (fun x : ℝ × ℝ => max ((m 2 + x.2) - (m 1 + x.1)) 0)
  simp only [measureReal_univ_eq_one, one_smul] at he
  rw [he, integral_prod_symm _ hp]
  exact positive_pair_double_integral _ _ _ _

theorem pairIntegral_eq_pairSlack (c : Counts) (m : Means) (i j : Arm) (hij : i ≠ j) :
    pairIntegral c m i j = pairSlack c m i j := by
  fin_cases i <;> fin_cases j
  all_goals first | exact False.elim (hij rfl) | exact pairIntegral_01 c m |
    exact pairIntegral_02 c m | exact pairIntegral_10 c m | exact pairIntegral_12 c m |
    exact pairIntegral_20 c m | exact pairIntegral_21 c m

theorem pairSlack_le_exclusion (c : Counts) (m : Means) (i j : Arm) (hij : i ≠ j) :
    pairSlack c m i j ≤ exclusion c m i := by
  rw [← pairIntegral_eq_pairSlack c m i j hij]
  exact pairIntegral_le_exclusion c m i j hij.symm

theorem stateSlack_le_exclusion (c : Counts) (m : Means) :
    stateSlack c m ≤ exclusion c m 2 := by
  have h := pairSlack_le_exclusion c m 2 0 (by decide)
  simpa [stateSlack, slack, pairSlack, posteriorVariance, add_comm] using h

theorem exclusion_third_le_pairSlacks (c : Counts) (m : Means) :
    exclusion c m 2 ≤ pairSlack c m 2 0 + pairSlack c m 2 1 := by
  have hi := (pair_integrable c m 2 0).add (pair_integrable c m 2 1)
  have h := integral_mono (exclusion_integrable c m 2) hi (fun u => by
    change max (u 2 - min (u 0) (u 1)) 0 ≤ max (u 2 - u 0) 0 + max (u 2 - u 1) 0
    by_cases hu : u 0 ≤ u 1
    · rw [min_eq_left hu]
      linarith [le_max_right (u 2 - u 1) 0]
    · rw [min_eq_right (le_of_not_ge hu)]
      linarith [le_max_right (u 2 - u 0) 0])
  simp only [Pi.add_apply] at h
  rw [integral_add (pair_integrable c m 2 0) (pair_integrable c m 2 1)] at h
  change exclusion c m 2 ≤ pairIntegral c m 2 0 + pairIntegral c m 2 1 at h
  rw [pairIntegral_20, pairIntegral_21] at h
  exact h

end

end BayesOptimal.Exclusion

end

/-! ## ExclusionTail -/
section

open MeasureTheory ProbabilityTheory
open scoped NNReal ENNReal

namespace BayesOptimal.ExclusionTail

set_option maxHeartbeats 1000000

open BayesOptimal.Foundations.Gaussian BayesOptimal.Foundations.Counts BayesOptimal.Foundations.Drift BayesOptimal.Foundations.Rates

noncomputable section

theorem mean_bound6_newZ (T q i n : ℕ) (p : MeanPath) (hT : 5 ≤ T)
    (hn : 1 ≤ n) (hnq : n ≤ q) (hY : eventY T q i p)
    (hZ : BayesOptimal.Comparison.newZ T q i p) :
    |p i n| ≤ 6 * Real.sqrt (Real.log (T : ℝ)) := by
  have hlog := log_horizon_ge_one T hT
  have hroot : 1 ≤ Real.sqrt (Real.log (T : ℝ)) := Real.one_le_sqrt.mpr hlog
  have hs := reciprocalSqSum_bound n q hn hnq
  have hnR : (1 : ℝ) ≤ n := by exact_mod_cast hn
  have hinv : 1 / (n : ℝ) ≤ 1 := (div_le_one (by positivity)).mpr hnR
  have hsbound : reciprocalSqSum n q ≤ 2 := by
    have hqinv : 0 ≤ 1 / (q : ℝ) := by positivity
    linarith
  have hsroot : Real.sqrt (reciprocalSqSum n q) ≤ 3 / 2 := by
    apply (Real.sqrt_le_left (by norm_num : (0 : ℝ) ≤ 3 / 2)).mpr
    linarith
  have hz := hZ n hn hnq
  have htri : |p i n| ≤ |p i n - p i q| + |p i q| := by
    simpa only [sub_add_cancel] using abs_add_le (p i n - p i q) (p i q)
  have hsmall : 1 / (T : ℝ) ^ 2 ≤ 1 := by
    have hTr : 5 ≤ (T : ℝ) := by exact_mod_cast hT
    apply (div_le_one (by positivity)).mpr
    nlinarith
  have hscaled := mul_le_mul_of_nonneg_left hsroot
    (show 0 ≤ 3 * Real.sqrt (Real.log (T : ℝ)) by positivity)
  unfold eventY at hY
  nlinarith

/-- The paper's exact prefactor is obtained by retaining the 1/t MGF factor. -/
theorem hingeLoss_le_paper_prefactor (a b : ℝ) (v : ℝ≥0)
    (hb : 4 ≤ b) (ha : b ≤ a) (hv : (v : ℝ) ≤ 2) :
    hingeLoss a v ≤ (1 / Real.sqrt Real.pi) * Real.exp (-b ^ 2 / 4) := by
  have hbpos : 0 < b := by linarith
  have hpi : Real.sqrt Real.pi ≤ 2 := by
    apply (Real.sqrt_le_left (by norm_num : (0 : ℝ) ≤ 2)).mpr
    linarith [Real.pi_lt_four]
  have hroot : 0 < Real.sqrt Real.pi := Real.sqrt_pos.mpr Real.pi_pos
  have hexp : -(b / 2) * a + (v : ℝ) * (b / 2) ^ 2 / 2 ≤ -b ^ 2 / 4 := by
    have hm := mul_le_mul_of_nonneg_left ha (half_pos hbpos).le
    nlinarith [sq_nonneg b]
  have hfactor : 1 / (b / 2) ≤ 1 / Real.sqrt Real.pi := by
    apply one_div_le_one_div_of_le hroot
    linarith
  calc
    hingeLoss a v ≤ Real.exp (-(b / 2) * a + (v : ℝ) * (b / 2) ^ 2 / 2) / (b / 2) :=
      BayesOptimal.Foundations.GaussianTail.hingeLoss_le_mgf a v (b / 2) (half_pos hbpos)
    _ ≤ Real.exp (-b ^ 2 / 4) / (b / 2) :=
      div_le_div_of_nonneg_right (Real.exp_le_exp.mpr hexp) (half_pos hbpos).le
    _ ≤ (1 / Real.sqrt Real.pi) * Real.exp (-b ^ 2 / 4) := by
      calc
        _ = (1 / (b / 2)) * Real.exp (-b ^ 2 / 4) := by ring
        _ ≤ _ := mul_le_mul_of_nonneg_right hfactor (Real.exp_pos (-b ^ 2 / 4)).le

def paperG0 (T : ℕ) (CU : ℝ) : ℝ :=
  (2 / Real.sqrt Real.pi) * (T : ℝ) ^ (-((CU - 6) ^ 2 / 4))

theorem pair_tail_newW (T q i n : ℕ) (CU : ℝ) (p : MeanPath) (hT : 5 ≤ T)
    (hCU : 10 ≤ CU) (hn : 1 ≤ n) (hnq : n ≤ q)
    (hX : eventX T CU p) (hY : eventY T q i p)
    (hZ : BayesOptimal.Comparison.newZ T q i p) (v : ℝ≥0) (hv : (v : ℝ) ≤ 2) :
    hingeLoss (p i n - p 3 1) v ≤
      (1 / Real.sqrt Real.pi) * (T : ℝ) ^ (-((CU - 6) ^ 2 / 4)) := by
  have hlog := log_horizon_ge_one T hT
  have hlog0 : 0 ≤ Real.log (T : ℝ) := by linarith
  have hsqrt : 1 ≤ Real.sqrt (Real.log (T : ℝ)) := Real.one_le_sqrt.mpr hlog
  have hmean := mean_bound6_newZ T q i n p hT hn hnq hY hZ
  have hlo := (abs_le.mp hmean).1
  have hgap : (CU - 6) * Real.sqrt (Real.log (T : ℝ)) ≤ p i n - p 3 1 := by
    unfold eventX at hX
    nlinarith
  have hb : 4 ≤ (CU - 6) * Real.sqrt (Real.log (T : ℝ)) := by nlinarith
  have h := hingeLoss_le_paper_prefactor _ _ v hb hgap hv
  have he : Real.exp (-((CU - 6) * Real.sqrt (Real.log (T : ℝ))) ^ 2 / 4) =
      (T : ℝ) ^ (-((CU - 6) ^ 2 / 4)) := by
    rw [Real.rpow_def_of_pos (by exact_mod_cast (show 0 < T by omega))]
    congr 1
    rw [mul_pow, Real.sq_sqrt hlog0]
    ring
  simpa only [he] using h

end

end BayesOptimal.ExclusionTail

end

/-! ## ExclusionBounds -/
section

open MeasureTheory ProbabilityTheory Filter Asymptotics
open scoped NNReal ENNReal

namespace BayesOptimal.ExclusionBounds

open BayesOptimal.Foundations.Gaussian BayesOptimal.Foundations.Drift BayesOptimal.Foundations.Rates BayesOptimal.Foundations.DynamicPolicy
open BayesOptimal.Exclusion BayesOptimal.ExclusionTail

noncomputable section

theorem variance_le_two_counts (n m : ℕ) (hn : 1 ≤ n) (hm : 1 ≤ m) :
    ((n : ℝ≥0)⁻¹ + (m : ℝ≥0)⁻¹ : ℝ) ≤ 2 := by
  simp only [NNReal.coe_inv, NNReal.coe_natCast]
  have hnR : (1 : ℝ) ≤ n := by exact_mod_cast hn
  have hmR : (1 : ℝ) ≤ m := by exact_mod_cast hm
  linarith [inv_le_one_of_one_le₀ hnR, inv_le_one_of_one_le₀ hmR]

theorem cutoff_condition_implies_ten (CU : ℝ) (hCU : 0 < CU)
    (hcondition : 180 < (CU - 6) ^ 2 / 4) : 10 ≤ CU := by nlinarith

/-- Revised Lemma11 with its actual min-based exclusion loss and exact prefactor. -/
theorem lemma11 (T q t : ℕ) (CU : ℝ) (p : BayesOptimal.Foundations.Counts.MeanPath)
    (c : BayesOptimal.Foundations.Counts.Counts) (hT : 5 ≤ T) (hCU : 10 ≤ CU)
    (hc : BayesOptimal.Foundations.Counts.horizonConsistent t c) (hW : BayesOptimal.Comparison.newW T q CU p c) :
    exclusion (modelCounts c) (modelMeans p c) 2 ≤ paperG0 T CU := by
  have hl := pair_tail_newW T q 1 c.n1 CU p hT hCU hc.1 hW.2.2.2.2.2.1
    hW.1 hW.2.1 hW.2.2.2.1
    ((c.n3 : ℝ≥0)⁻¹ + (c.n1 : ℝ≥0)⁻¹)
    (variance_le_two_counts _ _ (by have := hc.2.2.1; omega) hc.1)
  have hr := pair_tail_newW T q 2 c.n2 CU p hT hCU hc.2.1 hW.2.2.2.2.2.2.1
    hW.1 hW.2.2.1 hW.2.2.2.2.1
    ((c.n3 : ℝ≥0)⁻¹ + (c.n2 : ℝ≥0)⁻¹)
    (variance_le_two_counts _ _ (by have := hc.2.2.1; omega) hc.2.1)
  have hs := exclusion_third_le_pairSlacks (modelCounts c) (modelMeans p c)
  have he0 : pairSlack (modelCounts c) (modelMeans p c) 2 0 =
      hingeLoss (p 1 c.n1 - p 3 1) ((c.n3 : ℝ≥0)⁻¹ + (c.n1 : ℝ≥0)⁻¹) := by
    simp [pairSlack, modelCounts, modelMeans, hc.2.2.1]
  have he1 : pairSlack (modelCounts c) (modelMeans p c) 2 1 =
      hingeLoss (p 2 c.n2 - p 3 1) ((c.n3 : ℝ≥0)⁻¹ + (c.n2 : ℝ≥0)⁻¹) := by
    simp [pairSlack, modelCounts, modelMeans, hc.2.2.1]
  rw [he0, he1] at hs
  calc
    _ ≤ _ := hs
    _ ≤ (1 / Real.sqrt Real.pi) * (T : ℝ) ^ (-((CU - 6) ^ 2 / 4)) +
        (1 / Real.sqrt Real.pi) * (T : ℝ) ^ (-((CU - 6) ^ 2 / 4)) := add_le_add hl hr
    _ = paperG0 T CU := by unfold paperG0; ring

theorem lemma11_from_equation11 (T q t : ℕ) (CU : ℝ) (p : BayesOptimal.Foundations.Counts.MeanPath)
    (c : BayesOptimal.Foundations.Counts.Counts) (hT : 5 ≤ T) (hCU : 0 < CU)
    (hcondition : 180 < (CU - 6) ^ 2 / 4)
    (hc : BayesOptimal.Foundations.Counts.horizonConsistent t c) (hW : BayesOptimal.Comparison.newW T q CU p c) :
    exclusion (modelCounts c) (modelMeans p c) 2 ≤ paperG0 T CU :=
  lemma11 T q t CU p c hT (cutoff_condition_implies_ten CU hCU hcondition) hc hW

theorem paperG0_nonnegative (T : ℕ) (CU : ℝ) : 0 ≤ paperG0 T CU := by
  unfold paperG0
  positivity

theorem paperG0_le_inverse181 (T : ℕ) (CU : ℝ) (hT : 5 ≤ T) (hCU : 33 ≤ CU) :
    paperG0 T CU ≤ (2 / Real.sqrt Real.pi) * invPower 181 T := by
  have hTpos : (0 : ℝ) < T := by exact_mod_cast (show 0 < T by omega)
  have hlog : 0 ≤ Real.log (T : ℝ) := by have := log_horizon_ge_one T hT; linarith
  have hrate : (181 : ℝ) ≤ (CU - 6) ^ 2 / 4 := by nlinarith
  have hscaled := mul_le_mul_of_nonneg_right hrate hlog
  have he : Real.exp (-(181 : ℝ) * Real.log (T : ℝ)) = invPower 181 T := by
    rw [neg_mul, Real.exp_neg]
    change (Real.exp ((181 : ℕ) * Real.log (T : ℝ)))⁻¹ = invPower 181 T
    rw [Real.exp_nat_mul, Real.exp_log hTpos]
    rfl
  unfold paperG0
  rw [Real.rpow_def_of_pos hTpos]
  apply mul_le_mul_of_nonneg_left _ (by positivity)
  rw [← he]
  apply Real.exp_le_exp.mpr
  nlinarith only [hscaled]

theorem paperG0_bigO181 (CU : ℝ) (hCU : 33 ≤ CU) :
    (fun T : ℕ => paperG0 T CU) =O[atTop] invPower 181 := by
  apply IsBigOWith.isBigO (c := 2 / Real.sqrt Real.pi)
  apply IsBigOWith.of_bound
  filter_upwards [eventually_ge_atTop (5 : ℕ)] with T hT
  rw [Real.norm_of_nonneg (paperG0_nonnegative T CU),
    Real.norm_of_nonneg (invPower_nonneg 181 T)]
  exact paperG0_le_inverse181 T CU hT hCU

theorem paperG0_littleO180 (CU : ℝ) (hCU : 33 ≤ CU) :
    (fun T : ℕ => paperG0 T CU) =o[atTop] invPower 180 :=
  error_littleO (by norm_num : 180 < 181) (paperG0_bigO181 CU hCU)

end

end BayesOptimal.ExclusionBounds

end

/-! ## ExclusionPerm -/
section

open MeasureTheory ProbabilityTheory
open scoped NNReal ENNReal

namespace BayesOptimal.ExclusionPerm

open BayesOptimal.Foundations.BayesianModel BayesOptimal.Foundations.PosteriorRegret BayesOptimal.Foundations.ThreeArmComparison
open BayesOptimal.Exclusion

noncomputable section

def renameCounts (e : Equiv.Perm Arm) (c : Counts) : Counts := c ∘ e
def renameMeans (e : Equiv.Perm Arm) (m : Means) : Means := m ∘ e

theorem advance_rename (e : Equiv.Perm Arm) (c : Counts) (i : Arm) :
    advance (renameCounts e c) i = renameCounts e (advance c (e i)) := by
  ext j
  simp [advance, renameCounts, e.injective.eq_iff]

theorem shift_rename (e : Equiv.Perm Arm) (m : Means) (i : Arm) (z : ℝ) :
    shift (renameMeans e m) i z = renameMeans e (shift m (e i) z) := by
  ext j
  simp [shift, renameMeans, e.injective.eq_iff]

theorem terminal_rename (e : Equiv.Perm Arm) (m : Means) :
    terminal (renameMeans e m) = terminal m := by
  have h (n : Means) (i : Arm) : n i ≤ terminal n :=
    (recommend_greedy n i).trans_eq (recommend_max n)
  apply le_antisymm
  · exact max_le (h m (e 0)) (max_le (h m (e 1)) (h m (e 2)))
  · have h0 := h (renameMeans e m) (e.symm 0)
    have h1 := h (renameMeans e m) (e.symm 1)
    have h2 := h (renameMeans e m) (e.symm 2)
    simp only [renameMeans, Function.comp_apply, Equiv.apply_symm_apply] at h0 h1 h2
    exact max_le h0 (max_le h1 h2)

theorem value_rename (k : ℕ) (e : Equiv.Perm Arm) (c : Counts) (m : Means) :
    value k (renameCounts e c) (renameMeans e m) = value k c m := by
  induction k generalizing c m with
  | zero => exact terminal_rename e m
  | succ k ih =>
    have ha (i : Arm) : action k (renameCounts e c) (renameMeans e m) i =
        action k c m (e i) := by
      unfold action
      rw [advance_rename]
      simp_rw [shift_rename, ih]
      rfl
    apply le_antisymm
    · rw [value_succ, ha 0, ha 1, ha 2]
      exact max_le (action_le_value k c m (e 0))
        (max_le (action_le_value k c m (e 1)) (action_le_value k c m (e 2)))
    · have h0 := action_le_value k (renameCounts e c) (renameMeans e m) (e.symm 0)
      have h1 := action_le_value k (renameCounts e c) (renameMeans e m) (e.symm 1)
      have h2 := action_le_value k (renameCounts e c) (renameMeans e m) (e.symm 2)
      rw [ha, Equiv.apply_symm_apply] at h0 h1 h2
      rw [value_succ]
      exact max_le h0 (max_le h1 h2)

theorem action_rename (k : ℕ) (e : Equiv.Perm Arm) (c : Counts) (m : Means) (i : Arm) :
    action k (renameCounts e c) (renameMeans e m) i = action k c m (e i) := by
  unfold action
  rw [advance_rename]
  simp_rw [shift_rename, value_rename]
  rfl

def EBI (k : ℕ) (c : Counts) (m : Means) (i : Arm) : ℝ :=
  loss k c m - actionLoss k c m i

theorem EBI_eq (k : ℕ) (c : Counts) (m : Means) (i : Arm) (hc : 0 < c i) :
    EBI k c m i = action k c m i - value k c m := by
  rw [EBI, actionLoss_eq k c m i hc]
  unfold loss
  ring

/-- Revised Lemma12 for every arm of the three-arm Gaussian model and every horizon. -/
theorem lemma12_k3 (k : ℕ) (c : Counts) (m : Means) (i : Arm)
    (hc : ∀ j, 0 < c j) : EBI k c m i ≤ exclusion c m i := by
  let e : Equiv.Perm Arm := Equiv.swap 2 i
  have he : e 2 = i := Equiv.swap_apply_left 2 i
  have hpositive : ∀ j, 0 < renameCounts e c j := fun j => hc (e j)
  have ha := (action_comparison k (renameCounts e c) (renameMeans e m) 2 hpositive).2
  rw [twoAction_two, action_rename, he] at ha
  have hv := (value_comparison k (renameCounts e c) (renameMeans e m) hpositive).1
  rw [value_rename] at hv
  have hpair : stateSlack (renameCounts e c) (renameMeans e m) =
      pairSlack c m i (e 0) := by
    simp only [stateSlack, slack, renameCounts, renameMeans, Function.comp_apply,
      he, pairSlack, BayesOptimal.Foundations.Gaussian.posteriorVariance]
    rw [add_comm]
  have hne : i ≠ e 0 := by
    rw [← he]
    exact fun h => (show (2 : Arm) ≠ 0 by decide) (e.injective h)
  have hs := pairSlack_le_exclusion c m i (e 0) hne
  rw [EBI_eq k c m i (hc i)]
  rw [hpair] at ha
  linarith

end

end BayesOptimal.ExclusionPerm

end

/-! ## GaussianComparison -/
section

open MeasureTheory ProbabilityTheory Set
open scoped MeasureTheory NNReal ENNReal

namespace BayesOptimal.Comparison.Gaussian

open BayesOptimal.Foundations.Gaussian BayesOptimal.Foundations.Counts BayesOptimal.Foundations.TwoArmBellman

noncomputable section

/-- This is the revised exclusion integrand, not the old best-arm contribution. -/
theorem exclusion_loss_pair_bound (a b x : ℝ) :
    max (x - min a b) 0 ≤ max (x - a) 0 + max (x - b) 0 := by
  by_cases h : a ≤ b
  · rw [min_eq_left h]
    exact le_add_of_nonneg_right (le_max_right _ _)
  · rw [min_eq_right (le_of_not_ge h)]
    exact le_add_of_nonneg_left (le_max_right _ _)

/-- The revised exclusion quantity can be positive when arm 3 is not best. -/
theorem exclusion_definition_differs :
    max ((1 : ℝ) - min 0 2) 0 = 1 ∧ ¬ (max (0 : ℝ) 2 < 1) := by
  norm_num

def newG1 (gap : ℝ) (vL vR : ℝ≥0) : ℝ :=
  (gaussianReal 0 vL (Icc (3 * |gap| / 2) (2 * |gap|))).toReal *
    (gaussianReal 0 vR (Ici |gap|)).toReal * |gap|

theorem newG1_nonnegative (gap : ℝ) (vL vR : ℝ≥0) :
    0 ≤ newG1 gap vL vR := by
  unfold newG1
  positivity

theorem newG1_at_zero (vL vR : ℝ≥0) : newG1 0 vL vR = 0 := by
  simp [newG1]

theorem newG1_positive (gap : ℝ) (vL vR : ℝ≥0)
    (hgap : gap ≠ 0) (hl : 0 < vL) (hr : 0 < vR) :
    0 < newG1 gap vL vR := by
  have hd : 0 < |gap| := abs_pos.mpr hgap
  exact mul_pos
    (mul_pos (gaussian_Icc_probability_pos 0 _ _ vL hl (by linarith))
      (gaussian_Ici_probability_pos 0 _ vR hr)) hd

def newG2 (gap : ℝ) (vL vG vR : ℝ≥0) : ℝ :=
  (gaussianReal 0 vL (Icc (|gap| / 4) (|gap| / 3))).toReal *
    (gaussianReal 0 vG (Icc (9 * |gap| / 8) (4 * |gap| / 3))).toReal *
    (gaussianReal 0 vR (Ici (3 * |gap| / 4))).toReal * (2 * |gap| / 3)

theorem newG2_nonnegative (gap : ℝ) (vL vG vR : ℝ≥0) :
    0 ≤ newG2 gap vL vG vR := by
  unfold newG2
  positivity

theorem newG2_at_zero (vL vG vR : ℝ≥0) : newG2 0 vL vG vR = 0 := by
  simp [newG2]

theorem newG2_positive (gap : ℝ) (vL vG vR : ℝ≥0)
    (hgap : gap ≠ 0) (hl : 0 < vL) (hg : 0 < vG) (hr : 0 < vR) :
    0 < newG2 gap vL vG vR := by
  have hd : 0 < |gap| := abs_pos.mpr hgap
  exact mul_pos (mul_pos
    (mul_pos (gaussian_Icc_probability_pos 0 _ _ vL hl (by linarith))
      (gaussian_Icc_probability_pos 0 _ _ vG hg (by linarith)))
    (gaussian_Ici_probability_pos 0 _ vR hr)) (by positivity)

/-- The scalar difference used in new Lemma 15, PDF page 30. -/
def pointwiseImprovement (d l r : ℝ) : ℝ :=
  max (r + l - d) 0 - max (r - |d - l|) 0

theorem lemma15_equal_before_crossing (d l r : ℝ) (hl : l ≤ d) :
    pointwiseImprovement d l r = 0 := by
  unfold pointwiseImprovement
  rw [abs_of_nonneg (sub_nonneg.mpr hl)]
  have he : r + l - d = r - (d - l) := by ring
  rw [he, sub_self]

theorem lemma15_pointwise_nonnegative (d l r : ℝ) :
    0 ≤ pointwiseImprovement d l r := by
  by_cases hl : l ≤ d
  · rw [lemma15_equal_before_crossing d l r hl]
  · unfold pointwiseImprovement
    have hl' : d < l := lt_of_not_ge hl
    rw [abs_of_neg (sub_neg.mpr hl')]
    apply sub_nonneg.mpr
    apply max_le_max
    · linarith
    · exact le_rfl

/-- The changed interval [3d/2,2d] makes the printed event lower bound valid. -/
theorem lemma15_repaired_event_bound (d l r : ℝ) (hd : 0 ≤ d)
    (hlow : 3 * d / 2 ≤ l) (hupp : l ≤ 2 * d) (hr : d ≤ r) :
    d ≤ pointwiseImprovement d l r := by
  have hcross : d ≤ l := by linarith
  unfold pointwiseImprovement
  rw [abs_of_nonpos (sub_nonpos.mpr hcross),
    max_eq_left (by linarith : 0 ≤ r + l - d),
    max_eq_left (by linarith : 0 ≤ r - -(d - l))]
  linarith

/-- The two intervals in new Lemma 16, PDF page 32, satisfy all stated
conditions and give its printed pointwise factor 2d/3. -/
theorem lemma16_repaired_event_bound (d l g r : ℝ) (hd : 0 ≤ d)
    (hlow : d / 4 ≤ l) (hupp : l ≤ d / 3)
    (hglow : 9 * d / 8 ≤ g) (hgupp : g ≤ 4 * d / 3) (hr : 3 * d / 4 ≤ r) :
    2 * d / 3 ≤ pointwiseImprovement (d - l) g r := by
  have hδ : 0 ≤ d - l := by linarith
  have hg1 : 3 * (d - l) / 2 ≤ g := by linarith
  have hg2 : g ≤ 2 * (d - l) := by linarith
  have hrδ : d - l ≤ r := by linarith
  exact (show 2 * d / 3 ≤ d - l by linarith).trans
    (lemma15_repaired_event_bound (d - l) g r hδ hg1 hg2 hrδ)

theorem cumulativeVariance_swap (k n1 n2 n3 : ℕ) :
    cumulativeVariance k ⟨n1, n2, n3⟩ = cumulativeVariance k ⟨n2, n1, n3⟩ := by
  induction k generalizing n1 n2 n3 with
  | zero => rfl
  | succ k ih =>
    simp only [cumulativeVariance, leftStep, rightStep]
    rw [ih (n1 + 1) n2 n3, ih n1 (n2 + 1) n3]
    exact max_comm _ _

/-- New Lemma 17 says every smaller-count arm is optimal. This checks the
equal-count case in addition to draft0's fixed left tie rule. -/
theorem equal_count_actions_equal (k n n3 : ℕ) (m1 m2 : ℝ) :
    leftAction k m1 m2 ⟨n, n, n3⟩ = rightAction k m1 m2 ⟨n, n, n3⟩ := by
  rw [leftAction_eq, rightAction_eq]
  congr 1
  congr 1
  simp only [leftStep, rightStep]
  rw [cumulativeVariance_swap k (n + 1) n n3]

theorem equal_count_right_action_optimal (k n n3 : ℕ) (m1 m2 : ℝ) (hn : 0 < n) :
    payoff (k + 1) m1 m2 ⟨n, n, n3⟩ = rightAction k m1 m2 ⟨n, n, n3⟩ := by
  rw [smaller_count_left_optimal k m1 m2 ⟨n, n, n3⟩ hn hn (by rfl),
    equal_count_actions_equal]


end

end BayesOptimal.Comparison.Gaussian

end

/-! ## Marginal -/
section

open MeasureTheory ProbabilityTheory Set Filter Asymptotics
open scoped MeasureTheory NNReal ENNReal

namespace BayesOptimal.Marginal

noncomputable section

open BayesOptimal.Foundations.Gaussian BayesOptimal.Foundations.TwoArmBellman BayesOptimal.Foundations.Rates
open BayesOptimal.Comparison.Gaussian

/-- Revised Lemma 14: terminal Gaussian simple regret with its density normalization. -/
theorem lemma14_normalized (m1 m2 : ℝ) (v1 v2 : ℝ≥0) (hv : 0 < v1 + v2) :
    twoArmPosteriorLoss m1 m2 v1 v2 =
      (Real.sqrt (2 * Real.pi * (v1 + v2)))⁻¹ *
        unnormalizedLoss (m1 - m2) (v1 + v2) :=
  twoArmPosteriorLoss_normalized m1 m2 v1 v2 hv

theorem pointwiseImprovement_eq (d l r : ℝ) :
    pointwiseImprovement d l r =
      max (r - (d - l)) 0 - max (r - |d - l|) 0 := by
  unfold pointwiseImprovement
  congr 2
  ring

theorem scalar_integrable (d l : ℝ) (v : ℝ≥0) :
    Integrable (pointwiseImprovement d l) (gaussianReal 0 v) := by
  have he : pointwiseImprovement d l =
      fun r : ℝ => max (r - (d - l)) 0 - max (r - |d - l|) 0 := by
    funext r
    exact pointwiseImprovement_eq d l r
  rw [he]
  exact (hinge_integrable (d - l) v).sub (hinge_integrable |d - l| v)

theorem scalar_integral (d l : ℝ) (v : ℝ≥0) :
    (∫ r : ℝ, pointwiseImprovement d l r ∂gaussianReal 0 v) = max (l - d) 0 := by
  simp_rw [pointwiseImprovement_eq]
  rw [integral_sub (hinge_integrable (d - l) v) (hinge_integrable |d - l| v)]
  change hingeLoss (d - l) v - hingeLoss |d - l| v = _
  rw [hingeLoss_sub_abs]
  congr 1
  ring

theorem scalar_event_to_hinge (d l u a : ℝ) (v : ℝ≥0)
    (h : ∀ r ∈ Ici a, u ≤ pointwiseImprovement d l r) :
    u * (gaussianReal 0 v (Ici a)).toReal ≤ max (l - d) 0 := by
  calc
    _ ≤ ∫ r : ℝ in Ici a, pointwiseImprovement d l r ∂gaussianReal 0 v :=
      setIntegral_ge_of_const_le measurableSet_Ici (measure_ne_top _ _) h
        (scalar_integrable d l v).restrict
    _ ≤ ∫ r : ℝ, pointwiseImprovement d l r ∂gaussianReal 0 v :=
      setIntegral_le_integral (scalar_integrable d l v)
        (ae_of_all _ (lemma15_pointwise_nonnegative d l))
    _ = _ := scalar_integral d l v

/-- The exact probability-product lower bound printed in revised Lemma 15. -/
theorem lemma15_g1_lower (gap : ℝ) (vL vR : ℝ≥0) :
    newG1 gap vL vR ≤ oneStepImprovement gap vL vR := by
  rw [oneStepImprovement_eq_hinge]
  have hevent (l : ℝ) (hl : l ∈ Icc (3 * |gap| / 2) (2 * |gap|)) :
      |gap| * (gaussianReal 0 vR (Ici |gap|)).toReal ≤ max (l - |gap|) 0 := by
    apply scalar_event_to_hinge
    intro r hr
    exact lemma15_repaired_event_bound |gap| l r (abs_nonneg _) hl.1 hl.2 hr
  calc
    newG1 gap vL vR = (|gap| * (gaussianReal 0 vR (Ici |gap|)).toReal) *
        (gaussianReal 0 vL (Icc (3 * |gap| / 2) (2 * |gap|))).toReal := by
      unfold newG1
      ring
    _ ≤ ∫ l : ℝ in Icc (3 * |gap| / 2) (2 * |gap|), max (l - |gap|) 0
        ∂gaussianReal 0 vL :=
      setIntegral_ge_of_const_le measurableSet_Icc (measure_ne_top _ _) hevent
        (hinge_integrable |gap| vL).restrict
    _ ≤ hingeLoss |gap| vL :=
      setIntegral_le_integral (hinge_integrable |gap| vL)
        (ae_of_all _ (fun _ => le_max_right _ _))

theorem absolute_shift_hinge_integrable (d : ℝ) (a b : ℝ≥0) :
    Integrable (fun l : ℝ => hingeLoss |d - l| b) (gaussianReal 0 a) := by
  have he (l : ℝ) : hingeLoss |d - l| b =
      hingeLoss (d - l) b - max (l - d) 0 := by
    have h := hingeLoss_sub_abs (d - l) b
    have hn : -(d - l) = l - d := by ring
    rw [hn] at h
    linarith only [h]
  simp_rw [he]
  exact (hinge_smoothing_integrable d a b).sub (hinge_integrable d a)

theorem hinge_increment_integral_shift (d : ℝ) (a b : ℝ≥0) :
    hingeLoss d (a + b) - hingeLoss d a =
      ∫ l : ℝ, hingeLoss |d - l| b ∂gaussianReal 0 a := by
  have he (l : ℝ) : hingeLoss |d - l| b =
      hingeLoss (d - l) b - max (l - d) 0 := by
    have h := hingeLoss_sub_abs (d - l) b
    have hn : -(d - l) = l - d := by ring
    rw [hn] at h
    linarith only [h]
  simp_rw [he]
  rw [integral_sub (hinge_smoothing_integrable d a b) (hinge_integrable d a),
    hinge_smoothing]
  rfl

/-- The exact probability-product lower bound printed in revised Lemma 16,
before substituting the count-dependent variance difference. -/
theorem lemma16_g2_lower (gap : ℝ) (vL vG vR : ℝ≥0) :
    newG2 gap vL vG vR ≤
      hingeLoss |gap| (vL + vG) - hingeLoss |gap| vL := by
  rw [hinge_increment_integral_shift]
  have hevent (l : ℝ) (hl : l ∈ Icc (|gap| / 4) (|gap| / 3)) :
      (2 * |gap| / 3) *
        (gaussianReal 0 vG (Icc (9 * |gap| / 8) (4 * |gap| / 3))).toReal *
        (gaussianReal 0 vR (Ici (3 * |gap| / 4))).toReal ≤ hingeLoss |(|gap| - l)| vG := by
    have hg_event (g : ℝ) (hg : g ∈ Icc (9 * |gap| / 8) (4 * |gap| / 3)) :
        (2 * |gap| / 3) * (gaussianReal 0 vR (Ici (3 * |gap| / 4))).toReal ≤
          max (g - (|gap| - l)) 0 := by
      apply scalar_event_to_hinge
      intro r hr
      exact lemma16_repaired_event_bound |gap| l g r (abs_nonneg _) hl.1 hl.2
        hg.1 hg.2 hr
    rw [abs_of_nonneg (by linarith [hl.2, abs_nonneg gap] : 0 ≤ |gap| - l)]
    calc
      _ = ((2 * |gap| / 3) * (gaussianReal 0 vR (Ici (3 * |gap| / 4))).toReal) *
          (gaussianReal 0 vG (Icc (9 * |gap| / 8) (4 * |gap| / 3))).toReal := by ring
      _ ≤ ∫ g : ℝ in Icc (9 * |gap| / 8) (4 * |gap| / 3),
          max (g - (|gap| - l)) 0 ∂gaussianReal 0 vG :=
        setIntegral_ge_of_const_le measurableSet_Icc (measure_ne_top _ _) hg_event
          (hinge_integrable (|gap| - l) vG).restrict
      _ ≤ hingeLoss (|gap| - l) vG :=
        setIntegral_le_integral (hinge_integrable (|gap| - l) vG)
          (ae_of_all _ (fun _ => le_max_right _ _))
  calc
    newG2 gap vL vG vR = ((2 * |gap| / 3) *
        (gaussianReal 0 vG (Icc (9 * |gap| / 8) (4 * |gap| / 3))).toReal *
        (gaussianReal 0 vR (Ici (3 * |gap| / 4))).toReal) *
        (gaussianReal 0 vL (Icc (|gap| / 4) (|gap| / 3))).toReal := by
      unfold newG2
      ring
    _ ≤ ∫ l : ℝ in Icc (|gap| / 4) (|gap| / 3), hingeLoss |(|gap| - l)| vG
        ∂gaussianReal 0 vL :=
      setIntegral_ge_of_const_le measurableSet_Icc (measure_ne_top _ _) hevent
        (absolute_shift_hinge_integrable |gap| vL vG).restrict
    _ ≤ ∫ l : ℝ, hingeLoss |(|gap| - l)| vG ∂gaussianReal 0 vL :=
      setIntegral_le_integral (absolute_shift_hinge_integrable |gap| vL vG)
        (ae_of_all _ (fun _ => hingeLoss_nonnegative _ _))

end

end BayesOptimal.Marginal

end

/-! ## MarginalTerminal -/
section

open MeasureTheory ProbabilityTheory Set Filter Asymptotics
open scoped MeasureTheory NNReal ENNReal

namespace BayesOptimal.Marginal

noncomputable section

open BayesOptimal.Foundations.Gaussian BayesOptimal.Foundations.Rates BayesOptimal.Foundations.TerminalBounds

def terminalConstant : ℝ := (Real.sqrt (4 * Real.pi))⁻¹

theorem terminalConstant_pos : 0 < terminalConstant := by
  unfold terminalConstant
  positivity

theorem updateVariance_half_budget_lower (T q n : ℕ)
    (hT : T = 2 * q + 1) (hn : 1 ≤ n) (hnq : n ≤ q) :
    4 * invPower 2 T ≤ (updateVariance (n : ℝ≥0) : ℝ) := by
  have hnr : 1 ≤ (n : ℝ) := by exact_mod_cast hn
  have hnqr : (n : ℝ) ≤ q := by exact_mod_cast hnq
  have hTr : (T : ℝ) = 2 * (q : ℝ) + 1 := by exact_mod_cast hT
  have hTpos : 0 < (T : ℝ) := by nlinarith only [hnr, hnqr, hTr]
  have hnprod : (n : ℝ) * ((n : ℝ) + 1) ≤ (q : ℝ) * ((q : ℝ) + 1) := by
    nlinarith only [hnr, hnqr]
  simp only [updateVariance, NNReal.coe_inv, NNReal.coe_mul, NNReal.coe_add,
    NNReal.coe_natCast, NNReal.coe_one, invPower]
  rw [← div_eq_mul_inv, inv_eq_one_div]
  apply (div_le_div_iff₀ (by positivity) (by positivity)).mpr
  nlinarith only [hnprod, hTr]

/-- The revised terminal large-gap range has density at least c*T^-18
on [d+T^-2,d+2*T^-2]. -/
theorem terminal_gaussianPDF_lower22 (T : ℕ) (gap x : ℝ) (v : ℝ≥0)
    (hT : 5 ≤ T) (hgap : |gap| ≤ 10 * Real.sqrt (Real.log (T : ℝ)) / T)
    (hv : 0 < v) (hvu : (v : ℝ) ≤ 2) (hvl : 4 * invPower 2 T ≤ (v : ℝ))
    (hx : x ∈ Icc (|gap| + invPower 2 T) (|gap| + 2 * invPower 2 T)) :
    terminalConstant * invPower 18 T ≤ gaussianPDFReal 0 v x := by
  have hTr : 5 ≤ (T : ℝ) := by exact_mod_cast hT
  have hTp : 0 < (T : ℝ) := by linarith only [hTr]
  have hlog : 1 ≤ Real.log (T : ℝ) := BayesOptimal.Foundations.Drift.log_horizon_ge_one T hT
  have hlog0 : 0 ≤ Real.log (T : ℝ) := by linarith only [hlog]
  have hs : 1 ≤ Real.sqrt (Real.log (T : ℝ)) := by
    simpa using Real.sqrt_le_sqrt hlog
  have hi : 0 ≤ invPower 2 T := invPower_nonneg _ _
  have heps : invPower 2 T ≤ Real.sqrt (Real.log (T : ℝ)) / T := by
    unfold invPower
    rw [inv_eq_one_div]
    apply (div_le_div_iff₀ (by positivity) hTp).mpr
    nlinarith only [hs, hTr]
  have hx0 : 0 ≤ x := by linarith only [hx.1, abs_nonneg gap, hi]
  have hxu : x ≤ 12 * Real.sqrt (Real.log (T : ℝ)) / T := by
    calc
      x ≤ |gap| + 2 * invPower 2 T := hx.2
      _ ≤ 10 * Real.sqrt (Real.log (T : ℝ)) / T +
          2 * (Real.sqrt (Real.log (T : ℝ)) / T) := by gcongr
      _ = _ := by ring
  have hsq : x ^ 2 ≤ (12 * Real.sqrt (Real.log (T : ℝ)) / T) ^ 2 :=
    (sq_le_sq₀ hx0 (by positivity)).mpr hxu
  have heq : (12 * Real.sqrt (Real.log (T : ℝ)) / T) ^ 2 =
      144 * Real.log (T : ℝ) * invPower 2 T := by
    rw [div_pow, mul_pow, Real.sq_sqrt hlog0]
    unfold invPower
    ring
  rw [heq] at hsq
  have hvquad := mul_le_mul_of_nonneg_left hvl (show 0 ≤ 36 * Real.log (T : ℝ) by positivity)
  have hquad : x ^ 2 ≤ 36 * Real.log (T : ℝ) * (v : ℝ) := by
    nlinarith only [hsq, hvquad]
  have hquot : x ^ 2 / (2 * (v : ℝ)) ≤ 18 * Real.log (T : ℝ) := by
    apply (div_le_iff₀ (by positivity)).mpr
    nlinarith only [hquad]
  have hexp : Real.exp (-18 * Real.log (T : ℝ)) ≤
      Real.exp (-x ^ 2 / (2 * (v : ℝ))) := by
    apply Real.exp_le_exp.mpr
    rw [neg_div]
    linarith only [hquot]
  have hexpeq : Real.exp (-18 * Real.log (T : ℝ)) = invPower 18 T := by
    exact BayesOptimal.Foundations.PredictiveBound.exp_neg_nat_log 18 hTp
  rw [hexpeq] at hexp
  have hnorm : terminalConstant ≤ (Real.sqrt (2 * Real.pi * (v : ℝ)))⁻¹ := by
    unfold terminalConstant
    apply (inv_le_inv₀ (by positivity) (by positivity)).mpr
    apply Real.sqrt_le_sqrt
    nlinarith only [hvu, Real.pi_pos]
  unfold gaussianPDFReal
  simp only [sub_zero]
  exact mul_le_mul hnorm hexp (invPower_nonneg _ _) (by positivity)

theorem terminal_interval_lower22 (T : ℕ) (gap : ℝ) (v : ℝ≥0)
    (hT : 5 ≤ T) (hgap : |gap| ≤ 10 * Real.sqrt (Real.log (T : ℝ)) / T)
    (hv : 0 < v) (hvu : (v : ℝ) ≤ 2) (hvl : 4 * invPower 2 T ≤ (v : ℝ)) :
    terminalConstant * invPower 20 T ≤
      (gaussianReal 0 v (Icc (|gap| + invPower 2 T) (|gap| + 2 * invPower 2 T))).toReal := by
  have hi := invPower_nonneg 2 T
  have hmass : (gaussianReal 0 v
      (Icc (|gap| + invPower 2 T) (|gap| + 2 * invPower 2 T))).toReal =
      ∫ x in Icc (|gap| + invPower 2 T) (|gap| + 2 * invPower 2 T), gaussianPDFReal 0 v x := by
    rw [gaussianReal_apply_eq_integral 0 (ne_of_gt hv), ENNReal.toReal_ofReal]
    exact integral_nonneg (gaussianPDFReal_nonneg _ _)
  have hmono : (∫ _ in Icc (|gap| + invPower 2 T) (|gap| + 2 * invPower 2 T),
      terminalConstant * invPower 18 T) ≤
      ∫ x in Icc (|gap| + invPower 2 T) (|gap| + 2 * invPower 2 T), gaussianPDFReal 0 v x := by
    apply setIntegral_mono_on (integrableOn_const isCompact_Icc.measure_ne_top)
      (integrable_gaussianPDFReal 0 v).integrableOn measurableSet_Icc
    intro x hx
    exact terminal_gaussianPDF_lower22 T gap x v hT hgap hv hvu hvl hx
  have hconst : (∫ _ in Icc (|gap| + invPower 2 T) (|gap| + 2 * invPower 2 T),
      terminalConstant * invPower 18 T) = terminalConstant * invPower 20 T := by
    rw [setIntegral_const, smul_eq_mul, measureReal_def, Real.volume_Icc,
      ENNReal.toReal_ofReal (by linarith only [hi])]
    rw [← invPower_product 18 2 T]
    ring
  rw [← hconst, hmass]
  exact hmono

/-- Revised Lemma 15's separate terminal Omega(T^-22) conclusion, including
zero gap, with an explicit uniform positive constant. -/
theorem lemma15_terminal_uniform22 (T q n : ℕ) (gap : ℝ) (vR : ℝ≥0)
    (hT : 5 ≤ T) (hodd : T = 2 * q + 1) (hn : 1 ≤ n) (hnq : n ≤ q)
    (hgap : |gap| ≤ 10 * Real.sqrt (Real.log (T : ℝ)) / T) :
    terminalConstant * invPower 22 T ≤
      oneStepImprovement gap (updateVariance (n : ℝ≥0)) vR := by
  have hnT : n < T := by omega
  have hb := updateVariance_count_bounds n T hn hnT
  have hp : 0 < updateVariance (n : ℝ≥0) := by
    have hnp : 0 < (n : ℝ≥0) := by exact_mod_cast (show 0 < n by omega)
    unfold updateVariance
    positivity
  have hvl := updateVariance_half_budget_lower T q n hodd hn hnq
  have hm := terminal_interval_lower22 T gap (updateVariance (n : ℝ≥0)) hT hgap hp
    (by linarith only [hb.2]) hvl
  have hscale := mul_le_mul_of_nonneg_left hm (invPower_nonneg 2 T)
  have hl := oneStepImprovement_ge_corrected_bound gap (invPower 2 T)
    (updateVariance (n : ℝ≥0)) vR
  unfold correctedImprovementLowerBound at hl
  calc
    terminalConstant * invPower 22 T = invPower 2 T * (terminalConstant * invPower 20 T) := by
      rw [← invPower_product 2 20 T]
      ring
    _ ≤ invPower 2 T *
        (gaussianReal 0 (updateVariance (n : ℝ≥0))
          (Icc (|gap| + invPower 2 T) (|gap| + 2 * invPower 2 T))).toReal := hscale
    _ ≤ _ := hl

end

end BayesOptimal.Marginal

end

/-! ## Forecast -/
section

open MeasureTheory ProbabilityTheory Set
open scoped NNReal ENNReal
open BayesOptimal.Foundations.Counts BayesOptimal.Foundations.Drift BayesOptimal.Foundations.PredictiveBound

namespace BayesOptimal.Forecast

noncomputable section

def finalVariance (n1 n2 f1 f2 : ℕ) : ℝ :=
  (1 / (n1 : ℝ) - 1 / (f1 : ℝ)) + (1 / (n2 : ℝ) - 1 / (f2 : ℝ))

theorem finalVariance_nonnegative (n1 n2 f1 f2 : ℕ)
    (hn1 : 1 ≤ n1) (hn2 : 1 ≤ n2) (h1 : n1 ≤ f1) (h2 : n2 ≤ f2) :
    0 ≤ finalVariance n1 n2 f1 f2 := by
  exact add_nonneg (inverse_difference_nonnegative _ _ (by omega) h1)
    (inverse_difference_nonnegative _ _ (by omega) h2)

theorem finalVariance_le_two (n1 n2 f1 f2 : ℕ)
    (hn1 : 1 ≤ n1) (hn2 : 1 ≤ n2) : finalVariance n1 n2 f1 f2 ≤ 2 := by
  have h1 : 1 / (n1 : ℝ) ≤ 1 := by
    apply (div_le_iff₀ (by exact_mod_cast (show 0 < n1 by omega))).mpr
    simpa only [one_mul] using (show (1 : ℝ) ≤ n1 by exact_mod_cast hn1)
  have h2 : 1 / (n2 : ℝ) ≤ 1 := by
    apply (div_le_iff₀ (by exact_mod_cast (show 0 < n2 by omega))).mpr
    simpa only [one_mul] using (show (1 : ℝ) ≤ n2 by exact_mod_cast hn2)
  have hf1 : 0 ≤ 1 / (f1 : ℝ) := by positivity
  have hf2 : 0 ≤ 1 / (f2 : ℝ) := by positivity
  unfold finalVariance
  linarith

theorem finalVariance_residual_lower (q n1 n2 f1 f2 : ℕ)
    (hn1 : 1 ≤ n1) (hn2 : 1 ≤ n2) (h1 : n1 ≤ f1) (h2 : n2 ≤ f2)
    (hf1 : f1 ≤ q) (hf2 : f2 ≤ q) (hprogress : n1 < f1 ∨ n2 < f2) :
    1 / ((q : ℝ) * ((q : ℝ) - 1)) ≤ finalVariance n1 n2 f1 f2 := by
  unfold finalVariance
  rcases hprogress with h | h
  · have ha := inverse_difference_preterminal_lower_bound n1 f1 q hn1 h hf1
    have hb := inverse_difference_nonnegative n2 f2 (by omega) h2
    linarith
  · have ha := inverse_difference_preterminal_lower_bound n2 f2 q hn2 h hf2
    have hb := inverse_difference_nonnegative n1 f1 (by omega) h1
    linarith

theorem finalVariance_lower (T n1 n2 f1 f2 : ℕ)
    (hn1 : 1 ≤ n1) (hn2 : 1 ≤ n2) (h1 : n1 ≤ f1) (h2 : n2 ≤ f2)
    (hf1 : f1 ≤ T) (hf2 : f2 ≤ T) (hprogress : n1 < f1 ∨ n2 < f2) :
    1 / (T : ℝ) ^ 2 ≤ finalVariance n1 n2 f1 f2 := by
  unfold finalVariance
  rcases hprogress with h | h
  · have ha := inverse_difference_lower_bound n1 f1 T (by omega) h hf1
    have hb := inverse_difference_nonnegative n2 f2 (by omega) h2
    linarith
  · have ha := inverse_difference_lower_bound n2 f2 T (by omega) h hf2
    have hb := inverse_difference_nonnegative n1 f1 (by omega) h1
    linarith

theorem finalVariance_anchor (q n1 n2 f1 f2 : ℕ) (hq : 2 ≤ q)
    (hn1 : 1 ≤ n1) (hn2 : 1 ≤ n2) (h1 : n1 ≤ f1) (h2 : n2 ≤ f2)
    (hf : (f1 = q ∧ f2 = q - 1) ∨ (f1 = q - 1 ∧ f2 = q))
    (hprogress : n1 < f1 ∨ n2 < f2) :
    (1 / (n1 : ℝ) - 1 / (q : ℝ)) + (1 / (n2 : ℝ) - 1 / (q : ℝ)) ≤
      2 * finalVariance n1 n2 f1 f2 := by
  have hf1 : f1 ≤ q := by rcases hf with h | h <;> omega
  have hf2 : f2 ≤ q := by rcases hf with h | h <;> omega
  have hl := finalVariance_residual_lower q n1 n2 f1 f2 hn1 hn2 h1 h2 hf1 hf2 hprogress
  have hq0 : (q : ℝ) ≠ 0 := by exact_mod_cast (show q ≠ 0 by omega)
  have hqsub : (q : ℝ) - 1 ≠ 0 := by
    have hqr : (2 : ℝ) ≤ q := by exact_mod_cast hq
    linarith
  have hcast : ((q - 1 : ℕ) : ℝ) = (q : ℝ) - 1 := by
    rw [Nat.cast_sub (show 1 ≤ q by omega), Nat.cast_one]
  have hid : (1 / (n1 : ℝ) - 1 / (q : ℝ)) + (1 / (n2 : ℝ) - 1 / (q : ℝ)) =
      finalVariance n1 n2 f1 f2 + 1 / ((q : ℝ) * ((q : ℝ) - 1)) := by
    unfold finalVariance
    rcases hf with h | h
    · rw [h.1, h.2, hcast]
      field_simp
      ring
    · rw [h.1, h.2, hcast]
      field_simp
      ring
  linarith

theorem general_drift160 (T q t : Nat) (CU : Real) (p : MeanPath) (c : Counts)
    (hT : T = 2 * q + 1) (ht : 4 <= t) (hpre : t < T)
    (hc : horizonConsistent t c) (hW : BayesOptimal.Comparison.newW T q CU p c)
    (f1 f2 : Nat) (hn1 : c.n1 <= f1) (hn2 : c.n2 <= f2)
    (hf : (f1 = q ∧ f2 = q - 1) ∨ (f1 = q - 1 ∧ f2 = q)) :
    (terminalGap p c) ^ 2 <= 160 * Real.log (T : Real) * finalVariance c.n1 c.n2 f1 f2 := by
  rcases hc with ⟨hc1, hc2, hc3, htotal⟩
  rcases hW with ⟨_hX, hY1, hY2, hZ1, hZ2, h1, h2, _h3⟩
  have hq : 2 ≤ q := by omega
  have hT5 : 5 ≤ T := by omega
  have hTreal : 5 ≤ (T : ℝ) := by exact_mod_cast hT5
  have hlog := log_horizon_ge_one T hT5
  have hlog0 : 0 ≤ Real.log (T : ℝ) := by linarith
  have hS1 := reciprocalSqSum_nonnegative c.n1 q
  have hS2 := reciprocalSqSum_nonnegative c.n2 q
  have hB1 := reciprocalSqSum_bound c.n1 q hc1 h1
  have hB2 := reciprocalSqSum_bound c.n2 q hc2 h2
  have hf1 : f1 <= T := by rcases hf with h | h <;> omega
  have hf2 : f2 <= T := by rcases hf with h | h <;> omega
  have hprogress : c.n1 < f1 ∨ c.n2 < f2 := by rcases hf with h | h <;> omega
  have hanchor := finalVariance_anchor q c.n1 c.n2 f1 f2 hq hc1 hc2 hn1 hn2 hf hprogress
  have hSsum : reciprocalSqSum c.n1 q + reciprocalSqSum c.n2 q ≤
      4 * finalVariance c.n1 c.n2 f1 f2 := by linarith
  have hV0 := finalVariance_nonnegative c.n1 c.n2 f1 f2 hc1 hc2 hn1 hn2
  have hVl := finalVariance_lower T c.n1 c.n2 f1 f2 hc1 hc2 hn1 hn2 hf1 hf2 hprogress
  have hZ1' := hZ1 c.n1 hc1 h1
  have hZ2' := hZ2 c.n2 hc2 h2
  have hanchors : |p 1 q - p 2 q| ≤ 2 / (T : ℝ) ^ 2 := by
    have habs : |p 1 q - p 2 q| ≤ |p 1 q| + |p 2 q| := by
      simpa only [← sub_eq_add_neg, abs_neg] using abs_add_le (p 1 q) (-p 2 q)
    unfold eventY at hY1 hY2
    calc
      |p 1 q - p 2 q| ≤ |p 1 q| + |p 2 q| := habs
      _ ≤ 1 / (T : ℝ) ^ 2 + 1 / (T : ℝ) ^ 2 := add_le_add hY1 hY2
      _ = 2 / (T : ℝ) ^ 2 := by ring
  have htri1 := abs_sub_le (p 1 c.n1) (p 1 q) (p 2 c.n2)
  have htri2 := abs_sub_le (p 1 q) (p 2 q) (p 2 c.n2)
  rw [abs_sub_comm (p 2 q) (p 2 c.n2)] at htri2
  let A : ℝ := 3 * Real.sqrt (Real.log (T : ℝ)) * Real.sqrt (reciprocalSqSum c.n1 q)
  let B : ℝ := 3 * Real.sqrt (Real.log (T : ℝ)) * Real.sqrt (reciprocalSqSum c.n2 q)
  let C : ℝ := 2 / (T : ℝ) ^ 2
  have hA0 : 0 ≤ A := by dsimp [A]; positivity
  have hB0 : 0 ≤ B := by dsimp [B]; positivity
  have hC0 : 0 ≤ C := by dsimp [C]; positivity
  have habs : |terminalGap p c| ≤ A + B + C := by
    dsimp [A, B, C]
    unfold terminalGap
    linarith only [htri1, htri2, hanchors, hZ1', hZ2']
  have hsq : (terminalGap p c) ^ 2 ≤ (A + B + C) ^ 2 := by
    have h := (sq_le_sq₀ (abs_nonneg (terminalGap p c))
      (show 0 ≤ A + B + C by positivity)).mpr habs
    simpa only [sq_abs] using h
  have hthree : (A + B + C) ^ 2 ≤ 3 * (A ^ 2 + B ^ 2 + C ^ 2) := by
    nlinarith only [sq_nonneg (A - B), sq_nonneg (A - C), sq_nonneg (B - C)]
  have hAsq : A ^ 2 = 9 * Real.log (T : ℝ) * reciprocalSqSum c.n1 q := by
    dsimp [A]
    rw [mul_pow, mul_pow, Real.sq_sqrt hlog0, Real.sq_sqrt hS1]
    norm_num
  have hBsq : B ^ 2 = 9 * Real.log (T : ℝ) * reciprocalSqSum c.n2 q := by
    dsimp [B]
    rw [mul_pow, mul_pow, Real.sq_sqrt hlog0, Real.sq_sqrt hS2]
    norm_num
  have hCsq : C ^ 2 = 4 / (T : ℝ) ^ 4 := by
    dsimp [C]
    rw [div_pow, ← pow_mul]
    norm_num
  have hSscaled := mul_le_mul_of_nonneg_left hSsum hlog0
  have hinv : 1 / (T : ℝ) ^ 4 ≤ 1 / (T : ℝ) ^ 2 := by
    apply (div_le_div_iff₀ (by positivity) (by positivity)).mpr
    have hsquare : 1 ≤ (T : ℝ) ^ 2 := by nlinarith only [hTreal]
    have hpow := mul_le_mul_of_nonneg_right hsquare (sq_nonneg (T : ℝ))
    nlinarith only [hpow]
  have hVscaled : finalVariance c.n1 c.n2 f1 f2 ≤
      Real.log (T : ℝ) * finalVariance c.n1 c.n2 f1 f2 := by
    simpa using mul_le_mul_of_nonneg_right hlog hV0
  have hinvFinal : 1 / (T : ℝ) ^ 4 ≤
      Real.log (T : ℝ) * finalVariance c.n1 c.n2 f1 f2 :=
    hinv.trans (hVl.trans hVscaled)
  have hinvScaled : 4 / (T : ℝ) ^ 4 ≤
      4 * (Real.log (T : ℝ) * finalVariance c.n1 c.n2 f1 f2) := by
    calc
      4 / (T : ℝ) ^ 4 = 4 * (1 / (T : ℝ) ^ 4) := by ring
      _ ≤ 4 * (Real.log (T : ℝ) * finalVariance c.n1 c.n2 f1 f2) :=
        mul_le_mul_of_nonneg_left hinvFinal (by norm_num)
  rw [hAsq, hBsq, hCsq] at hthree
  nlinarith only [hsq, hthree, hSscaled, hinvScaled, mul_nonneg hlog0 hV0]


theorem general_forecast_probability170 (T q t : ℕ) (CU : ℝ)
    (p : MeanPath) (c : Counts)
    (hT : T = 2 * q + 1) (ht : 4 ≤ t) (hpre : t < T)
    (hc : horizonConsistent t c) (hW : BayesOptimal.Comparison.newW T q CU p c)
    (f1 f2 : ℕ) (hn1 : c.n1 ≤ f1) (hn2 : c.n2 ≤ f2)
    (hf : (f1 = q ∧ f2 = q - 1) ∨ (f1 = q - 1 ∧ f2 = q))
    (v : ℝ≥0) (hvcoe : (v : ℝ) = finalVariance c.n1 c.n2 f1 f2) :
    lowerConstant * BayesOptimal.Foundations.Rates.invPower 170 T ≤
      (gaussianReal (terminalGap p c) v
        (Icc (BayesOptimal.Foundations.Rates.invPower 2 T) (2 * BayesOptimal.Foundations.Rates.invPower 2 T))).toReal := by
  have hprogress : c.n1 < f1 ∨ c.n2 < f2 := by
    rcases hc with ⟨_, _, hc3, htotal⟩
    rcases hf with h | h <;> omega
  have hf1 : f1 ≤ T := by rcases hf with h | h <;> omega
  have hf2 : f2 ≤ T := by rcases hf with h | h <;> omega
  have hlower : BayesOptimal.Foundations.Rates.invPower 2 T ≤ (v : ℝ) := by
    rw [BayesOptimal.Foundations.Rates.invPower, inv_eq_one_div, hvcoe]
    exact finalVariance_lower T c.n1 c.n2 f1 f2 hc.1 hc.2.1 hn1 hn2 hf1 hf2 hprogress
  have hv : 0 < v := by
    have hpos : 0 < BayesOptimal.Foundations.Rates.invPower 2 T := BayesOptimal.Foundations.Rates.invPower_pos 2 T (by omega)
    exact hpos.trans_le hlower
  have hupper : (v : ℝ) ≤ 2 := by
    rw [hvcoe]
    exact finalVariance_le_two c.n1 c.n2 f1 f2 hc.1 hc.2.1
  have hδ : (terminalGap p c) ^ 2 ≤ 160 * Real.log (T : ℝ) * (v : ℝ) := by
    rw [hvcoe]
    exact general_drift160 T q t CU p c hT ht hpre hc hW f1 f2 hn1 hn2 hf
  have hm := gaussian_interval_probability_lower_nat 160 T (by omega) hv hupper hlower hδ
  exact (mul_le_mul_of_nonneg_left
    (BayesOptimal.Foundations.Rates.invPower_antitone (by norm_num : 162 ≤ 170) (by omega : 1 ≤ T))
    lowerConstant_pos.le).trans hm

end

end BayesOptimal.Forecast

end

/-! ## ForecastTerminal -/
section

open MeasureTheory ProbabilityTheory Set
open scoped NNReal ENNReal
open BayesOptimal.Foundations.Counts BayesOptimal.Foundations.Drift

namespace BayesOptimal.Forecast

noncomputable section

theorem terminal_gap_bound (T q : ℕ) (CU : ℝ) (p : MeanPath) (c : Counts)
    (hT : T = 2 * q + 1) (hlarge : 9 ≤ T)
    (hW : BayesOptimal.Comparison.newW T q CU p c)
    (hf : (c.n1 = q ∧ c.n2 = q - 1) ∨ (c.n1 = q - 1 ∧ c.n2 = q)) :
    |terminalGap p c| ≤ 10 * Real.sqrt (Real.log (T : ℝ)) / (T : ℝ) := by
  rcases hW with ⟨_, hY1, hY2, hZ1, hZ2, h1, h2, _⟩
  have hq : 2 ≤ q := by omega
  have hTr : (9 : ℝ) ≤ T := by exact_mod_cast hlarge
  have hTp : 0 < (T : ℝ) := by linarith
  have hqr : (2 : ℝ) ≤ q := by exact_mod_cast hq
  have hqsub : 0 < ((q - 1 : ℕ) : ℝ) := by exact_mod_cast (show 0 < q - 1 by omega)
  have hn1 : 1 ≤ c.n1 := by rcases hf with h | h <;> omega
  have hn2 : 1 ≤ c.n2 := by rcases hf with h | h <;> omega
  have hsumq : reciprocalSqSum q q = 0 := by simp [reciprocalSqSum]
  have hsumprev : reciprocalSqSum (q - 1) q = 1 / ((q - 1 : ℕ) : ℝ) ^ 2 := by
    unfold reciprocalSqSum
    have hIco : Finset.Ico (q - 1) q = {q - 1} := Nat.Ico_pred_singleton (by omega)
    rw [hIco, Finset.sum_singleton]
  have hsqrtprev : Real.sqrt (reciprocalSqSum (q - 1) q) = 1 / ((q - 1 : ℕ) : ℝ) := by
    rw [hsumprev]
    have he : 1 / ((q - 1 : ℕ) : ℝ) ^ 2 = (1 / ((q - 1 : ℕ) : ℝ)) ^ 2 := by ring
    rw [he, Real.sqrt_sq (by positivity)]
  have hroots : Real.sqrt (reciprocalSqSum c.n1 q) +
      Real.sqrt (reciprocalSqSum c.n2 q) = 1 / ((q - 1 : ℕ) : ℝ) := by
    rcases hf with h | h
    · rw [h.1, h.2, hsumq, hsqrtprev]
      simp
    · rw [h.1, h.2, hsumq, hsqrtprev]
      simp
  have hZ1' := hZ1 c.n1 hn1 h1
  have hZ2' := hZ2 c.n2 hn2 h2
  have htri1 := abs_sub_le (p 1 c.n1) (p 1 q) (p 2 c.n2)
  have htri2 := abs_sub_le (p 1 q) (p 2 q) (p 2 c.n2)
  rw [abs_sub_comm (p 2 q) (p 2 c.n2)] at htri2
  have hanchor := abs_sub (p 1 q) (p 2 q)
  unfold eventY at hY1 hY2
  have hanchors : |p 1 q - p 2 q| ≤ 2 / (T : ℝ) ^ 2 := by
    calc
      _ ≤ |p 1 q| + |p 2 q| := hanchor
      _ ≤ 1 / (T : ℝ) ^ 2 + 1 / (T : ℝ) ^ 2 := add_le_add hY1 hY2
      _ = _ := by ring
  have habs : |terminalGap p c| ≤
      3 * Real.sqrt (Real.log (T : ℝ)) *
        (Real.sqrt (reciprocalSqSum c.n1 q) + Real.sqrt (reciprocalSqSum c.n2 q)) +
      2 / (T : ℝ) ^ 2 := by
    unfold terminalGap
    nlinarith only [htri1, htri2, hanchors, hZ1', hZ2']
  rw [hroots] at habs
  have hrecip : 1 / ((q - 1 : ℕ) : ℝ) ≤ 3 / (T : ℝ) := by
    apply (div_le_div_iff₀ hqsub hTp).mpr
    have hcast : ((q - 1 : ℕ) : ℝ) = (q : ℝ) - 1 := by
      rw [Nat.cast_sub (show 1 ≤ q by omega), Nat.cast_one]
    have hTcast : (T : ℝ) = 2 * (q : ℝ) + 1 := by exact_mod_cast hT
    rw [hcast]
    linarith
  have hlog := log_horizon_ge_one T (by omega)
  have hsqrt : 1 ≤ Real.sqrt (Real.log (T : ℝ)) := Real.one_le_sqrt.mpr hlog
  have htiny : 2 / (T : ℝ) ^ 2 ≤ Real.sqrt (Real.log (T : ℝ)) / (T : ℝ) := by
    have ha : 2 / (T : ℝ) ^ 2 ≤ 1 / (T : ℝ) := by
      apply (div_le_div_iff₀ (by positivity) hTp).mpr
      nlinarith only [hTr]
    exact ha.trans (div_le_div_of_nonneg_right hsqrt hTp.le)
  have hscale := mul_le_mul_of_nonneg_left hrecip
    (by positivity : 0 ≤ 3 * Real.sqrt (Real.log (T : ℝ)))
  calc
    |terminalGap p c| ≤ _ := habs
    _ ≤ 3 * Real.sqrt (Real.log (T : ℝ)) * (3 / (T : ℝ)) +
        Real.sqrt (Real.log (T : ℝ)) / (T : ℝ) := add_le_add hscale htiny
    _ = _ := by ring

end

end BayesOptimal.Forecast

end

/-! ## PolicyChoice -/
section

open MeasureTheory ProbabilityTheory Filter Asymptotics
open scoped NNReal ENNReal

namespace BayesOptimal.PolicyChoice

open BayesOptimal.Foundations.Counts BayesOptimal.Foundations.DynamicPolicy BayesOptimal.Foundations.Rates BayesOptimal.Foundations.Gaussian
open BayesOptimal.Foundations.TerminalBounds BayesOptimal.Foundations.PredictiveBound BayesOptimal.Foundations.ThreeArmComparison
open BayesOptimal.Exclusion BayesOptimal.ExclusionPerm BayesOptimal.ExclusionBounds BayesOptimal.ExclusionTail
open BayesOptimal.Comparison

noncomputable section

def gainC : ℝ := gainConstant * lowerConstant
def comparisonC : ℝ := comparisonConstant * lowerConstant

theorem gainC_pos : 0 < gainC := mul_pos gainConstant_positive lowerConstant_pos
theorem comparisonC_pos : 0 < comparisonC := mul_pos comparisonConstant_positive lowerConstant_pos

theorem lemma6_upper (T q t : ℕ) (CU : ℝ) (p : MeanPath) (c : Counts)
    (hT : 5 ≤ T) (hCU : 0 < CU) (hcut : 180 < (CU - 6)^2 / 4)
    (hc : horizonConsistent t c) (hW : newW T q CU p c) :
    EBI (T - t) (modelCounts c) (modelMeans p c) 2 ≤ paperG0 T CU :=
  (lemma12_k3 _ _ _ _ (modelCounts_positive t c hc)).trans
    (lemma11_from_equation11 T q t CU p c hT hCU hcut hc hW)

theorem binary_EBI_lower (k : ℕ) (c : BayesOptimal.Foundations.BayesianModel.Counts)
    (m : BayesOptimal.Foundations.BayesianModel.Means) (i : BayesOptimal.Foundations.BayesianModel.Arm)
    (hc : ∀ j, 0 < c j) :
    twoAction k c m i - twoValue k c m - exclusion c m 2 ≤ EBI k c m i := by
  rw [EBI_eq k c m i (hc i)]
  have ha := (action_comparison k c m i hc).1
  have hv := (value_comparison k c m hc).2
  have hs := stateSlack_le_exclusion c m
  linarith only [ha, hv, hs]

theorem binary_action_gap_lower (k : ℕ) (c : BayesOptimal.Foundations.BayesianModel.Counts)
    (m : BayesOptimal.Foundations.BayesianModel.Means) (i j : BayesOptimal.Foundations.BayesianModel.Arm)
    (hc : ∀ a, 0 < c a) :
    twoAction k c m j - twoAction k c m i - exclusion c m 2 ≤
      BayesOptimal.Foundations.BayesianModel.action k c m j - BayesOptimal.Foundations.BayesianModel.action k c m i := by
  have hi := (action_comparison k c m i hc).2
  have hj := (action_comparison k c m j hc).1
  have hs := stateSlack_le_exclusion c m
  linarith only [hi, hj, hs]

theorem lemma7_individual_lower (T q t : ℕ) (CU : ℝ) (p : MeanPath) (c : Counts)
    (hT : T = 2*q+1) (ht : 4 ≤ t) (hpre : t < T) (hCU : 10 ≤ CU)
    (hc : horizonConsistent t c) (hW : newW T q CU p c) :
    gainC * invPower 176 T - paperG0 T CU ≤ EBI (T-t) (modelCounts c) (modelMeans p c) 0 ∧
    gainC * invPower 176 T - paperG0 T CU ≤ EBI (T-t) (modelCounts c) (modelMeans p c) 1 := by
  have hg := BayesOptimal.Dynamic.lemma19_individual_gains T q t CU p c hT ht hpre hc hW
  have he := lemma11 T q t CU p c (by omega) hCU hc hW
  have h0 := binary_EBI_lower (T-t) (modelCounts c) (modelMeans p c) 0
    (modelCounts_positive t c hc)
  have h1 := binary_EBI_lower (T-t) (modelCounts c) (modelMeans p c) 1
    (modelCounts_positive t c hc)
  rw [twoAction_model_zero, twoValue_model] at h0
  rw [twoAction_model_one, twoValue_model] at h1
  change gainC * invPower 176 T ≤ _ ∧ gainC * invPower 176 T ≤ _ at hg
  constructor <;> linarith only [hg.1, hg.2, he, h0, h1]

theorem lemma7_saturated_left (T q t : ℕ) (CU : ℝ) (p : MeanPath) (c : Counts)
    (hT : T = 2*q+1) (ht : 4 ≤ t) (hpre : t < T) (hCU : 10 ≤ CU)
    (hc : horizonConsistent t c) (hW : newW T q CU p c) (hsat : c.n1 = q) :
    comparisonC * invPower 178 T - paperG0 T CU ≤
      BayesOptimal.Foundations.BayesianModel.action (T-t) (modelCounts c) (modelMeans p c) 1 -
      BayesOptimal.Foundations.BayesianModel.action (T-t) (modelCounts c) (modelMeans p c) 0 := by
  have hg := BayesOptimal.Dynamic.lemma19_saturated_left_gap T q t CU p c hT ht hpre hc hW hsat
  have he := lemma11 T q t CU p c (by omega) hCU hc hW
  have h := binary_action_gap_lower (T-t) (modelCounts c) (modelMeans p c) 0 1
    (modelCounts_positive t c hc)
  rw [twoAction_model_zero, twoAction_model_one] at h
  change comparisonC * invPower 178 T ≤ _ at hg
  linarith only [hg, he, h]

theorem lemma7_saturated_right (T q t : ℕ) (CU : ℝ) (p : MeanPath) (c : Counts)
    (hT : T = 2*q+1) (ht : 4 ≤ t) (hpre : t < T) (hCU : 10 ≤ CU)
    (hc : horizonConsistent t c) (hW : newW T q CU p c) (hsat : c.n2 = q) :
    comparisonC * invPower 178 T - paperG0 T CU ≤
      BayesOptimal.Foundations.BayesianModel.action (T-t) (modelCounts c) (modelMeans p c) 0 -
      BayesOptimal.Foundations.BayesianModel.action (T-t) (modelCounts c) (modelMeans p c) 1 := by
  have hg := BayesOptimal.Dynamic.lemma19_saturated_right_gap T q t CU p c hT ht hpre hc hW hsat
  have he := lemma11 T q t CU p c (by omega) hCU hc hW
  have h := binary_action_gap_lower (T-t) (modelCounts c) (modelMeans p c) 1 0
    (modelCounts_positive t c hc)
  rw [twoAction_model_zero, twoAction_model_one] at h
  change comparisonC * invPower 178 T ≤ _ at hg
  linarith only [hg, he, h]

theorem terminal_pair (T q : ℕ) (c : Counts) (hT : T = 2*q+1)
    (hc : horizonConsistent T c) (h1 : c.n1 ≤ q) (h2 : c.n2 ≤ q) :
    (c.n1 = q ∧ c.n2 = q-1) ∨ (c.n1 = q-1 ∧ c.n2 = q) := by
  rcases hc with ⟨_, _, h3, hs⟩
  omega

theorem lemma8_individual_lower (T q : ℕ) (CU : ℝ) (p : MeanPath) (c : Counts)
    (hT : T = 2*q+1) (hlarge : 9 ≤ T) (hCU : 10 ≤ CU)
    (hc : horizonConsistent T c) (hW : newW T q CU p c) :
    BayesOptimal.Marginal.terminalConstant * invPower 22 T - paperG0 T CU ≤
      EBI 0 (modelCounts c) (modelMeans p c) 0 ∧
    BayesOptimal.Marginal.terminalConstant * invPower 22 T - paperG0 T CU ≤
      EBI 0 (modelCounts c) (modelMeans p c) 1 := by
  have hpair := terminal_pair T q c hT hc hW.2.2.2.2.2.1 hW.2.2.2.2.2.2.1
  have hd := BayesOptimal.Forecast.terminal_gap_bound T q CU p c hT hlarge hW hpair
  have hg1 := BayesOptimal.Marginal.lemma15_terminal_uniform22 T q c.n1 (terminalGap p c) 0
    (by omega) hT hc.1 hW.2.2.2.2.2.1 hd
  have hg2 := BayesOptimal.Marginal.lemma15_terminal_uniform22 T q c.n2 (terminalGap p c) 0
    (by omega) hT hc.2.1 hW.2.2.2.2.2.2.1 hd
  rw [oneStepImprovement_eq_hinge] at hg1 hg2
  have he := lemma11 T q T CU p c (by omega) hCU hc hW
  have h0 := binary_EBI_lower 0 (modelCounts c) (modelMeans p c) 0 (modelCounts_positive T c hc)
  have h1 := binary_EBI_lower 0 (modelCounts c) (modelMeans p c) 1 (modelCounts_positive T c hc)
  rw [twoAction_model_zero, twoValue_model, BayesOptimal.Foundations.TwoArmBellman.leftAction_eq,
    BayesOptimal.Foundations.TwoArmBellman.payoff_eq] at h0
  rw [twoAction_model_one, twoValue_model, BayesOptimal.Foundations.TwoArmBellman.rightAction_eq,
    BayesOptimal.Foundations.TwoArmBellman.payoff_eq] at h1
  simp only [BayesOptimal.Foundations.TwoArmBellman.cumulativeVariance, add_zero] at h0 h1
  have hz (x : ℝ) : hingeLoss x 0 = max (-x) 0 := by
    simp only [hingeLoss, gaussianReal_zero_var, integral_dirac, zero_sub]
  rw [hz] at h0 h1
  have hs1 := hingeLoss_sub_abs (p 2 c.n2 - p 1 c.n1) (updateVariance (c.n1 : ℝ≥0))
  have hs2 := hingeLoss_sub_abs (p 2 c.n2 - p 1 c.n1) (updateVariance (c.n2 : ℝ≥0))
  have hdabs : |p 2 c.n2 - p 1 c.n1| = |terminalGap p c| := abs_sub_comm _ _
  rw [hdabs] at hs1 hs2
  constructor <;> linarith only [hg1, hg2, he, h0, h1, hs1, hs2]

end
end BayesOptimal.PolicyChoice

end

/-! ## ChoiceAsymptotic -/
section

open Filter Asymptotics

namespace BayesOptimal.PolicyChoice

open BayesOptimal.Foundations.Counts BayesOptimal.Foundations.DynamicPolicy BayesOptimal.Foundations.Rates
open BayesOptimal.ExclusionPerm BayesOptimal.ExclusionBounds BayesOptimal.ExclusionTail BayesOptimal.Comparison

noncomputable section

theorem optimal_EBI_max (k : ℕ) (c : BayesOptimal.Foundations.BayesianModel.Counts)
    (m : BayesOptimal.Foundations.BayesianModel.Means) (a : BayesOptimal.Foundations.BayesianModel.Arm)
    (hc : ∀ i, 0 < c i)
    (ha : BayesOptimal.Foundations.BayesianModel.action k c m a = BayesOptimal.Foundations.BayesianModel.value (k+1) c m)
    (i : BayesOptimal.Foundations.BayesianModel.Arm) : EBI k c m i ≤ EBI k c m a := by
  rw [EBI_eq k c m i (hc i), EBI_eq k c m a (hc a), ha]
  exact sub_le_sub_right (BayesOptimal.Foundations.BayesianModel.action_le_value k c m i) _

/-- One policy-independent horizon threshold excludes arm 3 at every round
and excludes already saturated arms before the final draw. -/
theorem eventually_optimal_choices (CU : ℝ) (hCU : 33 ≤ CU) :
    ∃ T0 : ℕ, ∀ T : ℕ, T0 ≤ T →
      (∀ (q t : ℕ) (p : MeanPath) (c : Counts) (a : BayesOptimal.Foundations.BayesianModel.Arm),
        T = 2*q+1 → 4 ≤ t → t < T → horizonConsistent t c → newW T q CU p c →
        BayesOptimal.Foundations.BayesianModel.action (T-t) (modelCounts c) (modelMeans p c) a =
          BayesOptimal.Foundations.BayesianModel.value (T-t+1) (modelCounts c) (modelMeans p c) →
        admissible q c a) ∧
      (∀ (q : ℕ) (p : MeanPath) (c : Counts) (a : BayesOptimal.Foundations.BayesianModel.Arm),
        T = 2*q+1 → horizonConsistent T c → newW T q CU p c →
        BayesOptimal.Foundations.BayesianModel.action 0 (modelCounts c) (modelMeans p c) a =
          BayesOptimal.Foundations.BayesianModel.value 1 (modelCounts c) (modelMeans p c) → a ≠ 2) := by
  have herr := paperG0_bigO181 CU hCU
  have hg := eventual_subtraction_positive gainC_pos (by norm_num : (0 : ℝ) < 2)
    (by norm_num : 176 < 181) herr (Filter.Eventually.of_forall (fun _ => le_rfl))
  have hb := eventual_subtraction_positive comparisonC_pos (by norm_num : (0 : ℝ) < 1)
    (by norm_num : 178 < 181) herr (Filter.Eventually.of_forall (fun _ => le_rfl))
  have ht := eventual_subtraction_positive BayesOptimal.Marginal.terminalConstant_pos
    (by norm_num : (0 : ℝ) < 2) (by norm_num : 22 < 181) herr
    (Filter.Eventually.of_forall (fun _ => le_rfl))
  obtain ⟨T0, hT0⟩ := Filter.eventually_atTop.mp
    (hg.and (hb.and (ht.and (eventually_ge_atTop (9 : ℕ)))))
  refine ⟨T0, ?_⟩
  intro T hlarge
  have hmargin := hT0 T hlarge
  have hT9 := hmargin.2.2.2
  have hCU10 : 10 ≤ CU := by linarith
  have hcut : 180 < (CU-6)^2/4 := by nlinarith
  constructor
  · intro q t p c a hTodd ht4 hpre hc hW ha
    have he3 := lemma6_upper T q t CU p c (by omega) (by linarith) hcut hc hW
    have he0 := (lemma7_individual_lower T q t CU p c hTodd ht4 hpre hCU10 hc hW).1
    have hthird : a ≠ 2 := by
      intro h
      have hm := optimal_EBI_max (T-t) (modelCounts c) (modelMeans p c) a
        (modelCounts_positive t c hc) ha 0
      rw [h] at hm
      linarith only [he3, he0, hm, hmargin.1]
    refine ⟨hthird, ?_, ?_⟩
    · intro ha0
      by_contra h
      have hsat : c.n1 = q := by have := hW.2.2.2.2.2.1; omega
      have hgap := lemma7_saturated_left T q t CU p c hTodd ht4 hpre hCU10 hc hW hsat
      have hmax := BayesOptimal.Foundations.BayesianModel.action_le_value (T-t) (modelCounts c) (modelMeans p c) 1
      rw [ha0] at ha
      linarith only [hgap, hmax, ha, hmargin.2.1]
    · intro ha1
      by_contra h
      have hsat : c.n2 = q := by have := hW.2.2.2.2.2.2.1; omega
      have hgap := lemma7_saturated_right T q t CU p c hTodd ht4 hpre hCU10 hc hW hsat
      have hmax := BayesOptimal.Foundations.BayesianModel.action_le_value (T-t) (modelCounts c) (modelMeans p c) 0
      rw [ha1] at ha
      linarith only [hgap, hmax, ha, hmargin.2.1]
  · intro q p c a hTodd hc hW ha h
    have he3 := lemma6_upper T q T CU p c (by omega) (by linarith) hcut hc hW
    simp only [Nat.sub_self] at he3
    have he0 := (lemma8_individual_lower T q CU p c hTodd hT9 hCU10 hc hW).1
    have hm := optimal_EBI_max 0 (modelCounts c) (modelMeans p c) a
      (modelCounts_positive T c hc) ha 0
    rw [h] at hm
    linarith only [he3, he0, hm, hmargin.2.2.1]

end
end BayesOptimal.PolicyChoice

end

/-! ## TwoArmOptimal -/
section

/-!
Exact scope of revised Lemma 17 (PDF page 33): positive INTEGER precisions.
The Bellman recursion integrates the actual normal posterior innovations;
its maximum ranges over both possible actions at every history.
-/

open MeasureTheory ProbabilityTheory
open scoped NNReal ENNReal

namespace BayesOptimal.TwoArmOptimal

open BayesOptimal.Foundations.Gaussian BayesOptimal.Foundations.TwoArmBellman BayesOptimal.Foundations.Counts

noncomputable section

def pairCounts (n1 n2 : ℕ) : Counts := ⟨n1, n2, 0⟩
def pairMeans (m1 m2 : ℝ) : Fin 2 → ℝ := ![m1, m2]
def pairPrecisions (n1 n2 : ℕ) : Fin 2 → ℝ≥0 := ![(n1 : ℝ≥0), (n2 : ℝ≥0)]

theorem maxAll_pair (m1 m2 : ℝ) :
    FiniteGaussian.maxAll (pairMeans m1 m2) = max m1 m2 := by
  apply le_antisymm
  · apply FiniteGaussian.maxAll_le
    intro i
    fin_cases i
    · exact le_max_left _ _
    · exact le_max_right _ _
  · exact max_le (FiniteGaussian.coordinate_le_maxAll (pairMeans m1 m2) 0)
      (FiniteGaussian.coordinate_le_maxAll (pairMeans m1 m2) 1)

theorem advance_pair_left (n1 n2 : ℕ) :
    FiniteGaussian.advance (pairPrecisions n1 n2) 0 = pairPrecisions (n1 + 1) n2 := by
  ext i
  fin_cases i <;> simp [FiniteGaussian.advance, pairPrecisions]

theorem advance_pair_right (n1 n2 : ℕ) :
    FiniteGaussian.advance (pairPrecisions n1 n2) 1 = pairPrecisions n1 (n2 + 1) := by
  ext i
  fin_cases i <;> simp [FiniteGaussian.advance, pairPrecisions]

theorem shift_pair_left (m1 m2 z : ℝ) :
    FiniteGaussian.shift (pairMeans m1 m2) 0 z = pairMeans (m1 + z) m2 := by
  ext i
  fin_cases i <;> simp [FiniteGaussian.shift, pairMeans]

theorem shift_pair_right (m1 m2 z : ℝ) :
    FiniteGaussian.shift (pairMeans m1 m2) 1 z = pairMeans m1 (m2 + z) := by
  ext i
  fin_cases i <;> simp [FiniteGaussian.shift, pairMeans]

theorem value_eq_twoArm (k n1 n2 : ℕ) (m1 m2 : ℝ) :
    FiniteGaussian.value k (pairPrecisions n1 n2) (pairMeans m1 m2) =
      payoff k m1 m2 (pairCounts n1 n2) := by
  induction k generalizing n1 n2 m1 m2 with
  | zero => exact maxAll_pair m1 m2
  | succ k ih =>
    rw [FiniteGaussian.value_succ]
    have ha : FiniteGaussian.action k (pairPrecisions n1 n2) (pairMeans m1 m2) =
        pairMeans (leftAction k m1 m2 (pairCounts n1 n2))
          (rightAction k m1 m2 (pairCounts n1 n2)) := by
      ext i
      fin_cases i
      · change (∫ z : ℝ, FiniteGaussian.value k
            (FiniteGaussian.advance (pairPrecisions n1 n2) 0)
            (FiniteGaussian.shift (pairMeans m1 m2) 0 z)
            ∂gaussianReal 0 (updateVariance n1)) = leftAction k m1 m2 (pairCounts n1 n2)
        rw [advance_pair_left]
        simp_rw [shift_pair_left, ih]
        rfl
      · change (∫ z : ℝ, FiniteGaussian.value k
            (FiniteGaussian.advance (pairPrecisions n1 n2) 1)
            (FiniteGaussian.shift (pairMeans m1 m2) 1 z)
            ∂gaussianReal 0 (updateVariance n2)) = rightAction k m1 m2 (pairCounts n1 n2)
        rw [advance_pair_right]
        simp_rw [shift_pair_right, ih]
        rfl
    rw [ha, maxAll_pair]
    rfl

theorem action_left_eq (k n1 n2 : ℕ) (m1 m2 : ℝ) :
    FiniteGaussian.action k (pairPrecisions n1 n2) (pairMeans m1 m2) 0 =
      leftAction k m1 m2 (pairCounts n1 n2) := by
  change (∫ z : ℝ, FiniteGaussian.value k
      (FiniteGaussian.advance (pairPrecisions n1 n2) 0)
      (FiniteGaussian.shift (pairMeans m1 m2) 0 z)
      ∂gaussianReal 0 (updateVariance n1)) = _
  rw [advance_pair_left]
  simp_rw [shift_pair_left, value_eq_twoArm]
  rfl

theorem action_right_eq (k n1 n2 : ℕ) (m1 m2 : ℝ) :
    FiniteGaussian.action k (pairPrecisions n1 n2) (pairMeans m1 m2) 1 =
      rightAction k m1 m2 (pairCounts n1 n2) := by
  change (∫ z : ℝ, FiniteGaussian.value k
      (FiniteGaussian.advance (pairPrecisions n1 n2) 1)
      (FiniteGaussian.shift (pairMeans m1 m2) 1 z)
      ∂gaussianReal 0 (updateVariance n2)) = _
  rw [advance_pair_right]
  simp_rw [shift_pair_right, value_eq_twoArm]
  rfl

/-- Every minimum-count action achieves the actual adaptive Bellman optimum,
including BOTH actions when the counts are equal. -/
theorem lemma17_action_optimal (k n1 n2 : ℕ) (m1 m2 : ℝ)
    (h1 : 0 < n1) (h2 : 0 < n2) (i : Fin 2)
    (hi : ∀ j, pairPrecisions n1 n2 i ≤ pairPrecisions n1 n2 j) :
    FiniteGaussian.action k (pairPrecisions n1 n2) (pairMeans m1 m2) i =
      FiniteGaussian.value (k + 1) (pairPrecisions n1 n2) (pairMeans m1 m2) := by
  rw [value_eq_twoArm]
  fin_cases i
  · change FiniteGaussian.action k (pairPrecisions n1 n2) (pairMeans m1 m2) 0 = _
    rw [action_left_eq]
    apply (smaller_count_left_optimal k m1 m2 (pairCounts n1 n2) h1 h2 _).symm
    have h := hi 1
    change (n1 : ℝ≥0) ≤ (n2 : ℝ≥0) at h
    exact_mod_cast h
  · change FiniteGaussian.action k (pairPrecisions n1 n2) (pairMeans m1 m2) 1 = _
    rw [action_right_eq]
    have h : n2 ≤ n1 := by
      have hh := hi 0
      change (n2 : ℝ≥0) ≤ (n1 : ℝ≥0) at hh
      exact_mod_cast hh
    by_cases he : n1 = n2
    · subst n2
      exact (BayesOptimal.Comparison.Gaussian.equal_count_right_action_optimal
        k n1 0 m1 m2 h1).symm
    · exact (smaller_count_right_optimal k m1 m2 (pairCounts n1 n2) h1 h2
        (show n2 < n1 by omega)).symm

/-- Revised Lemma 17, with L_i interpreted by the actual posterior-regret
integral of FinitePosterior; no optimality inequality is assumed. -/
theorem lemma17 (k n1 n2 : ℕ) (m1 m2 : ℝ)
    (h1 : 0 < n1) (h2 : 0 < n2) (i : Fin 2)
    (hi : ∀ j, pairPrecisions n1 n2 i ≤ pairPrecisions n1 n2 j) (j : Fin 2) :
    FinitePosterior.actionLoss k (pairPrecisions n1 n2) (pairMeans m1 m2) i ≤
      FinitePosterior.actionLoss k (pairPrecisions n1 n2) (pairMeans m1 m2) j := by
  have hc (a : Fin 2) : 0 < pairPrecisions n1 n2 a := by
    fin_cases a
    · change (0 : ℝ≥0) < (n1 : ℝ≥0)
      exact_mod_cast h1
    · change (0 : ℝ≥0) < (n2 : ℝ≥0)
      exact_mod_cast h2
  rw [FinitePosterior.actionLoss_eq _ _ _ _ (hc i),
    FinitePosterior.actionLoss_eq _ _ _ _ (hc j),
    lemma17_action_optimal k n1 n2 m1 m2 h1 h2 i hi]
  exact sub_le_sub_left (FiniteGaussian.action_le_value _ _ _ j) _

/-- The same statement for an arbitrary two-arm mean vector and arbitrary
positive integer precision vector, with no vector-normal-form assumptions. -/
theorem lemma17_every_posterior (k : ℕ) (n : Fin 2 → ℕ) (m : Fin 2 → ℝ)
    (hn : ∀ a, 0 < n a) (i : Fin 2) (hi : ∀ j, n i ≤ n j) (j : Fin 2) :
    FinitePosterior.actionLoss k (fun a => (n a : ℝ≥0)) m i ≤
      FinitePosterior.actionLoss k (fun a => (n a : ℝ≥0)) m j := by
  have hp : (fun a => (n a : ℝ≥0)) = pairPrecisions (n 0) (n 1) := by
    ext a
    fin_cases a <;> rfl
  have hm : m = pairMeans (m 0) (m 1) := by
    ext a
    fin_cases a <;> rfl
  rw [hp, hm]
  apply lemma17 k (n 0) (n 1) (m 0) (m 1) (hn 0) (hn 1) i _ j
  intro a
  rw [← hp]
  change (n i : ℝ≥0) ≤ (n a : ℝ≥0)
  exact_mod_cast hi a

/-- The deterministic smaller-count schedule attains the adaptive optimum. -/
theorem lemma17_balanced_policy (k n1 n2 : ℕ) (m1 m2 : ℝ)
    (h1 : 0 < n1) (h2 : 0 < n2) :
    balancedPayoff k m1 m2 (pairCounts n1 n2) =
      FiniteGaussian.value k (pairPrecisions n1 n2) (pairMeans m1 m2) := by
  rw [value_eq_twoArm]
  exact balanced_policy_optimal _ _ _ _ h1 h2

/-- Static allocation step in the printed proof: reciprocal terminal
variance is minimized by balancing, subject to integer count constraints. -/
theorem lemma17_minimal_terminal_variance (k n1 n2 a b : ℕ)
    (h1 : 0 < n1) (h2 : 0 < n2) (ha : n1 ≤ a) (hb : n2 ≤ b)
    (hs : a + b = n1 + n2 + k) :
    variance (balancedRun k (pairCounts n1 n2)) ≤ posteriorVariance a b :=
  balancedRun_variance_le_allocation _ _ _ _ h1 h2 ha hb hs

/-- The exact cumulative normal variance is initial minus terminal
posterior variance, as in the deterministic-allocation proof. -/
theorem lemma17_variance_identity (k n1 n2 : ℕ) (h1 : 0 < n1) (h2 : 0 < n2) :
    (cumulativeVariance k (pairCounts n1 n2) : ℝ) =
      transitionVariance k (pairCounts n1 n2) :=
  cumulativeVariance_eq_transitionVariance _ _ h1 h2

theorem lemma17_gaussian_forecast (k n1 n2 : ℕ) (delta : ℝ) :
    BayesOptimal.Foundations.PredictiveLaw.balancedPredictiveLaw k (pairCounts n1 n2) delta =
      gaussianReal delta (BayesOptimal.Foundations.PredictiveLaw.accumulatedVariance k (pairCounts n1 n2)) :=
  BayesOptimal.Foundations.PredictiveLaw.balancedPredictiveLaw_gaussian _ _ _

end
end BayesOptimal.TwoArmOptimal

end

/-! ## Information -/
section

/-! Information cannot increase optimal posterior expected regret.
The proof uses the actual finite-arm Gaussian Bellman recursion. -/

open MeasureTheory ProbabilityTheory
open scoped NNReal ENNReal

namespace BayesOptimal.Information

open FiniteGaussian

variable {A : Type*} [Fintype A] [Nonempty A] [DecidableEq A]

noncomputable section

omit [Fintype A] [Nonempty A] in
theorem advance_commute (c : Precisions A) (i j : A) :
    advance (advance c i) j = advance (advance c j) i := by
  funext a
  simp only [advance]
  exact add_right_comm _ _ _

omit [Fintype A] [Nonempty A] in
theorem shift_commute (m : Means A) (i j : A) (x y : ℝ) :
    shift (shift m i x) j y = shift (shift m j y) i x := by
  ext a
  simp only [shift]
  ring

omit [Fintype A] [Nonempty A] in
theorem innovation_other (c : Precisions A) (i j : A) (h : j ≠ i) :
    innovation (advance c i) j = innovation c j := by
  simp [innovation, advance, h]

omit [Nonempty A] in
theorem double_shift_integrable {f : Means A → ℝ} (hf : LipschitzWith 1 f)
    (m : Means A) (i j : A) (v w : ℝ≥0) :
    Integrable (fun p : ℝ × ℝ => f (shift (shift m i p.1) j p.2))
      ((gaussianReal 0 v).prod (gaussianReal 0 w)) := by
  have hb (p : ℝ × ℝ) : ‖f (shift (shift m i p.1) j p.2)‖ ≤
      |f m| + |p.1| + |p.2| := by
    have h := hf.dist_le_mul (shift (shift m i p.1) j p.2) m
    simp only [NNReal.coe_one, one_mul, dist_eq_norm] at h
    have hn : ‖shift (shift m i p.1) j p.2 - m‖ ≤ |p.1| + |p.2| := by
      have he : shift (shift m i p.1) j p.2 - m =
          (shift (shift m i p.1) j p.2 - shift m i p.1) + (shift m i p.1 - m) := by
        abel
      rw [he]
      exact (norm_add_le _ _).trans (by
        have h1 := shift_norm_bound (shift m i p.1) j p.2
        have h2 := shift_norm_bound m i p.1
        linarith)
    have ht := norm_add_le (f (shift (shift m i p.1) j p.2) - f m) (f m)
    rw [sub_add_cancel, Real.norm_eq_abs (f m)] at ht
    linarith
  have hcont : Continuous (fun p : ℝ × ℝ => shift (shift m i p.1) j p.2) := by
    apply continuous_pi
    intro a
    simp only [shift]
    split_ifs <;> fun_prop
  exact (((integrable_const |f m|).add
    ((BayesOptimal.Foundations.Gaussian.gaussian_id_integrable 0 v).norm.comp_fst (gaussianReal 0 w))).add
    ((BayesOptimal.Foundations.Gaussian.gaussian_id_integrable 0 w).norm.comp_snd (gaussianReal 0 v))).mono'
    (hf.continuous.comp hcont).measurable.aestronglyMeasurable
    (Filter.Eventually.of_forall hb)

theorem distinct_actions_commute (k : ℕ) (c : Precisions A) (m : Means A)
    (i j : A) (hij : i ≠ j) :
    (∫ x : ℝ, action k (advance c i) (shift m i x) j ∂gaussianReal 0 (innovation c i)) =
      ∫ y : ℝ, action k (advance c j) (shift m j y) i ∂gaussianReal 0 (innovation c j) := by
  simp only [action, innovation_other c i j hij.symm, innovation_other c j i hij]
  rw [integral_integral_swap
    (double_shift_integrable (value_lipschitz k (advance (advance c i) j)) m i j _ _)]
  simp_rw [advance_commute c i j, shift_commute m i j]

omit [Fintype A] [Nonempty A] in
theorem terminal_coordinate_mean (c : Precisions A) (m : Means A) (i j : A) :
    (∫ z : ℝ, shift m i z j ∂gaussianReal 0 (innovation c i)) = m j := by
  by_cases h : j = i
  · simp only [shift, if_pos h]
    rw [integral_add (integrable_const _) (BayesOptimal.Foundations.Gaussian.gaussian_id_integrable _ _)]
    simp [integral_id_gaussianReal]
  · simp [shift, h]

theorem terminal_action_ge (c : Precisions A) (m : Means A) (i : A) :
    value 0 c m ≤ action 0 c m i := by
  obtain ⟨j, hj⟩ := maxAll_attained m
  change maxAll m ≤ ∫ z : ℝ, maxAll (shift m i z) ∂gaussianReal 0 (innovation c i)
  rw [← hj, ← terminal_coordinate_mean c m i j]
  apply integral_mono _ (action_integrable 0 c m i)
    (fun z => coordinate_le_maxAll (shift m i z) j)
  by_cases h : j = i
  · simpa only [shift, if_pos h] using
      (integrable_const (m j)).add (BayesOptimal.Foundations.Gaussian.gaussian_id_integrable 0 (innovation c i))
  · simp [shift, h]

/-- Any first observation followed by k optimal observations is at least as
valuable as just the k optimal observations, for every finite arm set. -/
theorem value_le_action (k : ℕ) (c : Precisions A) (m : Means A) (i : A) :
    value k c m ≤ action k c m i := by
  induction k generalizing c m with
  | zero => exact terminal_action_ge c m i
  | succ k ih =>
    rw [value_succ]
    apply maxAll_le
    intro j
    by_cases hij : i = j
    · subst j
      unfold action
      exact integral_mono (action_integrable k c m i)
        (action_integrable (k + 1) c m i) (fun z =>
          (ih (advance c i) (shift m i z)).trans
            (action_le_value k (advance c i) (shift m i z) i))
    · have hcomm := distinct_actions_commute k c m i j hij
      have hli : Integrable (fun x : ℝ => action k (advance c i) (shift m i x) j)
          (gaussianReal 0 (innovation c i)) :=
        shifted_integrable (integral_shift_lipschitz
          (value_lipschitz k (advance (advance c i) j)) j (innovation (advance c i) j))
          m i (innovation c i)
      have hlj : Integrable (fun y : ℝ => action k (advance c j) (shift m j y) i)
          (gaussianReal 0 (innovation c j)) :=
        shifted_integrable (integral_shift_lipschitz
          (value_lipschitz k (advance (advance c j) i)) i (innovation (advance c j) i))
          m j (innovation c j)
      calc
        action k c m j ≤ ∫ y : ℝ, action k (advance c j) (shift m j y) i
            ∂gaussianReal 0 (innovation c j) :=
          integral_mono (action_integrable k c m j) hlj
            (fun y => ih (advance c j) (shift m j y))
        _ = ∫ x : ℝ, action k (advance c i) (shift m i x) j
            ∂gaussianReal 0 (innovation c i) := hcomm.symm
        _ ≤ action (k + 1) c m i :=
          integral_mono hli (action_integrable (k + 1) c m i)
            (fun x => action_le_value k (advance c i) (shift m i x) j)

/-- Definition 4's nonnegative expected Bellman improvement, for arbitrary
positive real precision and every arm, follows by canceling the true
posterior expected terminal maximum. -/
theorem expected_bellman_improvement_nonnegative (k : ℕ) (c : Precisions A)
    (m : Means A) (i : A) (hc : 0 < c i) :
    0 ≤ FinitePosterior.loss k c m - FinitePosterior.actionLoss k c m i := by
  rw [FinitePosterior.actionLoss_eq _ _ _ _ hc]
  unfold FinitePosterior.loss
  have h := value_le_action k c m i
  linarith

end
end BayesOptimal.Information

end

/-! ## ForecastRules -/
section

open MeasureTheory ProbabilityTheory Set
open scoped NNReal ENNReal
open BayesOptimal.Foundations.Counts BayesOptimal.Foundations.Drift BayesOptimal.Foundations.PredictiveBound

namespace BayesOptimal.Forecast

noncomputable section

/-- Every deterministic count-only tie resolution is allowed. -/
def SmallerCountRule (r : ℕ → ℕ → Bool) : Prop :=
  ∀ a b, if r a b then a ≤ b else b ≤ a

def ruleStep (r : ℕ → ℕ → Bool) (c : Counts) : Counts :=
  if r c.n1 c.n2 then ⟨c.n1 + 1, c.n2, c.n3⟩ else ⟨c.n1, c.n2 + 1, c.n3⟩

def ruleRun (r : ℕ → ℕ → Bool) : ℕ → Counts → Counts
  | 0, c => c
  | k + 1, c => ruleRun r k (ruleStep r c)

theorem ruleStep_sum (r : ℕ → ℕ → Bool) (c : Counts) :
    (ruleStep r c).n1 + (ruleStep r c).n2 = c.n1 + c.n2 + 1 := by
  unfold ruleStep
  split <;> simp <;> omega

theorem ruleStep_monotone (r : ℕ → ℕ → Bool) (c : Counts) :
    c.n1 ≤ (ruleStep r c).n1 ∧ c.n2 ≤ (ruleStep r c).n2 := by
  unfold ruleStep
  split <;> simp

theorem ruleRun_sum (r : ℕ → ℕ → Bool) (k : ℕ) (c : Counts) :
    (ruleRun r k c).n1 + (ruleRun r k c).n2 = c.n1 + c.n2 + k := by
  induction k generalizing c with
  | zero => simp [ruleRun]
  | succ k ih =>
    rw [ruleRun, ih, ruleStep_sum]
    omega

theorem ruleRun_monotone (r : ℕ → ℕ → Bool) (k : ℕ) (c : Counts) :
    c.n1 ≤ (ruleRun r k c).n1 ∧ c.n2 ≤ (ruleRun r k c).n2 := by
  induction k generalizing c with
  | zero => simp [ruleRun]
  | succ k ih =>
    have hs := ruleStep_monotone r c
    have hi := ih (ruleStep r c)
    exact ⟨hs.1.trans hi.1, hs.2.trans hi.2⟩

theorem ruleStep_caps (r : ℕ → ℕ → Bool) (hr : SmallerCountRule r)
    (q : ℕ) (c : Counts) (h1 : c.n1 ≤ q) (h2 : c.n2 ≤ q)
    (hsum : c.n1 + c.n2 < 2 * q) :
    (ruleStep r c).n1 ≤ q ∧ (ruleStep r c).n2 ≤ q := by
  have hm := hr c.n1 c.n2
  cases hd : r c.n1 c.n2
  · simp [hd] at hm
    simp [ruleStep, hd]
    omega
  · simp [hd] at hm
    simp [ruleStep, hd]
    omega

theorem ruleRun_caps (r : ℕ → ℕ → Bool) (hr : SmallerCountRule r)
    (q k : ℕ) (c : Counts) (h1 : c.n1 ≤ q) (h2 : c.n2 ≤ q)
    (hsum : c.n1 + c.n2 + k ≤ 2 * q) :
    (ruleRun r k c).n1 ≤ q ∧ (ruleRun r k c).n2 ≤ q := by
  induction k generalizing c with
  | zero => exact ⟨h1, h2⟩
  | succ k ih =>
    have hs := ruleStep_caps r hr q c h1 h2 (by omega)
    have ht := ruleStep_sum r c
    exact ih (ruleStep r c) hs.1 hs.2 (by omega)

theorem ruleRun_terminal_pair (r : ℕ → ℕ → Bool) (hr : SmallerCountRule r)
    (T q t : ℕ) (c : Counts) (hT : T = 2 * q + 1) (ht : 4 ≤ t) (hpre : t < T)
    (hc : horizonConsistent t c) (h1 : c.n1 ≤ q) (h2 : c.n2 ≤ q) :
    ((ruleRun r (T - t) c).n1 = q ∧ (ruleRun r (T - t) c).n2 = q - 1) ∨
      ((ruleRun r (T - t) c).n1 = q - 1 ∧ (ruleRun r (T - t) c).n2 = q) := by
  rcases hc with ⟨_, _, hc3, htotal⟩
  have hcaps := ruleRun_caps r hr q (T - t) c h1 h2 (by omega)
  have hs := ruleRun_sum r (T - t) c
  omega

def ruleSampledCount (r : ℕ → ℕ → Bool) (c : Counts) : ℕ :=
  if r c.n1 c.n2 then c.n1 else c.n2

def ruleInnovation (r : ℕ → ℕ → Bool) (c : Counts) : ℝ≥0 :=
  BayesOptimal.Foundations.Gaussian.updateVariance (ruleSampledCount r c : ℝ≥0)

def ruleAccumulatedVariance (r : ℕ → ℕ → Bool) : ℕ → Counts → ℝ≥0
  | 0, _ => 0
  | k + 1, c => ruleInnovation r c + ruleAccumulatedVariance r k (ruleStep r c)

def ruleForecast (r : ℕ → ℕ → Bool) : ℕ → Counts → ℝ → Measure ℝ
  | 0, _, δ => gaussianReal δ 0
  | k + 1, c, δ => gaussianReal 0 (ruleInnovation r c) ∗ ruleForecast r k (ruleStep r c) δ

theorem ruleForecast_gaussian (r : ℕ → ℕ → Bool) (k : ℕ) (c : Counts) (δ : ℝ) :
    ruleForecast r k c δ = gaussianReal δ (ruleAccumulatedVariance r k c) := by
  induction k generalizing c with
  | zero => rfl
  | succ k ih =>
    rw [ruleForecast, ih, gaussianReal_conv_gaussianReal, zero_add]
    rfl

theorem ruleAccumulatedVariance_coe (r : ℕ → ℕ → Bool) (k : ℕ) (c : Counts)
    (h1 : 0 < c.n1) (h2 : 0 < c.n2) :
    (ruleAccumulatedVariance r k c : ℝ) =
      finalVariance c.n1 c.n2 (ruleRun r k c).n1 (ruleRun r k c).n2 := by
  induction k generalizing c with
  | zero => simp [ruleAccumulatedVariance, ruleRun, finalVariance]
  | succ k ih =>
    have hm := ruleStep_monotone r c
    rw [ruleAccumulatedVariance, NNReal.coe_add, ih _ (by omega) (by omega)]
    unfold ruleInnovation ruleSampledCount
    cases hd : r c.n1 c.n2
    · simp only [Bool.false_eq_true, ↓reduceIte]
      rw [BayesOptimal.Foundations.Gaussian.updateVariance, NNReal.coe_inv, NNReal.coe_mul,
        NNReal.coe_add, NNReal.coe_natCast, NNReal.coe_one]
      have hv := varianceDecrement_identity c.n2 h2
      simp only [ruleRun, ruleStep, hd, Bool.false_eq_true, ↓reduceIte, finalVariance,
        Nat.cast_add, Nat.cast_one]
      simp only [varianceDecrement, one_div] at hv
      rw [← hv]
      ring
    · simp only [↓reduceIte]
      rw [BayesOptimal.Foundations.Gaussian.updateVariance, NNReal.coe_inv, NNReal.coe_mul,
        NNReal.coe_add, NNReal.coe_natCast, NNReal.coe_one]
      have hv := varianceDecrement_identity c.n1 h1
      simp only [ruleRun, ruleStep, hd, ↓reduceIte, finalVariance, Nat.cast_add, Nat.cast_one]
      simp only [varianceDecrement, one_div] at hv
      rw [← hv]
      ring

theorem lemma18 (r : ℕ → ℕ → Bool) (hr : SmallerCountRule r)
    (T q t : ℕ) (CU : ℝ) (p : MeanPath) (c : Counts)
    (hT : T = 2 * q + 1) (ht : 4 ≤ t) (hpre : t < T)
    (hc : horizonConsistent t c) (hW : BayesOptimal.Comparison.newW T q CU p c) :
    lowerConstant * BayesOptimal.Foundations.Rates.invPower 170 T ≤
      (ruleForecast r (T - t) c (terminalGap p c)
        (Icc (BayesOptimal.Foundations.Rates.invPower 2 T) (2 * BayesOptimal.Foundations.Rates.invPower 2 T))).toReal := by
  have hc1 : c.n1 ≤ q := hW.2.2.2.2.2.1
  have hc2 : c.n2 ≤ q := hW.2.2.2.2.2.2.1
  have hf := ruleRun_terminal_pair r hr T q t c hT ht hpre hc hc1 hc2
  have hm := ruleRun_monotone r (T - t) c
  rw [ruleForecast_gaussian]
  exact general_forecast_probability170 T q t CU p c hT ht hpre hc hW
    _ _ hm.1 hm.2 hf _ (ruleAccumulatedVariance_coe r _ c (by have := hc.1; omega)
      (by have := hc.2.1; omega))

end

end BayesOptimal.Forecast

end

/-! ## CommonSample -/
section

/-! Explicit common observation streams and deterministic observation schedules.
Every coordinate is a Gaussian posterior-mean innovation indexed by arm and
current integer precision. The corresponding observation is obtained by the
normal conjugate update. Permuting an allocation preserves the common samples
pointwise, and preserves its actual posterior-predictive terminal regret. -/

open MeasureTheory ProbabilityTheory
open scoped NNReal ENNReal

namespace BayesOptimal.CommonSample

open BayesOptimal.Foundations.Counts BayesOptimal.Foundations.Gaussian BayesOptimal.Foundations.TwoArmBellman
open BayesOptimal.TwoArmOptimal

noncomputable section

def step (i : Bool) (c : Counts) : Counts := if i then leftStep c else rightStep c

def sampled (i : Bool) (c : Counts) : ℕ := if i then c.n1 else c.n2

def finalCounts : List Bool → Counts → Counts
  | [], c => c
  | i :: s, c => finalCounts s (step i c)

def allocationVariance : List Bool → Counts → ℝ≥0
  | [], _ => 0
  | i :: s, c => updateVariance (sampled i c) + allocationVariance s (step i c)

def utility : List Bool → Counts → ℝ → ℝ → ℝ
  | [], _, m1, m2 => max m1 m2
  | i :: s, c, m1, m2 => if i then
      ∫ z : ℝ, utility s (leftStep c) (m1 + z) m2
        ∂gaussianReal 0 (updateVariance c.n1)
    else ∫ z : ℝ, utility s (rightStep c) m1 (m2 + z)
        ∂gaussianReal 0 (updateVariance c.n2)

def potential (c : Counts) (m1 m2 : ℝ) : ℝ :=
  FinitePosterior.potential (pairPrecisions c.n1 c.n2) (pairMeans m1 m2)

def terminalRisk (c : Counts) (m1 m2 : ℝ) : ℝ := potential c m1 m2 - max m1 m2

def risk : List Bool → Counts → ℝ → ℝ → ℝ
  | [], c, m1, m2 => terminalRisk c m1 m2
  | i :: s, c, m1, m2 => if i then
      ∫ z : ℝ, risk s (leftStep c) (m1 + z) m2
        ∂gaussianReal 0 (updateVariance c.n1)
    else ∫ z : ℝ, risk s (rightStep c) m1 (m2 + z)
        ∂gaussianReal 0 (updateVariance c.n2)

theorem terminalRisk_is_actual_regret (c : Counts) (m1 m2 : ℝ) :
    terminalRisk c m1 m2 = FinitePosterior.terminalRegret
      (pairPrecisions c.n1 c.n2) (pairMeans m1 m2) (if m1 ≤ m2 then 1 else 0) := by
  rw [FinitePosterior.terminalRegret_eq]
  unfold terminalRisk potential
  congr 1
  by_cases h : m1 ≤ m2
  · simp [h, pairMeans]
  · simp [h, pairMeans, max_eq_left (le_of_not_ge h)]

theorem utility_eq (s : List Bool) (c : Counts) (m1 m2 : ℝ) :
    utility s c m1 m2 = m2 + hingeLoss (m2 - m1) (allocationVariance s c) := by
  induction s generalizing c m1 m2 with
  | nil => simpa [utility, allocationVariance] using (payoff_eq 0 m1 m2 c)
  | cons i s ih =>
    cases i <;> simp only [utility, allocationVariance, step, sampled, Bool.false_eq_true,
      ↓reduceIte, ih]
    · exact right_formula_integral _ _ _ _
    · exact left_formula_integral _ _ _ _

theorem allocationVariance_decomposition (s : List Bool) (c : Counts)
    (h1 : 0 < c.n1) (h2 : 0 < c.n2) :
    allocationVariance s c + variance (finalCounts s c) = variance c := by
  induction s generalizing c with
  | nil => simp [allocationVariance, finalCounts]
  | cons i s ih =>
    cases i <;> simp only [allocationVariance, finalCounts, step, sampled,
      Bool.false_eq_true, ↓reduceIte]
    · rw [add_assoc, ih (rightStep c) (by simpa [rightStep] using h1)
        (by simp [rightStep])]
      exact (rightStep_variance c h2).symm
    · rw [add_assoc, ih (leftStep c) (by simp [leftStep])
        (by simpa [leftStep] using h2)]
      exact (leftStep_variance c h1).symm

theorem left_potential_integrable (c : Counts) (m1 m2 : ℝ) :
    Integrable (fun z : ℝ => potential (leftStep c) (m1 + z) m2)
      (gaussianReal 0 (updateVariance c.n1)) := by
  have h := FiniteGaussian.shifted_integrable
    (FinitePosterior.potential_lipschitz (pairPrecisions (c.n1 + 1) c.n2))
    (pairMeans m1 m2) 0 (updateVariance c.n1)
  simpa only [potential, leftStep, shift_pair_left] using h

theorem right_potential_integrable (c : Counts) (m1 m2 : ℝ) :
    Integrable (fun z : ℝ => potential (rightStep c) m1 (m2 + z))
      (gaussianReal 0 (updateVariance c.n2)) := by
  have h := FiniteGaussian.shifted_integrable
    (FinitePosterior.potential_lipschitz (pairPrecisions c.n1 (c.n2 + 1)))
    (pairMeans m1 m2) 1 (updateVariance c.n2)
  simpa only [potential, rightStep, shift_pair_right] using h

theorem left_potential_tower (c : Counts) (m1 m2 : ℝ) (h1 : 0 < c.n1) :
    (∫ z : ℝ, potential (leftStep c) (m1 + z) m2
      ∂gaussianReal 0 (updateVariance c.n1)) = potential c m1 m2 := by
  have h := FinitePosterior.potential_tower (pairPrecisions c.n1 c.n2)
    (pairMeans m1 m2) 0 (by change (0 : ℝ≥0) < c.n1; exact_mod_cast h1)
  rw [advance_pair_left] at h
  simpa [potential, leftStep, shift_pair_left,
    FiniteGaussian.innovation, pairPrecisions] using h

theorem right_potential_tower (c : Counts) (m1 m2 : ℝ) (h2 : 0 < c.n2) :
    (∫ z : ℝ, potential (rightStep c) m1 (m2 + z)
      ∂gaussianReal 0 (updateVariance c.n2)) = potential c m1 m2 := by
  have h := FinitePosterior.potential_tower (pairPrecisions c.n1 c.n2)
    (pairMeans m1 m2) 1 (by change (0 : ℝ≥0) < c.n2; exact_mod_cast h2)
  rw [advance_pair_right] at h
  simpa [potential, rightStep, shift_pair_right,
    FiniteGaussian.innovation, pairPrecisions] using h

/-- The risk is the iterated integral of actual posterior latent regret, not
an assumed potential-minus-payoff definition. -/
theorem risk_eq (s : List Bool) (c : Counts) (m1 m2 : ℝ)
    (h1 : 0 < c.n1) (h2 : 0 < c.n2) :
    risk s c m1 m2 = potential c m1 m2 - utility s c m1 m2 := by
  induction s generalizing c m1 m2 with
  | nil => rfl
  | cons i s ih =>
    cases i <;> simp only [risk, utility, Bool.false_eq_true, ↓reduceIte]
    · simp_rw [ih (rightStep c) _ _ (by simpa [rightStep] using h1)
        (by simp [rightStep])]
      have hu : Integrable (fun z : ℝ => utility s (rightStep c) m1 (m2 + z))
          (gaussianReal 0 (updateVariance c.n2)) := by
        simp only [utility_eq]
        exact right_formula_integrable _ _ _ _
      rw [integral_sub (right_potential_integrable c m1 m2) hu,
        right_potential_tower c m1 m2 h2]
    · simp_rw [ih (leftStep c) _ _ (by simp [leftStep])
        (by simpa [leftStep] using h2)]
      have hu : Integrable (fun z : ℝ => utility s (leftStep c) (m1 + z) m2)
          (gaussianReal 0 (updateVariance c.n1)) := by
        simp only [utility_eq]
        exact left_formula_integrable _ _ _ _
      rw [integral_sub (left_potential_integrable c m1 m2) hu,
        left_potential_tower c m1 m2 h1]

/-- Exact allocation-only dependence of the posterior-predictive terminal risk. -/
theorem risk_depends_only_terminal_counts (s u : List Bool) (c : Counts) (m1 m2 : ℝ)
    (h1 : 0 < c.n1) (h2 : 0 < c.n2)
    (hfinal : finalCounts s c = finalCounts u c) :
    risk s c m1 m2 = risk u c m1 m2 := by
  have hs := allocationVariance_decomposition s c h1 h2
  have hu := allocationVariance_decomposition u c h1 h2
  rw [hfinal] at hs
  have hv : allocationVariance s c = allocationVariance u c := add_right_cancel (hs.trans hu.symm)
  rw [risk_eq s c m1 m2 h1 h2, risk_eq u c m1 m2 h1 h2, utility_eq, utility_eq, hv]

abbrev Stream := Bool → ℕ → ℝ

def commonUpdate (i : Bool) (c : Counts) (m : ℝ × ℝ) (z : Stream) : ℝ × ℝ :=
  if i then (m.1 + z true c.n1, m.2) else (m.1, m.2 + z false c.n2)

def terminalMeans : List Bool → Counts → (ℝ × ℝ) → Stream → (ℝ × ℝ)
  | [], _, m, _ => m
  | i :: s, c, m, z => terminalMeans s (step i c) (commonUpdate i c m z) z

theorem step_commute (i j : Bool) (c : Counts) : step j (step i c) = step i (step j c) := by
  cases i <;> cases j <;> rfl

theorem commonUpdate_commute (i j : Bool) (c : Counts) (m : ℝ × ℝ) (z : Stream) :
    commonUpdate j (step i c) (commonUpdate i c m z) z =
      commonUpdate i (step j c) (commonUpdate j c m z) z := by
  cases i <;> cases j <;> rfl

theorem finalCounts_permutation (s u : List Bool) (h : s.Perm u) (c : Counts) :
    finalCounts s c = finalCounts u c := by
  induction h generalizing c with
  | nil => rfl
  | cons i h ih => exact ih (step i c)
  | swap i j s => simp only [finalCounts, step_commute]
  | trans h₁ h₂ ih₁ ih₂ => exact (ih₁ c).trans (ih₂ c)

/-- Coupling is pointwise on a single per-arm stream, stronger than equality in law. -/
theorem terminalMeans_permutation (s u : List Bool) (h : s.Perm u)
    (c : Counts) (m : ℝ × ℝ) (z : Stream) :
    terminalMeans s c m z = terminalMeans u c m z := by
  induction h generalizing c m with
  | nil => rfl
  | cons i h ih => exact ih (step i c) (commonUpdate i c m z)
  | swap i j s => simp only [terminalMeans, step_commute, commonUpdate_commute]
  | trans h₁ h₂ ih₁ ih₂ => exact (ih₁ c m).trans (ih₂ c m)

theorem risk_permutation (s u : List Bool) (h : s.Perm u) (c : Counts) (m1 m2 : ℝ)
    (h1 : 0 < c.n1) (h2 : 0 < c.n2) : risk s c m1 m2 = risk u c m1 m2 :=
  risk_depends_only_terminal_counts s u c m1 m2 h1 h2 (finalCounts_permutation s u h c)

/-- A single probability space supplies all common samples and either final sample. -/
def streamLaw (N : ℕ) : Measure (Bool × Fin N → ℝ) :=
  Measure.pi (fun j => gaussianReal 0 (updateVariance (j.2.val : ℝ≥0)))

instance streamLaw_probability (N : ℕ) : IsProbabilityMeasure (streamLaw N) := by
  unfold streamLaw
  infer_instance

theorem stream_coordinates_independent (N : ℕ) :
    iIndepFun (fun j : Bool × Fin N => fun x : Bool × Fin N → ℝ => x j) (streamLaw N) := by
  exact iIndepFun_pi (fun _ => measurable_id.aemeasurable)

def finiteStream (N : ℕ) (x : Bool × Fin N → ℝ) : Stream :=
  fun i n => if h : n < N then x (i, ⟨n, h⟩) else 0

theorem stream_coordinate_law (N n : ℕ) (i : Bool) (hn : n < N) :
    (streamLaw N).map (fun x => finiteStream N x i n) =
      gaussianReal 0 (updateVariance (n : ℝ≥0)) := by
  simpa only [finiteStream, dif_pos hn] using
    (measurePreserving_eval (fun j : Bool × Fin N =>
      gaussianReal 0 (updateVariance (j.2.val : ℝ≥0))) (i, ⟨n, hn⟩)).map_eq

/-- Raw observation corresponding to the independent conjugate innovation. -/
def observation (n : ℕ) (m z : ℝ) : ℝ := m + (n + 1 : ℝ) * z

theorem observation_conjugate_update (n : ℕ) (m z : ℝ) :
    ((n : ℝ) * m + observation n m z) / (n + 1 : ℝ) = m + z := by
  unfold observation
  field_simp
  ring

theorem observation_predictive_law (n : ℕ) (m : ℝ) (hn : 0 < n) :
    (gaussianReal 0 (updateVariance (n : ℝ≥0))).map (observation n m) =
      gaussianReal m (1 + (n : ℝ≥0)⁻¹) := by
  have hn0 : (n : ℝ) ≠ 0 := by exact_mod_cast (Nat.ne_of_gt hn)
  have hnp0 : (n : ℝ) + 1 ≠ 0 := by positivity
  let sqn : ℝ≥0 := ⟨((n : ℝ) + 1) ^ 2, sq_nonneg ((n : ℝ) + 1)⟩
  have hv : sqn * updateVariance (n : ℝ≥0) =
      1 + (n : ℝ≥0)⁻¹ := by
    apply NNReal.coe_injective
    change ((n : ℝ) + 1) ^ 2 * ((n : ℝ) * ((n : ℝ) + 1))⁻¹ = 1 + (n : ℝ)⁻¹
    field_simp [hn0, hnp0]
  unfold observation
  change Measure.map ((fun x : ℝ => m + x) ∘ (fun x : ℝ => ((n : ℝ) + 1) * x))
    (gaussianReal 0 (updateVariance (n : ℝ≥0))) = _
  rw [← Measure.map_map (by fun_prop : Measurable (fun x : ℝ => m + x))
    (by fun_prop : Measurable (fun x : ℝ => (n + 1 : ℝ) * x)),
    gaussianReal_map_const_mul, mul_zero, hv, gaussianReal_map_const_add, zero_add]

end
end BayesOptimal.CommonSample

end

/-! ## Coupling19Counts -/
section

/-! A single globally fixed left-tie rule cannot supply the skip orientation
for both forced-arm comparisons. The counterexample persists at arbitrarily
large odd horizons. The paper's explicit orientation choice is formalized
using one fixed count-only rule within each comparison, chosen for that arm. -/

namespace BayesOptimal.Coupling19

open BayesOptimal.Foundations.Counts BayesOptimal.Foundations.TwoArmBellman
open BayesOptimal.Foundations.TwoArmGain BayesOptimal.Forecast

noncomputable section

theorem fixed_tie_skip_left_counts (q : ℕ) (hq : 2 ≤ q) :
    (balancedRun (2 * q - 3) ⟨1, 1, 1⟩).n1 = q ∧
      (balancedRun (2 * q - 3) ⟨1, 1, 1⟩).n2 = q - 1 := by
  have h := equation22_terminal_counts q (2 * q - 3) ⟨1, 1, 1⟩
    (by omega) (by change 1 ≤ q; omega) (by change 1 ≤ q; omega) (by simp; omega)
  simpa only [show ¬ (1 : ℕ) = q by omega, if_false] using h

theorem fixed_tie_forced_left_counts (q : ℕ) (hq : 2 ≤ q) :
    (balancedRun (2 * q - 3) (leftStep ⟨1, 1, 1⟩)).n1 = q ∧
      (balancedRun (2 * q - 3) (leftStep ⟨1, 1, 1⟩)).n2 = q := by
  have h := BayesOptimal.Dynamic.forced_left_final_counts q (2 * q - 3) ⟨1, 1, 1⟩
    (by omega) (by change 1 ≤ q; omega) (by change 1 ≤ q; omega) (by simp; omega)
  simpa only [show ¬ (1 : ℕ) = q by omega, if_false] using h

/-- A globally fixed LEFT-tie skip allocation cannot always be followed by
one additional LEFT draw to give the optimal forced-left allocation. This
refutes that stronger interpretation, rather than Lemma 19 itself. -/
theorem fixed_tie_same_forced_arm_assertion_false (q : ℕ) (hq : 2 ≤ q) :
    balancedRun (2 * q - 3) (leftStep ⟨1, 1, 1⟩) ≠
      leftStep (balancedRun (2 * q - 3) ⟨1, 1, 1⟩) := by
  intro h
  have hskip := fixed_tie_skip_left_counts q hq
  have hforce := fixed_tie_forced_left_counts q hq
  have he := congrArg Counts.n1 h
  change (balancedRun (2 * q - 3) (leftStep ⟨1, 1, 1⟩)).n1 =
    (balancedRun (2 * q - 3) ⟨1, 1, 1⟩).n1 + 1 at he
  rw [hforce.1, hskip.1] at he
  omega

theorem counts_ext {c d : Counts} (h1 : c.n1 = d.n1) (h2 : c.n2 = d.n2)
    (h3 : c.n3 = d.n3) : c = d := by
  cases c
  cases d
  simp_all

def counterexamplePath (T : ℕ) (CU : ℝ) : BayesOptimal.Foundations.Counts.MeanPath :=
  fun i _ => if i = 3 then -CU * Real.sqrt (Real.log (T : ℝ)) - 1 else 0

/-- The failing coupling occurs inside the actual W(t) domain of Lemma 19. -/
theorem counterexample_within_lemma19_domain (q : ℕ) (hq : 2 ≤ q) (CU : ℝ) :
    horizonConsistent 4 ⟨1, 1, 1⟩ ∧ 4 < 2 * q + 1 ∧
      (2 * q + 1 - 4 = 2 * q - 3) ∧
      BayesOptimal.Comparison.newW (2 * q + 1) q CU (counterexamplePath (2 * q + 1) CU) ⟨1, 1, 1⟩ := by
  refine ⟨by norm_num [horizonConsistent], by omega, by omega, ?_⟩
  have hz (i : ℕ) (hi : i ≠ 3) :
      BayesOptimal.Comparison.newZ (2 * q + 1) q i (counterexamplePath (2 * q + 1) CU) := by
    intro n hn hnq
    simp only [counterexamplePath, if_neg hi, sub_self, abs_zero]
    positivity
  refine ⟨?_, ?_, ?_, hz 1 (by norm_num), hz 2 (by norm_num), ?_, ?_, by norm_num⟩
  · dsimp [BayesOptimal.Foundations.Drift.eventX, counterexamplePath]
    linarith
  · unfold BayesOptimal.Foundations.Drift.eventY counterexamplePath
    norm_num
    positivity
  · unfold BayesOptimal.Foundations.Drift.eventY counterexamplePath
    norm_num
    positivity
  · change 1 ≤ q
    omega
  · change 1 ≤ q
    omega

def swapCounts (c : Counts) : Counts := ⟨c.n2, c.n1, c.n3⟩

def rightTie (a b : ℕ) : Bool := decide (a < b)

theorem rightTie_smaller : SmallerCountRule rightTie := by
  intro a b
  unfold rightTie
  by_cases h : a < b <;> simp [h] <;> omega

theorem rightTie_step_swap (c : Counts) :
    ruleStep rightTie c = swapCounts (balancedStep (swapCounts c)) := by
  unfold ruleStep rightTie swapCounts balancedStep
  by_cases h : c.n1 < c.n2
  · have h' : ¬ c.n2 ≤ c.n1 := by omega
    simp [h, h']
  · have h' : c.n2 ≤ c.n1 := by omega
    simp [h, h']

theorem swapCounts_involutive (c : Counts) : swapCounts (swapCounts c) = c := rfl

theorem rightTie_run_swap (k : ℕ) (c : Counts) :
    ruleRun rightTie k c = swapCounts (balancedRun k (swapCounts c)) := by
  induction k generalizing c with
  | zero => rfl
  | succ k ih =>
    rw [ruleRun, ih, rightTie_step_swap, swapCounts_involutive, balancedRun]

theorem oriented_skip_left_counts (q k : ℕ) (c : Counts) (hq : 0 < q)
    (hcap1 : c.n1 ≤ q) (hcap2 : c.n2 ≤ q)
    (hs : c.n1 + c.n2 + k = 2 * q - 1) :
    (ruleRun rightTie k c).n1 = (if c.n1 = q then q else q - 1) ∧
      (ruleRun rightTie k c).n2 = (if c.n1 = q then q - 1 else q) := by
  rw [rightTie_run_swap]
  have h := equation22_terminal_counts q k (swapCounts c) hq hcap2 hcap1
    (by simpa [swapCounts, add_comm] using hs)
  change (balancedRun k (swapCounts c)).n2 = _ ∧
    (balancedRun k (swapCounts c)).n1 = _
  exact ⟨h.2, h.1⟩

/-- Repaired orientation: sample the forced LEFT arm once after all common samples. -/
theorem repaired_left_allocation_plus_one (q k : ℕ) (c : Counts) (hq : 0 < q)
    (hcap1 : c.n1 ≤ q) (hcap2 : c.n2 ≤ q)
    (hs : c.n1 + c.n2 + k = 2 * q - 1) :
    balancedRun k (leftStep c) = leftStep (ruleRun rightTie k c) := by
  have hskip := oriented_skip_left_counts q k c hq hcap1 hcap2 hs
  have hforce := BayesOptimal.Dynamic.forced_left_final_counts q k c hq hcap1 hcap2 hs
  have hn3 : (ruleRun rightTie k c).n3 = c.n3 := by
    rw [rightTie_run_swap]
    exact balancedRun_n3 k (swapCounts c)
  apply counts_ext
  · change (balancedRun k (leftStep c)).n1 = (ruleRun rightTie k c).n1 + 1
    rw [hforce.1, hskip.1]
    split_ifs <;> omega
  · change (balancedRun k (leftStep c)).n2 = (ruleRun rightTie k c).n2
    exact hforce.2.trans hskip.2.symm
  · change (balancedRun k (leftStep c)).n3 = (ruleRun rightTie k c).n3
    rw [balancedRun_n3, hn3]
    rfl

/-- Repaired orientation: sample the forced RIGHT arm once after all common samples. -/
theorem repaired_right_allocation_plus_one (q k : ℕ) (c : Counts) (hq : 0 < q)
    (hcap1 : c.n1 ≤ q) (hcap2 : c.n2 ≤ q)
    (hs : c.n1 + c.n2 + k = 2 * q - 1) :
    balancedRun k (rightStep c) = rightStep (balancedRun k c) := by
  have hskip := equation22_terminal_counts q k c hq hcap1 hcap2 hs
  have hforce := BayesOptimal.Dynamic.forced_right_final_counts q k c hq hcap1 hcap2 hs
  apply counts_ext
  · change (balancedRun k (rightStep c)).n1 = (balancedRun k c).n1
    exact hforce.1.trans hskip.1.symm
  · change (balancedRun k (rightStep c)).n2 = (balancedRun k c).n2 + 1
    rw [hforce.2, hskip.2]
    split_ifs <;> omega
  · change (balancedRun k (rightStep c)).n3 = (balancedRun k c).n3
    rw [balancedRun_n3, balancedRun_n3]
    rfl

end
end BayesOptimal.Coupling19

end

/-! ## Coupling19 -/
section

/-! Explicit arm-dependent optimal allocations, permutation of their common
samples, and the conditional last-observation identities used in Lemma 19. -/

open MeasureTheory ProbabilityTheory
open scoped NNReal ENNReal

namespace BayesOptimal.Coupling19

open BayesOptimal.Foundations.Counts BayesOptimal.Foundations.Gaussian BayesOptimal.Foundations.TwoArmBellman BayesOptimal.Foundations.TwoArmGain
open BayesOptimal.CommonSample BayesOptimal.Forecast

noncomputable section

def leftTie (a b : ℕ) : Bool := decide (a ≤ b)

theorem leftTie_smaller : SmallerCountRule leftTie := by
  intro a b
  unfold leftTie
  by_cases h : a ≤ b
  · simp [h]
  · simp [h]
    omega

theorem leftTie_step (c : Counts) : ruleStep leftTie c = balancedStep c := by
  simp [ruleStep, leftTie, balancedStep]

theorem leftTie_run (k : ℕ) (c : Counts) : ruleRun leftTie k c = balancedRun k c := by
  induction k generalizing c with
  | zero => rfl
  | succ k ih => rw [ruleRun, leftTie_step, ih, balancedRun]

def schedule (r : ℕ → ℕ → Bool) : ℕ → Counts → List Bool
  | 0, _ => []
  | k + 1, c => r c.n1 c.n2 :: schedule r k (ruleStep r c)

theorem schedule_final (r : ℕ → ℕ → Bool) (k : ℕ) (c : Counts) :
    finalCounts (schedule r k c) c = ruleRun r k c := by
  induction k generalizing c with
  | zero => rfl
  | succ k ih =>
    simp only [schedule, finalCounts, ruleRun]
    have hs : step (r c.n1 c.n2) c = ruleStep r c := by
      unfold step ruleStep
      split <;> rfl
    rw [hs, ih]

theorem schedule_optimal (r : ℕ → ℕ → Bool) (hr : SmallerCountRule r)
    (k : ℕ) (c : Counts) (m1 m2 : ℝ) (h1 : 0 < c.n1) (h2 : 0 < c.n2) :
    utility (schedule r k c) c m1 m2 = payoff k m1 m2 c := by
  induction k generalizing c m1 m2 with
  | zero => rfl
  | succ k ih =>
    have hm := hr c.n1 c.n2
    cases hd : r c.n1 c.n2
    · simp only [hd, Bool.false_eq_true, ↓reduceIte] at hm
      have hs : ruleStep r c = rightStep c := by simp [ruleStep, hd, rightStep]
      simp only [schedule, hd, utility, Bool.false_eq_true, ↓reduceIte, hs]
      simp_rw [ih (rightStep c) _ _ (by simpa [rightStep] using h1) (by simp [rightStep])]
      change rightAction k m1 m2 c = payoff (k + 1) m1 m2 c
      by_cases he : c.n1 = c.n2
      · have hc : c = ⟨c.n2, c.n2, c.n3⟩ := by
          cases c
          simp_all
        rw [hc]
        exact (BayesOptimal.Comparison.Gaussian.equal_count_right_action_optimal
          k c.n2 c.n3 m1 m2 h2).symm
      · exact (smaller_count_right_optimal k m1 m2 c h1 h2 (by omega)).symm
    · simp only [hd, ↓reduceIte] at hm
      have hs : ruleStep r c = leftStep c := by simp [ruleStep, hd, leftStep]
      simp only [schedule, hd, utility, ↓reduceIte, hs]
      simp_rw [ih (leftStep c) _ _ (by simp [leftStep]) (by simpa [leftStep] using h2)]
      exact (smaller_count_left_optimal k m1 m2 c h1 h2 hm).symm

theorem finalCounts_append (s u : List Bool) (c : Counts) :
    finalCounts (s ++ u) c = finalCounts u (finalCounts s c) := by
  induction s generalizing c with
  | nil => rfl
  | cons i s ih => exact ih (step i c)

theorem allocationVariance_append (s u : List Bool) (c : Counts) :
    allocationVariance (s ++ u) c = allocationVariance s c + allocationVariance u (finalCounts s c) := by
  induction s generalizing c with
  | nil => simp [allocationVariance, finalCounts]
  | cons i s ih =>
    simp only [List.cons_append, allocationVariance, finalCounts, ih, add_assoc]

theorem finalCounts_left (s : List Bool) (c : Counts) :
    (finalCounts s c).n1 = c.n1 + s.count true := by
  induction s generalizing c with
  | nil => simp [finalCounts]
  | cons i s ih => cases i <;> simp [finalCounts, ih, step, leftStep, rightStep]; omega

theorem finalCounts_right (s : List Bool) (c : Counts) :
    (finalCounts s c).n2 = c.n2 + s.count false := by
  induction s generalizing c with
  | nil => simp [finalCounts]
  | cons i s ih => cases i <;> simp [finalCounts, ih, step, leftStep, rightStep]; omega

theorem permutation_of_finalCounts (s u : List Bool) (c : Counts)
    (h : finalCounts s c = finalCounts u c) : s.Perm u := by
  apply List.perm_iff_count.mpr
  intro i
  cases i
  · have he := congrArg Counts.n2 h
    rw [finalCounts_right, finalCounts_right] at he
    omega
  · have he := congrArg Counts.n1 h
    rw [finalCounts_left, finalCounts_left] at he
    omega

/-- The forced-first allocation is a permutation of the chosen skip
allocation followed by one final sample from the SAME forced arm. -/
theorem forced_left_is_common_then_last (q k : ℕ) (c : Counts) (hq : 0 < q)
    (hcap1 : c.n1 ≤ q) (hcap2 : c.n2 ≤ q)
    (hs : c.n1 + c.n2 + k = 2 * q - 1) :
    (true :: schedule leftTie k (leftStep c)).Perm (schedule rightTie k c ++ [true]) := by
  apply permutation_of_finalCounts _ _ c
  simp only [finalCounts, step, ↓reduceIte, schedule_final, leftTie_run, finalCounts_append]
  exact repaired_left_allocation_plus_one q k c hq hcap1 hcap2 hs

theorem forced_right_is_common_then_last (q k : ℕ) (c : Counts) (hq : 0 < q)
    (hcap1 : c.n1 ≤ q) (hcap2 : c.n2 ≤ q)
    (hs : c.n1 + c.n2 + k = 2 * q - 1) :
    (false :: schedule leftTie k (rightStep c)).Perm (schedule leftTie k c ++ [false]) := by
  apply permutation_of_finalCounts _ _ c
  simp only [finalCounts, step, Bool.false_eq_true, ↓reduceIte, schedule_final,
    leftTie_run, finalCounts_append]
  exact repaired_right_allocation_plus_one q k c hq hcap1 hcap2 hs

/-- Both experiments share the entire observed stream. The extra forced-arm
observation is explicitly placed last, without changing any terminal mean. -/
theorem forced_left_shared_samples (q k : ℕ) (c : Counts) (hq : 0 < q)
    (hcap1 : c.n1 ≤ q) (hcap2 : c.n2 ≤ q)
    (hs : c.n1 + c.n2 + k = 2 * q - 1) (m : ℝ × ℝ) (z : Stream) :
    terminalMeans (true :: schedule leftTie k (leftStep c)) c m z =
      terminalMeans (schedule rightTie k c ++ [true]) c m z :=
  terminalMeans_permutation _ _ (forced_left_is_common_then_last q k c hq hcap1 hcap2 hs) c m z

theorem forced_right_shared_samples (q k : ℕ) (c : Counts) (hq : 0 < q)
    (hcap1 : c.n1 ≤ q) (hcap2 : c.n2 ≤ q)
    (hs : c.n1 + c.n2 + k = 2 * q - 1) (m : ℝ × ℝ) (z : Stream) :
    terminalMeans (false :: schedule leftTie k (rightStep c)) c m z =
      terminalMeans (schedule leftTie k c ++ [false]) c m z :=
  terminalMeans_permutation _ _ (forced_right_is_common_then_last q k c hq hcap1 hcap2 hs) c m z

/-- The exact conditional one-step identity, averaged under the common
Gaussian posterior forecast. It holds for every deterministic prefix. -/
theorem common_prefix_last_gain (s : List Bool) (i : Bool) (c : Counts) (m1 m2 : ℝ)
    (h1 : 0 < c.n1) (h2 : 0 < c.n2) :
    risk s c m1 m2 - risk (s ++ [i]) c m1 m2 =
      ∫ x : ℝ, hingeLoss |x| (updateVariance (sampled i (finalCounts s c)))
        ∂gaussianReal (m1 - m2) (allocationVariance s c) := by
  rw [risk_eq s c m1 m2 h1 h2, risk_eq (s ++ [i]) c m1 m2 h1 h2,
    utility_eq, utility_eq, allocationVariance_append]
  simp only [allocationVariance, add_zero]
  have h := hinge_variance_increment_integral (m2 - m1) (allocationVariance s c)
    (updateVariance (sampled i (finalCounts s c)))
  have he : -(m2 - m1) = m1 - m2 := by ring
  rw [he] at h
  linarith only [h]

/-- The two coupled forced allocations differ only in their last sample.
This is the exact conditional action-gap identity preceding Eq. (25). -/
theorem common_prefix_last_action_gap (s : List Bool) (c : Counts) (m1 m2 : ℝ)
    (h1 : 0 < c.n1) (h2 : 0 < c.n2) :
    risk (s ++ [true]) c m1 m2 - risk (s ++ [false]) c m1 m2 =
      ∫ x : ℝ, (hingeLoss |x| (updateVariance (finalCounts s c).n2) -
        hingeLoss |x| (updateVariance (finalCounts s c).n1))
        ∂gaussianReal (m1 - m2) (allocationVariance s c) := by
  rw [integral_sub (absolute_hinge_gaussian_integrable _ _ _)
    (absolute_hinge_gaussian_integrable _ _ _)]
  have hleft := common_prefix_last_gain s true c m1 m2 h1 h2
  have hright := common_prefix_last_gain s false c m1 m2 h1 h2
  simp only [sampled, Bool.false_eq_true, ↓reduceIte] at hleft hright
  linarith only [hleft, hright]

theorem ruleRun_n3 (r : ℕ → ℕ → Bool) (k : ℕ) (c : Counts) :
    (ruleRun r k c).n3 = c.n3 := by
  induction k generalizing c with
  | zero => rfl
  | succ k ih =>
    rw [ruleRun, ih]
    unfold ruleStep
    split <;> rfl

theorem ruleRun_right_only (r : ℕ → ℕ → Bool) (hr : SmallerCountRule r)
    (k : ℕ) (c : Counts) (h : c.n2 + k ≤ c.n1) :
    ruleRun r k c = ⟨c.n1, c.n2 + k, c.n3⟩ := by
  induction k generalizing c with
  | zero => simp [ruleRun]
  | succ k ih =>
    have hsmall : c.n2 < c.n1 := by omega
    have hchoice : r c.n1 c.n2 = false := by
      have hm := hr c.n1 c.n2
      cases hd : r c.n1 c.n2
      · rfl
      · simp only [hd, ↓reduceIte] at hm
        omega
    have hs : ruleStep r c = rightStep c := by simp [ruleStep, hchoice, rightStep]
    rw [ruleRun, hs, ih (rightStep c) (by simp only [rightStep]; omega)]
    simp only [rightStep]
    congr 1
    omega

/-- The forced terminal allocation is independent of the count-only tie
rule. Therefore the SAME arm-dependent rule may be used within each pair of
coupled experiments, as in the intended reading of the printed proof. -/
theorem forced_left_terminal_counts_independent_rule (r : ℕ → ℕ → Bool)
    (hr : SmallerCountRule r) (q k : ℕ) (c : Counts) (hq : 0 < q)
    (hcap1 : c.n1 ≤ q) (hcap2 : c.n2 ≤ q)
    (hs : c.n1 + c.n2 + k = 2 * q - 1) :
    ruleRun r k (leftStep c) = balancedRun k (leftStep c) := by
  have hn3 := ruleRun_n3 r k (leftStep c)
  have hf := BayesOptimal.Dynamic.forced_left_final_counts q k c hq hcap1 hcap2 hs
  by_cases h : c.n1 = q
  · have hall : (leftStep c).n2 + k ≤ (leftStep c).n1 := by simp only [leftStep]; omega
    rw [ruleRun_right_only r hr k (leftStep c) hall,
      balancedRun_right_only k (leftStep c) hall]
  · have ha : (leftStep c).n1 ≤ q := by simp only [leftStep]; omega
    have hb : (leftStep c).n2 ≤ q := hcap2
    have hsum : (leftStep c).n1 + (leftStep c).n2 + k = 2 * q := by simp only [leftStep]; omega
    have hcaps := ruleRun_caps r hr q k (leftStep c) ha hb (by omega)
    have htotal := ruleRun_sum r k (leftStep c)
    simp only [if_neg h] at hf
    apply counts_ext
    · rw [hf.1]
      omega
    · rw [hf.2]
      omega
    · rw [hn3, balancedRun_n3]

/-- Both sides now use the same right-tie rule, selected for the LEFT-arm
comparison before either experiment. -/
theorem same_rule_left_common_then_last (q k : ℕ) (c : Counts) (hq : 0 < q)
    (hcap1 : c.n1 ≤ q) (hcap2 : c.n2 ≤ q)
    (hs : c.n1 + c.n2 + k = 2 * q - 1) :
    (true :: schedule rightTie k (leftStep c)).Perm (schedule rightTie k c ++ [true]) := by
  apply permutation_of_finalCounts _ _ c
  simp only [finalCounts, step, ↓reduceIte, schedule_final, finalCounts_append]
  rw [forced_left_terminal_counts_independent_rule rightTie rightTie_smaller q k c hq hcap1 hcap2 hs]
  exact repaired_left_allocation_plus_one q k c hq hcap1 hcap2 hs

theorem same_rule_left_shared_samples (q k : ℕ) (c : Counts) (hq : 0 < q)
    (hcap1 : c.n1 ≤ q) (hcap2 : c.n2 ≤ q)
    (hs : c.n1 + c.n2 + k = 2 * q - 1) (m : ℝ × ℝ) (z : Stream) :
    terminalMeans (true :: schedule rightTie k (leftStep c)) c m z =
      terminalMeans (schedule rightTie k c ++ [true]) c m z :=
  terminalMeans_permutation _ _ (same_rule_left_common_then_last q k c hq hcap1 hcap2 hs) c m z

end
end BayesOptimal.Coupling19

end

/-! ## Coupling19Rates -/
section

open MeasureTheory ProbabilityTheory Set
open scoped NNReal ENNReal

namespace BayesOptimal.Coupling19

open BayesOptimal.Foundations.Counts BayesOptimal.Foundations.Gaussian BayesOptimal.Foundations.TwoArmBellman BayesOptimal.Foundations.TwoArmGain
open BayesOptimal.Foundations.Rates BayesOptimal.Foundations.TerminalBounds BayesOptimal.Foundations.PredictiveBound
open BayesOptimal.CommonSample BayesOptimal.Forecast BayesOptimal.Comparison

noncomputable section

theorem schedule_variance (r : ℕ → ℕ → Bool) (k : ℕ) (c : Counts) :
    allocationVariance (schedule r k c) c = ruleAccumulatedVariance r k c := by
  induction k generalizing c with
  | zero => rfl
  | succ k ih =>
    simp only [schedule, allocationVariance, ruleAccumulatedVariance]
    have hs : step (r c.n1 c.n2) c = ruleStep r c := by
      unfold step ruleStep
      split <;> rfl
    rw [hs, ih]
    rfl

theorem skip_risk_eq (r : ℕ → ℕ → Bool) (hr : SmallerCountRule r)
    (k : ℕ) (c : Counts) (m1 m2 : ℝ) (h1 : 0 < c.n1) (h2 : 0 < c.n2) :
    risk (schedule r k c) c m1 m2 = potential c m1 m2 - payoff k m1 m2 c := by
  rw [risk_eq _ _ _ _ h1 h2, schedule_optimal r hr k c m1 m2 h1 h2]

theorem forced_left_risk_eq (k : ℕ) (c : Counts) (m1 m2 : ℝ)
    (h1 : 0 < c.n1) (h2 : 0 < c.n2) :
    risk (true :: schedule leftTie k (leftStep c)) c m1 m2 =
      potential c m1 m2 - leftAction k m1 m2 c := by
  rw [risk_eq _ _ _ _ h1 h2]
  simp only [utility, ↓reduceIte]
  simp_rw [schedule_optimal leftTie leftTie_smaller k (leftStep c) _ _
    (by simp [leftStep]) (by simpa [leftStep] using h2)]
  rfl

theorem forced_right_risk_eq (k : ℕ) (c : Counts) (m1 m2 : ℝ)
    (h1 : 0 < c.n1) (h2 : 0 < c.n2) :
    risk (false :: schedule leftTie k (rightStep c)) c m1 m2 =
      potential c m1 m2 - rightAction k m1 m2 c := by
  rw [risk_eq _ _ _ _ h1 h2]
  simp only [utility, Bool.false_eq_true, ↓reduceIte]
  simp_rw [schedule_optimal leftTie leftTie_smaller k (rightStep c) _ _
    (by simpa [rightStep] using h1) (by simp [rightStep])]
  rfl

/-- Repaired Eq. (24) is an exact common-sample coupling identity for arm 1. -/
theorem left_gain_common_sample_identity (q k : ℕ) (c : Counts) (m1 m2 : ℝ)
    (hq : 0 < q) (h1 : 0 < c.n1) (h2 : 0 < c.n2)
    (hcap1 : c.n1 ≤ q) (hcap2 : c.n2 ≤ q)
    (hs : c.n1 + c.n2 + k = 2 * q - 1) :
    leftAction k m1 m2 c - payoff k m1 m2 c =
      ∫ x : ℝ, hingeLoss |x| (updateVariance (ruleRun rightTie k c).n1)
        ∂gaussianReal (m1 - m2) (ruleAccumulatedVariance rightTie k c) := by
  have hcoup := risk_permutation _ _
    (forced_left_is_common_then_last q k c hq hcap1 hcap2 hs) c m1 m2 h1 h2
  rw [forced_left_risk_eq k c m1 m2 h1 h2] at hcoup
  have hg := common_prefix_last_gain (schedule rightTie k c) true c m1 m2 h1 h2
  rw [skip_risk_eq rightTie rightTie_smaller k c m1 m2 h1 h2, ← hcoup,
    schedule_final, schedule_variance] at hg
  simp only [sampled, ↓reduceIte] at hg
  linarith only [hg]

theorem right_gain_common_sample_identity (q k : ℕ) (c : Counts) (m1 m2 : ℝ)
    (hq : 0 < q) (h1 : 0 < c.n1) (h2 : 0 < c.n2)
    (hcap1 : c.n1 ≤ q) (hcap2 : c.n2 ≤ q)
    (hs : c.n1 + c.n2 + k = 2 * q - 1) :
    rightAction k m1 m2 c - payoff k m1 m2 c =
      ∫ x : ℝ, hingeLoss |x| (updateVariance (ruleRun leftTie k c).n2)
        ∂gaussianReal (m1 - m2) (ruleAccumulatedVariance leftTie k c) := by
  have hcoup := risk_permutation _ _
    (forced_right_is_common_then_last q k c hq hcap1 hcap2 hs) c m1 m2 h1 h2
  rw [forced_right_risk_eq k c m1 m2 h1 h2] at hcoup
  have hg := common_prefix_last_gain (schedule leftTie k c) false c m1 m2 h1 h2
  rw [skip_risk_eq leftTie leftTie_smaller k c m1 m2 h1 h2, ← hcoup,
    schedule_final, schedule_variance] at hg
  simp only [sampled, Bool.false_eq_true, ↓reduceIte] at hg
  linarith only [hg]

theorem arbitrary_rule_hinge_gain_lower (r : ℕ → ℕ → Bool) (hr : SmallerCountRule r)
    (T q t n : ℕ) (CU : ℝ) (p : MeanPath) (c : Counts)
    (hT : T = 2 * q + 1) (ht : 4 ≤ t) (hpre : t < T)
    (hc : horizonConsistent t c) (hW : newW T q CU p c) (hn : 1 ≤ n) (hnT : n < T) :
    (gainConstant * lowerConstant) * invPower 176 T ≤
      ∫ x : ℝ, hingeLoss |x| (updateVariance (n : ℝ≥0))
        ∂gaussianReal (terminalGap p c) (ruleAccumulatedVariance r (T - t) c) := by
  have h5 : 5 ≤ T := by omega
  have hmass := BayesOptimal.Forecast.lemma18 r hr T q t CU p c hT ht hpre hc hW
  rw [ruleForecast_gaussian] at hmass
  have hband := BayesOptimal.Foundations.DynamicGain.gaussian_integral_band_lower
    (absolute_hinge_gaussian_integrable (terminalGap p c) (ruleAccumulatedVariance r (T - t) c)
      (updateVariance (n : ℝ≥0))) (fun x => hingeLoss_nonnegative |x| _)
    (r := 6) (fun x hx => by
      have hx0 : 0 ≤ x := (invPower_nonneg 2 T).trans hx.1
      have hsmall : |x| ≤ 2 * invPower 2 T := by rw [abs_of_nonneg hx0]; exact hx.2
      have hg := lemma14_sample_count_lower T n x 0 h5 hn hnT hsmall
      rw [oneStepImprovement_eq_hinge] at hg
      exact hg)
  have hp := mul_le_mul_of_nonneg_left hmass
    (mul_nonneg gainConstant_positive.le (invPower_nonneg 6 T))
  have he : (gainConstant * invPower 6 T) * (lowerConstant * invPower 170 T) =
      (gainConstant * lowerConstant) * invPower 176 T := by
    rw [← invPower_product 6 170 T]
    ring
  rw [he] at hp
  exact hp.trans hband

/-- Both Eq. (24) inequalities proved THROUGH the explicit common-sample coupling. -/
theorem lemma19_individual_gains_via_coupling (T q t : ℕ) (CU : ℝ)
    (p : MeanPath) (c : Counts) (hT : T = 2 * q + 1) (ht : 4 ≤ t) (hpre : t < T)
    (hc : horizonConsistent t c) (hW : newW T q CU p c) :
    (gainConstant * lowerConstant) * invPower 176 T ≤
      leftAction (T - t) (p 1 c.n1) (p 2 c.n2) c -
        payoff (T - t) (p 1 c.n1) (p 2 c.n2) c ∧
    (gainConstant * lowerConstant) * invPower 176 T ≤
      rightAction (T - t) (p 1 c.n1) (p 2 c.n2) c -
        payoff (T - t) (p 1 c.n1) (p 2 c.n2) c := by
  have hq : 2 ≤ q := by omega
  have h1 : 0 < c.n1 := by have := hc.1; omega
  have h2 : 0 < c.n2 := by have := hc.2.1; omega
  have hs : c.n1 + c.n2 + (T - t) = 2 * q - 1 := by
    have := hc.2.2.2
    have := hc.2.2.1
    omega
  have hcap1 := hW.2.2.2.2.2.1
  have hcap2 := hW.2.2.2.2.2.2.1
  have hl := oriented_skip_left_counts q (T - t) c (by omega) hcap1 hcap2 hs
  have hr := equation22_terminal_counts q (T - t) c (by omega) hcap1 hcap2 hs
  rw [left_gain_common_sample_identity q (T - t) c _ _ (by omega) h1 h2 hcap1 hcap2 hs,
    right_gain_common_sample_identity q (T - t) c _ _ (by omega) h1 h2 hcap1 hcap2 hs]
  constructor
  · apply arbitrary_rule_hinge_gain_lower rightTie rightTie_smaller T q t
      (ruleRun rightTie (T - t) c).n1 CU p c hT ht hpre hc hW
    · rw [hl.1]; split_ifs <;> omega
    · rw [hl.1]; split_ifs <;> omega
  · apply arbitrary_rule_hinge_gain_lower leftTie leftTie_smaller T q t
      (ruleRun leftTie (T - t) c).n2 CU p c hT ht hpre hc hW
    · rw [leftTie_run, hr.2]; split_ifs <;> omega
    · rw [leftTie_run, hr.2]; split_ifs <;> omega

end
end BayesOptimal.Coupling19

end

/-! ## Coupling19Saturated -/
section

open MeasureTheory ProbabilityTheory Set
open scoped NNReal ENNReal

namespace BayesOptimal.Coupling19

open BayesOptimal.Foundations.Counts BayesOptimal.Foundations.Gaussian BayesOptimal.Foundations.TwoArmBellman BayesOptimal.Foundations.TwoArmGain
open BayesOptimal.Foundations.Rates BayesOptimal.Foundations.TerminalBounds BayesOptimal.Foundations.PredictiveBound
open BayesOptimal.CommonSample BayesOptimal.Forecast BayesOptimal.Comparison

noncomputable section

theorem saturated_left_forced_permutation (q k : ℕ) (c : Counts)
    (hsat : c.n1 = q) (hs : c.n1 + c.n2 + k = 2 * q - 1) :
    (true :: schedule leftTie k (leftStep c)).Perm (schedule leftTie k c ++ [true]) := by
  apply permutation_of_finalCounts _ _ c
  simp only [finalCounts, step, ↓reduceIte, schedule_final, leftTie_run, finalCounts_append]
  exact balancedRun_left_commute k c (by omega)

theorem saturated_right_skip_rules_agree (q k : ℕ) (c : Counts) (hq : 0 < q)
    (hcap1 : c.n1 ≤ q) (hcap2 : c.n2 ≤ q)
    (hsat : c.n2 = q) (hs : c.n1 + c.n2 + k = 2 * q - 1) :
    ruleRun rightTie k c = balancedRun k c := by
  have hl := oriented_skip_left_counts q k c hq hcap1 hcap2 hs
  have hr := equation22_terminal_counts q k c hq hcap1 hcap2 hs
  have hsmall : c.n1 < q := by omega
  have hn3 : (ruleRun rightTie k c).n3 = c.n3 := by
    rw [rightTie_run_swap]
    exact balancedRun_n3 k (swapCounts c)
  apply counts_ext
  · rw [hl.1, hr.1, if_neg (by omega : ¬ c.n1 = q), if_pos hsat]
  · rw [hl.2, hr.2, if_neg (by omega : ¬ c.n1 = q), if_pos hsat]
  · rw [hn3, balancedRun_n3]

theorem saturated_right_forced_permutation (q k : ℕ) (c : Counts) (hq : 0 < q)
    (hcap1 : c.n1 ≤ q) (hcap2 : c.n2 ≤ q)
    (hsat : c.n2 = q) (hs : c.n1 + c.n2 + k = 2 * q - 1) :
    (false :: schedule leftTie k (rightStep c)).Perm (schedule rightTie k c ++ [false]) := by
  apply permutation_of_finalCounts _ _ c
  simp only [finalCounts, step, Bool.false_eq_true, ↓reduceIte,
    schedule_final, leftTie_run, finalCounts_append]
  rw [saturated_right_skip_rules_agree q k c hq hcap1 hcap2 hsat hs]
  exact repaired_right_allocation_plus_one q k c hq hcap1 hcap2 hs

/-- Fubini and allocation permutation identify the actual forced-first risks
with two experiments that have a shared prefix and different final samples. -/
theorem paired_forced_action_gap_identity (r : ℕ → ℕ → Bool) (k : ℕ)
    (c : Counts) (m1 m2 : ℝ) (h1 : 0 < c.n1) (h2 : 0 < c.n2)
    (hleft : (true :: schedule leftTie k (leftStep c)).Perm (schedule r k c ++ [true]))
    (hright : (false :: schedule leftTie k (rightStep c)).Perm (schedule r k c ++ [false])) :
    rightAction k m1 m2 c - leftAction k m1 m2 c =
      ∫ x : ℝ, (hingeLoss |x| (updateVariance (ruleRun r k c).n2) -
        hingeLoss |x| (updateVariance (ruleRun r k c).n1))
        ∂gaussianReal (m1 - m2) (ruleAccumulatedVariance r k c) := by
  have hl := risk_permutation _ _ hleft c m1 m2 h1 h2
  have hr := risk_permutation _ _ hright c m1 m2 h1 h2
  rw [forced_left_risk_eq k c m1 m2 h1 h2] at hl
  rw [forced_right_risk_eq k c m1 m2 h1 h2] at hr
  have hg := common_prefix_last_action_gap (schedule r k c) c m1 m2 h1 h2
  rw [← hl, ← hr, schedule_final, schedule_variance] at hg
  linarith only [hg]

theorem arbitrary_rule_hinge_difference_lower (r : ℕ → ℕ → Bool) (hr : SmallerCountRule r)
    (T q t ni nj : ℕ) (CU : ℝ) (p : MeanPath) (c : Counts)
    (hT : T = 2 * q + 1) (ht : 4 ≤ t) (hpre : t < T)
    (hc : horizonConsistent t c) (hW : newW T q CU p c)
    (hj : 1 ≤ nj) (hstrict : nj < ni) (hiT : ni < T) :
    (comparisonConstant * lowerConstant) * invPower 178 T ≤
      ∫ x : ℝ, (hingeLoss |x| (updateVariance (nj : ℝ≥0)) -
        hingeLoss |x| (updateVariance (ni : ℝ≥0)))
        ∂gaussianReal (terminalGap p c) (ruleAccumulatedVariance r (T - t) c) := by
  have h5 : 5 ≤ T := by omega
  have hip : 0 < (ni : ℝ≥0) := by exact_mod_cast (show 0 < ni by omega)
  have hjp : 0 < (nj : ℝ≥0) := by exact_mod_cast (show 0 < nj by omega)
  have hv := updateVariance_strictAntitone (nj : ℝ≥0) (ni : ℝ≥0) hjp
    (by exact_mod_cast hstrict)
  have hi : Integrable (fun x : ℝ => hingeLoss |x| (updateVariance (nj : ℝ≥0)) -
      hingeLoss |x| (updateVariance (ni : ℝ≥0)))
      (gaussianReal (terminalGap p c) (ruleAccumulatedVariance r (T - t) c)) :=
    (absolute_hinge_gaussian_integrable _ _ _).sub (absolute_hinge_gaussian_integrable _ _ _)
  have hmass := BayesOptimal.Forecast.lemma18 r hr T q t CU p c hT ht hpre hc hW
  rw [ruleForecast_gaussian] at hmass
  have hband := BayesOptimal.Foundations.DynamicGain.gaussian_integral_band_lower hi
    (fun x => sub_nonneg.mpr (hingeLoss_strictMono_variance |x| (abs_nonneg _) _ _ hv).le)
    (r := 8) (fun x hx => by
      have hx0 : 0 ≤ x := (invPower_nonneg 2 T).trans hx.1
      have hsmall : |x| ≤ 2 * invPower 2 T := by rw [abs_of_nonneg hx0]; exact hx.2
      have hg := lemma15_terminal_action_gap_conservative T ni nj x h5 hj hstrict hiT hsmall
      rw [terminal_actionLoss_difference_eq x (ni : ℝ≥0) (nj : ℝ≥0) hjp hip] at hg
      exact hg)
  have hp := mul_le_mul_of_nonneg_left hmass
    (mul_nonneg comparisonConstant_positive.le (invPower_nonneg 8 T))
  have he : (comparisonConstant * invPower 8 T) * (lowerConstant * invPower 170 T) =
      (comparisonConstant * lowerConstant) * invPower 178 T := by
    rw [← invPower_product 8 170 T]
    ring
  rw [he] at hp
  exact hp.trans hband

/-- The full saturated-arm Eq. (25), using the literal shared-prefix experiments. -/
theorem lemma19_saturated_left_gap_via_coupling (T q t : ℕ) (CU : ℝ)
    (p : MeanPath) (c : Counts) (hT : T = 2 * q + 1) (ht : 4 ≤ t) (hpre : t < T)
    (hc : horizonConsistent t c) (hW : newW T q CU p c) (hsat : c.n1 = q) :
    (comparisonConstant * lowerConstant) * invPower 178 T ≤
      rightAction (T - t) (p 1 c.n1) (p 2 c.n2) c -
        leftAction (T - t) (p 1 c.n1) (p 2 c.n2) c := by
  have hq : 2 ≤ q := by omega
  have h1 : 0 < c.n1 := by have := hc.1; omega
  have h2 : 0 < c.n2 := by have := hc.2.1; omega
  have hs : c.n1 + c.n2 + (T - t) = 2 * q - 1 := by
    have := hc.2.2.2
    have := hc.2.2.1
    omega
  have hcap1 := hW.2.2.2.2.2.1
  have hcap2 := hW.2.2.2.2.2.2.1
  have hsmall : c.n2 < q := by omega
  have hf := equation22_terminal_counts q (T - t) c (by omega) hcap1 hcap2 hs
  simp only [if_neg (by omega : ¬ c.n2 = q)] at hf
  rw [paired_forced_action_gap_identity leftTie (T - t) c _ _ h1 h2
    (saturated_left_forced_permutation q (T - t) c hsat hs)
    (forced_right_is_common_then_last q (T - t) c (by omega) hcap1 hcap2 hs)]
  simp only [leftTie_run, hf.1, hf.2]
  exact arbitrary_rule_hinge_difference_lower leftTie leftTie_smaller T q t q (q - 1)
    CU p c hT ht hpre hc hW (by omega) (by omega) (by omega)

theorem lemma19_saturated_right_gap_via_coupling (T q t : ℕ) (CU : ℝ)
    (p : MeanPath) (c : Counts) (hT : T = 2 * q + 1) (ht : 4 ≤ t) (hpre : t < T)
    (hc : horizonConsistent t c) (hW : newW T q CU p c) (hsat : c.n2 = q) :
    (comparisonConstant * lowerConstant) * invPower 178 T ≤
      leftAction (T - t) (p 1 c.n1) (p 2 c.n2) c -
        rightAction (T - t) (p 1 c.n1) (p 2 c.n2) c := by
  have hq : 2 ≤ q := by omega
  have h1 : 0 < c.n1 := by have := hc.1; omega
  have h2 : 0 < c.n2 := by have := hc.2.1; omega
  have hs : c.n1 + c.n2 + (T - t) = 2 * q - 1 := by
    have := hc.2.2.2
    have := hc.2.2.1
    omega
  have hcap1 := hW.2.2.2.2.2.1
  have hcap2 := hW.2.2.2.2.2.2.1
  have hsmall : c.n1 < q := by omega
  have hf := oriented_skip_left_counts q (T - t) c (by omega) hcap1 hcap2 hs
  simp only [if_neg (by omega : ¬ c.n1 = q)] at hf
  have hgap := paired_forced_action_gap_identity rightTie (T - t) c (p 1 c.n1) (p 2 c.n2) h1 h2
    (forced_left_is_common_then_last q (T - t) c (by omega) hcap1 hcap2 hs)
    (saturated_right_forced_permutation q (T - t) c (by omega) hcap1 hcap2 hsat hs)
  rw [hf.1, hf.2] at hgap
  rw [integral_sub (absolute_hinge_gaussian_integrable _ _ _)
    (absolute_hinge_gaussian_integrable _ _ _)] at hgap
  have hbound := arbitrary_rule_hinge_difference_lower rightTie rightTie_smaller T q t q (q - 1)
    CU p c hT ht hpre hc hW (by omega) (by omega) (by omega)
  rw [integral_sub (absolute_hinge_gaussian_integrable _ _ _)
    (absolute_hinge_gaussian_integrable _ _ _)] at hbound
  unfold terminalGap at hbound
  linarith only [hgap, hbound]

end
end BayesOptimal.Coupling19

end

/-! ## CommonSampleLaw -/
section

open MeasureTheory ProbabilityTheory Set
open scoped NNReal ENNReal

namespace BayesOptimal.CommonSample

open BayesOptimal.Foundations.Counts BayesOptimal.Foundations.Gaussian BayesOptimal.Foundations.TwoArmBellman BayesOptimal.Foundations.TwoArmGain
open BayesOptimal.TwoArmOptimal

noncomputable section

theorem centered_pair_difference_law (c : Counts) :
    HasLaw (fun x : Fin 2 → ℝ => x 0 - x 1) (gaussianReal 0 (variance c))
      (FinitePosterior.centeredLaw (pairPrecisions c.n1 c.n2)) := by
  let μ := FinitePosterior.centeredLaw (pairPrecisions c.n1 c.n2)
  have h0 : HasLaw (fun x : Fin 2 → ℝ => x 0)
      (gaussianReal 0 (c.n1 : ℝ≥0)⁻¹) μ := by
    exact (measurePreserving_eval (fun a : Fin 2 => gaussianReal 0
      ((pairPrecisions c.n1 c.n2) a)⁻¹) 0).hasLaw
  have h1 : HasLaw (fun x : Fin 2 → ℝ => -x 1)
      (gaussianReal 0 (c.n2 : ℝ≥0)⁻¹) μ := by
    have he : HasLaw (fun x : Fin 2 → ℝ => x 1)
        (gaussianReal 0 (c.n2 : ℝ≥0)⁻¹) μ :=
      (measurePreserving_eval (fun a : Fin 2 => gaussianReal 0
        ((pairPrecisions c.n1 c.n2) a)⁻¹) 1).hasLaw
    have hn : HasLaw (fun x : ℝ => -x) (gaussianReal 0 (c.n2 : ℝ≥0)⁻¹)
        (gaussianReal 0 (c.n2 : ℝ≥0)⁻¹) := by
      constructor
      · exact (by fun_prop : AEMeasurable (fun x : ℝ => -x) (gaussianReal 0 (c.n2 : ℝ≥0)⁻¹))
      · simpa using gaussianReal_map_neg (μ := (0 : ℝ)) (v := (c.n2 : ℝ≥0)⁻¹)
    exact hn.fun_comp he
  have hind : iIndepFun (fun a : Fin 2 => fun x : Fin 2 → ℝ => x a) μ :=
    iIndepFun_pi (fun _ => measurable_id.aemeasurable)
  have hInd : IndepFun (fun x : Fin 2 → ℝ => x 0) (fun x : Fin 2 → ℝ => -x 1) μ :=
    (hind.indepFun (by decide : (0 : Fin 2) ≠ 1)).comp measurable_id (by fun_prop)
  have h := hInd.hasLaw_fun_add h0 h1
  rw [gaussianReal_conv_gaussianReal, zero_add] at h
  simpa only [sub_eq_add_neg, BayesOptimal.Foundations.TwoArmBellman.variance, posteriorVariance] using h

theorem potential_eq_gaussian (c : Counts) (m1 m2 : ℝ) :
    potential c m1 m2 = m2 + hingeLoss (m2 - m1) (variance c) := by
  let cp := pairPrecisions c.n1 c.n2
  let μ := FinitePosterior.centeredLaw cp
  letI : IsProbabilityMeasure μ := by dsimp [μ]; infer_instance
  have hi1 : Integrable (fun x : Fin 2 → ℝ => x 1) μ :=
    FinitePosterior.centered_coordinate_integrable cp 1
  have hi0 : Integrable (fun x : Fin 2 → ℝ => x 0) μ :=
    FinitePosterior.centered_coordinate_integrable cp 0
  have hip : Integrable (fun x : Fin 2 → ℝ => max (x 0 - x 1 - (m2 - m1)) 0) μ :=
    ((hi0.sub hi1).sub (integrable_const (m2 - m1))).pos_part
  have hf (x : Fin 2 → ℝ) : FiniteGaussian.maxAll (pairMeans m1 m2 + x) =
      (m2 + x 1) + max (x 0 - x 1 - (m2 - m1)) 0 := by
    have he : pairMeans m1 m2 + x = pairMeans (m1 + x 0) (m2 + x 1) := by
      ext a
      fin_cases a <;> simp [pairMeans]
    rw [he, maxAll_pair]
    by_cases h : m1 + x 0 ≤ m2 + x 1
    · rw [max_eq_right h, max_eq_right (by linarith : x 0 - x 1 - (m2 - m1) ≤ 0), add_zero]
    · rw [max_eq_left (le_of_not_ge h), max_eq_left (by linarith : 0 ≤ x 0 - x 1 - (m2 - m1))]
      ring
  unfold potential FinitePosterior.potential FinitePosterior.expectation
  simp_rw [hf]
  change (∫ x : Fin 2 → ℝ, (m2 + x 1) + max (x 0 - x 1 - (m2 - m1)) 0 ∂μ) = _
  have him : Integrable (fun x : Fin 2 → ℝ => m2 + x 1) μ := (integrable_const m2).add hi1
  rw [integral_add him hip, integral_add (integrable_const m2) hi1, integral_const]
  have hm1 : (∫ x : Fin 2 → ℝ, x 1 ∂μ) = 0 := by
    have hcoord : HasLaw (fun x : Fin 2 → ℝ => x 1) (gaussianReal 0 (cp 1)⁻¹) μ :=
      (measurePreserving_eval (fun a => gaussianReal 0 (cp a)⁻¹) 1).hasLaw
    exact hcoord.integral_eq.trans integral_id_gaussianReal
  rw [hm1]
  simp only [measureReal_univ_eq_one, one_smul, add_zero]
  congr 1
  have h := (centered_pair_difference_law c).integral_comp
    (f := fun x : ℝ => max (x - (m2 - m1)) 0) (by fun_prop)
  exact h

theorem terminalRisk_eq_posteriorLoss (c : Counts) (m1 m2 : ℝ) :
    terminalRisk c m1 m2 = posteriorLoss (m1 - m2) (variance c) := by
  unfold terminalRisk
  rw [potential_eq_gaussian]
  have h := hingeLoss_sub_abs (m2 - m1) (variance c)
  change m2 + hingeLoss (m2 - m1) (variance c) - max m1 m2 = hingeLoss |m1 - m2| (variance c)
  rw [abs_sub_comm m1 m2]
  by_cases he : m1 ≤ m2
  · rw [max_eq_right he] at ⊢
    rw [max_eq_right (by linarith : -(m2 - m1) ≤ 0)] at h
    linarith only [h]
  · rw [max_eq_left (le_of_not_ge he)]
    rw [max_eq_left (by linarith : 0 ≤ -(m2 - m1))] at h
    linarith only [h]

def blockSum {M : Type*} [AddCommMonoid M] (N n b : ℕ) (f : Fin N → M) : M :=
  ∑ j : Fin N, if n ≤ j.val ∧ j.val < b then f j else 0

theorem blockSum_empty {M : Type*} [AddCommMonoid M] (N n : ℕ) (f : Fin N → M) :
    blockSum N n n f = 0 := by
  apply Finset.sum_eq_zero
  intro j _
  rw [if_neg (by omega : ¬ (n ≤ j.val ∧ j.val < n))]

theorem blockSum_head {M : Type*} [AddCommMonoid M] (N n b : ℕ) (f : Fin N → M)
    (hn : n < b) (hb : b ≤ N) :
    blockSum N n b f = f ⟨n, by omega⟩ + blockSum N (n + 1) b f := by
  have hsplit (j : Fin N) : (if n ≤ j.val ∧ j.val < b then f j else 0) =
      (if j = ⟨n, by omega⟩ then f j else 0) +
      (if n + 1 ≤ j.val ∧ j.val < b then f j else 0) := by
    by_cases he : j.val = n
    · have he' : j = ⟨n, by omega⟩ := Fin.ext he
      rw [he']
      simp [hn]
    · have he' : j ≠ ⟨n, by omega⟩ := fun h => he (congrArg Fin.val h)
      have heq : (n ≤ j.val ∧ j.val < b) ↔ (n + 1 ≤ j.val ∧ j.val < b) := by omega
      simp only [if_neg he', zero_add, heq]
  unfold blockSum
  simp_rw [hsplit]
  rw [Finset.sum_add_distrib]
  simp

theorem finalCounts_monotone (s : List Bool) (c : Counts) :
    c.n1 ≤ (finalCounts s c).n1 ∧ c.n2 ≤ (finalCounts s c).n2 := by
  induction s generalizing c with
  | nil => exact ⟨le_rfl, le_rfl⟩
  | cons i s ih =>
    have hh := ih (step i c)
    cases i <;> simp only [finalCounts, step, Bool.false_eq_true, ↓reduceIte, leftStep, rightStep] at * <;> omega

theorem terminalMeans_eq_blockSum (N : ℕ) (s : List Bool) (c : Counts)
    (m : ℝ × ℝ) (x : Bool × Fin N → ℝ)
    (hN1 : (finalCounts s c).n1 ≤ N) (hN2 : (finalCounts s c).n2 ≤ N) :
    terminalMeans s c m (finiteStream N x) =
      (m.1 + blockSum N c.n1 (finalCounts s c).n1 (fun j => x (true, j)),
       m.2 + blockSum N c.n2 (finalCounts s c).n2 (fun j => x (false, j))) := by
  induction s generalizing c m with
  | nil => simp [terminalMeans, finalCounts, blockSum_empty]
  | cons i s ih =>
    cases i
    · change (finalCounts s (rightStep c)).n1 ≤ N at hN1
      change (finalCounts s (rightStep c)).n2 ≤ N at hN2
      simp only [terminalMeans, finalCounts, step, commonUpdate, Bool.false_eq_true, ↓reduceIte]
      rw [ih (rightStep c) _ hN1 hN2]
      have hm := finalCounts_monotone s (rightStep c)
      have hn : c.n2 < (finalCounts s (rightStep c)).n2 := by
        change c.n1 ≤ (finalCounts s (rightStep c)).n1 ∧ c.n2 + 1 ≤ (finalCounts s (rightStep c)).n2 at hm
        omega
      have hcn : c.n2 < N := by omega
      change (m.1 + blockSum N c.n1 (finalCounts s (rightStep c)).n1 _,
        (m.2 + finiteStream N x false c.n2) + blockSum N (c.n2 + 1) (finalCounts s (rightStep c)).n2 _) =
        (m.1 + blockSum N c.n1 (finalCounts s (rightStep c)).n1 _,
        m.2 + blockSum N c.n2 (finalCounts s (rightStep c)).n2 _)
      simp only [finiteStream, dif_pos hcn]
      rw [blockSum_head N c.n2 (finalCounts s (rightStep c)).n2 _ hn hN2]
      congr 1
      ring
    · change (finalCounts s (leftStep c)).n1 ≤ N at hN1
      change (finalCounts s (leftStep c)).n2 ≤ N at hN2
      simp only [terminalMeans, finalCounts, step, commonUpdate, ↓reduceIte]
      rw [ih (leftStep c) _ hN1 hN2]
      have hm := finalCounts_monotone s (leftStep c)
      have hn : c.n1 < (finalCounts s (leftStep c)).n1 := by
        change c.n1 + 1 ≤ (finalCounts s (leftStep c)).n1 ∧ c.n2 ≤ (finalCounts s (leftStep c)).n2 at hm
        omega
      have hcn : c.n1 < N := by omega
      change ((m.1 + finiteStream N x true c.n1) + blockSum N (c.n1 + 1) (finalCounts s (leftStep c)).n1 _,
        m.2 + blockSum N c.n2 (finalCounts s (leftStep c)).n2 _) =
        (m.1 + blockSum N c.n1 (finalCounts s (leftStep c)).n1 _,
        m.2 + blockSum N c.n2 (finalCounts s (leftStep c)).n2 _)
      simp only [finiteStream, dif_pos hcn]
      rw [blockSum_head N c.n1 (finalCounts s (leftStep c)).n1 _ hn hN1]
      congr 1
      ring

end
end BayesOptimal.CommonSample

end

/-! ## CommonSampleJoint -/
section

open MeasureTheory ProbabilityTheory Set
open scoped NNReal ENNReal

namespace BayesOptimal.CommonSample

open BayesOptimal.Foundations.Counts BayesOptimal.Foundations.Gaussian BayesOptimal.Foundations.TwoArmBellman BayesOptimal.Foundations.TwoArmGain

noncomputable section

def squareWeight (a : ℝ) : ℝ≥0 := ⟨a ^ 2, sq_nonneg a⟩

def weightedSum {N : ℕ} (a : Bool × Fin N → ℝ) (x : Bool × Fin N → ℝ) : ℝ :=
  ∑ j, a j * x j

def weightedVariance {N : ℕ} (a : Bool × Fin N → ℝ) (j : Bool × Fin N) : ℝ≥0 :=
  squareWeight (a j) * updateVariance (j.2.val : ℝ≥0)

theorem weighted_coordinate_law {N : ℕ} (a : Bool × Fin N → ℝ) (j : Bool × Fin N) :
    HasLaw (fun x : Bool × Fin N → ℝ => a j * x j) (gaussianReal 0 (weightedVariance a j)) (streamLaw N) := by
  have he : HasLaw (fun x : Bool × Fin N → ℝ => x j)
      (gaussianReal 0 (updateVariance (j.2.val : ℝ≥0))) (streamLaw N) :=
    (measurePreserving_eval (fun i : Bool × Fin N => gaussianReal 0
      (updateVariance (i.2.val : ℝ≥0))) j).hasLaw
  have hs : HasLaw (fun x : ℝ => a j * x) (gaussianReal 0 (weightedVariance a j))
      (gaussianReal 0 (updateVariance (j.2.val : ℝ≥0))) := by
    constructor
    · exact (by fun_prop : AEMeasurable (fun x : ℝ => a j * x) (gaussianReal 0 (updateVariance (j.2.val : ℝ≥0))))
    · rw [gaussianReal_map_const_mul, mul_zero]
      rfl
  exact hs.fun_comp he

theorem weighted_finset_law {N : ℕ} (a : Bool × Fin N → ℝ) (s : Finset (Bool × Fin N)) :
    HasLaw (fun x : Bool × Fin N → ℝ => ∑ j ∈ s, a j * x j)
      (gaussianReal 0 (∑ j ∈ s, weightedVariance a j)) (streamLaw N) := by
  have hind : iIndepFun (fun j : Bool × Fin N => fun x : Bool × Fin N → ℝ => a j * x j) (streamLaw N) :=
    iIndepFun_pi (fun _ => by fun_prop)
  induction s using Finset.induction_on with
  | empty =>
    constructor
    · simp only [Finset.sum_empty]; exact aemeasurable_const
    · simp [gaussianReal_zero_var]
  | insert j s hj ih =>
    have hInd := hind.indepFun_finset_sum_of_notMem (fun _ => by fun_prop) hj
    have hInd' : IndepFun (fun x : Bool × Fin N → ℝ => a j * x j)
        (fun x : Bool × Fin N → ℝ => ∑ k ∈ s, a k * x k) (streamLaw N) := by
      simpa only [Finset.sum_fn] using hInd.symm
    have h := hInd'.hasLaw_fun_add (weighted_coordinate_law a j) ih
    rw [gaussianReal_conv_gaussianReal, zero_add] at h
    simpa only [Finset.sum_insert hj] using h

theorem weightedSum_law {N : ℕ} (a : Bool × Fin N → ℝ) :
    HasLaw (weightedSum a) (gaussianReal 0 (∑ j, weightedVariance a j)) (streamLaw N) :=
  weighted_finset_law a Finset.univ

def gapCoefficient (N : ℕ) (c d : Counts) (j : Bool × Fin N) : ℝ :=
  if j.1 then if c.n1 ≤ j.2.val ∧ j.2.val < d.n1 then 1 else 0
  else if c.n2 ≤ j.2.val ∧ j.2.val < d.n2 then -1 else 0

theorem gap_weightedSum (N : ℕ) (c d : Counts) (x : Bool × Fin N → ℝ) :
    weightedSum (gapCoefficient N c d) x =
      blockSum N c.n1 d.n1 (fun j => x (true, j)) -
        blockSum N c.n2 d.n2 (fun j => x (false, j)) := by
  unfold weightedSum
  rw [Fintype.sum_prod_type, Fintype.sum_bool]
  simp only [gapCoefficient, ↓reduceIte, Bool.false_eq_true, ite_mul, one_mul, zero_mul, neg_one_mul]
  simp only [blockSum, sub_eq_add_neg, ← Finset.sum_neg_distrib]
  congr 1
  apply Finset.sum_congr rfl
  intro j _
  split_ifs <;> simp

theorem gap_weightedVariance (N : ℕ) (c d : Counts) :
    (∑ j : Bool × Fin N, weightedVariance (gapCoefficient N c d) j) =
      blockSum N c.n1 d.n1 (fun j => updateVariance (j.val : ℝ≥0)) +
        blockSum N c.n2 d.n2 (fun j => updateVariance (j.val : ℝ≥0)) := by
  rw [Fintype.sum_prod_type, Fintype.sum_bool]
  unfold weightedVariance gapCoefficient
  simp only [↓reduceIte, Bool.false_eq_true]
  congr 1 <;> apply Finset.sum_congr rfl <;> intro j _ <;>
    split_ifs <;> simp [squareWeight]

theorem allocationVariance_eq_blockSum (N : ℕ) (s : List Bool) (c : Counts)
    (hN1 : (finalCounts s c).n1 ≤ N) (hN2 : (finalCounts s c).n2 ≤ N) :
    allocationVariance s c =
      blockSum N c.n1 (finalCounts s c).n1 (fun j => updateVariance (j.val : ℝ≥0)) +
        blockSum N c.n2 (finalCounts s c).n2 (fun j => updateVariance (j.val : ℝ≥0)) := by
  induction s generalizing c with
  | nil => simp [allocationVariance, finalCounts, blockSum_empty]
  | cons i s ih =>
    cases i
    · change (finalCounts s (rightStep c)).n1 ≤ N at hN1
      change (finalCounts s (rightStep c)).n2 ≤ N at hN2
      change updateVariance (c.n2 : ℝ≥0) + allocationVariance s (rightStep c) = _
      rw [ih (rightStep c) hN1 hN2]
      have hm := finalCounts_monotone s (rightStep c)
      have hn : c.n2 < (finalCounts s (rightStep c)).n2 := by
        change c.n1 ≤ (finalCounts s (rightStep c)).n1 ∧ c.n2 + 1 ≤ (finalCounts s (rightStep c)).n2 at hm
        omega
      change updateVariance (c.n2 : ℝ≥0) +
        (blockSum N c.n1 (finalCounts s (rightStep c)).n1 _ +
         blockSum N (c.n2 + 1) (finalCounts s (rightStep c)).n2 _) =
        blockSum N c.n1 (finalCounts s (rightStep c)).n1 _ +
         blockSum N c.n2 (finalCounts s (rightStep c)).n2 _
      rw [blockSum_head N c.n2 (finalCounts s (rightStep c)).n2 _ hn hN2]
      dsimp only
      exact add_left_comm _ _ _
    · change (finalCounts s (leftStep c)).n1 ≤ N at hN1
      change (finalCounts s (leftStep c)).n2 ≤ N at hN2
      change updateVariance (c.n1 : ℝ≥0) + allocationVariance s (leftStep c) = _
      rw [ih (leftStep c) hN1 hN2]
      have hm := finalCounts_monotone s (leftStep c)
      have hn : c.n1 < (finalCounts s (leftStep c)).n1 := by
        change c.n1 + 1 ≤ (finalCounts s (leftStep c)).n1 ∧ c.n2 ≤ (finalCounts s (leftStep c)).n2 at hm
        omega
      change updateVariance (c.n1 : ℝ≥0) +
        (blockSum N (c.n1 + 1) (finalCounts s (leftStep c)).n1 _ +
         blockSum N c.n2 (finalCounts s (leftStep c)).n2 _) =
        blockSum N c.n1 (finalCounts s (leftStep c)).n1 _ +
         blockSum N c.n2 (finalCounts s (leftStep c)).n2 _
      rw [blockSum_head N c.n1 (finalCounts s (leftStep c)).n1 _ hn hN1]
      dsimp only
      exact (add_assoc _ _ _).symm

theorem terminal_gap_law (N : ℕ) (s : List Bool) (c : Counts) (m1 m2 : ℝ)
    (hN1 : (finalCounts s c).n1 ≤ N) (hN2 : (finalCounts s c).n2 ≤ N) :
    HasLaw (fun x : Bool × Fin N → ℝ =>
      (terminalMeans s c (m1, m2) (finiteStream N x)).1 -
        (terminalMeans s c (m1, m2) (finiteStream N x)).2)
      (gaussianReal (m1 - m2) (allocationVariance s c)) (streamLaw N) := by
  have hg := weightedSum_law (gapCoefficient N c (finalCounts s c))
  rw [gap_weightedVariance, ← allocationVariance_eq_blockSum N s c hN1 hN2] at hg
  have hshift : HasLaw (fun z : ℝ => (m1 - m2) + z)
      (gaussianReal (m1 - m2) (allocationVariance s c)) (gaussianReal 0 (allocationVariance s c)) := by
    constructor
    · exact (by fun_prop : AEMeasurable (fun z : ℝ => (m1 - m2) + z) (gaussianReal 0 (allocationVariance s c)))
    · simpa using gaussianReal_map_const_add (μ := (0 : ℝ)) (v := allocationVariance s c) (m1 - m2)
  have h := hshift.fun_comp hg
  convert h using 1
  funext x
  rw [terminalMeans_eq_blockSum N s c (m1, m2) x hN1 hN2, gap_weightedSum]
  dsimp
  ring

end
end BayesOptimal.CommonSample

end

/-! ## CommonSampleIntegral -/
section

open MeasureTheory ProbabilityTheory Set
open scoped NNReal ENNReal

namespace BayesOptimal.CommonSample

open BayesOptimal.Foundations.Counts BayesOptimal.Foundations.Gaussian BayesOptimal.Foundations.TwoArmBellman BayesOptimal.Foundations.TwoArmGain

noncomputable section

def streamTerminalRisk (N : ℕ) (s : List Bool) (c : Counts) (m1 m2 : ℝ)
    (x : Bool × Fin N → ℝ) : ℝ :=
  terminalRisk (finalCounts s c)
    (terminalMeans s c (m1, m2) (finiteStream N x)).1
    (terminalMeans s c (m1, m2) (finiteStream N x)).2

theorem streamTerminalRisk_integrable (N : ℕ) (s : List Bool) (c : Counts) (m1 m2 : ℝ)
    (hN1 : (finalCounts s c).n1 ≤ N) (hN2 : (finalCounts s c).n2 ≤ N) :
    Integrable (streamTerminalRisk N s c m1 m2) (streamLaw N) := by
  let g : (Bool × Fin N → ℝ) → ℝ := fun x =>
    (terminalMeans s c (m1, m2) (finiteStream N x)).1 -
      (terminalMeans s c (m1, m2) (finiteStream N x)).2
  have hlaw : HasLaw g (gaussianReal (m1 - m2) (allocationVariance s c)) (streamLaw N) :=
    terminal_gap_law N s c m1 m2 hN1 hN2
  have hi : Integrable (fun d : ℝ => hingeLoss |d|
      (BayesOptimal.Foundations.TwoArmBellman.variance (finalCounts s c))) ((streamLaw N).map g) := by
    rw [hlaw.map_eq]
    exact absolute_hinge_gaussian_integrable _ _ _
  have h := (integrable_map_measure hi.aestronglyMeasurable hlaw.aemeasurable).mp hi
  convert h using 1
  funext x
  exact terminalRisk_eq_posteriorLoss (finalCounts s c) _ _

/-- Identification of the SINGLE joint per-arm Gaussian common-sample space
with the recursively integrated actual posterior-predictive regret. No
distributional or coupling hypothesis is assumed. -/
theorem stream_integral_eq_recursive_risk (N : ℕ) (s : List Bool) (c : Counts)
    (m1 m2 : ℝ) (h1 : 0 < c.n1) (h2 : 0 < c.n2)
    (hN1 : (finalCounts s c).n1 ≤ N) (hN2 : (finalCounts s c).n2 ≤ N) :
    (∫ x : Bool × Fin N → ℝ, streamTerminalRisk N s c m1 m2 x ∂streamLaw N) =
      risk s c m1 m2 := by
  have hlaw := terminal_gap_law N s c m1 m2 hN1 hN2
  have hi := absolute_hinge_gaussian_integrable (m1 - m2) (allocationVariance s c)
    (BayesOptimal.Foundations.TwoArmBellman.variance (finalCounts s c))
  have hmap := hlaw.integral_comp hi.aestronglyMeasurable
  have hterminal : (fun x : Bool × Fin N → ℝ => streamTerminalRisk N s c m1 m2 x) =
      (fun x : Bool × Fin N → ℝ => hingeLoss
        |(terminalMeans s c (m1, m2) (finiteStream N x)).1 -
          (terminalMeans s c (m1, m2) (finiteStream N x)).2|
        (BayesOptimal.Foundations.TwoArmBellman.variance (finalCounts s c))) := by
    funext x
    exact terminalRisk_eq_posteriorLoss (finalCounts s c) _ _
  rw [hterminal]
  change (∫ x : Bool × Fin N → ℝ, ((fun d : ℝ => hingeLoss |d|
    (BayesOptimal.Foundations.TwoArmBellman.variance (finalCounts s c))) ∘
    (fun x : Bool × Fin N → ℝ => (terminalMeans s c (m1, m2) (finiteStream N x)).1 -
      (terminalMeans s c (m1, m2) (finiteStream N x)).2)) x ∂streamLaw N) = _
  rw [hmap]
  rw [risk_eq s c m1 m2 h1 h2, utility_eq, potential_eq_gaussian]
  have hs := allocationVariance_decomposition s c h1 h2
  rw [← hs]
  have hg := hinge_variance_increment_integral (m2 - m1) (allocationVariance s c)
    (BayesOptimal.Foundations.TwoArmBellman.variance (finalCounts s c))
  rw [show -(m2 - m1) = m1 - m2 by ring] at hg
  linarith only [hg]

theorem streamTerminalRisk_permutation (N : ℕ) (s u : List Bool) (h : s.Perm u)
    (c : Counts) (m1 m2 : ℝ) (x : Bool × Fin N → ℝ) :
    streamTerminalRisk N s c m1 m2 x = streamTerminalRisk N u c m1 m2 x := by
  unfold streamTerminalRisk
  rw [finalCounts_permutation s u h c, terminalMeans_permutation s u h c (m1, m2) (finiteStream N x)]

/-- The raw shared-sample terminal-risk integrals are equal pointwise before
integration under the SAME actual Gaussian product measure. -/
theorem stream_integral_permutation (N : ℕ) (s u : List Bool) (h : s.Perm u)
    (c : Counts) (m1 m2 : ℝ) :
    (∫ x : Bool × Fin N → ℝ, streamTerminalRisk N s c m1 m2 x ∂streamLaw N) =
      ∫ x : Bool × Fin N → ℝ, streamTerminalRisk N u c m1 m2 x ∂streamLaw N := by
  congr 1
  funext x
  exact streamTerminalRisk_permutation N s u h c m1 m2 x

end
end BayesOptimal.CommonSample

end

/-! ## CountModelBridge -/
section

open MeasureTheory ProbabilityTheory
open scoped NNReal ENNReal

namespace BayesOptimal.CountModelBridge

open BayesOptimal.Foundations.BayesianModel

noncomputable section

/-- The integer-count model is the finite Gaussian model with these precisions. -/
def natPrecisions (c : Counts) : FiniteGaussian.Precisions Arm :=
  fun a => (c a : ℝ≥0)

theorem natPrecisions_positive (c : Counts) (hc : ∀ a, 0 < c a) :
    ∀ a, 0 < natPrecisions c a := by
  intro a
  change (0 : ℝ≥0) < (c a : ℝ≥0)
  exact_mod_cast hc a

theorem advance_natPrecisions (c : Counts) (a : Arm) :
    FiniteGaussian.advance (natPrecisions c) a = natPrecisions (advance c a) := by
  funext b
  by_cases h : b = a <;>
    simp [FiniteGaussian.advance, natPrecisions, advance, h]

theorem shift_eq (m : Means) (a : Arm) (z : ℝ) :
    FiniteGaussian.shift m a z = shift m a z := rfl

theorem innovation_eq (c : Counts) (a : Arm) :
    FiniteGaussian.innovation (natPrecisions c) a = innovation c a := rfl

theorem maxAll_eq_terminal (m : Means) :
    FiniteGaussian.maxAll m = terminal m := by
  apply le_antisymm
  · apply FiniteGaussian.maxAll_le
    intro a
    fin_cases a
    · exact le_max_left _ _
    · exact (le_max_left _ _).trans (le_max_right _ _)
    · exact (le_max_right _ _).trans (le_max_right _ _)
  · unfold terminal
    apply max_le (FiniteGaussian.coordinate_le_maxAll m 0)
    exact max_le (FiniteGaussian.coordinate_le_maxAll m 1)
      (FiniteGaussian.coordinate_le_maxAll m 2)

theorem value_eq (k : ℕ) (c : Counts) (m : Means) :
    FiniteGaussian.value k (natPrecisions c) m = value k c m := by
  induction k generalizing c m with
  | zero => exact maxAll_eq_terminal m
  | succ k ih =>
    rw [FiniteGaussian.value_succ, maxAll_eq_terminal, value_succ]
    have ha (a : Arm) :
        FiniteGaussian.action k (natPrecisions c) m a = action k c m a := by
      unfold FiniteGaussian.action action
      simp only [advance_natPrecisions, shift_eq, innovation_eq, ih]
    simp only [terminal, ha]

theorem action_eq (k : ℕ) (c : Counts) (m : Means) (a : Arm) :
    FiniteGaussian.action k (natPrecisions c) m a = action k c m a := by
  unfold FiniteGaussian.action action
  simp only [advance_natPrecisions, shift_eq, innovation_eq, value_eq]

/-- Equality of generic action loss and generic optimal loss is exactly the
integer-count Bellman optimality predicate used by the main theorem. -/
theorem actionLoss_eq_loss_iff (k : ℕ) (c : Counts) (m : Means) (a : Arm)
    (hc : 0 < c a) :
    FinitePosterior.actionLoss k (natPrecisions c) m a =
      FinitePosterior.loss (k + 1) (natPrecisions c) m ↔
    action k c m a = value (k + 1) c m := by
  rw [FinitePosterior.actionLoss_eq k (natPrecisions c) m a (by
    change (0 : ℝ≥0) < (c a : ℝ≥0)
    exact_mod_cast hc)]
  unfold FinitePosterior.loss
  rw [action_eq, value_eq]
  exact sub_right_inj

end
end BayesOptimal.CountModelBridge

end

/-! ## Coupling19Stream -/
section

open MeasureTheory ProbabilityTheory Set
open scoped NNReal ENNReal

namespace BayesOptimal.Coupling19

open BayesOptimal.Foundations.Counts BayesOptimal.Foundations.Gaussian BayesOptimal.Foundations.TwoArmBellman BayesOptimal.Foundations.TwoArmGain
open BayesOptimal.CommonSample BayesOptimal.Forecast

noncomputable section

/-- Actual common-product-space loss reduction. The extra LEFT observation
is placed LAST; this equality identifies its integral with the forced-first
Bellman loss reduction and the conditional one-step-gain average. -/
theorem left_common_product_gain (N q k : ℕ) (c : Counts) (m1 m2 : ℝ)
    (hq : 0 < q) (h1 : 0 < c.n1) (h2 : 0 < c.n2)
    (hcap1 : c.n1 ≤ q) (hcap2 : c.n2 ≤ q)
    (hs : c.n1 + c.n2 + k = 2 * q - 1)
    (hN : q + 1 ≤ N) :
    (∫ x : Bool × Fin N → ℝ,
      (streamTerminalRisk N (schedule rightTie k c) c m1 m2 x -
       streamTerminalRisk N (schedule rightTie k c ++ [true]) c m1 m2 x) ∂streamLaw N) =
      leftAction k m1 m2 c - payoff k m1 m2 c := by
  have hskip := oriented_skip_left_counts q k c hq hcap1 hcap2 hs
  have hskip1 : (finalCounts (schedule rightTie k c) c).n1 ≤ N := by
    rw [schedule_final, hskip.1]
    split_ifs <;> omega
  have hskip2 : (finalCounts (schedule rightTie k c) c).n2 ≤ N := by
    rw [schedule_final, hskip.2]
    split_ifs <;> omega
  have hforce1 : (finalCounts (schedule rightTie k c ++ [true]) c).n1 ≤ N := by
    rw [finalCounts_append]
    change (finalCounts (schedule rightTie k c) c).n1 + 1 ≤ N
    rw [schedule_final, hskip.1]
    split_ifs <;> omega
  have hforce2 : (finalCounts (schedule rightTie k c ++ [true]) c).n2 ≤ N := by
    rw [finalCounts_append]
    exact hskip2
  rw [integral_sub (streamTerminalRisk_integrable N _ c m1 m2 hskip1 hskip2)
    (streamTerminalRisk_integrable N _ c m1 m2 hforce1 hforce2),
    stream_integral_eq_recursive_risk N _ c m1 m2 h1 h2 hskip1 hskip2,
    stream_integral_eq_recursive_risk N _ c m1 m2 h1 h2 hforce1 hforce2]
  have hcoup := risk_permutation _ _
    (forced_left_is_common_then_last q k c hq hcap1 hcap2 hs) c m1 m2 h1 h2
  rw [forced_left_risk_eq k c m1 m2 h1 h2] at hcoup
  rw [skip_risk_eq rightTie rightTie_smaller k c m1 m2 h1 h2, ← hcoup]
  ring

/-- The symmetric common-product-space loss reduction for arm 2. -/
theorem right_common_product_gain (N q k : ℕ) (c : Counts) (m1 m2 : ℝ)
    (hq : 0 < q) (h1 : 0 < c.n1) (h2 : 0 < c.n2)
    (hcap1 : c.n1 ≤ q) (hcap2 : c.n2 ≤ q)
    (hs : c.n1 + c.n2 + k = 2 * q - 1)
    (hN : q + 1 ≤ N) :
    (∫ x : Bool × Fin N → ℝ,
      (streamTerminalRisk N (schedule leftTie k c) c m1 m2 x -
       streamTerminalRisk N (schedule leftTie k c ++ [false]) c m1 m2 x) ∂streamLaw N) =
      rightAction k m1 m2 c - payoff k m1 m2 c := by
  have hskip := equation22_terminal_counts q k c hq hcap1 hcap2 hs
  have hskip1 : (finalCounts (schedule leftTie k c) c).n1 ≤ N := by
    rw [schedule_final, leftTie_run, hskip.1]
    split_ifs <;> omega
  have hskip2 : (finalCounts (schedule leftTie k c) c).n2 ≤ N := by
    rw [schedule_final, leftTie_run, hskip.2]
    split_ifs <;> omega
  have hforce1 : (finalCounts (schedule leftTie k c ++ [false]) c).n1 ≤ N := by
    rw [finalCounts_append]
    exact hskip1
  have hforce2 : (finalCounts (schedule leftTie k c ++ [false]) c).n2 ≤ N := by
    rw [finalCounts_append]
    change (finalCounts (schedule leftTie k c) c).n2 + 1 ≤ N
    rw [schedule_final, leftTie_run, hskip.2]
    split_ifs <;> omega
  rw [integral_sub (streamTerminalRisk_integrable N _ c m1 m2 hskip1 hskip2)
    (streamTerminalRisk_integrable N _ c m1 m2 hforce1 hforce2),
    stream_integral_eq_recursive_risk N _ c m1 m2 h1 h2 hskip1 hskip2,
    stream_integral_eq_recursive_risk N _ c m1 m2 h1 h2 hforce1 hforce2]
  have hcoup := risk_permutation _ _
    (forced_right_is_common_then_last q k c hq hcap1 hcap2 hs) c m1 m2 h1 h2
  rw [forced_right_risk_eq k c m1 m2 h1 h2] at hcoup
  rw [skip_risk_eq leftTie leftTie_smaller k c m1 m2 h1 h2, ← hcoup]
  ring

end
end BayesOptimal.Coupling19

end

/-! ## EmbeddingCoupling -/
section

set_option linter.unusedSectionVars false
set_option synthInstance.maxHeartbeats 400000

open MeasureTheory ProbabilityTheory
open scoped NNReal ENNReal

namespace BayesOptimal.EmbeddingCoupling

open FiniteGaussian FinitePosterior FiniteModelExclusion EmbeddingDirect
open EmbeddingRaw EmbeddingExecution EmbeddingRandomized

variable {A : Type*} [Fintype A] [Nonempty A] [DecidableEq A]

noncomputable section

section Removed
variable (i : A) [Nonempty {a : A // a ≠ i}]

def retainedWorld (H : ℕ) (m : Means A) (w : MockStream.World A H i) :
    Means (Retained i) × RawStream (Retained i) H :=
  (fun a => MockStream.theta H m i w a, w.2.2)

def copiedObservations {H : ℕ} (m : Means A) (b : MockStream.Block H) : Fin H → ℝ :=
  fun t => m i + b.1 + b.2 t

theorem retainedData_preserving (H : ℕ) (c : Precisions A) (m : Means A) :
    MeasurePreserving (fun p : MockStream.OtherData A H i =>
      (restrictMeans i m + p.1, p.2)) (MockStream.otherDataLaw H c i)
      (worldLaw H (restrictPrecisions i c) (restrictMeans i m)) := by
  have ht : MeasurePreserving (fun x : Means (Retained i) => restrictMeans i m + x)
      (centeredLaw (restrictPrecisions i c))
      (posteriorLaw (restrictPrecisions i c) (restrictMeans i m)) := ⟨by fun_prop, rfl⟩
  exact ht.prod (MeasurePreserving.id (arrayLaw (A := Retained i) H))

/-- The imaginary removed-arm block is independent of the true retained
latent parameters and all their real reward noise. -/
theorem copy_retained_preserving (H : ℕ) (c : Precisions A) (m : Means A) :
    MeasurePreserving (fun w : MockStream.World A H i => (w.1.2, retainedWorld i H m w))
      (MockStream.law H c i)
      ((MockStream.blockLaw H (c i)⁻¹).prod
        (worldLaw H (restrictPrecisions i c) (restrictMeans i m))) := by
  have hp := (measurePreserving_snd (μ := MockStream.blockLaw H (c i)⁻¹)
    (ν := MockStream.blockLaw H (c i)⁻¹)).prod
      (MeasurePreserving.id (MockStream.otherDataLaw H c i))
  have h := ((MeasurePreserving.id (MockStream.blockLaw H (c i)⁻¹)).prod
    (retainedData_preserving i H c m)).comp hp
  convert h using 1
  funext w
  apply Prod.ext
  · rfl
  · apply Prod.ext
    · ext a
      simp [retainedWorld, MockStream.theta, FinitePosterior.join, a.property, restrictMeans]
    · rfl

theorem inserted_copy_stream (H : ℕ) (m : Means A) (w : MockStream.World A H i) :
    insert i (observations (retainedWorld i H m w)) (copiedObservations i m w.1.2) =
      MockStream.mockStream H m i w := by
  ext a t
  by_cases ha : a = i
  · subst a
    simp [EmbeddingRaw.insert, copiedObservations, MockStream.mockStream,
      MockStream.realStream, MockStream.swap]
  · simp [EmbeddingRaw.insert, observations, retainedWorld, MockStream.mockStream,
      MockStream.realStream, MockStream.swap, MockStream.theta, FinitePosterior.join, ha]

def simulated {H : ℕ} (dummy : Retained i) (s : Strategy (A := A) H)
    (c : Precisions A) (m : Means A) (b : MockStream.Block H) : Strategy (A := Retained i) H :=
  simulate i dummy s (restrictPrecisions i c) (restrictMeans i m) (copiedObservations i m b)

section Measurable
variable [MeasurableSpace A] [MeasurableSingletonClass A]

theorem mockRisk_eq_rawRisk {H : ℕ} (s : Strategy (A := A) H)
    (c : Precisions A) (m : Means A) (h : Measurable (run s)) :
    MockSample.risk H c m i (MockStream.realStream H m i) (run s) = rawRisk s c m := by
  unfold rawRisk
  rw [← (MockLaw.realWorld_preserving H c m i).map_eq,
    integral_map (MockLaw.realWorld_preserving H c m i).measurable.aemeasurable
      (rawPayoff_measurable s h).aestronglyMeasurable]
  simp only [MockLaw.real_observations]
  rfl

theorem simulatedRisk_eq_world {H : ℕ} (dummy : Retained i) (s : Strategy (A := A) H)
    (c : Precisions A) (m : Means A)
    (hmeas : Measurable (fun p : MockStream.Block H × RawStream (Retained i) H =>
      run (A := Retained i) (simulated i dummy s c m p.1) p.2)) :
    (∫ b, rawRisk (simulated i dummy s c m b) (restrictPrecisions i c) (restrictMeans i m)
      ∂MockStream.blockLaw H (c i)⁻¹) =
    ∫ w, randomizedPayoff (simulated i dummy s c m) (w.1.2, retainedWorld i H m w)
      ∂MockStream.law H c i := by
  have hi := randomizedPayoff_integrable (MockStream.blockLaw H (c i)⁻¹)
    (simulated i dummy s c m) (restrictPrecisions i c) (restrictMeans i m) hmeas
  change (∫ b, ∫ v, randomizedPayoff (simulated i dummy s c m) (b, v)
    ∂worldLaw H (restrictPrecisions i c) (restrictMeans i m)
    ∂MockStream.blockLaw H (c i)⁻¹) = _
  rw [← integral_prod _ hi, ← (copy_retained_preserving i H c m).map_eq,
    integral_map (copy_retained_preserving i H c m).measurable.aemeasurable
      (randomizedPayoff_measurable (simulated i dummy s c m) hmeas).aestronglyMeasurable]

/-- Risk comparison for the literal budget-preserving simulator, before
any optimality argument. Both risks use the actual latent Gaussian laws. -/
theorem simulatedRisk_le_fullRisk {H : ℕ} (dummy : Retained i) (s : Strategy (A := A) H)
    (c : Precisions A) (m : Means A) (hfull : Measurable (run s))
    (hmeas : Measurable (fun p : MockStream.Block H × RawStream (Retained i) H =>
      run (A := Retained i) (simulated i dummy s c m p.1) p.2)) :
    (∫ b, rawRisk (simulated i dummy s c m b) (restrictPrecisions i c) (restrictMeans i m)
      ∂MockStream.blockLaw H (c i)⁻¹) ≤ rawRisk s c m + exclusion i c m := by
  rw [simulatedRisk_eq_world i dummy s c m hmeas]
  have hcand := (copy_retained_preserving i H c m).integrable_comp_of_integrable
    (randomizedPayoff_integrable (MockStream.blockLaw H (c i)⁻¹)
      (simulated i dummy s c m) (restrictPrecisions i c) (restrictMeans i m) hmeas)
  have hfullInt := (MockStream.swap_preserving H c i).integrable_comp_of_integrable
    (MockSample.risk_integrable H c m i (MockStream.realStream H m i) (run s)
      (MockStream.realStream_measurable H m i) hfull)
  have hexInt := (MockStream.swap_preserving H c i).integrable_comp_of_integrable
    (MockSample.exclusion_world_integrable i H c m)
  have hb := integral_mono hcand (hfullInt.add hexInt) (fun w => by
    have hp := simulate_regret_bound i dummy s (restrictPrecisions i c) (restrictMeans i m)
      (copiedObservations i m w.1.2) (observations (retainedWorld i H m w))
      (MockStream.theta H m i (MockStream.swap H i w))
    rw [inserted_copy_stream i H m w] at hp
    rw [MockSample.otherMaximum_swap i H m w] at hp
    have hj := MockStream.theta_other_unchanged H m i
      (run (A := Retained i) (simulated i dummy s c m w.1.2)
        (observations (retainedWorld i H m w)))
      (run (A := Retained i) (simulated i dummy s c m w.1.2)
        (observations (retainedWorld i H m w))).property w
    change otherMaximum i (MockStream.theta H m i w) -
      MockStream.theta H m i (MockStream.swap H i w)
        (run (A := Retained i) (simulated i dummy s c m w.1.2)
          (observations (retainedWorld i H m w))) ≤ _ at hp
    rw [hj] at hp
    exact hp)
  have he : (∫ w, max (MockStream.theta H m i (MockStream.swap H i w) i -
      otherMinimum i (MockStream.theta H m i (MockStream.swap H i w))) 0
      ∂MockStream.law H c i) = exclusion i c m := by
    exact (MockSample.integral_swap H c i (fun w => max
      (MockStream.theta H m i w i - otherMinimum i (MockStream.theta H m i w)) 0) (by
      have htheta := MockStream.theta_measurable H m i
      exact (((measurable_pi_apply i).comp htheta).sub
        ((otherMinimum_lipschitz i).continuous.measurable.comp htheta)).max measurable_const)).trans
      (MockSample.exclusion_world_integral i H c m)
  dsimp only [Pi.add_apply, Function.comp_def] at hb hfullInt hexInt
  rw [integral_add hfullInt hexInt] at hb
  simp_rw [MockStream.stream_swap] at hb
  rw [MockSample.full_risk_coupling H c m i (run s) hfull,
    he, mockRisk_eq_rawRisk i s c m hfull] at hb
  exact hb

/-- The second embedding's feasibility inequality. Regularity and joint
measurability are properties of its explicit raw strategy, never a supplied
risk-coupling equality or a supplied Bellman endpoint. -/
theorem lemma13_second_embedding {H : ℕ} (dummy : Retained i) (s : Strategy (A := A) H)
    (c : Precisions A) (m : Means A) (hc : ∀ a, 0 < c a) (hfull : Measurable (run s))
    (hregular : ∀ b, Regular (simulated i dummy s c m b))
    (hmeas : Measurable (fun p : MockStream.Block H × RawStream (Retained i) H =>
      run (A := Retained i) (simulated i dummy s c m p.1) p.2)) :
    loss H (restrictPrecisions i c) (restrictMeans i m) ≤ rawRisk s c m + exclusion i c m := by
  exact (randomized_rawRisk_ge_loss (MockStream.blockLaw H (c i)⁻¹)
    (simulated i dummy s c m) (restrictPrecisions i c) (restrictMeans i m)
    (fun a => hc a) hregular hmeas).trans
      (simulatedRisk_le_fullRisk i dummy s c m hfull hmeas)

theorem lemma13_second_embedding_forced {H : ℕ} (dummy a : Retained i)
    (next : ℝ → Strategy (A := A) H) (c : Precisions A) (m : Means A)
    (hc : ∀ b, 0 < c b) (hfull : Measurable (run (.sample (a : A) next)))
    (hregular : ∀ b, Regular (simulated i dummy (.sample a next) c m b))
    (hmeas : Measurable (fun p : MockStream.Block (H + 1) × RawStream (Retained i) (H + 1) =>
      run (A := Retained i) (simulated i dummy (.sample a next) c m p.1) p.2)) :
    actionLoss H (restrictPrecisions i c) (restrictMeans i m) a ≤
      rawRisk (.sample (a : A) next) c m + exclusion i c m := by
  have hpoint (b : MockStream.Block (H + 1)) :
      actionLoss H (restrictPrecisions i c) (restrictMeans i m) a ≤
      rawRisk (simulated i dummy (.sample a next) c m b)
        (restrictPrecisions i c) (restrictMeans i m) := by
    have he := simulate_forced_retained i dummy a next (restrictPrecisions i c)
      (restrictMeans i m) (copiedObservations i m b)
    have hr := hregular b
    change Regular (simulate i dummy (.sample a next) (restrictPrecisions i c)
      (restrictMeans i m) (copiedObservations i m b)) at hr
    rw [he] at hr
    change actionLoss H (restrictPrecisions i c) (restrictMeans i m) a ≤
      rawRisk (simulate i dummy (.sample a next) (restrictPrecisions i c)
        (restrictMeans i m) (copiedObservations i m b)) _ _
    rw [he]
    exact rawRisk_ge_actionLoss a _ _ _ (fun a => hc a) hr
  have hl := integral_mono
    (integrable_const (actionLoss H (restrictPrecisions i c) (restrictMeans i m) a))
    (randomized_rawRisk_integrable (MockStream.blockLaw (H + 1) (c i)⁻¹)
      (simulated i dummy (.sample a next) c m) (restrictPrecisions i c) (restrictMeans i m) hmeas)
    hpoint
  simp only [integral_const, measureReal_univ_eq_one, one_smul] at hl
  exact hl.trans (simulatedRisk_le_fullRisk i dummy (.sample a next) c m hfull hmeas)

end Measurable
end Removed
end
end BayesOptimal.EmbeddingCoupling

end

/-! ## EmbeddingMeasurable -/
section

open MeasureTheory ProbabilityTheory

namespace BayesOptimal.EmbeddingMeasurable

open BayesOptimal.FiniteGaussian BayesOptimal.FiniteModelMeasurable BayesOptimal.EmbeddingRaw
open BayesOptimal.EmbeddingDirect BayesOptimal.EmbeddingExecution

variable {A : Type*} [Fintype A] [Nonempty A] [DecidableEq A]
variable [MeasurableSpace A] [MeasurableSingletonClass A]

noncomputable section

@[fun_prop] theorem shift_param_measurable {B X : Type*} [DecidableEq B]
    [MeasurableSpace X] (m : X → Means B) (z : X → ℝ) (i : B)
    (hm : Measurable m) (hz : Measurable z) :
    Measurable (fun x => shift (m x) i (z x)) := by
  apply measurable_pi_lambda
  intro a
  by_cases h : a = i
  · simpa only [shift, if_pos h] using ((measurable_pi_apply a).comp hm).add hz
  · simpa only [shift, if_neg h, add_zero] using (measurable_pi_apply a).comp hm

variable (i : A) [Nonempty (Retained i)] (dummy : Retained i)

abbrev Input (H : ℕ) := (Means A × Means (Retained i)) ×
  ((Fin H → ℝ) × RawStream (Retained i) H)

def result (H : ℕ) (c : Precisions A) (d : Precisions (Retained i))
    (p : Input i H) : Retained i :=
  run (simulate i dummy (rawOfInnovation (optimalFirst H c p.1.1) c p.1.1)
    d p.1.2 p.2.1) p.2.2

theorem result_zero_measurable (c : Precisions A) (d : Precisions (Retained i)) :
    Measurable (result i dummy 0 c d) := by
  have hm : Measurable (fun p : Input i 0 => firstMax p.1.1) :=
    firstMax_measurable.comp (measurable_fst.comp measurable_fst)
  have hn : Measurable (fun p : Input i 0 => (firstMax (A := Retained i) p.1.2 : A)) :=
    measurable_subtype_coe.comp
      (firstMax_measurable.comp (measurable_snd.comp measurable_fst))
  have h : Measurable (fun p : Input i 0 =>
      if firstMax p.1.1 = i then (firstMax (A := Retained i) p.1.2 : A) else firstMax p.1.1) :=
    hn.ite (hm (measurableSet_singleton i)) hm
  have hr : Measurable (fun p : Input i 0 => (result i dummy 0 c d p : A)) := by
    convert h using 1
    funext p
    unfold result optimalFirst rawOfInnovation simulate run
    split_ifs <;> rfl
  exact hr.subtype_mk

theorem result_measurable (H : ℕ) (c : Precisions A) (d : Precisions (Retained i)) :
    Measurable (result i dummy H c d) := by
  induction H generalizing c d with
  | zero => exact result_zero_measurable i dummy c d
  | succ H ih =>
    let g : Input i (H+1) × A → Retained i := fun x =>
      let p := x.1
      let a := x.2
      if h : a = i then
        result i dummy H (advance c a) d
          ((shift p.1.1 a ((p.2.1 ⟨0, by omega⟩-p.1.1 a)/((c a : ℝ)+1)),p.1.2),
            ((fun t => p.2.1 t.succ),tail p.2.2))
      else
        let b : Retained i := ⟨a,h⟩
        let y := p.2.2 b ⟨0, by omega⟩
        result i dummy H (advance c a) (advance d b)
          ((shift p.1.1 a ((y-p.1.1 a)/((c a : ℝ)+1)),
            shift p.1.2 b ((y-p.1.2 b)/((d b : ℝ)+1))),
            ((fun t => p.2.1 t.succ),tail p.2.2))
    have hg : Measurable g := by
      apply measurable_from_prod_countable_left
      intro a
      by_cases h : a = i
      · simp only [g, dif_pos h]
        apply (ih (advance c a) d).comp
        unfold tail
        fun_prop
      · simp only [g, dif_neg h]
        have hy : Measurable (fun p : Input i (H+1) => p.2.2 ⟨a,h⟩ ⟨0,by omega⟩) :=
          (measurable_pi_apply (⟨0,by omega⟩ : Fin (H+1))).comp
            ((measurable_pi_apply (⟨a,h⟩ : Retained i)).comp
              (measurable_snd.comp measurable_snd))
        apply (ih (advance c a) (advance d ⟨a,h⟩)).comp
        have hm : Measurable (fun p : Input i (H+1) => p.1.1) :=
          measurable_fst.comp measurable_fst
        have hn : Measurable (fun p : Input i (H+1) => p.1.2) :=
          measurable_snd.comp measurable_fst
        have hz := (hy.sub ((measurable_pi_apply a).comp hm)).div_const ((c a : ℝ)+1)
        have hw := (hy.sub ((measurable_pi_apply (⟨a,h⟩ : Retained i)).comp hn)).div_const
          ((d ⟨a,h⟩ : ℝ)+1)
        apply Measurable.prodMk
        · exact (shift_param_measurable _ _ a hm hz).prodMk
            (shift_param_measurable _ _ (⟨a,h⟩ : Retained i) hn hw)
        · unfold tail
          fun_prop
    have hchoose : Measurable (fun p : Input i (H+1) => chooseFirst H c p.1.1) :=
      (chooseFirst_measurable H c).comp (measurable_fst.comp measurable_fst)
    have h := hg.comp (measurable_id.prodMk hchoose)
    convert h using 1
    funext p
    simp only [result, optimalFirst, rawOfInnovation, simulate, g, Function.comp_def, id]
    split_ifs <;> rfl

theorem simulated_optimal_regular (H : ℕ) (c : Precisions A) (m : Means A)
    (d : Precisions (Retained i)) (n : Means (Retained i)) (imaginary : Fin H → ℝ) :
    Regular (simulate i dummy (rawOfInnovation (optimalFirst H c m) c m) d n imaginary) := by
  induction H generalizing c m d n with
  | zero => simp only [optimalFirst, rawOfInnovation, simulate]; split_ifs <;> trivial
  | succ H ih =>
    simp only [optimalFirst, rawOfInnovation, simulate]
    split_ifs with h
    · constructor
      · intro y; exact ih _ _ _ _ _
      · change Measurable (result i dummy H (advance c (chooseFirst H c m)) d ∘
          fun p : ℝ × RawStream (Retained i) H =>
          ((shift m (chooseFirst H c m)
            ((imaginary ⟨0,by omega⟩-m (chooseFirst H c m))/
              ((c (chooseFirst H c m) : ℝ)+1)),n),
            ((fun t => imaginary t.succ),p.2)))
        apply (result_measurable i dummy H (advance c (chooseFirst H c m)) d).comp
        fun_prop
    · constructor
      · intro y; exact ih _ _ _ _ _
      · let b : Retained i := ⟨chooseFirst H c m,h⟩
        change Measurable (result i dummy H (advance c b) (advance d b) ∘
          fun p : ℝ × RawStream (Retained i) H =>
          ((shift m b ((p.1-m b)/((c b : ℝ)+1)),
            shift n b ((p.1-n b)/((d b : ℝ)+1))),
            ((fun t => imaginary t.succ),p.2)))
        apply (result_measurable i dummy H (advance c b) (advance d b)).comp
        fun_prop

end
end BayesOptimal.EmbeddingMeasurable

end

/-! ## PolicyEmbedding -/
section

set_option linter.unusedSectionVars false

open MeasureTheory ProbabilityTheory
open scoped NNReal ENNReal

namespace BayesOptimal.PolicyEmbedding

open FiniteGaussian FinitePosterior FiniteModelExclusion FiniteModelMeasurable
open EmbeddingDirect EmbeddingRaw EmbeddingExecution EmbeddingCoupling EmbeddingMeasurable

variable {A : Type*} [Fintype A] [Nonempty A] [DecidableEq A]
variable [MeasurableSpace A] [MeasurableSingletonClass A]
variable (i : A) [Nonempty (Retained i)]

noncomputable section

theorem simulated_optimal_joint_measurable (dummy : Retained i) (H : ℕ)
    (c : Precisions A) (m : Means A) :
    Measurable (fun p : MockStream.Block H × RawStream (Retained i) H =>
      run (A := Retained i)
        (simulated i dummy (rawOfInnovation (optimalFirst H c m) c m) c m p.1) p.2) := by
  have ht : Measurable (fun p : MockStream.Block H × RawStream (Retained i) H =>
      ((m, restrictMeans i m), (copiedObservations i m p.1, p.2))) := by
    unfold copiedObservations
    fun_prop
  exact (result_measurable i dummy H c (restrictPrecisions i c)).comp ht

/-- Both literal policy embeddings of Lemma 13, for every finite arm set,
every removed arm, every finite horizon, and arbitrary positive real
Gaussian precisions. All measurability, independence, risk representation,
and budget properties of the constructed policies are proved in Lean. -/
theorem lemma13_loss_by_policy_embeddings (H : ℕ) (c : Precisions A) (m : Means A)
    (hc : ∀ a, 0 < c a) :
    |loss H c m - loss H (restrictPrecisions i c) (restrictMeans i m)| ≤ exclusion i c m := by
  obtain ⟨dummy⟩ := (inferInstance : Nonempty (Retained i))
  have hforward := lemma13_first_embedding i H c m hc
  have hreverse := lemma13_second_embedding i dummy
    (rawOfInnovation (optimalFirst H c m) c m) c m hc
    (regular_run_measurable _ (optimalFirst_raw_regular H c m))
    (fun b => simulated_optimal_regular i dummy H c m (restrictPrecisions i c)
      (restrictMeans i m) (copiedObservations i m b))
    (simulated_optimal_joint_measurable i dummy H c m)
  rw [optimalFirst_rawRisk H c m hc] at hreverse
  exact abs_le.mpr ⟨by linarith, hforward⟩

def forcedInnovation (H : ℕ) (c : Precisions A) (m : Means A) (a : A) : Strategy (A := A) (H + 1) :=
  .sample a (fun z => optimalFirst H (advance c a) (shift m a z))

def forcedRaw (H : ℕ) (c : Precisions A) (m : Means A) (a : A) : Strategy (A := A) (H + 1) :=
  rawOfInnovation (forcedInnovation H c m a) c m

theorem forcedRaw_regular (H : ℕ) (c : Precisions A) (m : Means A) (a : A) :
    Regular (forcedRaw H c m a) := by
  constructor
  · intro y
    exact optimalFirst_raw_regular H _ _
  · have ht : Measurable (fun p : ℝ × RawStream A H =>
        (shift m a ((p.1 - m a) / ((c a : ℝ) + 1)), p.2)) := by
      apply Measurable.prodMk
      · exact shift_param_measurable _ _ a measurable_const (by fun_prop)
      · exact measurable_snd
    exact (optimalFirst_raw_run_measurable H (advance c a)).comp ht

theorem forcedRaw_risk (H : ℕ) (c : Precisions A) (m : Means A) (a : A)
    (hc : ∀ b, 0 < c b) : rawRisk (forcedRaw H c m a) c m = actionLoss H c m a := by
  rw [forcedRaw, rawOfInnovation_risk _ _ _ hc (forcedRaw_regular H c m a)]
  change (∫ z, expectedRegret (optimalFirst H (advance c a) (shift m a z))
    (advance c a) (shift m a z) ∂gaussianReal 0 (innovation c a)) = actionLoss H c m a
  apply integral_congr_ae
  apply Filter.Eventually.of_forall
  intro z
  dsimp only
  rw [expectedRegret_eq _ _ _ (optimalFirst_admissible H _ _) (advance_positive c a hc),
    optimalFirst_utility]
  rfl

def forcedResult (dummy a : Retained i) (H : ℕ) (c : Precisions A)
    (d : Precisions (Retained i)) (p : Input i (H + 1)) : Retained i :=
  run (A := Retained i) (simulate i dummy (forcedRaw H c p.1.1 a)
    d p.1.2 p.2.1) p.2.2

theorem forcedResult_measurable (dummy a : Retained i) (H : ℕ) (c : Precisions A)
    (d : Precisions (Retained i)) : Measurable (forcedResult i dummy a H c d) := by
  have ht : Measurable (fun p : Input i (H + 1) =>
      ((shift p.1.1 (a : A)
          ((p.2.2 a ⟨0, Nat.zero_lt_succ H⟩ - p.1.1 a) / ((c a : ℝ) + 1)),
        shift p.1.2 a
          ((p.2.2 a ⟨0, Nat.zero_lt_succ H⟩ - p.1.2 a) / ((d a : ℝ) + 1))),
        ((fun t : Fin H => p.2.1 t.succ), tail p.2.2))) := by
    unfold tail
    fun_prop
  have h := (result_measurable i dummy H (advance c a) (advance d a)).comp ht
  convert h using 1
  funext p
  simp only [forcedResult, forcedRaw, forcedInnovation, rawOfInnovation, simulate,
    a.property, dite_false, run, result, Function.comp_def]

theorem forced_simulated_regular (dummy a : Retained i) (H : ℕ) (c : Precisions A)
    (m : Means A) (d : Precisions (Retained i)) (n : Means (Retained i))
    (imaginary : Fin (H + 1) → ℝ) :
    Regular (simulate i dummy (forcedRaw H c m a) d n imaginary) := by
  simp only [forcedRaw, forcedInnovation, rawOfInnovation, simulate, a.property]
  constructor
  · intro y
    exact simulated_optimal_regular i dummy H _ _ _ _ _
  · have ht : Measurable (fun p : ℝ × RawStream (Retained i) H =>
        ((shift m (a : A) ((p.1 - m a) / ((c a : ℝ) + 1)),
          shift n a ((p.1 - n a) / ((d a : ℝ) + 1))),
          ((fun t : Fin H => imaginary t.succ), p.2))) := by
      fun_prop
    exact (result_measurable i dummy H (advance c a) (advance d a)).comp ht

theorem forced_simulated_joint_measurable (dummy a : Retained i) (H : ℕ)
    (c : Precisions A) (m : Means A) :
    Measurable (fun p : MockStream.Block (H + 1) × RawStream (Retained i) (H + 1) =>
      run (A := Retained i)
        (simulated i dummy (forcedRaw H c m a) c m p.1) p.2) := by
  have ht : Measurable (fun p : MockStream.Block (H + 1) × RawStream (Retained i) (H + 1) =>
      ((m, restrictMeans i m), (copiedObservations i m p.1, p.2))) := by
    unfold copiedObservations
    fun_prop
  exact (forcedResult_measurable i dummy a H c (restrictPrecisions i c)).comp ht

/-- Eq. (14) by the same two genuine policy embeddings, with the first
action constrained to either retained arm. -/
theorem lemma13_actionLoss_by_policy_embeddings (H : ℕ) (c : Precisions A) (m : Means A)
    (a : Retained i) (hc : ∀ b, 0 < c b) :
    |actionLoss H c m a - actionLoss H (restrictPrecisions i c) (restrictMeans i m) a| ≤
      exclusion i c m := by
  obtain ⟨dummy⟩ := (inferInstance : Nonempty (Retained i))
  have hforward := lemma13_first_embedding_forced i H c m a hc
  have hreg := forcedRaw_regular H c m a
  have hregular : ∀ b, Regular (simulated i dummy (forcedRaw H c m a) c m b) :=
    fun b => forced_simulated_regular i dummy a H c m (restrictPrecisions i c)
      (restrictMeans i m) (copiedObservations i m b)
  have hfull := regular_run_measurable _ hreg
  have hmeas := forced_simulated_joint_measurable i dummy a H c m
  have hreverse := lemma13_second_embedding_forced i dummy a
    (fun y => let z := (y - m a) / ((c a : ℝ) + 1)
      rawOfInnovation (optimalFirst H (advance c a) (shift m a z))
        (advance c a) (shift m a z)) c m hc hfull hregular hmeas
  change actionLoss H (restrictPrecisions i c) (restrictMeans i m) a ≤
    rawRisk (forcedRaw H c m a) c m + exclusion i c m at hreverse
  rw [forcedRaw_risk H c m a hc] at hreverse
  exact abs_le.mpr ⟨by linarith, hforward⟩

end
end BayesOptimal.PolicyEmbedding

end

