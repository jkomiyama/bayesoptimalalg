/-! ## Foundations.PosteriorRegret -/
section

open MeasureTheory ProbabilityTheory
open scoped NNReal ENNReal

namespace BayesOptimal.Foundations.PosteriorRegret

open BayesianModel

noncomputable section

def smooth (f : Means → ℝ) (i : Arm) (v : ℝ≥0) (m : Means) : ℝ :=
  ∫ z : ℝ, f (shift m i z) ∂gaussianReal 0 v

theorem smooth_lipschitz {f : Means → ℝ} (hf : LipschitzWith 1 f)
    (i : Arm) (v : ℝ≥0) : LipschitzWith 1 (smooth f i v) :=
  integral_shift_lipschitz hf i v

theorem shift_same (m : Means) (i : Arm) (x y : ℝ) :
    shift (shift m i x) i y = shift m i (x + y) := by
  ext j
  by_cases h : j = i
  · simp [shift, h, add_assoc]
  · simp [shift, h]

theorem shift_comm (m : Means) (i j : Arm) (x y : ℝ) :
    shift (shift m i x) j y = shift (shift m j y) i x := by
  ext a
  simp only [shift]
  ring

theorem double_shift_integrable {f : Means → ℝ} (hf : LipschitzWith 1 f)
    (m : Means) (i j : Arm) (v w : ℝ≥0) :
    Integrable (fun p : ℝ × ℝ => f (shift (shift m i p.1) j p.2))
      ((gaussianReal 0 v).prod (gaussianReal 0 w)) := by
  have hb (p : ℝ × ℝ) : ‖f (shift (shift m i p.1) j p.2)‖ ≤
      ‖f m‖ + |p.1| + |p.2| := by
    have h := hf.dist_le_mul (shift (shift m i p.1) j p.2) m
    simp only [dist_eq_norm, NNReal.coe_one, one_mul] at h
    have hn := norm_sub_le_norm_sub_add_norm_sub
      (shift (shift m i p.1) j p.2) (shift m i p.1) m
    have h₁ := shift_norm_bound m i p.1
    have h₂ := shift_norm_bound (shift m i p.1) j p.2
    have ht := norm_add_le (f (shift (shift m i p.1) j p.2) - f m) (f m)
    simp only [sub_add_cancel] at ht
    linarith
  have hc : Continuous (fun p : ℝ × ℝ => shift (shift m i p.1) j p.2) := by
    apply continuous_pi
    intro a
    unfold shift
    split_ifs <;> fun_prop
  exact ((integrable_const ‖f m‖).add
    ((Gaussian.gaussian_id_integrable 0 v).norm.comp_fst (gaussianReal 0 w))).add
    ((Gaussian.gaussian_id_integrable 0 w).norm.comp_snd (gaussianReal 0 v)) |>.mono'
      (hf.continuous.comp hc).measurable.aestronglyMeasurable
      (Filter.Eventually.of_forall hb)

theorem smooth_comm {f : Means → ℝ} (hf : LipschitzWith 1 f)
    (i j : Arm) (v w : ℝ≥0) :
    smooth (smooth f j w) i v = smooth (smooth f i v) j w := by
  funext m
  unfold smooth
  rw [integral_integral_swap (double_shift_integrable hf m i j v w)]
  congr 1
  funext y
  congr 1
  funext x
  rw [shift_comm]

theorem smooth_add {f : Means → ℝ} (hf : LipschitzWith 1 f)
    (i : Arm) (v w : ℝ≥0) :
    smooth (smooth f i w) i v = smooth f i (v + w) := by
  funext m
  unfold smooth
  have hconv : (gaussianReal 0 v) ∗ (gaussianReal 0 w) = gaussianReal 0 (v + w) := by
    simpa using (gaussianReal_conv_gaussianReal (m₁ := (0 : ℝ)) (m₂ := (0 : ℝ)))
  have hi : Integrable (fun z : ℝ => f (shift m i z))
      ((gaussianReal 0 v) ∗ (gaussianReal 0 w)) := by
    rw [hconv]
    exact shifted_integrable hf m i (v + w)
  rw [← hconv, integral_conv hi]
  congr 1
  funext x
  congr 1
  funext y
  rw [shift_same]

def potential (c : Counts) : Means → ℝ :=
  smooth (smooth (smooth terminal 2 (c 2 : ℝ≥0)⁻¹)
    1 (c 1 : ℝ≥0)⁻¹) 0 (c 0 : ℝ≥0)⁻¹

theorem potential_lipschitz (c : Counts) : LipschitzWith 1 (potential c) :=
  smooth_lipschitz (smooth_lipschitz (smooth_lipschitz terminal_lipschitz _ _) _ _) _ _

theorem count_variance_split (n : ℕ) (hn : 0 < n) :
    (n : ℝ≥0)⁻¹ = Gaussian.updateVariance (n : ℝ≥0) + ((n + 1 : ℕ) : ℝ≥0)⁻¹ := by
  have h := Gaussian.posteriorVariance_after_draw (n : ℝ≥0) 0
    (by exact_mod_cast hn)
  simpa [Gaussian.posteriorVariance] using h

/-- The posterior expected best latent mean is a martingale under every arm
draw. This checks the additive constant connecting utility and regret. -/
theorem potential_tower (c : Counts) (i : Arm) (hc : 0 < c i) :
    smooth (potential (advance c i)) i (innovation c i) = potential c := by
  have hsplit := count_variance_split (c i) hc
  fin_cases i
  · change smooth (potential (advance c 0)) 0 (innovation c 0) = potential c
    norm_num [potential, advance, innovation] at hsplit ⊢
    rw [smooth_add (smooth_lipschitz (smooth_lipschitz terminal_lipschitz _ _) _ _)]
    rw [← hsplit]
  · change smooth (potential (advance c 1)) 1 (innovation c 1) = potential c
    norm_num [potential, advance, innovation] at hsplit ⊢
    rw [smooth_comm (smooth_lipschitz (smooth_lipschitz terminal_lipschitz _ _) _ _)
      1 0]
    congr 1
    rw [smooth_add (smooth_lipschitz terminal_lipschitz _ _), ← hsplit]
  · change smooth (potential (advance c 2)) 2 (innovation c 2) = potential c
    norm_num [potential, advance, innovation] at hsplit ⊢
    change (c 2 : ℝ≥0)⁻¹ = Gaussian.updateVariance (c 2 : ℝ≥0) +
      ((c 2 : ℝ≥0) + 1)⁻¹ at hsplit
    rw [smooth_comm (smooth_lipschitz (smooth_lipschitz terminal_lipschitz _ _) _ _)
      2 0]
    congr 1
    rw [smooth_comm (smooth_lipschitz terminal_lipschitz _ _) 2 1]
    congr 1
    rw [smooth_add terminal_lipschitz, ← hsplit]

def loss (k : ℕ) (c : Counts) (m : Means) : ℝ := potential c m - value k c m

def actionLoss (k : ℕ) (c : Counts) (m : Means) (i : Arm) : ℝ :=
  ∫ z : ℝ, loss k (advance c i) (shift m i z)
    ∂gaussianReal 0 (innovation c i)

theorem actionLoss_eq (k : ℕ) (c : Counts) (m : Means) (i : Arm)
    (hc : 0 < c i) : actionLoss k c m i = potential c m - action k c m i := by
  unfold actionLoss loss action
  rw [integral_sub (shifted_integrable (potential_lipschitz _) _ _ _)
    (action_integrable k c m i)]
  have ht := congrFun (potential_tower c i hc) m
  exact congrArg (fun x : ℝ => x - ∫ z : ℝ, value k (advance c i) (shift m i z)
    ∂gaussianReal 0 (innovation c i)) ht

theorem chosen_loss_minimal (k : ℕ) (c : Counts) (m : Means)
    (hc : ∀ i, 0 < c i) (i : Arm) :
    actionLoss k c m (choose k c m) ≤ actionLoss k c m i := by
  rw [actionLoss_eq _ _ _ _ (hc _), actionLoss_eq _ _ _ _ (hc _), choose_optimal]
  exact sub_le_sub_left (action_le_value k c m i) _

end

end BayesOptimal.Foundations.PosteriorRegret

end

/-! ## Foundations.MainBridge -/
section

/-!
Corrected deterministic induction and terminal recommendation step in Theorem 2.
The action admissibility premises are explicit. Establishing them for the actual
Bayes optimal policy still requires stochastic Bellman comparison lemmas.
In particular the terminal premise is separate, never inferred from t < T.
-/

namespace BayesOptimal.Foundations.MainBridge

abbrev Arm := Fin 3
abbrev ArmCounts := Arm → ℕ

def advance (c : ArmCounts) (a : Arm) : ArmCounts :=
  fun i => c i + if i = a then 1 else 0

def invariant (q s : ℕ) (c : ArmCounts) : Prop :=
  c 0 ≤ q ∧ c 1 ≤ q ∧ c 2 = 1 ∧ c 0 + c 1 + c 2 = s

def admissible (q : ℕ) (c : ArmCounts) (a : Arm) : Prop :=
  a ≠ 2 ∧ (a = 0 → c 0 < q) ∧ (a = 1 → c 1 < q)

theorem advance_invariant (q s : ℕ) (c : ArmCounts) (a : Arm)
    (hc : invariant q s c) (ha : admissible q c a) :
    invariant q (s + 1) (advance c a) := by
  fin_cases a <;> simp [invariant, admissible, advance] at * <;> omega

/-- The full round induction, including an independent last-round premise. -/
theorem invariant_all_rounds (q : ℕ) (hq : 2 ≤ q)
    (counts : ℕ → ArmCounts) (action : ℕ → Arm)
    (hstart : ∀ i, counts 3 i = 1)
    (hupdate : ∀ s, 3 ≤ s → s < 2 * q + 1 →
      counts (s + 1) = advance (counts s) (action (s + 1)))
    (hpreterminal : ∀ s, 3 ≤ s → s < 2 * q →
      invariant q s (counts s) → admissible q (counts s) (action (s + 1)))
    (hterminal : invariant q (2 * q) (counts (2 * q)) →
      admissible q (counts (2 * q)) (action (2 * q + 1))) :
    ∀ s, 3 ≤ s → s ≤ 2 * q + 1 → invariant q s (counts s) := by
  intro s
  induction s using Nat.strong_induction_on with
  | h s ih =>
    intro hlo hhi
    by_cases hbase : s = 3
    · subst s
      change counts 3 0 ≤ q ∧ counts 3 1 ≤ q ∧ counts 3 2 = 1 ∧
        counts 3 0 + counts 3 1 + counts 3 2 = 3
      rw [hstart 0, hstart 1, hstart 2]
      omega
    · have hprev : 3 ≤ s - 1 := by omega
      have hs : s - 1 + 1 = s := by omega
      have hc := ih (s - 1) (by omega) hprev (by omega)
      have ha : admissible q (counts (s - 1)) (action s) := by
        by_cases hlast : s = 2 * q + 1
        · have heq : s - 1 = 2 * q := by omega
          rw [heq] at hc ⊢
          rw [hlast]
          exact hterminal hc
        · have ha' := hpreterminal (s - 1) hprev (by omega) hc
          simpa only [hs] using ha'
      have hu := hupdate (s - 1) hprev (by omega)
      simp only [hs] at hu
      rw [hu]
      simpa only [hs] using advance_invariant q (s - 1) (counts (s - 1)) (action s) hc ha

theorem invariant_final_counts (q : ℕ) (c : ArmCounts)
    (hc : invariant q (2 * q + 1) c) :
    c 0 = q ∧ c 1 = q ∧ c 2 = 1 := by
  unfold invariant at hc
  omega

/-- Safe numerical separation from the printed X and final Y events. -/
theorem terminal_underestimation_separation (T : ℕ) (hT : 5 ≤ T)
    (CU mean₁ mean₃ : ℝ) (hCU : 30 ≤ CU)
    (hY : |mean₁| ≤ 1 / (T : ℝ) ^ 2)
    (hX : mean₃ ≤ -CU * Real.sqrt (Real.log (T : ℝ))) : mean₃ < mean₁ := by
  have hTr : 1 ≤ (T : ℝ) := by exact_mod_cast (show 1 ≤ T by omega)
  have hTtwo : (2 : ℝ) ≤ (T : ℝ) := by exact_mod_cast (show 2 ≤ T by omega)
  have hlog : (1 / 4 : ℝ) < Real.log (T : ℝ) := by
    have htwo : (1 / 4 : ℝ) < Real.log 2 := by linarith [Real.log_two_gt_d9]
    exact htwo.trans_le (Real.log_le_log (by norm_num) hTtwo)
  have hsqrt : (1 / 2 : ℝ) < Real.sqrt (Real.log (T : ℝ)) := by
    apply (Real.lt_sqrt (by norm_num)).mpr
    nlinarith
  have hsmall : 1 / (T : ℝ) ^ 2 ≤ 1 := by
    apply (div_le_one (by positivity)).mpr
    nlinarith
  have hmean := (abs_le.mp hY).1
  have hprod : 1 < CU * Real.sqrt (Real.log (T : ℝ)) := by
    nlinarith
  linarith

theorem greedy_recommendation_wrong (means : Arm → ℝ) (chosen : Arm)
    (hgreedy : ∀ i, means i ≤ means chosen) (hsep : means 2 < means 0) :
    chosen ≠ 2 := by
  intro hc
  have h := hgreedy 0
  rw [hc] at h
  exact not_le_of_gt hsep h

theorem final_recommendation_wrong (T : ℕ) (hT : 5 ≤ T) (CU : ℝ) (hCU : 30 ≤ CU)
    (means : Arm → ℝ) (chosen : Arm)
    (hgreedy : ∀ i, means i ≤ means chosen)
    (hY : |means 0| ≤ 1 / (T : ℝ) ^ 2)
    (hX : means 2 ≤ -CU * Real.sqrt (Real.log (T : ℝ))) : chosen ≠ 2 := by
  exact greedy_recommendation_wrong means chosen hgreedy
    (terminal_underestimation_separation T hT CU (means 0) (means 2) hCU hY hX)

/-- All deterministic conditions needed by the repaired main argument on one
bad sample path. The terminal action condition is deliberately a separate field. -/
structure BadPathConditions (q : ℕ) (counts : ℕ → ArmCounts) (action : ℕ → Arm)
    (means : Arm → ℕ → ℝ) (chosen : Arm) (CU : ℝ) : Prop where
  initial : ∀ i, counts 3 i = 1
  update : ∀ s, 3 ≤ s → s < 2 * q + 1 →
    counts (s + 1) = advance (counts s) (action (s + 1))
  beforeTerminal : ∀ s, 3 ≤ s → s < 2 * q →
    invariant q s (counts s) → admissible q (counts s) (action (s + 1))
  atTerminal : invariant q (2 * q) (counts (2 * q)) →
    admissible q (counts (2 * q)) (action (2 * q + 1))
  firstArmClose : |means 0 q| ≤ 1 / ((2 * q + 1 : ℕ) : ℝ) ^ 2
  thirdArmLow : means 2 1 ≤ -CU * Real.sqrt (Real.log ((2 * q + 1 : ℕ) : ℝ))
  greedy : ∀ i, means i (counts (2 * q + 1) i) ≤
    means chosen (counts (2 * q + 1) chosen)

theorem bad_path_final_counts_and_wrong (q : ℕ) (hq : 2 ≤ q)
    (counts : ℕ → ArmCounts) (action : ℕ → Arm) (means : Arm → ℕ → ℝ)
    (chosen : Arm) (CU : ℝ) (hCU : 30 ≤ CU)
    (h : BadPathConditions q counts action means chosen CU) :
    counts (2 * q + 1) 0 = q ∧ counts (2 * q + 1) 1 = q ∧
      counts (2 * q + 1) 2 = 1 ∧ chosen ≠ 2 := by
  have hinv := invariant_all_rounds q hq counts action h.initial h.update
    h.beforeTerminal h.atTerminal (2 * q + 1) (by omega) (by omega)
  have hc := invariant_final_counts q (counts (2 * q + 1)) hinv
  refine ⟨hc.1, hc.2.1, hc.2.2, ?_⟩
  apply final_recommendation_wrong (2 * q + 1) (by omega) CU hCU
    (fun i => means i (counts (2 * q + 1) i)) chosen h.greedy
  · simpa only [hc.1] using h.firstArmClose
  · simpa only [hc.2.2] using h.thirdArmLow

/-- A genuine expected-regret consequence. The unproved policy-comparison
obligations are the explicit BadPathConditions hypothesis, not hidden axioms. -/
theorem bad_event_regret_lower_bound {Ω : Type*} [MeasurableSpace Ω]
    (μ : MeasureTheory.Measure Ω) [MeasureTheory.IsProbabilityMeasure μ]
    (q : ℕ) (hq : 2 ≤ q) (CU gap : ℝ) (hCU : 30 ≤ CU) (hgap : 0 ≤ gap)
    (event : Set Ω) (counts : Ω → ℕ → ArmCounts) (action : Ω → ℕ → Arm)
    (means : Ω → Arm → ℕ → ℝ) (recommend : Ω → Arm)
    (hwrongMeas : MeasurableSet {ω | recommend ω ≠ 2})
    (hpaths : ∀ ω ∈ event,
      BadPathConditions q (counts ω) (action ω) (means ω) (recommend ω) CU) :
    gap * μ.real event ≤ BayesOptimal.Foundations.Rates.fixedGapRegret μ {ω | recommend ω ≠ 2} gap := by
  apply BayesOptimal.Foundations.Rates.fixedGapRegret_event_lower_bound μ hwrongMeas ?_ hgap
  intro ω hω
  exact (bad_path_final_counts_and_wrong q hq (counts ω) (action ω) (means ω)
    (recommend ω) CU hCU (hpaths ω hω)).2.2.2

end BayesOptimal.Foundations.MainBridge

end

/-! ## Foundations.PolicyPaths -/
section

open MeasureTheory ProbabilityTheory

namespace BayesOptimal.Foundations.PolicyPaths

set_option maxHeartbeats 1000000

open BayesianModel

abbrev Path := Arm → ℕ → ℝ

noncomputable section

def meansAt (p : Path) (c : Counts) : Means := fun i => p i (c i)

def afterInitial (T : ℕ) (p : Path) : ℕ → Counts
  | 0 => fun _ => 1
  | r + 1 =>
    let c := afterInitial T p r
    advance c (choose (T - (r + 4)) c (meansAt p c))

def counts (T : ℕ) (p : Path) (s : ℕ) : Counts := afterInitial T p (s - 3)

def selected (T : ℕ) (p : Path) (t : ℕ) : Arm :=
  choose (T - t) (counts T p (t - 1)) (meansAt p (counts T p (t - 1)))

def recommendation (T : ℕ) (p : Path) : Arm := recommend (meansAt p (counts T p T))

theorem counts_initial (T : ℕ) (p : Path) (i : Arm) : counts T p 3 i = 1 := rfl

theorem counts_update (T : ℕ) (p : Path) (s : ℕ) (hs : 3 ≤ s) :
    counts T p (s + 1) = advance (counts T p s) (selected T p (s + 1)) := by
  have hindex : s + 1 - 3 = (s - 3) + 1 := by omega
  have htime : (s - 3) + 4 = s + 1 := by omega
  simp only [counts, hindex, afterInitial, htime, selected, Nat.add_sub_cancel]

theorem counts_positive (T : ℕ) (p : Path) (s : ℕ) (i : Arm) :
    0 < counts T p s i := by
  have h (r : ℕ) : ∀ i : Arm, 0 < afterInitial T p r i := by
    induction r with
    | zero => intro j; norm_num [afterInitial]
    | succ r ih =>
      intro j
      simp only [afterInitial, advance]
      exact lt_of_lt_of_le (ih j) (Nat.le_add_right _ _)
  exact h (s - 3) i

theorem selected_optimal (T : ℕ) (p : Path) (t : ℕ) (i : Arm) :
    action (T - t) (counts T p (t - 1)) (meansAt p (counts T p (t - 1))) i ≤
    action (T - t) (counts T p (t - 1)) (meansAt p (counts T p (t - 1)))
      (selected T p t) := by
  unfold selected
  rw [choose_optimal]
  exact action_le_value _ _ _ _

theorem selected_minimizes_regret (T : ℕ) (p : Path) (t : ℕ) (i : Arm) :
    PosteriorRegret.actionLoss (T - t) (counts T p (t - 1))
      (meansAt p (counts T p (t - 1))) (selected T p t) ≤
    PosteriorRegret.actionLoss (T - t) (counts T p (t - 1))
      (meansAt p (counts T p (t - 1))) i :=
  PosteriorRegret.chosen_loss_minimal _ _ _ (counts_positive T p (t - 1)) i

theorem recommendation_greedy (T : ℕ) (p : Path) (i : Arm) :
    p i (counts T p T i) ≤ p (recommendation T p) (counts T p T (recommendation T p)) :=
  recommend_greedy (meansAt p (counts T p T)) i

theorem choose_measurable (k : ℕ) (c : Counts) : Measurable (choose k c) := by
  unfold choose
  exact Measurable.ite
    (measurableSet_le ((action_lipschitz k c 1).continuous.max
      (action_lipschitz k c 2).continuous).measurable
      (action_lipschitz k c 0).continuous.measurable)
    measurable_const
    (Measurable.ite
      (measurableSet_le (action_lipschitz k c 2).continuous.measurable
        (action_lipschitz k c 1).continuous.measurable)
      measurable_const measurable_const)

theorem recommend_measurable : Measurable recommend := by
  unfold recommend
  exact Measurable.ite
    (measurableSet_le ((continuous_apply 1).max (continuous_apply 2)).measurable
      (continuous_apply 0).measurable)
    measurable_const
    (Measurable.ite (measurableSet_le (measurable_pi_apply 2) (measurable_pi_apply 1))
      measurable_const measurable_const)

theorem meansAt_measurable (c : Counts) : Measurable (meansAt · c) := by
  apply measurable_pi_lambda
  intro i
  exact (measurable_pi_apply (c i)).comp (measurable_pi_apply i)

theorem meansAt_joint_measurable :
    Measurable (fun x : Counts × Path => meansAt x.2 x.1) :=
  measurable_from_prod_countable_right meansAt_measurable

theorem choose_joint_measurable (k : ℕ) :
    Measurable (fun x : Counts × Means => choose k x.1 x.2) :=
  measurable_from_prod_countable_right (choose_measurable k)

theorem afterInitial_measurable (T r : ℕ) : Measurable (afterInitial T · r) := by
  induction r with
  | zero => exact measurable_const
  | succ r ih =>
    have hm : Measurable (fun p : Path => meansAt p (afterInitial T p r)) :=
      meansAt_joint_measurable.comp (ih.prodMk measurable_id)
    have hp : Measurable (fun p : Path =>
        (afterInitial T p r, meansAt p (afterInitial T p r))) := ih.prodMk hm
    have ha := (choose_joint_measurable (T - (r + 4))).comp hp
    change Measurable (fun p : Path =>
      choose (T - (r + 4)) (afterInitial T p r) (meansAt p (afterInitial T p r))) at ha
    exact (measurable_of_countable (fun x : Counts × Arm => advance x.1 x.2)).comp
      (ih.prodMk ha)

theorem counts_measurable (T s : ℕ) : Measurable (counts T · s) :=
  afterInitial_measurable T (s - 3)

theorem recommendation_measurable (T : ℕ) : Measurable (recommendation T) :=
  recommend_measurable.comp
    (meansAt_joint_measurable.comp ((counts_measurable T T).prodMk measurable_id))

theorem wrong_measurable (T : ℕ) : MeasurableSet {p : Path | recommendation T p ≠ 2} :=
  ((recommendation_measurable T) (measurableSet_singleton 2)).compl

end

end BayesOptimal.Foundations.PolicyPaths

end

/-! ## Foundations.FrequentistModel -/
section

open MeasureTheory ProbabilityTheory
open scoped BigOperators

namespace BayesOptimal.Foundations.FrequentistModel

open BayesianModel BadEvent

noncomputable section

/-- The instance used in the main theorem has true means (0,0,1). -/
def trueMean (i : Arm) : ℝ := if i = 2 then 1 else 0

def observation {T : ℕ} (ω : RawArrays T) (i : Arm) (n : Fin T) : ℝ :=
  ω i n + trueMean i

/-- Every statistic supplied to the Bayes policy is computed from the actual
independent frequentist reward array. -/
def empiricalPath {T : ℕ} (ω : RawArrays T) : PolicyPaths.Path :=
  fun i n => sampleMean n (ω i) + trueMean i

theorem true_instance_gap (i : Arm) : 1 - trueMean i = if i = 2 then 0 else 1 := by
  unfold trueMean
  split_ifs <;> norm_num

theorem empiricalPath_first {T : ℕ} (ω : RawArrays T) (n : ℕ) :
    empiricalPath ω 0 n = fullMeanPath ω 1 n := by simp [empiricalPath, trueMean, fullMeanPath]

theorem empiricalPath_second {T : ℕ} (ω : RawArrays T) (n : ℕ) :
    empiricalPath ω 1 n = fullMeanPath ω 2 n := by simp [empiricalPath, trueMean, fullMeanPath]

theorem empiricalPath_third {T : ℕ} (ω : RawArrays T) (n : ℕ) :
    empiricalPath ω 2 n = fullMeanPath ω 3 n := by simp [empiricalPath, trueMean, fullMeanPath]

theorem sampleMean_continuous (T n : ℕ) : Continuous (sampleMean (q := T) n) := by
  unfold sampleMean weightedSum
  fun_prop

theorem sampleMean_mul_count (T n : ℕ) (ω : Fin T → ℝ) (hn : 0 < n) :
    (n : ℝ) * sampleMean n ω = ∑ i : Fin T, if (i : ℕ) < n then ω i else 0 := by
  have hn0 : (n : ℝ) ≠ 0 := by exact_mod_cast Nat.ne_of_gt hn
  unfold sampleMean weightedSum
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro i _hi
  unfold meanCoefficient
  split_ifs
  · field_simp
  · simp

theorem rawSum_succ (T n : ℕ) (ω : Fin T → ℝ) (hnT : n < T) :
    (∑ i : Fin T, if (i : ℕ) < n + 1 then ω i else 0) =
      (∑ i : Fin T, if (i : ℕ) < n then ω i else 0) + ω ⟨n, hnT⟩ := by
  classical
  have hpoint : ∀ i : Fin T,
      (if (i : ℕ) < n + 1 then ω i else 0) =
        (if (i : ℕ) < n then ω i else 0) + (if i = ⟨n, hnT⟩ then ω i else 0) := by
    intro i
    by_cases hi : (i : ℕ) < n
    · have hin1 : (i : ℕ) < n + 1 := by omega
      have hine : i ≠ ⟨n, hnT⟩ := by
        intro h
        have hv : (i : ℕ) = n := congrArg Fin.val h
        omega
      simp [hi, hin1, hine]
    · by_cases hieq : (i : ℕ) = n
      · have hieq' : i = ⟨n, hnT⟩ := Fin.ext hieq
        simp [hieq']
      · have hin1 : ¬ ((i : ℕ) < n + 1) := by omega
        have hine : i ≠ ⟨n, hnT⟩ := by intro h; exact hieq (congrArg Fin.val h)
        simp [hi, hin1, hine]
  simp_rw [hpoint]
  rw [Finset.sum_add_distrib]
  simp

/-- The empirical statistic of the actual raw reward array follows Eq. (3). -/
theorem sampleMean_update (T n : ℕ) (ω : Fin T → ℝ) (hn : 0 < n) (hnT : n < T) :
    sampleMean (n + 1) ω =
      Gaussian.posteriorMeanUpdate (sampleMean n ω) (n : ℝ) (ω ⟨n, hnT⟩) := by
  have hsum := rawSum_succ T n ω hnT
  rw [← sampleMean_mul_count T (n + 1) ω (by omega),
    ← sampleMean_mul_count T n ω hn] at hsum
  have hn1 : (n : ℝ) + 1 ≠ 0 := by positivity
  unfold Gaussian.posteriorMeanUpdate
  apply (eq_div_iff hn1).mpr
  push_cast at hsum
  nlinarith only [hsum]

theorem empiricalPath_update {T : ℕ} (ω : RawArrays T) (i : Arm) (n : ℕ)
    (hn : 0 < n) (hnT : n < T) :
    empiricalPath ω i (n + 1) =
      Gaussian.posteriorMeanUpdate (empiricalPath ω i n) (n : ℝ)
        (observation ω i ⟨n, hnT⟩) := by
  have h := sampleMean_update T n (ω i) hn hnT
  have hn1 : (n : ℝ) + 1 ≠ 0 := by positivity
  simp only [empiricalPath, observation, h, Gaussian.posteriorMeanUpdate]
  field_simp
  ring

theorem empiricalPath_measurable (T : ℕ) : Measurable (empiricalPath (T := T)) := by
  apply measurable_pi_lambda
  intro i
  apply measurable_pi_lambda
  intro n
  exact (((sampleMean_continuous T n).measurable.comp (measurable_pi_apply i)).add_const
    (trueMean i))

def actualRecommendation (T : ℕ) (ω : RawArrays T) : Arm :=
  PolicyPaths.recommendation T (empiricalPath ω)

theorem actualRecommendation_measurable (T : ℕ) : Measurable (actualRecommendation T) :=
  (PolicyPaths.recommendation_measurable T).comp (empiricalPath_measurable T)

def wrongEvent (T : ℕ) : Set (RawArrays T) := {ω | actualRecommendation T ω ≠ 2}

theorem wrongEvent_measurable (T : ℕ) : MeasurableSet (wrongEvent T) :=
  ((actualRecommendation_measurable T) (measurableSet_singleton 2)).compl

/-- Frequentist expected simple regret of the explicit posterior Bellman
policy. The integrand is the true gap of its actual recommendation. -/
def regret (T : ℕ) : ℝ :=
  ∫ ω : RawArrays T, 1 - trueMean (actualRecommendation T ω) ∂rawArraysLaw T

theorem regret_eq_wrong_probability (T : ℕ) :
    regret T = (rawArraysLaw T).real (wrongEvent T) := by
  have hi : (fun ω : RawArrays T => 1 - trueMean (actualRecommendation T ω)) =
      (wrongEvent T).indicator (fun _ => (1 : ℝ)) := by
    funext ω
    rw [true_instance_gap]
    by_cases h : actualRecommendation T ω = 2 <;> simp [wrongEvent, h]
  unfold regret
  rw [hi, integral_indicator (wrongEvent_measurable T)]
  simp

theorem badEvent_regret_lower_bound (T q : ℕ) (hT : T = 2 * q + 1) (hq : 2 ≤ q)
    (hwrong : rawBadEvent T q (by omega) (by omega) ⊆ wrongEvent T) :
    (underestimationConstant / 64) * Rates.invPower 886 T ≤ regret T := by
  rw [regret_eq_wrong_probability]
  exact (rawBadEvent_probability_lower T q hT hq).trans (measureReal_mono hwrong)

end

end BayesOptimal.Foundations.FrequentistModel

end

/-! ## Foundations.Execution -/
section

namespace BayesOptimal.Foundations.Execution

open BayesianModel PolicyPaths FrequentistModel

noncomputable section

theorem advance_total (c : BayesianModel.Counts) (i : Arm) :
    advance c i 0 + advance c i 1 + advance c i 2 = c 0 + c 1 + c 2 + 1 := by
  fin_cases i <;> simp [advance] <;> omega

theorem afterInitial_total (T r : ℕ) (p : Path) :
    afterInitial T p r 0 + afterInitial T p r 1 + afterInitial T p r 2 = 3 + r := by
  induction r with
  | zero => rfl
  | succ r ih =>
    simp only [afterInitial, advance_total]
    omega

theorem counts_total (T s : ℕ) (p : Path) (hs : 3 ≤ s) :
    counts T p s 0 + counts T p s 1 + counts T p s 2 = s := by
  have h := afterInitial_total T (s - 3) p
  unfold counts
  omega

theorem count_before_draw_lt_budget (T t : ℕ) (p : Path) (ht : 4 ≤ t) (htT : t ≤ T)
    (i : Arm) : counts T p (t - 1) i < T := by
  have hsum := counts_total T (t - 1) p (by omega)
  fin_cases i
  · change counts T p (t - 1) 0 < T
    omega
  · change counts T p (t - 1) 1 < T
    omega
  · change counts T p (t - 1) 2 < T
    omega

theorem initial_mean (T : ℕ) (hT : 0 < T) (ω : BadEvent.RawArrays T) (i : Arm) :
    meansAt (empiricalPath ω) (counts T (empiricalPath ω) 3) i =
      observation ω i ⟨0, hT⟩ := by
  simp only [meansAt, counts_initial, empiricalPath, observation]
  rw [BadEvent.sampleMean_one hT]

theorem meansAt_advance_eq_shift {T : ℕ} (ω : BadEvent.RawArrays T)
    (c : BayesianModel.Counts) (i : Arm) (hn : 0 < c i) (hb : c i < T) :
    meansAt (empiricalPath ω) (advance c i) =
      shift (meansAt (empiricalPath ω) c) i
        (Gaussian.posteriorMeanUpdate (meansAt (empiricalPath ω) c i) (c i)
          (observation ω i ⟨c i, hb⟩) - meansAt (empiricalPath ω) c i) := by
  funext j
  by_cases hj : j = i
  · subst j
    simp only [meansAt, advance, shift, if_true]
    rw [empiricalPath_update ω i (c i) hn hb]
    ring
  · simp only [meansAt, advance, shift, if_neg hj, add_zero]

/-- Each actual posterior state follows the weighted sample update (Eq.3),
using an unused raw Gaussian reward of the arm selected by the Bayes policy. -/
theorem actual_mean_update (T t : ℕ) (ht : 4 ≤ t) (htT : t ≤ T)
    (ω : BadEvent.RawArrays T) :
    let p := empiricalPath ω
    let c := counts T p (t - 1)
    let i := selected T p t
    let oldMean := meansAt p c i
    let reward := observation ω i ⟨c i, count_before_draw_lt_budget T t p ht htT i⟩
    meansAt p (counts T p t) =
      shift (meansAt p c) i (Gaussian.posteriorMeanUpdate oldMean (c i) reward - oldMean) := by
  dsimp only
  have he : t - 1 + 1 = t := by omega
  have hu := counts_update T (empiricalPath ω) (t - 1) (by omega)
  rw [he] at hu
  rw [hu]
  exact meansAt_advance_eq_shift ω (counts T (empiricalPath ω) (t - 1))
    (selected T (empiricalPath ω) t)
    (counts_positive T (empiricalPath ω) (t - 1) (selected T (empiricalPath ω) t))
    (count_before_draw_lt_budget T t (empiricalPath ω) ht htT (selected T (empiricalPath ω) t))

end

end BayesOptimal.Foundations.Execution

end

/-! ## Foundations.PathInduction -/
section

namespace BayesOptimal.Foundations.PathInduction

open BayesianModel PolicyPaths

noncomputable section

def paperPath (p : Path) : Counts.MeanPath :=
  fun i n => if i = 1 then p 0 n else if i = 2 then p 1 n else p 2 n

def projectCounts (c : BayesianModel.Counts) : Counts.Counts := ⟨c 0, c 1, c 2⟩

def goodPath (T q : ℕ) (p : Path) : Prop :=
  Drift.eventX T 40 (paperPath p) ∧ Drift.eventY T q 1 (paperPath p) ∧
  Drift.eventY T q 2 (paperPath p) ∧ Drift.eventZ T q 1 (paperPath p) ∧
  Drift.eventZ T q 2 (paperPath p)

theorem goodPath_W (T q s : ℕ) (p : Path) (c : BayesianModel.Counts)
    (hp : goodPath T q p) (hc : MainBridge.invariant q s c) :
    Drift.paperW T q 40 (paperPath p) (projectCounts c) := by
  have hcaps : c 0 ≤ q ∧ c 1 ≤ q ∧ c 2 = 1 := by
    exact ⟨hc.1, hc.2.1, hc.2.2.1⟩
  exact ⟨hp.1, hp.2.1, hp.2.2.1, hp.2.2.2.1, hp.2.2.2.2,
    hcaps.1, hcaps.2.1, hcaps.2.2.le⟩

/-- Round induction valid for both budget parities, including the last draw. -/
theorem counts_invariant (T q : ℕ) (hq : 2 ≤ q) (_hT : 3 ≤ T) (p : Path)
    (hpolicy : ∀ s, 3 ≤ s → s < T → MainBridge.invariant q s (counts T p s) →
      MainBridge.admissible q (counts T p s) (selected T p (s + 1))) :
    ∀ s, 3 ≤ s → s ≤ T → MainBridge.invariant q s (counts T p s) := by
  intro s
  induction s using Nat.strong_induction_on with
  | h s ih =>
    intro hlo hhi
    by_cases hbase : s = 3
    · subst s
      change (1 : ℕ) ≤ q ∧ 1 ≤ q ∧ 1 = 1 ∧ 1 + 1 + 1 = 3
      omega
    · have hp : 3 ≤ s - 1 := by omega
      have he : s - 1 + 1 = s := by omega
      have hc := ih (s - 1) (by omega) hp (by omega)
      have ha := hpolicy (s - 1) hp (by omega) hc
      rw [← he, counts_update T p (s - 1) hp]
      simpa only [he] using MainBridge.advance_invariant q (s - 1) (counts T p (s - 1))
        (selected T p s) hc (by simpa only [he] using ha)

theorem final_anchor_count (T q : ℕ) (c : BayesianModel.Counts)
    (hT : T = 2 * q ∨ T = 2 * q + 1) (hc : MainBridge.invariant q T c) :
    c 0 = q ∨ c 1 = q := by
  unfold MainBridge.invariant at hc
  omega

theorem goodPath_recommendation_wrong (T q : ℕ) (_hq : 2 ≤ q) (hT5 : 5 ≤ T)
    (hT : T = 2 * q ∨ T = 2 * q + 1) (p : Path) (hp : goodPath T q p)
    (hc : MainBridge.invariant q T (counts T p T)) :
    recommendation T p ≠ 2 := by
  have hanchor := final_anchor_count T q (counts T p T) hT hc
  have hx : p 2 1 ≤ -40 * Real.sqrt (Real.log (T : ℝ)) := by
    simpa [Drift.eventX, paperPath] using hp.1
  have hc3 := hc.2.2.1
  intro hr
  rcases hanchor with h₀ | h₁
  · have hy : |p 0 q| ≤ 1 / (T : ℝ) ^ 2 := by
      simpa [Drift.eventY, paperPath] using hp.2.1
    have hsep := MainBridge.terminal_underestimation_separation T hT5 40 (p 0 q)
      (p 2 1) (by norm_num) hy hx
    have hg := recommendation_greedy T p 0
    rw [hr, h₀, hc3] at hg
    exact not_le_of_gt hsep hg
  · have hy : |p 1 q| ≤ 1 / (T : ℝ) ^ 2 := by
      simpa [Drift.eventY, paperPath] using hp.2.2.1
    have hsep := MainBridge.terminal_underestimation_separation T hT5 40 (p 1 q)
      (p 2 1) (by norm_num) hy hx
    have hg := recommendation_greedy T p 1
    rw [hr, h₁, hc3] at hg
    exact not_le_of_gt hsep hg

end

end BayesOptimal.Foundations.PathInduction

end

/-! ## Foundations.Optimality -/
section

open MeasureTheory ProbabilityTheory

namespace BayesOptimal.Foundations.Optimality

open BayesianModel PosteriorRegret

noncomputable section

/-- Unrolling a history-dependent strategy at a fixed observed state gives
an arm at each node and a continuation for every observed innovation. -/
inductive Strategy : ℕ → Type
  | stop (i : Arm) : Strategy 0
  | sample {k : ℕ} (i : Arm) (next : ℝ → Strategy k) : Strategy (k + 1)

def utility : {k : ℕ} → Strategy k → Counts → Means → ℝ
  | 0, .stop i, _, m => m i
  | _ + 1, .sample i next, c, m =>
      ∫ z : ℝ, utility (next z) (advance c i) (shift m i z)
        ∂gaussianReal 0 (innovation c i)

/-- Admissibility states that each continuation's actual expected payoff is
integrable. It places no optimality or paper-estimate condition on a strategy. -/
def Admissible : {k : ℕ} → Strategy k → Counts → Means → Prop
  | 0, .stop _, _, _ => True
  | _ + 1, .sample i next, c, m =>
      (∀ z, Admissible (next z) (advance c i) (shift m i z)) ∧
      Integrable (fun z : ℝ => utility (next z) (advance c i) (shift m i z))
        (gaussianReal 0 (innovation c i))

def optimal : (k : ℕ) → Counts → Means → Strategy k
  | 0, _, m => .stop (recommend m)
  | k + 1, c, m =>
    let i := choose k c m
    .sample i (fun z => optimal k (advance c i) (shift m i z))

/-- The selected Bellman policy attains the recursive value. -/
theorem optimal_utility (k : ℕ) (c : Counts) (m : Means) :
    utility (optimal k c m) c m = value k c m := by
  induction k generalizing c m with
  | zero => exact recommend_max m
  | succ k ih =>
    simp only [optimal, utility, ih]
    exact choose_optimal k c m

theorem optimal_admissible (k : ℕ) (c : Counts) (m : Means) :
    Admissible (optimal k c m) c m := by
  induction k generalizing c m with
  | zero => trivial
  | succ k ih =>
    constructor
    · intro z; exact ih _ _
    · simp only [optimal_utility]
      exact action_integrable k c m (choose k c m)

/-- Bellman's value dominates every admissible history-dependent strategy,
including strategies with observations changing all later actions. -/
theorem utility_le_value {k : ℕ} (s : Strategy k) (c : Counts) (m : Means)
    (hs : Admissible s c m) : utility s c m ≤ value k c m := by
  induction k generalizing c m with
  | zero =>
    cases s with
    | stop i =>
      change m i ≤ terminal m
      rw [← recommend_max]
      exact recommend_greedy m i
  | succ k ih =>
    cases s with
    | sample i next =>
      have h := integral_mono hs.2 (action_integrable k c m i)
        (fun z => ih (next z) _ _ (hs.1 z))
      exact h.trans (action_le_value k c m i)

def expectedRegret : {k : ℕ} → Strategy k → Counts → Means → ℝ
  | 0, .stop i, c, m => potential c m - m i
  | _ + 1, .sample i next, c, m =>
    ∫ z : ℝ, expectedRegret (next z) (advance c i) (shift m i z)
      ∂gaussianReal 0 (innovation c i)

theorem expectedRegret_eq {k : ℕ} (s : Strategy k) (c : Counts) (m : Means)
    (hc : ∀ i, 0 < c i) (hs : Admissible s c m) :
    expectedRegret s c m = potential c m - utility s c m := by
  induction k generalizing c m with
  | zero => cases s; rfl
  | succ k ih =>
    cases s with
    | sample i next =>
      have hp : ∀ j, 0 < advance c i j := by
        intro j
        exact lt_of_lt_of_le (hc j) (Nat.le_add_right _ _)
      simp only [expectedRegret, ih (next _) _ _ hp (hs.1 _), utility]
      rw [integral_sub (shifted_integrable (potential_lipschitz _) _ _ _) hs.2]
      have ht := congrFun (potential_tower c i (hc i)) m
      exact congrArg (fun x : ℝ => x - ∫ z : ℝ, utility (next z) (advance c i) (shift m i z)
        ∂gaussianReal 0 (innovation c i)) ht

/-- Global posterior Bayes optimality after the required initial draws.
No premise assumes that the selected policy is optimal. -/
theorem bayes_optimal {k : ℕ} (s : Strategy k) (c : Counts) (m : Means)
    (hc : ∀ i, 0 < c i) (hs : Admissible s c m) :
    expectedRegret (optimal k c m) c m ≤ expectedRegret s c m := by
  rw [expectedRegret_eq _ _ _ hc (optimal_admissible k c m),
    expectedRegret_eq s c m hc hs, optimal_utility]
  exact sub_le_sub_left (utility_le_value s c m hs) _

end

end BayesOptimal.Foundations.Optimality

end

/-! ## Foundations.PosteriorLaw -/
section

open MeasureTheory ProbabilityTheory
open scoped NNReal ENNReal

namespace BayesOptimal.Foundations.PosteriorLaw

open BayesianModel PosteriorRegret

noncomputable section

abbrev Triple := ℝ × (ℝ × ℝ)

/-- Independent centered posterior errors, with the paper's inverse-count variances. -/
def centeredTripleLaw (c : Counts) : Measure Triple :=
  (gaussianReal 0 (c 0 : ℝ≥0)⁻¹).prod
    ((gaussianReal 0 (c 1 : ℝ≥0)⁻¹).prod (gaussianReal 0 (c 2 : ℝ≥0)⁻¹))

def tripleShift (m : Means) (x : Triple) : Means :=
  shift (shift (shift m 0 x.1) 1 x.2.1) 2 x.2.2

theorem tripleShift_continuous (m : Means) : Continuous (tripleShift m) := by
  apply continuous_pi
  intro i
  fin_cases i <;> simp [tripleShift, shift] <;> fun_prop

theorem tripleShift_measurable (m : Means) : Measurable (tripleShift m) :=
  (tripleShift_continuous m).measurable

/-- The actual joint Gaussian posterior of the three latent arm means. -/
def posteriorLaw (c : Counts) (m : Means) : Measure Means :=
  Measure.map (tripleShift m) (centeredTripleLaw c)

instance centeredTripleLaw_probability (c : Counts) :
    IsProbabilityMeasure (centeredTripleLaw c) := by
  unfold centeredTripleLaw
  infer_instance

instance posteriorLaw_probability (c : Counts) (m : Means) :
    IsProbabilityMeasure (posteriorLaw c m) :=
  Measure.isProbabilityMeasure_map (tripleShift_measurable m).aemeasurable

theorem centered_first_law (c : Counts) :
    Measure.map Prod.fst (centeredTripleLaw c) = gaussianReal 0 (c 0 : ℝ≥0)⁻¹ := by
  simp [centeredTripleLaw]

theorem centered_second_law (c : Counts) :
    Measure.map (fun x : Triple => x.2.1) (centeredTripleLaw c) =
      gaussianReal 0 (c 1 : ℝ≥0)⁻¹ := by
  change Measure.map (Prod.fst ∘ Prod.snd) (centeredTripleLaw c) = _
  rw [← Measure.map_map measurable_fst measurable_snd]
  simp [centeredTripleLaw]

theorem centered_third_law (c : Counts) :
    Measure.map (fun x : Triple => x.2.2) (centeredTripleLaw c) =
      gaussianReal 0 (c 2 : ℝ≥0)⁻¹ := by
  change Measure.map (Prod.snd ∘ Prod.snd) (centeredTripleLaw c) = _
  rw [← Measure.map_map measurable_snd measurable_snd]
  simp [centeredTripleLaw]

theorem posterior_coordinate_law (c : Counts) (m : Means) (i : Arm) :
    Measure.map (fun u : Means => u i) (posteriorLaw c m) =
      gaussianReal (m i) (c i : ℝ≥0)⁻¹ := by
  unfold posteriorLaw
  rw [Measure.map_map (measurable_pi_apply i) (tripleShift_measurable m)]
  fin_cases i
  · have h := gaussianReal_map_const_add (μ := 0) (v := (c 0 : ℝ≥0)⁻¹) (m 0)
    rw [← centered_first_law c,
      Measure.map_map (by fun_prop) measurable_fst] at h
    simpa [Function.comp_def, tripleShift, shift] using h
  · have h := gaussianReal_map_const_add (μ := 0) (v := (c 1 : ℝ≥0)⁻¹) (m 1)
    rw [← centered_second_law c,
      Measure.map_map (by fun_prop) (by fun_prop)] at h
    simpa [Function.comp_def, tripleShift, shift] using h
  · have h := gaussianReal_map_const_add (μ := 0) (v := (c 2 : ℝ≥0)⁻¹) (m 2)
    rw [← centered_third_law c,
      Measure.map_map (by fun_prop) (by fun_prop)] at h
    simpa [Function.comp_def, tripleShift, shift] using h

theorem posterior_joint_law (c : Counts) (m : Means) :
    Measure.map (fun u : Means => (u 0, (u 1, u 2))) (posteriorLaw c m) =
      (gaussianReal (m 0) (c 0 : ℝ≥0)⁻¹).prod
        ((gaussianReal (m 1) (c 1 : ℝ≥0)⁻¹).prod
          (gaussianReal (m 2) (c 2 : ℝ≥0)⁻¹)) := by
  unfold posteriorLaw
  rw [Measure.map_map (by fun_prop) (tripleShift_measurable m)]
  have he : (fun u : Means => (u 0, (u 1, u 2))) ∘ tripleShift m =
      Prod.map (fun x : ℝ => m 0 + x)
        (Prod.map (fun x : ℝ => m 1 + x) (fun x : ℝ => m 2 + x)) := by
    funext x
    simp [tripleShift, shift, Prod.map]
  rw [he]
  unfold centeredTripleLaw
  rw [← Measure.map_prod_map _ _ (by fun_prop) (by fun_prop),
    ← Measure.map_prod_map _ _ (by fun_prop) (by fun_prop)]
  simp only [gaussianReal_map_const_add, zero_add]

theorem triple_shift_integrable {f : Means → ℝ} (hf : LipschitzWith 1 f)
    (m : Means) (c : Counts) :
    Integrable (fun x : Triple => f (tripleShift m x)) (centeredTripleLaw c) := by
  have hb (x : Triple) : ‖f (tripleShift m x)‖ ≤
      ‖f m‖ + |x.1| + |x.2.1| + |x.2.2| := by
    have h := hf.dist_le_mul (tripleShift m x) m
    simp only [dist_eq_norm, NNReal.coe_one, one_mul] at h
    have h₀ := shift_norm_bound m 0 x.1
    have h₁ := shift_norm_bound (shift m 0 x.1) 1 x.2.1
    have h₂ := shift_norm_bound (shift (shift m 0 x.1) 1 x.2.1) 2 x.2.2
    have ht₁ := norm_sub_le_norm_sub_add_norm_sub
      (shift (shift m 0 x.1) 1 x.2.1) (shift m 0 x.1) m
    have ht₂ := norm_sub_le_norm_sub_add_norm_sub
      (tripleShift m x) (shift (shift m 0 x.1) 1 x.2.1) m
    have ht := norm_add_le (f (tripleShift m x) - f m) (f m)
    simp only [sub_add_cancel] at ht
    unfold tripleShift at h ht ht₂ ⊢
    linarith
  have hi₀ := (Gaussian.gaussian_id_integrable 0 (c 0 : ℝ≥0)⁻¹).norm.comp_fst
    ((gaussianReal 0 (c 1 : ℝ≥0)⁻¹).prod (gaussianReal 0 (c 2 : ℝ≥0)⁻¹))
  have hi₁ := ((Gaussian.gaussian_id_integrable 0 (c 1 : ℝ≥0)⁻¹).norm.comp_fst
    (gaussianReal 0 (c 2 : ℝ≥0)⁻¹)).comp_snd (gaussianReal 0 (c 0 : ℝ≥0)⁻¹)
  have hi₂ := ((Gaussian.gaussian_id_integrable 0 (c 2 : ℝ≥0)⁻¹).norm.comp_snd
    (gaussianReal 0 (c 1 : ℝ≥0)⁻¹)).comp_snd (gaussianReal 0 (c 0 : ℝ≥0)⁻¹)
  exact (((integrable_const ‖f m‖).add hi₀).add hi₁).add hi₂ |>.mono'
    (hf.continuous.comp (tripleShift_continuous m)).measurable.aestronglyMeasurable
    (Filter.Eventually.of_forall hb)

theorem posterior_terminal_integrable (c : Counts) (m : Means) :
    Integrable terminal (posteriorLaw c m) := by
  apply (integrable_map_measure terminal_lipschitz.continuous.measurable.aestronglyMeasurable
    (tripleShift_measurable m).aemeasurable).mpr
  exact triple_shift_integrable terminal_lipschitz m c

theorem potential_eq_posterior_integral (c : Counts) (m : Means) :
    potential c m = ∫ u : Means, terminal u ∂posteriorLaw c m := by
  rw [posteriorLaw, integral_map (tripleShift_measurable m).aemeasurable
    terminal_lipschitz.continuous.measurable.aestronglyMeasurable]
  unfold centeredTripleLaw
  rw [integral_prod _ (triple_shift_integrable terminal_lipschitz m c)]
  unfold potential smooth
  congr 1
  funext x
  unfold tripleShift
  rw [integral_prod _ (double_shift_integrable terminal_lipschitz
    (shift m 0 x) 1 2 _ _)]

theorem posterior_coordinate_integrable (c : Counts) (m : Means) (i : Arm) :
    Integrable (fun u : Means => u i) (posteriorLaw c m) := by
  have hi : Integrable (fun x : ℝ => x)
      (Measure.map (fun u : Means => u i) (posteriorLaw c m)) := by
    rw [posterior_coordinate_law]
    exact Gaussian.gaussian_id_integrable _ _
  exact hi.comp_measurable (measurable_pi_apply i)

theorem posterior_coordinate_mean (c : Counts) (m : Means) (i : Arm) :
    ∫ u : Means, u i ∂posteriorLaw c m = m i := by
  have h := integral_id_gaussianReal (μ := m i) (v := (c i : ℝ≥0)⁻¹)
  rw [← posterior_coordinate_law c m i,
    integral_map (measurable_pi_apply i).aemeasurable (by fun_prop)] at h
  exact h

/-- Actual posterior expected simple regret of recommending a fixed arm. -/
def terminalRegret (c : Counts) (m : Means) (i : Arm) : ℝ :=
  ∫ u : Means, terminal u - u i ∂posteriorLaw c m

theorem terminalRegret_integrable (c : Counts) (m : Means) (i : Arm) :
    Integrable (fun u : Means => terminal u - u i) (posteriorLaw c m) :=
  (posterior_terminal_integrable c m).sub (posterior_coordinate_integrable c m i)

theorem terminalRegret_nonnegative (c : Counts) (m : Means) (i : Arm) :
    0 ≤ terminalRegret c m i := by
  apply integral_nonneg
  intro u
  exact sub_nonneg.mpr ((recommend_greedy u i).trans_eq (recommend_max u))

theorem terminalRegret_eq (c : Counts) (m : Means) (i : Arm) :
    terminalRegret c m i = potential c m - m i := by
  unfold terminalRegret
  rw [integral_sub (posterior_terminal_integrable c m)
    (posterior_coordinate_integrable c m i),
    ← potential_eq_posterior_integral, posterior_coordinate_mean]

theorem terminalRegret_recommend_eq_loss (c : Counts) (m : Means) :
    terminalRegret c m (recommend m) = loss 0 c m := by
  rw [terminalRegret_eq, recommend_max m]
  rfl

theorem terminalRegret_recommend_minimal (c : Counts) (m : Means) (i : Arm) :
    terminalRegret c m (recommend m) ≤ terminalRegret c m i := by
  rw [terminalRegret_eq, terminalRegret_eq]
  exact sub_le_sub_left (recommend_greedy m i) _

theorem terminalRegret_stop_eq_expectedRegret (c : Counts) (m : Means) (i : Arm) :
    terminalRegret c m i = Optimality.expectedRegret (.stop i) c m := by
  exact terminalRegret_eq c m i

end

end BayesOptimal.Foundations.PosteriorLaw

end

/-! ## Foundations.MainTheorem -/
section

/-!
End-to-end regret bounds for the explicitly defined posterior Bayes optimal
Gaussian algorithm on true means (0,0,1). The event probabilities, Bellman
comparisons, all action choices and terminal recommendation are proved.
-/

open MeasureTheory ProbabilityTheory Filter Asymptotics

namespace BayesOptimal.Foundations.MainTheorem

open BayesianModel PolicyPaths PathInduction FrequentistModel

noncomputable section

theorem modelCounts_project (c : BayesianModel.Counts) :
    DynamicPolicy.modelCounts (projectCounts c) = c := by
  ext i
  fin_cases i <;> simp [DynamicPolicy.modelCounts, projectCounts]

theorem modelMeans_project (p : Path) (c : BayesianModel.Counts) :
    DynamicPolicy.modelMeans (paperPath p) (projectCounts c) = meansAt p c := by
  ext i
  fin_cases i <;> simp [DynamicPolicy.modelMeans, paperPath, projectCounts, meansAt]

theorem decision_selected (T s : ℕ) (p : Path) :
    DynamicPolicy.decision T (s + 1) (paperPath p) (projectCounts (counts T p s)) =
      selected T p (s + 1) := by
  simp only [DynamicPolicy.decision, modelCounts_project, modelMeans_project,
    selected, Nat.add_sub_cancel]

theorem invariant_horizon (T q s : ℕ) (p : Path)
    (hc : MainBridge.invariant q s (counts T p s)) :
    Counts.horizonConsistent (s + 1) (projectCounts (counts T p s)) := by
  have h₀ := counts_positive T p s 0
  have h₁ := counts_positive T p s 1
  simp only [Counts.horizonConsistent, projectCounts]
  exact ⟨h₀, h₁, hc.2.2.1, by simpa only [Nat.add_sub_cancel] using hc.2.2.2⟩

theorem fullMeanPath_eq {T : ℕ} (ω : BadEvent.RawArrays T) :
    paperPath (empiricalPath ω) = BadEvent.fullMeanPath ω := by
  funext i n
  simp [paperPath, empiricalPath, trueMean, BadEvent.fullMeanPath]

theorem W50_implies_W40 (T q : ℕ) (p : Counts.MeanPath) (c : Counts.Counts)
    (hW : Drift.paperW T q 50 p c) : Drift.paperW T q 40 p c := by
  refine ⟨?_, hW.2⟩
  have hx := hW.1
  unfold Drift.eventX at *
  nlinarith [Real.sqrt_nonneg (Real.log (T : ℝ))]

theorem rawBadEvent50_goodPath (T q : ℕ) (hq : 2 ≤ q) (hqT : q ≤ T) (hT : 0 < T)
    (ω : BadEvent.RawArrays T) (hω : ω ∈ BadEvent50.rawBadEvent T q hqT hT) :
    goodPath T q (empiricalPath ω) := by
  have hw := BadEvent50.rawBadEvent_implies_full_W T q hqT hT ω
    (⟨1, 1, 1⟩ : Counts.Counts) hω (by change 1 ≤ q; omega)
      (by change 1 ≤ q; omega) (by norm_num)
  rw [← fullMeanPath_eq ω] at hw
  have h40 := W50_implies_W40 T q _ _ hw
  exact ⟨h40.1, h40.2.1, h40.2.2.1, h40.2.2.2.1, h40.2.2.2.2.1⟩

theorem odd_goodPath_wrong (N : ℕ)
    (hN : ∀ (T : ℕ), N ≤ T → ∀ (q t : ℕ) (p : Counts.MeanPath) (c : Counts.Counts),
      T = 2 * q + 1 → 4 ≤ t → t ≤ T → Counts.horizonConsistent t c →
      Drift.paperW T q 40 p c → DynamicPolicy.admissible q c (DynamicPolicy.decision T t p c))
    (T q : ℕ) (hlarge : N ≤ T) (hT : T = 2 * q + 1) (hq : 2 ≤ q)
    (p : Path) (hp : goodPath T q p) : recommendation T p ≠ 2 := by
  have hpolicy (s : ℕ) (hs : 3 ≤ s) (hsT : s < T)
      (hc : MainBridge.invariant q s (counts T p s)) :
      MainBridge.admissible q (counts T p s) (selected T p (s + 1)) := by
    have ha := hN T hlarge q (s + 1) (paperPath p) (projectCounts (counts T p s))
      hT (by omega) (by omega) (invariant_horizon T q s p hc)
      (goodPath_W T q s p (counts T p s) hp hc)
    rw [decision_selected] at ha
    exact ha
  have hi := counts_invariant T q hq (by omega) p hpolicy T (by omega) le_rfl
  exact goodPath_recommendation_wrong T q hq (by omega) (Or.inr hT) p hp hi

/-- No unproved event or policy hypothesis occurs in this odd-budget main bound. -/
theorem odd_main_polynomial_lower_bound :
    ∃ N : ℕ, ∀ (T q : ℕ), N ≤ T → T = 2 * q + 1 →
      (BadEvent.underestimationConstant / 64) * Rates.invPower 1356 T ≤ regret T := by
  obtain ⟨N, hN⟩ := DynamicPolicy.eventually_all_W_admissible
  refine ⟨max N 5, ?_⟩
  intro T q hlarge hT
  have h5 : 5 ≤ T := (le_max_right N 5).trans hlarge
  have hq : 2 ≤ q := by omega
  rw [regret_eq_wrong_probability]
  apply (BadEvent50.rawBadEvent_odd_probability_lower T q hT hq).trans
  refine measureReal_mono ?_ (measure_ne_top _ _)
  intro ω hω
  exact odd_goodPath_wrong N hN T q ((le_max_left N 5).trans hlarge) hT hq
    (empiricalPath ω) (rawBadEvent50_goodPath T q hq (by omega) (by omega) ω hω)

theorem even_rawBadEvent_wrong (N : ℕ)
    (hN : ∀ (T : ℕ), N ≤ T → ∀ (q t : ℕ) (p : Counts.MeanPath) (c : Counts.Counts),
      T = 2 * q → 4 ≤ t → t ≤ T → Counts.horizonConsistent t c →
      Drift.paperW T q 50 p c → DynamicPolicy.admissible q c (DynamicPolicy.decision T t p c))
    (T q : ℕ) (hlarge : N ≤ T) (hT : T = 2 * q) (hq : 3 ≤ q)
    (ω : BadEvent.RawArrays T) (hω : ω ∈ BadEvent50.rawBadEvent T q (by omega) (by omega)) :
    actualRecommendation T ω ≠ 2 := by
  let p := empiricalPath ω
  have hp := rawBadEvent50_goodPath T q (by omega) (by omega) (by omega) ω hω
  have hpolicy (s : ℕ) (hs : 3 ≤ s) (hsT : s < T)
      (hc : MainBridge.invariant q s (counts T p s)) :
      MainBridge.admissible q (counts T p s) (selected T p (s + 1)) := by
    have hw := BadEvent50.rawBadEvent_implies_full_W T q (by omega) (by omega) ω
      (projectCounts (counts T p s)) hω hc.1 hc.2.1 hc.2.2.1.le
    rw [← fullMeanPath_eq ω] at hw
    have ha := hN T hlarge q (s + 1) (paperPath p) (projectCounts (counts T p s))
      hT (by omega) (by omega) (invariant_horizon T q s p hc) hw
    rw [decision_selected] at ha
    exact ha
  have hi := counts_invariant T q (by omega) (by omega) p hpolicy T (by omega) le_rfl
  exact goodPath_recommendation_wrong T q (by omega) (by omega) (Or.inl hT) p hp hi

theorem even_main_polynomial_lower_bound :
    ∃ N : ℕ, ∀ (T q : ℕ), N ≤ T → T = 2 * q →
      (BadEvent.underestimationConstant / 64) * Rates.invPower 1356 T ≤ regret T := by
  obtain ⟨N, hN⟩ := EvenDynamicPolicy.eventually_all_W_admissible
  refine ⟨max N 12, ?_⟩
  intro T q hlarge hT
  have h12 : 12 ≤ T := (le_max_right N 12).trans hlarge
  have hq : 3 ≤ q := by omega
  rw [regret_eq_wrong_probability]
  apply (BadEvent50.rawBadEvent_even_probability_lower T q hT hq).trans
  refine measureReal_mono ?_ (measure_ne_top _ _)
  intro ω hω
  exact even_rawBadEvent_wrong N hN T q ((le_max_left N 12).trans hlarge) hT hq ω hω

/-- The complete main lower bound, valid for every sufficiently large natural
budget, not only an odd subsequence. There are no stochastic or policy premises. -/
theorem main_polynomial_lower_bound :
    ∃ N : ℕ, ∀ T : ℕ, N ≤ T →
      (BadEvent.underestimationConstant / 64) * Rates.invPower 1356 T ≤ regret T := by
  obtain ⟨No, ho⟩ := odd_main_polynomial_lower_bound
  obtain ⟨Ne, he⟩ := even_main_polynomial_lower_bound
  refine ⟨max No Ne, ?_⟩
  intro T hT
  have hmod := Nat.mod_lt T (by norm_num : 0 < 2)
  have hdiv := Nat.mod_add_div T 2
  have hparity : T = 2 * (T / 2) ∨ T = 2 * (T / 2) + 1 := by omega
  rcases hparity with hEven | hOdd
  · exact he T (T / 2) ((le_max_right No Ne).trans hT) hEven
  · exact ho T (T / 2) ((le_max_left No Ne).trans hT) hOdd

/-- A concrete witness for the paper's main polynomial-regret assertion:
three arms, true means (0,0,1), and positive exponent C=1356. -/
theorem main_theorem :
    ∃ C : ℕ, 0 < C ∧ Rates.invPower C =O[atTop] regret := by
  refine ⟨1356, by norm_num, ?_⟩
  obtain ⟨N, hN⟩ := main_polynomial_lower_bound
  apply Rates.omega_of_eventual_lower_bound
    (div_pos BadEvent.underestimationConstant_positive (by norm_num : (0 : ℝ) < 64))
  exact Filter.eventually_atTop.mpr ⟨N, hN⟩

/-- The same defined Bellman algorithm is posterior Bayes optimal and has the
proved frequentist polynomial lower bound. The only strategy qualification is
the integrability required for its expected regret to be defined. -/
theorem end_to_end_certificate :
    (∀ (k : ℕ) (c : BayesianModel.Counts) (m : Means), (∀ i, 0 < c i) →
      ∀ s : Optimality.Strategy k, Optimality.Admissible s c m →
        Optimality.expectedRegret (Optimality.optimal k c m) c m ≤
          Optimality.expectedRegret s c m) ∧
    (∃ C : ℕ, 0 < C ∧ Rates.invPower C =O[atTop] regret) := by
  exact ⟨fun _ _ _ hc s hs => Optimality.bayes_optimal s _ _ hc hs, main_theorem⟩

end

end BayesOptimal.Foundations.MainTheorem

end

