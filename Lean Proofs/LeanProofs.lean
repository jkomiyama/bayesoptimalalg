/-! ## Foundations.TerminalDrift -/
section

namespace BayesOptimal.Foundations.TerminalDrift

open BayesOptimal.Foundations.Counts BayesOptimal.Foundations.Drift BayesOptimal.Foundations.Gaussian BayesOptimal.Foundations.TerminalBounds
open scoped BigOperators NNReal

noncomputable section

theorem terminal_anchorSum_le_updateVariance (q : ℕ) (c : Counts)
    (hq : 2 ≤ q) (h1 : c.n1 ≤ q) (h2 : c.n2 ≤ q)
    (hs : c.n1 + c.n2 = 2 * q - 1) :
    reciprocalSqSum c.n1 q + reciprocalSqSum c.n2 q ≤
      6 * (updateVariance (q : ℝ≥0) : ℝ) := by
  have hqr : 2 ≤ (q : ℝ) := by exact_mod_cast hq
  have hqp : 0 < (q : ℝ) := by linarith
  have hqsp : 0 < (q : ℝ) - 1 := by linarith
  have hq0 : (q : ℝ) ≠ 0 := by linarith
  have hqsub0 : (q : ℝ) - 1 ≠ 0 := by linarith
  have hqadd0 : (q : ℝ) + 1 ≠ 0 := by linarith
  have hqsub : ((q - 1 : ℕ) : ℝ) = (q : ℝ) - 1 := by
    simp only [Nat.cast_sub (show 1 ≤ q by omega), Nat.cast_one]
  have hVar : (updateVariance (q : ℝ≥0) : ℝ) =
      1 / ((q : ℝ) * ((q : ℝ) + 1)) := by
    simp only [updateVariance, NNReal.coe_inv, NNReal.coe_mul, NNReal.coe_add,
      NNReal.coe_natCast, NNReal.coe_one, one_div]
  have hdiff : 1 / ((q : ℝ) - 1) - 1 / (q : ℝ) =
      1 / ((q : ℝ) * ((q : ℝ) - 1)) := by
    field_simp
    ring
  have hratio : 2 * (1 / ((q : ℝ) - 1) - 1 / (q : ℝ)) ≤
      6 * (updateVariance (q : ℝ≥0) : ℝ) := by
    calc
      _ = 2 / ((q : ℝ) * ((q : ℝ) - 1)) := by rw [hdiff]; ring
      _ ≤ 6 / ((q : ℝ) * ((q : ℝ) + 1)) := by
        apply (div_le_div_iff₀ (by positivity) (by positivity)).mpr
        nlinarith
      _ = 6 * (updateVariance (q : ℝ≥0) : ℝ) := by rw [hVar]; ring
  have hbound := reciprocalSqSum_bound (q - 1) q (by omega) (by omega)
  rw [hqsub] at hbound
  have hc : (c.n1 = q ∧ c.n2 = q - 1) ∨ (c.n1 = q - 1 ∧ c.n2 = q) := by omega
  rcases hc with ⟨hc1, hc2⟩ | ⟨hc1, hc2⟩
  · rw [hc1, hc2]
    simpa only [reciprocalSqSum, Finset.Ico_self, Finset.sum_empty, zero_add] using hbound.trans hratio
  · rw [hc1, hc2]
    simpa only [reciprocalSqSum, Finset.Ico_self, Finset.sum_empty, add_zero] using hbound.trans hratio

/-- Terminal replacement for the drift-to-variance estimate: the terminal
forecast variance is zero, but the sampled-arm innovation variance remains
positive and controls the full W-event drift. -/
theorem terminal_fullW_drift_bound (T q : ℕ) (CU : ℝ) (p : MeanPath) (c : Counts)
    (hT : T = 2 * q + 1) (hT5 : 5 ≤ T)
    (hc : horizonConsistent T c) (hW : paperW T q CU p c) :
    (terminalGap p c) ^ 2 ≤
      204 * Real.log (T : ℝ) * (updateVariance (q : ℝ≥0) : ℝ) := by
  rcases hc with ⟨hc1, hc2, hc3, htotal⟩
  rcases hW with ⟨_, hY1, hY2, hZ1, hZ2, h1, h2, _⟩
  have hq : 2 ≤ q := by omega
  have hsum : c.n1 + c.n2 = 2 * q - 1 := by omega
  have hlog := log_horizon_ge_one T hT5
  have hlog0 : 0 ≤ Real.log (T : ℝ) := by linarith
  have hS1 := reciprocalSqSum_nonnegative c.n1 q
  have hS2 := reciprocalSqSum_nonnegative c.n2 q
  have hSsum := terminal_anchorSum_le_updateVariance q c hq h1 h2 hsum
  have hZ1' := hZ1 c.n1 hc1 h1
  have hZ2' := hZ2 c.n2 hc2 h2
  have hanchors : |p 1 q - p 2 q| ≤ 2 / (T : ℝ) ^ 2 := by
    have htri := abs_sub (p 1 q) (p 2 q)
    unfold eventY at hY1 hY2
    calc
      _ ≤ |p 1 q| + |p 2 q| := htri
      _ ≤ 1 / (T : ℝ) ^ 2 + 1 / (T : ℝ) ^ 2 := add_le_add hY1 hY2
      _ = _ := by ring
  have htri1 := abs_sub_le (p 1 c.n1) (p 1 q) (p 2 c.n2)
  have htri2 := abs_sub_le (p 1 q) (p 2 q) (p 2 c.n2)
  rw [abs_sub_comm (p 2 q) (p 2 c.n2)] at htri2
  let A : ℝ := 4 * Real.sqrt (Real.log (T : ℝ)) * Real.sqrt (reciprocalSqSum c.n1 q)
  let B : ℝ := 4 * Real.sqrt (Real.log (T : ℝ)) * Real.sqrt (reciprocalSqSum c.n2 q)
  let C : ℝ := 2 / (T : ℝ) ^ 2
  have hA0 : 0 ≤ A := by dsimp [A]; positivity
  have hB0 : 0 ≤ B := by dsimp [B]; positivity
  have hC0 : 0 ≤ C := by dsimp [C]; positivity
  have habs : |terminalGap p c| ≤ A + B + C := by
    dsimp [A, B, C]
    unfold terminalGap
    linarith only [htri1, htri2, hanchors, hZ1', hZ2']
  have hsq : (terminalGap p c) ^ 2 ≤ (A + B + C) ^ 2 := by
    simpa only [sq_abs] using
      (sq_le_sq₀ (abs_nonneg (terminalGap p c)) (by positivity)).mpr habs
  have hcq : c.n1 = q ∨ c.n2 = q := by omega
  have hAB : A * B = 0 := by
    rcases hcq with hq1 | hq2
    · simp [A, hq1, reciprocalSqSum]
    · simp [B, hq2, reciprocalSqSum]
  have htwo : (A + B + C) ^ 2 ≤ 2 * (A ^ 2 + B ^ 2 + C ^ 2) := by
    nlinarith [sq_nonneg (A + B - C)]
  have hAsq : A ^ 2 = 16 * Real.log (T : ℝ) * reciprocalSqSum c.n1 q := by
    dsimp [A]
    rw [mul_pow, mul_pow, Real.sq_sqrt hlog0, Real.sq_sqrt hS1]
    norm_num
  have hBsq : B ^ 2 = 16 * Real.log (T : ℝ) * reciprocalSqSum c.n2 q := by
    dsimp [B]
    rw [mul_pow, mul_pow, Real.sq_sqrt hlog0, Real.sq_sqrt hS2]
    norm_num
  have hCsq : C ^ 2 = 4 / (T : ℝ) ^ 4 := by
    dsimp [C]
    rw [div_pow, ← pow_mul]
    norm_num
  have hSscaled := mul_le_mul_of_nonneg_left hSsum hlog0
  have hTreal : 5 ≤ (T : ℝ) := by exact_mod_cast hT5
  have hinv : 1 / (T : ℝ) ^ 4 ≤ 1 / (T : ℝ) ^ 2 := by
    apply (div_le_div_iff₀ (by positivity) (by positivity)).mpr
    nlinarith [sq_nonneg ((T : ℝ) ^ 2 - 1)]
  have hcount := updateVariance_count_bounds q T (by omega) (by omega)
  have hcountLower : 1 / (T : ℝ) ^ 2 ≤ (updateVariance (q : ℝ≥0) : ℝ) := by
    simpa only [BayesOptimal.Foundations.Rates.invPower, inv_eq_one_div] using hcount.1
  have hv0 : 0 ≤ (updateVariance (q : ℝ≥0) : ℝ) := (updateVariance (q : ℝ≥0)).property
  have hVscaled : (updateVariance (q : ℝ≥0) : ℝ) ≤
      Real.log (T : ℝ) * (updateVariance (q : ℝ≥0) : ℝ) := by
    simpa using mul_le_mul_of_nonneg_right hlog hv0
  have hinvFinal : 1 / (T : ℝ) ^ 4 ≤
      Real.log (T : ℝ) * (updateVariance (q : ℝ≥0) : ℝ) :=
    hinv.trans (hcountLower.trans hVscaled)
  have hinvScaled : 4 / (T : ℝ) ^ 4 ≤
      4 * (Real.log (T : ℝ) * (updateVariance (q : ℝ≥0) : ℝ)) := by
    calc
      _ = 4 * (1 / (T : ℝ) ^ 4) := by ring
      _ ≤ _ := mul_le_mul_of_nonneg_left hinvFinal (by norm_num)
  rw [hAsq, hBsq, hCsq] at htwo
  nlinarith only [hsq, htwo, hSscaled, hinvScaled, mul_nonneg hlog0 hv0]

end

end BayesOptimal.Foundations.TerminalDrift

end

/-! ## Foundations.DynamicPolicy -/
section

open MeasureTheory ProbabilityTheory
open Filter Asymptotics
open scoped NNReal ENNReal

namespace BayesOptimal.Foundations.DynamicPolicy

open BayesOptimal.Foundations.Counts BayesOptimal.Foundations.Drift BayesOptimal.Foundations.Gaussian BayesOptimal.Foundations.Rates
open BayesOptimal.Foundations.TerminalBounds BayesOptimal.Foundations.PredictiveBound BayesOptimal.Foundations.PredictiveLaw
open BayesOptimal.Foundations.DynamicGain

noncomputable section

def modelCounts (c : Counts) : BayesOptimal.Foundations.BayesianModel.Counts :=
  fun i => if i = 0 then c.n1 else if i = 1 then c.n2 else c.n3

def modelMeans (p : MeanPath) (c : Counts) : BayesOptimal.Foundations.BayesianModel.Means :=
  fun i => if i = 0 then p 1 c.n1 else if i = 1 then p 2 c.n2 else p 3 c.n3

def decision (T t : ℕ) (p : MeanPath) (c : Counts) : BayesOptimal.Foundations.BayesianModel.Arm :=
  BayesOptimal.Foundations.BayesianModel.choose (T - t) (modelCounts c) (modelMeans p c)

def admissible (q : ℕ) (c : Counts) (a : BayesOptimal.Foundations.BayesianModel.Arm) : Prop :=
  a ≠ 2 ∧ (a = 0 → c.n1 < q) ∧ (a = 1 → c.n2 < q)

def gainCoefficient : ℝ := min (gainConstant * lowerConstant) lowerConstant
def comparisonCoefficient : ℝ := min (comparisonConstant * lowerConstant) (lowerConstant / 2)

theorem gainCoefficient_pos : 0 < gainCoefficient := by
  exact lt_min (mul_pos gainConstant_positive lowerConstant_pos) lowerConstant_pos

theorem comparisonCoefficient_pos : 0 < comparisonCoefficient := by
  exact lt_min (mul_pos comparisonConstant_positive lowerConstant_pos) (half_pos lowerConstant_pos)

theorem modelCounts_positive (t : ℕ) (c : Counts) (hc : horizonConsistent t c) :
    ∀ i, 0 < modelCounts c i := by
  intro i
  have h1 := hc.1
  have h2 := hc.2.1
  have h3 := hc.2.2.1
  unfold modelCounts
  split_ifs <;> omega

theorem twoValue_model (k : ℕ) (p : MeanPath) (c : Counts) :
    BayesOptimal.Foundations.ThreeArmComparison.twoValue k (modelCounts c) (modelMeans p c) =
      BayesOptimal.Foundations.TwoArmBellman.payoff k (p 1 c.n1) (p 2 c.n2) c := by
  simp only [BayesOptimal.Foundations.ThreeArmComparison.twoValue, BayesOptimal.Foundations.ThreeArmComparison.projectCounts,
    modelMeans, modelCounts]
  norm_num
  cases c with
  | mk n1 n2 n3 => exact BayesOptimal.Foundations.TwoArmBellman.payoff_third_irrelevant k _ _ n1 n2 0 n3

theorem twoAction_model_zero (k : ℕ) (p : MeanPath) (c : Counts) :
    BayesOptimal.Foundations.ThreeArmComparison.twoAction k (modelCounts c) (modelMeans p c) 0 =
      BayesOptimal.Foundations.TwoArmBellman.leftAction k (p 1 c.n1) (p 2 c.n2) c := by
  rw [BayesOptimal.Foundations.ThreeArmComparison.twoAction_zero]
  simp only [BayesOptimal.Foundations.ThreeArmComparison.projectCounts, modelMeans, modelCounts]
  norm_num
  unfold BayesOptimal.Foundations.TwoArmBellman.leftAction
  congr 1
  funext z
  cases c with
  | mk n1 n2 n3 => exact BayesOptimal.Foundations.TwoArmBellman.payoff_third_irrelevant k _ _ (n1 + 1) n2 0 n3

theorem twoAction_model_one (k : ℕ) (p : MeanPath) (c : Counts) :
    BayesOptimal.Foundations.ThreeArmComparison.twoAction k (modelCounts c) (modelMeans p c) 1 =
      BayesOptimal.Foundations.TwoArmBellman.rightAction k (p 1 c.n1) (p 2 c.n2) c := by
  rw [BayesOptimal.Foundations.ThreeArmComparison.twoAction_one]
  simp only [BayesOptimal.Foundations.ThreeArmComparison.projectCounts, modelMeans, modelCounts]
  norm_num
  unfold BayesOptimal.Foundations.TwoArmBellman.rightAction
  congr 1
  funext z
  cases c with
  | mk n1 n2 n3 => exact BayesOptimal.Foundations.TwoArmBellman.payoff_third_irrelevant k _ _ n1 (n2 + 1) 0 n3

theorem slack_bad_state_upper (T q t : ℕ) (p : MeanPath) (c : Counts)
    (hT : 5 ≤ T) (hc : horizonConsistent t c) (hW : paperW T q 40 p c) :
    BayesOptimal.Foundations.ThreeArmComparison.stateSlack (modelCounts c) (modelMeans p c) ≤
      2 * invPower 225 T := by
  have hv : (posteriorVariance (c.n1 : ℝ≥0) (c.n3 : ℝ≥0) : ℝ) ≤ 2 := by
    rw [hc.2.2.1]
    simp only [posteriorVariance, NNReal.coe_add, NNReal.coe_inv, NNReal.coe_natCast,
      ]
    have hn : (1 : ℝ) ≤ c.n1 := by exact_mod_cast hc.1
    have hsmall : (c.n1 : ℝ)⁻¹ ≤ 1 := inv_le_one_of_one_le₀ hn
    linarith
  have he : BayesOptimal.Foundations.ThreeArmComparison.stateSlack (modelCounts c) (modelMeans p c) =
      hingeLoss (p 1 c.n1 - p 3 1) (posteriorVariance (c.n1 : ℝ≥0) (c.n3 : ℝ≥0)) := by
    simp [BayesOptimal.Foundations.ThreeArmComparison.stateSlack, BayesOptimal.Foundations.ThreeArmComparison.slack,
      modelCounts, modelMeans, hc.2.2.1]
  rw [he]
  exact BayesOptimal.Foundations.GaussianTail.bad_state_tail T q c.n1 p hT hc.1 hW.2.2.2.2.2.1
    hW.1 hW.2.1 hW.2.2.2.1 _ hv

theorem forecast_parameters (T q t : ℕ) (p : MeanPath) (c : Counts)
    (hT : T = 2 * q + 1) (ht : 4 ≤ t) (hpre : t < T)
    (hc : horizonConsistent t c) (hW : paperW T q 40 p c) :
    0 < accumulatedVariance (T - t) c ∧
      (accumulatedVariance (T - t) c : ℝ) ≤ 2 ∧
      invPower 2 T ≤ (accumulatedVariance (T - t) c : ℝ) ∧
      (terminalGap p c) ^ 2 ≤ 204 * Real.log (T : ℝ) *
        (accumulatedVariance (T - t) c : ℝ) := by
  have h1 : 0 < c.n1 := by have := hc.1; omega
  have h2 : 0 < c.n2 := by have := hc.2.1; omega
  have hV := accumulatedVariance_coe (T - t) c h1 h2
  have hv : 0 < accumulatedVariance (T - t) c := by
    change (0 : ℝ) < (accumulatedVariance (T - t) c : ℝ)
    rw [hV]
    exact transitionVariance_positive (T - t) c (by omega) h1 h2
  have hu : (accumulatedVariance (T - t) c : ℝ) ≤ 2 := by
    rw [hV]; exact transitionVariance_le_two _ _ hc.1 hc.2.1
  have hl : invPower 2 T ≤ (accumulatedVariance (T - t) c : ℝ) := by
    rw [invPower, inv_eq_one_div, hV]
    exact lemma17_nonterminal_variance_bound T q t c hT (by omega) ht hpre hc
      hW.2.2.2.2.2.1 hW.2.2.2.2.2.2.1
  have hd : (terminalGap p c) ^ 2 ≤ 204 * Real.log (T : ℝ) *
      (accumulatedVariance (T - t) c : ℝ) := by
    rw [hV]; exact lemma17_fullW_drift_bound T q t 40 p c hT ht hpre hc hW
  exact ⟨hv, hu, hl, hd⟩

theorem nonterminal_horizon_gain (T q t : ℕ) (p : MeanPath) (c : Counts)
    (hT : T = 2 * q + 1) (ht : 4 ≤ t) (hpre : t < T)
    (hc : horizonConsistent t c) (hW : paperW T q 40 p c) :
    gainCoefficient * invPower 212 T ≤
      BayesOptimal.Foundations.TwoArmBellman.payoff (T - t + 1) (p 1 c.n1) (p 2 c.n2) c -
      BayesOptimal.Foundations.TwoArmBellman.payoff (T - t) (p 1 c.n1) (p 2 c.n2) c := by
  have hpar := forecast_parameters T q t p c hT ht hpre hc hW
  have h1 : 0 < c.n1 := by have := hc.1; omega
  have h2 : 0 < c.n2 := by have := hc.2.1; omega
  have hs : c.n1 + c.n2 + (T - t) = 2 * q - 1 := by
    rcases hc with ⟨_, _, h3, htotal⟩; omega
  rw [BayesOptimal.Foundations.TwoArmGain.payoff_horizon_gain_preterminal q (T - t) _ _ c (by omega)
    h1 h2 hW.2.2.2.2.2.1 hW.2.2.2.2.2.2.1 hs,
    balancedPredictiveLaw_gaussian]
  exact (mul_le_mul_of_nonneg_right (min_le_left _ _) (invPower_nonneg 212 T)).trans
    (nonterminal_hinge_gain_lower T (q - 1) (terminalGap p c) _ (by omega) (by omega)
      (by omega) hpar.1 hpar.2.1 hpar.2.2.1 hpar.2.2.2)

theorem nonterminal_left_gap (T q t : ℕ) (p : MeanPath) (c : Counts)
    (hT : T = 2 * q + 1) (ht : 4 ≤ t) (hpre : t < T)
    (hc : horizonConsistent t c) (hW : paperW T q 40 p c) (hsat : c.n1 = q) :
    comparisonCoefficient * invPower 214 T ≤
      BayesOptimal.Foundations.TwoArmBellman.payoff (T - t + 1) (p 1 c.n1) (p 2 c.n2) c -
      BayesOptimal.Foundations.TwoArmBellman.leftAction (T - t) (p 1 c.n1) (p 2 c.n2) c := by
  have hpar := forecast_parameters T q t p c hT ht hpre hc hW
  have h1 : 0 < c.n1 := by have := hc.1; omega
  have h2 : 0 < c.n2 := by have := hc.2.1; omega
  have hs : c.n1 + c.n2 + (T - t) = 2 * q - 1 := by
    rcases hc with ⟨_, _, h3, htotal⟩; omega
  rw [BayesOptimal.Foundations.TwoArmGain.saturated_left_gap_preterminal q (T - t) _ _ c (by omega)
    h1 h2 hsat hs, balancedPredictiveLaw_gaussian]
  exact (mul_le_mul_of_nonneg_right (min_le_left _ _) (invPower_nonneg 214 T)).trans
    (nonterminal_hinge_difference_lower T q (q - 1) (terminalGap p c) _ (by omega)
      (by omega) (by omega) (by omega) hpar.1 hpar.2.1 hpar.2.2.1 hpar.2.2.2)

theorem nonterminal_right_gap (T q t : ℕ) (p : MeanPath) (c : Counts)
    (hT : T = 2 * q + 1) (ht : 4 ≤ t) (hpre : t < T)
    (hc : horizonConsistent t c) (hW : paperW T q 40 p c) (hsat : c.n2 = q) :
    comparisonCoefficient * invPower 214 T ≤
      BayesOptimal.Foundations.TwoArmBellman.payoff (T - t + 1) (p 1 c.n1) (p 2 c.n2) c -
      BayesOptimal.Foundations.TwoArmBellman.rightAction (T - t) (p 1 c.n1) (p 2 c.n2) c := by
  have hpar := forecast_parameters T q t p c hT ht hpre hc hW
  have h1 : 0 < c.n1 := by have := hc.1; omega
  have h2 : 0 < c.n2 := by have := hc.2.1; omega
  have hs : c.n1 + c.n2 + (T - t) = 2 * q - 1 := by
    rcases hc with ⟨_, _, h3, htotal⟩; omega
  rw [BayesOptimal.Foundations.TwoArmGain.saturated_right_gap_preterminal q (T - t) _ _ c (by omega)
    h1 h2 hsat hs, balancedPredictiveLaw_gaussian]
  exact (mul_le_mul_of_nonneg_right (min_le_left _ _) (invPower_nonneg 214 T)).trans
    (nonterminal_hinge_difference_lower T q (q - 1) (terminalGap p c) _ (by omega)
      (by omega) (by omega) (by omega) hpar.1 hpar.2.1 hpar.2.2.1 hpar.2.2.2)

theorem terminal_horizon_gain (T q : ℕ) (p : MeanPath) (c : Counts)
    (hT : T = 2 * q + 1) (hT5 : 5 ≤ T)
    (hc : horizonConsistent T c) (hW : paperW T q 40 p c) :
    gainCoefficient * invPower 212 T ≤
      BayesOptimal.Foundations.TwoArmBellman.payoff 1 (p 1 c.n1) (p 2 c.n2) c -
      BayesOptimal.Foundations.TwoArmBellman.payoff 0 (p 1 c.n1) (p 2 c.n2) c := by
  have h1 : 0 < c.n1 := by have := hc.1; omega
  have h2 : 0 < c.n2 := by have := hc.2.1; omega
  have hq : 2 ≤ q := by omega
  have hs : c.n1 + c.n2 + 0 = 2 * q - 1 := by
    rcases hc with ⟨_, _, h3, htotal⟩; omega
  have hd := BayesOptimal.Foundations.TerminalDrift.terminal_fullW_drift_bound T q 40 p c hT hT5 hc hW
  have hb := updateVariance_count_bounds q T (by omega) (by omega)
  have hv : 0 < updateVariance (q : ℝ≥0) := by unfold updateVariance; positivity
  have hlower := terminal_hinge_gain_lower T (terminalGap p c) _ hT5 hv
    (by linarith only [hb.2]) hb.1 hd
  have hcount : (0 : ℝ≥0) < (q - 1 : ℕ) := by exact_mod_cast (show 0 < q - 1 by omega)
  have hvar := updateVariance_strictAntitone ((q - 1 : ℕ) : ℝ≥0) (q : ℝ≥0)
    hcount (by exact_mod_cast (show q - 1 < q by omega))
  have hmono := hingeLoss_strictMono_variance |terminalGap p c| (abs_nonneg _)
    (updateVariance (q : ℝ≥0)) (updateVariance ((q - 1 : ℕ) : ℝ≥0)) hvar
  rw [BayesOptimal.Foundations.TwoArmGain.payoff_horizon_gain_preterminal q 0 _ _ c (by omega)
    h1 h2 hW.2.2.2.2.2.1 hW.2.2.2.2.2.2.1 hs, balancedPredictiveLaw_terminal,
    integral_dirac]
  exact (mul_le_mul (min_le_right _ _) (invPower_antitone (by omega : 208 ≤ 212) (by omega))
    (invPower_nonneg 212 T) lowerConstant_pos.le).trans (hlower.trans hmono.le)

theorem terminal_left_gap (T q : ℕ) (p : MeanPath) (c : Counts)
    (hT : T = 2 * q + 1) (hT5 : 5 ≤ T)
    (hc : horizonConsistent T c) (hW : paperW T q 40 p c) (hsat : c.n1 = q) :
    comparisonCoefficient * invPower 214 T ≤
      BayesOptimal.Foundations.TwoArmBellman.payoff 1 (p 1 c.n1) (p 2 c.n2) c -
      BayesOptimal.Foundations.TwoArmBellman.leftAction 0 (p 1 c.n1) (p 2 c.n2) c := by
  have h1 : 0 < c.n1 := by have := hc.1; omega
  have h2 : 0 < c.n2 := by have := hc.2.1; omega
  have hq : 2 ≤ q := by omega
  have hs : c.n1 + c.n2 + 0 = 2 * q - 1 := by
    rcases hc with ⟨_, _, h3, htotal⟩; omega
  have hd := BayesOptimal.Foundations.TerminalDrift.terminal_fullW_drift_bound T q 40 p c hT hT5 hc hW
  have hlower := terminal_hinge_difference_lower T q (q - 1) (terminalGap p c)
    hT5 (by omega) (by omega) (by omega) hd
  rw [BayesOptimal.Foundations.TwoArmGain.saturated_left_gap_preterminal q 0 _ _ c (by omega)
    h1 h2 hsat hs, balancedPredictiveLaw_terminal, integral_dirac]
  exact (mul_le_mul (min_le_right _ _) (invPower_antitone (by omega : 211 ≤ 214) (by omega))
    (invPower_nonneg 214 T) (half_pos lowerConstant_pos).le).trans hlower

theorem terminal_right_gap (T q : ℕ) (p : MeanPath) (c : Counts)
    (hT : T = 2 * q + 1) (hT5 : 5 ≤ T)
    (hc : horizonConsistent T c) (hW : paperW T q 40 p c) (hsat : c.n2 = q) :
    comparisonCoefficient * invPower 214 T ≤
      BayesOptimal.Foundations.TwoArmBellman.payoff 1 (p 1 c.n1) (p 2 c.n2) c -
      BayesOptimal.Foundations.TwoArmBellman.rightAction 0 (p 1 c.n1) (p 2 c.n2) c := by
  have h1 : 0 < c.n1 := by have := hc.1; omega
  have h2 : 0 < c.n2 := by have := hc.2.1; omega
  have hq : 2 ≤ q := by omega
  have hs : c.n1 + c.n2 + 0 = 2 * q - 1 := by
    rcases hc with ⟨_, _, h3, htotal⟩; omega
  have hd := BayesOptimal.Foundations.TerminalDrift.terminal_fullW_drift_bound T q 40 p c hT hT5 hc hW
  have hlower := terminal_hinge_difference_lower T q (q - 1) (terminalGap p c)
    hT5 (by omega) (by omega) (by omega) hd
  rw [BayesOptimal.Foundations.TwoArmGain.saturated_right_gap_preterminal q 0 _ _ c (by omega)
    h1 h2 hsat hs, balancedPredictiveLaw_terminal, integral_dirac]
  exact (mul_le_mul (min_le_right _ _) (invPower_antitone (by omega : 211 ≤ 214) (by omega))
    (invPower_nonneg 214 T) (half_pos lowerConstant_pos).le).trans hlower

theorem all_round_horizon_gain (T q t : ℕ) (p : MeanPath) (c : Counts)
    (hT : T = 2 * q + 1) (hT5 : 5 ≤ T) (ht : 4 ≤ t) (horizon : t ≤ T)
    (hc : horizonConsistent t c) (hW : paperW T q 40 p c) :
    gainCoefficient * invPower 212 T ≤
      BayesOptimal.Foundations.TwoArmBellman.payoff (T - t + 1) (p 1 c.n1) (p 2 c.n2) c -
      BayesOptimal.Foundations.TwoArmBellman.payoff (T - t) (p 1 c.n1) (p 2 c.n2) c := by
  by_cases hpre : t < T
  · exact nonterminal_horizon_gain T q t p c hT ht hpre hc hW
  · have heq : t = T := by omega
    subst t
    simpa only [Nat.sub_self, zero_add] using terminal_horizon_gain T q p c hT hT5 hc hW

theorem all_round_left_gap (T q t : ℕ) (p : MeanPath) (c : Counts)
    (hT : T = 2 * q + 1) (hT5 : 5 ≤ T) (ht : 4 ≤ t) (horizon : t ≤ T)
    (hc : horizonConsistent t c) (hW : paperW T q 40 p c) (hsat : c.n1 = q) :
    comparisonCoefficient * invPower 214 T ≤
      BayesOptimal.Foundations.TwoArmBellman.payoff (T - t + 1) (p 1 c.n1) (p 2 c.n2) c -
      BayesOptimal.Foundations.TwoArmBellman.leftAction (T - t) (p 1 c.n1) (p 2 c.n2) c := by
  by_cases hpre : t < T
  · exact nonterminal_left_gap T q t p c hT ht hpre hc hW hsat
  · have heq : t = T := by omega
    subst t
    simpa only [Nat.sub_self, zero_add] using terminal_left_gap T q p c hT hT5 hc hW hsat

theorem all_round_right_gap (T q t : ℕ) (p : MeanPath) (c : Counts)
    (hT : T = 2 * q + 1) (hT5 : 5 ≤ T) (ht : 4 ≤ t) (horizon : t ≤ T)
    (hc : horizonConsistent t c) (hW : paperW T q 40 p c) (hsat : c.n2 = q) :
    comparisonCoefficient * invPower 214 T ≤
      BayesOptimal.Foundations.TwoArmBellman.payoff (T - t + 1) (p 1 c.n1) (p 2 c.n2) c -
      BayesOptimal.Foundations.TwoArmBellman.rightAction (T - t) (p 1 c.n1) (p 2 c.n2) c := by
  by_cases hpre : t < T
  · exact nonterminal_right_gap T q t p c hT ht hpre hc hW hsat
  · have heq : t = T := by omega
    subst t
    simpa only [Nat.sub_self, zero_add] using terminal_right_gap T q p c hT hT5 hc hW hsat

/-- A single budget threshold controls all W states and all decision rounds, including T. -/
theorem eventually_all_W_admissible :
    ∃ T0 : ℕ, ∀ T : ℕ, T0 ≤ T → ∀ (q t : ℕ) (p : MeanPath) (c : Counts),
      T = 2 * q + 1 → 4 ≤ t → t ≤ T → horizonConsistent t c →
      paperW T q 40 p c → admissible q c (decision T t p c) := by
  have herr : (fun T => 2 * invPower 225 T) =O[atTop] invPower 225 :=
    (isBigO_refl (invPower 225) atTop).const_mul_left 2
  have hg := eventual_subtraction_positive gainCoefficient_pos (by norm_num : (0 : ℝ) < 1)
    (by omega : 212 < 225) herr (Filter.Eventually.of_forall (fun T => le_rfl))
  have hb := eventual_subtraction_positive comparisonCoefficient_pos (by norm_num : (0 : ℝ) < 1)
    (by omega : 214 < 225) herr (Filter.Eventually.of_forall (fun T => le_rfl))
  obtain ⟨T0, hT0⟩ := Filter.eventually_atTop.mp
    (hg.and (hb.and (eventually_ge_atTop (5 : ℕ))))
  refine ⟨T0, ?_⟩
  intro T hlarge q t p c hT ht horizon hc hW
  have hbudget := hT0 T hlarge
  have hT5 : 5 ≤ T := hbudget.2.2
  have hslack := slack_bad_state_upper T q t p c hT5 hc hW
  have hpositive := modelCounts_positive t c hc
  have hgain := all_round_horizon_gain T q t p c hT hT5 ht horizon hc hW
  have hgainGap : BayesOptimal.Foundations.ThreeArmComparison.stateSlack (modelCounts c) (modelMeans p c) <
      BayesOptimal.Foundations.ThreeArmComparison.twoValue (T - t + 1) (modelCounts c) (modelMeans p c) -
      BayesOptimal.Foundations.ThreeArmComparison.twoValue (T - t) (modelCounts c) (modelMeans p c) := by
    rw [twoValue_model, twoValue_model]
    linarith only [hslack, hgain, hbudget.1]
  have hthird := BayesOptimal.Foundations.ThreeArmComparison.third_never_chosen (T - t)
    (modelCounts c) (modelMeans p c) hpositive hgainGap
  refine ⟨hthird, ?_, ?_⟩
  · intro hchoose
    by_contra hnot
    have hsat : c.n1 = q := by have := hW.2.2.2.2.2.1; omega
    have hbnd := all_round_left_gap T q t p c hT hT5 ht horizon hc hW hsat
    have hgap : BayesOptimal.Foundations.ThreeArmComparison.stateSlack (modelCounts c) (modelMeans p c) <
        BayesOptimal.Foundations.ThreeArmComparison.twoValue (T - t + 1) (modelCounts c) (modelMeans p c) -
        BayesOptimal.Foundations.ThreeArmComparison.twoAction (T - t) (modelCounts c) (modelMeans p c) 0 := by
      rw [twoValue_model, twoAction_model_zero]
      linarith only [hslack, hbnd, hbudget.2.1]
    exact BayesOptimal.Foundations.ThreeArmComparison.deficient_action_never_chosen (T - t)
      (modelCounts c) (modelMeans p c) 0 hpositive hgap hchoose
  · intro hchoose
    by_contra hnot
    have hsat : c.n2 = q := by have := hW.2.2.2.2.2.2.1; omega
    have hbnd := all_round_right_gap T q t p c hT hT5 ht horizon hc hW hsat
    have hgap : BayesOptimal.Foundations.ThreeArmComparison.stateSlack (modelCounts c) (modelMeans p c) <
        BayesOptimal.Foundations.ThreeArmComparison.twoValue (T - t + 1) (modelCounts c) (modelMeans p c) -
        BayesOptimal.Foundations.ThreeArmComparison.twoAction (T - t) (modelCounts c) (modelMeans p c) 1 := by
      rw [twoValue_model, twoAction_model_one]
      linarith only [hslack, hbnd, hbudget.2.1]
    exact BayesOptimal.Foundations.ThreeArmComparison.deficient_action_never_chosen (T - t)
      (modelCounts c) (modelMeans p c) 1 hpositive hgap hchoose

end

end BayesOptimal.Foundations.DynamicPolicy

end

/-! ## Foundations.EvenCounts -/
section

open MeasureTheory ProbabilityTheory Set
open scoped MeasureTheory NNReal ENNReal

namespace BayesOptimal.Foundations.EvenCounts

open BayesOptimal.Foundations.Counts BayesOptimal.Foundations.Drift BayesOptimal.Foundations.Gaussian BayesOptimal.Foundations.TwoArmBellman BayesOptimal.Foundations.TwoArmGain

noncomputable section

/-- Even budgets have two fewer arm-1/2 samples before the terminal draw.
Already saturated arms keep q observations; otherwise both reach q-1. -/
theorem even_prefix_counts (q k : ℕ) (c : Counts)
    (hq : 2 ≤ q) (h1 : c.n1 ≤ q) (h2 : c.n2 ≤ q)
    (hs : c.n1 + c.n2 + k = 2 * q - 2) :
    (balancedRun k c).n1 =
      (if c.n1 = q then q else if c.n2 = q then q - 2 else q - 1) ∧
    (balancedRun k c).n2 =
      (if c.n1 = q then q - 2 else if c.n2 = q then q else q - 1) := by
  have hmono := balancedRun_monotone k c
  have hsum := balancedRun_sum k c
  have hmax := balancedRun_max k c
  by_cases hn1 : c.n1 = q
  · simp only [if_pos hn1]
    constructor <;> omega
  · by_cases hn2 : c.n2 = q
    · simp only [if_neg hn1, if_pos hn2]
      constructor <;> omega
    · simp only [if_neg hn1, if_neg hn2]
      constructor <;> omega

theorem even_prefix_caps (q k : ℕ) (c : Counts)
    (hq : 2 ≤ q) (h1 : c.n1 ≤ q) (h2 : c.n2 ≤ q)
    (hs : c.n1 + c.n2 + k = 2 * q - 2) :
    (balancedRun k c).n1 ≤ q ∧ (balancedRun k c).n2 ≤ q := by
  have hc := even_prefix_counts q k c hq h1 h2 hs
  constructor
  · rw [hc.1]; split_ifs <;> omega
  · rw [hc.2]; split_ifs <;> omega

theorem even_transition_residual_lower (q k : ℕ) (c : Counts)
    (hq : 3 ≤ q) (hk : 0 < k) (hc1 : 1 ≤ c.n1) (hc2 : 1 ≤ c.n2)
    (h1 : c.n1 ≤ q) (h2 : c.n2 ≤ q)
    (hs : c.n1 + c.n2 + k = 2 * q - 2) :
    1 / ((q : ℝ) * ((q : ℝ) - 2)) ≤ transitionVariance k c := by
  have hc := even_prefix_counts q k c (by omega) h1 h2 hs
  have hmono := balancedRun_monotone k c
  have hsum := balancedRun_sum k c
  have hprogress : c.n1 < (balancedRun k c).n1 ∨ c.n2 < (balancedRun k c).n2 := by omega
  have hqr : 3 ≤ (q : ℝ) := by exact_mod_cast hq
  have hqp : 0 < (q : ℝ) := by linarith
  have hqsp : 0 < (q : ℝ) - 2 := by linarith
  have hq1p : 0 < (q : ℝ) - 1 := by linarith
  have hq11p : 0 < ((q : ℝ) - 1) - 1 := by linarith
  have hq1 : ((q - 1 : ℕ) : ℝ) = (q : ℝ) - 1 := by
    simp only [Nat.cast_sub (show 1 ≤ q by omega), Nat.cast_one]
  have hcomp : 1 / ((q : ℝ) * ((q : ℝ) - 2)) ≤
      1 / (((q - 1 : ℕ) : ℝ) * (((q - 1 : ℕ) : ℝ) - 1)) := by
    rw [hq1]
    apply (div_le_div_iff₀ (by positivity) (by positivity)).mpr
    nlinarith
  unfold transitionVariance
  rcases hprogress with hp1 | hp2
  · have hb : (balancedRun k c).n1 ≤ q - 1 := by
      rw [hc.1] at *
      split_ifs at * <;> omega
    have hi := inverse_difference_preterminal_lower_bound c.n1 (balancedRun k c).n1
      (q - 1) hc1 hp1 hb
    have hn := inverse_difference_nonnegative c.n2 _ (by omega) hmono.2
    linarith
  · have hb : (balancedRun k c).n2 ≤ q - 1 := by
      rw [hc.2] at *
      split_ifs at * <;> omega
    have hi := inverse_difference_preterminal_lower_bound c.n2 (balancedRun k c).n2
      (q - 1) hc2 hp2 hb
    have hn := inverse_difference_nonnegative c.n1 _ (by omega) hmono.1
    linarith

theorem even_terminal_anchor_residual_upper (q k : ℕ) (c : Counts)
    (hq : 3 ≤ q) (h1 : c.n1 ≤ q) (h2 : c.n2 ≤ q)
    (hs : c.n1 + c.n2 + k = 2 * q - 2) :
    (1 / ((balancedRun k c).n1 : ℝ) - 1 / (q : ℝ)) +
      (1 / ((balancedRun k c).n2 : ℝ) - 1 / (q : ℝ)) ≤
      2 / ((q : ℝ) * ((q : ℝ) - 2)) := by
  have hc := even_prefix_counts q k c (by omega) h1 h2 hs
  have hqr : 3 ≤ (q : ℝ) := by exact_mod_cast hq
  have hqp : 0 < (q : ℝ) := by linarith
  have hq1p : 0 < (q : ℝ) - 1 := by linarith
  have hq2p : 0 < (q : ℝ) - 2 := by linarith
  have hq1 : ((q - 1 : ℕ) : ℝ) = (q : ℝ) - 1 := by
    simp only [Nat.cast_sub (show 1 ≤ q by omega), Nat.cast_one]
  have hq2 : ((q - 2 : ℕ) : ℝ) = (q : ℝ) - 2 := by
    simp only [Nat.cast_sub (show 2 ≤ q by omega), Nat.cast_ofNat]
  have hd1 : 1 / ((q : ℝ) - 1) - 1 / (q : ℝ) =
      1 / ((q : ℝ) * ((q : ℝ) - 1)) := by field_simp; ring
  have hd2 : 1 / ((q : ℝ) - 2) - 1 / (q : ℝ) =
      2 / ((q : ℝ) * ((q : ℝ) - 2)) := by field_simp; ring
  rw [hc.1, hc.2]
  by_cases hn1 : c.n1 = q
  · simp only [if_pos hn1, hq2, sub_self, zero_add, hd2]
    exact le_rfl
  · by_cases hn2 : c.n2 = q
    · simp only [if_neg hn1, if_pos hn2, hq2, sub_self, add_zero, hd2]
      exact le_rfl
    · simp only [if_neg hn1, if_neg hn2, hq1, hd1]
      have hd : 2 / ((q : ℝ) * ((q : ℝ) - 1)) ≤
          2 / ((q : ℝ) * ((q : ℝ) - 2)) := by
        apply (div_le_div_iff₀ (by positivity) (by positivity)).mpr
        nlinarith
      calc
        _ = 2 / ((q : ℝ) * ((q : ℝ) - 1)) := by ring
        _ ≤ _ := hd

theorem even_to_anchor_variance_bound (q k : ℕ) (c : Counts)
    (hq : 3 ≤ q) (hk : 0 < k) (hc1 : 1 ≤ c.n1) (hc2 : 1 ≤ c.n2)
    (h1 : c.n1 ≤ q) (h2 : c.n2 ≤ q)
    (hs : c.n1 + c.n2 + k = 2 * q - 2) :
    (1 / (c.n1 : ℝ) - 1 / (q : ℝ)) +
      (1 / (c.n2 : ℝ) - 1 / (q : ℝ)) ≤ 3 * transitionVariance k c := by
  have hl := even_transition_residual_lower q k c hq hk hc1 hc2 h1 h2 hs
  have hu := even_terminal_anchor_residual_upper q k c hq h1 h2 hs
  have hscale : 2 / ((q : ℝ) * ((q : ℝ) - 2)) ≤ 2 * transitionVariance k c := by
    calc
      _ = 2 * (1 / ((q : ℝ) * ((q : ℝ) - 2))) := by ring
      _ ≤ _ := mul_le_mul_of_nonneg_left hl (by norm_num)
  unfold transitionVariance at *
  linarith

theorem even_balancedInnovation_preterminal (q k : ℕ) (c : Counts)
    (hq : 3 ≤ q) (h1 : c.n1 ≤ q) (h2 : c.n2 ≤ q)
    (hs : c.n1 + c.n2 + k = 2 * q - 2) :
    balancedInnovation (balancedRun k c) =
      if c.n1 = q ∨ c.n2 = q then updateVariance ((q - 2 : ℕ) : ℝ≥0)
      else updateVariance ((q - 1 : ℕ) : ℝ≥0) := by
  have hc := even_prefix_counts q k c (by omega) h1 h2 hs
  unfold balancedInnovation
  rw [hc.1, hc.2]
  by_cases hn1 : c.n1 = q
  · have hsat : c.n1 = q ∨ c.n2 = q := Or.inl hn1
    simp only [if_pos hn1, if_pos hsat]
    rw [if_neg (by omega : ¬ q ≤ q - 2)]
  · by_cases hn2 : c.n2 = q
    · simp only [if_neg hn1, if_pos hn2]
      have hsat : c.n1 = q ∨ c.n2 = q := Or.inr hn2
      rw [if_pos hsat]
      rw [if_pos (by omega : q - 2 ≤ q)]
    · have hsat : ¬ (c.n1 = q ∨ c.n2 = q) := not_or.mpr ⟨hn1, hn2⟩
      simp only [if_neg hn1, if_neg hn2, if_neg hsat, le_refl, if_true]

theorem even_min_count_bounds (q k : ℕ) (c : Counts)
    (hq : 3 ≤ q) (h1 : c.n1 ≤ q) (h2 : c.n2 ≤ q)
    (hs : c.n1 + c.n2 + k = 2 * q - 2) :
    q - 2 ≤ min (balancedRun k c).n1 (balancedRun k c).n2 ∧
      min (balancedRun k c).n1 (balancedRun k c).n2 ≤ q - 1 := by
  have hc := even_prefix_counts q k c (by omega) h1 h2 hs
  rw [hc.1, hc.2]
  split_ifs <;> constructor <;> omega

theorem even_horizon_gain_preterminal (q k : ℕ) (m1 m2 : ℝ) (c : Counts)
    (hq : 3 ≤ q) (hc1 : 0 < c.n1) (hc2 : 0 < c.n2)
    (h1 : c.n1 ≤ q) (h2 : c.n2 ≤ q)
    (hs : c.n1 + c.n2 + k = 2 * q - 2) :
    payoff (k + 1) m1 m2 c - payoff k m1 m2 c =
      ∫ x : ℝ, hingeLoss |x|
        (if c.n1 = q ∨ c.n2 = q then updateVariance ((q - 2 : ℕ) : ℝ≥0)
         else updateVariance ((q - 1 : ℕ) : ℝ≥0))
        ∂BayesOptimal.Foundations.PredictiveLaw.balancedPredictiveLaw k c (m1 - m2) := by
  rw [payoff_horizon_gain_integral _ _ _ _ hc1 hc2,
    even_balancedInnovation_preterminal _ _ _ hq h1 h2 hs]

theorem even_saturated_left_gap_preterminal (q k : ℕ) (m1 m2 : ℝ) (c : Counts)
    (hq : 3 ≤ q) (hc1 : 0 < c.n1) (hc2 : 0 < c.n2)
    (hsaturated : c.n1 = q) (hs : c.n1 + c.n2 + k = 2 * q - 2) :
    payoff (k + 1) m1 m2 c - leftAction k m1 m2 c =
      ∫ x : ℝ, (hingeLoss |x| (updateVariance ((q - 2 : ℕ) : ℝ≥0)) -
        hingeLoss |x| (updateVariance (q : ℝ≥0)))
        ∂BayesOptimal.Foundations.PredictiveLaw.balancedPredictiveLaw k c (m1 - m2) := by
  have htot : c.n2 + k = q - 2 := by omega
  have hright : c.n2 + k ≤ c.n1 := by omega
  have hcap2 : c.n2 ≤ q := by omega
  have hc := even_prefix_counts q k c (by omega) (by omega) hcap2 hs
  simp only [if_pos hsaturated] at hc
  rw [saturated_left_action_gap_integral _ _ _ _ hc1 hc2 hright]
  have hb : balancedInnovation (balancedRun k c) =
      updateVariance ((q - 2 : ℕ) : ℝ≥0) := by
    unfold balancedInnovation
    rw [hc.1, hc.2, if_neg (by omega : ¬ q ≤ q - 2)]
  rw [hb, hc.1]

theorem even_saturated_right_gap_preterminal (q k : ℕ) (m1 m2 : ℝ) (c : Counts)
    (hq : 3 ≤ q) (hc1 : 0 < c.n1) (hc2 : 0 < c.n2)
    (hsaturated : c.n2 = q) (hs : c.n1 + c.n2 + k = 2 * q - 2) :
    payoff (k + 1) m1 m2 c - rightAction k m1 m2 c =
      ∫ x : ℝ, (hingeLoss |x| (updateVariance ((q - 2 : ℕ) : ℝ≥0)) -
        hingeLoss |x| (updateVariance (q : ℝ≥0)))
        ∂BayesOptimal.Foundations.PredictiveLaw.balancedPredictiveLaw k c (m1 - m2) := by
  have htot : c.n1 + k = q - 2 := by omega
  have hleft : c.n1 + k ≤ c.n2 := by omega
  have hn1 : ¬ c.n1 = q := by omega
  have hcap1 : c.n1 ≤ q := by omega
  have hc := even_prefix_counts q k c (by omega) hcap1 (by omega) hs
  simp only [if_neg hn1, if_pos hsaturated] at hc
  rw [saturated_right_action_gap_integral _ _ _ _ hc1 hc2 hleft]
  have hb : balancedInnovation (balancedRun k c) =
      updateVariance ((q - 2 : ℕ) : ℝ≥0) := by
    unfold balancedInnovation
    rw [hc.1, hc.2, if_pos (by omega : q - 2 ≤ q)]
  rw [hb, hc.2]

end

end BayesOptimal.Foundations.EvenCounts

end

/-! ## Foundations.EvenDrift -/
section

namespace BayesOptimal.Foundations.EvenDrift

open BayesOptimal.Foundations.Counts BayesOptimal.Foundations.Drift BayesOptimal.Foundations.Gaussian BayesOptimal.Foundations.TerminalBounds BayesOptimal.Foundations.EvenCounts
open scoped NNReal

noncomputable section

theorem fullW_gap_squared_anchor_bound (T q : ℕ) (CU : ℝ) (p : MeanPath) (c : Counts)
    (hT5 : 5 ≤ T) (hc1 : 1 ≤ c.n1) (hc2 : 1 ≤ c.n2)
    (hW : paperW T q CU p c) :
    (terminalGap p c) ^ 2 ≤ 3 *
      (16 * Real.log (T : ℝ) * (reciprocalSqSum c.n1 q + reciprocalSqSum c.n2 q) +
        4 / (T : ℝ) ^ 4) := by
  rcases hW with ⟨_, hY1, hY2, hZ1, hZ2, h1, h2, _⟩
  have hlog0 : 0 ≤ Real.log (T : ℝ) := (by linarith [log_horizon_ge_one T hT5])
  have hS1 := reciprocalSqSum_nonnegative c.n1 q
  have hS2 := reciprocalSqSum_nonnegative c.n2 q
  have hZ1' := hZ1 c.n1 hc1 h1
  have hZ2' := hZ2 c.n2 hc2 h2
  have hanchors : |p 1 q - p 2 q| ≤ 2 / (T : ℝ) ^ 2 := by
    unfold eventY at hY1 hY2
    calc
      _ ≤ |p 1 q| + |p 2 q| := abs_sub _ _
      _ ≤ 1 / (T : ℝ) ^ 2 + 1 / (T : ℝ) ^ 2 := add_le_add hY1 hY2
      _ = _ := by ring
  have htri1 := abs_sub_le (p 1 c.n1) (p 1 q) (p 2 c.n2)
  have htri2 := abs_sub_le (p 1 q) (p 2 q) (p 2 c.n2)
  rw [abs_sub_comm (p 2 q) (p 2 c.n2)] at htri2
  let A : ℝ := 4 * Real.sqrt (Real.log (T : ℝ)) * Real.sqrt (reciprocalSqSum c.n1 q)
  let B : ℝ := 4 * Real.sqrt (Real.log (T : ℝ)) * Real.sqrt (reciprocalSqSum c.n2 q)
  let C : ℝ := 2 / (T : ℝ) ^ 2
  have habs : |terminalGap p c| ≤ A + B + C := by
    dsimp [A, B, C]
    unfold terminalGap
    linarith only [htri1, htri2, hanchors, hZ1', hZ2']
  have hsq : (terminalGap p c) ^ 2 ≤ (A + B + C) ^ 2 := by
    simpa only [sq_abs] using
      (sq_le_sq₀ (abs_nonneg (terminalGap p c)) (by dsimp [A, B, C]; positivity)).mpr habs
  have hthree : (A + B + C) ^ 2 ≤ 3 * (A ^ 2 + B ^ 2 + C ^ 2) := by
    nlinarith only [sq_nonneg (A - B), sq_nonneg (A - C), sq_nonneg (B - C)]
  have hAsq : A ^ 2 = 16 * Real.log (T : ℝ) * reciprocalSqSum c.n1 q := by
    dsimp [A]
    rw [mul_pow, mul_pow, Real.sq_sqrt hlog0, Real.sq_sqrt hS1]
    norm_num
  have hBsq : B ^ 2 = 16 * Real.log (T : ℝ) * reciprocalSqSum c.n2 q := by
    dsimp [B]
    rw [mul_pow, mul_pow, Real.sq_sqrt hlog0, Real.sq_sqrt hS2]
    norm_num
  have hCsq : C ^ 2 = 4 / (T : ℝ) ^ 4 := by
    dsimp [C]
    rw [div_pow, ← pow_mul]
    norm_num
  rw [hAsq, hBsq, hCsq] at hthree
  nlinarith only [hsq, hthree]

/-- Nonterminal drift for even budgets, including the initial saturated
orientations. The coefficient 300 retains both q-anchor residuals. -/
theorem even_fullW_drift_bound (T q t : ℕ) (CU : ℝ) (p : MeanPath) (c : Counts)
    (hT : T = 2 * q) (ht : 4 ≤ t) (hpre : t < T)
    (hc : horizonConsistent t c) (hW : paperW T q CU p c) :
    (terminalGap p c) ^ 2 ≤ 300 * Real.log (T : ℝ) * transitionVariance (T - t) c := by
  rcases hc with ⟨hc1, hc2, hc3, htotal⟩
  have h1 := hW.2.2.2.2.2.1
  have h2 := hW.2.2.2.2.2.2.1
  have hq : 3 ≤ q := by omega
  have hT5 : 5 ≤ T := by omega
  have hTr : 5 ≤ (T : ℝ) := by exact_mod_cast hT5
  have hk : 0 < T - t := by omega
  have hs : c.n1 + c.n2 + (T - t) = 2 * q - 2 := by omega
  have hbase := fullW_gap_squared_anchor_bound T q CU p c hT5 hc1 hc2 hW
  have hS1 := reciprocalSqSum_bound c.n1 q hc1 h1
  have hS2 := reciprocalSqSum_bound c.n2 q hc2 h2
  have hanchor := even_to_anchor_variance_bound q (T - t) c hq hk hc1 hc2 h1 h2 hs
  have hSsum : reciprocalSqSum c.n1 q + reciprocalSqSum c.n2 q ≤
      6 * transitionVariance (T - t) c := by linarith
  have hlog := log_horizon_ge_one T hT5
  have hlog0 : 0 ≤ Real.log (T : ℝ) := by linarith
  have hV0 := transitionVariance_nonnegative (T - t) c (by omega) (by omega)
  have hcaps := even_prefix_caps q (T - t) c (by omega) h1 h2 hs
  have hVl := transitionVariance_ge_inverse_square_of_caps (T - t) T c hk
    (by omega) (by omega) (by omega) (by omega)
  have hSscaled := mul_le_mul_of_nonneg_left hSsum hlog0
  have hinv : 1 / (T : ℝ) ^ 4 ≤ 1 / (T : ℝ) ^ 2 := by
    apply (div_le_div_iff₀ (by positivity) (by positivity)).mpr
    nlinarith [sq_nonneg ((T : ℝ) ^ 2 - 1)]
  have hVscaled : transitionVariance (T - t) c ≤
      Real.log (T : ℝ) * transitionVariance (T - t) c := by
    simpa using mul_le_mul_of_nonneg_right hlog hV0
  have hinvFinal := hinv.trans (hVl.trans hVscaled)
  have hinvScaled : 4 / (T : ℝ) ^ 4 ≤ 4 *
      (Real.log (T : ℝ) * transitionVariance (T - t) c) := by
    calc
      _ = 4 * (1 / (T : ℝ) ^ 4) := by ring
      _ ≤ _ := mul_le_mul_of_nonneg_left hinvFinal (by norm_num)
  nlinarith only [hbase, hSscaled, hinvScaled]

theorem even_terminal_anchorSum_le_updateVariance (q : ℕ) (c : Counts)
    (hq : 6 ≤ q) (hc1 : 1 ≤ c.n1) (hc2 : 1 ≤ c.n2)
    (h1 : c.n1 ≤ q) (h2 : c.n2 ≤ q) (hs : c.n1 + c.n2 = 2 * q - 2) :
    reciprocalSqSum c.n1 q + reciprocalSqSum c.n2 q ≤
      7 * (updateVariance (q : ℝ≥0) : ℝ) := by
  have hB1 := reciprocalSqSum_bound c.n1 q hc1 h1
  have hB2 := reciprocalSqSum_bound c.n2 q hc2 h2
  have hres := even_terminal_anchor_residual_upper q 0 c (by omega) h1 h2 (by simpa using hs)
  simp only [balancedRun] at hres
  have hscaled := mul_le_mul_of_nonneg_left hres (by norm_num : (0 : ℝ) ≤ 2)
  have hsum : reciprocalSqSum c.n1 q + reciprocalSqSum c.n2 q ≤
      4 / ((q : ℝ) * ((q : ℝ) - 2)) := by
    have he : 2 * (2 / ((q : ℝ) * ((q : ℝ) - 2))) =
        4 / ((q : ℝ) * ((q : ℝ) - 2)) := by ring
    rw [he] at hscaled
    linarith
  have hqr : 6 ≤ (q : ℝ) := by exact_mod_cast hq
  have hqp : 0 < (q : ℝ) := by linarith
  have hq2p : 0 < (q : ℝ) - 2 := by linarith
  have hratio : 4 / ((q : ℝ) * ((q : ℝ) - 2)) ≤
      7 / ((q : ℝ) * ((q : ℝ) + 1)) := by
    apply (div_le_div_iff₀ (by positivity) (by positivity)).mpr
    nlinarith
  have hVar : (updateVariance (q : ℝ≥0) : ℝ) =
      1 / ((q : ℝ) * ((q : ℝ) + 1)) := by
    simp only [updateVariance, NNReal.coe_inv, NNReal.coe_mul, NNReal.coe_add,
      NNReal.coe_natCast, NNReal.coe_one, one_div]
  calc
    _ ≤ 4 / ((q : ℝ) * ((q : ℝ) - 2)) := hsum
    _ ≤ 7 / ((q : ℝ) * ((q : ℝ) + 1)) := hratio
    _ = _ := by rw [hVar]; ring

/-- Even-budget terminal drift bound; T≥12 suffices for the eventual main
theorem. The innovation variance at count q bounds both terminal orientations. -/
theorem even_terminal_fullW_drift_bound (T q : ℕ) (CU : ℝ) (p : MeanPath) (c : Counts)
    (hT : T = 2 * q) (hT12 : 12 ≤ T)
    (hc : horizonConsistent T c) (hW : paperW T q CU p c) :
    (terminalGap p c) ^ 2 ≤
      350 * Real.log (T : ℝ) * (updateVariance (q : ℝ≥0) : ℝ) := by
  rcases hc with ⟨hc1, hc2, hc3, htotal⟩
  have h1 := hW.2.2.2.2.2.1
  have h2 := hW.2.2.2.2.2.2.1
  have hq : 6 ≤ q := by omega
  have hT5 : 5 ≤ T := by omega
  have hs : c.n1 + c.n2 = 2 * q - 2 := by omega
  have hbase := fullW_gap_squared_anchor_bound T q CU p c hT5 hc1 hc2 hW
  have hSsum := even_terminal_anchorSum_le_updateVariance q c hq hc1 hc2 h1 h2 hs
  have hlog := log_horizon_ge_one T hT5
  have hlog0 : 0 ≤ Real.log (T : ℝ) := by linarith
  have hSscaled := mul_le_mul_of_nonneg_left hSsum hlog0
  have hTr : 5 ≤ (T : ℝ) := by exact_mod_cast hT5
  have hinv : 1 / (T : ℝ) ^ 4 ≤ 1 / (T : ℝ) ^ 2 := by
    apply (div_le_div_iff₀ (by positivity) (by positivity)).mpr
    nlinarith [sq_nonneg ((T : ℝ) ^ 2 - 1)]
  have hcount := updateVariance_count_bounds q T (by omega) (by omega)
  have hcountLower : 1 / (T : ℝ) ^ 2 ≤ (updateVariance (q : ℝ≥0) : ℝ) := by
    simpa only [BayesOptimal.Foundations.Rates.invPower, inv_eq_one_div] using hcount.1
  have hv0 : 0 ≤ (updateVariance (q : ℝ≥0) : ℝ) := (updateVariance (q : ℝ≥0)).property
  have hVscaled : (updateVariance (q : ℝ≥0) : ℝ) ≤
      Real.log (T : ℝ) * (updateVariance (q : ℝ≥0) : ℝ) := by
    simpa using mul_le_mul_of_nonneg_right hlog hv0
  have hinvFinal := hinv.trans (hcountLower.trans hVscaled)
  have hinvScaled : 4 / (T : ℝ) ^ 4 ≤
      4 * (Real.log (T : ℝ) * (updateVariance (q : ℝ≥0) : ℝ)) := by
    calc
      _ = 4 * (1 / (T : ℝ) ^ 4) := by ring
      _ ≤ _ := mul_le_mul_of_nonneg_left hinvFinal (by norm_num)
  nlinarith only [hbase, hSscaled, hinvScaled, mul_nonneg hlog0 hv0]

end

end BayesOptimal.Foundations.EvenDrift

end

/-! ## Foundations.EvenDynamicGain -/
section

/-!
Actual quantitative Gaussian gains for the corrected even-budget drift.
The analytic arguments use the existing Gaussian losses and forecasts, with
drift coefficients 300 for nonterminal states and 350 for terminal states.
-/

open MeasureTheory ProbabilityTheory Set
open scoped NNReal ENNReal

namespace BayesOptimal.Foundations.EvenDynamicGain

open BayesOptimal.Foundations.Gaussian BayesOptimal.Foundations.Rates BayesOptimal.Foundations.TerminalBounds BayesOptimal.Foundations.PredictiveBound
open BayesOptimal.Foundations.DynamicGain

noncomputable section

theorem nonterminal_hinge_gain_lower (T n : ℕ) (δ : ℝ) (a : ℝ≥0)
    (hT : 5 ≤ T) (hn : 1 ≤ n) (hnT : n < T)
    (ha : 0 < a) (haupper : (a : ℝ) ≤ 2) (halower : invPower 2 T ≤ (a : ℝ))
    (hδ : δ ^ 2 ≤ 300 * Real.log (T : ℝ) * (a : ℝ)) :
    (gainConstant * lowerConstant) * invPower 308 T ≤
      ∫ x : ℝ, hingeLoss |x| (updateVariance (n : ℝ≥0)) ∂gaussianReal δ a := by
  have hmass := gaussian_interval_probability_lower_nat 300 T hT ha haupper halower hδ
  have hband := gaussian_integral_band_lower
    (BayesOptimal.Foundations.TwoArmGain.absolute_hinge_gaussian_integrable δ a (updateVariance (n : ℝ≥0)))
    (fun x => hingeLoss_nonnegative |x| _) (r := 6)
    (fun x hx => by
      have hx0 : 0 ≤ x := (invPower_nonneg 2 T).trans hx.1
      have hsmall : |x| ≤ 2 * invPower 2 T := by rw [abs_of_nonneg hx0]; exact hx.2
      have hg := lemma14_sample_count_lower T n x 0 hT hn hnT hsmall
      rw [oneStepImprovement_eq_hinge] at hg
      exact hg)
  have hp := mul_le_mul_of_nonneg_left hmass
    (mul_nonneg gainConstant_positive.le (invPower_nonneg 6 T))
  have he : (gainConstant * invPower 6 T) * (lowerConstant * invPower 302 T) =
      (gainConstant * lowerConstant) * invPower 308 T := by
    rw [← invPower_product 6 302 T]
    ring
  rw [he] at hp
  exact hp.trans hband

theorem nonterminal_hinge_difference_lower (T ni nj : ℕ) (δ : ℝ) (a : ℝ≥0)
    (hT : 5 ≤ T) (hj : 1 ≤ nj) (hstrict : nj < ni) (hiT : ni < T)
    (ha : 0 < a) (haupper : (a : ℝ) ≤ 2) (halower : invPower 2 T ≤ (a : ℝ))
    (hδ : δ ^ 2 ≤ 300 * Real.log (T : ℝ) * (a : ℝ)) :
    (comparisonConstant * lowerConstant) * invPower 310 T ≤
      ∫ x : ℝ,
        hingeLoss |x| (updateVariance (nj : ℝ≥0)) -
        hingeLoss |x| (updateVariance (ni : ℝ≥0)) ∂gaussianReal δ a := by
  have hip : 0 < (ni : ℝ≥0) := by exact_mod_cast (show 0 < ni by omega)
  have hjp : 0 < (nj : ℝ≥0) := by exact_mod_cast (show 0 < nj by omega)
  have hv := updateVariance_strictAntitone (nj : ℝ≥0) (ni : ℝ≥0) hjp
    (by exact_mod_cast hstrict)
  have hi := (BayesOptimal.Foundations.TwoArmGain.absolute_hinge_gaussian_integrable δ a
    (updateVariance (nj : ℝ≥0))).sub
    (BayesOptimal.Foundations.TwoArmGain.absolute_hinge_gaussian_integrable δ a (updateVariance (ni : ℝ≥0)))
  have hmass := gaussian_interval_probability_lower_nat 300 T hT ha haupper halower hδ
  have hband := gaussian_integral_band_lower hi
    (fun x => sub_nonneg.mpr (hingeLoss_strictMono_variance |x| (abs_nonneg _) _ _ hv).le)
    (r := 8) (fun x hx => by
      have hx0 : 0 ≤ x := (invPower_nonneg 2 T).trans hx.1
      have hsmall : |x| ≤ 2 * invPower 2 T := by rw [abs_of_nonneg hx0]; exact hx.2
      have hg := lemma15_terminal_action_gap_conservative T ni nj x hT hj hstrict hiT hsmall
      rw [terminal_actionLoss_difference_eq x (ni : ℝ≥0) (nj : ℝ≥0) hjp hip] at hg
      exact hg)
  have hp := mul_le_mul_of_nonneg_left hmass
    (mul_nonneg comparisonConstant_positive.le (invPower_nonneg 8 T))
  have he : (comparisonConstant * invPower 8 T) * (lowerConstant * invPower 302 T) =
      (comparisonConstant * lowerConstant) * invPower 310 T := by
    rw [← invPower_product 8 302 T]
    ring
  rw [he] at hp
  exact hp.trans hband

/-- A terminal gap of order sqrt(log T) standard deviations still gives a polynomial gain. -/
theorem terminal_hinge_gain_lower (T : ℕ) (gap : ℝ) (v : ℝ≥0)
    (hT : 5 ≤ T) (hv : 0 < v) (hvupper : (v : ℝ) ≤ 2)
    (hvlower : invPower 2 T ≤ (v : ℝ))
    (hgap : gap ^ 2 ≤ 350 * Real.log (T : ℝ) * (v : ℝ)) :
    lowerConstant * invPower 354 T ≤ hingeLoss |gap| v := by
  have hmean : (-|gap|) ^ 2 ≤ 350 * Real.log (T : ℝ) * (v : ℝ) := by
    simpa only [neg_sq, sq_abs] using hgap
  have hmass := gaussian_interval_probability_lower_nat 350 T hT hv hvupper hvlower hmean
  have hband := gaussian_integral_band_lower
    ((gaussian_id_integrable (-|gap|) v).pos_part)
    (fun x => le_max_right x 0) (c := 1) (T := T) (r := 2)
    (fun x hx => by simpa only [one_mul] using hx.1.trans (le_max_left x 0))
  have hp := mul_le_mul_of_nonneg_left hmass (invPower_nonneg 2 T)
  have he : invPower 2 T * (lowerConstant * invPower 352 T) =
      lowerConstant * invPower 354 T := by
    rw [← invPower_product 2 352 T]
    ring
  rw [he] at hp
  simp only [one_mul] at hband
  have h := hp.trans hband
  rw [gaussian_positivePart_integral] at h
  simpa only [neg_neg] using h

theorem terminal_hinge_difference_lower (T ni nj : ℕ) (gap : ℝ)
    (hT : 5 ≤ T) (hj : 1 ≤ nj) (hstrict : nj < ni) (hiT : ni < T)
    (hgap : gap ^ 2 ≤ 350 * Real.log (T : ℝ) * (updateVariance (ni : ℝ≥0) : ℝ)) :
    (lowerConstant / 2) * invPower 357 T ≤
      hingeLoss |gap| (updateVariance (nj : ℝ≥0)) -
        hingeLoss |gap| (updateVariance (ni : ℝ≥0)) := by
  let vL := updateVariance (ni : ℝ≥0)
  let vR := updateVariance (nj : ℝ≥0)
  let sL := Real.sqrt (vL : ℝ)
  let sR := Real.sqrt (vR : ℝ)
  let a := |gap| / sL
  have hjp : 0 < (nj : ℝ≥0) := by exact_mod_cast (show 0 < nj by omega)
  have hip : 0 < (ni : ℝ≥0) := by exact_mod_cast (show 0 < ni by omega)
  have hvL : 0 < vL := by dsimp [vL, updateVariance]; positivity
  have hsL : 0 < sL := Real.sqrt_pos.mpr hvL
  have hsR : 0 ≤ sR := Real.sqrt_nonneg _
  have ha0 : 0 ≤ a := div_nonneg (abs_nonneg _) hsL.le
  have haeq : sL * a = |gap| := by dsimp [a]; field_simp
  have hvar : vL < vR := updateVariance_strictAntitone (nj : ℝ≥0) (ni : ℝ≥0)
    hjp (by exact_mod_cast hstrict)
  have hs : sL ≤ sR := Real.sqrt_le_sqrt hvar.le
  have hbound := updateVariance_count_bounds nj T hj (by omega)
  have hsig := sqrt_variance_difference_ge_half vL vR hvar.le (by
    dsimp [vR]; linarith only [hbound.2])
  have hdiff := updateVariance_difference_lower ni nj T hj hstrict hiT
  have hsiglower : (1 / 2 : ℝ) * invPower 3 T ≤ sR - sL := by
    dsimp [sL, sR, vL, vR] at *
    linarith only [hsig, hdiff]
  have haLog : (-a) ^ 2 ≤ 350 * Real.log (T : ℝ) := by
    dsimp [a, sL]
    rw [neg_sq, div_pow, sq_abs, Real.sq_sqrt (show 0 ≤ (vL : ℝ) from hvL.le)]
    exact (div_le_iff₀ (show 0 < (vL : ℝ) from hvL)).mpr hgap
  have hmass := gaussian_interval_probability_lower_nat 350 T (δ := -a) (v := 1) hT
    (by norm_num) (by norm_num) (by
      simpa [invPower] using invPower_antitone (show 0 ≤ 2 by omega) (by omega : 1 ≤ T))
    (by simpa only [NNReal.coe_one, mul_one] using haLog)
  let f := fun y : ℝ => max (sR * (y + a) - |gap|) 0 - max (sL * (y + a) - |gap|) 0
  have hiR : Integrable (fun y : ℝ => max (sR * (y + a) - |gap|) 0)
      (gaussianReal (-a) 1) :=
    ((((gaussian_id_integrable (-a) 1).add (integrable_const a)).const_mul sR).sub
      (integrable_const |gap|)).pos_part
  have hiL : Integrable (fun y : ℝ => max (sL * (y + a) - |gap|) 0)
      (gaussianReal (-a) 1) :=
    ((((gaussian_id_integrable (-a) 1).add (integrable_const a)).const_mul sL).sub
      (integrable_const |gap|)).pos_part
  have hf0 : ∀ y, 0 ≤ f y := by
    intro y
    dsimp [f]
    apply sub_nonneg.mpr
    by_cases hy : 0 ≤ y + a
    · exact max_le_max (sub_le_sub_right (mul_le_mul_of_nonneg_right hs hy) _) le_rfl
    · have hy' : y + a ≤ 0 := le_of_not_ge hy
      rw [max_eq_right (by nlinarith [mul_nonpos_of_nonneg_of_nonpos hsR hy', abs_nonneg gap]),
        max_eq_right (by nlinarith [mul_nonpos_of_nonneg_of_nonpos hsL.le hy', abs_nonneg gap])]
  have hband := gaussian_integral_band_lower (hiR.sub hiL) hf0 (c := 1 / 2) (T := T) (r := 5)
    (fun y hy => by
      have hy0 : 0 ≤ y := (invPower_nonneg 2 T).trans hy.1
      have hx : a ≤ y + a := by linarith
      have hlinL : 0 ≤ sL * (y + a) - |gap| := by nlinarith [mul_nonneg hsL.le hy0]
      have hlinR : 0 ≤ sR * (y + a) - |gap| := by
        have hmul := mul_le_mul_of_nonneg_right hs (show 0 ≤ y + a by positivity)
        linarith
      dsimp [f]
      rw [max_eq_left hlinL, max_eq_left hlinR]
      have hp1 := mul_le_mul_of_nonneg_right hsiglower (show 0 ≤ y + a by positivity)
      have hp2 := mul_le_mul_of_nonneg_left (hy.1.trans (by linarith : y ≤ y + a))
        (mul_nonneg (by norm_num : (0 : ℝ) ≤ 1 / 2) (invPower_nonneg 3 T))
      have he : (1 / 2 : ℝ) * invPower 5 T =
          ((1 / 2 : ℝ) * invPower 3 T) * invPower 2 T := by
        rw [← invPower_product 3 2 T]
        ring
      rw [he]
      nlinarith only [hp1, hp2])
  have hp := mul_le_mul_of_nonneg_left hmass
    (mul_nonneg (by norm_num : (0 : ℝ) ≤ 1 / 2) (invPower_nonneg 5 T))
  have he : ((1 / 2 : ℝ) * invPower 5 T) * (lowerConstant * invPower 352 T) =
      (lowerConstant / 2) * invPower 357 T := by
    rw [← invPower_product 5 352 T]
    ring
  rw [he] at hp
  have hlow := hp.trans hband
  change (lowerConstant / 2) * invPower 357 T ≤ ∫ y : ℝ, f y ∂gaussianReal (-a) 1 at hlow
  have hmap : (gaussianReal 0 1).map (fun x : ℝ => x - a) = gaussianReal (-a) 1 := by
    simpa using gaussianReal_map_sub_const (μ := (0 : ℝ)) (v := 1) a
  have heq : (∫ y : ℝ, f y ∂gaussianReal (-a) 1) =
      hingeLoss |gap| vR - hingeLoss |gap| vL := by
    rw [← hmap, integral_map (by fun_prop) (by fun_prop)]
    simp only [f, sub_add_cancel]
    have hiR0 : Integrable (fun x : ℝ => max (sR * x - |gap|) 0) (gaussianReal 0 1) := by
      simpa only [Pi.sub_apply] using
        ((((gaussian_id_integrable 0 1).const_mul sR).sub (integrable_const |gap|)).pos_part)
    have hiL0 : Integrable (fun x : ℝ => max (sL * x - |gap|) 0) (gaussianReal 0 1) := by
      simpa only [Pi.sub_apply] using
        ((((gaussian_id_integrable 0 1).const_mul sL).sub (integrable_const |gap|)).pos_part)
    rw [integral_sub hiR0 hiL0,
      hingeLoss_eq_standard_integral, hingeLoss_eq_standard_integral]
  rw [heq] at hlow
  exact hlow

theorem nonterminal_hinge_gain_lower_conservative (T n : ℕ) (δ : ℝ) (a : ℝ≥0)
    (hT : 5 ≤ T) (hn : 1 ≤ n) (hnT : n < T)
    (ha : 0 < a) (haupper : (a : ℝ) ≤ 2) (halower : invPower 2 T ≤ (a : ℝ))
    (hδ : δ ^ 2 ≤ 300 * Real.log (T : ℝ) * (a : ℝ)) :
    (gainConstant * lowerConstant) * invPower 370 T ≤
      ∫ x : ℝ, hingeLoss |x| (updateVariance (n : ℝ≥0)) ∂gaussianReal δ a := by
  exact (mul_le_mul_of_nonneg_left
    (invPower_antitone (by norm_num : 308 ≤ 370) (by omega : 1 ≤ T))
    (mul_nonneg gainConstant_positive.le lowerConstant_pos.le)).trans
      (nonterminal_hinge_gain_lower T n δ a hT hn hnT ha haupper halower hδ)

theorem nonterminal_hinge_difference_lower_conservative (T ni nj : ℕ) (δ : ℝ) (a : ℝ≥0)
    (hT : 5 ≤ T) (hj : 1 ≤ nj) (hstrict : nj < ni) (hiT : ni < T)
    (ha : 0 < a) (haupper : (a : ℝ) ≤ 2) (halower : invPower 2 T ≤ (a : ℝ))
    (hδ : δ ^ 2 ≤ 300 * Real.log (T : ℝ) * (a : ℝ)) :
    (comparisonConstant * lowerConstant) * invPower 370 T ≤
      ∫ x : ℝ, hingeLoss |x| (updateVariance (nj : ℝ≥0)) -
        hingeLoss |x| (updateVariance (ni : ℝ≥0)) ∂gaussianReal δ a := by
  exact (mul_le_mul_of_nonneg_left
    (invPower_antitone (by norm_num : 310 ≤ 370) (by omega : 1 ≤ T))
    (mul_nonneg comparisonConstant_positive.le lowerConstant_pos.le)).trans
      (nonterminal_hinge_difference_lower T ni nj δ a hT hj hstrict hiT ha haupper halower hδ)

theorem terminal_hinge_gain_lower_conservative (T : ℕ) (gap : ℝ) (v : ℝ≥0)
    (hT : 5 ≤ T) (hv : 0 < v) (hvupper : (v : ℝ) ≤ 2)
    (hvlower : invPower 2 T ≤ (v : ℝ))
    (hgap : gap ^ 2 ≤ 350 * Real.log (T : ℝ) * (v : ℝ)) :
    lowerConstant * invPower 370 T ≤ hingeLoss |gap| v := by
  exact (mul_le_mul_of_nonneg_left
    (invPower_antitone (by norm_num : 354 ≤ 370) (by omega : 1 ≤ T))
    lowerConstant_pos.le).trans
      (terminal_hinge_gain_lower T gap v hT hv hvupper hvlower hgap)

theorem terminal_hinge_difference_lower_conservative (T ni nj : ℕ) (gap : ℝ)
    (hT : 5 ≤ T) (hj : 1 ≤ nj) (hstrict : nj < ni) (hiT : ni < T)
    (hgap : gap ^ 2 ≤ 350 * Real.log (T : ℝ) * (updateVariance (ni : ℝ≥0) : ℝ)) :
    (lowerConstant / 2) * invPower 370 T ≤
      hingeLoss |gap| (updateVariance (nj : ℝ≥0)) -
        hingeLoss |gap| (updateVariance (ni : ℝ≥0)) := by
  exact (mul_le_mul_of_nonneg_left
    (invPower_antitone (by norm_num : 357 ≤ 370) (by omega : 1 ≤ T))
    (half_pos lowerConstant_pos).le).trans
      (terminal_hinge_difference_lower T ni nj gap hT hj hstrict hiT hgap)

end

end BayesOptimal.Foundations.EvenDynamicGain

