/-! ## ProseCorollariesErrorRate -/
section

set_option autoImplicit false
set_option warningAsError true

open MeasureTheory ProbabilityTheory Set Filter
open scoped NNReal ENNReal Topology

namespace BayesOptimal.ProseCorollaries

open BayesOptimal.FiniteGaussian BayesOptimal.FiniteModelExclusion

variable {A : Type*} [Fintype A] [Nonempty A] [DecidableEq A]
variable [MeasurableSpace A] [MeasurableSingletonClass A]
variable {Ω : Type*} [MeasurableSpace Ω]

noncomputable section

def minimumGap (μ : Means A) (best : A) [Nonempty {a : A // a ≠ best}] : ℝ :=
  μ best - otherMaximum best μ

def maximumGap (μ : Means A) (best : A) : ℝ := μ best + maxAll (-μ)

omit [Nonempty A] [MeasurableSpace A] [MeasurableSingletonClass A] in
theorem minimumGap_pos (μ : Means A) (best : A) [Nonempty {a : A // a ≠ best}]
    (hbest : ∀ a, a ≠ best → μ a < μ best) : 0 < minimumGap μ best := by
  obtain ⟨a, ha⟩ := maxAll_attained (fun a : {a : A // a ≠ best} => μ a)
  unfold minimumGap otherMaximum
  rw [← ha]
  exact sub_pos.mpr (hbest a a.2)

omit [MeasurableSpace A] [MeasurableSingletonClass A] in
theorem gap_bounds (μ : Means A) (best a : A) [Nonempty {a : A // a ≠ best}]
    (ha : a ≠ best) : minimumGap μ best ≤ μ best - μ a ∧
      μ best - μ a ≤ maximumGap μ best := by
  have hl := coordinate_le_maxAll (fun b : {b : A // b ≠ best} => μ b) ⟨a, ha⟩
  have hu := coordinate_le_maxAll (-μ) a
  constructor
  · change μ best - maxAll (fun b : {b : A // b ≠ best} => μ b) ≤ μ best - μ a
    linarith
  · change μ best - μ a ≤ μ best + maxAll (-μ)
    change -μ a ≤ maxAll (-μ) at hu
    linarith

omit [MeasurableSpace A] [MeasurableSingletonClass A] in
theorem maximumGap_pos (μ : Means A) (best : A) [Nonempty {a : A // a ≠ best}]
    (hbest : ∀ a, a ≠ best → μ a < μ best) : 0 < maximumGap μ best := by
  obtain ⟨a, ha⟩ := (inferInstance : Nonempty {a : A // a ≠ best})
  exact (minimumGap_pos μ best hbest).trans_le
    ((gap_bounds μ best a ha).1.trans (gap_bounds μ best a ha).2)

omit [Nonempty A] [DecidableEq A] in
theorem finite_value_integrable (ν : Measure Ω) [IsFiniteMeasure ν]
    (f : A → ℝ) (J : Ω → A) (hJ : Measurable J) :
    Integrable (fun w => f (J w)) ν := by
  have hm := (measurable_of_countable f).comp hJ
  apply (integrable_const (∑ a, |f a|)).mono' hm.aestronglyMeasurable
  exact Filter.Eventually.of_forall (fun w => by
    rw [Real.norm_eq_abs]
    exact Finset.single_le_sum (fun a _ => abs_nonneg (f a)) (Finset.mem_univ (J w)))

def recommendationError (ν : Measure Ω) (best : A) (J : Ω → A) : ℝ :=
  ν.real {w | J w ≠ best}

def frequentistRegret (ν : Measure Ω) (μ : Means A) (best : A) (J : Ω → A) : ℝ :=
  ∫ w, μ best - μ (J w) ∂ν

/-- At every finite unique-best instance, simple regret is sandwiched
between the minimum and maximum gaps times the actual error probability. -/
theorem error_regret_sandwich (ν : Measure Ω) [IsProbabilityMeasure ν]
    (μ : Means A) (best : A) [Nonempty {a : A // a ≠ best}]
    (_hbest : ∀ a, a ≠ best → μ a < μ best) (J : Ω → A) (hJ : Measurable J) :
    minimumGap μ best * recommendationError ν best J ≤ frequentistRegret ν μ best J ∧
      frequentistRegret ν μ best J ≤ maximumGap μ best * recommendationError ν best J := by
  let E : Set Ω := {w | J w ≠ best}
  have hE : MeasurableSet E := (hJ (measurableSet_singleton best)).compl
  have hi := finite_value_integrable ν (fun a => μ best - μ a) J hJ
  have hlo := integral_mono ((integrable_const (minimumGap μ best)).indicator hE) hi
    (fun w => by
      by_cases hw : w ∈ E
      · rw [indicator_of_mem hw]
        exact (gap_bounds μ best (J w) hw).1
      · have he : J w = best := not_not.mp hw
        simp only [indicator_of_notMem hw, he, sub_self, le_refl])
  have hhi := integral_mono hi ((integrable_const (maximumGap μ best)).indicator hE)
    (fun w => by
      by_cases hw : w ∈ E
      · rw [indicator_of_mem hw]
        exact (gap_bounds μ best (J w) hw).2
      · have he : J w = best := not_not.mp hw
        simp only [indicator_of_notMem hw, he, sub_self, le_refl])
  rw [integral_indicator_const _ hE, smul_eq_mul, mul_comm] at hlo hhi
  exact ⟨hlo, hhi⟩

theorem liminf_add_vanishing_coe (u : ℕ → EReal) (v : ℕ → ℝ)
    (hv : Tendsto v atTop (𝓝 0)) :
    liminf (fun T => u T + (v T : EReal)) atTop = liminf u atTop := by
  have hvc : Tendsto (fun T => (v T : EReal)) atTop (𝓝 0) := by
    simpa only [EReal.coe_zero] using EReal.tendsto_coe.mpr hv
  have hlo := EReal.le_liminf_add (u := u) (v := fun T => (v T : EReal)) (f := atTop)
  rw [hvc.liminf_eq, add_zero] at hlo
  have hhi := EReal.liminf_add_le (u := fun T => (v T : EReal)) (v := u) (f := atTop)
    (Or.inl (by rw [hvc.limsup_eq]; exact EReal.coe_ne_bot 0))
    (Or.inl (by rw [hvc.limsup_eq]; exact EReal.coe_ne_top 0))
  rw [hvc.limsup_eq, zero_add] at hhi
  have hhi' : liminf (fun T => u T + (v T : EReal)) atTop ≤ liminf u atTop := by
    simpa only [Pi.add_apply, add_comm] using hhi
  exact le_antisymm hhi' hlo

theorem limsup_add_vanishing_coe (u : ℕ → EReal) (v : ℕ → ℝ)
    (hv : Tendsto v atTop (𝓝 0)) :
    limsup (fun T => u T + (v T : EReal)) atTop = limsup u atTop := by
  have hvc : Tendsto (fun T => (v T : EReal)) atTop (𝓝 0) := by
    simpa only [EReal.coe_zero] using EReal.tendsto_coe.mpr hv
  have hlo := EReal.le_limsup_add (u := u) (v := fun T => (v T : EReal)) (f := atTop)
  rw [hvc.liminf_eq, add_zero] at hlo
  have hhi := EReal.limsup_add_le (u := u) (v := fun T => (v T : EReal)) (f := atTop)
    (Or.inr (by rw [hvc.limsup_eq]; exact EReal.coe_ne_top 0))
    (Or.inr (by rw [hvc.limsup_eq]; exact EReal.coe_ne_bot 0))
  rw [hvc.limsup_eq, add_zero] at hhi
  exact le_antisymm hhi hlo

theorem rate_le_of_scaled_lower (p r : ℕ → ℝ) (a : ℝ) (ha : 0 < a)
    (hp : ∀ T, 0 ≤ p T) (_hr : ∀ T, 0 ≤ r T)
    (hl : ∀ T, a * p T ≤ r T) (T : ℕ) (hT : 0 < T) :
    BayesOptimal.RegretExponent.rate r T ≤ BayesOptimal.RegretExponent.rate p T +
      (((-Real.log a) / (T : ℝ) : ℝ) : EReal) := by
  by_cases hpz : p T = 0
  · simp [BayesOptimal.RegretExponent.rate, hpz]
  · have hpp : 0 < p T := lt_of_le_of_ne (hp T) (Ne.symm hpz)
    have hrp : 0 < r T := (mul_pos ha hpp).trans_le (hl T)
    have hlog := Real.log_le_log (mul_pos ha hpp) (hl T)
    rw [Real.log_mul ha.ne' hpp.ne'] at hlog
    rw [BayesOptimal.RegretExponent.rate, if_neg hrp.ne',
      BayesOptimal.RegretExponent.rate, if_neg hpz, ← EReal.coe_add]
    apply EReal.coe_le_coe
    rw [← add_div]
    apply div_le_div_of_nonneg_right _ (by exact_mod_cast hT.le)
    linarith

/-- Multiplication by fixed positive gap constants preserves the full
extended-real exponential rate, including horizons with zero error. -/
theorem liminf_rate_eq_of_gap_sandwich (p r : ℕ → ℝ) (a b : ℝ)
    (ha : 0 < a) (hb : 0 < b) (hp : ∀ T, 0 ≤ p T) (hr : ∀ T, 0 ≤ r T)
    (hl : ∀ T, a * p T ≤ r T) (hu : ∀ T, r T ≤ b * p T) :
    liminf (BayesOptimal.RegretExponent.rate p) atTop =
      liminf (BayesOptimal.RegretExponent.rate r) atTop := by
  have hlow : ∀ T, b⁻¹ * r T ≤ p T := by
    intro T
    exact (inv_mul_le_iff₀ hb).mpr (hu T)
  have hpr := liminf_le_liminf (show ∀ᶠ T : ℕ in atTop,
      BayesOptimal.RegretExponent.rate p T ≤ BayesOptimal.RegretExponent.rate r T +
        (((-Real.log b⁻¹) / (T : ℝ) : ℝ) : EReal) by
    filter_upwards [eventually_ge_atTop (1 : ℕ)] with T hT
    exact rate_le_of_scaled_lower r p b⁻¹ (inv_pos.mpr hb) hr hp hlow T (by omega))
  have hrp := liminf_le_liminf (show ∀ᶠ T : ℕ in atTop,
      BayesOptimal.RegretExponent.rate r T ≤ BayesOptimal.RegretExponent.rate p T +
        (((-Real.log a) / (T : ℝ) : ℝ) : EReal) by
    filter_upwards [eventually_ge_atTop (1 : ℕ)] with T hT
    exact rate_le_of_scaled_lower p r a ha hp hr hl T (by omega))
  rw [liminf_add_vanishing_coe _ _ (tendsto_const_div_atTop_nhds_zero_nat _)] at hpr hrp
  exact le_antisymm hpr hrp

theorem limsup_rate_eq_of_gap_sandwich (p r : ℕ → ℝ) (a b : ℝ)
    (ha : 0 < a) (hb : 0 < b) (hp : ∀ T, 0 ≤ p T) (hr : ∀ T, 0 ≤ r T)
    (hl : ∀ T, a * p T ≤ r T) (hu : ∀ T, r T ≤ b * p T) :
    limsup (BayesOptimal.RegretExponent.rate p) atTop =
      limsup (BayesOptimal.RegretExponent.rate r) atTop := by
  have hlow : ∀ T, b⁻¹ * r T ≤ p T := by
    intro T
    exact (inv_mul_le_iff₀ hb).mpr (hu T)
  have hpr := limsup_le_limsup (show ∀ᶠ T : ℕ in atTop,
      BayesOptimal.RegretExponent.rate p T ≤ BayesOptimal.RegretExponent.rate r T +
        (((-Real.log b⁻¹) / (T : ℝ) : ℝ) : EReal) by
    filter_upwards [eventually_ge_atTop (1 : ℕ)] with T hT
    exact rate_le_of_scaled_lower r p b⁻¹ (inv_pos.mpr hb) hr hp hlow T (by omega))
  have hrp := limsup_le_limsup (show ∀ᶠ T : ℕ in atTop,
      BayesOptimal.RegretExponent.rate r T ≤ BayesOptimal.RegretExponent.rate p T +
        (((-Real.log a) / (T : ℝ) : ℝ) : EReal) by
    filter_upwards [eventually_ge_atTop (1 : ℕ)] with T hT
    exact rate_le_of_scaled_lower p r a ha hp hr hl T (by omega))
  rw [limsup_add_vanishing_coe _ _ (tendsto_const_div_atTop_nhds_zero_nat _)] at hpr hrp
  exact le_antisymm hpr hrp

/-- The unnumbered exponential-rate equivalence in Section 6 for any
measurable horizon-indexed family of recommendations at a unique-best
finite-arm instance. No positive-error assumption excludes zero horizons. -/
theorem error_regret_same_exponential_rate (ν : Measure Ω) [IsProbabilityMeasure ν]
    (μ : Means A) (best : A) [Nonempty {a : A // a ≠ best}]
    (hbest : ∀ a, a ≠ best → μ a < μ best)
    (J : ℕ → Ω → A) (hJ : ∀ T, Measurable (J T)) :
    liminf (BayesOptimal.RegretExponent.rate (fun T => recommendationError ν best (J T))) atTop =
      liminf (BayesOptimal.RegretExponent.rate (fun T => frequentistRegret ν μ best (J T))) atTop := by
  apply liminf_rate_eq_of_gap_sandwich _ _ (minimumGap μ best) (maximumGap μ best)
    (minimumGap_pos μ best hbest) (maximumGap_pos μ best hbest)
    (fun _ => measureReal_nonneg)
  · intro T
    exact ((mul_nonneg (minimumGap_pos μ best hbest).le measureReal_nonneg).trans
      (error_regret_sandwich ν μ best hbest (J T) (hJ T)).1)
  · intro T
    exact (error_regret_sandwich ν μ best hbest (J T) (hJ T)).1
  · intro T
    exact (error_regret_sandwich ν μ best hbest (J T) (hJ T)).2

/-- The upper exponential rate agrees as well; together with the preceding
theorem this covers existence and equality of an exponential-rate limit. -/
theorem error_regret_same_upper_exponential_rate (ν : Measure Ω) [IsProbabilityMeasure ν]
    (μ : Means A) (best : A) [Nonempty {a : A // a ≠ best}]
    (hbest : ∀ a, a ≠ best → μ a < μ best)
    (J : ℕ → Ω → A) (hJ : ∀ T, Measurable (J T)) :
    limsup (BayesOptimal.RegretExponent.rate (fun T => recommendationError ν best (J T))) atTop =
      limsup (BayesOptimal.RegretExponent.rate (fun T => frequentistRegret ν μ best (J T))) atTop := by
  apply limsup_rate_eq_of_gap_sandwich _ _ (minimumGap μ best) (maximumGap μ best)
    (minimumGap_pos μ best hbest) (maximumGap_pos μ best hbest)
    (fun _ => measureReal_nonneg)
  · intro T
    exact ((mul_nonneg (minimumGap_pos μ best hbest).le measureReal_nonneg).trans
      (error_regret_sandwich ν μ best hbest (J T) (hJ T)).1)
  · intro T
    exact (error_regret_sandwich ν μ best hbest (J T) (hJ T)).1
  · intro T
    exact (error_regret_sandwich ν μ best hbest (J T) (hJ T)).2

end
end BayesOptimal.ProseCorollaries

end

/-! ## ProseCorollariesExclusion -/
section

set_option autoImplicit false
set_option warningAsError true

open MeasureTheory ProbabilityTheory Set
open scoped NNReal ENNReal

namespace BayesOptimal.ProseCorollaries

open BayesOptimal.FiniteGaussian BayesOptimal.FinitePosterior BayesOptimal.FiniteModelExclusion

variable {A : Type*} [Fintype A] [Nonempty A] [DecidableEq A]
variable [MeasurableSpace A] [MeasurableSingletonClass A]
variable {S : Type*} [MeasurableSpace S]

noncomputable section

omit [Nonempty A] [MeasurableSpace A] [MeasurableSingletonClass A] in
theorem otherMinimum_le_retained (i : A) [Nonempty {a : A // a ≠ i}]
    (u : Means A) (j : A) (hji : j ≠ i) : otherMinimum i u ≤ u j := by
  have h := coordinate_le_maxAll (fun a : {a : A // a ≠ i} => -u a) ⟨j, hji⟩
  change -maxAll (fun a : {a : A // a ≠ i} => -u a) ≤ u j
  linarith

omit [MeasurableSpace A] [MeasurableSingletonClass A] in
/-- The exclusion-loss comparison is pathwise, independently of the policy.
It remains valid at ties and for any recommended arm. -/
theorem regret_on_best_arm_le_exclusion (i : A) [Nonempty {a : A // a ≠ i}]
    (u : Means A) (j : A) (hi : maxAll u = u i) :
    maxAll u - u j ≤ max (u i - otherMinimum i u) 0 := by
  rw [hi]
  by_cases hji : j = i
  · subst j
    exact (sub_self _).trans_le (le_max_right _ _)
  · exact (sub_le_sub_left (otherMinimum_le_retained i u j hji) _).trans
      (le_max_left _ _)

theorem posterior_randomized_regret_integrable (c : Precisions A) (m : Means A)
    (ν : Measure S) [IsProbabilityMeasure ν] (J : Means A × S → A) (hJ : Measurable J) :
    Integrable (fun w => maxAll w.1 - w.1 (J w)) ((posteriorLaw c m).prod ν) := by
  have heval : Measurable (fun p : (Means A × S) × A => p.1.1 p.2) :=
    measurable_from_prod_countable_left (fun a => by
      change Measurable (fun p : Means A × S => p.1 a)
      fun_prop)
  have hm : Measurable (fun w : Means A × S => maxAll w.1 - w.1 (J w)) :=
    (maxAll_lipschitz.continuous.measurable.comp measurable_fst).sub
      (heval.comp (measurable_id.prodMk hJ))
  have hb : Integrable (fun w : Means A × S => 2 * ∑ a, |w.1 a|)
      ((posteriorLaw c m).prod ν) := by
    apply Integrable.const_mul
    apply integrable_finset_sum
    intro a _
    exact ((posterior_coordinate_integrable c m a).abs.comp_fst ν)
  apply hb.mono' hm.aestronglyMeasurable
  exact Filter.Eventually.of_forall (fun w =>
    BayesOptimal.EmbeddingRandomized.regret_norm_le_sum w.1 (J w))

/-- Section 5.2's unnumbered assertion: the posterior risk contribution on
any event where arm i is best is bounded by its actual exclusion expectation.
The arbitrary independent S includes all Gaussian observation arrays and
external policy randomizers. The recommendation may be any Borel function. -/
theorem posterior_best_arm_risk_le_exclusion (i : A) [Nonempty {a : A // a ≠ i}]
    (c : Precisions A) (m : Means A) (ν : Measure S) [IsProbabilityMeasure ν]
    (J : Means A × S → A) (hJ : Measurable J)
    (E : Set (Means A × S)) (hE : MeasurableSet E)
    (hbest : ∀ w ∈ E, maxAll w.1 = w.1 i) :
    (∫ w, E.indicator (fun w => maxAll w.1 - w.1 (J w)) w
      ∂(posteriorLaw c m).prod ν) ≤ exclusion i c m := by
  have hi := posterior_randomized_regret_integrable c m ν J hJ
  have hex := (exclusion_integrable i c m).comp_fst ν
  have hp := integral_mono (hi.indicator hE) hex (fun w => by
    by_cases hw : w ∈ E
    · rw [indicator_of_mem hw]
      exact regret_on_best_arm_le_exclusion i w.1 (J w) (hbest w hw)
    · rw [indicator_of_notMem hw]
      exact le_max_right _ _)
  rw [integral_prod _ hex] at hp
  simpa [exclusion] using hp

end
end BayesOptimal.ProseCorollaries

end

/-! ## ProseCorollariesRemark3 -/
section

set_option autoImplicit false
set_option warningAsError true

open MeasureTheory ProbabilityTheory
open scoped NNReal ENNReal

namespace BayesOptimal.ProseCorollaries

open BayesOptimal.Foundations.Counts BayesOptimal.Foundations.Gaussian BayesOptimal.Foundations.TwoArmBellman BayesOptimal.Foundations.TwoArmGain
open BayesOptimal.TwoArmOptimal

noncomputable section

/-- Remark 3: when neither initial count is at the cap, either first action
has the same posterior loss. This holds for every real mean pair, without W. -/
theorem remark3_equal_action_losses (q k n1 n2 : ℕ) (m1 m2 : ℝ)
    (h1 : 0 < n1) (h2 : 0 < n2) (hcap1 : n1 < q) (hcap2 : n2 < q)
    (hs : n1 + n2 + k = 2 * q - 1) :
    BayesOptimal.FinitePosterior.actionLoss k (pairPrecisions n1 n2) (pairMeans m1 m2) 0 =
      BayesOptimal.FinitePosterior.actionLoss k (pairPrecisions n1 n2) (pairMeans m1 m2) 1 := by
  let c := pairCounts n1 n2
  have hf1 := BayesOptimal.Dynamic.forced_left_final_counts q k c (by omega)
    (show c.n1 ≤ q from hcap1.le) (show c.n2 ≤ q from hcap2.le) hs
  have hf2 := BayesOptimal.Dynamic.forced_right_final_counts q k c (by omega)
    (show c.n1 ≤ q from hcap1.le) (show c.n2 ≤ q from hcap2.le) hs
  simp only [show ¬ c.n1 = q from Nat.ne_of_lt hcap1,
    show ¬ c.n2 = q from Nat.ne_of_lt hcap2, if_false] at hf1 hf2
  have hl := leftAction_variance_decomposition k c h1 h2
  have hr := rightAction_variance_decomposition k c h1 h2
  rw [BayesOptimal.Foundations.TwoArmBellman.variance, hf1.1, hf1.2] at hl
  rw [BayesOptimal.Foundations.TwoArmBellman.variance, hf2.1, hf2.2] at hr
  have hv : updateVariance c.n1 + cumulativeVariance k (leftStep c) =
      updateVariance c.n2 + cumulativeVariance k (rightStep c) :=
    add_right_cancel (hl.trans hr.symm)
  have ha : leftAction k m1 m2 c = rightAction k m1 m2 c := by
    rw [leftAction_eq, rightAction_eq, hv]
  have hp0 : 0 < pairPrecisions n1 n2 0 := by simpa [pairPrecisions] using h1
  have hp1 : 0 < pairPrecisions n1 n2 1 := by simpa [pairPrecisions] using h2
  rw [BayesOptimal.FinitePosterior.actionLoss_eq _ _ _ _ hp0,
    BayesOptimal.FinitePosterior.actionLoss_eq _ _ _ _ hp1,
    action_left_eq, action_right_eq]
  exact congrArg (fun x => BayesOptimal.FinitePosterior.potential
    (pairPrecisions n1 n2) (pairMeans m1 m2) - x) ha

/-- The actual count-balancing continuation has the literal terminal pair
(q,q) with the remaining budget of Remark 3. -/
theorem remark3_balanced_terminal_counts (q S n1 n2 : ℕ)
    (hcap1 : n1 ≤ q) (hcap2 : n2 ≤ q) (hs : n1 + n2 + S = 2 * q) :
    (balancedRun S (pairCounts n1 n2)).n1 = q ∧
      (balancedRun S (pairCounts n1 n2)).n2 = q :=
  balancedRun_final_counts q S (pairCounts n1 n2) hcap1 hcap2 hs

theorem hinge_difference_integral_pos (a b v : ℝ≥0) (d : ℝ) (hab : a < b) :
    0 < ∫ x : ℝ, hingeLoss |x| b - hingeLoss |x| a ∂gaussianReal d v := by
  have hp (x : ℝ) : 0 < hingeLoss |x| b - hingeLoss |x| a :=
    sub_pos.mpr (hingeLoss_strictMono_variance |x| (abs_nonneg _) a b hab)
  apply (integral_pos_iff_support_of_nonneg (fun x => (hp x).le)
    ((absolute_hinge_gaussian_integrable d v b).sub
      (absolute_hinge_gaussian_integrable d v a))).mpr
  have hsupport : Function.support (fun x : ℝ => hingeLoss |x| b - hingeLoss |x| a) =
      Set.univ := Set.eq_univ_of_forall (fun x => (hp x).ne')
  rw [hsupport]
  simp

/-- Remark 3's saturated-left inequality, at every mean pair. No event or
asymptotic probability hypothesis is needed. -/
theorem remark3_saturated_left_strict (q k n2 : ℕ) (m1 m2 : ℝ)
    (h2 : 0 < n2) (hs : q + n2 + k = 2 * q - 1) :
    BayesOptimal.FinitePosterior.actionLoss k (pairPrecisions q n2) (pairMeans m1 m2) 1 <
      BayesOptimal.FinitePosterior.actionLoss k (pairPrecisions q n2) (pairMeans m1 m2) 0 := by
  have hq : 2 ≤ q := by omega
  let c := pairCounts q n2
  have hc1 : 0 < c.n1 := by change 0 < q; omega
  have hc2 : 0 < c.n2 := h2
  have hct : c.n2 < c.n1 := by change n2 < q; omega
  have hgap := saturated_left_action_gap_integral k m1 m2 c hc1 hc2
    (show c.n2 + k ≤ c.n1 by change n2 + k ≤ q; omega)
  have hf := saturated_left_prefix_counts q k c (by omega) rfl hs
  rw [balancedInnovation_preterminal q k c (by omega) (by rfl)
    (show c.n2 ≤ q by change n2 ≤ q; omega) hs, hf.1,
    BayesOptimal.Foundations.PredictiveLaw.balancedPredictiveLaw_gaussian] at hgap
  have hv := updateVariance_strictAntitone ((q - 1 : ℕ) : ℝ≥0) (q : ℝ≥0)
    (by exact_mod_cast (show 0 < q - 1 by omega))
    (by exact_mod_cast (show q - 1 < q by omega))
  have hp := hinge_difference_integral_pos _ _
    (BayesOptimal.Foundations.PredictiveLaw.accumulatedVariance k c) (m1 - m2) hv
  rw [← hgap] at hp
  have hright := smaller_count_right_optimal k m1 m2 c hc1 hc2 hct
  have h0 : 0 < pairPrecisions q n2 0 := by simpa [pairPrecisions] using hc1
  have h1 : 0 < pairPrecisions q n2 1 := by simpa [pairPrecisions] using h2
  rw [BayesOptimal.FinitePosterior.actionLoss_eq _ _ _ _ h1,
    BayesOptimal.FinitePosterior.actionLoss_eq _ _ _ _ h0,
    action_right_eq, action_left_eq]
  change _ - rightAction k m1 m2 c < _ - leftAction k m1 m2 c
  rw [← hright]
  linarith

/-- The symmetric saturated-right assertion of Remark 3. -/
theorem remark3_saturated_right_strict (q k n1 : ℕ) (m1 m2 : ℝ)
    (h1 : 0 < n1) (hs : n1 + q + k = 2 * q - 1) :
    BayesOptimal.FinitePosterior.actionLoss k (pairPrecisions n1 q) (pairMeans m1 m2) 0 <
      BayesOptimal.FinitePosterior.actionLoss k (pairPrecisions n1 q) (pairMeans m1 m2) 1 := by
  have hq : 2 ≤ q := by omega
  let c := pairCounts n1 q
  have hc1 : 0 < c.n1 := h1
  have hc2 : 0 < c.n2 := by change 0 < q; omega
  have hct : c.n1 ≤ c.n2 := by change n1 ≤ q; omega
  have hgap := saturated_right_action_gap_integral k m1 m2 c hc1 hc2
    (show c.n1 + k ≤ c.n2 by change n1 + k ≤ q; omega)
  have hf := saturated_right_prefix_counts q k c (by omega) rfl hs
  rw [balancedInnovation_preterminal q k c (by omega)
    (show c.n1 ≤ q by change n1 ≤ q; omega) (by rfl) hs, hf.2,
    BayesOptimal.Foundations.PredictiveLaw.balancedPredictiveLaw_gaussian] at hgap
  have hv := updateVariance_strictAntitone ((q - 1 : ℕ) : ℝ≥0) (q : ℝ≥0)
    (by exact_mod_cast (show 0 < q - 1 by omega))
    (by exact_mod_cast (show q - 1 < q by omega))
  have hp := hinge_difference_integral_pos _ _
    (BayesOptimal.Foundations.PredictiveLaw.accumulatedVariance k c) (m1 - m2) hv
  rw [← hgap] at hp
  have hleft := smaller_count_left_optimal k m1 m2 c hc1 hc2 hct
  have h0 : 0 < pairPrecisions n1 q 0 := by simpa [pairPrecisions] using h1
  have h1' : 0 < pairPrecisions n1 q 1 := by simpa [pairPrecisions] using hc2
  rw [BayesOptimal.FinitePosterior.actionLoss_eq _ _ _ _ h0,
    BayesOptimal.FinitePosterior.actionLoss_eq _ _ _ _ h1',
    action_left_eq, action_right_eq]
  change _ - leftAction k m1 m2 c < _ - rightAction k m1 m2 c
  rw [← hleft]
  linarith

end
end BayesOptimal.ProseCorollaries

end

/-! ## RateComparison -/
section

set_option autoImplicit false
set_option warningAsError true

/-!
Limited comparison checks for junpei_version.pdf. These prove the revised
rate algebra conditional on its stated component bounds. They do not
formalize or certify the revised probabilistic or policy lemmas.
-/

open Filter Asymptotics
open scoped NNReal

namespace BayesOptimal.ComparisonChecks.RateChecks

open BayesOptimal.Foundations.Rates

theorem revised_product176 (T : ℕ) :
    invPower 6 T * invPower 170 T = invPower 176 T := by
  exact invPower_product 6 170 T

theorem revised_product178 (T : ℕ) :
    invPower 8 T * invPower 170 T = invPower 178 T := by
  exact invPower_product 8 170 T

theorem cutoff33_satisfies_revised_threshold :
    (180 : ℝ) < ((33 : ℝ) - 6) ^ 2 / 4 := by norm_num

theorem all_cutoffs_ge33_satisfy_revised_threshold (CU : ℝ) (hCU : 33 ≤ CU) :
    180 < (CU - 6) ^ 2 / 4 := by nlinarith

theorem revised_interval_probability_conditional (T : ℕ) (delta : ℝ) (variance : ℝ≥0)
    (hT : 5 ≤ T) (hv : 0 < variance) (hvu : (variance : ℝ) ≤ 2)
    (hvl : invPower 2 T ≤ (variance : ℝ))
    (hdelta : delta ^ 2 ≤ 160 * Real.log (T : ℝ) * (variance : ℝ)) :
    BayesOptimal.Foundations.PredictiveBound.lowerConstant * invPower 170 T ≤
      (ProbabilityTheory.gaussianReal delta variance
        (Set.Icc (invPower 2 T) (2 * invPower 2 T))).toReal := by
  exact (mul_le_mul_of_nonneg_left
    (invPower_antitone (by norm_num : 162 ≤ 170) (by omega : 1 ≤ T))
    BayesOptimal.Foundations.PredictiveBound.lowerConstant_pos.le).trans
      (BayesOptimal.Foundations.PredictiveBound.gaussian_interval_probability_lower_nat 160 T
        hT hv hvu hvl hdelta)

theorem revised_first_margin {c1 c3 : ℝ} {g0 g1 g3 : ℕ → ℝ}
    (hc1 : 0 < c1) (hc3 : 0 < c3)
    (h0 : g0 =o[atTop] invPower 180)
    (h1 : ∀ᶠ T in atTop, c1 * invPower 6 T ≤ g1 T)
    (h3 : ∀ᶠ T in atTop, c3 * invPower 170 T ≤ g3 T) :
    ∀ᶠ T in atTop, ((c1 * c3) / 2) * invPower 176 T ≤
      g1 T * g3 T - 2 * g0 T := by
  exact eventual_subtraction_lower_bound (mul_pos hc1 hc3) (by norm_num)
    (by norm_num : 176 < 180) h0.isBigO
    (eventual_product_lower_bound hc1.le hc3.le h1 h3)

theorem revised_second_margin {c2 c3 : ℝ} {g0 g2 g3 : ℕ → ℝ}
    (hc2 : 0 < c2) (hc3 : 0 < c3)
    (h0 : g0 =o[atTop] invPower 180)
    (h2 : ∀ᶠ T in atTop, c2 * invPower 8 T ≤ g2 T)
    (h3 : ∀ᶠ T in atTop, c3 * invPower 170 T ≤ g3 T) :
    ∀ᶠ T in atTop, ((c2 * c3) / 2) * invPower 178 T ≤
      g2 T * g3 T - 4 * g0 T := by
  exact eventual_subtraction_lower_bound (mul_pos hc2 hc3) (by norm_num)
    (by norm_num : 178 < 180) h0.isBigO
    (eventual_product_lower_bound hc2.le hc3.le h2 h3)

theorem revised_margins_positive {c1 c2 c3 : ℝ} {g0 g1 g2 g3 : ℕ → ℝ}
    (hc1 : 0 < c1) (hc2 : 0 < c2) (hc3 : 0 < c3)
    (h0 : g0 =o[atTop] invPower 180)
    (h1 : ∀ᶠ T in atTop, c1 * invPower 6 T ≤ g1 T)
    (h2 : ∀ᶠ T in atTop, c2 * invPower 8 T ≤ g2 T)
    (h3 : ∀ᶠ T in atTop, c3 * invPower 170 T ≤ g3 T) :
    ∀ᶠ T in atTop, 0 < g1 T * g3 T - 2 * g0 T ∧
      0 < g2 T * g3 T - 4 * g0 T := by
  filter_upwards [eventual_subtraction_positive (mul_pos hc1 hc3)
      (by norm_num : (0 : ℝ) < 2) (by norm_num : 176 < 180) h0.isBigO
      (eventual_product_lower_bound hc1.le hc3.le h1 h3),
    eventual_subtraction_positive (mul_pos hc2 hc3)
      (by norm_num : (0 : ℝ) < 4) (by norm_num : 178 < 180) h0.isBigO
      (eventual_product_lower_bound hc2.le hc3.le h2 h3)] with T hfirst hsecond
  exact ⟨hfirst, hsecond⟩

theorem revised176_can_be_weakened_to178 {T : ℕ} (hT : 1 ≤ T) :
    invPower 178 T ≤ invPower 176 T := by
  exact invPower_antitone (by norm_num) hT

theorem revised166_can_be_weakened_to170 {T : ℕ} (hT : 1 ≤ T) :
    invPower 170 T ≤ invPower 166 T := by
  exact invPower_antitone (by norm_num) hT

/-- Existing draft0 exponent 206 alone does not supply revised exponent 170. -/
theorem rate206_does_not_supply170 : ¬ (invPower 170 =O[atTop] invPower 206) := by
  exact inverse_power_not_bigOmega_nat (by norm_num)

theorem rate212_does_not_supply176 : ¬ (invPower 176 =O[atTop] invPower 212) := by
  exact inverse_power_not_bigOmega_nat (by norm_num)

theorem rate214_does_not_supply178 : ¬ (invPower 178 =O[atTop] invPower 214) := by
  exact inverse_power_not_bigOmega_nat (by norm_num)

theorem first_arm_positive_advantage_le_exclusion (mu1 mu2 mu3 : ℝ) :
    max (mu3 - mu1) 0 ≤ max (mu3 - min mu1 mu2) 0 := by
  exact max_le_max (sub_le_sub_left (min_le_left mu1 mu2) mu3) le_rfl


