/-! ## FiniteGaussian -/
section

open MeasureTheory ProbabilityTheory
open scoped NNReal ENNReal

namespace BayesOptimal.FiniteGaussian

variable {A : Type*} [Fintype A] [Nonempty A] [DecidableEq A]

abbrev Means (A : Type*) := A → ℝ
abbrev Precisions (A : Type*) := A → ℝ≥0

noncomputable section

def maxAll (m : Means A) : ℝ :=
  Finset.univ.sup' Finset.univ_nonempty m

omit [DecidableEq A] in
theorem coordinate_le_maxAll (m : Means A) (i : A) : m i ≤ maxAll m :=
  Finset.le_sup' m (Finset.mem_univ i)

omit [DecidableEq A] in
theorem maxAll_le (m : Means A) (a : ℝ) (h : ∀ i, m i ≤ a) : maxAll m ≤ a :=
  Finset.sup'_le Finset.univ_nonempty m (fun i _ => h i)

omit [DecidableEq A] in
theorem maxAll_attained (m : Means A) : ∃ i, m i = maxAll m := by
  obtain ⟨i, _, hi⟩ := Finset.exists_mem_eq_sup' Finset.univ_nonempty m
  exact ⟨i, hi.symm⟩

def advance (c : Precisions A) (i : A) : Precisions A :=
  fun j => c j + if j = i then 1 else 0

def shift (m : Means A) (i : A) (z : ℝ) : Means A :=
  fun j => m j + if j = i then z else 0

def innovation (c : Precisions A) (i : A) : ℝ≥0 := BayesOptimal.Foundations.Gaussian.updateVariance (c i)

omit [DecidableEq A] in
theorem maxAll_lipschitz : LipschitzWith 1 (maxAll (A := A)) := by
  apply LipschitzWith.of_dist_le_mul
  intro m n
  simp only [NNReal.coe_one, one_mul, Real.dist_eq]
  apply abs_le.mpr
  have hu (m n : Means A) : maxAll m ≤ maxAll n + dist m n := by
    apply maxAll_le
    intro i
    have h := (LipschitzWith.eval i : LipschitzWith 1 (fun x : Means A => x i)).dist_le_mul m n
    simp only [NNReal.coe_one, one_mul, Real.dist_eq] at h
    have hupper := (abs_le.mp h).2
    have hcoord := coordinate_le_maxAll n i
    linarith
  have hm := hu m n
  have hn := hu n m
  rw [dist_comm n m] at hn
  constructor <;> linarith

omit [Fintype A] [Nonempty A] in
theorem shift_sub_shift (m n : Means A) (i : A) (z : ℝ) :
    shift m i z - shift n i z = m - n := by
  ext j
  simp only [shift, Pi.sub_apply]
  ring

omit [Nonempty A] in
theorem shift_norm_bound (m : Means A) (i : A) (z : ℝ) : ‖shift m i z - m‖ ≤ |z| := by
  apply (pi_norm_le_iff_of_nonneg (abs_nonneg z)).mpr
  intro j
  by_cases h : j = i <;> simp [shift, h, Real.norm_eq_abs]

omit [Fintype A] [Nonempty A] in
theorem shift_continuous (m : Means A) (i : A) : Continuous (shift m i) := by
  apply continuous_pi
  intro j
  by_cases h : j = i <;> simp [shift, h] <;> fun_prop

omit [Nonempty A] in
theorem shifted_integrable {f : Means A → ℝ} (hf : LipschitzWith 1 f)
    (m : Means A) (i : A) (v : ℝ≥0) :
    Integrable (fun z : ℝ => f (shift m i z)) (gaussianReal 0 v) := by
  have hb (z : ℝ) : ‖f (shift m i z)‖ ≤ |f m| + |z| := by
    have h := hf.dist_le_mul (shift m i z) m
    simp only [NNReal.coe_one, one_mul, dist_eq_norm, Real.norm_eq_abs] at h
    have hn := shift_norm_bound m i z
    have ht := abs_add_le (f (shift m i z) - f m) (f m)
    rw [sub_add_cancel] at ht
    rw [Real.norm_eq_abs]
    linarith
  exact ((integrable_const |f m|).add (BayesOptimal.Foundations.Gaussian.gaussian_id_integrable 0 v).norm).mono'
    (hf.continuous.comp (shift_continuous m i)).measurable.aestronglyMeasurable
    (Filter.Eventually.of_forall hb)

omit [Nonempty A] in
theorem integral_shift_lipschitz {f : Means A → ℝ} (hf : LipschitzWith 1 f)
    (i : A) (v : ℝ≥0) :
    LipschitzWith 1 (fun m => ∫ z : ℝ, f (shift m i z) ∂gaussianReal 0 v) := by
  apply LipschitzWith.of_dist_le_mul
  intro m n
  simp only [NNReal.coe_one, one_mul, dist_eq_norm]
  rw [← integral_sub (shifted_integrable hf m i v) (shifted_integrable hf n i v)]
  have hb : ∀ᵐ z : ℝ ∂gaussianReal 0 v,
      ‖f (shift m i z) - f (shift n i z)‖ ≤ ‖m - n‖ := by
    apply Filter.Eventually.of_forall
    intro z
    have h := hf.dist_le_mul (shift m i z) (shift n i z)
    simpa only [dist_eq_norm, shift_sub_shift, NNReal.coe_one, one_mul] using h
  simpa using norm_integral_le_of_norm_le_const hb

omit [DecidableEq A] in
theorem maxAll_family_lipschitz {f : A → Means A → ℝ}
    (hf : ∀ i, LipschitzWith 1 (f i)) :
    LipschitzWith 1 (fun m => maxAll (fun i => f i m)) := by
  apply LipschitzWith.of_dist_le_mul
  intro m n
  simp only [NNReal.coe_one, one_mul, Real.dist_eq]
  have hu (m n : Means A) : maxAll (fun i => f i m) ≤
      maxAll (fun i => f i n) + dist m n := by
    apply maxAll_le
    intro i
    have h := (hf i).dist_le_mul m n
    simp only [NNReal.coe_one, one_mul, Real.dist_eq] at h
    have hb := (abs_le.mp h).2
    have hi := coordinate_le_maxAll (fun i => f i n) i
    linarith
  have hm := hu m n
  have hn := hu n m
  rw [dist_comm n m] at hn
  exact abs_le.mpr ⟨by linarith, by linarith⟩

def value : ℕ → Precisions A → Means A → ℝ
  | 0, _, m => maxAll m
  | k + 1, c, m => maxAll (fun i =>
      ∫ z : ℝ, value k (advance c i) (shift m i z) ∂gaussianReal 0 (innovation c i))

def action (k : ℕ) (c : Precisions A) (m : Means A) (i : A) : ℝ :=
  ∫ z : ℝ, value k (advance c i) (shift m i z) ∂gaussianReal 0 (innovation c i)

theorem value_succ (k : ℕ) (c : Precisions A) (m : Means A) :
    value (k + 1) c m = maxAll (action k c m) := rfl

theorem value_lipschitz (k : ℕ) (c : Precisions A) : LipschitzWith 1 (value k c) := by
  induction k generalizing c with
  | zero => exact maxAll_lipschitz
  | succ k ih =>
    exact maxAll_family_lipschitz (fun i =>
      integral_shift_lipschitz (ih (advance c i)) i (innovation c i))

theorem action_integrable (k : ℕ) (c : Precisions A) (m : Means A) (i : A) :
    Integrable (fun z => value k (advance c i) (shift m i z))
      (gaussianReal 0 (innovation c i)) :=
  shifted_integrable (value_lipschitz k (advance c i)) m i (innovation c i)

theorem action_le_value (k : ℕ) (c : Precisions A) (m : Means A) (i : A) :
    action k c m i ≤ value (k + 1) c m := coordinate_le_maxAll _ i

def choose (k : ℕ) (c : Precisions A) (m : Means A) : A :=
  Classical.choose (maxAll_attained (action k c m))

def recommend (m : Means A) : A := Classical.choose (maxAll_attained m)

theorem choose_optimal (k : ℕ) (c : Precisions A) (m : Means A) :
    action k c m (choose k c m) = value (k + 1) c m :=
  Classical.choose_spec (maxAll_attained (action k c m))

omit [DecidableEq A] in
theorem recommend_max (m : Means A) : m (recommend m) = maxAll m :=
  Classical.choose_spec (maxAll_attained m)

inductive Strategy : ℕ → Type _
  | stop (i : A) : Strategy 0
  | sample {k : ℕ} (i : A) (next : ℝ → Strategy k) : Strategy (k + 1)

def utility : {k : ℕ} → Strategy (A := A) k → Precisions A → Means A → ℝ
  | 0, .stop i, _, m => m i
  | _ + 1, .sample i next, c, m =>
      ∫ z : ℝ, utility (next z) (advance c i) (shift m i z)
        ∂gaussianReal 0 (innovation c i)

def Admissible : {k : ℕ} → Strategy (A := A) k → Precisions A → Means A → Prop
  | 0, .stop _, _, _ => True
  | _ + 1, .sample i next, c, m =>
      (∀ z, Admissible (next z) (advance c i) (shift m i z)) ∧
      Integrable (fun z => utility (next z) (advance c i) (shift m i z))
        (gaussianReal 0 (innovation c i))

def optimal : (k : ℕ) → Precisions A → Means A → Strategy (A := A) k
  | 0, _, m => .stop (recommend m)
  | k + 1, c, m =>
    let i := choose k c m
    .sample i (fun z => optimal k (advance c i) (shift m i z))

theorem optimal_utility (k : ℕ) (c : Precisions A) (m : Means A) :
    utility (optimal k c m) c m = value k c m := by
  induction k generalizing c m with
  | zero => exact recommend_max m
  | succ k ih => simp only [optimal, utility, ih]; exact choose_optimal k c m

theorem optimal_admissible (k : ℕ) (c : Precisions A) (m : Means A) :
    Admissible (optimal k c m) c m := by
  induction k generalizing c m with
  | zero => trivial
  | succ k ih =>
    constructor
    · intro z; exact ih _ _
    · simp only [optimal_utility]
      exact action_integrable k c m (choose k c m)

theorem utility_le_value {k : ℕ} (s : Strategy (A := A) k) (c : Precisions A) (m : Means A)
    (hs : Admissible s c m) : utility s c m ≤ value k c m := by
  induction k generalizing c m with
  | zero => cases s with | stop i => exact coordinate_le_maxAll m i
  | succ k ih =>
    cases s with
    | sample i next =>
      exact (integral_mono hs.2 (action_integrable k c m i)
        (fun z => ih (next z) _ _ (hs.1 z))).trans (action_le_value k c m i)

/-- Theorem1's global finite-horizon optimality, for any finite nonempty arm
set and arbitrary positive real Gaussian precisions. -/
theorem optimal_dominates {k : ℕ} (s : Strategy (A := A) k)
    (c : Precisions A) (m : Means A) (hs : Admissible s c m) :
    utility s c m ≤ utility (optimal k c m) c m := by
  rw [optimal_utility]
  exact utility_le_value s c m hs

end
end BayesOptimal.FiniteGaussian

end

/-! ## FinitePosterior -/
section

open MeasureTheory ProbabilityTheory
open scoped NNReal ENNReal

namespace BayesOptimal.FinitePosterior

open BayesOptimal.FiniteGaussian

variable {A : Type*} [Fintype A] [DecidableEq A]

noncomputable section

def centeredLaw (c : Precisions A) : Measure (Means A) :=
  Measure.pi (fun a => gaussianReal 0 (c a)⁻¹)

instance centeredLaw_probability (c : Precisions A) :
    IsProbabilityMeasure (centeredLaw c) := by unfold centeredLaw; infer_instance

def posteriorLaw (c : Precisions A) (m : Means A) : Measure (Means A) :=
  Measure.map (fun x => m + x) (centeredLaw c)

instance posteriorLaw_probability (c : Precisions A) (m : Means A) :
    IsProbabilityMeasure (posteriorLaw c m) :=
  Measure.isProbabilityMeasure_map (by fun_prop)

omit [DecidableEq A] in
theorem centered_coordinate_law (c : Precisions A) (i : A) :
    (centeredLaw c).map (fun x => x i) = gaussianReal 0 (c i)⁻¹ :=
  (measurePreserving_eval (fun a => gaussianReal 0 (c a)⁻¹) i).map_eq

omit [DecidableEq A] in
theorem centered_coordinate_integrable (c : Precisions A) (i : A) :
    Integrable (fun x : Means A => x i) (centeredLaw c) := by
  have h := BayesOptimal.Foundations.Gaussian.gaussian_id_integrable 0 (c i)⁻¹
  rw [← centered_coordinate_law c i] at h
  exact h.comp_measurable (measurable_pi_apply i)

omit [DecidableEq A] in
theorem norm_le_sum_abs (x : Means A) : ‖x‖ ≤ ∑ a, |x a| := by
  have hs : 0 ≤ ∑ a, |x a| := Finset.sum_nonneg (fun _ _ => abs_nonneg _)
  apply (pi_norm_le_iff_of_nonneg hs).mpr
  intro i
  rw [Real.norm_eq_abs]
  exact Finset.single_le_sum (fun a (_ : a ∈ Finset.univ) => abs_nonneg (x a))
    (Finset.mem_univ i)

omit [DecidableEq A] in
theorem centered_sum_integrable (c : Precisions A) :
    Integrable (fun x : Means A => ∑ a, |x a|) (centeredLaw c) := by
  apply integrable_finset_sum
  intro i _
  simpa only [Real.norm_eq_abs] using (centered_coordinate_integrable c i).norm

omit [DecidableEq A] in
theorem translated_integrable {f : Means A → ℝ} (hf : LipschitzWith 1 f)
    (c : Precisions A) (m : Means A) :
    Integrable (fun x => f (m + x)) (centeredLaw c) := by
  have hb (x : Means A) : ‖f (m + x)‖ ≤ |f m| + ∑ a, |x a| := by
    have hl := hf.dist_le_mul (m + x) m
    simp only [NNReal.coe_one, one_mul, dist_eq_norm, add_sub_cancel_left] at hl
    have ht := norm_add_le (f (m + x) - f m) (f m)
    rw [sub_add_cancel, Real.norm_eq_abs (f m)] at ht
    linarith [norm_le_sum_abs x]
  exact ((integrable_const |f m|).add (centered_sum_integrable c)).mono'
    (hf.continuous.comp (by fun_prop)).measurable.aestronglyMeasurable
    (Filter.Eventually.of_forall hb)

omit [DecidableEq A] in
theorem posterior_integrable {f : Means A → ℝ} (hf : LipschitzWith 1 f)
    (c : Precisions A) (m : Means A) : Integrable f (posteriorLaw c m) := by
  apply (integrable_map_measure hf.continuous.measurable.aestronglyMeasurable
    (by fun_prop : AEMeasurable (fun x : Means A => m + x) (centeredLaw c))).mpr
  exact translated_integrable hf c m

omit [DecidableEq A] in
theorem posterior_integral {f : Means A → ℝ} (hf : LipschitzWith 1 f)
    (c : Precisions A) (m : Means A) :
    (∫ u, f u ∂posteriorLaw c m) = ∫ x, f (m + x) ∂centeredLaw c := by
  exact integral_map (by fun_prop) hf.continuous.measurable.aestronglyMeasurable

omit [DecidableEq A] in
theorem posterior_coordinate_law (c : Precisions A) (m : Means A) (i : A) :
    (posteriorLaw c m).map (fun x => x i) = gaussianReal (m i) (c i)⁻¹ := by
  unfold posteriorLaw
  rw [Measure.map_map (measurable_pi_apply i) (by fun_prop)]
  have h := gaussianReal_map_const_add (μ := (0 : ℝ)) (v := (c i)⁻¹) (m i)
  rw [← centered_coordinate_law c i] at h
  rw [Measure.map_map (g := fun x : ℝ => m i + x) (f := fun x : Means A => x i)
    (by fun_prop) (measurable_pi_apply i)] at h
  simpa only [Function.comp_def, Pi.add_apply, zero_add] using h

omit [DecidableEq A] in
theorem posterior_coordinate_integrable (c : Precisions A) (m : Means A) (i : A) :
    Integrable (fun x : Means A => x i) (posteriorLaw c m) :=
  posterior_integrable (LipschitzWith.eval i) c m

omit [DecidableEq A] in
theorem posterior_coordinate_mean (c : Precisions A) (m : Means A) (i : A) :
    (∫ u, u i ∂posteriorLaw c m) = m i := by
  have h := integral_id_gaussianReal (μ := m i) (v := (c i)⁻¹)
  rw [← posterior_coordinate_law c m i,
    integral_map (measurable_pi_apply i).aemeasurable (by fun_prop)] at h
  exact h

def otherLaw (c : Precisions A) (i : A) : Measure ({a : A // a ≠ i} → ℝ) :=
  Measure.pi (fun a => gaussianReal 0 (c a)⁻¹)

instance otherLaw_probability (c : Precisions A) (i : A) :
    IsProbabilityMeasure (otherLaw c i) := by unfold otherLaw; infer_instance

def join (i : A) (x : ℝ × ({a : A // a ≠ i} → ℝ)) : Means A :=
  fun a => if h : a = i then x.1 else x.2 ⟨a, h⟩

omit [Fintype A] in
theorem join_continuous (i : A) : Continuous (join i) := by
  apply continuous_pi
  intro a
  by_cases h : a = i <;> simp only [join, h, dite_true, dite_false] <;> fun_prop

theorem join_law (c : Precisions A) (i : A) :
    Measure.map (join i) ((gaussianReal 0 (c i)⁻¹).prod (otherLaw c i)) = centeredLaw c := by
  symm
  apply Measure.pi_eq
  intro s hs
  rw [Measure.map_apply (join_continuous i).measurable (MeasurableSet.univ_pi hs)]
  have he : join i ⁻¹' Set.pi Set.univ s =
      s i ×ˢ Set.pi Set.univ (fun a : {a : A // a ≠ i} => s a) := by
    ext x
    simp only [Set.mem_preimage, Set.mem_pi, Set.mem_univ, forall_true_left,
      Set.mem_prod, join]
    constructor
    · intro h
      exact ⟨by simpa using h i, fun a => by simpa [a.property] using h a⟩
    · rintro ⟨hi, ho⟩ a
      split_ifs with ha
      · subst a; exact hi
      · exact ho ⟨a, ha⟩
  rw [he, Measure.prod_prod, otherLaw, Measure.pi_pi]
  letI : Unique {a : A // a = i} :=
    ⟨⟨i, rfl⟩, fun a => Subtype.ext a.property⟩
  have hprod := Fintype.prod_subtype_mul_prod_subtype (fun a : A => a = i)
    (fun a => (gaussianReal 0 (c a)⁻¹) (s a))
  simpa only [Fintype.prod_unique] using hprod

theorem join_integrable {f : Means A → ℝ} (hf : LipschitzWith 1 f)
    (c : Precisions A) (m : Means A) (i : A) :
    Integrable (fun x => f (m + join i x))
      ((gaussianReal 0 (c i)⁻¹).prod (otherLaw c i)) := by
  have h := translated_integrable hf c m
  rw [← join_law c i] at h
  exact h.comp_measurable (join_continuous i).measurable

def expectation (f : Means A → ℝ) (c : Precisions A) (m : Means A) : ℝ :=
  ∫ x, f (m + x) ∂centeredLaw c

omit [DecidableEq A] in
theorem expectation_lipschitz {f : Means A → ℝ} (hf : LipschitzWith 1 f)
    (c : Precisions A) : LipschitzWith 1 (expectation f c) := by
  apply LipschitzWith.of_dist_le_mul
  intro m n
  simp only [NNReal.coe_one, one_mul, dist_eq_norm]
  unfold expectation
  rw [← integral_sub (translated_integrable hf c m) (translated_integrable hf c n)]
  have hb : ∀ᵐ x ∂centeredLaw c, ‖f (m + x) - f (n + x)‖ ≤ ‖m - n‖ := by
    apply Filter.Eventually.of_forall
    intro x
    have h := hf.dist_le_mul (m + x) (n + x)
    simpa only [dist_eq_norm, NNReal.coe_one, one_mul, add_sub_add_right_eq_sub] using h
  simpa using norm_integral_le_of_norm_le_const hb

theorem expectation_split {f : Means A → ℝ} (hf : LipschitzWith 1 f)
    (c : Precisions A) (m : Means A) (i : A) :
    expectation f c m = ∫ u, ∫ x : ℝ, f (m + join i (x, u))
      ∂gaussianReal 0 (c i)⁻¹ ∂otherLaw c i := by
  unfold expectation
  rw [← join_law c i]
  rw [integral_map (f := fun x : Means A => f (m + x))
    (join_continuous i).measurable.aemeasurable
    (hf.continuous.comp (by fun_prop)).measurable.aestronglyMeasurable,
    integral_prod _ (join_integrable hf c m i),
    integral_integral_swap (join_integrable hf c m i)]

def smooth (f : Means A → ℝ) (i : A) (v : ℝ≥0) (m : Means A) : ℝ :=
  ∫ z : ℝ, f (shift m i z) ∂gaussianReal 0 v

theorem smooth_lipschitz {f : Means A → ℝ} (hf : LipschitzWith 1 f)
    (i : A) (v : ℝ≥0) : LipschitzWith 1 (smooth f i v) :=
  integral_shift_lipschitz hf i v

omit [Fintype A] in
theorem shift_same (m : Means A) (i : A) (x y : ℝ) :
    shift (shift m i x) i y = shift m i (x + y) := by
  ext a
  by_cases h : a = i <;> simp [shift, h, add_assoc]

omit [Fintype A] in
theorem shift_zero (m : Means A) (i : A) : shift m i 0 = m := by
  ext a
  simp [shift]

theorem smooth_add {f : Means A → ℝ} (hf : LipschitzWith 1 f)
    (i : A) (v w : ℝ≥0) :
    smooth (smooth f i w) i v = smooth f i (v + w) := by
  funext m
  unfold smooth
  have hconv : gaussianReal 0 v ∗ gaussianReal 0 w = gaussianReal 0 (v + w) := by
    simpa using gaussianReal_conv_gaussianReal (m₁ := (0 : ℝ)) (m₂ := (0 : ℝ))
  have hi : Integrable (fun z : ℝ => f (shift m i z))
      (gaussianReal 0 v ∗ gaussianReal 0 w) := by
    rw [hconv]
    exact shifted_integrable hf m i (v + w)
  rw [← hconv, integral_conv hi]
  congr 1
  funext x
  congr 1
  funext y
  rw [shift_same]

omit [Fintype A] in
theorem shift_join (m : Means A) (i : A) (u : {a : A // a ≠ i} → ℝ) (z x : ℝ) :
    shift (shift m i z + join i (0, u)) i x = shift m i z + join i (x, u) := by
  ext a
  by_cases h : a = i <;> simp [shift, join, h, Pi.add_apply]

omit [Fintype A] in
theorem shift_add_join (m : Means A) (i : A) (u : {a : A // a ≠ i} → ℝ) (z : ℝ) :
    shift m i z + join i (0, u) = shift (m + join i (0, u)) i z := by
  ext a
  simp only [shift, Pi.add_apply]
  ring

theorem expectation_split_smooth {f : Means A → ℝ} (hf : LipschitzWith 1 f)
    (c : Precisions A) (m : Means A) (i : A) :
    expectation f c m = ∫ u, smooth f i (c i)⁻¹ (m + join i (0, u)) ∂otherLaw c i := by
  rw [expectation_split hf c m i]
  congr 1
  funext u
  unfold smooth
  congr 1
  funext x
  have h := shift_join m i u 0 x
  simpa only [shift_zero] using congrArg f h.symm

theorem join_zero_norm_bound (i : A) (u : {a : A // a ≠ i} → ℝ) :
    ‖join i (0, u)‖ ≤ ∑ a, |u a| := by
  apply (pi_norm_le_iff_of_nonneg (Finset.sum_nonneg (fun _ _ => abs_nonneg _))).mpr
  intro a
  by_cases h : a = i
  · simp only [join, h, dite_true, norm_zero]
    exact Finset.sum_nonneg (fun _ _ => abs_nonneg _)
  · simp only [join, h, dite_false, Real.norm_eq_abs]
    exact Finset.single_le_sum (fun b (_ : b ∈ Finset.univ) => abs_nonneg (u b))
      (Finset.mem_univ (⟨a, h⟩ : {a : A // a ≠ i}))

theorem shift_join_integrable {f : Means A → ℝ} (hf : LipschitzWith 1 f)
    (c : Precisions A) (m : Means A) (i : A) (v : ℝ≥0) :
    Integrable (fun p : ℝ × ({a : A // a ≠ i} → ℝ) =>
      f (shift m i p.1 + join i (0, p.2)))
      ((gaussianReal 0 v).prod (otherLaw c i)) := by
  have hiu : Integrable (fun u : {a : A // a ≠ i} → ℝ => ∑ a, |u a|)
      (otherLaw c i) := centered_sum_integrable (fun a : {a : A // a ≠ i} => c a)
  have hb (p : ℝ × ({a : A // a ≠ i} → ℝ)) :
      ‖f (shift m i p.1 + join i (0, p.2))‖ ≤ |f m| + |p.1| + ∑ a, |p.2 a| := by
    have hl := hf.dist_le_mul (shift m i p.1 + join i (0, p.2)) m
    simp only [NNReal.coe_one, one_mul, dist_eq_norm] at hl
    have hn : ‖shift m i p.1 + join i (0, p.2) - m‖ ≤ |p.1| + ∑ a, |p.2 a| := by
      have he : shift m i p.1 + join i (0, p.2) - m =
          (shift m i p.1 - m) + join i (0, p.2) := by abel
      rw [he]
      exact (norm_add_le _ _).trans (add_le_add (shift_norm_bound m i p.1)
        (join_zero_norm_bound i p.2))
    have ht := norm_add_le (f (shift m i p.1 + join i (0, p.2)) - f m) (f m)
    rw [sub_add_cancel, Real.norm_eq_abs (f m)] at ht
    linarith
  have hcont : Continuous (fun p : ℝ × ({a : A // a ≠ i} → ℝ) =>
      shift m i p.1 + join i (0, p.2)) :=
    ((shift_continuous m i).comp continuous_fst).add
      ((join_continuous i).comp (continuous_const.prodMk continuous_snd))
  exact (((integrable_const |f m|).add
    ((BayesOptimal.Foundations.Gaussian.gaussian_id_integrable 0 v).norm.comp_fst (otherLaw c i))).add
    (hiu.comp_snd (gaussianReal 0 v))).mono'
      (hf.continuous.comp hcont).measurable.aestronglyMeasurable
      (Filter.Eventually.of_forall hb)

theorem otherLaw_advance (c : Precisions A) (i : A) :
    otherLaw (advance c i) i = otherLaw c i := by
  unfold otherLaw
  congr 1
  funext a
  simp [advance, a.property]

theorem variance_split (c : ℝ≥0) (hc : 0 < c) :
    c⁻¹ = BayesOptimal.Foundations.Gaussian.updateVariance c + (c + 1)⁻¹ := by
  have h := BayesOptimal.Foundations.Gaussian.posteriorVariance_after_draw c 0 hc
  simpa [BayesOptimal.Foundations.Gaussian.posteriorVariance] using h

/-- Exact posterior tower for every arm and every integrable Lipschitz payoff,
under the actual independent finite product Gaussian posterior. -/
theorem expectation_tower {f : Means A → ℝ} (hf : LipschitzWith 1 f)
    (c : Precisions A) (m : Means A) (i : A) (hc : 0 < c i) :
    (∫ z : ℝ, expectation f (advance c i) (shift m i z)
      ∂gaussianReal 0 (innovation c i)) = expectation f c m := by
  have he (z : ℝ) := expectation_split_smooth hf (advance c i) (shift m i z) i
  simp_rw [he]
  rw [otherLaw_advance]
  have hci : advance c i i = c i + 1 := by simp [advance]
  rw [hci]
  rw [integral_integral_swap
    (shift_join_integrable (smooth_lipschitz hf i (c i + 1)⁻¹) c m i (innovation c i))]
  rw [expectation_split_smooth hf c m i]
  congr 1
  funext u
  simp_rw [shift_add_join]
  change smooth (smooth f i (c i + 1)⁻¹) i (innovation c i) _ =
    smooth f i (c i)⁻¹ _
  rw [smooth_add hf]
  unfold innovation
  rw [← variance_split (c i) hc]

section Nonempty
variable [Nonempty A]

def potential (c : Precisions A) (m : Means A) : ℝ := expectation maxAll c m

omit [DecidableEq A] in
theorem potential_lipschitz (c : Precisions A) : LipschitzWith 1 (potential c) :=
  expectation_lipschitz maxAll_lipschitz c

omit [DecidableEq A] in
theorem potential_eq_posterior (c : Precisions A) (m : Means A) :
    potential c m = ∫ u, maxAll u ∂posteriorLaw c m :=
  (posterior_integral maxAll_lipschitz c m).symm

theorem potential_tower (c : Precisions A) (m : Means A) (i : A) (hc : 0 < c i) :
    (∫ z : ℝ, potential (advance c i) (shift m i z)
      ∂gaussianReal 0 (innovation c i)) = potential c m :=
  expectation_tower maxAll_lipschitz c m i hc

def terminalRegret (c : Precisions A) (m : Means A) (i : A) : ℝ :=
  ∫ u, maxAll u - u i ∂posteriorLaw c m

omit [DecidableEq A] in
theorem terminalRegret_eq (c : Precisions A) (m : Means A) (i : A) :
    terminalRegret c m i = potential c m - m i := by
  unfold terminalRegret
  rw [integral_sub (posterior_integrable maxAll_lipschitz c m)
    (posterior_coordinate_integrable c m i), ← potential_eq_posterior,
    posterior_coordinate_mean]

def loss (k : ℕ) (c : Precisions A) (m : Means A) : ℝ := potential c m - value k c m

def actionLoss (k : ℕ) (c : Precisions A) (m : Means A) (i : A) : ℝ :=
  ∫ z : ℝ, loss k (advance c i) (shift m i z) ∂gaussianReal 0 (innovation c i)

theorem actionLoss_eq (k : ℕ) (c : Precisions A) (m : Means A) (i : A) (hc : 0 < c i) :
    actionLoss k c m i = potential c m - action k c m i := by
  unfold actionLoss loss action
  rw [integral_sub (shifted_integrable (potential_lipschitz _) m i _)
    (action_integrable k c m i), potential_tower c m i hc]

def expectedRegret : {k : ℕ} → Strategy (A := A) k → Precisions A → Means A → ℝ
  | 0, .stop i, c, m => terminalRegret c m i
  | _ + 1, .sample i next, c, m =>
      ∫ z : ℝ, expectedRegret (next z) (advance c i) (shift m i z)
        ∂gaussianReal 0 (innovation c i)

omit [Fintype A] [Nonempty A] in
theorem advance_positive (c : Precisions A) (i : A) (hc : ∀ a, 0 < c a) :
    ∀ a, 0 < advance c i a := by
  intro a
  unfold advance
  exact lt_of_lt_of_le (hc a) (le_add_of_nonneg_right (by positivity))

/-- Recursive expected regret has the actual latent Gaussian simple-regret
integral at its leaves; the additive potential is proved, rather than assumed. -/
theorem expectedRegret_eq {k : ℕ} (s : Strategy (A := A) k)
    (c : Precisions A) (m : Means A) (hs : Admissible s c m) (hc : ∀ a, 0 < c a) :
    expectedRegret s c m = potential c m - utility s c m := by
  induction k generalizing c m with
  | zero => cases s with | stop i => exact terminalRegret_eq c m i
  | succ k ih =>
    cases s with
    | sample i next =>
      change (∫ z, expectedRegret (next z) (advance c i) (shift m i z)
        ∂gaussianReal 0 (innovation c i)) = _
      have he (z : ℝ) := ih (next z) (advance c i) (shift m i z) (hs.1 z)
        (advance_positive c i hc)
      simp_rw [he]
      rw [integral_sub (shifted_integrable (potential_lipschitz _) m i _) hs.2,
        potential_tower c m i (hc i)]
      rfl

/-- Theorem1 for any finite nonempty arm set and arbitrary positive real
posterior precisions, using actual posterior expected simple regret. -/
theorem theorem1_global_bayes_optimality {k : ℕ} (s : Strategy (A := A) k)
    (c : Precisions A) (m : Means A) (hs : Admissible s c m) (hc : ∀ a, 0 < c a) :
    expectedRegret (optimal k c m) c m ≤ expectedRegret s c m := by
  rw [expectedRegret_eq _ _ _ (optimal_admissible k c m) hc,
    expectedRegret_eq s c m hs hc, optimal_utility]
  exact sub_le_sub_left (utility_le_value s c m hs) _

/-- External randomization may choose any admissible adaptive strategy tree.
Its actual expected regret is the integral over that independent seed. -/
theorem theorem1_randomized_bayes_optimality {S : Type*} [MeasurableSpace S]
    (seedLaw : Measure S) [IsProbabilityMeasure seedLaw] {k : ℕ}
    (s : S → Strategy (A := A) k) (c : Precisions A) (m : Means A)
    (hs : ∀ᵐ r ∂seedLaw, Admissible (s r) c m) (hc : ∀ a, 0 < c a)
    (hi : Integrable (fun r => expectedRegret (s r) c m) seedLaw) :
    expectedRegret (optimal k c m) c m ≤ ∫ r, expectedRegret (s r) c m ∂seedLaw := by
  have h := integral_mono_ae (integrable_const (expectedRegret (optimal k c m) c m)) hi
    (hs.mono (fun r hr => theorem1_global_bayes_optimality (s r) c m hr hc))
  simpa using h

end Nonempty

end
end BayesOptimal.FinitePosterior

end

/-! ## FiniteModelExclusion -/
section

open MeasureTheory ProbabilityTheory
open scoped NNReal ENNReal

namespace BayesOptimal.FiniteModelExclusion

open BayesOptimal.FiniteGaussian BayesOptimal.FinitePosterior BayesOptimal.Foundations.Gaussian

variable {A : Type*} [Fintype A] [Nonempty A] [DecidableEq A]

noncomputable section

omit [Nonempty A] [DecidableEq A] in
theorem posteriorLaw_eq_pi (c : Precisions A) (m : Means A) :
    posteriorLaw c m = Measure.pi (fun a => gaussianReal (m a) (c a)⁻¹) := by
  unfold posteriorLaw centeredLaw
  change (Measure.pi (fun a => gaussianReal 0 (c a)⁻¹)).map
    (fun x a => m a + x a) = _
  rw [Measure.pi_map_pi (fun a => (by fun_prop :
    AEMeasurable (fun x : ℝ => m a + x) (gaussianReal 0 (c a)⁻¹)))]
  simp only [gaussianReal_map_const_add, zero_add]

def pairSlack (c : Precisions A) (m : Means A) (i j : A) : ℝ :=
  hingeLoss (m j - m i) ((c i)⁻¹ + (c j)⁻¹)

omit [Fintype A] [Nonempty A] [DecidableEq A] in
theorem pairSlack_nonnegative (c : Precisions A) (m : Means A) (i j : A) :
    0 ≤ pairSlack c m i j := hingeLoss_nonnegative _ _

omit [Nonempty A] [DecidableEq A] in
theorem pairSlack_eq_integral (c : Precisions A) (m : Means A) (i j : A) (hij : i ≠ j) :
    pairSlack c m i j = ∫ u, max (u i - u j) 0 ∂posteriorLaw c m := by
  have hiInd : iIndepFun (fun a (u : Means A) => u a) (posteriorLaw c m) := by
    rw [posteriorLaw_eq_pi]
    exact iIndepFun_pi (fun _ => aemeasurable_id)
  have hInd := (hiInd.indepFun hij).comp measurable_id measurable_neg
  have hneg : (posteriorLaw c m).map (fun u => -u j) = gaussianReal (-m j) (c j)⁻¹ := by
    have h := gaussianReal_map_neg (μ := m j) (v := (c j)⁻¹)
    rw [← posterior_coordinate_law c m j] at h
    rw [Measure.map_map (f := fun u : Means A => u j) (g := fun x : ℝ => -x)
      (by fun_prop) (measurable_pi_apply j)] at h
    exact h
  have hlaw := gaussianReal_add_gaussianReal_of_indepFun hInd
    (posterior_coordinate_law c m i) hneg
  have hdist : (posteriorLaw c m).map (fun u => u i - u j) =
      gaussianReal (m i - m j) ((c i)⁻¹ + (c j)⁻¹) := by
    simpa only [Function.comp_def, id_eq, Pi.add_apply, sub_eq_add_neg] using hlaw
  have hmap := gaussianReal_map_const_add (μ := (0 : ℝ))
    (v := (c i)⁻¹ + (c j)⁻¹) (m i - m j)
  simp only [zero_add] at hmap
  have hpos : Integrable (fun x : ℝ => max x 0)
      (gaussianReal (m i - m j) ((c i)⁻¹ + (c j)⁻¹)) :=
    (gaussian_id_integrable _ _).pos_part
  rw [← hdist] at hpos
  rw [← integral_map (by fun_prop) hpos.aestronglyMeasurable, hdist,
    ← hmap, integral_map (by fun_prop) (by fun_prop)]
  unfold pairSlack hingeLoss
  congr 1
  funext x
  congr 1
  ring

section Removed
variable (i : A) [Nonempty {a : A // a ≠ i}]

def otherMaximum (m : Means A) : ℝ := maxAll (fun a : {a : A // a ≠ i} => m a)

def otherMinimum (m : Means A) : ℝ := -maxAll (fun a : {a : A // a ≠ i} => -m a)

omit [Nonempty A] [Nonempty {a : A // a ≠ i}] in
theorem restriction_lipschitz :
    LipschitzWith 1 (fun m : Means A => fun a : {a : A // a ≠ i} => m a) := by
  apply LipschitzWith.of_dist_le_mul
  intro m n
  simp only [NNReal.coe_one, one_mul, dist_eq_norm]
  apply (pi_norm_le_iff_of_nonneg (norm_nonneg (m - n))).mpr
  intro a
  have h := (LipschitzWith.eval (a : A) : LipschitzWith 1 (fun m : Means A => m a)).dist_le_mul m n
  simpa only [dist_eq_norm, NNReal.coe_one, one_mul, Pi.sub_apply] using h

omit [Nonempty A] in
theorem otherMaximum_lipschitz : LipschitzWith 1 (otherMaximum i) := by
  simpa only [one_mul] using maxAll_lipschitz.comp (restriction_lipschitz i)

omit [Nonempty A] in
theorem otherMinimum_lipschitz : LipschitzWith 1 (otherMinimum i) := by
  have hn : LipschitzWith 1 (fun m : Means A => fun a : {a : A // a ≠ i} => -m a) :=
    (restriction_lipschitz i).neg
  simpa only [one_mul] using (maxAll_lipschitz.comp hn).neg

def exclusion (c : Precisions A) (m : Means A) : ℝ :=
  ∫ u, max (u i - otherMinimum i u) 0 ∂posteriorLaw c m

omit [Nonempty A] in
theorem exclusion_integrable (c : Precisions A) (m : Means A) :
    Integrable (fun u => max (u i - otherMinimum i u) 0) (posteriorLaw c m) :=
  ((posterior_coordinate_integrable c m i).sub
    (posterior_integrable (otherMinimum_lipschitz i) c m)).pos_part

omit [Nonempty A] in
theorem pairSlack_le_exclusion (c : Precisions A) (m : Means A) (j : A) (hji : j ≠ i) :
    pairSlack c m i j ≤ exclusion i c m := by
  rw [pairSlack_eq_integral c m i j hji.symm]
  apply integral_mono ((posterior_coordinate_integrable c m i).sub
    (posterior_coordinate_integrable c m j)).pos_part (exclusion_integrable i c m)
  intro u
  have hmin : otherMinimum i u ≤ u j := by
    have h := coordinate_le_maxAll (fun a : {a : A // a ≠ i} => -u a) ⟨j, hji⟩
    unfold otherMinimum
    linarith
  exact max_le_max (sub_le_sub_left hmin _) le_rfl

def reducedValue : ℕ → Precisions A → Means A → ℝ
  | 0, _, m => otherMaximum i m
  | k + 1, c, m => maxAll (fun a =>
      ∫ z : ℝ, reducedValue k (advance c a) (shift m a z)
        ∂gaussianReal 0 (innovation c a))

def reducedAction (k : ℕ) (c : Precisions A) (m : Means A) (a : A) : ℝ :=
  ∫ z : ℝ, reducedValue i k (advance c a) (shift m a z)
    ∂gaussianReal 0 (innovation c a)

theorem reducedValue_lipschitz (k : ℕ) (c : Precisions A) :
    LipschitzWith 1 (reducedValue i k c) := by
  induction k generalizing c with
  | zero => exact otherMaximum_lipschitz i
  | succ k ih => exact maxAll_family_lipschitz (fun a =>
      integral_shift_lipschitz (ih (advance c a)) a (innovation c a))

theorem reducedAction_integrable (k : ℕ) (c : Precisions A) (m : Means A) (a : A) :
    Integrable (fun z => reducedValue i k (advance c a) (shift m a z))
      (gaussianReal 0 (innovation c a)) :=
  shifted_integrable (reducedValue_lipschitz i k (advance c a)) m a (innovation c a)

omit [Nonempty A] [Fintype A] in
theorem advance_comm (c : Precisions A) (a b : A) :
    advance (advance c a) b = advance (advance c b) a := by
  ext j
  simp only [advance, add_right_comm]

omit [Nonempty A] [Fintype A] in
theorem shift_comm (m : Means A) (a b : A) (x y : ℝ) :
    shift (shift m a x) b y = shift (shift m b y) a x := by
  ext j
  simp only [shift]
  ring

theorem reducedValue_removed_irrelevant (k : ℕ) (c : Precisions A) (m : Means A) (z : ℝ) :
    reducedValue i k (advance c i) (shift m i z) = reducedValue i k c m := by
  induction k generalizing c m z with
  | zero =>
    unfold reducedValue otherMaximum
    congr 1
    funext a
    simp [shift, a.property]
  | succ k ih =>
    unfold reducedValue
    congr 1
    funext a
    by_cases hai : a = i
    · subst a
      simp_rw [ih]
      simp
    · have hv : innovation (advance c i) a = innovation c a := by
        simp [innovation, advance, hai]
      rw [hv]
      congr 1
      funext x
      rw [advance_comm c i a, shift_comm m i a z x, ih]

theorem reducedAction_removed (k : ℕ) (c : Precisions A) (m : Means A) :
    reducedAction i k c m i = reducedValue i k c m := by
  unfold reducedAction
  simp_rw [reducedValue_removed_irrelevant]
  simp

omit [Fintype A] [Nonempty A] [Nonempty {a : A // a ≠ i}] in
theorem pairSlack_draw_integrable (c : Precisions A) (m : Means A) (j a : A)
    (hji : j ≠ i) :
    Integrable (fun z => pairSlack (advance c a) (shift m a z) i j)
      (gaussianReal 0 (innovation c a)) := by
  by_cases hai : a = i
  · subst a
    simpa [pairSlack, advance, shift, hji, innovation, sub_sub] using
      BayesOptimal.Foundations.ThreeArmComparison.hingeLoss_shift_integrable (m j - m i)
        (updateVariance (c i)) ((c i + 1)⁻¹ + (c j)⁻¹)
  · by_cases haj : a = j
    · subst a
      simpa [pairSlack, advance, shift, hji, hji.symm, innovation, sub_eq_add_neg,
        add_assoc, add_left_comm, add_comm] using
        BayesOptimal.Foundations.ThreeArmComparison.hingeLoss_add_integrable (m j - m i)
          (updateVariance (c j)) ((c i)⁻¹ + (c j + 1)⁻¹)
    · simp [pairSlack, advance, shift, Ne.symm hai, Ne.symm haj]

omit [Fintype A] [Nonempty A] [Nonempty {a : A // a ≠ i}] in
theorem pairSlack_tower (c : Precisions A) (m : Means A) (j a : A)
    (hji : j ≠ i) (hc : ∀ b, 0 < c b) :
    (∫ z, pairSlack (advance c a) (shift m a z) i j
      ∂gaussianReal 0 (innovation c a)) = pairSlack c m i j := by
  by_cases hai : a = i
  · subst a
    have h := BayesOptimal.Foundations.ThreeArmComparison.hingeLoss_shift_tower (m j - m i)
      (updateVariance (c i)) ((c i + 1)⁻¹ + (c j)⁻¹)
    have hv := posteriorVariance_after_draw (c i) (c j) (hc i)
    unfold posteriorVariance at hv
    rw [← hv] at h
    simpa [pairSlack, advance, shift, hji, innovation, posteriorVariance, sub_sub] using h
  · by_cases haj : a = j
    · subst a
      have h := BayesOptimal.Foundations.ThreeArmComparison.hingeLoss_add_tower (m j - m i)
        (updateVariance (c j)) ((c i)⁻¹ + (c j + 1)⁻¹)
      have hv := posteriorVariance_after_draw (c j) (c i) (hc j)
      unfold posteriorVariance at hv
      rw [add_comm (c i)⁻¹ (c j + 1)⁻¹, ← hv,
        add_comm (c j)⁻¹ (c i)⁻¹] at h
      simpa [pairSlack, advance, shift, hji, hji.symm, innovation, sub_eq_add_neg,
        add_assoc, add_left_comm, add_comm] using h
    · simp [pairSlack, advance, shift, Ne.symm hai, Ne.symm haj]

theorem value_comparison (k : ℕ) (c : Precisions A) (m : Means A) (j : A)
    (hji : j ≠ i) (hc : ∀ a, 0 < c a) :
    reducedValue i k c m ≤ value k c m ∧
      value k c m ≤ reducedValue i k c m + pairSlack c m i j := by
  induction k generalizing c m with
  | zero =>
    constructor
    · apply maxAll_le
      intro a
      exact coordinate_le_maxAll m a
    · apply maxAll_le
      intro a
      by_cases hai : a = i
      · subst a
        have hm := coordinate_le_maxAll (fun b : {a : A // a ≠ i} => m b) ⟨j, hji⟩
        have hp := BayesOptimal.Foundations.ThreeArmComparison.positivePart_le_hingeLoss (m j - m i)
          ((c i)⁻¹ + (c j)⁻¹)
        have hmi := le_max_left (-(m j - m i)) (0 : ℝ)
        change m i ≤ otherMaximum i m + pairSlack c m i j
        unfold otherMaximum pairSlack
        linarith
      · have hm := coordinate_le_maxAll (fun b : {a : A // a ≠ i} => m b) ⟨a, hai⟩
        have hp := pairSlack_nonnegative c m i j
        change m a ≤ otherMaximum i m + pairSlack c m i j
        unfold otherMaximum
        linarith
  | succ k ih =>
    constructor
    · apply maxAll_le
      intro a
      exact (integral_mono (reducedAction_integrable i k c m a)
        (action_integrable k c m a) (fun z =>
          (ih (advance c a) (shift m a z) (advance_positive c a hc)).1)).trans
        (action_le_value k c m a)
    · apply maxAll_le
      intro a
      have hupper := integral_mono (action_integrable k c m a)
        ((reducedAction_integrable i k c m a).add (pairSlack_draw_integrable i c m j a hji))
        (fun z => (ih (advance c a) (shift m a z) (advance_positive c a hc)).2)
      dsimp only [Pi.add_apply] at hupper
      rw [integral_add (reducedAction_integrable i k c m a)
        (pairSlack_draw_integrable i c m j a hji), pairSlack_tower i c m j a hji hc] at hupper
      exact hupper.trans (add_le_add_right (coordinate_le_maxAll
        (reducedAction i k c m) a) _)

/-- Lemma12 for arbitrary finite arm sets, real positive posterior precisions,
every arm, and every finite remaining horizon. The bound is the actual
posterior expectation of the arm's advantage over the minimum other mean. -/
theorem lemma12_finite (k : ℕ) (c : Precisions A) (m : Means A) (j : A)
    (hji : j ≠ i) (hc : ∀ a, 0 < c a) :
    loss k c m - actionLoss k c m i ≤ exclusion i c m := by
  rw [actionLoss_eq k c m i (hc i)]
  unfold loss
  have hupper := integral_mono (action_integrable k c m i)
    ((reducedAction_integrable i k c m i).add (pairSlack_draw_integrable i c m j i hji))
    (fun z => (value_comparison i k (advance c i) (shift m i z) j hji
      (advance_positive c i hc)).2)
  dsimp only [Pi.add_apply] at hupper
  rw [integral_add (reducedAction_integrable i k c m i)
    (pairSlack_draw_integrable i c m j i hji), pairSlack_tower i c m j i hji hc] at hupper
  change action k c m i ≤ reducedAction i k c m i + pairSlack c m i j at hupper
  rw [reducedAction_removed] at hupper
  have hlower := (value_comparison i k c m j hji hc).1
  have hR := pairSlack_le_exclusion i c m j hji
  linarith

end Removed

instance others_nonempty [Nontrivial A] (i : A) : Nonempty {a : A // a ≠ i} := by
  obtain ⟨j, hji⟩ := exists_ne i
  exact ⟨⟨j, hji⟩⟩

/-- Nontriviality of a finite arm type is exactly the requirement of at least
two arms. Every removed arm is covered, without fixing an anchor in the bound. -/
theorem lemma12_any_finite_arm [Nontrivial A] (k : ℕ) (c : Precisions A)
    (m : Means A) (i : A) (hc : ∀ a, 0 < c a) :
    loss k c m - actionLoss k c m i ≤ exclusion i c m := by
  obtain ⟨j, hji⟩ := exists_ne i
  exact lemma12_finite i k c m j hji hc

end
end BayesOptimal.FiniteModelExclusion

end

/-! ## MockStream -/
section

open MeasureTheory ProbabilityTheory
open scoped NNReal ENNReal

namespace BayesOptimal.MockStream

open BayesOptimal.FiniteGaussian BayesOptimal.FinitePosterior BayesOptimal.FiniteModelExclusion

variable {A : Type*} [Fintype A] [DecidableEq A]

noncomputable section

/-- A finite reward array, indexed by arm and calendar sampling opportunity.
Unused entries remain independent Gaussian noise conditional on the latent means. -/
abbrev RawStream (A : Type*) (H : ℕ) := A → Fin H → ℝ
abbrev Block (H : ℕ) := ℝ × (Fin H → ℝ)
abbrev OtherData (A : Type*) (H : ℕ) (i : A) :=
  ({a : A // a ≠ i} → ℝ) × ({a : A // a ≠ i} → Fin H → ℝ)
abbrev World (A : Type*) (H : ℕ) (i : A) := (Block H × Block H) × OtherData A H i

def noiseLaw (H : ℕ) : Measure (Fin H → ℝ) :=
  Measure.pi (fun _ => gaussianReal 0 1)

instance noiseLaw_probability (H : ℕ) : IsProbabilityMeasure (noiseLaw H) := by
  unfold noiseLaw; infer_instance

def blockLaw (H : ℕ) (v : ℝ≥0) : Measure (Block H) :=
  (gaussianReal 0 v).prod (noiseLaw H)

instance blockLaw_probability (H : ℕ) (v : ℝ≥0) :
    IsProbabilityMeasure (blockLaw H v) := by unfold blockLaw; infer_instance

def otherDataLaw (H : ℕ) (c : Precisions A) (i : A) : Measure (OtherData A H i) :=
  (otherLaw c i).prod (Measure.pi (fun _ : {a : A // a ≠ i} => noiseLaw H))

instance otherDataLaw_probability (H : ℕ) (c : Precisions A) (i : A) :
    IsProbabilityMeasure (otherDataLaw H c i) := by unfold otherDataLaw; infer_instance

/-- The real arm-i latent/noise block and its independent posterior-predictive
copy are independent of each other and all the remaining arms' latent/noise data. -/
def law (H : ℕ) (c : Precisions A) (i : A) : Measure (World A H i) :=
  ((blockLaw H (c i)⁻¹).prod (blockLaw H (c i)⁻¹)).prod (otherDataLaw H c i)

instance law_probability (H : ℕ) (c : Precisions A) (i : A) :
    IsProbabilityMeasure (law H c i) := by unfold law; infer_instance

def swap (H : ℕ) (i : A) (w : World A H i) : World A H i :=
  ((w.1.2, w.1.1), w.2)

theorem swap_preserving (H : ℕ) (c : Precisions A) (i : A) :
    MeasurePreserving (swap H i) (law H c i) (law H c i) := by
  exact (Measure.measurePreserving_swap (μ := blockLaw H (c i)⁻¹)
    (ν := blockLaw H (c i)⁻¹)).prod (MeasurePreserving.id _)

omit [Fintype A] [DecidableEq A] in
theorem swap_involution (H : ℕ) (i : A) (w : World A H i) :
    swap H i (swap H i w) = w := rfl

def theta (H : ℕ) (m : Means A) (i : A) (w : World A H i) : Means A :=
  m + join i (w.1.1.1, w.2.1)

def copyMean (H : ℕ) (m : Means A) (i : A) (w : World A H i) : ℝ :=
  m i + w.1.2.1

def realStream (H : ℕ) (m : Means A) (i : A) (w : World A H i) : RawStream A H :=
  fun a t => if h : a = i then m a + w.1.1.1 + w.1.1.2 t
    else m a + w.2.1 ⟨a, h⟩ + w.2.2 ⟨a, h⟩ t

def mockStream (H : ℕ) (m : Means A) (i : A) (w : World A H i) : RawStream A H :=
  realStream H m i (swap H i w)

theorem theta_measurable (H : ℕ) (m : Means A) (i : A) : Measurable (theta H m i) := by
  unfold theta
  exact measurable_const.add ((join_continuous i).measurable.comp (by fun_prop))

omit [Fintype A] in
theorem realStream_measurable (H : ℕ) (m : Means A) (i : A) :
    Measurable (realStream H m i) := by
  apply measurable_pi_lambda
  intro a
  apply measurable_pi_lambda
  intro t
  by_cases h : a = i <;> simp only [realStream, h, dite_true, dite_false] <;> fun_prop

omit [Fintype A] in
theorem mockStream_measurable (H : ℕ) (m : Means A) (i : A) :
    Measurable (mockStream H m i) :=
  (realStream_measurable H m i).comp (by unfold swap; fun_prop)

omit [Fintype A] in
theorem stream_swap (H : ℕ) (m : Means A) (i : A) (w : World A H i) :
    realStream H m i (swap H i w) = mockStream H m i w := rfl

omit [Fintype A] in
theorem stream_other_unchanged (H : ℕ) (m : Means A) (i : A) (a : A) (hai : a ≠ i)
    (w : World A H i) : mockStream H m i w a = realStream H m i w a := by
  funext t
  simp [mockStream, realStream, swap, hai]

omit [Fintype A] in
theorem theta_other_unchanged (H : ℕ) (m : Means A) (i : A) (a : A) (hai : a ≠ i)
    (w : World A H i) : theta H m i (swap H i w) a = theta H m i w a := by
  simp [theta, join, swap, hai]

theorem latent_projection_preserving (H : ℕ) (c : Precisions A) (i : A) :
    MeasurePreserving (fun w : World A H i => (w.1.1.1, w.2.1)) (law H c i)
      ((gaussianReal 0 (c i)⁻¹).prod (otherLaw c i)) := by
  exact ((measurePreserving_fst (μ := gaussianReal 0 (c i)⁻¹) (ν := noiseLaw H)).comp
    (measurePreserving_fst (μ := blockLaw H (c i)⁻¹) (ν := blockLaw H (c i)⁻¹))).prod
    (measurePreserving_fst (μ := otherLaw c i)
      (ν := Measure.pi (fun _ : {a : A // a ≠ i} => noiseLaw H)))

theorem theta_law (H : ℕ) (c : Precisions A) (m : Means A) (i : A) :
    (law H c i).map (theta H m i) = posteriorLaw c m := by
  have hj : MeasurePreserving (join i)
      ((gaussianReal 0 (c i)⁻¹).prod (otherLaw c i)) (centeredLaw c) :=
    ⟨(join_continuous i).measurable, join_law c i⟩
  have h := hj.comp (latent_projection_preserving H c i)
  unfold theta posteriorLaw
  rw [← h.map_eq, Measure.map_map (by fun_prop) h.measurable]
  rfl

theorem theta_preserving (H : ℕ) (c : Precisions A) (m : Means A) (i : A) :
    MeasurePreserving (theta H m i) (law H c i) (posteriorLaw c m) :=
  ⟨theta_measurable H m i, theta_law H c m i⟩

/-- The copy latent and its noise array have exactly the same joint law as
the real block; this equality includes the dependence shared across all rewards. -/
theorem copy_block_law (H : ℕ) (c : Precisions A) (i : A) :
    (law H c i).map (fun w => w.1.2) = blockLaw H (c i)⁻¹ := by
  exact ((measurePreserving_snd (μ := blockLaw H (c i)⁻¹) (ν := blockLaw H (c i)⁻¹)).comp
    (measurePreserving_fst (μ := (blockLaw H (c i)⁻¹).prod (blockLaw H (c i)⁻¹))
      (ν := otherDataLaw H c i))).map_eq

/-- Rearrangement isolates the auxiliary copy from the entire real world. -/
theorem isolate_copy_preserving (H : ℕ) (c : Precisions A) (i : A) :
    MeasurePreserving (fun w : World A H i => ((w.1.1, w.2), w.1.2)) (law H c i)
      (((blockLaw H (c i)⁻¹).prod (otherDataLaw H c i)).prod (blockLaw H (c i)⁻¹)) := by
  let b := blockLaw H (c i)⁻¹
  let o := otherDataLaw H c i
  have h1 := measurePreserving_prodAssoc b b o
  have h2 := (MeasurePreserving.id b).prod (Measure.measurePreserving_swap (μ := b) (ν := o))
  have h3 := MeasurePreserving.symm MeasurableEquiv.prodAssoc
    (measurePreserving_prodAssoc b o b)
  exact h3.comp (h2.comp h1)

/-- The posterior-predictive block is independent of all real parameters,
real observation noises, and the remaining arms' data. -/
theorem copy_independent_of_real_data (H : ℕ) (c : Precisions A) (i : A) :
    IndepFun (fun w : World A H i => w.1.2) (fun w => (w.1.1, w.2)) (law H c i) := by
  have h := isolate_copy_preserving H c i
  apply (indepFun_iff_map_prod_eq_prod_map_map (by fun_prop) (by fun_prop)).mpr
  have hfst := measurePreserving_fst
    (μ := (blockLaw H (c i)⁻¹).prod (otherDataLaw H c i)) (ν := blockLaw H (c i)⁻¹)
  have hsnd := measurePreserving_snd
    (μ := (blockLaw H (c i)⁻¹).prod (otherDataLaw H c i)) (ν := blockLaw H (c i)⁻¹)
  have hswap := (Measure.measurePreserving_swap
    (μ := (blockLaw H (c i)⁻¹).prod (otherDataLaw H c i)) (ν := blockLaw H (c i)⁻¹)).comp h
  have ha := hsnd.comp h
  have hb := hfst.comp h
  have haEq : (law H c i).map (fun w => w.1.2) = blockLaw H (c i)⁻¹ := by
    simpa only [Function.comp_def] using ha.map_eq
  have hbEq : (law H c i).map (fun w => (w.1.1, w.2)) =
      (blockLaw H (c i)⁻¹).prod (otherDataLaw H c i) := by
    simpa only [Function.comp_def] using hb.map_eq
  rw [haEq, hbEq]
  simpa only [Function.comp_def, Prod.swap] using hswap.map_eq

/-- Given a latent mean, the finite pseudo-noise array produces iid Gaussian
rewards of variance one; the common latent is drawn only once for the stream. -/
theorem rewards_given_mean_law (H : ℕ) (u : ℝ) :
    (noiseLaw H).map (fun e : Fin H → ℝ => fun t => u + e t) =
      Measure.pi (fun _ : Fin H => gaussianReal u 1) := by
  unfold noiseLaw
  rw [Measure.pi_map_pi (fun _ => (by fun_prop :
    AEMeasurable (fun x : ℝ => u + x) (gaussianReal 0 1)))]
  simp only [gaussianReal_map_const_add, zero_add]

theorem copy_mean_law (H : ℕ) (c : Precisions A) (m : Means A) (i : A) :
    (law H c i).map (copyMean H m i) = gaussianReal (m i) (c i)⁻¹ := by
  have hm := (measurePreserving_fst (μ := gaussianReal 0 (c i)⁻¹) (ν := noiseLaw H)).map_eq
  change (blockLaw H (c i)⁻¹).map Prod.fst = gaussianReal 0 (c i)⁻¹ at hm
  have ht := gaussianReal_map_const_add (μ := (0 : ℝ)) (v := (c i)⁻¹) (m i)
  rw [← hm, ← copy_block_law H c i,
    Measure.map_map (by fun_prop) (by fun_prop),
    Measure.map_map (by fun_prop) (by fun_prop)] at ht
  simpa [copyMean, Function.comp_def] using ht

theorem copy_mean_independent_of_theta (H : ℕ) (c : Precisions A) (m : Means A) (i : A) :
    IndepFun (copyMean H m i) (theta H m i) (law H c i) := by
  have hf : Measurable (fun b : Block H => m i + b.1) := by fun_prop
  have hg : Measurable (fun p : Block H × OtherData A H i =>
      m + join i (p.1.1, p.2.1)) :=
    measurable_const.add ((join_continuous i).measurable.comp (by fun_prop))
  simpa only [copyMean, theta, Function.comp_def] using
    (copy_independent_of_real_data H c i).comp hf hg

/-- The complete adaptive input reward array has the same distribution after
substituting the independent arm-i copy, including its shared-latent dependence. -/
theorem streams_same_law (H : ℕ) (c : Precisions A) (m : Means A) (i : A) :
    (law H c i).map (mockStream H m i) = (law H c i).map (realStream H m i) := by
  change (law H c i).map ((realStream H m i) ∘ (swap H i)) = _
  rw [← Measure.map_map (realStream_measurable H m i)
    (swap_preserving H c i).measurable, (swap_preserving H c i).map_eq]

end
end BayesOptimal.MockStream

end

/-! ## FiniteModelMeasurable -/
section

open MeasureTheory ProbabilityTheory
open scoped NNReal ENNReal

namespace BayesOptimal.FiniteModelMeasurable

open BayesOptimal.FiniteGaussian BayesOptimal.FinitePosterior

variable {A : Type*} [Fintype A] [Nonempty A] [DecidableEq A]

noncomputable section

def listValue (a0 : A) : List A → Means A → ℝ
  | [], m => m a0
  | a :: as, m => max (m a) (listValue a0 as m)

def listChoice (a0 : A) : List A → Means A → A
  | [], _ => a0
  | a :: as, m => if listValue a0 as m ≤ m a then a else listChoice a0 as m

omit [Fintype A] [Nonempty A] [DecidableEq A] in
theorem listValue_continuous (a0 : A) (as : List A) : Continuous (listValue a0 as) := by
  induction as with
  | nil => exact continuous_apply a0
  | cons a as ih => exact (continuous_apply a).max ih

omit [Fintype A] [Nonempty A] [DecidableEq A] in
theorem listChoice_attains (a0 : A) (as : List A) (m : Means A) :
    m (listChoice a0 as m) = listValue a0 as m := by
  induction as with
  | nil => rfl
  | cons a as ih =>
    change m (if listValue a0 as m ≤ m a then a else listChoice a0 as m) =
      max (m a) (listValue a0 as m)
    split_ifs with h
    · exact (max_eq_left h).symm
    · rw [ih, max_eq_right (le_of_not_ge h)]

omit [DecidableEq A] in
theorem listValue_le_maxAll (a0 : A) (as : List A) (m : Means A) :
    listValue a0 as m ≤ maxAll m := by
  induction as with
  | nil => exact coordinate_le_maxAll m a0
  | cons a as ih => exact max_le (coordinate_le_maxAll m a) ih

omit [Fintype A] [Nonempty A] [DecidableEq A] in
theorem coordinate_le_listValue (a0 : A) (as : List A) (m : Means A)
    (a : A) (ha : a ∈ as) : m a ≤ listValue a0 as m := by
  induction as with
  | nil => simp at ha
  | cons b as ih =>
    rcases List.mem_cons.mp ha with h | h
    · subst a; exact le_max_left _ _
    · exact (ih h).trans (le_max_right _ _)

def firstMax (m : Means A) : A :=
  listChoice (Classical.choice (inferInstance : Nonempty A)) Finset.univ.toList m

omit [DecidableEq A] in
theorem firstMax_attains (m : Means A) : m (firstMax m) = maxAll m := by
  change m (listChoice _ Finset.univ.toList m) = maxAll m
  rw [listChoice_attains _ _ m]
  apply le_antisymm (listValue_le_maxAll _ _ _)
  apply maxAll_le
  intro a
  exact coordinate_le_listValue _ _ _ a (by simp)

section Measurable
variable [MeasurableSpace A]

omit [Nonempty A] [DecidableEq A] in
theorem listChoice_measurable (a0 : A) (as : List A) : Measurable (listChoice a0 as) := by
  induction as with
  | nil => exact measurable_const
  | cons a as ih =>
    exact Measurable.ite
      (isClosed_le (listValue_continuous a0 as) (continuous_apply a)).measurableSet
      measurable_const ih

omit [DecidableEq A] in
theorem firstMax_measurable : Measurable (firstMax (A := A)) :=
  listChoice_measurable _ _

def chooseFirst (k : ℕ) (c : Precisions A) (m : Means A) : A :=
  firstMax (action k c m)

omit [MeasurableSpace A] in
theorem chooseFirst_optimal (k : ℕ) (c : Precisions A) (m : Means A) :
    action k c m (chooseFirst k c m) = value (k + 1) c m := firstMax_attains _

/-- A Borel optimal arm selector for every fixed proper Gaussian posterior
precision vector. Ties are resolved by a fixed finite list. -/
theorem chooseFirst_measurable (k : ℕ) (c : Precisions A) :
    Measurable (chooseFirst k c) := by
  apply firstMax_measurable.comp
  apply measurable_pi_lambda
  intro a
  exact (integral_shift_lipschitz (value_lipschitz k (advance c a))
    a (innovation c a)).continuous.measurable

def optimalFirst : (k : ℕ) → Precisions A → Means A → Strategy (A := A) k
  | 0, _, m => .stop (firstMax m)
  | k + 1, c, m =>
      let i := chooseFirst k c m
      .sample i (fun z => optimalFirst k (advance c i) (shift m i z))

omit [MeasurableSpace A] in
theorem optimalFirst_utility (k : ℕ) (c : Precisions A) (m : Means A) :
    utility (optimalFirst k c m) c m = value k c m := by
  induction k generalizing c m with
  | zero => exact firstMax_attains m
  | succ k ih => simp only [optimalFirst, utility, ih]; exact chooseFirst_optimal k c m

omit [MeasurableSpace A] in
theorem optimalFirst_admissible (k : ℕ) (c : Precisions A) (m : Means A) :
    Admissible (optimalFirst k c m) c m := by
  induction k generalizing c m with
  | zero => trivial
  | succ k ih =>
    constructor
    · intro z; exact ih _ _
    · simp only [optimalFirst_utility]
      exact action_integrable k c m (chooseFirst k c m)

omit [MeasurableSpace A] in
theorem optimalFirst_bayes_optimality {k : ℕ} (s : Strategy (A := A) k)
    (c : Precisions A) (m : Means A) (hs : Admissible s c m) (hc : ∀ a, 0 < c a) :
    expectedRegret (optimalFirst k c m) c m ≤ expectedRegret s c m := by
  rw [expectedRegret_eq _ _ _ (optimalFirst_admissible k c m) hc,
    expectedRegret_eq s c m hs hc, optimalFirst_utility]
  exact sub_le_sub_left (utility_le_value s c m hs) _

end Measurable

end
end BayesOptimal.FiniteModelMeasurable

end

/-! ## MockSample -/
section

open MeasureTheory ProbabilityTheory
open scoped NNReal ENNReal

namespace BayesOptimal.MockSample

open BayesOptimal.FiniteGaussian BayesOptimal.FinitePosterior BayesOptimal.FiniteModelExclusion
open BayesOptimal.MockStream

variable {A : Type*} [Fintype A] [Nonempty A] [DecidableEq A] {H : ℕ}

noncomputable section

omit [Nonempty A] in
theorem theta_coordinate_integrable (H : ℕ) (c : Precisions A) (m : Means A)
    (i a : A) : Integrable (fun w => theta H m i w a) (law H c i) := by
  have h := posterior_coordinate_integrable c m a
  rw [← theta_law H c m i] at h
  exact h.comp_measurable (theta_measurable H m i)

theorem theta_max_integrable (H : ℕ) (c : Precisions A) (m : Means A) (i : A) :
    Integrable (fun w => maxAll (theta H m i w)) (law H c i) := by
  have h := posterior_integrable maxAll_lipschitz c m
  rw [← theta_law H c m i] at h
  exact h.comp_measurable (theta_measurable H m i)

section Measurable
variable [MeasurableSpace A] [MeasurableSingletonClass A]

omit [Nonempty A] in
theorem selected_coordinate_measurable (H : ℕ) (m : Means A) (i : A)
    (S : World A H i → RawStream A H) (J : RawStream A H → A)
    (hS : Measurable S) (hJ : Measurable J) :
    Measurable (fun w => theta H m i w (J (S w))) := by
  have h : Measurable (fun p : World A H i × A => theta H m i p.1 p.2) :=
    measurable_from_prod_countable_left (fun a =>
      (measurable_pi_apply a).comp (theta_measurable H m i))
  exact h.comp (measurable_id.prodMk (hJ.comp hS))

omit [Nonempty A] in
theorem selected_coordinate_integrable (H : ℕ) (c : Precisions A) (m : Means A) (i : A)
    (S : World A H i → RawStream A H) (J : RawStream A H → A)
    (hS : Measurable S) (hJ : Measurable J) :
    Integrable (fun w => theta H m i w (J (S w))) (law H c i) := by
  have hi : Integrable (fun w => ∑ a, |theta H m i w a|) (law H c i) := by
    apply integrable_finset_sum
    intro a _
    simpa only [Real.norm_eq_abs] using (theta_coordinate_integrable H c m i a).norm
  apply hi.mono' (selected_coordinate_measurable H m i S J hS hJ).aestronglyMeasurable
  apply Filter.Eventually.of_forall
  intro w
  rw [Real.norm_eq_abs]
  exact Finset.single_le_sum (fun a _ => abs_nonneg (theta H m i w a))
    (Finset.mem_univ (J (S w)))

def risk (H : ℕ) (c : Precisions A) (m : Means A) (i : A)
    (S : World A H i → RawStream A H) (J : RawStream A H → A) : ℝ :=
  ∫ w, maxAll (theta H m i w) - theta H m i w (J (S w)) ∂law H c i

theorem risk_integrable (H : ℕ) (c : Precisions A) (m : Means A) (i : A)
    (S : World A H i → RawStream A H) (J : RawStream A H → A)
    (hS : Measurable S) (hJ : Measurable J) :
    Integrable (fun w => maxAll (theta H m i w) - theta H m i w (J (S w)))
      (law H c i) :=
  (theta_max_integrable H c m i).sub
    (selected_coordinate_integrable H c m i S J hS hJ)

omit [Nonempty A] [MeasurableSpace A] [MeasurableSingletonClass A] in
/-- Exchange of the real latent/noise block and its independent identical
copy preserves the full world law, including all other arms' parameters. -/
theorem integral_swap (H : ℕ) (c : Precisions A) (i : A)
    (f : World A H i → ℝ) (hf : Measurable f) :
    (∫ w, f (swap H i w) ∂law H c i) = ∫ w, f w ∂law H c i := by
  rw [← integral_map (swap_preserving H c i).measurable.aemeasurable
    hf.aestronglyMeasurable, (swap_preserving H c i).map_eq]

/-- Swapping both the latent arm-i parameter and its reward stream preserves
the risk of every measurable policy, even one that recommends i. -/
theorem full_risk_coupling (H : ℕ) (c : Precisions A) (m : Means A) (i : A)
    (J : RawStream A H → A) (hJ : Measurable J) :
    (∫ w, maxAll (theta H m i (swap H i w)) -
        theta H m i (swap H i w) (J (mockStream H m i w)) ∂law H c i) =
      risk H c m i (realStream H m i) J := by
  exact integral_swap H c i _
    (((maxAll_lipschitz (A := A)).continuous.measurable.comp
      (theta_measurable H m i)).sub
      (selected_coordinate_measurable H m i _ J (realStream_measurable H m i) hJ))

/-- Literal risk equality in Definition 5: a continuation that never
recommends i has the same actual Bayesian regret under the real stream and
under an independent posterior-predictive copy of just the arm-i stream. -/
theorem risk_coupling (H : ℕ) (c : Precisions A) (m : Means A) (i : A)
    (J : RawStream A H → A) (hJ : Measurable J) (hne : ∀ s, J s ≠ i) :
    risk H c m i (mockStream H m i) J = risk H c m i (realStream H m i) J := by
  have hswap := integral_swap H c i
    (fun w => theta H m i w (J (realStream H m i w)))
    (selected_coordinate_measurable H m i _ J (realStream_measurable H m i) hJ)
  have he : (fun w => theta H m i (swap H i w)
      (J (realStream H m i (swap H i w)))) =
      (fun w => theta H m i w (J (mockStream H m i w))) := by
    funext w
    rw [stream_swap]
    exact theta_other_unchanged H m i _ (hne _) w
  rw [he] at hswap
  unfold risk
  rw [integral_sub (theta_max_integrable H c m i)
    (selected_coordinate_integrable H c m i _ J (mockStream_measurable H m i) hJ),
    integral_sub (theta_max_integrable H c m i)
      (selected_coordinate_integrable H c m i _ J (realStream_measurable H m i) hJ), hswap]

def removeRecommendation (i : A) (J R : RawStream A H → A) (s : RawStream A H) : A :=
  if J s = i then R s else J s

omit [Fintype A] [Nonempty A] in
theorem removeRecommendation_measurable (i : A) (J R : RawStream A H → A)
    (hJ : Measurable J) (hR : Measurable R) : Measurable (removeRecommendation i J R) :=
  hR.ite (hJ (measurableSet_singleton i)) hJ

omit [Fintype A] [Nonempty A] [MeasurableSpace A] [MeasurableSingletonClass A] in
theorem removeRecommendation_excludes (i : A) (J R : RawStream A H → A)
    (hR : ∀ s, R s ≠ i) (s : RawStream A H) : removeRecommendation i J R s ≠ i := by
  unfold removeRecommendation
  split_ifs with h
  · exact hR s
  · exact h

omit [Fintype A] [Nonempty A] [MeasurableSpace A] [MeasurableSingletonClass A] in
theorem removeRecommendation_agrees (i : A) (J R : RawStream A H → A)
    (s : RawStream A H) (hJ : J s ≠ i) : removeRecommendation i J R s = J s := by
  simp [removeRecommendation, hJ]

section Removed
variable (i : A) [Nonempty {a : A // a ≠ i}]

omit [MeasurableSpace A] [MeasurableSingletonClass A] in
theorem maxAll_eq_removed (u : Means A) :
    maxAll u = max (u i) (otherMaximum i u) := by
  apply le_antisymm
  · apply maxAll_le
    intro a
    by_cases h : a = i
    · subst a; exact le_max_left _ _
    · exact (coordinate_le_maxAll (fun b : {a : A // a ≠ i} => u b) ⟨a, h⟩).trans
        (le_max_right _ _)
  · apply max_le (coordinate_le_maxAll u i)
    apply maxAll_le
    intro a
    exact coordinate_le_maxAll u a

omit [MeasurableSpace A] [MeasurableSingletonClass A] in
/-- The exact latent loss decomposition printed in Definition 5. -/
theorem loss_decomposition (u : Means A) (j : A) (hji : j ≠ i) :
    maxAll u - u j = otherMaximum i u - u j + max (u i - otherMaximum i u) 0 := by
  have _ := hji
  rw [maxAll_eq_removed i]
  by_cases h : otherMaximum i u ≤ u i
  · rw [max_eq_left h, max_eq_left (sub_nonneg.mpr h)]
    ring
  · have hh : u i ≤ otherMaximum i u := le_of_not_ge h
    rw [max_eq_right hh, max_eq_right (sub_nonpos.mpr hh), add_zero]

omit [Nonempty A] [MeasurableSpace A] [MeasurableSingletonClass A] in
theorem otherMaximum_swap (H : ℕ) (m : Means A) (w : World A H i) :
    otherMaximum i (theta H m i (swap H i w)) = otherMaximum i (theta H m i w) := by
  unfold otherMaximum
  congr 1
  funext a
  exact theta_other_unchanged H m i a a.property w

omit [Nonempty A] [MeasurableSpace A] [MeasurableSingletonClass A] in
theorem otherMinimum_le (u : Means A) (j : A) (hji : j ≠ i) :
    otherMinimum i u ≤ u j := by
  have h := coordinate_le_maxAll (fun a : {a : A // a ≠ i} => -u a) ⟨j, hji⟩
  unfold otherMinimum
  linarith

omit [MeasurableSpace A] [MeasurableSingletonClass A] in
/-- The pointwise increase from excluding a terminal recommendation i is
bounded by its advantage over the minimum retained latent mean. -/
theorem recommendation_loss_increase (u : Means A) (J R : RawStream A H → A)
    (hR : ∀ s, R s ≠ i) (s : RawStream A H) :
    (maxAll u - u (removeRecommendation i J R s)) - (maxAll u - u (J s)) ≤
      max (u i - otherMinimum i u) 0 := by
  unfold removeRecommendation
  split_ifs with h
  · rw [h]
    have hm := otherMinimum_le i u (R s) (hR s)
    have hp := le_max_left (u i - otherMinimum i u) (0 : ℝ)
    linarith
  · simp only [sub_self]
    exact le_max_right _ _

omit [Nonempty A] [MeasurableSpace A] [MeasurableSingletonClass A] in
theorem exclusion_world_integral (H : ℕ) (c : Precisions A) (m : Means A) :
    (∫ w, max (theta H m i w i - otherMinimum i (theta H m i w)) 0 ∂law H c i) =
      exclusion i c m := by
  unfold exclusion
  rw [← theta_law H c m i, integral_map (theta_measurable H m i).aemeasurable]
  exact ((measurable_pi_apply i).sub (otherMinimum_lipschitz i).continuous.measurable).max
    measurable_const |>.aestronglyMeasurable

omit [Nonempty A] [MeasurableSpace A] [MeasurableSingletonClass A] in
theorem exclusion_world_integrable (H : ℕ) (c : Precisions A) (m : Means A) :
    Integrable (fun w => max (theta H m i w i - otherMinimum i (theta H m i w)) 0)
      (law H c i) := by
  have h := exclusion_integrable i c m
  rw [← theta_law H c m i] at h
  exact h.comp_measurable (theta_measurable H m i)

/-- The second displayed inequality's risk-comparison part, with the actual
Gaussian posterior expectation and no assumed equality or exclusion bound. -/
theorem modified_real_risk_le (H : ℕ) (c : Precisions A) (m : Means A)
    (J R : RawStream A H → A) (hJ : Measurable J) (hR : Measurable R)
    (hne : ∀ s, R s ≠ i) :
    risk H c m i (realStream H m i) (removeRecommendation i J R) ≤
      risk H c m i (realStream H m i) J + exclusion i c m := by
  have hmod := removeRecommendation_measurable i J R hJ hR
  have h := integral_mono
    (risk_integrable H c m i _ _ (realStream_measurable H m i) hmod)
    ((risk_integrable H c m i _ J (realStream_measurable H m i) hJ).add
      (exclusion_world_integrable i H c m)) (fun w => by
        have hp := recommendation_loss_increase i (theta H m i w) J R hne
          (realStream H m i w)
        simp only [Pi.add_apply] at ⊢
        linarith)
  dsimp only [Pi.add_apply] at h
  rw [integral_add
    (risk_integrable H c m i _ J (realStream_measurable H m i) hJ)
    (exclusion_world_integrable i H c m), exclusion_world_integral i H c m] at h
  exact h

/-- Independent-copy mock loss equals the terminal-modified real loss and is
at most the original real loss plus the actual posterior exclusion slack. -/
theorem mock_risk_eq_and_le (H : ℕ) (c : Precisions A) (m : Means A)
    (J R : RawStream A H → A) (hJ : Measurable J) (hR : Measurable R)
    (hne : ∀ s, R s ≠ i) :
    risk H c m i (mockStream H m i) (removeRecommendation i J R) =
      risk H c m i (realStream H m i) (removeRecommendation i J R) ∧
    risk H c m i (mockStream H m i) (removeRecommendation i J R) ≤
      risk H c m i (realStream H m i) J + exclusion i c m := by
  have he := risk_coupling H c m i (removeRecommendation i J R)
    (removeRecommendation_measurable i J R hJ hR)
    (removeRecommendation_excludes i J R hne)
  exact ⟨he, he ▸ modified_real_risk_le i H c m J R hJ hR hne⟩

end Removed
end Measurable
end
end BayesOptimal.MockSample

end

/-! ## EmbeddingDirect -/
section

set_option linter.unusedSectionVars false

open MeasureTheory ProbabilityTheory
open scoped NNReal ENNReal

namespace BayesOptimal.EmbeddingDirect

open FiniteGaussian FinitePosterior FiniteModelExclusion

variable {A : Type*} [Fintype A] [Nonempty A] [DecidableEq A]
variable (i : A) [Nonempty {a : A // a ≠ i}]

noncomputable section

abbrev Retained := {a : A // a ≠ i}

def restrictMeans (m : Means A) : Means (Retained i) := fun a => m a
def restrictPrecisions (c : Precisions A) : Precisions (Retained i) := fun a => c a

omit [Fintype A] [Nonempty A] [Nonempty {a : A // a ≠ i}] in
theorem restrict_advance (c : Precisions A) (a : Retained i) :
    restrictPrecisions i (advance c a) = advance (restrictPrecisions i c) a := by
  ext b
  simp only [restrictPrecisions, advance, Subtype.ext_iff]

omit [Fintype A] [Nonempty A] [Nonempty {a : A // a ≠ i}] in
theorem restrict_shift (m : Means A) (a : Retained i) (z : ℝ) :
    restrictMeans i (shift m a z) = shift (restrictMeans i m) a z := by
  ext b
  simp only [restrictMeans, shift, Subtype.ext_iff]

/-- The first embedding in Lemma 13: neither sample nor recommend the removed arm. -/
def embed : {k : ℕ} → Strategy (A := Retained i) k → Strategy (A := A) k
  | 0, .stop a => .stop a
  | _ + 1, .sample a next => .sample a (fun z => embed (next z))

theorem embed_utility {k : ℕ} (s : Strategy (A := Retained i) k)
    (c : Precisions A) (m : Means A) :
    utility (embed i s) c m = utility s (restrictPrecisions i c) (restrictMeans i m) := by
  induction k generalizing c m with
  | zero => cases s; rfl
  | succ k ih =>
    cases s with
    | sample a next =>
      simp only [embed, utility, ih, restrict_advance, restrict_shift]
      rfl

theorem embed_admissible {k : ℕ} (s : Strategy (A := Retained i) k)
    (c : Precisions A) (m : Means A)
    (hs : Admissible s (restrictPrecisions i c) (restrictMeans i m)) :
    Admissible (embed i s) c m := by
  induction k generalizing c m with
  | zero => cases s; trivial
  | succ k ih =>
    cases s with
    | sample a next =>
      constructor
      · intro z
        apply ih
        simpa only [restrict_advance, restrict_shift] using hs.1 z
      · simp only [embed_utility, restrict_advance, restrict_shift]
        exact hs.2

def reducedPotential (c : Precisions A) (m : Means A) : ℝ :=
  potential (restrictPrecisions i c) (restrictMeans i m)

theorem reducedPotential_eq_posterior (c : Precisions A) (m : Means A) :
    reducedPotential i c m = ∫ u, otherMaximum i u ∂posteriorLaw c m := by
  rw [posterior_integral (otherMaximum_lipschitz i), ← expectation]
  rw [expectation_split (otherMaximum_lipschitz i) c m i]
  have hj (u : Retained i → ℝ) (x : ℝ) :
      otherMaximum i (m + join i (x, u)) = maxAll (fun a : Retained i => m a + u a) := by
    unfold otherMaximum
    congr 1
    ext a
    simp [Pi.add_apply, join, a.property]
  simp_rw [hj]
  unfold reducedPotential potential expectation centeredLaw otherLaw
  simp only [restrictPrecisions, integral_const, measureReal_univ_eq_one, one_smul]
  rfl

omit [Nonempty A] in
theorem otherMinimum_le (m : Means A) (a : Retained i) : otherMinimum i m ≤ m a := by
  have h := coordinate_le_maxAll (fun b : Retained i => -m b) a
  unfold otherMinimum
  linarith

theorem removed_excess_identity (u : Means A) :
    maxAll u - otherMaximum i u = max (u i - otherMaximum i u) 0 := by
  have he : maxAll u = max (otherMaximum i u) (u i) := by
    apply le_antisymm
    · apply maxAll_le
      intro a
      by_cases ha : a = i
      · subst a; exact le_max_right _ _
      · exact (coordinate_le_maxAll (fun b : Retained i => u b) ⟨a, ha⟩).trans
          (le_max_left _ _)
    · exact max_le (maxAll_le _ _ (fun a => coordinate_le_maxAll u a))
        (coordinate_le_maxAll u i)
  rw [he]
  by_cases h : u i ≤ otherMaximum i u
  · rw [max_eq_left h, max_eq_right (by linarith : u i - otherMaximum i u ≤ 0)]
    ring
  · rw [max_eq_right (le_of_not_ge h), max_eq_left (by linarith : 0 ≤ u i - otherMaximum i u)]

theorem potential_excess_eq (c : Precisions A) (m : Means A) :
    potential c m - reducedPotential i c m =
      ∫ u, max (u i - otherMaximum i u) 0 ∂posteriorLaw c m := by
  rw [potential_eq_posterior, reducedPotential_eq_posterior,
    ← integral_sub (posterior_integrable maxAll_lipschitz c m)
      (posterior_integrable (otherMaximum_lipschitz i) c m)]
  apply integral_congr_ae
  exact Filter.Eventually.of_forall (removed_excess_identity i)

theorem potential_excess_bounds (c : Precisions A) (m : Means A) :
    0 ≤ potential c m - reducedPotential i c m ∧
      potential c m - reducedPotential i c m ≤ exclusion i c m := by
  rw [potential_excess_eq]
  constructor
  · exact integral_nonneg (fun _ => le_max_right _ _)
  · apply integral_mono
      ((posterior_coordinate_integrable c m i).sub
        (posterior_integrable (otherMaximum_lipschitz i) c m)).pos_part
      (exclusion_integrable i c m)
    intro u
    obtain ⟨a⟩ := (inferInstance : Nonempty (Retained i))
    have hmin := otherMinimum_le i u a
    have hmax := coordinate_le_maxAll (fun b : Retained i => u b) a
    exact max_le_max (by dsimp [otherMaximum]; linarith) le_rfl

/-- Equality of actual posterior expected simple regrets in the first embedding.
The excess is the expectation of the removed arm's positive advantage over
the best retained arm, independent of which retained policy is embedded. -/
theorem embed_expectedRegret {k : ℕ} (s : Strategy (A := Retained i) k)
    (c : Precisions A) (m : Means A)
    (hs : Admissible s (restrictPrecisions i c) (restrictMeans i m))
    (hc : ∀ a, 0 < c a) :
    expectedRegret (embed i s) c m =
      expectedRegret s (restrictPrecisions i c) (restrictMeans i m) +
      ∫ u, max (u i - otherMaximum i u) 0 ∂posteriorLaw c m := by
  rw [expectedRegret_eq _ _ _ (embed_admissible i s c m hs) hc,
    expectedRegret_eq _ _ _ hs (fun a => hc a), embed_utility,
    ← potential_excess_eq]
  unfold reducedPotential
  ring

/-- The upper half of Lemma 13 follows by applying global optimality to
the explicitly embedded optimal retained policy. -/
theorem lemma13_first_embedding (k : ℕ) (c : Precisions A) (m : Means A)
    (_hc : ∀ a, 0 < c a) :
    loss k c m - loss k (restrictPrecisions i c) (restrictMeans i m) ≤ exclusion i c m := by
  let s := optimal k (restrictPrecisions i c) (restrictMeans i m)
  have hs : Admissible s (restrictPrecisions i c) (restrictMeans i m) := optimal_admissible _ _ _
  have ho := utility_le_value (embed i s) c m (embed_admissible i s c m hs)
  rw [embed_utility, optimal_utility] at ho
  have hp := (potential_excess_bounds i c m).2
  unfold loss reducedPotential at *
  linarith

theorem lemma13_first_embedding_forced (k : ℕ) (c : Precisions A) (m : Means A)
    (a : Retained i) (hc : ∀ b, 0 < c b) :
    actionLoss k c m a -
      actionLoss k (restrictPrecisions i c) (restrictMeans i m) a ≤ exclusion i c m := by
  rw [actionLoss_eq k c m a (hc a),
    actionLoss_eq k (restrictPrecisions i c) (restrictMeans i m) a (hc a)]
  have hu : action k (restrictPrecisions i c) (restrictMeans i m) a ≤ action k c m a := by
    unfold action
    change (∫ z, value k (advance (restrictPrecisions i c) a)
      (shift (restrictMeans i m) a z) ∂gaussianReal 0 (innovation c a)) ≤ _
    apply integral_mono (action_integrable k (restrictPrecisions i c) (restrictMeans i m) a)
      (action_integrable k c m a)
    intro z
    let s := optimal k (restrictPrecisions i (advance c a)) (restrictMeans i (shift m a z))
    have hs := embed_admissible i s (advance c a) (shift m a z) (optimal_admissible _ _ _)
    have h := utility_le_value (embed i s) (advance c a) (shift m a z) hs
    rw [embed_utility, optimal_utility, restrict_advance, restrict_shift] at h
    exact h
  have hp := (potential_excess_bounds i c m).2
  unfold reducedPotential at hp
  linarith

end
end BayesOptimal.EmbeddingDirect

end

/-! ## EmbeddingRaw -/
section

set_option linter.unusedSectionVars false

open MeasureTheory ProbabilityTheory
open scoped NNReal ENNReal

namespace BayesOptimal.EmbeddingRaw

open FiniteGaussian FinitePosterior FiniteModelExclusion EmbeddingDirect FiniteModelMeasurable

variable {A : Type*} [Fintype A] [Nonempty A] [DecidableEq A]

noncomputable section

abbrev RawStream (A : Type*) (H : ℕ) := A → Fin H → ℝ

def tail {H : ℕ} (s : RawStream A (H + 1)) : RawStream A H := fun a t => s a t.succ

/-- Execute a finite adaptive observation tree on calendar-indexed reward streams.
Each sample consumes exactly one calendar round. The next tree sees only the
reward of the arm selected at that round. -/
def run : {H : ℕ} → Strategy (A := A) H → RawStream A H → A
  | 0, .stop a, _ => a
  | H + 1, .sample a next, s => run (next (s a ⟨0, Nat.zero_lt_succ H⟩)) (tail s)

def trace : {H : ℕ} → Strategy (A := A) H → RawStream A H → List A
  | 0, .stop _, _ => []
  | H + 1, .sample a next, s => a :: trace (next (s a ⟨0, Nat.zero_lt_succ H⟩)) (tail s)

omit [Fintype A] [Nonempty A] [DecidableEq A] in
theorem trace_budget {H : ℕ} (s : Strategy (A := A) H) (r : RawStream A H) :
    (trace s r).length = H := by
  induction H with
  | zero => cases s; rfl
  | succ H ih => cases s with | sample a next => simp only [trace, List.length_cons, ih]

/-- Convert the innovation-coordinate strategy used by the Bellman recursion
to a strategy whose continuation receives the actual raw reward. -/
def rawOfInnovation : {H : ℕ} → Strategy (A := A) H → Precisions A → Means A →
    Strategy (A := A) H
  | 0, .stop a, _, _ => .stop a
  | _ + 1, .sample a next, c, m =>
      .sample a (fun y =>
        let z := (y - m a) / ((c a : ℝ) + 1)
        rawOfInnovation (next z) (advance c a) (shift m a z))

section Removed
variable (i : A) [Nonempty {a : A // a ≠ i}]

def insert {H : ℕ} (real : RawStream (Retained i) H) (imaginary : Fin H → ℝ) :
    RawStream A H :=
  fun a t => if h : a = i then imaginary t else real ⟨a, h⟩ t

omit [Fintype A] [Nonempty A] [Nonempty {a : A // a ≠ i}] in
theorem insert_retained {H : ℕ} (real : RawStream (Retained i) H)
    (imaginary : Fin H → ℝ) (a : Retained i) (t : Fin H) :
    insert i real imaginary a t = real a t := by simp [insert, a.property]

omit [Fintype A] [Nonempty A] [Nonempty {a : A // a ≠ i}] in
theorem insert_removed {H : ℕ} (real : RawStream (Retained i) H)
    (imaginary : Fin H → ℝ) (t : Fin H) :
    insert i real imaginary i t = imaginary t := by simp [insert]

omit [Fintype A] [Nonempty A] [Nonempty {a : A // a ≠ i}] in
theorem tail_insert {H : ℕ} (real : RawStream (Retained i) (H + 1))
    (imaginary : Fin (H + 1) → ℝ) :
    tail (insert i real imaginary) = insert i (tail real) (fun t => imaginary t.succ) := rfl

theorem embed_run {H : ℕ} (s : Strategy (A := Retained i) H)
    (real : RawStream (Retained i) H) (imaginary : Fin H → ℝ) :
    run (embed i s) (insert i real imaginary) = (run (A := Retained i) s real : A) := by
  induction H with
  | zero => cases s; rfl
  | succ H ih =>
    cases s with
    | sample a next =>
      simp only [embed, run, insert_retained, tail_insert]
      exact ih (next _) _ _

/-- Literal second embedding of Lemma 13. A request for the removed arm
consumes one real observation from `dummy` and discards it. Its continuation
instead receives the independent imaginary reward. Retained observations
update the internal retained posterior. At the terminal node a removed-arm
recommendation is replaced by a posterior-best retained arm. -/
def simulate (dummy : Retained i) : {H : ℕ} → Strategy (A := A) H →
    Precisions (Retained i) → Means (Retained i) → (Fin H → ℝ) → Strategy (A := Retained i) H
  | 0, .stop a, _, m, _ =>
      if h : a = i then .stop (firstMax m) else .stop ⟨a, h⟩
  | H + 1, .sample a next, c, m, imaginary =>
      if h : a = i then
        .sample dummy (fun _ => simulate dummy
          (next (imaginary ⟨0, Nat.zero_lt_succ H⟩)) c m (fun t => imaginary t.succ))
      else
        .sample ⟨a, h⟩ (fun y =>
          let b : Retained i := ⟨a, h⟩
          let z := (y - m b) / ((c b : ℝ) + 1)
          simulate dummy (next y) (advance c b) (shift m b z) (fun t => imaginary t.succ))

theorem simulate_terminal_best (dummy : Retained i) (c : Precisions (Retained i))
    (m : Means (Retained i)) :
    simulate i dummy (.stop i) c m Fin.elim0 = .stop (firstMax m) := by
  simp [simulate]

theorem simulate_terminal_best_mean (m : Means (Retained i)) :
    m (firstMax m) = maxAll m := firstMax_attains m

theorem simulate_forced_retained (dummy : Retained i) {H : ℕ}
    (a : Retained i) (next : ℝ → Strategy (A := A) H)
    (c : Precisions (Retained i)) (m : Means (Retained i))
    (imaginary : Fin (H + 1) → ℝ) :
    simulate i dummy (.sample a next) c m imaginary =
      .sample a (fun y => simulate i dummy (next y) (advance c a)
        (shift m a ((y - m a) / ((c a : ℝ) + 1))) (fun t => imaginary t.succ)) := by
  simp [simulate, a.property]

theorem simulate_removed_discards_real (dummy : Retained i) {H : ℕ}
    (next : ℝ → Strategy (A := A) H)
    (c : Precisions (Retained i)) (m : Means (Retained i))
    (imaginary : Fin (H + 1) → ℝ) :
    simulate i dummy (.sample i next) c m imaginary =
      .sample dummy (fun _ => simulate i dummy
        (next (imaginary ⟨0, Nat.zero_lt_succ H⟩)) c m (fun t => imaginary t.succ)) := by
  simp [simulate]

theorem simulate_budget (dummy : Retained i) {H : ℕ} (s : Strategy (A := A) H)
    (c : Precisions (Retained i)) (m : Means (Retained i)) (imaginary : Fin H → ℝ)
    (real : RawStream (Retained i) H) :
    (trace (A := Retained i) (simulate i dummy s c m imaginary) real).length = H :=
  trace_budget _ _

/-- Whenever the internal full policy recommends a retained arm, replay
keeps exactly that recommendation, pathwise and for every reward array. -/
theorem simulate_run_agrees (dummy : Retained i) {H : ℕ} (s : Strategy (A := A) H)
    (c : Precisions (Retained i)) (m : Means (Retained i)) (imaginary : Fin H → ℝ)
    (real : RawStream (Retained i) H)
    (hne : run s (insert i real imaginary) ≠ i) :
    (run (A := Retained i) (simulate i dummy s c m imaginary) real : A) =
      run s (insert i real imaginary) := by
  induction H generalizing c m with
  | zero =>
    cases s with
    | stop a => simp only [run] at hne; simp [simulate, hne, run]
  | succ H ih =>
    cases s with
    | sample a next =>
      by_cases ha : a = i
      · subst a
        simp only [run, insert_removed, tail_insert] at hne
        simp only [simulate, dite_true, run, insert_removed, tail_insert]
        exact ih (next _) c m _ _ hne
      · simp only [run, insert, dif_neg ha, tail_insert] at hne
        simp only [simulate, run, insert, dif_neg ha, tail_insert]
        exact ih (next _) _ _ _ _ hne

/-- Pointwise comparison underlying the second embedding. It needs no
distributional assumptions: any replacement by a retained arm has regret
increase bounded by the removed arm's positive advantage over the minimum
retained latent mean. -/
theorem simulate_regret_bound (dummy : Retained i) {H : ℕ} (s : Strategy (A := A) H)
    (c : Precisions (Retained i)) (m : Means (Retained i)) (imaginary : Fin H → ℝ)
    (real : RawStream (Retained i) H) (u : Means A) :
    otherMaximum i u - u (run (A := Retained i) (simulate i dummy s c m imaginary) real) ≤
      maxAll u - u (run s (insert i real imaginary)) + max (u i - otherMinimum i u) 0 := by
  have hmax : otherMaximum i u ≤ maxAll u :=
    maxAll_le _ _ (fun a => coordinate_le_maxAll u a)
  have hpos := le_max_right (u i - otherMinimum i u) 0
  by_cases h : run s (insert i real imaginary) = i
  · rw [h]
    have hmin := otherMinimum_le i u
      (run (A := Retained i) (simulate i dummy s c m imaginary) real)
    have hp := le_max_left (u i - otherMinimum i u) 0
    linarith
  · rw [simulate_run_agrees i dummy s c m imaginary real h]
    linarith

end Removed
end
end BayesOptimal.EmbeddingRaw

end

/-! ## MockPolicy -/
section

set_option linter.unusedSectionVars false

open MeasureTheory ProbabilityTheory
open scoped NNReal ENNReal

namespace BayesOptimal.MockPolicy

open BayesOptimal.FiniteGaussian BayesOptimal.FinitePosterior BayesOptimal.FiniteModelExclusion
open BayesOptimal.FiniteModelMeasurable
open BayesOptimal.EmbeddingRaw

variable {A : Type*} [Fintype A] [Nonempty A] [DecidableEq A]
variable [MeasurableSpace A] [MeasurableSingletonClass A]

noncomputable section

section Removed
variable (i : A) [Nonempty {a : A // a ≠ i}]

def retainedBest (m : Means A) : A :=
  ((firstMax (A := {a : A // a ≠ i}) (fun a => m a) : {a : A // a ≠ i}) : A)

theorem retainedBest_excludes (m : Means A) : retainedBest i m ≠ i :=
  (firstMax (A := {a : A // a ≠ i}) (fun a => m a)).property

theorem retainedBest_attains (m : Means A) :
    m (retainedBest i m) = otherMaximum i m :=
  firstMax_attains (A := {a : A // a ≠ i}) (fun a => m a)

theorem retainedBest_measurable : Measurable (retainedBest i) := by
  exact measurable_subtype_coe.comp (firstMax_measurable.comp
    (measurable_pi_lambda _ (fun a => measurable_pi_apply (a : A))))

def terminalChoice (m : Means A) (a : A) : A :=
  if a = i then retainedBest i m else a

theorem terminalChoice_excludes (m : Means A) (a : A) : terminalChoice i m a ≠ i := by
  unfold terminalChoice
  split_ifs with h
  · exact retainedBest_excludes i m
  · exact h

theorem terminalChoice_preserves (m : Means A) (a : A) (ha : a ≠ i) :
    terminalChoice i m a = a := by simp [terminalChoice, ha]

theorem terminalChoice_measurable :
    Measurable (fun p : Means A × A => terminalChoice i p.1 p.2) :=
  ((retainedBest_measurable i).comp measurable_fst).ite
    (measurable_snd (measurableSet_singleton i)) measurable_snd

theorem terminalChoice_posterior_best (m : Means A) (a : A) (ha : m a = maxAll m) :
    m (terminalChoice i m a) = otherMaximum i m := by
  unfold terminalChoice
  split_ifs with h
  · exact retainedBest_attains i m
  · apply le_antisymm
    · exact coordinate_le_maxAll (fun b : {a : A // a ≠ i} => m b) ⟨a, h⟩
    · apply maxAll_le
      intro b
      rw [ha]
      exact coordinate_le_maxAll m b

def terminalModified : {H : ℕ} → Strategy (A := A) H → Precisions A → Means A →
    Strategy (A := A) H
  | 0, .stop a, _, m => .stop (terminalChoice i m a)
  | _ + 1, .sample a next, c, m =>
      .sample a (fun y =>
        let z := (y - m a) / ((c a : ℝ) + 1)
        terminalModified (next y) (advance c a) (shift m a z))

/-- Replay the internally requested sequence using the same actual arm requests.
If that arm is i, ignore the real reward and supply the next auxiliary reward.
Every other real reward is passed unchanged to the Bayes continuation. -/
def replay : {H : ℕ} → Strategy (A := A) H → Precisions A → Means A →
    (Fin H → ℝ) → Strategy (A := A) H
  | 0, .stop a, _, m, _ => .stop (terminalChoice i m a)
  | H + 1, .sample a next, c, m, imaginary =>
      if a = i then
        let y := imaginary ⟨0, Nat.zero_lt_succ H⟩
        let z := (y - m a) / ((c a : ℝ) + 1)
        .sample a (fun _ => replay (next y) (advance c a) (shift m a z)
          (fun t => imaginary t.succ))
      else
        .sample a (fun y =>
          let z := (y - m a) / ((c a : ℝ) + 1)
          replay (next y) (advance c a) (shift m a z) (fun t => imaginary t.succ))

def substitute {H : ℕ} (real : RawStream A H) (imaginary : Fin H → ℝ) : RawStream A H :=
  fun a t => if a = i then imaginary t else real a t

theorem replay_discards_real {H : ℕ} (next : ℝ → Strategy (A := A) H)
    (c : Precisions A) (m : Means A) (imaginary : Fin (H + 1) → ℝ) :
    replay i (.sample i next) c m imaginary =
      .sample i (fun _ => replay i (next (imaginary ⟨0, Nat.zero_lt_succ H⟩))
        (advance c i) (shift m i ((imaginary ⟨0, Nat.zero_lt_succ H⟩ - m i) /
          ((c i : ℝ) + 1))) (fun t => imaginary t.succ)) := by
  simp [replay]

theorem replay_supplies_real {H : ℕ} (a : A) (ha : a ≠ i)
    (next : ℝ → Strategy (A := A) H) (c : Precisions A) (m : Means A)
    (imaginary : Fin (H + 1) → ℝ) :
    replay i (.sample a next) c m imaginary =
      .sample a (fun y => replay i (next y) (advance c a)
        (shift m a ((y - m a) / ((c a : ℝ) + 1))) (fun t => imaginary t.succ)) := by
  simp [replay, ha]

theorem replay_run_eq {H : ℕ} (s : Strategy (A := A) H) (c : Precisions A) (m : Means A)
    (imaginary : Fin H → ℝ) (real : RawStream A H) :
    run (replay i s c m imaginary) real =
      run (terminalModified i s c m) (substitute i real imaginary) := by
  induction H generalizing c m with
  | zero => cases s; rfl
  | succ H ih =>
    cases s with
    | sample a next =>
      by_cases ha : a = i
      · simp only [replay, run, terminalModified, substitute, ha, if_true]
        exact ih (next _) _ _ _ _
      · simp only [replay, run, terminalModified, substitute, if_neg ha]
        exact ih (next _) _ _ _ _

theorem terminalModified_excludes {H : ℕ} (s : Strategy (A := A) H)
    (c : Precisions A) (m : Means A) (real : RawStream A H) :
    run (terminalModified i s c m) real ≠ i := by
  induction H generalizing c m with
  | zero => cases s with | stop a => exact terminalChoice_excludes i m a
  | succ H ih => cases s with | sample a next => exact ih _ _ _ _

theorem terminalModified_preserves {H : ℕ} (s : Strategy (A := A) H)
    (c : Precisions A) (m : Means A) (real : RawStream A H) (hne : run s real ≠ i) :
    run (terminalModified i s c m) real = run s real := by
  induction H generalizing c m with
  | zero => cases s with | stop a => exact terminalChoice_preserves i m a hne
  | succ H ih => cases s with | sample a next => exact ih _ _ _ _ hne

theorem terminalModified_regret_bound {H : ℕ} (s : Strategy (A := A) H)
    (c : Precisions A) (m : Means A) (real : RawStream A H) (u : Means A) :
    (maxAll u - u (run (terminalModified i s c m) real)) - (maxAll u - u (run s real)) ≤
      max (u i - otherMinimum i u) 0 := by
  by_cases h : run s real = i
  · rw [h]
    have hmin := BayesOptimal.MockSample.otherMinimum_le i u _
      (terminalModified_excludes i s c m real)
    have hp := le_max_left (u i - otherMinimum i u) (0 : ℝ)
    linarith
  · rw [terminalModified_preserves i s c m real h]
    simp only [sub_self]
    exact le_max_right _ _

theorem replay_excludes {H : ℕ} (s : Strategy (A := A) H) (c : Precisions A)
    (m : Means A) (imaginary : Fin H → ℝ) (real : RawStream A H) :
    run (replay i s c m imaginary) real ≠ i := by
  rw [replay_run_eq]
  exact terminalModified_excludes i s c m _

theorem replay_budget {H : ℕ} (s : Strategy (A := A) H) (c : Precisions A)
    (m : Means A) (imaginary : Fin H → ℝ) (real : RawStream A H) :
    (trace (replay i s c m imaginary) real).length = H := trace_budget _ _

/-- The first auxiliary observation updates the internal Gaussian posterior
but consumes no actual sampling opportunity. -/
def continuation (H : ℕ) (c : Precisions A) (m : Means A) (y : ℝ) : Strategy (A := A) H :=
  let z := (y - m i) / ((c i : ℝ) + 1)
  rawOfInnovation (optimalFirst H (advance c i) (shift m i z))
    (advance c i) (shift m i z)

def forcedPolicy (H : ℕ) (c : Precisions A) (m : Means A) : Strategy (A := A) (H + 1) :=
  .sample i (continuation i H c m)

def mockPolicy (H : ℕ) (c : Precisions A) (m : Means A)
    (auxiliary : Fin (H + 1) → ℝ) : Strategy (A := A) H :=
  let y := auxiliary ⟨0, Nat.zero_lt_succ H⟩
  let z := (y - m i) / ((c i : ℝ) + 1)
  replay i (continuation i H c m y) (advance c i) (shift m i z)
    (fun t => auxiliary t.succ)

/-- This is the paper's T-t actual budget, despite the initial mock observation.
The theorem also returns a complete future arm sequence with exactly that length. -/
theorem mockPolicy_budget (H : ℕ) (c : Precisions A) (m : Means A)
    (auxiliary : Fin (H + 1) → ℝ) (real : RawStream A H) :
    (trace (mockPolicy i H c m auxiliary) real).length = H := trace_budget _ _

theorem mockPolicy_recommends_retained (H : ℕ) (c : Precisions A) (m : Means A)
    (auxiliary : Fin (H + 1) → ℝ) (real : RawStream A H) :
    run (mockPolicy i H c m auxiliary) real ≠ i := replay_excludes i _ _ _ _ _

/-- The complete mock execution agrees pathwise with the real forced-i
Bayes continuation, supplied the substituted array and terminal restriction. -/
theorem mockPolicy_run_eq_full (H : ℕ) (c : Precisions A) (m : Means A)
    (auxiliary : Fin (H + 1) → ℝ) (real : RawStream A (H + 1)) :
    run (mockPolicy i H c m auxiliary) (tail real) =
      run (terminalModified i (forcedPolicy i H c m) c m) (substitute i real auxiliary) := by
  simp only [mockPolicy, forcedPolicy, terminalModified, run, substitute, if_true]
  exact replay_run_eq i _ _ _ _ _

end Removed
end
end BayesOptimal.MockPolicy

end

/-! ## ObservationBridge -/
section

open MeasureTheory ProbabilityTheory
open scoped NNReal ENNReal

namespace BayesOptimal.ObservationBridge

noncomputable section

theorem charFunDual_centered_gaussian (v : ℝ≥0) (L : ℝ →L[ℝ] ℝ) :
    charFunDual (gaussianReal 0 v) L =
      Complex.exp (-((v : ℝ) * (L 1)^2 : ℝ) / 2) := by
  rw [charFunDual_eq_charFun_map_one, gaussianReal_map_continuousLinearMap,
    charFun_gaussianReal]
  simp only [map_zero, Complex.ofReal_zero, zero_mul, mul_zero, zero_sub,
    NNReal.coe_mul, Real.coe_toNNReal', max_eq_left (sq_nonneg _)]
  congr 1
  push_cast
  ring

def updateLinear (c : ℝ≥0) : (ℝ × ℝ) →L[ℝ] (ℝ × ℝ) :=
  (((((c : ℝ)+1)⁻¹) • (ContinuousLinearMap.fst ℝ ℝ ℝ +
      ContinuousLinearMap.snd ℝ ℝ ℝ)).prod
    (((c : ℝ) / ((c : ℝ)+1)) • ContinuousLinearMap.fst ℝ ℝ ℝ -
      (((c : ℝ)+1)⁻¹) • ContinuousLinearMap.snd ℝ ℝ ℝ))

theorem updateLinear_apply (c : ℝ≥0) (x : ℝ × ℝ) :
    updateLinear c x = ((x.1+x.2)/((c : ℝ)+1),
      (c : ℝ)*x.1/((c : ℝ)+1)-x.2/((c : ℝ)+1)) := by
  ext <;> simp [updateLinear, div_eq_mul_inv] <;> ring

theorem update_joint_law (c : ℝ≥0) (hc : 0 < c) :
    (((gaussianReal 0 c⁻¹).prod (gaussianReal 0 1)).map (updateLinear c)) =
      (gaussianReal 0 (BayesOptimal.Foundations.Gaussian.updateVariance c)).prod
        (gaussianReal 0 (c+1)⁻¹) := by
  apply Measure.ext_of_charFunDual
  funext L
  rw [charFunDual_map, charFunDual_prod, charFunDual_prod]
  simp_rw [charFunDual_centered_gaussian]
  rw [← Complex.exp_add, ← Complex.exp_add]
  congr 1
  have hc0 : (c : ℝ) ≠ 0 := ne_of_gt (by exact_mod_cast hc)
  have hc1 : (c : ℝ)+1 ≠ 0 := by positivity
  have hleft : (L.comp (updateLinear c)).comp (ContinuousLinearMap.inl ℝ ℝ ℝ) 1 =
      ((c : ℝ)+1)⁻¹ * L (1,0) + (c : ℝ)/((c : ℝ)+1) * L (0,1) := by
    change L (updateLinear c (1,0)) = _
    rw [updateLinear_apply]
    have hx : ((1+0)/((c : ℝ)+1), (c : ℝ)*1/((c : ℝ)+1)-0/((c : ℝ)+1)) =
        ((c : ℝ)+1)⁻¹ • (1,0) + ((c : ℝ)/((c : ℝ)+1)) • (0,1) := by
      ext <;> simp
    rw [hx, map_add, map_smul, map_smul]
    rfl
  have hright : (L.comp (updateLinear c)).comp (ContinuousLinearMap.inr ℝ ℝ ℝ) 1 =
      ((c : ℝ)+1)⁻¹ * L (1,0) - ((c : ℝ)+1)⁻¹ * L (0,1) := by
    change L (updateLinear c (0,1)) = _
    rw [updateLinear_apply]
    have hx : ((0+1)/((c : ℝ)+1), (c : ℝ)*0/((c : ℝ)+1)-1/((c : ℝ)+1)) =
        ((c : ℝ)+1)⁻¹ • (1,0) - ((c : ℝ)+1)⁻¹ • (0,1) := by
      ext <;> simp
    rw [hx, map_sub, map_smul, map_smul]
    rfl
  rw [hleft, hright]
  simp only [ContinuousLinearMap.comp_apply, ContinuousLinearMap.inl_apply,
    ContinuousLinearMap.inr_apply, NNReal.coe_inv, NNReal.coe_one,
    BayesOptimal.Foundations.Gaussian.updateVariance, NNReal.coe_mul, NNReal.coe_add]
  have he (a b : ℝ) :
      -((c : ℝ)⁻¹ * (((c : ℝ)+1)⁻¹*a + (c : ℝ)/((c : ℝ)+1)*b)^2)/2 +
      -((((c : ℝ)+1)⁻¹*a - ((c : ℝ)+1)⁻¹*b)^2)/2 =
      -(((c : ℝ)*((c : ℝ)+1))⁻¹*a^2)/2 + -(((c : ℝ)+1)⁻¹*b^2)/2 := by
    field_simp [hc0, hc1]
    ring
  have hz := congrArg (fun x : ℝ => (x : ℂ)) (he (L (1,0)) (L (0,1)))
  push_cast at hz
  push_cast
  simpa only [one_mul] using hz

def rawPair (m : ℝ) (x : ℝ × ℝ) : ℝ × ℝ :=
  (m+x.1, m+x.1+x.2)

def posteriorPair (c : ℝ≥0) (m : ℝ) (x : ℝ × ℝ) : ℝ × ℝ :=
  (m+x.1+x.2, m+((c : ℝ)+1)*x.1)

@[fun_prop] theorem rawPair_measurable (m : ℝ) : Measurable (rawPair m) := by
  unfold rawPair
  fun_prop

@[fun_prop] theorem posteriorPair_measurable (c : ℝ≥0) (m : ℝ) :
    Measurable (posteriorPair c m) := by
  unfold posteriorPair
  fun_prop

theorem rawPair_eq_posteriorPair_update (c : ℝ≥0) (m : ℝ) (x : ℝ × ℝ) :
    rawPair m x = posteriorPair c m (updateLinear c x) := by
  have hc1 : (c : ℝ)+1 ≠ 0 := by positivity
  rw [updateLinear_apply]
  ext <;> simp only [rawPair, posteriorPair] <;> field_simp [hc1] <;> ring

/-- The actual joint law of a Gaussian latent mean and its noisy observation
equals the posterior-innovation/posterior-residual representation. -/
theorem scalar_observation_joint_law (c : ℝ≥0) (hc : 0 < c) (m : ℝ) :
    (((gaussianReal 0 c⁻¹).prod (gaussianReal 0 1)).map (rawPair m)) =
      (((gaussianReal 0 (BayesOptimal.Foundations.Gaussian.updateVariance c)).prod
        (gaussianReal 0 (c+1)⁻¹)).map (posteriorPair c m)) := by
  rw [← update_joint_law c hc, Measure.map_map (by fun_prop) (by fun_prop)]
  congr 1
  funext x
  exact rawPair_eq_posteriorPair_update c m x

theorem scalar_observation_integral (c : ℝ≥0) (hc : 0 < c) (m : ℝ)
    (f : ℝ × ℝ → ℝ) (hf : Measurable f) :
    (∫ x : ℝ × ℝ, f (rawPair m x)
      ∂(gaussianReal 0 c⁻¹).prod (gaussianReal 0 1)) =
    ∫ x : ℝ × ℝ, f (posteriorPair c m x)
      ∂(gaussianReal 0 (BayesOptimal.Foundations.Gaussian.updateVariance c)).prod
        (gaussianReal 0 (c+1)⁻¹) := by
  rw [← integral_map (by fun_prop) hf.aestronglyMeasurable,
    scalar_observation_joint_law c hc m,
    integral_map (by fun_prop) hf.aestronglyMeasurable]

theorem prod_preserving {X Y U V : Type*} [MeasurableSpace X] [MeasurableSpace Y]
    [MeasurableSpace U] [MeasurableSpace V] {μ : Measure X} {ν : Measure Y}
    {ρ : Measure U} {σ : Measure V} [SFinite μ] [SFinite ρ]
    {f : X → Y} {g : U → V} (hf : MeasurePreserving f μ ν)
    (hg : MeasurePreserving g ρ σ) :
    MeasurePreserving (Prod.map f g) (μ.prod ρ) (ν.prod σ) := by
  refine ⟨hf.measurable.prodMap hg.measurable, ?_⟩
  rw [← Measure.map_prod_map μ ρ hf.measurable hg.measurable, hf.map_eq, hg.map_eq]

theorem middle_swap_preserving {X Y U : Type*} [MeasurableSpace X]
    [MeasurableSpace Y] [MeasurableSpace U] (μ : Measure X) (ν : Measure Y)
    (ρ : Measure U) [SFinite μ] [SFinite ν] [SFinite ρ] :
    MeasurePreserving (fun x : (X × Y) × U => ((x.1.1,x.2),x.1.2))
      ((μ.prod ν).prod ρ) ((μ.prod ρ).prod ν) := by
  have h1 := measurePreserving_prodAssoc μ ν ρ
  have h2 := prod_preserving (MeasurePreserving.id μ)
    (Measure.measurePreserving_swap (μ := ν) (ν := ρ))
  have h3 := MeasurePreserving.symm MeasurableEquiv.prodAssoc
    (measurePreserving_prodAssoc μ ρ ν)
  exact h3.comp (h2.comp h1)

section Finite

open BayesOptimal.FiniteGaussian BayesOptimal.FinitePosterior

variable {A : Type*} [Fintype A] [DecidableEq A]

def translatedJoin (m : Means A) (i : A) (x : ℝ × ({a : A // a ≠ i} → ℝ)) :
    Means A := m + join i x

@[fun_prop] theorem translatedJoin_measurable (m : Means A) (i : A) :
    Measurable (translatedJoin m i) := by
  exact (continuous_const.add (join_continuous i)).measurable

theorem translatedJoin_preserving (c : Precisions A) (m : Means A) (i : A) :
    MeasurePreserving (translatedJoin m i)
      ((gaussianReal 0 (c i)⁻¹).prod (otherLaw c i)) (posteriorLaw c m) := by
  refine ⟨translatedJoin_measurable m i, ?_⟩
  unfold posteriorLaw
  rw [← join_law c i, Measure.map_map (by fun_prop) (join_continuous i).measurable]
  rfl

def rawObservation (i : A) (x : Means A × ℝ) : Means A × ℝ :=
  (x.1, x.1 i+x.2)

def reconstructedObservation (c : Precisions A) (m : Means A) (i : A)
    (x : ℝ × Means A) : Means A × ℝ :=
  (shift m i x.1+x.2, m i+((c i : ℝ)+1)*x.1)

omit [Fintype A] [DecidableEq A] in
@[fun_prop] theorem rawObservation_measurable (i : A) : Measurable (rawObservation i) := by
  unfold rawObservation
  fun_prop

omit [Fintype A] in
@[fun_prop] theorem reconstructedObservation_measurable
    (c : Precisions A) (m : Means A) (i : A) :
    Measurable (reconstructedObservation c m i) := by
  unfold reconstructedObservation
  apply Measurable.prodMk
  · apply measurable_pi_lambda
    intro a
    simp only [shift, Pi.add_apply]
    split_ifs <;> fun_prop
  · fun_prop

/-- Full finite-arm Gaussian observation/posterior disintegration as an
equality of joint laws. It applies to arbitrary measurable adaptive payoffs. -/
theorem observation_joint_law (c : Precisions A) (m : Means A) (i : A)
    (hc : 0 < c i) :
    ((posteriorLaw c m).prod (gaussianReal 0 1)).map (rawObservation i) =
      ((gaussianReal 0 (innovation c i)).prod (centeredLaw (advance c i))).map
        (reconstructedObservation c m i) := by
  let μ := gaussianReal 0 (c i)⁻¹
  let ν := gaussianReal (0 : ℝ) (1 : ℝ≥0)
  let ρ := otherLaw c i
  let ζ := gaussianReal 0 (innovation c i)
  let η := gaussianReal 0 (c i+1)⁻¹
  have hraw := (prod_preserving (translatedJoin_preserving c m i)
    (MeasurePreserving.id ν)).comp (middle_swap_preserving μ ν ρ)
  have hupdate : MeasurePreserving (updateLinear (c i)) (μ.prod ν) (ζ.prod η) :=
    ⟨by fun_prop, update_joint_law (c i) hc⟩
  have hcenter : MeasurePreserving (join i) (η.prod ρ) (centeredLaw (advance c i)) := by
    refine ⟨(join_continuous i).measurable, ?_⟩
    have hj := join_law (advance c i) i
    rw [otherLaw_advance] at hj
    simpa only [advance, if_pos rfl, add_zero, add_comm] using hj
  have hpost := (prod_preserving (MeasurePreserving.id ζ) hcenter).comp
    ((measurePreserving_prodAssoc ζ η ρ).comp
      (prod_preserving hupdate (MeasurePreserving.id ρ)))
  have hr := congrArg (fun l => l.map (rawObservation i)) hraw.map_eq
  dsimp only at hr
  rw [Measure.map_map (rawObservation_measurable i) hraw.measurable] at hr
  have hp := congrArg (fun l => l.map (reconstructedObservation c m i)) hpost.map_eq
  dsimp only at hp
  rw [Measure.map_map (reconstructedObservation_measurable c m i) hpost.measurable] at hp
  rw [← hr, ← hp]
  congr 1
  funext x
  dsimp only [Function.comp_def, Prod.map, id, MeasurableEquiv.prodAssoc,
    Equiv.prodAssoc, translatedJoin, rawObservation, reconstructedObservation]
  rw [updateLinear_apply]
  have hc1 : (c i : ℝ)+1 ≠ 0 := by positivity
  apply Prod.ext
  · ext a
    by_cases ha : a = i
    · subst a
      simp only [Pi.add_apply, join, shift, dite_true, ite_true]
      field_simp [hc1]
      ring
    · simp [Pi.add_apply, join, shift, ha]
  · simp only [Pi.add_apply, join, dite_true]
    field_simp [hc1]
    ring

theorem observation_integral (c : Precisions A) (m : Means A) (i : A)
    (hc : 0 < c i) (f : Means A × ℝ → ℝ) (hf : Measurable f) :
    (∫ x : Means A × ℝ, f (rawObservation i x)
      ∂(posteriorLaw c m).prod (gaussianReal 0 1)) =
    ∫ x : ℝ × Means A, f (reconstructedObservation c m i x)
      ∂(gaussianReal 0 (innovation c i)).prod (centeredLaw (advance c i)) := by
  rw [← integral_map (rawObservation_measurable i).aemeasurable hf.aestronglyMeasurable,
    observation_joint_law c m i hc,
    integral_map (reconstructedObservation_measurable c m i).aemeasurable
      hf.aestronglyMeasurable]

end Finite

end
end BayesOptimal.ObservationBridge

end

/-! ## EmbeddingExecution -/
section

set_option linter.unusedSectionVars false

open MeasureTheory ProbabilityTheory
open scoped NNReal ENNReal

namespace BayesOptimal.EmbeddingExecution

open FiniteGaussian FinitePosterior EmbeddingRaw FiniteModelMeasurable

variable {A : Type*} [Fintype A] [Nonempty A] [DecidableEq A]

noncomputable section

def arrayLaw (H : ℕ) : Measure (RawStream A H) :=
  Measure.pi (fun _ : A => MockStream.noiseLaw H)

instance arrayLaw_probability (H : ℕ) : IsProbabilityMeasure (arrayLaw (A := A) H) := by
  unfold arrayLaw
  infer_instance

def splitNoise {H : ℕ} (e : RawStream A (H + 1)) : (A → ℝ) × RawStream A H :=
  (fun a => e a ⟨0, Nat.zero_lt_succ H⟩, tail e)

theorem splitNoise_preserving (H : ℕ) :
    MeasurePreserving (splitNoise (A := A)) (arrayLaw (A := A) (H + 1))
      ((Measure.pi (fun _ : A => gaussianReal 0 1)).prod (arrayLaw (A := A) H)) := by
  have h1 := measurePreserving_pi
    (fun _ : A => MockStream.noiseLaw (H + 1))
    (fun _ : A => (gaussianReal 0 1).prod (MockStream.noiseLaw H))
    (fun _ => measurePreserving_piFinSuccAbove
      (fun _ : Fin (H + 1) => gaussianReal 0 1) ⟨0, Nat.zero_lt_succ H⟩)
  have h2 := measurePreserving_arrowProdEquivProdArrow ℝ (Fin H → ℝ) A
    (fun _ => gaussianReal 0 1) (fun _ => MockStream.noiseLaw H)
  convert h2.comp h1 using 1

theorem selected_noise_split_preserving (H : ℕ) (a : A) :
    MeasurePreserving (fun e : RawStream A (H + 1) =>
      (e a ⟨0, Nat.zero_lt_succ H⟩, tail e)) (arrayLaw (A := A) (H + 1))
      ((gaussianReal 0 1).prod (arrayLaw (A := A) H)) := by
  exact ((measurePreserving_eval (fun _ : A => gaussianReal 0 1) a).prod
    (MeasurePreserving.id (arrayLaw (A := A) H))).comp (splitNoise_preserving H)

def worldLaw (H : ℕ) (c : Precisions A) (m : Means A) :
    Measure (Means A × RawStream A H) := (posteriorLaw c m).prod (arrayLaw H)

instance worldLaw_probability (H : ℕ) (c : Precisions A) (m : Means A) :
    IsProbabilityMeasure (worldLaw H c m) := by unfold worldLaw; infer_instance

def observations {H : ℕ} (w : Means A × RawStream A H) : RawStream A H :=
  fun a t => w.1 a + w.2 a t

theorem observations_measurable (H : ℕ) : Measurable (observations (A := A) (H := H)) := by
  unfold observations
  fun_prop

section Measurable
variable [MeasurableSpace A] [MeasurableSingletonClass A]

def Regular : {H : ℕ} → Strategy (A := A) H → Prop
  | 0, .stop _ => True
  | _ + 1, .sample _ next =>
      (∀ y, Regular (next y)) ∧
      Measurable (fun p : ℝ × RawStream A _ => run (next p.1) p.2)

theorem regular_run_measurable {H : ℕ} (s : Strategy (A := A) H) (hs : Regular s) :
    Measurable (run s) := by
  cases s with
  | stop a => exact measurable_const
  | @sample H a next =>
    have hm : Measurable (fun r : RawStream A (H + 1) =>
        (r a ⟨0, Nat.zero_lt_succ H⟩, tail r)) := by unfold tail; fun_prop
    exact hs.2.comp hm

def rawRisk {H : ℕ} (s : Strategy (A := A) H) (c : Precisions A) (m : Means A) : ℝ :=
  ∫ w, maxAll w.1 - w.1 (run s (observations w)) ∂worldLaw H c m

theorem rawRisk_integrable {H : ℕ} (s : Strategy (A := A) H)
    (c : Precisions A) (m : Means A) (hs : Measurable (run s)) :
    Integrable (fun w : Means A × RawStream A H => maxAll w.1 - w.1 (run s (observations w)))
      (worldLaw H c m) := by
  have hc (a : A) : Integrable (fun w : Means A × RawStream A H => w.1 a)
      (worldLaw H c m) :=
    (posterior_coordinate_integrable c m a).comp_fst (arrayLaw H)
  have hsum : Integrable (fun w : Means A × RawStream A H => ∑ a, |w.1 a|)
      (worldLaw H c m) := by
    apply integrable_finset_sum
    intro a _
    simpa only [Real.norm_eq_abs] using (hc a).norm
  have hcoord : Measurable (fun p : (Means A × RawStream A H) × A => p.1.1 p.2) :=
    measurable_from_prod_countable_left (fun a => by
      change Measurable (fun w : Means A × RawStream A H => w.1 a)
      exact (measurable_pi_apply a).comp measurable_fst)
  have hsel : Measurable (fun w : Means A × RawStream A H => w.1 (run s (observations w))) :=
    hcoord.comp (measurable_id.prodMk (hs.comp (observations_measurable H)))
  have hi : Integrable (fun w : Means A × RawStream A H => w.1 (run s (observations w)))
      (worldLaw H c m) := by
    apply hsum.mono' hsel.aestronglyMeasurable
    apply Filter.Eventually.of_forall
    intro w
    rw [Real.norm_eq_abs]
    exact Finset.single_le_sum (fun a _ => abs_nonneg (w.1 a)) (Finset.mem_univ _)
  exact ((posterior_integrable maxAll_lipschitz c m).comp_fst (arrayLaw H)).sub hi

theorem rawRisk_zero (a : A) (c : Precisions A) (m : Means A) :
    rawRisk (.stop a) c m = terminalRegret c m a := by
  unfold rawRisk worldLaw
  simp only [run]
  simpa only [measureReal_univ_eq_one, one_smul, terminalRegret] using
    integral_fun_fst (μ := posteriorLaw c m) (ν := arrayLaw (A := A) 0)
    (fun u : Means A => maxAll u - u a)

theorem optimalFirst_raw_run_measurable (H : ℕ) (c : Precisions A) :
    Measurable (fun p : Means A × RawStream A H =>
      run (rawOfInnovation (optimalFirst H c p.1) c p.1) p.2) := by
  induction H generalizing c with
  | zero => exact firstMax_measurable.comp measurable_fst
  | succ H ih =>
    let g : (Means A × RawStream A (H + 1)) × A → A := fun p =>
      run (rawOfInnovation (optimalFirst H (advance c p.2)
        (shift p.1.1 p.2 ((p.1.2 p.2 ⟨0, Nat.zero_lt_succ H⟩ - p.1.1 p.2) /
          ((c p.2 : ℝ) + 1)))) (advance c p.2)
        (shift p.1.1 p.2 ((p.1.2 p.2 ⟨0, Nat.zero_lt_succ H⟩ - p.1.1 p.2) /
          ((c p.2 : ℝ) + 1)))) (tail p.1.2)
    have hg : Measurable g := by
      apply measurable_from_prod_countable_left
      intro a
      have ht : Measurable (fun p : Means A × RawStream A (H + 1) =>
          (shift p.1 a ((p.2 a ⟨0, Nat.zero_lt_succ H⟩ - p.1 a) / ((c a : ℝ) + 1)),
            tail p.2)) := by
        apply Measurable.prodMk
        · apply measurable_pi_lambda
          intro b
          simp only [shift]
          split_ifs <;> fun_prop
        · unfold tail; fun_prop
      exact (ih (advance c a)).comp ht
    have hm := hg.comp (measurable_id.prodMk ((chooseFirst_measurable H c).comp measurable_fst))
    exact hm

theorem optimalFirst_raw_regular (H : ℕ) (c : Precisions A) (m : Means A) :
    Regular (rawOfInnovation (optimalFirst H c m) c m) := by
  induction H generalizing c m with
  | zero => trivial
  | succ H ih =>
    constructor
    · intro y; exact ih _ _
    · have ht : Measurable (fun p : ℝ × RawStream A H =>
          (shift m (chooseFirst H c m)
            ((p.1 - m (chooseFirst H c m)) / ((c (chooseFirst H c m) : ℝ) + 1)), p.2)) := by
        apply Measurable.prodMk
        · apply measurable_pi_lambda
          intro a
          simp only [shift]
          split_ifs <;> fun_prop
        · exact measurable_snd
      exact (optimalFirst_raw_run_measurable H (advance c (chooseFirst H c m))).comp ht

def continuationPayoff {H : ℕ} (next : ℝ → Strategy (A := A) H)
    (p : (Means A × ℝ) × RawStream A H) : ℝ :=
  maxAll p.1.1 - p.1.1 (run (next p.1.2) (observations (p.1.1, p.2)))

theorem continuationPayoff_measurable {H : ℕ} (next : ℝ → Strategy (A := A) H)
    (hnext : Measurable (fun p : ℝ × RawStream A H => run (next p.1) p.2)) :
    Measurable (continuationPayoff next) := by
  have hselect : Measurable (fun p : (Means A × ℝ) × RawStream A H =>
      run (next p.1.2) (observations (p.1.1, p.2))) := by
    have ht : Measurable (fun p : (Means A × ℝ) × RawStream A H =>
        (p.1.2, observations (p.1.1, p.2))) := by unfold observations; fun_prop
    exact hnext.comp ht
  have hcoord : Measurable (fun p : ((Means A × ℝ) × RawStream A H) × A =>
      p.1.1.1 p.2) := measurable_from_prod_countable_left (fun a => by
        change Measurable (fun p : (Means A × ℝ) × RawStream A H => p.1.1 a)
        fun_prop)
  exact ((maxAll_lipschitz (A := A)).continuous.measurable.comp
    (measurable_fst.comp measurable_fst)).sub
      (hcoord.comp (measurable_id.prodMk hselect))

theorem continuationPayoff_norm_le {H : ℕ} (next : ℝ → Strategy (A := A) H)
    (p : (Means A × ℝ) × RawStream A H) :
    ‖continuationPayoff next p‖ ≤ 2 * ∑ a, |p.1.1 a| := by
  obtain ⟨a, ha⟩ := maxAll_attained p.1.1
  have h1 := Finset.single_le_sum (fun a _ => abs_nonneg (p.1.1 a)) (Finset.mem_univ a)
  have h2 := Finset.single_le_sum (fun a _ => abs_nonneg (p.1.1 a))
    (Finset.mem_univ (run (next p.1.2) (observations (p.1.1, p.2))))
  unfold continuationPayoff
  rw [Real.norm_eq_abs, ← ha]
  have hb := abs_add_le (p.1.1 a) (-p.1.1 (run (next p.1.2) (observations (p.1.1, p.2))))
  rw [abs_neg, ← sub_eq_add_neg] at hb
  linarith

theorem continuationPayoff_raw_integrable {H : ℕ} (next : ℝ → Strategy (A := A) H)
    (hnext : Measurable (fun p : ℝ × RawStream A H => run (next p.1) p.2))
    (c : Precisions A) (m : Means A) (a : A) :
    Integrable (fun p : (Means A × ℝ) × RawStream A H =>
      continuationPayoff next (ObservationBridge.rawObservation a p.1, p.2))
      (((posteriorLaw c m).prod (gaussianReal 0 1)).prod (arrayLaw H)) := by
  have hi : Integrable (fun p : (Means A × ℝ) × RawStream A H =>
      2 * ∑ b, |p.1.1 b|)
      (((posteriorLaw c m).prod (gaussianReal 0 1)).prod (arrayLaw H)) := by
    apply Integrable.const_mul
    apply integrable_finset_sum
    intro b _
    simpa only [Real.norm_eq_abs] using
      (((posterior_coordinate_integrable c m b).norm.comp_fst (gaussianReal 0 1)).comp_fst
        (arrayLaw H))
  apply hi.mono' (((continuationPayoff_measurable next hnext).comp
    (by fun_prop)).aestronglyMeasurable)
  exact Filter.Eventually.of_forall (fun p => continuationPayoff_norm_le next
    (ObservationBridge.rawObservation a p.1, p.2))

/-- Exact raw reward disintegration for an arbitrary measurable finite
adaptive tree; all unused calendar noise is integrated out explicitly. -/
theorem rawRisk_succ_data {H : ℕ} (a : A) (next : ℝ → Strategy (A := A) H)
    (c : Precisions A) (m : Means A) (hc : 0 < c a)
    (hnext : Measurable (fun p : ℝ × RawStream A H => run (next p.1) p.2)) :
    (rawRisk (.sample a next) c m =
      ∫ z, rawRisk (next (m a + ((c a : ℝ) + 1) * z)) (advance c a) (shift m a z)
        ∂gaussianReal 0 (innovation c a)) ∧
    Integrable (fun z => rawRisk (next (m a + ((c a : ℝ) + 1) * z))
      (advance c a) (shift m a z)) (gaussianReal 0 (innovation c a)) := by
  let F := continuationPayoff next
  have hF : Measurable F := continuationPayoff_measurable next hnext
  have hraw : Integrable (fun p : (Means A × ℝ) × RawStream A H =>
      F (ObservationBridge.rawObservation a p.1, p.2))
      (((posteriorLaw c m).prod (gaussianReal 0 1)).prod (arrayLaw H)) :=
    continuationPayoff_raw_integrable next hnext c m a
  have hsplit := (MeasurePreserving.symm MeasurableEquiv.prodAssoc
    (measurePreserving_prodAssoc (posteriorLaw c m) (gaussianReal 0 1) (arrayLaw H))).comp
      ((MeasurePreserving.id (posteriorLaw c m)).prod (selected_noise_split_preserving H a))
  have hfirst : rawRisk (.sample a next) c m =
      ∫ p : (Means A × ℝ) × RawStream A H,
        F (ObservationBridge.rawObservation a p.1, p.2)
          ∂((posteriorLaw c m).prod (gaussianReal 0 1)).prod (arrayLaw H) := by
    have hfraw : Measurable (fun p : (Means A × ℝ) × RawStream A H =>
        F (ObservationBridge.rawObservation a p.1, p.2)) := by
      exact hF.comp ((ObservationBridge.rawObservation_measurable a).prodMap measurable_id)
    rw [← hsplit.map_eq, integral_map hsplit.measurable.aemeasurable hfraw.aestronglyMeasurable]
    rfl
  let G : Means A × ℝ → ℝ := fun p => ∫ e, F (p, e) ∂arrayLaw H
  have hG : Measurable G := (hF.stronglyMeasurable.integral_prod_right').measurable
  have hsecond : rawRisk (.sample a next) c m =
      ∫ p : ℝ × Means A, G (ObservationBridge.reconstructedObservation c m a p)
        ∂(gaussianReal 0 (innovation c a)).prod (centeredLaw (advance c a)) := by
    rw [hfirst, integral_prod _ hraw]
    exact ObservationBridge.observation_integral c m a hc G hG
  have hrawMap : Integrable F
      ((((posteriorLaw c m).prod (gaussianReal 0 1)).map
        (ObservationBridge.rawObservation a)).prod (arrayLaw H)) := by
    have hpres : MeasurePreserving (ObservationBridge.rawObservation a)
        ((posteriorLaw c m).prod (gaussianReal 0 1))
        (((posteriorLaw c m).prod (gaussianReal 0 1)).map
          (ObservationBridge.rawObservation a)) :=
      ⟨by fun_prop, rfl⟩
    exact ((hpres.prod (MeasurePreserving.id (arrayLaw H))).integrable_comp
      hF.aestronglyMeasurable).mp hraw
  rw [ObservationBridge.observation_joint_law c m a hc] at hrawMap
  have hpost : Integrable (fun p : (ℝ × Means A) × RawStream A H =>
      F (ObservationBridge.reconstructedObservation c m a p.1, p.2))
      (((gaussianReal 0 (innovation c a)).prod (centeredLaw (advance c a))).prod
        (arrayLaw H)) := by
    have hpres : MeasurePreserving (ObservationBridge.reconstructedObservation c m a)
        ((gaussianReal 0 (innovation c a)).prod (centeredLaw (advance c a)))
        (((gaussianReal 0 (innovation c a)).prod (centeredLaw (advance c a))).map
          (ObservationBridge.reconstructedObservation c m a)) := ⟨by fun_prop, rfl⟩
    exact (hpres.prod (MeasurePreserving.id (arrayLaw H))).integrable_comp_of_integrable hrawMap
  have hpostG : Integrable (fun p : ℝ × Means A =>
      G (ObservationBridge.reconstructedObservation c m a p))
      ((gaussianReal 0 (innovation c a)).prod (centeredLaw (advance c a))) :=
    hpost.integral_prod_left
  rw [integral_prod _ hpostG] at hsecond
  have hzEq (z : ℝ) :
      (∫ u : Means A, G (ObservationBridge.reconstructedObservation c m a (z, u))
        ∂centeredLaw (advance c a)) =
      rawRisk (next (m a + ((c a : ℝ) + 1) * z)) (advance c a) (shift m a z) := by
    have hr : Measurable (run (next (m a + ((c a : ℝ) + 1) * z))) :=
      hnext.comp (measurable_const.prodMk measurable_id)
    have hc' : Measurable (fun p : (Means A × RawStream A H) × A => p.1.1 p.2) :=
      measurable_from_prod_countable_left (fun b => by
        change Measurable (fun p : Means A × RawStream A H => p.1 b)
        fun_prop)
    have hfz : Measurable (fun p : Means A × RawStream A H =>
        maxAll p.1 - p.1 (run (next (m a + ((c a : ℝ) + 1) * z)) (observations p))) :=
      ((maxAll_lipschitz (A := A)).continuous.measurable.comp measurable_fst).sub
        (hc'.comp (measurable_id.prodMk (hr.comp (observations_measurable H))))
    unfold G F rawRisk worldLaw
    simp only [posteriorLaw]
    conv_rhs => rw [← Measure.map_id (μ := arrayLaw (A := A) H)]
    rw [
      Measure.map_prod_map _ _ (by fun_prop) measurable_id,
      integral_map (by fun_prop) hfz.aestronglyMeasurable]
    have hz : Integrable (fun p : Means A × RawStream A H =>
        continuationPayoff next
          (ObservationBridge.reconstructedObservation c m a (z, p.1), p.2))
        ((centeredLaw (advance c a)).prod (arrayLaw H)) := by
      have hi := rawRisk_integrable (next (m a + ((c a : ℝ) + 1) * z))
        (advance c a) (shift m a z) hr
      simp only [worldLaw, posteriorLaw] at hi
      rw [← Measure.map_id (μ := arrayLaw (A := A) H),
        Measure.map_prod_map _ _ (by fun_prop) measurable_id] at hi
      exact hi.comp_measurable (by fun_prop)
    exact (integral_prod _ hz).symm
  constructor
  · simpa only [hzEq] using hsecond
  · simpa only [hzEq] using hpostG.integral_prod_left

theorem rawRisk_succ {H : ℕ} (a : A) (next : ℝ → Strategy (A := A) H)
    (c : Precisions A) (m : Means A) (hc : 0 < c a)
    (hnext : Measurable (fun p : ℝ × RawStream A H => run (next p.1) p.2)) :
    rawRisk (.sample a next) c m =
      ∫ z, rawRisk (next (m a + ((c a : ℝ) + 1) * z)) (advance c a) (shift m a z)
        ∂gaussianReal 0 (innovation c a) :=
  (rawRisk_succ_data a next c m hc hnext).1

/-- Raw-history strategies, including strategies that deliberately discard
some real observations, cannot improve on the actual Gaussian Bellman loss. -/
theorem rawRisk_ge_loss {H : ℕ} (s : Strategy (A := A) H) (c : Precisions A)
    (m : Means A) (hc : ∀ a, 0 < c a) (hs : Regular s) :
    loss H c m ≤ rawRisk s c m := by
  induction H generalizing c m with
  | zero =>
    cases s with
    | stop a =>
      rw [rawRisk_zero, terminalRegret_eq]
      exact sub_le_sub_left (coordinate_le_maxAll m a) (potential c m)
  | succ H ih =>
    cases s with
    | sample a next =>
      have hdata := rawRisk_succ_data a next c m (hc a) hs.2
      have hi : Integrable (fun z => loss H (advance c a) (shift m a z))
          (gaussianReal 0 (innovation c a)) :=
        (shifted_integrable (potential_lipschitz _) m a _).sub (action_integrable H c m a)
      have h := integral_mono hi hdata.2 (fun z => ih (next _)
        (advance c a) (shift m a z) (advance_positive c a hc) (hs.1 _))
      rw [← hdata.1] at h
      change actionLoss H c m a ≤ rawRisk (.sample a next) c m at h
      rw [actionLoss_eq H c m a (hc a)] at h
      have ha := action_le_value H c m a
      unfold loss
      linarith

theorem rawRisk_ge_actionLoss {H : ℕ} (a : A) (next : ℝ → Strategy (A := A) H)
    (c : Precisions A) (m : Means A) (hc : ∀ b, 0 < c b)
    (hs : Regular (.sample a next)) :
    actionLoss H c m a ≤ rawRisk (.sample a next) c m := by
  have hdata := rawRisk_succ_data a next c m (hc a) hs.2
  have hi : Integrable (fun z => loss H (advance c a) (shift m a z))
      (gaussianReal 0 (innovation c a)) :=
    (shifted_integrable (potential_lipschitz _) m a _).sub (action_integrable H c m a)
  have h := integral_mono hi hdata.2 (fun z => rawRisk_ge_loss (next _)
    (advance c a) (shift m a z) (advance_positive c a hc) (hs.1 _))
  rw [← hdata.1] at h
  exact h

theorem recovered_innovation (c : ℝ≥0) (m z : ℝ) :
    (m + ((c : ℝ) + 1) * z - m) / ((c : ℝ) + 1) = z := by
  have h : (c : ℝ) + 1 ≠ 0 := by positivity
  field_simp [h]
  ring

/-- Actual latent-parameter/noise-array execution has exactly the same
posterior expected simple regret as the innovation-coordinate strategy. -/
theorem rawOfInnovation_risk {H : ℕ} (s : Strategy (A := A) H)
    (c : Precisions A) (m : Means A) (hc : ∀ a, 0 < c a)
    (hs : Regular (rawOfInnovation s c m)) :
    rawRisk (rawOfInnovation s c m) c m = expectedRegret s c m := by
  induction H generalizing c m with
  | zero => cases s with | stop a => exact rawRisk_zero a c m
  | succ H ih =>
    cases s with
    | sample a next =>
      let continuation : ℝ → Strategy (A := A) H := fun y =>
        let z := (y - m a) / ((c a : ℝ) + 1)
        rawOfInnovation (next z) (advance c a) (shift m a z)
      have hs' : Regular (.sample a continuation) := hs
      change rawRisk (.sample a continuation) c m = _
      rw [rawRisk_succ a continuation c m (hc a) hs'.2]
      apply integral_congr_ae
      apply Filter.Eventually.of_forall
      intro z
      have hreg := hs'.1 (m a + ((c a : ℝ) + 1) * z)
      simp only [continuation, recovered_innovation] at hreg ⊢
      exact ih (next z) (advance c a) (shift m a z) (advance_positive c a hc) hreg

/-- A genuine measurable raw-history optimal policy attains Bellman loss;
the result uses the proved observation disintegration, rather than assuming
that the latent Gaussian execution agrees with the Bellman recursion. -/
theorem optimalFirst_rawRisk (H : ℕ) (c : Precisions A) (m : Means A)
    (hc : ∀ a, 0 < c a) :
    rawRisk (rawOfInnovation (optimalFirst H c m) c m) c m = loss H c m := by
  rw [rawOfInnovation_risk _ _ _ hc (optimalFirst_raw_regular H c m),
    expectedRegret_eq _ _ _ (optimalFirst_admissible H c m) hc,
    optimalFirst_utility]
  rfl

end Measurable
end
end BayesOptimal.EmbeddingExecution

end

/-! ## MockMeasurable -/
section

set_option linter.unusedSectionVars false
set_option maxHeartbeats 1000000

open MeasureTheory ProbabilityTheory
open scoped NNReal ENNReal

namespace BayesOptimal.MockMeasurable

open BayesOptimal.FiniteGaussian BayesOptimal.FinitePosterior BayesOptimal.FiniteModelExclusion
open BayesOptimal.FiniteModelMeasurable BayesOptimal.EmbeddingRaw BayesOptimal.EmbeddingExecution
open BayesOptimal.MockPolicy

variable {A : Type*} [Fintype A] [Nonempty A] [DecidableEq A]
variable [MeasurableSpace A] [MeasurableSingletonClass A]

noncomputable section

section Removed
variable (i : A) [Nonempty {a : A // a ≠ i}]

/-- The full raw Bayes continuation with its posterior-best retained
terminal recommendation is jointly measurable in its means and reward array. -/
theorem modifiedOptimal_run_measurable (H : ℕ) (c : Precisions A) :
    Measurable (fun p : Means A × RawStream A H =>
      run (terminalModified i (rawOfInnovation (optimalFirst H c p.1) c p.1) c p.1) p.2) := by
  induction H generalizing c with
  | zero =>
    exact (terminalChoice_measurable i).comp
      (measurable_fst.prodMk (firstMax_measurable.comp measurable_fst))
  | succ H ih =>
    let g : (Means A × RawStream A (H + 1)) × A → A := fun p =>
      run (terminalModified i (rawOfInnovation (optimalFirst H (advance c p.2)
        (shift p.1.1 p.2 ((p.1.2 p.2 ⟨0, Nat.zero_lt_succ H⟩ - p.1.1 p.2) /
          ((c p.2 : ℝ) + 1)))) (advance c p.2)
        (shift p.1.1 p.2 ((p.1.2 p.2 ⟨0, Nat.zero_lt_succ H⟩ - p.1.1 p.2) /
          ((c p.2 : ℝ) + 1)))) (advance c p.2)
        (shift p.1.1 p.2 ((p.1.2 p.2 ⟨0, Nat.zero_lt_succ H⟩ - p.1.1 p.2) /
          ((c p.2 : ℝ) + 1)))) (tail p.1.2)
    have hg : Measurable g := by
      apply measurable_from_prod_countable_left
      intro a
      have ht : Measurable (fun p : Means A × RawStream A (H + 1) =>
          (shift p.1 a ((p.2 a ⟨0, Nat.zero_lt_succ H⟩ - p.1 a) / ((c a : ℝ) + 1)),
            tail p.2)) := by
        apply Measurable.prodMk
        · apply measurable_pi_lambda
          intro b
          simp only [shift]
          split_ifs <;> fun_prop
        · unfold tail; fun_prop
      exact (ih (advance c a)).comp ht
    exact hg.comp (measurable_id.prodMk ((chooseFirst_measurable H c).comp measurable_fst))

/-- Measurability remains true after real arm-i observations are ignored and
the externally generated pseudo-stream is supplied instead. -/
theorem replayOptimal_run_measurable (H : ℕ) (c : Precisions A) (imaginary : Fin H → ℝ) :
    Measurable (fun p : Means A × RawStream A H =>
      run (replay i (rawOfInnovation (optimalFirst H c p.1) c p.1) c p.1 imaginary) p.2) := by
  have ht : Measurable (fun p : Means A × RawStream A H =>
      (p.1, substitute i p.2 imaginary)) := by
    apply measurable_fst.prodMk
    apply measurable_pi_lambda
    intro a
    apply measurable_pi_lambda
    intro t
    simp only [substitute]
    split_ifs <;> fun_prop
  convert (modifiedOptimal_run_measurable i H c).comp ht using 1
  funext p
  exact replay_run_eq i _ _ _ _ _

/-- The mock policy is a regular measurable adaptive tree for each fixed
independent auxiliary stream; no real arm-i observation enters its continuation. -/
theorem replayOptimal_regular (H : ℕ) (c : Precisions A) (m : Means A)
    (imaginary : Fin H → ℝ) :
    Regular (replay i (rawOfInnovation (optimalFirst H c m) c m) c m imaginary) := by
  induction H generalizing c m with
  | zero => trivial
  | succ H ih =>
    let a := chooseFirst H c m
    by_cases ha : a = i
    · simp only [optimalFirst, rawOfInnovation, replay]
      rw [if_pos ha]
      change Regular (.sample a (fun _ =>
        replay i (rawOfInnovation (optimalFirst H (advance c a)
          (shift m a ((imaginary ⟨0, Nat.zero_lt_succ H⟩ - m a) / ((c a : ℝ) + 1))))
          (advance c a) (shift m a ((imaginary ⟨0, Nat.zero_lt_succ H⟩ - m a) /
            ((c a : ℝ) + 1)))) (advance c a)
          (shift m a ((imaginary ⟨0, Nat.zero_lt_succ H⟩ - m a) / ((c a : ℝ) + 1)))
          (fun t => imaginary t.succ)))
      constructor
      · intro _; exact ih _ _ _
      · exact (replayOptimal_run_measurable i H (advance c a) (fun t => imaginary t.succ)).comp
          (measurable_const.prodMk measurable_snd)
    · simp only [optimalFirst, rawOfInnovation, replay]
      rw [if_neg ha]
      change Regular (.sample a (fun y =>
        replay i (rawOfInnovation (optimalFirst H (advance c a)
          (shift m a ((y - m a) / ((c a : ℝ) + 1)))) (advance c a)
          (shift m a ((y - m a) / ((c a : ℝ) + 1)))) (advance c a)
          (shift m a ((y - m a) / ((c a : ℝ) + 1))) (fun t => imaginary t.succ)))
      constructor
      · intro _; exact ih _ _ _
      · have ht : Measurable (fun p : ℝ × RawStream A H =>
            (shift m a ((p.1 - m a) / ((c a : ℝ) + 1)), p.2)) := by
          apply Measurable.prodMk
          · apply measurable_pi_lambda
            intro b
            simp only [shift]
            split_ifs <;> fun_prop
          · exact measurable_snd
        exact (replayOptimal_run_measurable i H (advance c a)
          (fun t => imaginary t.succ)).comp ht

theorem mockPolicy_regular (H : ℕ) (c : Precisions A) (m : Means A)
    (auxiliary : Fin (H + 1) → ℝ) : Regular (mockPolicy i H c m auxiliary) :=
  replayOptimal_regular i H _ _ _

theorem forcedPolicy_run_measurable (H : ℕ) (c : Precisions A) (m : Means A) :
    Measurable (run (forcedPolicy i H c m)) := by
  have ht : Measurable (fun p : RawStream A (H + 1) =>
      (shift m i ((p i ⟨0, Nat.zero_lt_succ H⟩ - m i) / ((c i : ℝ) + 1)), tail p)) := by
    apply Measurable.prodMk
    · apply measurable_pi_lambda
      intro b
      simp only [shift]
      split_ifs <;> fun_prop
    · unfold tail; fun_prop
  exact (optimalFirst_raw_run_measurable H (advance c i)).comp ht

theorem forcedPolicy_regular (H : ℕ) (c : Precisions A) (m : Means A) :
    Regular (forcedPolicy i H c m) := by
  constructor
  · intro y
    exact optimalFirst_raw_regular H _ _
  · have ht : Measurable (fun p : ℝ × RawStream A H =>
        (shift m i ((p.1 - m i) / ((c i : ℝ) + 1)), p.2)) := by
      apply Measurable.prodMk
      · apply measurable_pi_lambda
        intro b
        simp only [shift]
        split_ifs <;> fun_prop
      · exact measurable_snd
    exact (optimalFirst_raw_run_measurable H (advance c i)).comp ht

theorem forcedPolicy_modified_run_measurable (H : ℕ) (c : Precisions A) (m : Means A) :
    Measurable (run (terminalModified i (forcedPolicy i H c m) c m)) := by
  have ht : Measurable (fun p : RawStream A (H + 1) =>
      (shift m i ((p i ⟨0, Nat.zero_lt_succ H⟩ - m i) / ((c i : ℝ) + 1)), tail p)) := by
    apply Measurable.prodMk
    · apply measurable_pi_lambda
      intro b
      simp only [shift]
      split_ifs <;> fun_prop
    · unfold tail; fun_prop
  exact (modifiedOptimal_run_measurable i H (advance c i)).comp ht

def pad {H : ℕ} (real : RawStream A H) : RawStream A (H + 1) :=
  fun a => Fin.cases 0 (real a)

theorem tail_pad {H : ℕ} (real : RawStream A H) : tail (pad real) = real := rfl

/-- Joint Borel dependence on the entire independently generated auxiliary
stream and the actual adaptive observations. -/
theorem mockPolicy_run_measurable (H : ℕ) (c : Precisions A) (m : Means A) :
    Measurable (fun p : (Fin (H + 1) → ℝ) × RawStream A H =>
      run (mockPolicy i H c m p.1) p.2) := by
  have ht : Measurable (fun p : (Fin (H + 1) → ℝ) × RawStream A H =>
      substitute i (pad p.2) p.1) := by
    apply measurable_pi_lambda
    intro a
    apply measurable_pi_lambda
    intro t
    by_cases ha : a = i
    · simp only [substitute, ha, if_true]
      fun_prop
    · simp only [substitute, if_neg ha, pad]
      refine Fin.cases ?_ (fun r => ?_) t
      · exact measurable_const
      · simp only [Fin.cases_succ]
        fun_prop
  convert (forcedPolicy_modified_run_measurable i H c m).comp ht using 1
  funext p
  have h := mockPolicy_run_eq_full i H c m p.1 (pad p.2)
  simpa only [tail_pad] using h

def auxiliaryOfBlock (H : ℕ) (m : Means A) (b : MockStream.Block (H + 1)) : Fin (H + 1) → ℝ :=
  fun t => m i + b.1 + b.2 t

theorem auxiliaryOfBlock_measurable (H : ℕ) (m : Means A) :
    Measurable (auxiliaryOfBlock i H m) := by
  unfold auxiliaryOfBlock
  fun_prop

theorem mockPolicy_block_run_measurable (H : ℕ) (c : Precisions A) (m : Means A) :
    Measurable (fun p : MockStream.Block (H + 1) × RawStream A H =>
      run (mockPolicy i H c m (auxiliaryOfBlock i H m p.1)) p.2) := by
  have ht : Measurable (fun p : MockStream.Block (H + 1) × RawStream A H =>
      (auxiliaryOfBlock i H m p.1, p.2)) :=
    ((auxiliaryOfBlock_measurable i H m).comp measurable_fst).prodMk measurable_snd
  exact (mockPolicy_run_measurable i H c m).comp ht

end Removed
end
end BayesOptimal.MockMeasurable

end

/-! ## MockMeasure -/
section

open MeasureTheory ProbabilityTheory
open scoped NNReal ENNReal

namespace BayesOptimal.MockMeasure

noncomputable section

/-- Exchange the middle two independent factors without changing their laws. -/
theorem cross_preserving {X Y Z W : Type*}
    [MeasurableSpace X] [MeasurableSpace Y] [MeasurableSpace Z] [MeasurableSpace W]
    (μ : Measure X) (ν : Measure Y) (ρ : Measure Z) (τ : Measure W)
    [SFinite μ] [SFinite ν] [SFinite ρ] [SFinite τ] :
    MeasurePreserving (fun p : (X × Y) × (Z × W) => ((p.1.1, p.2.1), (p.1.2, p.2.2)))
      ((μ.prod ν).prod (ρ.prod τ)) ((μ.prod ρ).prod (ν.prod τ)) := by
  have h1 := measurePreserving_prodAssoc μ ν (ρ.prod τ)
  have h2 := (MeasurePreserving.id μ).prod
    (MeasurePreserving.symm MeasurableEquiv.prodAssoc (measurePreserving_prodAssoc ν ρ τ))
  have h3 := (MeasurePreserving.id μ).prod
    ((Measure.measurePreserving_swap (μ := ν) (ν := ρ)).prod (MeasurePreserving.id τ))
  have h4 := (MeasurePreserving.id μ).prod (measurePreserving_prodAssoc ρ ν τ)
  have h5 := MeasurePreserving.symm MeasurableEquiv.prodAssoc
    (measurePreserving_prodAssoc μ ρ (ν.prod τ))
  exact h5.comp (h4.comp (h3.comp (h2.comp h1)))

variable {A E : Type*} [Fintype A] [DecidableEq A] [MeasurableSpace E]

def join (i : A) (p : E × ({a : A // a ≠ i} → E)) : A → E :=
  fun a => if h : a = i then p.1 else p.2 ⟨a, h⟩

omit [Fintype A] in
theorem join_measurable (i : A) : Measurable (join (E := E) i) := by
  apply measurable_pi_lambda
  intro a
  by_cases h : a = i <;> simp only [join, h, dite_true, dite_false] <;> fun_prop

/-- Reassemble independent single-arm and retained-arm arrays into the full
product law. This applies equally to latent means and finite noise arrays. -/
theorem join_preserving (μ : A → Measure E) [∀ a, IsProbabilityMeasure (μ a)] (i : A) :
    MeasurePreserving (join i) ((μ i).prod (Measure.pi (fun a : {a : A // a ≠ i} => μ a)))
      (Measure.pi μ) := by
  refine ⟨join_measurable i, ?_⟩
  symm
  apply Measure.pi_eq
  intro s hs
  rw [Measure.map_apply (join_measurable i) (MeasurableSet.univ_pi hs)]
  have he : join i ⁻¹' Set.pi Set.univ s =
      s i ×ˢ Set.pi Set.univ (fun a : {a : A // a ≠ i} => s a) := by
    ext p
    simp only [Set.mem_preimage, Set.mem_pi, Set.mem_univ, forall_true_left,
      Set.mem_prod, join]
    constructor
    · intro h
      exact ⟨by simpa using h i, fun a => by simpa [a.property] using h a⟩
    · rintro ⟨hi, ho⟩ a
      split_ifs with ha
      · subst a; exact hi
      · exact ho ⟨a, ha⟩
  rw [he, Measure.prod_prod, Measure.pi_pi]
  letI : Unique {a : A // a = i} :=
    ⟨⟨i, rfl⟩, fun a => Subtype.ext a.property⟩
  have hprod := Fintype.prod_subtype_mul_prod_subtype (fun a : A => a = i)
    (fun a => μ a (s a))
  simpa only [Fintype.prod_unique] using hprod

end
end BayesOptimal.MockMeasure

end

/-! ## MockLaw -/
section

set_option linter.unusedSectionVars false
set_option synthInstance.maxHeartbeats 400000
set_option maxHeartbeats 1000000

open MeasureTheory ProbabilityTheory
open scoped NNReal ENNReal

namespace BayesOptimal.MockLaw

open BayesOptimal.FiniteGaussian BayesOptimal.FinitePosterior BayesOptimal.MockStream
open BayesOptimal.EmbeddingExecution

variable {A : Type*} [Fintype A] [Nonempty A] [DecidableEq A]

noncomputable section

def realNoise (H : ℕ) (i : A) (w : World A H i) : MockStream.RawStream A H :=
  MockMeasure.join i (w.1.1.2, w.2.2)

theorem realData_preserving (H : ℕ) (c : Precisions A) (m : Means A) (i : A) :
    MeasurePreserving (fun p : Block H × OtherData A H i =>
      (m + FinitePosterior.join i (p.1.1, p.2.1), MockMeasure.join i (p.1.2, p.2.2)))
      ((blockLaw H (c i)⁻¹).prod (otherDataLaw H c i)) (worldLaw H c m) := by
  have hc := MockMeasure.cross_preserving (gaussianReal 0 (c i)⁻¹) (noiseLaw H)
    (otherLaw c i) (Measure.pi (fun _ : {a : A // a ≠ i} => noiseLaw H))
  have hj : MeasurePreserving (FinitePosterior.join i)
      ((gaussianReal 0 (c i)⁻¹).prod (otherLaw c i)) (centeredLaw c) :=
    ⟨(join_continuous i).measurable, join_law c i⟩
  have ht : MeasurePreserving (fun x : Means A => m + x) (centeredLaw c)
      (posteriorLaw c m) := ⟨by fun_prop, rfl⟩
  have hn := MockMeasure.join_preserving (fun _ : A => noiseLaw H) i
  exact ((ht.comp hj).prod hn).comp hc

/-- Forgetting the independent copy gives exactly the usual latent Gaussian
posterior times independent observation noise, rather than an assumed law. -/
theorem realWorld_preserving (H : ℕ) (c : Precisions A) (m : Means A) (i : A) :
    MeasurePreserving (fun w : World A H i => (theta H m i w, realNoise H i w))
      (law H c i) (worldLaw H c m) := by
  have hp := (measurePreserving_fst
    (μ := (blockLaw H (c i)⁻¹).prod (otherDataLaw H c i)) (ν := blockLaw H (c i)⁻¹)).comp
    (isolate_copy_preserving H c i)
  exact (realData_preserving H c m i).comp hp

theorem real_observations (H : ℕ) (m : Means A) (i : A) (w : World A H i) :
    observations (theta H m i w, realNoise H i w) = realStream H m i w := by
  funext a t
  by_cases h : a = i <;>
    simp [observations, theta, realNoise, MockMeasure.join, FinitePosterior.join, realStream, h]

theorem tailNoise_preserving (H : ℕ) :
    MeasurePreserving (EmbeddingRaw.tail (A := A) (H := H)) (arrayLaw (A := A) (H + 1))
      (arrayLaw (A := A) H) := by
  exact (measurePreserving_snd
    (μ := Measure.pi (fun _ : A => gaussianReal 0 1)) (ν := arrayLaw (A := A) H)).comp
    (splitNoise_preserving H)

/-- Auxiliary posterior-predictive data are independent of the real latent
parameters and all H actual future observation rounds. -/
theorem seed_and_real_preserving (H : ℕ) (c : Precisions A) (m : Means A) (i : A) :
    MeasurePreserving (fun w : World A (H + 1) i =>
      (w.1.2, (theta (H + 1) m i w, EmbeddingRaw.tail (realNoise (H + 1) i w))))
      (law (H + 1) c i) ((blockLaw (H + 1) (c i)⁻¹).prod (worldLaw H c m)) := by
  letI : IsProbabilityMeasure (blockLaw (H + 1) (c i)⁻¹) := blockLaw_probability _ _
  letI : IsProbabilityMeasure (otherDataLaw (H + 1) c i) := otherDataLaw_probability _ _ _
  have hs : MeasurePreserving (Prod.swap :
      (Block (H + 1) × OtherData A (H + 1) i) × Block (H + 1) →
        Block (H + 1) × (Block (H + 1) × OtherData A (H + 1) i))
      (((blockLaw (H + 1) (c i)⁻¹).prod (otherDataLaw (H + 1) c i)).prod
        (blockLaw (H + 1) (c i)⁻¹))
      ((blockLaw (H + 1) (c i)⁻¹).prod
        ((blockLaw (H + 1) (c i)⁻¹).prod (otherDataLaw (H + 1) c i))) :=
    Measure.measurePreserving_swap
    (μ := (blockLaw (H + 1) (c i)⁻¹).prod (otherDataLaw (H + 1) c i))
    (ν := blockLaw (H + 1) (c i)⁻¹)
  have hp := hs.comp (isolate_copy_preserving (H + 1) c i)
  have ht := (MeasurePreserving.id (posteriorLaw c m)).prod (tailNoise_preserving (A := A) H)
  exact ((MeasurePreserving.id (blockLaw (H + 1) (c i)⁻¹)).prod
    (ht.comp (realData_preserving (H + 1) c m i))).comp hp

end
end BayesOptimal.MockLaw

end

/-! ## EmbeddingRandomized -/
section

set_option linter.unusedSectionVars false

open MeasureTheory ProbabilityTheory
open scoped NNReal ENNReal

namespace BayesOptimal.EmbeddingRandomized

open FiniteGaussian FinitePosterior EmbeddingRaw EmbeddingExecution

variable {A : Type*} [Fintype A] [Nonempty A] [DecidableEq A]
variable [MeasurableSpace A] [MeasurableSingletonClass A]

noncomputable section

theorem rawPayoff_measurable {H : ℕ} (s : Strategy (A := A) H) (hs : Measurable (run s)) :
    Measurable (fun w : Means A × RawStream A H => maxAll w.1 - w.1 (run s (observations w))) := by
  have hcoord : Measurable (fun p : (Means A × RawStream A H) × A => p.1.1 p.2) :=
    measurable_from_prod_countable_left (fun a => by
      change Measurable (fun w : Means A × RawStream A H => w.1 a)
      fun_prop)
  exact ((maxAll_lipschitz (A := A)).continuous.measurable.comp measurable_fst).sub
    (hcoord.comp (measurable_id.prodMk (hs.comp (observations_measurable H))))

theorem regret_norm_le_sum (u : Means A) (a : A) :
    ‖maxAll u - u a‖ ≤ 2 * ∑ b, |u b| := by
  obtain ⟨b, hb⟩ := maxAll_attained u
  have h1 := Finset.single_le_sum (fun b _ => abs_nonneg (u b)) (Finset.mem_univ b)
  have h2 := Finset.single_le_sum (fun b _ => abs_nonneg (u b)) (Finset.mem_univ a)
  rw [Real.norm_eq_abs, ← hb]
  have h := abs_add_le (u b) (-u a)
  rw [abs_neg, ← sub_eq_add_neg] at h
  linarith

variable {S : Type*} [MeasurableSpace S]

def randomizedPayoff {H : ℕ} (s : S → Strategy (A := A) H)
    (p : S × (Means A × RawStream A H)) : ℝ :=
  maxAll p.2.1 - p.2.1 (run (s p.1) (observations p.2))

theorem randomizedPayoff_measurable {H : ℕ} (s : S → Strategy (A := A) H)
    (hs : Measurable (fun p : S × RawStream A H => run (s p.1) p.2)) :
    Measurable (randomizedPayoff s) := by
  have ht : Measurable (fun p : S × (Means A × RawStream A H) =>
      (p.1, observations p.2)) := measurable_fst.prodMk ((observations_measurable H).comp measurable_snd)
  have hcoord : Measurable (fun p : (S × (Means A × RawStream A H)) × A => p.1.2.1 p.2) :=
    measurable_from_prod_countable_left (fun a => by
      change Measurable (fun p : S × (Means A × RawStream A H) => p.2.1 a)
      fun_prop)
  exact ((maxAll_lipschitz (A := A)).continuous.measurable.comp
    (measurable_fst.comp measurable_snd)).sub
      (hcoord.comp (measurable_id.prodMk (hs.comp ht)))

theorem randomizedPayoff_integrable {H : ℕ} (seedLaw : Measure S) [IsProbabilityMeasure seedLaw]
    (s : S → Strategy (A := A) H) (c : Precisions A) (m : Means A)
    (hs : Measurable (fun p : S × RawStream A H => run (s p.1) p.2)) :
    Integrable (randomizedPayoff s) (seedLaw.prod (worldLaw H c m)) := by
  have hi : Integrable (fun p : S × (Means A × RawStream A H) => 2 * ∑ a, |p.2.1 a|)
      (seedLaw.prod (worldLaw H c m)) := by
    apply Integrable.const_mul
    apply integrable_finset_sum
    intro a _
    simpa only [Real.norm_eq_abs] using
      (((posterior_coordinate_integrable c m a).norm.comp_fst (arrayLaw H)).comp_snd seedLaw)
  apply hi.mono' (randomizedPayoff_measurable s hs).aestronglyMeasurable
  exact Filter.Eventually.of_forall (fun p => regret_norm_le_sum p.2.1 _)

theorem randomized_rawRisk_integrable {H : ℕ} (seedLaw : Measure S) [IsProbabilityMeasure seedLaw]
    (s : S → Strategy (A := A) H) (c : Precisions A) (m : Means A)
    (hs : Measurable (fun p : S × RawStream A H => run (s p.1) p.2)) :
    Integrable (fun r => rawRisk (s r) c m) seedLaw :=
  (randomizedPayoff_integrable seedLaw s c m hs).integral_prod_left

/-- Independent external randomization, including an entire imaginary
posterior-predictive stream, is a feasible raw-history strategy and cannot
beat the deterministic Gaussian Bellman optimum. -/
theorem randomized_rawRisk_ge_loss {H : ℕ} (seedLaw : Measure S) [IsProbabilityMeasure seedLaw]
    (s : S → Strategy (A := A) H) (c : Precisions A) (m : Means A)
    (hc : ∀ a, 0 < c a) (hregular : ∀ r, Regular (s r))
    (hs : Measurable (fun p : S × RawStream A H => run (s p.1) p.2)) :
    loss H c m ≤ ∫ r, rawRisk (s r) c m ∂seedLaw := by
  have h := integral_mono (integrable_const (loss H c m))
    (randomized_rawRisk_integrable seedLaw s c m hs)
    (fun r => rawRisk_ge_loss (s r) c m hc (hregular r))
  simpa using h

theorem randomized_rawRisk_ge_actionLoss {H : ℕ} (seedLaw : Measure S)
    [IsProbabilityMeasure seedLaw] (a : A) (next : S → ℝ → Strategy (A := A) H)
    (c : Precisions A) (m : Means A) (hc : ∀ b, 0 < c b)
    (hregular : ∀ r, Regular (.sample a (next r)))
    (hs : Measurable (fun p : S × RawStream A (H + 1) => run (.sample a (next p.1)) p.2)) :
    actionLoss H c m a ≤ ∫ r, rawRisk (.sample a (next r)) c m ∂seedLaw := by
  have h := integral_mono (integrable_const (actionLoss H c m a))
    (randomized_rawRisk_integrable seedLaw (fun r => .sample a (next r)) c m hs)
    (fun r => rawRisk_ge_actionLoss a (next r) c m hc (hregular r))
  simpa using h

end
end BayesOptimal.EmbeddingRandomized

end

/-! ## MockRisk -/
section

set_option linter.unusedSectionVars false

open MeasureTheory ProbabilityTheory
open scoped NNReal ENNReal

namespace BayesOptimal.MockRisk

open BayesOptimal.FiniteGaussian BayesOptimal.FinitePosterior BayesOptimal.FiniteModelExclusion
open BayesOptimal.FiniteModelMeasurable BayesOptimal.EmbeddingRaw BayesOptimal.EmbeddingExecution
open BayesOptimal.EmbeddingRandomized BayesOptimal.MockPolicy BayesOptimal.MockMeasurable BayesOptimal.MockLaw

variable {A : Type*} [Fintype A] [Nonempty A] [DecidableEq A]
variable [MeasurableSpace A] [MeasurableSingletonClass A]

noncomputable section

section Removed
variable (i : A) [Nonempty {a : A // a ≠ i}]

/-- The literal mock loss in the paper: actual latent parameters are kept,
the complete auxiliary copy includes the initial free mock sample, and the
remaining H actual samples are executed by the discard/replay policy. -/
def mockLoss (H : ℕ) (c : Precisions A) (m : Means A) : ℝ :=
  ∫ w : MockStream.World A (H + 1) i,
    maxAll (MockStream.theta (H + 1) m i w) -
      MockStream.theta (H + 1) m i w
        (run (mockPolicy i H c m (auxiliaryOfBlock i H m w.1.2))
          (tail (MockStream.realStream (H + 1) m i w))) ∂MockStream.law (H + 1) c i

theorem substitute_real_mock (H : ℕ) (m : Means A)
    (w : MockStream.World A (H + 1) i) :
    substitute i (MockStream.realStream (H + 1) m i w) (auxiliaryOfBlock i H m w.1.2) =
      MockStream.mockStream (H + 1) m i w := by
  funext a t
  by_cases h : a = i <;>
    simp [substitute, MockStream.mockStream, MockStream.realStream, MockStream.swap,
      auxiliaryOfBlock, h]

theorem mockLoss_eq_modified_mock_risk (H : ℕ) (c : Precisions A) (m : Means A) :
    mockLoss i H c m = BayesOptimal.MockSample.risk (H + 1) c m i
      (MockStream.mockStream (H + 1) m i)
      (run (terminalModified i (forcedPolicy i H c m) c m)) := by
  apply integral_congr_ae
  apply Filter.Eventually.of_forall
  intro w
  have he := mockPolicy_run_eq_full i H c m (auxiliaryOfBlock i H m w.1.2)
    (MockStream.realStream (H + 1) m i w)
  rw [substitute_real_mock] at he
  dsimp only
  rw [he]

theorem mockLoss_eq_modified_real_risk (H : ℕ) (c : Precisions A) (m : Means A) :
    mockLoss i H c m = BayesOptimal.MockSample.risk (H + 1) c m i
      (MockStream.realStream (H + 1) m i)
      (run (terminalModified i (forcedPolicy i H c m) c m)) := by
  rw [mockLoss_eq_modified_mock_risk]
  exact BayesOptimal.MockSample.risk_coupling (H + 1) c m i _
    (forcedPolicy_modified_run_measurable i H c m)
    (terminalModified_excludes i (forcedPolicy i H c m) c m)

theorem real_risk_eq_rawRisk (H : ℕ) (c : Precisions A) (m : Means A)
    (s : Strategy (A := A) H) (hs : Measurable (run s)) :
    BayesOptimal.MockSample.risk H c m i (MockStream.realStream H m i) (run s) = rawRisk s c m := by
  have hm := realWorld_preserving H c m i
  have hi := integral_map (μ := MockStream.law H c i)
    hm.measurable.aemeasurable (rawPayoff_measurable s hs).aestronglyMeasurable
  rw [hm.map_eq] at hi
  symm
  unfold rawRisk BayesOptimal.MockSample.risk
  rw [hi]
  apply integral_congr_ae
  apply Filter.Eventually.of_forall
  intro w
  simp only [real_observations]

theorem mockLoss_le_forced_rawRisk (H : ℕ) (c : Precisions A) (m : Means A) :
    mockLoss i H c m ≤ rawRisk (forcedPolicy i H c m) c m + exclusion i c m := by
  rw [mockLoss_eq_modified_real_risk]
  have hmod := forcedPolicy_modified_run_measurable i H c m
  have horig := forcedPolicy_run_measurable i H c m
  have h := integral_mono
    (BayesOptimal.MockSample.risk_integrable (H + 1) c m i _ _
      (MockStream.realStream_measurable (H + 1) m i) hmod)
    ((BayesOptimal.MockSample.risk_integrable (H + 1) c m i _ _
      (MockStream.realStream_measurable (H + 1) m i) horig).add
      (BayesOptimal.MockSample.exclusion_world_integrable i (H + 1) c m)) (fun w => by
        have hp := terminalModified_regret_bound i (forcedPolicy i H c m) c m
          (MockStream.realStream (H + 1) m i w) (MockStream.theta (H + 1) m i w)
        simp only [Pi.add_apply]
        linarith)
  dsimp only [Pi.add_apply] at h
  rw [integral_add
    (BayesOptimal.MockSample.risk_integrable (H + 1) c m i _ _
      (MockStream.realStream_measurable (H + 1) m i) horig)
    (BayesOptimal.MockSample.exclusion_world_integrable i (H + 1) c m),
    BayesOptimal.MockSample.exclusion_world_integral i (H + 1) c m] at h
  change BayesOptimal.MockSample.risk (H + 1) c m i
    (MockStream.realStream (H + 1) m i) (run (terminalModified i (forcedPolicy i H c m) c m)) ≤
    BayesOptimal.MockSample.risk (H + 1) c m i
      (MockStream.realStream (H + 1) m i) (run (forcedPolicy i H c m)) + exclusion i c m at h
  rw [real_risk_eq_rawRisk i (H + 1) c m _ horig] at h
  exact h

theorem forced_rawRisk_eq_actionLoss (H : ℕ) (c : Precisions A) (m : Means A)
    (hc : ∀ a, 0 < c a) : rawRisk (forcedPolicy i H c m) c m = actionLoss H c m i := by
  have hreg := forcedPolicy_regular i H c m
  change rawRisk (.sample i (continuation i H c m)) c m = _
  rw [rawRisk_succ i (continuation i H c m) c m (hc i) hreg.2]
  apply integral_congr_ae
  apply Filter.Eventually.of_forall
  intro z
  simp only [continuation, recovered_innovation]
  exact optimalFirst_rawRisk H (advance c i) (shift m i z) (advance_positive c i hc)

theorem mockLoss_eq_randomized_rawRisk (H : ℕ) (c : Precisions A) (m : Means A) :
    mockLoss i H c m =
      ∫ b : MockStream.Block (H + 1),
        rawRisk (mockPolicy i H c m (auxiliaryOfBlock i H m b)) c m
          ∂MockStream.blockLaw (H + 1) (c i)⁻¹ := by
  let s : MockStream.Block (H + 1) → Strategy (A := A) H :=
    fun b => mockPolicy i H c m (auxiliaryOfBlock i H m b)
  have hs := mockPolicy_block_run_measurable i H c m
  have hmeas := randomizedPayoff_measurable s hs
  have hint := randomizedPayoff_integrable (MockStream.blockLaw (H + 1) (c i)⁻¹) s c m hs
  have hm := seed_and_real_preserving H c m i
  have hi := integral_map (μ := MockStream.law (H + 1) c i)
    hm.measurable.aemeasurable hmeas.aestronglyMeasurable
  rw [hm.map_eq, integral_prod _ hint] at hi
  change mockLoss i H c m = ∫ b, ∫ w, randomizedPayoff s (b, w) ∂worldLaw H c m
    ∂MockStream.blockLaw (H + 1) (c i)⁻¹
  rw [hi]
  apply integral_congr_ae
  apply Filter.Eventually.of_forall
  intro w
  have ho : observations (MockStream.theta (H + 1) m i w,
      tail (realNoise (H + 1) i w)) = tail (MockStream.realStream (H + 1) m i w) := by
    change tail (observations (MockStream.theta (H + 1) m i w, realNoise (H + 1) i w)) = _
    rw [real_observations]
  simp only [randomizedPayoff, s, ho]

/-- Both displayed inequalities of Definition 5, for arbitrary finite arm
sets and proper positive real precisions. Every policy, raw law, coupling,
measurability, discarded sample, and budget is constructed above. -/
theorem mock_loss_chain (H : ℕ) (c : Precisions A) (m : Means A)
    (hc : ∀ a, 0 < c a) :
    loss H c m ≤ mockLoss i H c m ∧ mockLoss i H c m ≤ actionLoss H c m i + exclusion i c m := by
  constructor
  · rw [mockLoss_eq_randomized_rawRisk]
    exact randomized_rawRisk_ge_loss (MockStream.blockLaw (H + 1) (c i)⁻¹)
      (fun b => mockPolicy i H c m (auxiliaryOfBlock i H m b)) c m hc
      (fun b => mockPolicy_regular i H c m _)
      (mockPolicy_block_run_measurable i H c m)
  · rw [← forced_rawRisk_eq_actionLoss i H c m hc]
    exact mockLoss_le_forced_rawRisk i H c m

/-- Lemma 12 obtained by the paper's actual mock construction and displayed
risk sandwich, independently of the previous reduced-Bellman proof. -/
theorem lemma12_by_mock_samples (H : ℕ) (c : Precisions A) (m : Means A)
    (hc : ∀ a, 0 < c a) : loss H c m - actionLoss H c m i ≤ exclusion i c m := by
  have h := mock_loss_chain i H c m hc
  linarith

end Removed
end
end BayesOptimal.MockRisk

end

/-! ## MockTie -/
section

set_option linter.unusedSectionVars false
set_option maxHeartbeats 1000000

open MeasureTheory ProbabilityTheory
open scoped NNReal ENNReal

namespace BayesOptimal.MockTie

open BayesOptimal.FiniteGaussian BayesOptimal.FinitePosterior BayesOptimal.FiniteModelExclusion
open BayesOptimal.FiniteModelMeasurable BayesOptimal.EmbeddingRaw BayesOptimal.EmbeddingExecution
open BayesOptimal.MockPolicy BayesOptimal.MockMeasurable BayesOptimal.MockRisk

variable {A : Type*} [Fintype A] [Nonempty A] [DecidableEq A] [LinearOrder A]
variable [MeasurableSpace A] [MeasurableSingletonClass A]

noncomputable section

def maximizers (m : Means A) : Finset A := Finset.univ.filter (fun a => m a = maxAll m)

theorem maximizers_nonempty (m : Means A) : (maximizers m).Nonempty := by
  obtain ⟨a, ha⟩ := maxAll_attained m
  exact ⟨a, by simp [maximizers, ha]⟩

def minimumMaximizer (m : Means A) : A := (maximizers m).min' (maximizers_nonempty m)

theorem minimumMaximizer_attains (m : Means A) : m (minimumMaximizer m) = maxAll m := by
  exact (Finset.mem_filter.mp (Finset.min'_mem (maximizers m) (maximizers_nonempty m))).2

theorem minimumMaximizer_le (m : Means A) (a : A) (ha : m a = maxAll m) :
    minimumMaximizer m ≤ a := by
  exact Finset.min'_le (maximizers m) a (by simp [maximizers, ha])

theorem minimumMaximizer_eq_iff (m : Means A) (a : A) :
    minimumMaximizer m = a ↔ m a = maxAll m ∧ ∀ b, b < a → m b < maxAll m := by
  constructor
  · intro h
    constructor
    · rw [← h]; exact minimumMaximizer_attains m
    · intro b hb
      apply lt_of_le_of_ne (coordinate_le_maxAll m b)
      intro hEq
      have hle := minimumMaximizer_le m b hEq
      rw [h] at hle
      exact (not_le_of_gt hb) hle
  · rintro ⟨ha, hb⟩
    apply le_antisymm (minimumMaximizer_le m a ha)
    apply le_of_not_gt
    intro h
    have hh := hb (minimumMaximizer m) h
    rw [minimumMaximizer_attains m] at hh
    exact lt_irrefl _ hh

/-- The literal minimum-index argmax convention is Borel on every finite
linearly ordered arm set, in particular Fin K and its retained subtype. -/
theorem minimumMaximizer_measurable : Measurable (minimumMaximizer (A := A)) := by
  apply measurable_to_countable'
  intro a
  have he : minimumMaximizer ⁻¹' {a} =
      {m : Means A | m a = maxAll m} ∩
        ⋂ b : A, {m : Means A | b < a → m b < maxAll m} := by
    ext m
    simp only [Set.mem_preimage, Set.mem_singleton_iff, Set.mem_inter_iff,
      Set.mem_iInter, Set.mem_setOf_eq]
    exact minimumMaximizer_eq_iff m a
  rw [he]
  apply MeasurableSet.inter
  · exact measurableSet_eq_fun (measurable_pi_apply a) maxAll_lipschitz.continuous.measurable
  · apply MeasurableSet.iInter
    intro b
    by_cases h : b < a
    · simp only [h, true_implies]
      exact measurableSet_lt (measurable_pi_apply b) maxAll_lipschitz.continuous.measurable
    · simp only [h, false_implies]
      exact MeasurableSet.univ

section Removed
variable (i : A) [Nonempty {a : A // a ≠ i}]

def minimumRetained (m : Means A) : A :=
  ((minimumMaximizer (A := {a : A // a ≠ i}) (fun a => m a) : {a : A // a ≠ i}) : A)

theorem minimumRetained_excludes (m : Means A) : minimumRetained i m ≠ i :=
  (minimumMaximizer (A := {a : A // a ≠ i}) (fun a => m a)).property

theorem minimumRetained_attains (m : Means A) :
    m (minimumRetained i m) = otherMaximum i m :=
  minimumMaximizer_attains (A := {a : A // a ≠ i}) (fun a => m a)

theorem minimumRetained_le (m : Means A) (a : A) (ha : a ≠ i)
    (hm : m a = otherMaximum i m) : minimumRetained i m ≤ a :=
  minimumMaximizer_le (A := {a : A // a ≠ i}) (fun a => m a) ⟨a, ha⟩ hm

theorem minimumRetained_measurable : Measurable (minimumRetained i) :=
  measurable_subtype_coe.comp (minimumMaximizer_measurable.comp
    (measurable_pi_lambda _ (fun a => measurable_pi_apply (a : A))))

/-- This equality is of actual conditional posterior regret integrals, not
merely equality of maximized means. The literal minimum selector may change
the arm selected on a tie, while its conditional risk remains identical. -/
theorem minimumRetained_terminalRegret (c : Precisions A) (m : Means A) (a : A)
    (ha : m a = maxAll m) :
    terminalRegret c m (minimumRetained i m) = terminalRegret c m (terminalChoice i m a) := by
  rw [terminalRegret_eq, terminalRegret_eq, minimumRetained_attains i m,
    terminalChoice_posterior_best i m a ha]

def literalPolicy : (H : ℕ) → Precisions A → Means A → Strategy (A := A) H
  | 0, _, m => .stop (minimumRetained i m)
  | H + 1, c, m =>
      let a := chooseFirst H c m
      .sample a (fun z => literalPolicy H (advance c a) (shift m a z))

def legacyPolicy : (H : ℕ) → Precisions A → Means A → Strategy (A := A) H
  | 0, _, m => .stop (terminalChoice i m (firstMax m))
  | H + 1, c, m =>
      let a := chooseFirst H c m
      .sample a (fun z => legacyPolicy H (advance c a) (shift m a z))

theorem policies_utility_eq (H : ℕ) (c : Precisions A) (m : Means A) :
    utility (literalPolicy i H c m) c m = utility (legacyPolicy i H c m) c m := by
  induction H generalizing c m with
  | zero =>
    simp only [literalPolicy, legacyPolicy, utility, minimumRetained_attains,
      terminalChoice_posterior_best i m (firstMax m) (firstMax_attains m)]
  | succ H ih => simp only [literalPolicy, legacyPolicy, utility, ih]

theorem policies_expectedRegret_eq (H : ℕ) (c : Precisions A) (m : Means A) :
    expectedRegret (literalPolicy i H c m) c m = expectedRegret (legacyPolicy i H c m) c m := by
  induction H generalizing c m with
  | zero => exact minimumRetained_terminalRegret i c m (firstMax m) (firstMax_attains m)
  | succ H ih => simp only [literalPolicy, legacyPolicy, expectedRegret, ih]

theorem raw_legacy_eq_terminalModified (H : ℕ) (c : Precisions A) (m : Means A) :
    rawOfInnovation (legacyPolicy i H c m) c m =
      terminalModified i (rawOfInnovation (optimalFirst H c m) c m) c m := by
  induction H generalizing c m with
  | zero => rfl
  | succ H ih =>
    simp only [legacyPolicy, optimalFirst, rawOfInnovation, terminalModified]
    congr 1
    funext y
    exact ih _ _

theorem literal_raw_run_measurable (H : ℕ) (c : Precisions A) :
    Measurable (fun p : Means A × RawStream A H =>
      run (rawOfInnovation (literalPolicy i H c p.1) c p.1) p.2) := by
  induction H generalizing c with
  | zero => exact (minimumRetained_measurable i).comp measurable_fst
  | succ H ih =>
    let g : (Means A × RawStream A (H + 1)) × A → A := fun p =>
      run (rawOfInnovation (literalPolicy i H (advance c p.2)
        (shift p.1.1 p.2 ((p.1.2 p.2 ⟨0, Nat.zero_lt_succ H⟩ - p.1.1 p.2) /
          ((c p.2 : ℝ) + 1)))) (advance c p.2)
        (shift p.1.1 p.2 ((p.1.2 p.2 ⟨0, Nat.zero_lt_succ H⟩ - p.1.1 p.2) /
          ((c p.2 : ℝ) + 1)))) (tail p.1.2)
    have hg : Measurable g := by
      apply measurable_from_prod_countable_left
      intro a
      have ht : Measurable (fun p : Means A × RawStream A (H + 1) =>
          (shift p.1 a ((p.2 a ⟨0, Nat.zero_lt_succ H⟩ - p.1 a) / ((c a : ℝ) + 1)),
            tail p.2)) := by
        apply Measurable.prodMk
        · apply measurable_pi_lambda
          intro b
          simp only [shift]
          split_ifs <;> fun_prop
        · unfold tail; fun_prop
      exact (ih (advance c a)).comp ht
    exact hg.comp (measurable_id.prodMk ((chooseFirst_measurable H c).comp measurable_fst))

theorem literal_raw_regular (H : ℕ) (c : Precisions A) (m : Means A) :
    Regular (rawOfInnovation (literalPolicy i H c m) c m) := by
  induction H generalizing c m with
  | zero => trivial
  | succ H ih =>
    constructor
    · intro y; exact ih _ _
    · have ht : Measurable (fun p : ℝ × RawStream A H =>
          (shift m (chooseFirst H c m)
            ((p.1 - m (chooseFirst H c m)) / ((c (chooseFirst H c m) : ℝ) + 1)), p.2)) := by
        apply Measurable.prodMk
        · apply measurable_pi_lambda
          intro a
          simp only [shift]
          split_ifs <;> fun_prop
        · exact measurable_snd
      exact (literal_raw_run_measurable i H (advance c (chooseFirst H c m))).comp ht

theorem legacy_raw_regular (H : ℕ) (c : Precisions A) (m : Means A) :
    Regular (rawOfInnovation (legacyPolicy i H c m) c m) := by
  induction H generalizing c m with
  | zero => trivial
  | succ H ih =>
    constructor
    · intro y; exact ih _ _
    · have ht : Measurable (fun p : ℝ × RawStream A H =>
          (shift m (chooseFirst H c m)
            ((p.1 - m (chooseFirst H c m)) / ((c (chooseFirst H c m) : ℝ) + 1)), p.2)) := by
        apply Measurable.prodMk
        · apply measurable_pi_lambda
          intro a
          simp only [shift]
          split_ifs <;> fun_prop
        · exact measurable_snd
      have hmeas := modifiedOptimal_run_measurable i H (advance c (chooseFirst H c m))
      simp_rw [← raw_legacy_eq_terminalModified i] at hmeas
      exact hmeas.comp ht

/-- Terminal reties preserve actual full latent-Gaussian execution risks at
every finite horizon; sampling choices and their raw observation paths agree. -/
theorem literal_rawRisk_eq_legacy (H : ℕ) (c : Precisions A) (m : Means A)
    (hc : ∀ a, 0 < c a) :
    rawRisk (rawOfInnovation (literalPolicy i H c m) c m) c m =
      rawRisk (rawOfInnovation (legacyPolicy i H c m) c m) c m := by
  rw [rawOfInnovation_risk _ _ _ hc (literal_raw_regular i H c m),
    rawOfInnovation_risk _ _ _ hc (legacy_raw_regular i H c m), policies_expectedRegret_eq]

theorem literal_raw_run_excludes (H : ℕ) (c : Precisions A) (m : Means A)
    (real : RawStream A H) : run (rawOfInnovation (literalPolicy i H c m) c m) real ≠ i := by
  induction H generalizing c m with
  | zero => exact minimumRetained_excludes i m
  | succ H ih => exact ih _ _ _

theorem terminalModified_literal_raw (H : ℕ) (c : Precisions A) (m : Means A) :
    terminalModified i (rawOfInnovation (literalPolicy i H c m) c m) c m =
      rawOfInnovation (literalPolicy i H c m) c m := by
  induction H generalizing c m with
  | zero => simp [literalPolicy, rawOfInnovation, terminalModified, terminalChoice,
      minimumRetained_excludes i m]
  | succ H ih =>
    simp only [literalPolicy, rawOfInnovation, terminalModified]
    congr 1
    funext y
    exact ih _ _

def literalForced (H : ℕ) (c : Precisions A) (m : Means A) : Strategy (A := A) (H + 1) :=
  .sample i (fun y =>
    let z := (y - m i) / ((c i : ℝ) + 1)
    rawOfInnovation (literalPolicy i H (advance c i) (shift m i z))
      (advance c i) (shift m i z))

def legacyForced (H : ℕ) (c : Precisions A) (m : Means A) : Strategy (A := A) (H + 1) :=
  .sample i (fun y =>
    let z := (y - m i) / ((c i : ℝ) + 1)
    rawOfInnovation (legacyPolicy i H (advance c i) (shift m i z))
      (advance c i) (shift m i z))

theorem legacyForced_eq_modified_forced (H : ℕ) (c : Precisions A) (m : Means A) :
    legacyForced i H c m = terminalModified i (forcedPolicy i H c m) c m := by
  unfold legacyForced forcedPolicy
  simp only [terminalModified, continuation]
  congr 1
  funext y
  exact raw_legacy_eq_terminalModified i H _ _

theorem literalForced_run_measurable (H : ℕ) (c : Precisions A) (m : Means A) :
    Measurable (run (literalForced i H c m)) := by
  have ht : Measurable (fun p : RawStream A (H + 1) =>
      (shift m i ((p i ⟨0, Nat.zero_lt_succ H⟩ - m i) / ((c i : ℝ) + 1)), tail p)) := by
    apply Measurable.prodMk
    · apply measurable_pi_lambda
      intro a
      simp only [shift]
      split_ifs <;> fun_prop
    · unfold tail; fun_prop
  exact (literal_raw_run_measurable i H (advance c i)).comp ht

theorem literalForced_run_excludes (H : ℕ) (c : Precisions A) (m : Means A)
    (real : RawStream A (H + 1)) : run (literalForced i H c m) real ≠ i :=
  literal_raw_run_excludes i H _ _ _

theorem literalForced_rawRisk_eq_legacy (H : ℕ) (c : Precisions A) (m : Means A)
    (hc : ∀ a, 0 < c a) : rawRisk (literalForced i H c m) c m = rawRisk (legacyForced i H c m) c m := by
  have ht : Measurable (fun p : ℝ × RawStream A H =>
      (shift m i ((p.1 - m i) / ((c i : ℝ) + 1)), p.2)) := by
    apply Measurable.prodMk
    · apply measurable_pi_lambda
      intro a
      simp only [shift]
      split_ifs <;> fun_prop
    · exact measurable_snd
  have hLit := (literal_raw_run_measurable i H (advance c i)).comp ht
  have hLegacy := modifiedOptimal_run_measurable i H (advance c i)
  simp_rw [← raw_legacy_eq_terminalModified i] at hLegacy
  have hLeg := hLegacy.comp ht
  unfold literalForced legacyForced
  rw [rawRisk_succ _ _ _ _ (hc i) hLit, rawRisk_succ _ _ _ _ (hc i) hLeg]
  apply integral_congr_ae
  apply Filter.Eventually.of_forall
  intro z
  simp only [recovered_innovation]
  exact literal_rawRisk_eq_legacy i H (advance c i) (shift m i z) (advance_positive c i hc)

/-- The exact numerical-minimum terminal convention is used unconditionally,
including ties where the old policy already recommended another retained arm. -/
def literalMockPolicy (H : ℕ) (c : Precisions A) (m : Means A)
    (auxiliary : Fin (H + 1) → ℝ) : Strategy (A := A) H :=
  let z := (auxiliary ⟨0, Nat.zero_lt_succ H⟩ - m i) / ((c i : ℝ) + 1)
  replay i (rawOfInnovation (literalPolicy i H (advance c i) (shift m i z))
    (advance c i) (shift m i z)) (advance c i) (shift m i z) (fun t => auxiliary t.succ)

theorem literalMockPolicy_budget (H : ℕ) (c : Precisions A) (m : Means A)
    (auxiliary : Fin (H + 1) → ℝ) (real : RawStream A H) :
    (trace (literalMockPolicy i H c m auxiliary) real).length = H := trace_budget _ _

theorem literalMockPolicy_run_eq_full (H : ℕ) (c : Precisions A) (m : Means A)
    (auxiliary : Fin (H + 1) → ℝ) (real : RawStream A (H + 1)) :
    run (literalMockPolicy i H c m auxiliary) (tail real) =
      run (literalForced i H c m) (substitute i real auxiliary) := by
  simp only [literalMockPolicy, literalForced, run, substitute, if_true]
  rw [replay_run_eq, terminalModified_literal_raw]
  rfl

theorem literalMockPolicy_leaf (c : Precisions A) (m : Means A) :
    replay i (rawOfInnovation (literalPolicy i 0 c m) c m) c m Fin.elim0 =
      .stop (minimumRetained i m) := by
  simp [literalPolicy, rawOfInnovation, replay, terminalChoice, minimumRetained_excludes i m]

theorem literalMockPolicy_run_measurable (H : ℕ) (c : Precisions A) (m : Means A) :
    Measurable (fun p : (Fin (H + 1) → ℝ) × RawStream A H =>
      run (literalMockPolicy i H c m p.1) p.2) := by
  have ht : Measurable (fun p : (Fin (H + 1) → ℝ) × RawStream A H =>
      substitute i (pad p.2) p.1) := by
    apply measurable_pi_lambda
    intro a
    apply measurable_pi_lambda
    intro t
    by_cases ha : a = i
    · simp only [substitute, ha, if_true]
      fun_prop
    · simp only [substitute, if_neg ha, pad]
      refine Fin.cases ?_ (fun r => ?_) t
      · exact measurable_const
      · simp only [Fin.cases_succ]
        fun_prop
  convert (literalForced_run_measurable i H c m).comp ht using 1
  funext p
  have h := literalMockPolicy_run_eq_full i H c m p.1 (pad p.2)
  simpa only [tail_pad] using h

def terminalMeans : (H : ℕ) → Precisions A → Means A → RawStream A H → Means A
  | 0, _, m, _ => m
  | H + 1, c, m, real =>
      let a := chooseFirst H c m
      let z := (real a ⟨0, Nat.zero_lt_succ H⟩ - m a) / ((c a : ℝ) + 1)
      terminalMeans H (advance c a) (shift m a z) (tail real)

/-- Exact raw execution bookkeeping, including the posterior at the terminal
node. This identifies the selected index, not just its maximized mean. -/
theorem literal_raw_run_minimum (H : ℕ) (c : Precisions A) (m : Means A)
    (real : RawStream A H) :
    run (rawOfInnovation (literalPolicy i H c m) c m) real =
      minimumRetained i (terminalMeans H c m real) := by
  induction H generalizing c m with
  | zero => rfl
  | succ H ih => exact ih _ _ _

def mockTerminalMeans (H : ℕ) (c : Precisions A) (m : Means A)
    (auxiliary : Fin (H + 1) → ℝ) (real : RawStream A H) : Means A :=
  let z := (auxiliary ⟨0, Nat.zero_lt_succ H⟩ - m i) / ((c i : ℝ) + 1)
  terminalMeans H (advance c i) (shift m i z)
    (substitute i real (fun t => auxiliary t.succ))

theorem literalMockPolicy_recommends_minimum (H : ℕ) (c : Precisions A) (m : Means A)
    (auxiliary : Fin (H + 1) → ℝ) (real : RawStream A H) :
    run (literalMockPolicy i H c m auxiliary) real =
      minimumRetained i (mockTerminalMeans i H c m auxiliary real) := by
  unfold literalMockPolicy mockTerminalMeans
  rw [replay_run_eq, terminalModified_literal_raw, literal_raw_run_minimum]

/-- The returned arm is exactly the minimum index among all retained
posterior maximizers at the mock algorithm's actual terminal internal state. -/
theorem literalMockPolicy_terminal_spec (H : ℕ) (c : Precisions A) (m : Means A)
    (auxiliary : Fin (H + 1) → ℝ) (real : RawStream A H) :
    let u := mockTerminalMeans i H c m auxiliary real
    let a := run (literalMockPolicy i H c m auxiliary) real
    a ≠ i ∧ u a = otherMaximum i u ∧
      ∀ b, b ≠ i → u b = otherMaximum i u → a ≤ b := by
  dsimp only
  rw [literalMockPolicy_recommends_minimum]
  exact ⟨minimumRetained_excludes i _, minimumRetained_attains i _,
    fun b hb hm => minimumRetained_le i _ b hb hm⟩

theorem replay_literal_run_measurable (H : ℕ) (c : Precisions A) (imaginary : Fin H → ℝ) :
    Measurable (fun p : Means A × RawStream A H =>
      run (replay i (rawOfInnovation (literalPolicy i H c p.1) c p.1) c p.1 imaginary) p.2) := by
  have ht : Measurable (fun p : Means A × RawStream A H =>
      (p.1, substitute i p.2 imaginary)) := by
    apply measurable_fst.prodMk
    apply measurable_pi_lambda
    intro a
    apply measurable_pi_lambda
    intro t
    simp only [substitute]
    split_ifs <;> fun_prop
  convert (literal_raw_run_measurable i H c).comp ht using 1
  funext p
  rw [replay_run_eq, terminalModified_literal_raw]
  rfl

theorem replay_literal_regular (H : ℕ) (c : Precisions A) (m : Means A)
    (imaginary : Fin H → ℝ) :
    Regular (replay i (rawOfInnovation (literalPolicy i H c m) c m) c m imaginary) := by
  induction H generalizing c m with
  | zero => trivial
  | succ H ih =>
    let a := chooseFirst H c m
    by_cases ha : a = i
    · simp only [literalPolicy, rawOfInnovation, replay]
      rw [if_pos ha]
      constructor
      · intro _; exact ih _ _ _
      · exact (replay_literal_run_measurable i H (advance c a) (fun t => imaginary t.succ)).comp
          (measurable_const.prodMk measurable_snd)
    · simp only [literalPolicy, rawOfInnovation, replay]
      rw [if_neg ha]
      constructor
      · intro _; exact ih _ _ _
      · have ht : Measurable (fun p : ℝ × RawStream A H =>
            (shift m a ((p.1 - m a) / ((c a : ℝ) + 1)), p.2)) := by
          apply Measurable.prodMk
          · apply measurable_pi_lambda
            intro b
            simp only [shift]
            split_ifs <;> fun_prop
          · exact measurable_snd
        exact (replay_literal_run_measurable i H (advance c a)
          (fun t => imaginary t.succ)).comp ht

theorem literalMockPolicy_regular (H : ℕ) (c : Precisions A) (m : Means A)
    (auxiliary : Fin (H + 1) → ℝ) : Regular (literalMockPolicy i H c m auxiliary) :=
  replay_literal_regular i H _ _ _

def literalMockLoss (H : ℕ) (c : Precisions A) (m : Means A) : ℝ :=
  ∫ w : MockStream.World A (H + 1) i,
    maxAll (MockStream.theta (H + 1) m i w) -
      MockStream.theta (H + 1) m i w
        (run (literalMockPolicy i H c m (auxiliaryOfBlock i H m w.1.2))
          (tail (MockStream.realStream (H + 1) m i w))) ∂MockStream.law (H + 1) c i

theorem literalMockLoss_eq_mock_risk (H : ℕ) (c : Precisions A) (m : Means A) :
    literalMockLoss i H c m = BayesOptimal.MockSample.risk (H + 1) c m i
      (MockStream.mockStream (H + 1) m i) (run (literalForced i H c m)) := by
  apply integral_congr_ae
  apply Filter.Eventually.of_forall
  intro w
  have he := literalMockPolicy_run_eq_full i H c m (auxiliaryOfBlock i H m w.1.2)
    (MockStream.realStream (H + 1) m i w)
  rw [substitute_real_mock] at he
  dsimp only
  rw [he]

/-- The literal minimum-index mock algorithm has exactly the same actual
latent-world risk as the prior certificate, even when tied arm indices differ. -/
theorem literalMockLoss_eq_original (H : ℕ) (c : Precisions A) (m : Means A)
    (hc : ∀ a, 0 < c a) : literalMockLoss i H c m = mockLoss i H c m := by
  rw [literalMockLoss_eq_mock_risk,
    BayesOptimal.MockSample.risk_coupling (H + 1) c m i _
      (literalForced_run_measurable i H c m) (literalForced_run_excludes i H c m),
    real_risk_eq_rawRisk i (H + 1) c m _ (literalForced_run_measurable i H c m),
    literalForced_rawRisk_eq_legacy i H c m hc, legacyForced_eq_modified_forced,
    mockLoss_eq_modified_real_risk,
    real_risk_eq_rawRisk i (H + 1) c m _ (forcedPolicy_modified_run_measurable i H c m)]

/-- Definition 5's displayed sandwich now holds for the literal minimum
retained argmax terminal rule, with all other sampling actions unchanged. -/
theorem literal_mock_loss_chain (H : ℕ) (c : Precisions A) (m : Means A)
    (hc : ∀ a, 0 < c a) :
    loss H c m ≤ literalMockLoss i H c m ∧
      literalMockLoss i H c m ≤ actionLoss H c m i + exclusion i c m := by
  rw [literalMockLoss_eq_original i H c m hc]
  exact mock_loss_chain i H c m hc

end Removed
end
end BayesOptimal.MockTie

end

/-! ## JointGaussianMeasurable -/
section

open MeasureTheory ProbabilityTheory
open scoped NNReal ENNReal

namespace BayesOptimal.JointGaussianMeasurable

noncomputable section

set_option linter.unusedSectionVars false

variable {A : Type*} [Fintype A] [Nonempty A] [DecidableEq A]

open BayesOptimal.FiniteGaussian BayesOptimal.FinitePosterior

/-- A parameter-dependent centered Gaussian is a measurable scaling of one
fixed standard Gaussian, including the zero-variance case. -/
theorem standard_scaled_law (v : ℝ≥0) :
    (gaussianReal 0 1).map (fun x : ℝ => Real.sqrt (v : ℝ) * x) =
      gaussianReal 0 v := by
  have hv : (⟨(Real.sqrt (v : ℝ)) ^ 2, sq_nonneg _⟩ : ℝ≥0) * 1 = v := by
    ext
    simp only [mul_one]
    exact Real.sq_sqrt v.property
  rw [gaussianReal_map_const_mul, mul_zero, hv]

theorem gaussian_integral_measurable {X : Type*} [MeasurableSpace X]
    (v : X → ℝ≥0) (hv : Measurable v) (f : X × ℝ → ℝ) (hf : Measurable f) :
    Measurable (fun x => ∫ z, f (x, z) ∂gaussianReal 0 (v x)) := by
  have hg : Measurable (fun p : X × ℝ =>
      f (p.1, Real.sqrt (v p.1 : ℝ) * p.2)) := by
    apply hf.comp
    exact measurable_fst.prodMk (((hv.comp measurable_fst).coe_nnreal_real.sqrt).mul
      measurable_snd)
  have h := hg.stronglyMeasurable.integral_prod_right' (ν := gaussianReal 0 1)
  convert h.measurable using 1
  funext x
  rw [← standard_scaled_law (v x), integral_map (by fun_prop)]
  exact (hf.comp (measurable_const.prodMk measurable_id)).aestronglyMeasurable

theorem advance_measurable (i : A) : Measurable (fun c : Precisions A => advance c i) := by
  apply measurable_pi_lambda
  intro a
  exact (measurable_pi_apply a).add measurable_const

theorem innovation_measurable (i : A) : Measurable (fun c : Precisions A => innovation c i) := by
  unfold innovation BayesOptimal.Foundations.Gaussian.updateVariance
  fun_prop

theorem shift_joint_measurable (i : A) :
    Measurable (fun p : Means A × ℝ => shift p.1 i p.2) := by
  apply measurable_pi_lambda
  intro a
  by_cases h : a = i <;> simp only [shift, h, ite_true, ite_false]
  · fun_prop
  · fun_prop

theorem transition_joint_measurable (i : A) :
    Measurable (fun p : (Precisions A × Means A) × ℝ =>
      (advance p.1.1 i, shift p.1.2 i p.2)) :=
  ((advance_measurable i).comp (measurable_fst.comp measurable_fst)).prodMk
    ((shift_joint_measurable i).comp
      ((measurable_snd.comp measurable_fst).prodMk measurable_snd))

/-- The Bellman values are jointly Borel in all real Gaussian precisions and
all posterior means; the precision vector is not fixed. -/
theorem value_joint_measurable (k : ℕ) :
    Measurable (fun p : Precisions A × Means A => value k p.1 p.2) := by
  induction k with
  | zero => exact maxAll_lipschitz.continuous.measurable.comp measurable_snd
  | succ k ih =>
    apply maxAll_lipschitz.continuous.measurable.comp
    apply measurable_pi_lambda
    intro i
    apply gaussian_integral_measurable
      (fun p : Precisions A × Means A => innovation p.1 i)
      ((innovation_measurable i).comp measurable_fst)
      (fun p => value k (advance p.1.1 i) (shift p.1.2 i p.2))
    exact ih.comp (transition_joint_measurable i)

theorem action_joint_measurable (k : ℕ) (i : A) :
    Measurable (fun p : Precisions A × Means A => action k p.1 p.2 i) := by
  apply gaussian_integral_measurable
    (fun p : Precisions A × Means A => innovation p.1 i)
    ((innovation_measurable i).comp measurable_fst)
    (fun p => value k (advance p.1.1 i) (shift p.1.2 i p.2))
  exact (value_joint_measurable k).comp (transition_joint_measurable i)

def standardArrayLaw : Measure (Means A) := Measure.pi (fun _ => gaussianReal 0 1)

instance standardArrayLaw_probability : IsProbabilityMeasure (standardArrayLaw (A := A)) := by
  unfold standardArrayLaw
  infer_instance

theorem posterior_standard_law (c : Precisions A) (m : Means A) :
    (standardArrayLaw (A := A)).map
        (fun x a => m a + Real.sqrt ((c a)⁻¹ : ℝ≥0) * x a) = posteriorLaw c m := by
  have h : MeasurePreserving (fun x a => Real.sqrt ((c a)⁻¹ : ℝ≥0) * x a)
      (standardArrayLaw (A := A)) (centeredLaw c) := by
    apply measurePreserving_pi
    intro a
    exact ⟨by fun_prop, standard_scaled_law (c a)⁻¹⟩
  unfold posteriorLaw
  rw [← h.map_eq, Measure.map_map (by fun_prop) h.measurable]
  rfl

theorem potential_joint_measurable :
    Measurable (fun p : Precisions A × Means A => potential p.1 p.2) := by
  have hf : Measurable (fun p : (Precisions A × Means A) × Means A =>
      maxAll (fun a => p.1.2 a + Real.sqrt ((p.1.1 a)⁻¹ : ℝ≥0) * p.2 a)) := by
    apply maxAll_lipschitz.continuous.measurable.comp
    apply measurable_pi_lambda
    intro a
    fun_prop
  have hm := hf.stronglyMeasurable.integral_prod_right'
    (ν := standardArrayLaw (A := A))
  convert hm.measurable using 1
  funext p
  change expectation maxAll p.1 p.2 = _
  unfold expectation
  rw [← posterior_integral maxAll_lipschitz p.1 p.2]
  rw [← posterior_standard_law p.1 p.2, integral_map (by
    apply Measurable.aemeasurable
    apply measurable_pi_lambda
    intro a
    fun_prop)
    maxAll_lipschitz.continuous.measurable.aestronglyMeasurable]

theorem loss_joint_measurable (k : ℕ) :
    Measurable (fun p : Precisions A × Means A => loss k p.1 p.2) :=
  potential_joint_measurable.sub (value_joint_measurable k)

theorem actionLoss_joint_measurable (k : ℕ) (i : A) :
    Measurable (fun p : Precisions A × Means A => actionLoss k p.1 p.2 i) := by
  apply gaussian_integral_measurable
    (fun p : Precisions A × Means A => innovation p.1 i)
    ((innovation_measurable i).comp measurable_fst)
    (fun p => loss k (advance p.1.1 i) (shift p.1.2 i p.2))
  exact (loss_joint_measurable k).comp (transition_joint_measurable i)

section Ordered
variable [LinearOrder A] [MeasurableSpace A] [MeasurableSingletonClass A]

def minimumOptimal (k : ℕ) (c : Precisions A) (m : Means A) : A :=
  BayesOptimal.MockTie.minimumMaximizer (action k c m)

theorem minimumOptimal_joint_measurable (k : ℕ) :
    Measurable (fun p : Precisions A × Means A => minimumOptimal k p.1 p.2) := by
  apply BayesOptimal.MockTie.minimumMaximizer_measurable.comp
  exact measurable_pi_lambda _ (action_joint_measurable k)

theorem minimumOptimal_attains (k : ℕ) (c : Precisions A) (m : Means A) :
    action k c m (minimumOptimal k c m) = value (k + 1) c m :=
  BayesOptimal.MockTie.minimumMaximizer_attains _

theorem minimumOptimal_le (k : ℕ) (c : Precisions A) (m : Means A) (i : A)
    (hi : action k c m i = value (k + 1) c m) : minimumOptimal k c m ≤ i :=
  BayesOptimal.MockTie.minimumMaximizer_le _ _ hi

theorem minimumOptimal_actionLoss (k : ℕ) (c : Precisions A) (m : Means A)
    (hc : ∀ a, 0 < c a) :
    actionLoss k c m (minimumOptimal k c m) = loss (k + 1) c m := by
  rw [actionLoss_eq _ _ _ _ (hc _), minimumOptimal_attains]
  rfl

theorem minimumOptimal_minimizes (k : ℕ) (c : Precisions A) (m : Means A)
    (hc : ∀ a, 0 < c a) (i : A) :
    actionLoss k c m (minimumOptimal k c m) ≤ actionLoss k c m i := by
  rw [minimumOptimal_actionLoss _ _ _ hc, actionLoss_eq _ _ _ _ (hc i)]
  exact sub_le_sub_left (action_le_value k c m i) _

theorem minimumOptimal_le_minimizer (k : ℕ) (c : Precisions A) (m : Means A)
    (hc : ∀ a, 0 < c a) (i : A)
    (hi : actionLoss k c m i = loss (k + 1) c m) : minimumOptimal k c m ≤ i := by
  apply minimumOptimal_le
  rw [actionLoss_eq _ _ _ _ (hc i)] at hi
  unfold loss at hi
  linarith

end Ordered
end
end BayesOptimal.JointGaussianMeasurable

end

/-! ## FlatPriorInitialization -/
section

open MeasureTheory ProbabilityTheory
open scoped NNReal ENNReal

namespace BayesOptimal.FlatPriorInitialization

noncomputable section

def empiricalMean {n : ℕ} (y : Fin n → ℝ) : ℝ := (∑ j, y j) / n

def residual {n : ℕ} (y : Fin n → ℝ) : ℝ := ∑ j, (y j - empiricalMean y)^2

/-- The likelihood with its parameter-independent unit-Gaussian normalizing
constant omitted. The prior density with respect to Lebesgue measure is one. -/
def flatLikelihood {n : ℕ} (y : Fin n → ℝ) (θ : ℝ) : ℝ :=
  Real.exp (-(∑ j, (y j - θ)^2) / 2)

def flatNormalizer {n : ℕ} (y : Fin n → ℝ) : ℝ :=
  Real.exp (-residual y / 2) * Real.sqrt (2 * Real.pi * ((n : ℝ)⁻¹))

theorem empiricalMean_sum {n : ℕ} (y : Fin n → ℝ) (hn : 0 < n) :
    (n : ℝ) * empiricalMean y = ∑ j, y j := by
  have hn0 : (n : ℝ) ≠ 0 := by exact_mod_cast (ne_of_gt hn)
  unfold empiricalMean
  field_simp

theorem sum_squares_decomposition {n : ℕ} (y : Fin n → ℝ) (hn : 0 < n) (θ : ℝ) :
    (∑ j, (y j - θ)^2) = residual y + n * (θ - empiricalMean y)^2 := by
  have hm := empiricalMean_sum y hn
  unfold residual
  simp only [sub_sq, Finset.sum_add_distrib, Finset.sum_sub_distrib,
    Finset.sum_const, Finset.card_univ,
    Fintype.card_fin, nsmul_eq_mul]
  simp only [← Finset.sum_mul, ← Finset.mul_sum]
  rw [← hm]
  ring

theorem flatNormalizer_pos {n : ℕ} (y : Fin n → ℝ) (hn : 0 < n) :
    0 < flatNormalizer y := by
  unfold flatNormalizer
  have hnR : (0 : ℝ) < n := by exact_mod_cast hn
  positivity

/-- Completing the square identifies the whole normalized flat-prior
likelihood, not just its first two moments. -/
theorem flatLikelihood_factorization {n : ℕ} (y : Fin n → ℝ) (hn : 0 < n) (θ : ℝ) :
    flatLikelihood y θ = flatNormalizer y *
      gaussianPDFReal (empiricalMean y) (n : ℝ≥0)⁻¹ θ := by
  have hnR : (0 : ℝ) < n := by exact_mod_cast hn
  have hs : Real.sqrt (2 * Real.pi * (n : ℝ)⁻¹) ≠ 0 := by positivity
  unfold flatLikelihood flatNormalizer gaussianPDFReal
  rw [sum_squares_decomposition y hn θ]
  simp only [NNReal.coe_inv, NNReal.coe_natCast]
  have he : -(residual y + (n : ℝ) * (θ - empiricalMean y)^2) / 2 =
      -residual y / 2 + -(θ - empiricalMean y)^2 / (2 * (n : ℝ)⁻¹) := by
    field_simp
    ring
  rw [he, Real.exp_add]
  field_simp

theorem flatLikelihood_integrable {n : ℕ} (y : Fin n → ℝ) (hn : 0 < n) :
    Integrable (flatLikelihood y) volume := by
  have he : flatLikelihood y = fun θ => flatNormalizer y *
      gaussianPDFReal (empiricalMean y) (n : ℝ≥0)⁻¹ θ :=
    funext (flatLikelihood_factorization y hn)
  rw [he]
  exact (integrable_gaussianPDFReal _ _).const_mul _

theorem flatLikelihood_integral {n : ℕ} (y : Fin n → ℝ) (hn : 0 < n) :
    (∫ θ, flatLikelihood y θ) = flatNormalizer y := by
  simp_rw [flatLikelihood_factorization y hn]
  rw [integral_const_mul, integral_gaussianPDFReal_eq_one]
  · ring
  · exact inv_ne_zero (by exact_mod_cast (ne_of_gt hn))

/-- Every nonempty observed sample gives exactly the proper Gaussian
posterior N(sample mean, reciprocal sample count). -/
theorem normalized_flatLikelihood {n : ℕ} (y : Fin n → ℝ) (hn : 0 < n) (θ : ℝ) :
    flatLikelihood y θ / (∫ x, flatLikelihood y x) =
      gaussianPDFReal (empiricalMean y) (n : ℝ≥0)⁻¹ θ := by
  rw [flatLikelihood_integral y hn, flatLikelihood_factorization y hn]
  field_simp [ne_of_gt (flatNormalizer_pos y hn)]

theorem normalized_flat_measure {n : ℕ} (y : Fin n → ℝ) (hn : 0 < n) :
    volume.withDensity (fun θ => ENNReal.ofReal
      (flatLikelihood y θ / (∫ x, flatLikelihood y x))) =
        gaussianReal (empiricalMean y) (n : ℝ≥0)⁻¹ := by
  simp_rw [normalized_flatLikelihood y hn]
  exact (gaussianReal_of_var_ne_zero _ (inv_ne_zero (by
    exact_mod_cast (ne_of_gt hn)))).symm

/-- Restoring all unit-Gaussian observation constants changes the likelihood
by a strictly positive scalar independent of the unknown mean. -/
theorem unitGaussian_likelihood {n : ℕ} (y : Fin n → ℝ) (θ : ℝ) :
    (∏ j, gaussianPDFReal θ 1 (y j)) =
      (Real.sqrt (2 * Real.pi))⁻¹ ^ n * flatLikelihood y θ := by
  simp only [gaussianPDFReal, NNReal.coe_one, mul_one]
  rw [Finset.prod_mul_distrib, Finset.prod_const, Finset.card_univ, Fintype.card_fin,
    ← Real.exp_sum]
  congr 2
  rw [← Finset.sum_div, ← Finset.sum_neg_distrib]

end
end BayesOptimal.FlatPriorInitialization

end

/-! ## FlatPriorProduct -/
section

open MeasureTheory ProbabilityTheory
open scoped NNReal ENNReal

namespace BayesOptimal.FlatPriorProduct

noncomputable section
set_option linter.unusedSectionVars false

open BayesOptimal.FlatPriorInitialization BayesOptimal.FiniteGaussian BayesOptimal.FinitePosterior

def observationLikelihood {n : ℕ} (y : Fin n → ℝ) (θ : ℝ) : ℝ :=
  ∏ j, gaussianPDFReal θ 1 (y j)

theorem observationLikelihood_integral {n : ℕ} (y : Fin n → ℝ) (hn : 0 < n) :
    (∫ θ, observationLikelihood y θ) =
      (Real.sqrt (2 * Real.pi))⁻¹ ^ n * flatNormalizer y := by
  unfold observationLikelihood
  simp_rw [unitGaussian_likelihood]
  rw [integral_const_mul, flatLikelihood_integral y hn]

theorem normalized_observationLikelihood {n : ℕ} (y : Fin n → ℝ) (hn : 0 < n) (θ : ℝ) :
    observationLikelihood y θ / (∫ x, observationLikelihood y x) =
      gaussianPDFReal (empiricalMean y) (n : ℝ≥0)⁻¹ θ := by
  rw [observationLikelihood_integral y hn]
  unfold observationLikelihood
  rw [unitGaussian_likelihood, flatLikelihood_factorization y hn]
  have hs : (Real.sqrt (2 * Real.pi))⁻¹ ^ n ≠ 0 := by positivity
  field_simp [hs, ne_of_gt (flatNormalizer_pos y hn)]

variable {A : Type*} [Fintype A] [Nonempty A] [DecidableEq A]

def productLikelihood (n : A → ℕ) (y : (a : A) → Fin (n a) → ℝ) (θ : Means A) : ℝ :=
  ∏ a, flatLikelihood (y a) (θ a)

theorem productLikelihood_integrable (n : A → ℕ) (y : (a : A) → Fin (n a) → ℝ)
    (hn : ∀ a, 0 < n a) : Integrable (productLikelihood n y) volume :=
  Integrable.fintype_prod (fun a => flatLikelihood_integrable (y a) (hn a))

theorem productLikelihood_integral (n : A → ℕ) (y : (a : A) → Fin (n a) → ℝ)
    (hn : ∀ a, 0 < n a) :
    (∫ θ, productLikelihood n y θ) = ∏ a, flatNormalizer (y a) := by
  unfold productLikelihood
  rw [integral_fintype_prod_volume_eq_prod]
  exact Finset.prod_congr rfl (fun a _ => flatLikelihood_integral (y a) (hn a))

theorem productLikelihood_integral_pos (n : A → ℕ) (y : (a : A) → Fin (n a) → ℝ)
    (hn : ∀ a, 0 < n a) : 0 < ∫ θ, productLikelihood n y θ := by
  rw [productLikelihood_integral n y hn]
  exact Finset.prod_pos (fun a _ => flatNormalizer_pos (y a) (hn a))

theorem normalized_productLikelihood (n : A → ℕ) (y : (a : A) → Fin (n a) → ℝ)
    (hn : ∀ a, 0 < n a) (θ : Means A) :
    productLikelihood n y θ / (∫ x, productLikelihood n y x) =
      ∏ a, gaussianPDFReal (empiricalMean (y a)) (n a : ℝ≥0)⁻¹ (θ a) := by
  rw [productLikelihood_integral n y hn]
  unfold productLikelihood
  simp_rw [flatLikelihood_factorization _ (hn _)]
  rw [Finset.prod_mul_distrib]
  field_simp [ne_of_gt (Finset.prod_pos (fun a _ => flatNormalizer_pos (y a) (hn a)))]

/-- The Gaussian product posterior really has its product likelihood density
with respect to the flat product Lebesgue prior. -/
theorem posterior_density (c : Precisions A) (m : Means A) (hc : ∀ a, 0 < c a) :
    posteriorLaw c m = volume.withDensity
      (fun θ => ENNReal.ofReal (∏ a, gaussianPDFReal (m a) (c a)⁻¹ (θ a))) := by
  rw [BayesOptimal.FiniteModelExclusion.posteriorLaw_eq_pi]
  apply Measure.pi_eq
  intro s hs
  have hprod : Integrable
      (fun θ : Means A => ∏ a, gaussianPDFReal (m a) (c a)⁻¹ (θ a)) volume :=
    Integrable.fintype_prod (fun a => integrable_gaussianPDFReal _ _)
  have hnonneg (θ : Means A) : 0 ≤ ∏ a, gaussianPDFReal (m a) (c a)⁻¹ (θ a) :=
    Finset.prod_nonneg (fun _ _ => gaussianPDFReal_nonneg _ _ _)
  rw [withDensity_apply _ (MeasurableSet.univ_pi hs),
    ← ofReal_integral_eq_lintegral_ofReal hprod.restrict
      (Filter.Eventually.of_forall hnonneg)]
  change ENNReal.ofReal (∫ θ, (∏ a, gaussianPDFReal (m a) (c a)⁻¹ (θ a))
    ∂((Measure.pi (fun _ : A => (volume : Measure ℝ))).restrict (Set.univ.pi s))) = _
  rw [Measure.restrict_pi_pi, integral_fintype_prod_eq_prod,
    ENNReal.ofReal_prod_of_nonneg]
  · apply Finset.prod_congr rfl
    intro a _
    exact (gaussianReal_apply_eq_integral (m a)
      (inv_ne_zero (ne_of_gt (hc a))) (s a)).symm
  · intro a _
    exact integral_nonneg (gaussianPDFReal_nonneg _ _)

/-- End-to-end initialization from the improper flat prior: any strictly
positive count vector, and every observed data set, gives the exact proper
independent Gaussian posterior used by the Bellman model. -/
theorem normalized_product_measure (n : A → ℕ) (y : (a : A) → Fin (n a) → ℝ)
    (hn : ∀ a, 0 < n a) :
    volume.withDensity (fun θ => ENNReal.ofReal
      (productLikelihood n y θ / (∫ x, productLikelihood n y x))) =
        posteriorLaw (fun a => (n a : ℝ≥0)) (fun a => empiricalMean (y a)) := by
  simp_rw [normalized_productLikelihood n y hn]
  exact (posterior_density _ _ (fun a => by exact_mod_cast hn a)).symm

theorem normalized_product_sufficient (n : A → ℕ)
    (y z : (a : A) → Fin (n a) → ℝ) (hn : ∀ a, 0 < n a)
    (hmean : ∀ a, empiricalMean (y a) = empiricalMean (z a)) :
    (fun θ => productLikelihood n y θ / (∫ x, productLikelihood n y x)) =
      (fun θ => productLikelihood n z θ / (∫ x, productLikelihood n z x)) := by
  funext θ
  simp_rw [normalized_productLikelihood n _ hn, hmean]

end
end BayesOptimal.FlatPriorProduct

end

/-! ## AdaptivePosteriorSufficiency -/
section

open MeasureTheory ProbabilityTheory
open scoped NNReal ENNReal

namespace BayesOptimal.AdaptivePosteriorSufficiency

noncomputable section
set_option linter.unusedSectionVars false

open BayesOptimal.FlatPriorInitialization BayesOptimal.FlatPriorProduct
open BayesOptimal.FiniteGaussian BayesOptimal.FinitePosterior

variable {A : Type*} [Fintype A] [Nonempty A] [DecidableEq A]

abbrev Fiber {N : ℕ} (arms : Fin N → A) (a : A) := {j : Fin N // arms j = a}

def sampleCount {N : ℕ} (arms : Fin N → A) (a : A) : ℕ := Fintype.card (Fiber arms a)

def sampleData {N : ℕ} (arms : Fin N → A) (y : Fin N → ℝ) (a : A) :
    Fin (sampleCount arms a) → ℝ :=
  fun j => y (((Fintype.equivFin (Fiber arms a)).symm j).val)

def likelihood {N : ℕ} (arms : Fin N → A) (y : Fin N → ℝ) (θ : Means A) : ℝ :=
  ∏ j, gaussianPDFReal (θ (arms j)) 1 (y j)

def likelihoodConstant {N : ℕ} (arms : Fin N → A) : ℝ :=
  ∏ a, (Real.sqrt (2 * Real.pi))⁻¹ ^ sampleCount arms a

theorem sampleCount_pos {N : ℕ} (arms : Fin N → A)
    (hinit : ∀ a, ∃ j, arms j = a) (a : A) : 0 < sampleCount arms a := by
  obtain ⟨j, hj⟩ := hinit a
  exact Fintype.card_pos_iff.mpr ⟨⟨j, hj⟩⟩

theorem likelihood_by_arm {N : ℕ} (arms : Fin N → A) (y : Fin N → ℝ) (θ : Means A) :
    likelihood arms y θ =
      ∏ a, observationLikelihood (sampleData arms y a) (θ a) := by
  unfold likelihood
  rw [← Fintype.prod_fiberwise arms (fun j => gaussianPDFReal (θ (arms j)) 1 (y j))]
  apply Finset.prod_congr rfl
  intro a _
  have he := (Fintype.equivFin (Fiber arms a)).symm.prod_comp
    (fun j : Fiber arms a => gaussianPDFReal (θ a) 1 (y j.val))
  change (∏ j : Fiber arms a, gaussianPDFReal (θ (arms j.val)) 1 (y j.val)) = _
  calc
    _ = ∏ j : Fiber arms a, gaussianPDFReal (θ a) 1 (y j.val) := by
      apply Finset.prod_congr rfl
      intro j _
      rw [j.property]
    _ = _ := he.symm

/-- Regrouping the observation likelihood is valid for every realized
sequence of chosen arms, including sequences chosen from earlier rewards. -/
theorem likelihood_factorization {N : ℕ} (arms : Fin N → A) (y : Fin N → ℝ) (θ : Means A) :
    likelihood arms y θ = likelihoodConstant arms *
      productLikelihood (sampleCount arms) (sampleData arms y) θ := by
  rw [likelihood_by_arm]
  unfold observationLikelihood
  simp_rw [unitGaussian_likelihood]
  exact Finset.prod_mul_distrib

theorem likelihoodConstant_pos {N : ℕ} (arms : Fin N → A) :
    0 < likelihoodConstant arms := by
  unfold likelihoodConstant
  apply Finset.prod_pos
  intro a _
  positivity

theorem normalized_likelihood {N : ℕ} (arms : Fin N → A) (y : Fin N → ℝ)
    (hinit : ∀ a, ∃ j, arms j = a) (θ : Means A) :
    likelihood arms y θ / (∫ x, likelihood arms y x) =
      ∏ a, gaussianPDFReal (empiricalMean (sampleData arms y a))
        (sampleCount arms a : ℝ≥0)⁻¹ (θ a) := by
  have hn := sampleCount_pos arms hinit
  simp_rw [likelihood_factorization]
  rw [integral_const_mul]
  have hc := ne_of_gt (likelihoodConstant_pos arms)
  rw [mul_div_mul_left _ _ hc]
  exact normalized_productLikelihood _ _ hn θ

/-- Normalizing the Gaussian likelihood of the labelled reward vector gives
the proper product Gaussian measure. This statement concerns the explicitly
defined likelihood; it does not assert a separate conditional-distribution
theorem for an arbitrary adaptive-history law. Actual adaptive Gaussian
observation disintegration is established in ObservationBridge. -/
theorem normalized_history_posterior {N : ℕ} (arms : Fin N → A) (y : Fin N → ℝ)
    (hinit : ∀ a, ∃ j, arms j = a) :
    volume.withDensity (fun θ => ENNReal.ofReal
      (likelihood arms y θ / (∫ x, likelihood arms y x))) =
      posteriorLaw (fun a => (sampleCount arms a : ℝ≥0))
        (fun a => empiricalMean (sampleData arms y a)) := by
  simp_rw [normalized_likelihood arms y hinit]
  exact (posterior_density _ _ (fun a => by
    exact_mod_cast sampleCount_pos arms hinit a)).symm

/-- A positive, parameter-independent policy-density factor cancels out of
the posterior. This is the likelihood cancellation used for adaptive rules. -/
theorem parameter_independent_factor_cancels {N : ℕ} (arms : Fin N → A) (y : Fin N → ℝ)
    (hinit : ∀ a, ∃ j, arms j = a) (p : ℝ) (hp : 0 < p) (θ : Means A) :
    (p * likelihood arms y θ) / (∫ x, p * likelihood arms y x) =
      ∏ a, gaussianPDFReal (empiricalMean (sampleData arms y a))
        (sampleCount arms a : ℝ≥0)⁻¹ (θ a) := by
  rw [integral_const_mul, mul_div_mul_left _ _ (ne_of_gt hp)]
  exact normalized_likelihood arms y hinit θ

end
end BayesOptimal.AdaptivePosteriorSufficiency

end

/-! ## DecisionRules -/
section

namespace BayesOptimal.DecisionRules

open BayesOptimal.FiniteGaussian BayesOptimal.FinitePosterior

variable {A : Type*} [Fintype A] [Nonempty A] [DecidableEq A]

noncomputable section

def EBI (k : ℕ) (c : Precisions A) (m : Means A) (i : A) : ℝ :=
  loss k c m - actionLoss k c m i

theorem EBI_eq (k : ℕ) (c : Precisions A) (m : Means A) (i : A) (hc : 0<c i) :
    EBI k c m i = action k c m i - value k c m := by
  rw [EBI, actionLoss_eq k c m i hc]
  unfold loss
  ring

theorem argmax_EBI_iff_argmin_actionLoss (k : ℕ) (c : Precisions A) (m : Means A) (i : A) :
    (∀ j, EBI k c m j ≤ EBI k c m i) ↔ (∀ j, actionLoss k c m i ≤ actionLoss k c m j) := by
  simp only [EBI, sub_le_sub_iff_left]

theorem actionLoss_eq_loss_iff (k : ℕ) (c : Precisions A) (m : Means A) (i : A)
    (hc : 0<c i) : actionLoss k c m i = loss (k+1) c m ↔
      action k c m i = value (k+1) c m := by
  rw [actionLoss_eq k c m i hc]
  unfold loss
  exact sub_right_inj

theorem actionLoss_minimal (k : ℕ) (c : Precisions A) (m : Means A)
    (hc : ∀ i, 0<c i) (j : A) : loss (k+1) c m ≤ actionLoss k c m j := by
  rw [actionLoss_eq k c m j (hc j)]
  unfold loss
  exact sub_le_sub_left (action_le_value k c m j) _

theorem chosen_actionLoss_eq (k : ℕ) (c : Precisions A) (m : Means A)
    (hc : ∀ i, 0<c i) : actionLoss k c m (choose k c m) = loss (k+1) c m :=
  (actionLoss_eq_loss_iff k c m _ (hc _)).mpr (choose_optimal k c m)

theorem optimal_action_iff_EBI_max (k : ℕ) (c : Precisions A) (m : Means A) (i : A)
    (hc : ∀ j, 0<c j) :
    action k c m i = value (k+1) c m ↔ ∀ j, EBI k c m j ≤ EBI k c m i := by
  simp_rw [EBI_eq k c m _ (hc _)]
  simp only [sub_le_sub_iff_right]
  constructor
  · intro h j
    rw [h]
    exact action_le_value k c m j
  · intro h
    apply le_antisymm (action_le_value k c m i)
    rw [value_succ]
    exact maxAll_le _ _ h

omit [DecidableEq A] in
theorem terminal_recommendation_iff (c : Precisions A) (m : Means A) (i : A) :
    (∀ j, terminalRegret c m i ≤ terminalRegret c m j) ↔ m i = maxAll m := by
  simp_rw [terminalRegret_eq, sub_le_sub_iff_left]
  constructor
  · intro h
    exact le_antisymm (coordinate_le_maxAll m i) (maxAll_le m (m i) h)
  · intro h j
    rw [h]
    exact coordinate_le_maxAll m j

theorem optimal_posterior_loss (k : ℕ) (c : Precisions A) (m : Means A)
    (hc : ∀ i, 0<c i) : expectedRegret (optimal k c m) c m = loss k c m := by
  rw [expectedRegret_eq _ _ _ (optimal_admissible k c m) hc, optimal_utility]
  rfl

end
end BayesOptimal.DecisionRules

end

/-! ## CountComparison -/
section

set_option warningAsError true

open MeasureTheory ProbabilityTheory Set
open BayesOptimal.Foundations.Counts BayesOptimal.Foundations.Drift BayesOptimal.Foundations.PredictiveLaw BayesOptimal.Foundations.PredictiveBound

namespace BayesOptimal.Comparison

noncomputable section

-- Exact coefficient 3 printed on PDF page 13.
def newZ (T q i : ℕ) (p : MeanPath) : Prop :=
  ∀ n : ℕ, 1 ≤ n → n ≤ q →
    |p i n - p i q| ≤ 3 * Real.sqrt (Real.log (T : ℝ)) *
      Real.sqrt (reciprocalSqSum n q)

def newW (T q : ℕ) (CU : ℝ) (p : MeanPath) (c : Counts) : Prop :=
  eventX T CU p ∧ eventY T q 1 p ∧ eventY T q 2 p ∧
    newZ T q 1 p ∧ newZ T q 2 p ∧
    c.n1 ≤ q ∧ c.n2 ≤ q ∧ c.n3 ≤ 1

-- PDF pages 34-35 state a multiset rather than a fixed orientation.
theorem forecast_terminal_multiset (T q t : ℕ) (c : Counts)
    (hT : T = 2 * q + 1) (hq : 0 < q) (ht : 4 ≤ t) (horizon : t ≤ T)
    (hc : horizonConsistent t c) (h1 : c.n1 ≤ q) (h2 : c.n2 ≤ q) :
    ((balancedRun (T - t) c).n1 = q ∧ (balancedRun (T - t) c).n2 = q - 1) ∨
    ((balancedRun (T - t) c).n1 = q - 1 ∧ (balancedRun (T - t) c).n2 = q) := by
  have he := equation22_generic_horizon T q t c hT hq ht horizon hc h1 h2
  by_cases hs : c.n2 = q
  · right
    simpa [hs] using he
  · left
    simpa [hs] using he

theorem new_equation23_drift160 (T q t : ℕ) (CU : ℝ) (p : MeanPath) (c : Counts)
    (hT : T = 2 * q + 1) (ht : 4 ≤ t) (hpre : t < T)
    (hc : horizonConsistent t c) (hW : newW T q CU p c) :
    (terminalGap p c) ^ 2 ≤ 160 * Real.log (T : ℝ) * transitionVariance (T - t) c := by
  rcases hc with ⟨hc1, hc2, hc3, htotal⟩
  rcases hW with ⟨_hX, hY1, hY2, hZ1, hZ2, h1, h2, _h3⟩
  have hq : 2 ≤ q := by omega
  have hT5 : 5 ≤ T := by omega
  have hTreal : 5 ≤ (T : ℝ) := by exact_mod_cast hT5
  have hk : 0 < T - t := by omega
  have hsum : c.n1 + c.n2 + (T - t) = 2 * q - 1 := by omega
  have hlog := log_horizon_ge_one T hT5
  have hlog0 : 0 ≤ Real.log (T : ℝ) := by linarith
  have hS1 := reciprocalSqSum_nonnegative c.n1 q
  have hS2 := reciprocalSqSum_nonnegative c.n2 q
  have hB1 := reciprocalSqSum_bound c.n1 q hc1 h1
  have hB2 := reciprocalSqSum_bound c.n2 q hc2 h2
  have hanchor := to_anchor_variance_bound q (T - t) c hq hk hc1 hc2 h1 h2 hsum
  have hSsum : reciprocalSqSum c.n1 q + reciprocalSqSum c.n2 q ≤
      4 * transitionVariance (T - t) c := by linarith
  have hV0 := transitionVariance_nonnegative (T - t) c (by omega) (by omega)
  have hVl := lemma17_nonterminal_variance_bound T q t c hT (by omega) ht hpre
    ⟨hc1, hc2, hc3, htotal⟩ h1 h2
  have hZ1' := hZ1 c.n1 hc1 h1
  have hZ2' := hZ2 c.n2 hc2 h2
  have hanchors : |p 1 q - p 2 q| ≤ 2 / (T : ℝ) ^ 2 := by
    have habs : |p 1 q - p 2 q| ≤ |p 1 q| + |p 2 q| := by
      simpa only [← sub_eq_add_neg, abs_neg] using abs_add_le (p 1 q) (-p 2 q)
    unfold eventY at hY1 hY2
    calc
      |p 1 q - p 2 q| ≤ |p 1 q| + |p 2 q| := habs
      _ ≤ 1 / (T : ℝ) ^ 2 + 1 / (T : ℝ) ^ 2 := add_le_add hY1 hY2
      _ = 2 / (T : ℝ) ^ 2 := by ring
  have htri1 := abs_sub_le (p 1 c.n1) (p 1 q) (p 2 c.n2)
  have htri2 := abs_sub_le (p 1 q) (p 2 q) (p 2 c.n2)
  rw [abs_sub_comm (p 2 q) (p 2 c.n2)] at htri2
  let A : ℝ := 3 * Real.sqrt (Real.log (T : ℝ)) * Real.sqrt (reciprocalSqSum c.n1 q)
  let B : ℝ := 3 * Real.sqrt (Real.log (T : ℝ)) * Real.sqrt (reciprocalSqSum c.n2 q)
  let C : ℝ := 2 / (T : ℝ) ^ 2
  have hA0 : 0 ≤ A := by dsimp [A]; positivity
  have hB0 : 0 ≤ B := by dsimp [B]; positivity
  have hC0 : 0 ≤ C := by dsimp [C]; positivity
  have habs : |terminalGap p c| ≤ A + B + C := by
    dsimp [A, B, C]
    unfold terminalGap
    linarith only [htri1, htri2, hanchors, hZ1', hZ2']
  have hsq : (terminalGap p c) ^ 2 ≤ (A + B + C) ^ 2 := by
    have h := (sq_le_sq₀ (abs_nonneg (terminalGap p c))
      (show 0 ≤ A + B + C by positivity)).mpr habs
    simpa only [sq_abs] using h
  have hthree : (A + B + C) ^ 2 ≤ 3 * (A ^ 2 + B ^ 2 + C ^ 2) := by
    nlinarith only [sq_nonneg (A - B), sq_nonneg (A - C), sq_nonneg (B - C)]
  have hAsq : A ^ 2 = 9 * Real.log (T : ℝ) * reciprocalSqSum c.n1 q := by
    dsimp [A]
    rw [mul_pow, mul_pow, Real.sq_sqrt hlog0, Real.sq_sqrt hS1]
    norm_num
  have hBsq : B ^ 2 = 9 * Real.log (T : ℝ) * reciprocalSqSum c.n2 q := by
    dsimp [B]
    rw [mul_pow, mul_pow, Real.sq_sqrt hlog0, Real.sq_sqrt hS2]
    norm_num
  have hCsq : C ^ 2 = 4 / (T : ℝ) ^ 4 := by
    dsimp [C]
    rw [div_pow, ← pow_mul]
    norm_num
  have hSscaled := mul_le_mul_of_nonneg_left hSsum hlog0
  have hinv : 1 / (T : ℝ) ^ 4 ≤ 1 / (T : ℝ) ^ 2 := by
    apply (div_le_div_iff₀ (by positivity) (by positivity)).mpr
    have hsquare : 1 ≤ (T : ℝ) ^ 2 := by nlinarith only [hTreal]
    have hpow := mul_le_mul_of_nonneg_right hsquare (sq_nonneg (T : ℝ))
    nlinarith only [hpow]
  have hVscaled : transitionVariance (T - t) c ≤
      Real.log (T : ℝ) * transitionVariance (T - t) c := by
    simpa using mul_le_mul_of_nonneg_right hlog hV0
  have hinvFinal : 1 / (T : ℝ) ^ 4 ≤
      Real.log (T : ℝ) * transitionVariance (T - t) c :=
    hinv.trans (hVl.trans hVscaled)
  have hinvScaled : 4 / (T : ℝ) ^ 4 ≤
      4 * (Real.log (T : ℝ) * transitionVariance (T - t) c) := by
    calc
      4 / (T : ℝ) ^ 4 = 4 * (1 / (T : ℝ) ^ 4) := by ring
      _ ≤ 4 * (Real.log (T : ℝ) * transitionVariance (T - t) c) :=
        mul_le_mul_of_nonneg_left hinvFinal (by norm_num)
  rw [hAsq, hBsq, hCsq] at hthree
  nlinarith only [hsq, hthree, hSscaled, hinvScaled, mul_nonneg hlog0 hV0]

theorem new_lemma18_fixed_tie162 (T q t : ℕ) (CU : ℝ)
    (p : MeanPath) (c : Counts)
    (hT : T = 2 * q + 1) (ht : 4 ≤ t) (hpre : t < T)
    (hc : horizonConsistent t c) (hW : newW T q CU p c) :
    lowerConstant * BayesOptimal.Foundations.Rates.invPower 162 T ≤
      (balancedPredictiveLaw (T - t) c (terminalGap p c)
        (Icc (BayesOptimal.Foundations.Rates.invPower 2 T) (2 * BayesOptimal.Foundations.Rates.invPower 2 T))).toReal := by
  have hq : 0 < q := by omega
  have hT5 : 5 ≤ T := by omega
  have hk : 0 < T - t := by omega
  have h1 : 0 < c.n1 := by have := hc.1; omega
  have h2 : 0 < c.n2 := by have := hc.2.1; omega
  have hcap1 : c.n1 ≤ q := hW.2.2.2.2.2.1
  have hcap2 : c.n2 ≤ q := hW.2.2.2.2.2.2.1
  have hVcoe := accumulatedVariance_coe (T - t) c h1 h2
  have hv : 0 < accumulatedVariance (T - t) c := by
    have hVr : 0 < (accumulatedVariance (T - t) c : ℝ) := by
      rw [hVcoe]
      exact transitionVariance_positive (T - t) c hk h1 h2
    exact hVr
  have hupper : (accumulatedVariance (T - t) c : ℝ) ≤ 2 := by
    rw [hVcoe]
    exact transitionVariance_le_two (T - t) c hc.1 hc.2.1
  have hlower : BayesOptimal.Foundations.Rates.invPower 2 T ≤
      (accumulatedVariance (T - t) c : ℝ) := by
    rw [BayesOptimal.Foundations.Rates.invPower, inv_eq_one_div, hVcoe]
    exact lemma17_nonterminal_variance_bound T q t c hT hq ht hpre hc hcap1 hcap2
  have hδ : (terminalGap p c) ^ 2 ≤
      160 * Real.log (T : ℝ) * (accumulatedVariance (T - t) c : ℝ) := by
    rw [hVcoe]
    exact new_equation23_drift160 T q t CU p c hT ht hpre hc hW
  rw [balancedPredictiveLaw_gaussian]
  exact gaussian_interval_probability_lower_nat 160 T hT5 hv hupper hlower hδ


-- A direct Lean certificate for the paper's conservative T^-170 bound,
-- for the certified count-only rule that resolves every tie in favor of arm 1.
theorem new_lemma18_fixed_tie170 (T q t : ℕ) (CU : ℝ)
    (p : MeanPath) (c : Counts)
    (hT : T = 2 * q + 1) (ht : 4 ≤ t) (hpre : t < T)
    (hc : horizonConsistent t c) (hW : newW T q CU p c) :
    lowerConstant * BayesOptimal.Foundations.Rates.invPower 170 T ≤
      (balancedPredictiveLaw (T - t) c (terminalGap p c)
        (Icc (BayesOptimal.Foundations.Rates.invPower 2 T) (2 * BayesOptimal.Foundations.Rates.invPower 2 T))).toReal := by
  have hm := new_lemma18_fixed_tie162 T q t CU p c hT ht hpre hc hW
  have hpow := BayesOptimal.Foundations.Rates.invPower_antitone (by norm_num : 162 ≤ 170)
    (show 1 ≤ T by omega)
  exact (mul_le_mul_of_nonneg_left hpow lowerConstant_pos.le).trans hm

-- The normalized exponent 164 printed on PDF page 35 is also checked.
theorem new_density_exponent164 {t δ x v : ℝ}
    (ht : 1 ≤ t) (hlog : 1 ≤ Real.log t) (hv : 0 < v)
    (hvlower : (t ^ 2)⁻¹ ≤ v)
    (hδ : δ ^ 2 ≤ 160 * Real.log t * v)
    (hx : x ∈ Icc ((t ^ 2)⁻¹) (2 * (t ^ 2)⁻¹)) :
    (x - δ) ^ 2 / (2 * v) ≤ 164 * Real.log t := by
  have hqnonneg : 0 ≤ (t ^ 2)⁻¹ := inv_nonneg.mpr (sq_nonneg t)
  have hqle : (t ^ 2)⁻¹ ≤ 1 := inv_le_one_of_one_le₀ (one_le_pow₀ ht)
  have hxnonneg : 0 ≤ x := hqnonneg.trans hx.1
  have hxx : x ^ 2 ≤ 4 * v := by
    have hqq : ((t ^ 2)⁻¹) ^ 2 ≤ (t ^ 2)⁻¹ := by nlinarith
    have hsq : x ^ 2 ≤ (2 * (t ^ 2)⁻¹) ^ 2 :=
      (sq_le_sq₀ hxnonneg (by positivity)).mpr hx.2
    nlinarith
  have hquad : (x - δ) ^ 2 ≤ (160 * Real.log t + 4) * (2 * v) := by
    nlinarith [sq_nonneg (x + δ)]
  have hquot : (x - δ) ^ 2 / (2 * v) ≤ 160 * Real.log t + 4 :=
    (div_le_iff₀ (mul_pos (by norm_num) hv)).mpr hquad
  linarith

end

end BayesOptimal.Comparison

end

