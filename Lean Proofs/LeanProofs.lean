/-! ## UniformSamplingModel -/
section

set_option linter.unusedSectionVars false

open MeasureTheory ProbabilityTheory Set Filter
open scoped NNReal ENNReal Topology

namespace BayesOptimal.UniformSampling

open BayesOptimal.FiniteGaussian BayesOptimal.FiniteModelMeasurable

variable {A : Type*} [Fintype A] [Nonempty A] [DecidableEq A]
variable [MeasurableSpace A] [MeasurableSingletonClass A]

noncomputable section

abbrev Arrays (A : Type*) (T : ℕ) := A → Fin T → ℝ

def law (T : ℕ) : Measure (Arrays A T) :=
  Measure.pi (fun _ : A => BayesOptimal.Foundations.BadEvent.arrayLaw T)

instance law_probability (T : ℕ) : IsProbabilityMeasure (law (A := A) T) := by
  unfold law
  infer_instance

/-- Empirical averages of actual independent unit-variance Gaussian rewards:
the array stores the centered noise, and the true mean is added to each arm.
The allocation is deterministic and may differ by rounding between arms. -/
def empirical {T : ℕ} (μ : Means A) (n : A → ℕ) (x : Arrays A T) : Means A :=
  fun a => μ a + BayesOptimal.Foundations.BadEvent.sampleMean (n a) (x a)

theorem empirical_measurable (T : ℕ) (μ : Means A) (n : A → ℕ) :
    Measurable (empirical (T := T) μ n) := by
  apply measurable_pi_lambda
  intro a
  exact (((BayesOptimal.Foundations.FrequentistModel.sampleMean_continuous T (n a)).measurable.comp
    (measurable_pi_apply a)).const_add (μ a))

theorem empirical_coordinate_law (T : ℕ) (μ : Means A) (n : A → ℕ) (a : A)
    (hn : 0 < n a) (hnT : n a ≤ T) :
    HasLaw (fun x : Arrays A T => empirical μ n x a)
      (gaussianReal (μ a) (n a : ℝ≥0)⁻¹) (law T) := by
  have he := (measurePreserving_eval (fun _ : A => BayesOptimal.Foundations.BadEvent.arrayLaw T) a).hasLaw
  have hm := (BayesOptimal.Foundations.BadEvent.sampleMean_law (n a) T hn hnT).fun_comp he
  have hadd : HasLaw (fun z : ℝ => μ a + z)
      (gaussianReal (μ a) (n a : ℝ≥0)⁻¹) (gaussianReal 0 (n a : ℝ≥0)⁻¹) := by
    constructor
    · exact (by fun_prop : Measurable (fun z : ℝ => μ a + z)).aemeasurable
    · simpa using gaussianReal_map_const_add (μ := (0 : ℝ)) (v := (n a : ℝ≥0)⁻¹) (μ a)
  exact hadd.fun_comp hm

theorem empirical_independent (T : ℕ) (μ : Means A) (n : A → ℕ) :
    iIndepFun (fun a (x : Arrays A T) => empirical μ n x a) (law T) := by
  exact iIndepFun_pi (fun a =>
    ((BayesOptimal.Foundations.FrequentistModel.sampleMean_continuous T (n a)).measurable.const_add
      (μ a)).aemeasurable)

def pairVariance (n : A → ℕ) (a b : A) : ℝ≥0 :=
  (n a : ℝ≥0)⁻¹ + (n b : ℝ≥0)⁻¹

theorem empirical_gap_law (T : ℕ) (μ : Means A) (n : A → ℕ) (a b : A)
    (hab : a ≠ b) (hn : ∀ a, 0 < n a) (hnT : ∀ a, n a ≤ T) :
    HasLaw (fun x : Arrays A T => empirical μ n x a - empirical μ n x b)
      (gaussianReal (μ a - μ b) (pairVariance n a b)) (law T) := by
  have ha := empirical_coordinate_law T μ n a (hn a) (hnT a)
  have hb := empirical_coordinate_law T μ n b (hn b) (hnT b)
  have hneg : HasLaw (fun z : ℝ => -z)
      (gaussianReal (-μ b) (n b : ℝ≥0)⁻¹) (gaussianReal (μ b) (n b : ℝ≥0)⁻¹) := by
    constructor
    · exact (by fun_prop : Measurable (fun z : ℝ => -z)).aemeasurable
    · simpa only [zero_sub] using
        gaussianReal_map_const_sub (μ := μ b) (v := (n b : ℝ≥0)⁻¹) 0
  have hind := (empirical_independent T μ n).indepFun hab
  have hind' : IndepFun (fun x : Arrays A T => empirical μ n x a)
      (fun x : Arrays A T => -empirical μ n x b) (law T) :=
    hind.comp measurable_id (by fun_prop)
  have hsum := hind'.hasLaw_fun_add ha (hneg.fun_comp hb)
  rw [gaussianReal_conv_gaussianReal] at hsum
  simpa only [sub_eq_add_neg, pairVariance] using hsum

def recommendation {T : ℕ} (μ : Means A) (n : A → ℕ) (x : Arrays A T) : A :=
  firstMax (empirical μ n x)

theorem recommendation_measurable (T : ℕ) (μ : Means A) (n : A → ℕ) :
    Measurable (recommendation (T := T) μ n) :=
  firstMax_measurable.comp (empirical_measurable T μ n)

theorem recommendation_maximal {T : ℕ} (μ : Means A) (n : A → ℕ) (x : Arrays A T)
    (a : A) : empirical μ n x a ≤ empirical μ n x (recommendation μ n x) := by
  change empirical μ n x a ≤ empirical μ n x (firstMax (empirical μ n x))
  rw [firstMax_attains (empirical μ n x)]
  exact coordinate_le_maxAll _ _

def error (T : ℕ) (μ : Means A) (best : A) (n : A → ℕ) : ℝ :=
  (law T).real {x | recommendation μ n x ≠ best}

def regret (T : ℕ) (μ : Means A) (best : A) (n : A → ℕ) : ℝ :=
  ∫ x, μ best - μ (recommendation μ n x) ∂law T

theorem strict_pair_implies_error {T : ℕ} (μ : Means A) (n : A → ℕ) (best a : A)
    (x : Arrays A T) (h : empirical μ n x best < empirical μ n x a) :
    recommendation μ n x ≠ best := by
  intro he
  have hm := recommendation_maximal μ n x a
  rw [he] at hm
  exact (not_lt_of_ge hm) h

theorem error_implies_weak_pair {T : ℕ} (μ : Means A) (n : A → ℕ) (best : A)
    (x : Arrays A T) (h : recommendation μ n x ≠ best) :
    ∃ a : {a : A // a ≠ best}, empirical μ n x best ≤ empirical μ n x a := by
  exact ⟨⟨recommendation μ n x, h⟩, recommendation_maximal μ n x best⟩

theorem error_lower_pair (T : ℕ) (μ : Means A) (n : A → ℕ) (best a : A) :
    (law T).real {x | empirical μ n x best < empirical μ n x a} ≤ error T μ best n := by
  exact measureReal_mono (fun _ h => strict_pair_implies_error μ n best a _ h)

theorem error_upper_pairs (T : ℕ) (μ : Means A) (n : A → ℕ) (best : A) :
    error T μ best n ≤ ∑ a : {a : A // a ≠ best},
      (law T).real {x | empirical μ n x best ≤ empirical μ n x a} := by
  have hset : {x : Arrays A T | recommendation μ n x ≠ best} ⊆
      ⋃ a : {a : A // a ≠ best}, {x | empirical μ n x best ≤ empirical μ n x a} := by
    intro x hx
    obtain ⟨a, ha⟩ := error_implies_weak_pair μ n best x hx
    exact mem_iUnion.mpr ⟨a, ha⟩
  exact (measureReal_mono hset).trans (measureReal_iUnion_fintype_le _)

end
end BayesOptimal.UniformSampling

end

/-! ## UniformSamplingProbability -/
section

set_option linter.unusedSectionVars false

open MeasureTheory ProbabilityTheory Set Filter
open scoped NNReal ENNReal Topology

namespace BayesOptimal.UniformSampling

open BayesOptimal.FiniteGaussian BayesOptimal.TailRatio

noncomputable section

theorem gaussian_upper_tail_standardize (δ : ℝ) (v : ℝ≥0) (hv : 0 < v) :
    (gaussianReal (-δ) v).real (Ioi 0) = normalTail (δ / Real.sqrt (v : ℝ)) ∧
      (gaussianReal (-δ) v).real (Ici 0) = normalTail (δ / Real.sqrt (v : ℝ)) := by
  have hvR : 0 < (v : ℝ) := by exact_mod_cast hv
  have hs : 0 < Real.sqrt (v : ℝ) := Real.sqrt_pos.mpr hvR
  have hvar : (⟨Real.sqrt (v : ℝ)^2, sq_nonneg _⟩ : ℝ≥0) * 1 = v := by
    apply NNReal.coe_injective
    change Real.sqrt (v : ℝ)^2 * 1 = (v : ℝ)
    rw [mul_one, Real.sq_sqrt hvR.le]
  have hmap : (gaussianReal 0 1).map (fun z : ℝ => -δ + Real.sqrt (v : ℝ) * z) =
      gaussianReal (-δ) v := by
    have he : (fun z : ℝ => -δ + Real.sqrt (v : ℝ) * z) =
        (fun z : ℝ => -δ + z) ∘ (fun z : ℝ => Real.sqrt (v : ℝ) * z) := rfl
    rw [he, ← Measure.map_map (by fun_prop) (by fun_prop), gaussianReal_map_const_mul,
      mul_zero, hvar, gaussianReal_map_const_add, zero_add]
  have hp : (fun z : ℝ => -δ + Real.sqrt (v : ℝ) * z) ⁻¹' Ioi 0 =
      Ioi (δ / Real.sqrt (v : ℝ)) := by
    ext z
    change 0 < -δ + Real.sqrt (v : ℝ) * z ↔ δ / Real.sqrt (v : ℝ) < z
    rw [div_lt_iff₀ hs]
    constructor <;> intro h <;> nlinarith
  have hstrict : (gaussianReal (-δ) v).real (Ioi 0) =
      normalTail (δ / Real.sqrt (v : ℝ)) := by
    rw [measureReal_def, ← hmap, Measure.map_apply (by fun_prop) measurableSet_Ioi, hp]
    rfl
  constructor
  · exact hstrict
  · haveI : NoAtoms (gaussianReal (-δ) v) := noAtoms_gaussianReal hv.ne'
    exact (congrArg ENNReal.toReal (measure_congr
      (Ioi_ae_eq_Ici (μ := gaussianReal (-δ) v) (a := 0)))).symm.trans hstrict

variable {A : Type*} [Fintype A] [Nonempty A] [DecidableEq A]
variable [MeasurableSpace A] [MeasurableSingletonClass A]

def threshold (μ : Means A) (n : A → ℕ) (best a : A) : ℝ :=
  (μ best - μ a) / Real.sqrt (pairVariance n a best : ℝ)

theorem pairVariance_pos (n : A → ℕ) (a b : A) (hn : ∀ a, 0 < n a) :
    0 < pairVariance n a b := by
  unfold pairVariance
  have ha : (0 : ℝ≥0) < (n a : ℝ≥0) := by exact_mod_cast hn a
  exact add_pos_of_pos_of_nonneg (inv_pos.mpr ha) (by positivity)

theorem pair_crossing_prob (T : ℕ) (μ : Means A) (n : A → ℕ) (best a : A)
    (hab : a ≠ best) (hn : ∀ a, 0 < n a) (hnT : ∀ a, n a ≤ T) :
    (law T).real {x | empirical μ n x best < empirical μ n x a} =
      normalTail (threshold μ n best a) ∧
    (law T).real {x | empirical μ n x best ≤ empirical μ n x a} =
      normalTail (threshold μ n best a) := by
  have h := empirical_gap_law T μ n a best hab hn hnT
  have hlaw : (law T).map (fun x : Arrays A T => empirical μ n x a - empirical μ n x best) =
      gaussianReal (-(μ best - μ a)) (pairVariance n a best) := by
    convert h.map_eq using 1
    congr 1
    ring
  have hs := gaussian_upper_tail_standardize (μ best - μ a) (pairVariance n a best)
    (pairVariance_pos n a best hn)
  have hm : Measurable (fun x : Arrays A T => empirical μ n x a - empirical μ n x best) :=
    ((measurable_pi_apply a).comp (empirical_measurable T μ n)).sub
      ((measurable_pi_apply best).comp (empirical_measurable T μ n))
  simp only [threshold]
  constructor
  · rw [← hs.1, measureReal_def, measureReal_def, ← hlaw,
      Measure.map_apply hm measurableSet_Ioi]
    congr 1
    congr 1
    ext x
    change empirical μ n x best < empirical μ n x a ↔
      0 < empirical μ n x a - empirical μ n x best
    exact sub_pos.symm
  · rw [← hs.2, measureReal_def, measureReal_def, ← hlaw,
      Measure.map_apply hm measurableSet_Ici]
    congr 1
    congr 1
    ext x
    change empirical μ n x best ≤ empirical μ n x a ↔
      0 ≤ empirical μ n x a - empirical μ n x best
    exact sub_nonneg.symm

theorem error_tail_sandwich (T : ℕ) (μ : Means A) (n : A → ℕ) (best : A)
    (hn : ∀ a, 0 < n a) (hnT : ∀ a, n a ≤ T) :
    (∀ a : {a : A // a ≠ best}, normalTail (threshold μ n best a) ≤ error T μ best n) ∧
    error T μ best n ≤ ∑ a : {a : A // a ≠ best}, normalTail (threshold μ n best a) := by
  constructor
  · intro a
    rw [← (pair_crossing_prob T μ n best a a.2 hn hnT).1]
    exact error_lower_pair T μ n best a
  · have h := error_upper_pairs T μ n best
    simpa only [(fun a : {a : A // a ≠ best} =>
      (pair_crossing_prob T μ n best a a.2 hn hnT).2)] using h

end
end BayesOptimal.UniformSampling

end

/-! ## UniformSamplingRate -/
section

set_option linter.unusedSectionVars false

open MeasureTheory ProbabilityTheory Set Filter
open scoped NNReal ENNReal Topology

namespace BayesOptimal.UniformSampling

open BayesOptimal.FiniteGaussian BayesOptimal.TailRatio

noncomputable section

theorem tendsto_atTop_of_sq_div_pos (x : ℕ → ℝ) (q : ℝ) (hq : 0 < q)
    (hx : ∀ᶠ T in atTop, 0 ≤ x T)
    (hlim : Tendsto (fun T => (x T)^2 / (T : ℝ)) atTop (𝓝 q)) :
    Tendsto x atTop atTop := by
  apply tendsto_atTop.mpr
  intro b
  filter_upwards [hx, (tendsto_order.mp hlim).1 (q/2) (by linarith),
    (tendsto_natCast_atTop_atTop : Tendsto (fun T : ℕ => (T : ℝ)) atTop atTop).eventually
      (eventually_gt_atTop (max 1 ((max b 0)^2 * (2/q))))] with T hxp hrat hT
  have hTp : 0 < (T : ℝ) := lt_trans (by positivity : (0 : ℝ) < 1)
    ((le_max_left _ _).trans_lt hT)
  have hsq := (lt_div_iff₀ hTp).mp hrat
  have hlarge : (max b 0)^2 < q/2 * (T : ℝ) := by
    have hm := mul_lt_mul_of_pos_left ((le_max_right _ _).trans_lt hT)
      (show 0 < q/2 by positivity)
    have he : q/2 * ((max b 0)^2 * (2/q)) = (max b 0)^2 := by field_simp
    rwa [he] at hm
  have hb : b ≤ max b 0 := le_max_left _ _
  have hb0 : 0 ≤ max b 0 := le_max_right _ _
  nlinarith

theorem threshold_rate_limit {A : Type*} [Fintype A] [Nonempty A] [DecidableEq A]
    (μ : Means A) (n : ℕ → A → ℕ) (K : ℝ) (hK : 0 < K)
    (hn : ∀ a, Tendsto (fun T : ℕ => (n T a : ℝ) / (T : ℝ)) atTop (𝓝 (1/K)))
    (best a : A) (hgap : 0 < μ best - μ a) :
    Tendsto (fun T => -Real.log (normalTail (threshold μ (n T) best a)) / (T : ℝ))
      atTop (𝓝 ((μ best - μ a)^2 / (4*K))) := by
  have hi (b : A) : Tendsto (fun T : ℕ => (T : ℝ) / (n T b : ℝ)) atTop (𝓝 K) := by
    have h := (hn b).inv₀ (ne_of_gt (by positivity : 0 < 1/K))
    simpa only [one_div, inv_div, inv_inv] using h
  have hv : Tendsto (fun T : ℕ => (T : ℝ) * (pairVariance (n T) a best : ℝ))
      atTop (𝓝 (2*K)) := by
    convert (hi a).add (hi best) using 1
    · funext T
      simp only [pairVariance, NNReal.coe_add, NNReal.coe_inv, NNReal.coe_natCast,
        mul_add, div_eq_mul_inv]
    · congr 1
      ring
  have hnpos (b : A) : ∀ᶠ T in atTop, 0 < n T b := by
    filter_upwards [(tendsto_order.mp (hn b)).1 0 (by positivity)] with T hT
    have hh := pos_of_mul_pos_left (show 0 < (n T b : ℝ) * (T : ℝ)⁻¹ by
      simpa only [div_eq_mul_inv] using hT) (by positivity : 0 ≤ (T : ℝ)⁻¹)
    exact_mod_cast hh
  have hsquared : Tendsto (fun T => (threshold μ (n T) best a)^2 / (T : ℝ))
      atTop (𝓝 ((μ best - μ a)^2 / (2*K))) := by
    have h : Tendsto (fun T : ℕ => (μ best - μ a)^2 /
        ((T : ℝ) * (pairVariance (n T) a best : ℝ))) atTop
        (𝓝 ((μ best - μ a)^2 / (2*K))) :=
      tendsto_const_nhds.div hv (ne_of_gt (by positivity : 0 < 2*K))
    apply h.congr'
    filter_upwards [hnpos a, hnpos best] with T ha hb
    have hvp : 0 < (pairVariance (n T) a best : ℝ) := by
      simp only [pairVariance, NNReal.coe_add, NNReal.coe_inv, NNReal.coe_natCast]
      positivity
    unfold threshold
    rw [div_pow, Real.sq_sqrt hvp.le]
    simp only [div_eq_mul_inv, mul_inv_rev]
    ring
  have hpositive : ∀ᶠ T in atTop, 0 ≤ threshold μ (n T) best a := by
    exact Filter.Eventually.of_forall (fun T => div_nonneg hgap.le (Real.sqrt_nonneg _))
  have ht := tendsto_atTop_of_sq_div_pos _ _ (by positivity) hpositive hsquared
  have h := gaussian_tail_rate _ _ ht hsquared
  convert h using 1
  congr 1
  ring

theorem finite_union_rate_limit {B : Type*} [Fintype B] [Nonempty B]
    (p : ℕ → B → ℝ) (r : ℕ → ℝ) (q : B → ℝ)
    (hp : ∀ᶠ T in atTop, ∀ b, 0 < p T b)
    (hl : ∀ᶠ T in atTop, ∀ b, p T b ≤ r T)
    (hu : ∀ᶠ T in atTop, r T ≤ ∑ b, p T b)
    (hlim : ∀ b, Tendsto (fun T => -Real.log (p T b) / (T : ℝ)) atTop (𝓝 (q b))) :
    Tendsto (fun T => -Real.log (r T) / (T : ℝ)) atTop
      (𝓝 (-maxAll (fun b => -q b))) := by
  let M : ℝ := Fintype.card B
  have hM : 0 < M := by
    dsimp [M]
    exact_mod_cast (Fintype.card_pos : 0 < Fintype.card B)
  have hpi : Tendsto (fun T => fun b => -(-Real.log (p T b) / (T : ℝ)))
      atTop (𝓝 (fun b => -q b)) := tendsto_pi_nhds.mpr (fun b => (hlim b).neg)
  have hmin : Tendsto (fun T => -maxAll (fun b => -(-Real.log (p T b) / (T : ℝ))))
      atTop (𝓝 (-maxAll (fun b => -q b))) :=
    ((maxAll_lipschitz (A := B)).continuous.tendsto _ |>.comp hpi).neg
  have hlowlim := hmin.sub (tendsto_const_div_atTop_nhds_zero_nat (Real.log M))
  obtain ⟨b0, hb0⟩ := maxAll_attained (fun b => -q b)
  have huplim : Tendsto (fun T => -Real.log (p T b0) / (T : ℝ)) atTop
      (𝓝 (-maxAll (fun b => -q b))) := by
    have he : q b0 = -maxAll (fun b => -q b) := by linarith
    simpa only [he] using hlim b0
  apply tendsto_of_tendsto_of_tendsto_of_le_of_le'
    (by simpa only [sub_zero] using hlowlim) huplim
  · filter_upwards [hp, hl, hu, eventually_ge_atTop (1 : ℕ)] with T hpp hll huu hT
    obtain ⟨b, hb⟩ := maxAll_attained (p T)
    have hsum : (∑ i, p T i) ≤ M * p T b := by
      calc
        _ ≤ ∑ _ : B, p T b := Finset.sum_le_sum (fun i _ =>
          (coordinate_le_maxAll (p T) i).trans_eq hb.symm)
        _ = _ := by simp only [Finset.sum_const, Finset.card_univ, nsmul_eq_mul, M]
    have hrp : 0 < r T := (hpp b).trans_le (hll b)
    have hlog := Real.log_le_log hrp (huu.trans hsum)
    rw [Real.log_mul hM.ne' (hpp b).ne'] at hlog
    have he (i : B) : -(-Real.log (p T i) / (T : ℝ)) ≤
        -(-Real.log (p T b) / (T : ℝ)) := by
      have hh := Real.log_le_log (hpp i)
        ((coordinate_le_maxAll (p T) i).trans_eq hb.symm)
      simpa only [neg_div, neg_neg] using div_le_div_of_nonneg_right hh
        (by positivity : 0 ≤ (T : ℝ))
    have hmax : maxAll (fun i => -(-Real.log (p T i) / (T : ℝ))) =
        -(-Real.log (p T b) / (T : ℝ)) :=
      le_antisymm (maxAll_le _ _ he)
        (coordinate_le_maxAll (fun i => -(-Real.log (p T i) / (T : ℝ))) b)
    rw [hmax]
    have hh := div_le_div_of_nonneg_right (neg_le_neg hlog)
      (by positivity : 0 ≤ (T : ℝ))
    simpa only [neg_add, add_div, neg_neg, neg_div, sub_eq_add_neg, add_comm] using hh
  · filter_upwards [hp, hl, eventually_ge_atTop (1 : ℕ)] with T hpp hll hT
    have hh := Real.log_le_log (hpp b0) (hll b0)
    exact div_le_div_of_nonneg_right (neg_le_neg hh) (by positivity)

end
end BayesOptimal.UniformSampling

end

/-! ## UniformSamplingConclusion -/
section

set_option linter.unusedSectionVars false

open MeasureTheory ProbabilityTheory Set Filter
open scoped NNReal ENNReal Topology

namespace BayesOptimal.UniformSampling

open BayesOptimal.FiniteGaussian BayesOptimal.FiniteModelExclusion BayesOptimal.ProseCorollaries BayesOptimal.TailRatio

noncomputable section

variable {A : Type*} [Fintype A] [Nonempty A] [DecidableEq A]
variable [MeasurableSpace A] [MeasurableSingletonClass A]

theorem minimum_gap_squared_identity (μ : Means A) (best : A)
    [Nonempty {a : A // a ≠ best}] (K : ℝ) (hK : 0 < K)
    (hbest : ∀ a, a ≠ best → μ a < μ best) :
    -maxAll (fun a : {a : A // a ≠ best} => -((μ best - μ a)^2 / (4*K))) =
      (minimumGap μ best)^2 / (4*K) := by
  obtain ⟨a0, ha0⟩ := maxAll_attained (fun a : {a : A // a ≠ best} => μ a)
  have haGap : μ best - μ a0 = minimumGap μ best := by
    unfold minimumGap otherMaximum
    rw [← ha0]
  have hm : maxAll (fun a : {a : A // a ≠ best} => -((μ best - μ a)^2 / (4*K))) =
      -((minimumGap μ best)^2 / (4*K)) := by
    apply le_antisymm
    · apply maxAll_le
      intro a
      apply neg_le_neg
      apply div_le_div_of_nonneg_right _ (by positivity)
      have hg := (gap_bounds μ best a a.2).1
      exact (sq_le_sq₀ (minimumGap_pos μ best hbest).le
        (sub_pos.mpr (hbest a a.2)).le).mpr hg
    · simpa only [haGap] using coordinate_le_maxAll
        (fun a : {a : A // a ≠ best} => -((μ best - μ a)^2 / (4*K))) a0
  rw [hm, neg_neg]

/-- Exact frequentist error exponent for any deterministic allocation with
asymptotically equal sampling proportions. The probability is derived from
the actual independent Gaussian observations and empirical-max selector. -/
theorem equal_allocation_error_limit (μ : Means A) (best : A)
    [Nonempty {a : A // a ≠ best}]
    (hbest : ∀ a, a ≠ best → μ a < μ best)
    (n : ℕ → A → ℕ) (K : ℝ) (hK : 0 < K)
    (hn : ∀ a, Tendsto (fun T : ℕ => (n T a : ℝ) / (T : ℝ)) atTop (𝓝 (1/K)))
    (hproper : ∀ᶠ T in atTop, (∀ a, 0 < n T a) ∧ (∀ a, n T a ≤ T)) :
    Tendsto (fun T => -Real.log (error T μ best (n T)) / (T : ℝ)) atTop
      (𝓝 ((minimumGap μ best)^2 / (4*K))) := by
  let p : ℕ → {a : A // a ≠ best} → ℝ := fun T a => normalTail (threshold μ (n T) best a)
  have h := finite_union_rate_limit p (fun T => error T μ best (n T))
    (fun a => (μ best - μ a)^2 / (4*K))
    (Filter.Eventually.of_forall (fun T a => normalTail_pos _))
    (by
      filter_upwards [hproper] with T hT
      exact (error_tail_sandwich T μ (n T) best hT.1 hT.2).1)
    (by
      filter_upwards [hproper] with T hT
      exact (error_tail_sandwich T μ (n T) best hT.1 hT.2).2)
    (fun a => threshold_rate_limit μ n K hK hn best a (sub_pos.mpr (hbest a a.2)))
  rwa [minimum_gap_squared_identity μ best K hK hbest] at h

theorem equal_allocation_error_eventually_pos (μ : Means A) (best : A)
    [Nonempty {a : A // a ≠ best}] (n : ℕ → A → ℕ)
    (hproper : ∀ᶠ T in atTop, (∀ a, 0 < n T a) ∧ (∀ a, n T a ≤ T)) :
    ∀ᶠ T in atTop, 0 < error T μ best (n T) := by
  obtain ⟨a⟩ := (inferInstance : Nonempty {a : A // a ≠ best})
  filter_upwards [hproper] with T hT
  exact (normalTail_pos _).trans_le
    ((error_tail_sandwich T μ (n T) best hT.1 hT.2).1 a)

theorem regret_error_bounds (T : ℕ) (μ : Means A) (best : A)
    [Nonempty {a : A // a ≠ best}]
    (hbest : ∀ a, a ≠ best → μ a < μ best) (n : A → ℕ) :
    minimumGap μ best * error T μ best n ≤ regret T μ best n ∧
      regret T μ best n ≤ maximumGap μ best * error T μ best n :=
  error_regret_sandwich (law T) μ best hbest (recommendation μ n)
    (recommendation_measurable T μ n)

/-- The exact same exponent holds for actual frequentist simple regret. -/
theorem equal_allocation_regret_limit (μ : Means A) (best : A)
    [Nonempty {a : A // a ≠ best}]
    (hbest : ∀ a, a ≠ best → μ a < μ best)
    (n : ℕ → A → ℕ) (K : ℝ) (hK : 0 < K)
    (hn : ∀ a, Tendsto (fun T : ℕ => (n T a : ℝ) / (T : ℝ)) atTop (𝓝 (1/K)))
    (hproper : ∀ᶠ T in atTop, (∀ a, 0 < n T a) ∧ (∀ a, n T a ≤ T)) :
    Tendsto (fun T => -Real.log (regret T μ best (n T)) / (T : ℝ)) atTop
      (𝓝 ((minimumGap μ best)^2 / (4*K))) := by
  have he := equal_allocation_error_limit μ best hbest n K hK hn hproper
  have hl := he.sub (tendsto_const_div_atTop_nhds_zero_nat (Real.log (maximumGap μ best)))
  have hu := he.sub (tendsto_const_div_atTop_nhds_zero_nat (Real.log (minimumGap μ best)))
  have hamin := minimumGap_pos μ best hbest
  have hamax := maximumGap_pos μ best hbest
  apply tendsto_of_tendsto_of_tendsto_of_le_of_le'
    (by simpa only [sub_zero] using hl) (by simpa only [sub_zero] using hu)
  · filter_upwards [equal_allocation_error_eventually_pos μ best n hproper,
      eventually_ge_atTop (1 : ℕ)] with T hp hT
    have hb := regret_error_bounds T μ best hbest (n T)
    have hrp := (mul_pos hamin hp).trans_le hb.1
    have hh := Real.log_le_log hrp hb.2
    rw [Real.log_mul hamax.ne' hp.ne'] at hh
    have hd := div_le_div_of_nonneg_right (neg_le_neg hh)
      (by positivity : 0 ≤ (T : ℝ))
    simpa only [neg_add, add_div, sub_eq_add_neg, neg_div, add_comm] using hd
  · filter_upwards [equal_allocation_error_eventually_pos μ best n hproper,
      eventually_ge_atTop (1 : ℕ)] with T hp hT
    have hb := regret_error_bounds T μ best hbest (n T)
    have hh := Real.log_le_log (mul_pos hamin hp) hb.1
    rw [Real.log_mul hamin.ne' hp.ne'] at hh
    have hd := div_le_div_of_nonneg_right (neg_le_neg hh)
      (by positivity : 0 ≤ (T : ℝ))
    simpa only [neg_add, add_div, sub_eq_add_neg, neg_div, add_comm] using hd

theorem equal_allocation_extended_rate_limit (μ : Means A) (best : A)
    [Nonempty {a : A // a ≠ best}]
    (hbest : ∀ a, a ≠ best → μ a < μ best)
    (n : ℕ → A → ℕ) (K : ℝ) (hK : 0 < K)
    (hn : ∀ a, Tendsto (fun T : ℕ => (n T a : ℝ) / (T : ℝ)) atTop (𝓝 (1/K)))
    (hproper : ∀ᶠ T in atTop, (∀ a, 0 < n T a) ∧ (∀ a, n T a ≤ T)) :
    Tendsto (BayesOptimal.RegretExponent.rate (fun T => regret T μ best (n T))) atTop
      (𝓝 (((minimumGap μ best)^2 / (4*K) : ℝ) : EReal)) := by
  have h := EReal.tendsto_coe.mpr (equal_allocation_regret_limit μ best hbest n K hK hn hproper)
  apply h.congr'
  filter_upwards [equal_allocation_error_eventually_pos μ best n hproper] with T hp
  have hrp := (mul_pos (minimumGap_pos μ best hbest) hp).trans_le
    (regret_error_bounds T μ best hbest (n T)).1
  simp only [BayesOptimal.RegretExponent.rate, if_neg hrp.ne']

end
end BayesOptimal.UniformSampling

end

/-! ## UniformSamplingRounding -/
section

set_option linter.unusedSectionVars false

open MeasureTheory ProbabilityTheory Set Filter
open scoped NNReal ENNReal Topology

namespace BayesOptimal.UniformSampling

noncomputable section

variable {A : Type*} [Fintype A] [Nonempty A]

/-- Exact balanced allocation: each arm gets floor(T/K), and the first
T mod K arms in the fixed enumeration get one additional observation. -/
def allocation (T : ℕ) (a : A) : ℕ :=
  T / Fintype.card A +
    if (Fintype.equivFin A a).val < T % Fintype.card A then 1 else 0

theorem allocation_bounds (T : ℕ) (a : A) :
    T / Fintype.card A ≤ allocation T a ∧
      allocation T a ≤ T / Fintype.card A + 1 := by
  unfold allocation
  split_ifs <;> omega

theorem allocation_sum (T : ℕ) : ∑ a : A, allocation T a = T := by
  classical
  let K := Fintype.card A
  have hK : 0 < K := Fintype.card_pos
  have hrem : T % K ≤ K := (Nat.mod_lt T hK).le
  have hcount : (∑ a : Fin K, if a.val < T % K then (1 : ℕ) else 0) = T % K := by
    have hc : (Finset.univ.filter (fun a : Fin K => a.val < T % K)).card = T % K := by
      simpa only [Fintype.card_subtype] using Fintype.card_fin_lt_of_le hrem
    simpa only [Finset.sum_ite, Finset.sum_const, nsmul_eq_mul, mul_one, mul_zero,
      add_zero] using hc
  have he : (∑ a : A, if (Fintype.equivFin A a).val < T % K then (1 : ℕ) else 0) =
      T % K := by
    exact (Equiv.sum_comp (Fintype.equivFin A)
      (fun a : Fin K => if a.val < T % K then (1 : ℕ) else 0)).trans hcount
  simp only [allocation, Finset.sum_add_distrib, Finset.sum_const, Finset.card_univ,
    nsmul_eq_mul]
  rw [he]
  exact Nat.div_add_mod T (Fintype.card A)

theorem allocation_positive (T : ℕ) (hT : Fintype.card A ≤ T) (a : A) :
    0 < allocation T a := by
  have hK : 0 < Fintype.card A := Fintype.card_pos
  exact (Nat.div_pos hT hK).trans_le (allocation_bounds T a).1

theorem allocation_le_budget (T : ℕ) (a : A) : allocation T a ≤ T := by
  calc
    allocation T a ≤ ∑ b : A, allocation T b :=
      Finset.single_le_sum (fun b _ => Nat.zero_le (allocation T b)) (Finset.mem_univ a)
    _ = T := allocation_sum T

theorem allocation_proportion (a : A) :
    Tendsto (fun T : ℕ => (allocation T a : ℝ) / (T : ℝ)) atTop
      (𝓝 (1 / (Fintype.card A : ℝ))) := by
  let K : ℝ := Fintype.card A
  have hK : 0 < K := by
    dsimp [K]
    exact_mod_cast (Fintype.card_pos : 0 < Fintype.card A)
  have hlo : Tendsto (fun T : ℕ => 1/K - 1/(T : ℝ)) atTop (𝓝 (1/K)) := by
    simpa using tendsto_const_nhds.sub (tendsto_const_div_atTop_nhds_zero_nat (1 : ℝ))
  have hhi : Tendsto (fun T : ℕ => 1/K + 1/(T : ℝ)) atTop (𝓝 (1/K)) := by
    simpa using tendsto_const_nhds.add (tendsto_const_div_atTop_nhds_zero_nat (1 : ℝ))
  have hbounds (T : ℕ) : (T : ℝ) - K ≤ (allocation T a : ℝ) * K ∧
      (allocation T a : ℝ) * K ≤ (T : ℝ) + K := by
    have he : (T : ℝ) = (T / Fintype.card A : ℕ) * K +
        (T % Fintype.card A : ℕ) := by
      dsimp [K]
      exact_mod_cast (show T = (T / Fintype.card A) * Fintype.card A +
        T % Fintype.card A by
          simpa only [Nat.mul_comm] using (Nat.div_add_mod T (Fintype.card A)).symm)
    have hr : (T % Fintype.card A : ℕ) < K := by
      dsimp [K]
      exact_mod_cast Nat.mod_lt T (Fintype.card_pos : 0 < Fintype.card A)
    have hr0 : (0 : ℝ) ≤ (T % Fintype.card A : ℕ) := by positivity
    have hl : (T / Fintype.card A : ℕ) ≤ (allocation T a : ℝ) := by
      exact_mod_cast (allocation_bounds T a).1
    have hu : (allocation T a : ℝ) ≤ (T / Fintype.card A : ℕ) + 1 := by
      exact_mod_cast (allocation_bounds T a).2
    constructor <;> nlinarith
  apply tendsto_of_tendsto_of_tendsto_of_le_of_le' hlo hhi
  · filter_upwards [eventually_ge_atTop (1 : ℕ)] with T hT
    have hTp : 0 < (T : ℝ) := by exact_mod_cast (by omega : 0 < T)
    apply (le_div_iff₀ hTp).mpr
    have hb := (hbounds T).1
    field_simp [hK.ne', hTp.ne']
    nlinarith
  · filter_upwards [eventually_ge_atTop (1 : ℕ)] with T hT
    have hTp : 0 < (T : ℝ) := by exact_mod_cast (by omega : 0 < T)
    apply (div_le_iff₀ hTp).mpr
    have hb := (hbounds T).2
    field_simp [hK.ne', hTp.ne']
    nlinarith

end
end BayesOptimal.UniformSampling

end

/-! ## UniformSampling -/
section

open MeasureTheory ProbabilityTheory Set Filter
open scoped NNReal ENNReal Topology

namespace BayesOptimal.UniformSampling

open BayesOptimal.FiniteGaussian BayesOptimal.ProseCorollaries

noncomputable section

variable {A : Type*} [Fintype A] [Nonempty A] [DecidableEq A]
variable [MeasurableSpace A] [MeasurableSingletonClass A]

omit [DecidableEq A] [MeasurableSpace A] [MeasurableSingletonClass A] in
theorem allocation_eventually_proper :
    ∀ᶠ T : ℕ in atTop,
      (∀ a : A, 0 < allocation T a) ∧ (∀ a : A, allocation T a ≤ T) := by
  filter_upwards [eventually_ge_atTop (Fintype.card A)] with T hT
  exact ⟨allocation_positive T hT, allocation_le_budget T⟩

/-- The manuscript's uniform-sampling frequentist exponent, with the
allocation rounding made explicit and the actual empirical recommendation.
This is a full limit, which in particular certifies the paper's liminf. -/
theorem uniform_frequentist_rate_limit (μ : Means A) (best : A)
    [Nonempty {a : A // a ≠ best}]
    (hbest : ∀ a, a ≠ best → μ a < μ best) :
    Tendsto (BayesOptimal.RegretExponent.rate (fun T => regret T μ best (allocation T))) atTop
      (𝓝 (((minimumGap μ best)^2 / (4 * (Fintype.card A : ℝ)) : ℝ) : EReal)) := by
  exact equal_allocation_extended_rate_limit μ best hbest allocation (Fintype.card A)
    (by exact_mod_cast (Fintype.card_pos : 0 < Fintype.card A))
    allocation_proportion allocation_eventually_proper

theorem uniform_frequentist_rate (μ : Means A) (best : A)
    [Nonempty {a : A // a ≠ best}]
    (hbest : ∀ a, a ≠ best → μ a < μ best) :
    liminf (BayesOptimal.RegretExponent.rate (fun T => regret T μ best (allocation T))) atTop =
      (((minimumGap μ best)^2 / (4 * (Fintype.card A : ℝ)) : ℝ) : EReal) :=
  (uniform_frequentist_rate_limit μ best hbest).liminf_eq

theorem uniform_error_log_limit (μ : Means A) (best : A)
    [Nonempty {a : A // a ≠ best}]
    (hbest : ∀ a, a ≠ best → μ a < μ best) :
    Tendsto (fun T => -Real.log (error T μ best (allocation T)) / (T : ℝ)) atTop
      (𝓝 ((minimumGap μ best)^2 / (4 * (Fintype.card A : ℝ)))) := by
  exact equal_allocation_error_limit μ best hbest allocation (Fintype.card A)
    (by exact_mod_cast (Fintype.card_pos : 0 < Fintype.card A))
    allocation_proportion allocation_eventually_proper

end
end BayesOptimal.UniformSampling

end

/-! ## UniformSamplingObservation -/
section

set_option linter.unusedSectionVars false

open MeasureTheory ProbabilityTheory Set Filter
open scoped NNReal ENNReal Topology

namespace BayesOptimal.UniformSampling

open BayesOptimal.FiniteGaussian BayesOptimal.FiniteModelMeasurable

noncomputable section

variable {A : Type*} [Fintype A] [Nonempty A] [DecidableEq A]
variable [MeasurableSpace A] [MeasurableSingletonClass A]

/-- The actual reward array. The centered array is a probability-space
representation, while an implemented algorithm sees these shifted rewards. -/
def observedRewards {T : ℕ} (μ : Means A) (x : Arrays A T) : Arrays A T :=
  fun a j => μ a + x a j

def observedEmpirical {T : ℕ} (n : A → ℕ) (r : Arrays A T) : Means A :=
  fun a => BayesOptimal.Foundations.BadEvent.sampleMean (n a) (r a)

/-- This decision rule has no true-mean argument: it takes averages of the
observed rewards and returns the fixed Borel empirical maximizer. -/
def observedRecommendation {T : ℕ} (n : A → ℕ) (r : Arrays A T) : A :=
  firstMax (observedEmpirical n r)

theorem observedRewards_measurable (T : ℕ) (μ : Means A) :
    Measurable (observedRewards (T := T) μ) := by
  unfold observedRewards
  fun_prop

theorem observedEmpirical_measurable (T : ℕ) (n : A → ℕ) :
    Measurable (observedEmpirical (T := T) n) := by
  apply measurable_pi_lambda
  intro a
  exact (BayesOptimal.Foundations.FrequentistModel.sampleMean_continuous T (n a)).measurable.comp
    (measurable_pi_apply a)

theorem observedRecommendation_measurable (T : ℕ) (n : A → ℕ) :
    Measurable (observedRecommendation (T := T) n) :=
  firstMax_measurable.comp (observedEmpirical_measurable T n)

theorem meanCoefficient_sum (T n : ℕ) (hn : 0 < n) (hnT : n ≤ T) :
    (∑ j : Fin T, BayesOptimal.Foundations.BadEvent.meanCoefficient n j) = 1 := by
  have hnR : (n : ℝ) ≠ 0 := by exact_mod_cast (ne_of_gt hn)
  unfold BayesOptimal.Foundations.BadEvent.meanCoefficient
  rw [BayesOptimal.Foundations.BadEvent.fin_sum_if_lt n T hnT]
  simp only [mul_zero, add_zero, mul_inv_cancel₀ hnR]

/-- The empirical statistic used in the exponent proof is literally the
average of the observed rewards, whenever the allocated count is positive. -/
theorem observedEmpirical_eq_empirical (T : ℕ) (μ : Means A) (n : A → ℕ)
    (hn : ∀ a, 0 < n a) (hnT : ∀ a, n a ≤ T) (x : Arrays A T) :
    observedEmpirical n (observedRewards μ x) = empirical μ n x := by
  funext a
  unfold observedEmpirical observedRewards empirical BayesOptimal.Foundations.BadEvent.sampleMean
    BayesOptimal.Foundations.BadEvent.weightedSum
  simp only [mul_add, Finset.sum_add_distrib, ← Finset.sum_mul,
    meanCoefficient_sum T (n a) (hn a) (hnT a), one_mul]

/-- Pointwise equality connects the parameter-independent observed-data
algorithm to the actual Gaussian-world recommendation used by every limit. -/
theorem observedRecommendation_eq (T : ℕ) (μ : Means A) (n : A → ℕ)
    (hn : ∀ a, 0 < n a) (hnT : ∀ a, n a ≤ T) (x : Arrays A T) :
    observedRecommendation n (observedRewards μ x) = recommendation μ n x := by
  unfold observedRecommendation recommendation
  rw [observedEmpirical_eq_empirical T μ n hn hnT x]

def observedLaw (T : ℕ) (μ : Means A) : Measure (Arrays A T) :=
  (law T).map (observedRewards μ)

instance observedLaw_probability (T : ℕ) (μ : Means A) :
    IsProbabilityMeasure (observedLaw T μ) :=
  MeasureTheory.Measure.isProbabilityMeasure_map (observedRewards_measurable T μ).aemeasurable

def observedRegret (T : ℕ) (μ : Means A) (best : A) (n : A → ℕ) : ℝ :=
  ∫ r, μ best - μ (observedRecommendation n r) ∂observedLaw T μ

/-- Exact equality of actual observed-data risk and the centered-array
representation; no distribution or model-equivalence hypothesis is assumed. -/
theorem observedRegret_eq (T : ℕ) (μ : Means A) (best : A) (n : A → ℕ)
    (hn : ∀ a, 0 < n a) (hnT : ∀ a, n a ≤ T) :
    observedRegret T μ best n = regret T μ best n := by
  have hm : Measurable (fun r : Arrays A T => μ best - μ (observedRecommendation n r)) :=
    measurable_const.sub ((measurable_of_countable μ).comp
      (observedRecommendation_measurable T n))
  unfold observedRegret observedLaw
  rw [integral_map (observedRewards_measurable T μ).aemeasurable hm.aestronglyMeasurable]
  simp only [observedRecommendation_eq T μ n hn hnT, regret]

/-- The uniform rate statement for a rule whose computational inputs are
only raw observed rewards and the deterministic rounded allocation. -/
theorem observed_uniform_frequentist_rate_limit (μ : Means A) (best : A)
    [Nonempty {a : A // a ≠ best}]
    (hbest : ∀ a, a ≠ best → μ a < μ best) :
    Tendsto (BayesOptimal.RegretExponent.rate
      (fun T => observedRegret T μ best (allocation T))) atTop
      (𝓝 (((BayesOptimal.ProseCorollaries.minimumGap μ best)^2 /
        (4 * (Fintype.card A : ℝ)) : ℝ) : EReal)) := by
  apply (uniform_frequentist_rate_limit μ best hbest).congr'
  filter_upwards [allocation_eventually_proper (A := A)] with T hT
  simp only [BayesOptimal.RegretExponent.rate, observedRegret_eq T μ best (allocation T) hT.1 hT.2]

theorem observed_uniform_frequentist_rate (μ : Means A) (best : A)
    [Nonempty {a : A // a ≠ best}]
    (hbest : ∀ a, a ≠ best → μ a < μ best) :
    liminf (BayesOptimal.RegretExponent.rate
      (fun T => observedRegret T μ best (allocation T))) atTop =
      (((BayesOptimal.ProseCorollaries.minimumGap μ best)^2 /
        (4 * (Fintype.card A : ℝ)) : ℝ) : EReal) :=
  (observed_uniform_frequentist_rate_limit μ best hbest).liminf_eq

end
end BayesOptimal.UniformSampling

