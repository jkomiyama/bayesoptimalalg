/-! ## ExclusionVarianceComparison -/
section

open MeasureTheory ProbabilityTheory
open scoped NNReal ENNReal

namespace BayesOptimal.ExclusionVarianceComparison

noncomputable section

open BayesOptimal.Foundations.Gaussian BayesOptimal.Foundations.BayesianModel BayesOptimal.Exclusion

theorem hingeLoss_antitone_center (v : ℝ≥0) : Antitone (fun a : ℝ => hingeLoss a v) := by
  intro a b hab
  apply integral_mono (hinge_integrable b v) (hinge_integrable a v)
  intro x
  exact max_le_max (by linarith) le_rfl

theorem hingeLoss_mono_variance (a : ℝ) (ha : 0 ≤ a) {v w : ℝ≥0} (hvw : v ≤ w) :
    hingeLoss a v ≤ hingeLoss a w := by
  rcases eq_or_lt_of_le hvw with h | h
  · rw [h]
  · exact (hingeLoss_strictMono_variance a ha v w h).le

/-- Exact positive-part comparison used in the printed Lemma 11 proof:
the means are ordered and the posterior variances are at most one. -/
theorem pair_comparison (c : Counts) (m : Means) (i j : Arm)
    (upper lower : ℝ) (hgap : upper ≤ lower)
    (hi : m i ≤ upper) (hj : lower ≤ m j)
    (hci : 1 ≤ c i) (hcj : 1 ≤ c j) :
    pairSlack c m i j ≤ hingeLoss (lower - upper) 2 := by
  have hcent : lower - upper ≤ m j - m i := by linarith
  have hvar : (c i : ℝ≥0)⁻¹ + (c j : ℝ≥0)⁻¹ ≤ 2 := by
    exact_mod_cast BayesOptimal.ExclusionBounds.variance_le_two_counts _ _ hci hcj
  exact (hingeLoss_antitone_center _ hcent).trans
    (hingeLoss_mono_variance _ (by linarith) hvar)

theorem independent_unit_positivePart (upper lower : ℝ) :
    (∫ x : ℝ, ∫ y : ℝ, max ((upper + x) - (lower + y)) 0
      ∂gaussianReal 0 1 ∂gaussianReal 0 1) = hingeLoss (lower - upper) 2 := by
  have h := positive_pair_double_integral upper lower 1 1
  norm_num at h
  exact h

/-- The displayed R^(3) ≤ 2 E[(x-y)+] inequality, with the independent
N(upper,1), N(lower,1) variables realized by translated standard Gaussians. -/
theorem lemma11_independent_comparison (c : Counts) (m : Means) (upper lower : ℝ)
    (hgap : upper ≤ lower) (h3 : m 2 ≤ upper) (h1 : lower ≤ m 0) (h2 : lower ≤ m 1)
    (hc : ∀ a, 1 ≤ c a) :
    exclusion c m 2 ≤ 2 * (∫ x : ℝ, ∫ y : ℝ,
      max ((upper + x) - (lower + y)) 0 ∂gaussianReal 0 1 ∂gaussianReal 0 1) := by
  rw [independent_unit_positivePart]
  have hleft := pair_comparison c m 2 0 upper lower hgap h3 h1 (hc 2) (hc 0)
  have hright := pair_comparison c m 2 1 upper lower hgap h3 h2 (hc 2) (hc 1)
  have hsum := exclusion_third_le_pairSlacks c m
  linarith

end
end BayesOptimal.ExclusionVarianceComparison

end

/-! ## FixedGaussianAbsoluteContinuous -/
section

set_option linter.unusedSectionVars false

open MeasureTheory ProbabilityTheory
open scoped NNReal ENNReal

namespace BayesOptimal.FixedGaussian

noncomputable section

theorem fin_pi_absolutelyContinuous {B : Type*} [MeasurableSpace B] (n : ℕ)
    (μ ν : Fin n → Measure B) [∀ i, SigmaFinite (μ i)] [∀ i, SigmaFinite (ν i)]
    (h : ∀ i, μ i ≪ ν i) : Measure.pi μ ≪ Measure.pi ν := by
  induction n with
  | zero =>
      rw [Measure.pi_of_empty μ, Measure.pi_of_empty ν]
  | succ n ih =>
      let e := MeasurableEquiv.piFinSuccAbove (fun _ : Fin (n + 1) => B)
        ⟨0, Nat.zero_lt_succ n⟩
      have hμ := measurePreserving_piFinSuccAbove μ ⟨0, Nat.zero_lt_succ n⟩
      have hν := measurePreserving_piFinSuccAbove ν ⟨0, Nat.zero_lt_succ n⟩
      have hrest := ih (fun j => μ ((⟨0, Nat.zero_lt_succ n⟩ : Fin (n + 1)).succAbove j))
        (fun j => ν ((⟨0, Nat.zero_lt_succ n⟩ : Fin (n + 1)).succAbove j))
        (fun j => h _)
      have hp := ((h ⟨0, Nat.zero_lt_succ n⟩).prod hrest).map e.symm.measurable
      simpa only [(hμ.symm e).map_eq, (hν.symm e).map_eq] using hp

theorem finite_pi_absolutelyContinuous {I B : Type*} [Fintype I] [MeasurableSpace B]
    (μ ν : I → Measure B) [∀ i, SigmaFinite (μ i)] [∀ i, SigmaFinite (ν i)]
    (h : ∀ i, μ i ≪ ν i) : Measure.pi μ ≪ Measure.pi ν := by
  let e := Fintype.equivFin I
  have hf := fin_pi_absolutelyContinuous (Fintype.card I)
    (fun j => μ (e.symm j)) (fun j => ν (e.symm j)) (fun j => h _)
  have hm := hf.map (MeasurableEquiv.piCongrLeft (fun _ : I => B) e.symm).measurable
  simpa only [Measure.pi_map_piCongrLeft] using hm

theorem gaussian_unit_equivalent (x y : ℝ) :
    gaussianReal x 1 ≪ gaussianReal y 1 ∧ gaussianReal y 1 ≪ gaussianReal x 1 := by
  constructor
  · exact (gaussianReal_absolutelyContinuous x one_ne_zero).trans
      (gaussianReal_absolutelyContinuous' y one_ne_zero)
  · exact (gaussianReal_absolutelyContinuous y one_ne_zero).trans
      (gaussianReal_absolutelyContinuous' x one_ne_zero)

end
end BayesOptimal.FixedGaussian

end

/-! ## FixedGaussianLaws -/
section

set_option linter.unusedSectionVars false

open MeasureTheory ProbabilityTheory
open scoped NNReal ENNReal

namespace BayesOptimal.FixedGaussian

open FiniteGaussian FinitePosterior EmbeddingRaw EmbeddingExecution

variable {A : Type*} [Fintype A] [Nonempty A] [DecidableEq A]

noncomputable section

/-- All calendar-indexed observations under a fixed true mean vector.  Reading
only the coordinates selected by an adaptive policy is a measurable map. -/
def fixedLaw (H : ℕ) (μ : Means A) : Measure (RawStream A H) :=
  Measure.pi (fun a : A => Measure.pi (fun _ : Fin H => gaussianReal (μ a) 1))

instance fixedLaw_probability (H : ℕ) (μ : Means A) :
    IsProbabilityMeasure (fixedLaw H μ) := by unfold fixedLaw; infer_instance

/-- The actual predictive reward array, including its within-arm correlation
through the shared Gaussian latent mean. -/
def predictiveLaw (H : ℕ) (c : Precisions A) (m : Means A) : Measure (RawStream A H) :=
  (worldLaw H c m).map observations

instance predictiveLaw_probability (H : ℕ) (c : Precisions A) (m : Means A) :
    IsProbabilityMeasure (predictiveLaw H c m) :=
  Measure.isProbabilityMeasure_map (observations_measurable H).aemeasurable

theorem shift_noise_preserving (H : ℕ) (μ : Means A) :
    MeasurePreserving (fun e : RawStream A H => fun a t => μ a + e a t)
      (arrayLaw H) (fixedLaw H μ) := by
  unfold arrayLaw fixedLaw
  apply measurePreserving_pi (fun _ : A => MockStream.noiseLaw H)
    (fun a : A => Measure.pi (fun _ : Fin H => gaussianReal (μ a) 1))
    (f := fun a e t => μ a + e t)
  intro a
  unfold MockStream.noiseLaw
  apply measurePreserving_pi (fun _ : Fin H => gaussianReal 0 1)
    (fun _ : Fin H => gaussianReal (μ a) 1) (f := fun _ e => μ a + e)
  intro t
  refine ⟨by fun_prop, ?_⟩
  simpa only [zero_add] using gaussianReal_map_const_add (μ := 0) (v := 1) (μ a)

theorem fixed_equivalent (H : ℕ) (μ ν : Means A) :
    fixedLaw H μ ≪ fixedLaw H ν ∧ fixedLaw H ν ≪ fixedLaw H μ := by
  constructor
  · apply finite_pi_absolutelyContinuous
    intro a
    apply finite_pi_absolutelyContinuous
    intro t
    exact (gaussian_unit_equivalent (μ a) (ν a)).1
  · apply finite_pi_absolutelyContinuous
    intro a
    apply finite_pi_absolutelyContinuous
    intro t
    exact (gaussian_unit_equivalent (μ a) (ν a)).2

theorem predictive_absolutelyContinuous_fixed (H : ℕ)
    (c : Precisions A) (m μ : Means A) : predictiveLaw H c m ≪ fixedLaw H μ := by
  apply Measure.AbsolutelyContinuous.mk
  intro s hs hzero
  rw [predictiveLaw, Measure.map_apply (observations_measurable H) hs]
  unfold worldLaw
  apply Measure.measure_prod_null_of_ae_null ((observations_measurable H) hs)
  apply Filter.Eventually.of_forall
  intro θ
  have hz := (fixed_equivalent H θ μ).1 hzero
  rw [← (shift_noise_preserving H θ).map_eq,
    Measure.map_apply (shift_noise_preserving H θ).measurable hs] at hz
  exact hz

theorem fixed_absolutelyContinuous_predictive (H : ℕ)
    (c : Precisions A) (m μ : Means A) : fixedLaw H μ ≪ predictiveLaw H c m := by
  apply Measure.AbsolutelyContinuous.mk
  intro s hs hzero
  rw [predictiveLaw, Measure.map_apply (observations_measurable H) hs] at hzero
  change (posteriorLaw c m).prod (arrayLaw H) (observations ⁻¹' s) = 0 at hzero
  have hsections := Measure.measure_ae_null_of_prod_null hzero
  obtain ⟨θ, hθ⟩ := hsections.exists
  have hz : fixedLaw H θ s = 0 := by
    rw [← (shift_noise_preserving H θ).map_eq,
      Measure.map_apply (shift_noise_preserving H θ).measurable hs]
    exact hθ
  exact (fixed_equivalent H μ θ).1 hz

theorem fixed_predictive_equivalent (H : ℕ) (c : Precisions A) (m μ : Means A) :
    fixedLaw H μ ≪ predictiveLaw H c m ∧ predictiveLaw H c m ≪ fixedLaw H μ :=
  ⟨fixed_absolutelyContinuous_predictive H c m μ,
    predictive_absolutelyContinuous_fixed H c m μ⟩

end
end BayesOptimal.FixedGaussian

end

/-! ## FixedGaussianTransfer -/
section

set_option linter.unusedSectionVars false

open MeasureTheory ProbabilityTheory
open scoped NNReal ENNReal

namespace BayesOptimal.FixedGaussian

open FiniteGaussian FinitePosterior EmbeddingRaw EmbeddingExecution

variable {A : Type*} [Fintype A] [Nonempty A] [DecidableEq A]

noncomputable section

/-- Independent randomization preserves finite-horizon equivalence.  The same
seed law is used under the predictive model and every fixed true mean. -/
theorem seeded_fixed_predictive_equivalent {S : Type*} [MeasurableSpace S]
    (σ : Measure S) (H : ℕ) (c : Precisions A) (m μ : Means A) :
    σ.prod (fixedLaw H μ) ≪ σ.prod (predictiveLaw H c m) ∧
      σ.prod (predictiveLaw H c m) ≪ σ.prod (fixedLaw H μ) := by
  constructor
  · exact Measure.AbsolutelyContinuous.rfl.prod (fixed_predictive_equivalent H c m μ).1
  · exact Measure.AbsolutelyContinuous.rfl.prod (fixed_predictive_equivalent H c m μ).2

/-- In particular, any measurable adaptive transcript or recommendation map
has the same null events under the two models.  The map is literally the same
function, so it cannot depend on the unknown true mean. -/
theorem adaptive_map_equivalent {S B : Type*} [MeasurableSpace S] [MeasurableSpace B]
    (σ : Measure S) (H : ℕ) (c : Precisions A) (m μ : Means A)
    (f : S × RawStream A H → B) (hf : Measurable f) :
    (σ.prod (fixedLaw H μ)).map f ≪ (σ.prod (predictiveLaw H c m)).map f ∧
      (σ.prod (predictiveLaw H c m)).map f ≪ (σ.prod (fixedLaw H μ)).map f := by
  exact ⟨((seeded_fixed_predictive_equivalent σ H c m μ).1).map hf,
    ((seeded_fixed_predictive_equivalent σ H c m μ).2).map hf⟩

theorem seeded_world_observations_preserving {S : Type*} [MeasurableSpace S]
    (σ : Measure S) [SFinite σ] (H : ℕ) (c : Precisions A) (m : Means A) :
    MeasurePreserving (fun p : S × (Means A × RawStream A H) =>
      (p.1, observations p.2)) (σ.prod (worldLaw H c m))
        (σ.prod (predictiveLaw H c m)) := by
  exact (MeasurePreserving.id σ).prod ⟨observations_measurable H, rfl⟩

/-- A predictive almost-everywhere statement about the actual execution
transfers to every fixed-parameter experiment. -/
theorem ae_execution_transfer {S : Type*} [MeasurableSpace S]
    (σ : Measure S) [SFinite σ] (H : ℕ) (c : Precisions A) (m μ : Means A)
    (P : S × RawStream A H → Prop) (hP : MeasurableSet {p | P p})
    (h : ∀ᵐ p ∂σ.prod (worldLaw H c m), P (p.1, observations p.2)) :
    ∀ᵐ p ∂σ.prod (fixedLaw H μ), P p := by
  have hp := seeded_world_observations_preserving σ H c m
  have he : ∀ᵐ p ∂σ.prod (predictiveLaw H c m), P p := by
    rw [← hp.map_eq]
    exact (ae_map_iff hp.measurable.aemeasurable hP).2 h
  exact (seeded_fixed_predictive_equivalent σ H c m μ).1.ae_le he

/-- Null-history modification therefore preserves the full recommendation
law for every fixed true mean, once predictive execution agreement is proved. -/
theorem recommendation_law_eq {S B : Type*} [MeasurableSpace S] [MeasurableSpace B]
    [Countable B] [MeasurableSingletonClass B]
    (σ : Measure S) [SFinite σ] (H : ℕ) (c : Precisions A) (m μ : Means A)
    (f g : S × RawStream A H → B) (hf : Measurable f) (hg : Measurable g)
    (h : ∀ᵐ p ∂σ.prod (worldLaw H c m),
      f (p.1, observations p.2) = g (p.1, observations p.2)) :
    (σ.prod (fixedLaw H μ)).map f = (σ.prod (fixedLaw H μ)).map g := by
  exact Measure.map_congr (ae_execution_transfer σ H c m μ
    (fun p => f p = g p) (measurableSet_eq_fun_of_countable hf hg) h)

/-- Equality is stronger than equality of regret: every integrable measurable
payoff of the recommendation agrees, including fixed-parameter simple regret. -/
theorem recommendation_payoff_integral_eq {S B : Type*} [MeasurableSpace S]
    [MeasurableSpace B] [Countable B] [MeasurableSingletonClass B]
    (σ : Measure S) [SFinite σ] (H : ℕ) (c : Precisions A) (m μ : Means A)
    (f g : S × RawStream A H → B) (hf : Measurable f) (hg : Measurable g)
    (h : ∀ᵐ p ∂σ.prod (worldLaw H c m),
      f (p.1, observations p.2) = g (p.1, observations p.2)) (L : B → ℝ) :
    (∫ p, L (f p) ∂σ.prod (fixedLaw H μ)) =
      ∫ p, L (g p) ∂σ.prod (fixedLaw H μ) := by
  apply integral_congr_ae
  exact (ae_execution_transfer σ H c m μ
    (fun p => f p = g p) (measurableSet_eq_fun_of_countable hf hg) h).mono
      (fun _ hp => congrArg L hp)

end
end BayesOptimal.FixedGaussian

end

/-! ## PolicyContinuation -/
section

open MeasureTheory ProbabilityTheory

namespace BayesOptimal.PolicyContinuation

open BayesOptimal.Foundations.BayesianModel BayesOptimal.FiniteGaussian BayesOptimal.EmbeddingRaw
open BayesOptimal.EmbeddingExecution

noncomputable section

abbrev Seeds (H : ℕ) := Fin (H + 1) → ℝ

def seedTail {H : ℕ} (u : Seeds (H + 1)) : Seeds H := fun j => u j.succ

/-- The actual raw-observation continuation of a posterior-state policy.
The final seed is used for the terminal recommendation. -/
def rawTree (π : BayesOptimal.Policy.StatePolicy) (t : ℕ) : (H : ℕ) →
    Counts → BayesOptimal.Foundations.BayesianModel.Means → Seeds H →
    BayesOptimal.FiniteGaussian.Strategy (A := Arm) H
  | 0, c, m, u => .stop (π.recommend c m (u ⟨0, by omega⟩))
  | H + 1, c, m, u =>
      let a := π.draw t c m (u ⟨0, by omega⟩)
      .sample a (fun y =>
        let z := (y - m a) / ((c a : ℝ) + 1)
        rawTree π (t + 1) H (BayesOptimal.Foundations.BayesianModel.advance c a)
          (BayesOptimal.Foundations.BayesianModel.shift m a z) (seedTail u))

theorem rawTree_zero (π : BayesOptimal.Policy.StatePolicy) (t : ℕ)
    (c : Counts) (m : BayesOptimal.Foundations.BayesianModel.Means) (u : Seeds 0) :
    rawTree π t 0 c m u = .stop (π.recommend c m (u ⟨0, by omega⟩)) := rfl

theorem rawTree_succ (π : BayesOptimal.Policy.StatePolicy) (t H : ℕ)
    (c : Counts) (m : BayesOptimal.Foundations.BayesianModel.Means) (u : Seeds (H + 1)) :
    rawTree π t (H + 1) c m u =
      .sample (π.draw t c m (u ⟨0, by omega⟩)) (fun y =>
        let a := π.draw t c m (u ⟨0, by omega⟩)
        let z := (y - m a) / ((c a : ℝ) + 1)
        rawTree π (t + 1) H (BayesOptimal.Foundations.BayesianModel.advance c a)
          (BayesOptimal.Foundations.BayesianModel.shift m a z) (seedTail u)) := rfl

abbrev Input (H : ℕ) := BayesOptimal.Foundations.BayesianModel.Means × (Seeds H × RawStream Arm H)

/-- Joint Borel measurability includes the starting means, every independent
policy seed, and every raw reward coordinate. -/
theorem rawTree_run_measurable (π : BayesOptimal.Policy.StatePolicy) (t H : ℕ) (c : Counts) :
    Measurable (fun p : Input H => run (rawTree π t H c p.1 p.2.1) p.2.2) := by
  induction H generalizing t c with
  | zero =>
      have hin : Measurable (fun p : Input 0 =>
          (c, p.1, p.2.1 (⟨0, by omega⟩ : Fin 1))) :=
        measurable_const.prodMk (measurable_fst.prodMk
          ((measurable_pi_apply (⟨0, by omega⟩ : Fin 1)).comp
            (measurable_fst.comp measurable_snd)))
      exact π.recommend_measurable.comp hin
  | succ H ih =>
      let g : Input (H + 1) × Arm → Arm := fun p =>
        run (rawTree π (t + 1) H (BayesOptimal.Foundations.BayesianModel.advance c p.2)
          (BayesOptimal.Foundations.BayesianModel.shift p.1.1 p.2
            ((p.1.2.2 p.2 ⟨0, by omega⟩ - p.1.1 p.2) / ((c p.2 : ℝ) + 1)))
          (seedTail p.1.2.1)) (tail p.1.2.2)
      have hg : Measurable g := by
        apply measurable_from_prod_countable_left
        intro a
        have hin : Measurable (fun p : Input (H + 1) =>
            (BayesOptimal.Foundations.BayesianModel.shift p.1 a
              ((p.2.2 a ⟨0, by omega⟩ - p.1 a) / ((c a : ℝ) + 1)),
                (seedTail p.2.1, tail p.2.2))) := by
          apply Measurable.prodMk
          · apply measurable_pi_lambda
            intro b
            simp only [BayesOptimal.Foundations.BayesianModel.shift]
            split_ifs <;> fun_prop
          · unfold seedTail tail
            fun_prop
        exact (ih (t + 1) (BayesOptimal.Foundations.BayesianModel.advance c a)).comp hin
      have hdraw : Measurable (fun p : Input (H + 1) =>
          π.draw t c p.1 (p.2.1 ⟨0, by omega⟩)) := by
        have hin : Measurable (fun p : Input (H + 1) =>
            (c, p.1, p.2.1 (⟨0, by omega⟩ : Fin (H + 2)))) :=
          measurable_const.prodMk (measurable_fst.prodMk
            ((measurable_pi_apply (⟨0, by omega⟩ : Fin (H + 2))).comp
              (measurable_fst.comp measurable_snd)))
        exact (π.draw_measurable t).comp hin
      exact hg.comp (measurable_id.prodMk hdraw)

/-- Every fixed-seed continuation is a regular raw-history tree; this is
proved from the policy's Borel decision maps. -/
theorem rawTree_regular (π : BayesOptimal.Policy.StatePolicy) (t H : ℕ)
    (c : Counts) (m : BayesOptimal.Foundations.BayesianModel.Means) (u : Seeds H) :
    Regular (rawTree π t H c m u) := by
  induction H generalizing t c m with
  | zero => trivial
  | succ H ih =>
      constructor
      · intro y
        exact ih (t + 1) _ _ (seedTail u)
      · let a := π.draw t c m (u ⟨0, by omega⟩)
        have hin : Measurable (fun p : ℝ × RawStream Arm H =>
            (BayesOptimal.Foundations.BayesianModel.shift m a ((p.1 - m a) / ((c a : ℝ) + 1)),
              (seedTail u, p.2))) := by
          apply Measurable.prodMk
          · apply measurable_pi_lambda
            intro b
            simp only [BayesOptimal.Foundations.BayesianModel.shift]
            split_ifs <;> fun_prop
          · exact measurable_const.prodMk measurable_snd
        exact (rawTree_run_measurable π (t + 1) H
          (BayesOptimal.Foundations.BayesianModel.advance c a)).comp hin

theorem rawTree_budget (π : BayesOptimal.Policy.StatePolicy) (t H : ℕ)
    (c : Counts) (m : BayesOptimal.Foundations.BayesianModel.Means) (u : Seeds H) (r : RawStream Arm H) :
    (trace (rawTree π t H c m u) r).length = H := trace_budget _ _

end
end BayesOptimal.PolicyContinuation

end

/-! ## PolicyContinuationOptimal -/
section

open MeasureTheory ProbabilityTheory
open scoped NNReal ENNReal

namespace BayesOptimal.PolicyContinuationOptimal

open BayesOptimal.Foundations.BayesianModel
open BayesOptimal.Policy BayesOptimal.PolicyContinuation BayesOptimal.CountModelBridge
open BayesOptimal.EmbeddingRaw BayesOptimal.EmbeddingExecution

noncomputable section

/-- The concrete Bellman posterior-state policy realizes the actual Gaussian
Bayes risk, for every fixed external seed array. The statement concerns its
raw-observation execution, not a stipulated Bellman utility. -/
theorem deterministicBellman_rawRisk (T t H : ℕ) (c : Counts) (m : Means)
    (u : Seeds H) (horizon : t + H = T + 1) (hc : ∀ a, 0 < c a) :
    rawRisk (rawTree (deterministicBellman T) t H c m u) (natPrecisions c) m =
      BayesOptimal.FinitePosterior.loss H (natPrecisions c) m := by
  induction H generalizing t c m with
  | zero =>
      rw [rawTree_zero, rawRisk_zero, BayesOptimal.FinitePosterior.terminalRegret_eq]
      change BayesOptimal.FinitePosterior.potential (natPrecisions c) m -
          m (BayesOptimal.Foundations.BayesianModel.recommend m) =
        BayesOptimal.FinitePosterior.potential (natPrecisions c) m -
          BayesOptimal.FiniteGaussian.maxAll m
      rw [BayesOptimal.Foundations.BayesianModel.recommend_max m, maxAll_eq_terminal m]
  | succ H ih =>
      have hremaining : T - t = H := by omega
      let a := BayesOptimal.Foundations.BayesianModel.choose H c m
      let next : ℝ → BayesOptimal.FiniteGaussian.Strategy (A := Arm) H := fun y =>
        rawTree (deterministicBellman T) (t + 1) H
          (BayesOptimal.Foundations.BayesianModel.advance c a)
          (BayesOptimal.Foundations.BayesianModel.shift m a ((y - m a) / ((c a : ℝ) + 1))) (seedTail u)
      have htree : rawTree (deterministicBellman T) t (H + 1) c m u =
          .sample a next := by
        simp only [rawTree, deterministicBellman, hremaining]
        rfl
      have hreg : Regular (.sample a next) := by
        rw [← htree]
        exact rawTree_regular (deterministicBellman T) t (H + 1) c m u
      have hca : ∀ b, 0 < BayesOptimal.Foundations.BayesianModel.advance c a b := by
        intro b
        have hb := hc b
        simp only [BayesOptimal.Foundations.BayesianModel.advance]
        omega
      have hrecover (z : ℝ) :
          (m a + (((natPrecisions c a : ℝ≥0) : ℝ) + 1) * z - m a) /
            ((c a : ℝ) + 1) = z := by
        simpa only [natPrecisions, NNReal.coe_natCast] using
          recovered_innovation (natPrecisions c a) (m a) z
      rw [htree, rawRisk_succ a next (natPrecisions c) m
        (natPrecisions_positive c hc a) hreg.2]
      calc
        _ = ∫ z : ℝ,
            BayesOptimal.FinitePosterior.loss H
              (BayesOptimal.FiniteGaussian.advance (natPrecisions c) a)
              (BayesOptimal.FiniteGaussian.shift m a z)
              ∂gaussianReal 0 (BayesOptimal.FiniteGaussian.innovation (natPrecisions c) a) := by
          apply integral_congr_ae
          apply Filter.Eventually.of_forall
          intro z
          simp only [next, hrecover, advance_natPrecisions, shift_eq]
          exact ih (t + 1) (BayesOptimal.Foundations.BayesianModel.advance c a)
            (BayesOptimal.Foundations.BayesianModel.shift m a z) (seedTail u) (by omega) hca
        _ = BayesOptimal.FinitePosterior.loss (H + 1) (natPrecisions c) m := by
          change BayesOptimal.FinitePosterior.actionLoss H (natPrecisions c) m a = _
          exact (CountModelBridge.actionLoss_eq_loss_iff H c m a (hc a)).mpr
            (BayesOptimal.Foundations.BayesianModel.choose_optimal H c m)

end
end BayesOptimal.PolicyContinuationOptimal

end

/-! ## PolicyAE -/
section

open MeasureTheory ProbabilityTheory

namespace BayesOptimal.Policy

set_option maxHeartbeats 800000

open BayesOptimal.Foundations.BayesianModel

noncomputable section

/-- Randomization may choose suboptimal actions on a Gaussian-null subset
of the external seed, separately at each proper posterior state. -/
def AEOptimal (π : StatePolicy) (T : ℕ) : Prop :=
  (∀ (t : ℕ) (c : Counts) (m : Means), 4 ≤ t → t ≤ T → (∀ i, 0 < c i) →
    ∀ᵐ u : ℝ ∂gaussianReal 0 1,
      action (T - t) c m (π.draw t c m u) = value (T - t + 1) c m) ∧
  (∀ (c : Counts) (m : Means), (∀ i, 0 < c i) →
    ∀ᵐ u : ℝ ∂gaussianReal 0 1, m (π.recommend c m u) = terminal m)

theorem pointwiseOptimal_aeOptimal (π : StatePolicy) (T : ℕ) (hπ : PointwiseOptimal π T) :
    AEOptimal π T := by
  constructor
  · intro t c m ht htT hc
    exact ae_of_all _ (fun u => hπ.1 t c m u ht htT hc)
  · intro c m hc
    exact ae_of_all _ (fun u => hπ.2 c m u hc)

theorem action_joint_measurable (k : ℕ) :
    Measurable (fun x : Counts × Means × Arm => action k x.1 x.2.1 x.2.2) := by
  apply measurable_from_prod_countable_right
  intro c
  apply measurable_from_prod_countable_left
  intro i
  exact (action_lipschitz k c i).continuous.measurable

theorem value_joint_measurable (k : ℕ) :
    Measurable (fun x : Counts × Means => value k x.1 x.2) := by
  apply measurable_from_prod_countable_right
  intro c
  exact (value_lipschitz k c).continuous.measurable

theorem evaluation_joint_measurable :
    Measurable (fun x : Means × Arm => x.1 x.2) := by
  apply measurable_from_prod_countable_left
  intro i
  exact measurable_pi_apply i

theorem draw_good_measurable (π : StatePolicy) (T t : ℕ) :
    MeasurableSet {x : Counts × Means × ℝ |
      action (T - t) x.1 x.2.1 (π.draw t x.1 x.2.1 x.2.2) =
        value (T - t + 1) x.1 x.2.1} := by
  have hc : Measurable (fun x : Counts × Means × ℝ => x.1) := measurable_fst
  have hm : Measurable (fun x : Counts × Means × ℝ => x.2.1) :=
    measurable_fst.comp measurable_snd
  have hd := π.draw_measurable t
  have ha := (action_joint_measurable (T - t)).comp (hc.prodMk (hm.prodMk hd))
  have hv := (value_joint_measurable (T - t + 1)).comp (hc.prodMk hm)
  exact measurableSet_eq_fun ha hv

theorem recommend_good_measurable (π : StatePolicy) :
    MeasurableSet {x : Counts × Means × ℝ |
      x.2.1 (π.recommend x.1 x.2.1 x.2.2) = terminal x.2.1} := by
  have hm : Measurable (fun x : Counts × Means × ℝ => x.2.1) :=
    measurable_fst.comp measurable_snd
  have hv := evaluation_joint_measurable.comp (hm.prodMk π.recommend_measurable)
  exact measurableSet_eq_fun hv (terminal_lipschitz.continuous.measurable.comp hm)

def repairedDraw (π : StatePolicy) (T t : ℕ) (c : Counts) (m : Means) (u : ℝ) : Arm :=
  if action (T - t) c m (π.draw t c m u) = value (T - t + 1) c m then
    π.draw t c m u else choose (T - t) c m

def repairedRecommend (π : StatePolicy) (c : Counts) (m : Means) (u : ℝ) : Arm :=
  if m (π.recommend c m u) = terminal m then π.recommend c m u else recommend m

theorem repairedDraw_measurable (π : StatePolicy) (T t : ℕ) :
    Measurable (fun x : Counts × Means × ℝ => repairedDraw π T t x.1 x.2.1 x.2.2) := by
  exact Measurable.ite (draw_good_measurable π T t) (π.draw_measurable t)
    (bellman_draw_measurable T t)

theorem repairedRecommend_measurable (π : StatePolicy) :
    Measurable (fun x : Counts × Means × ℝ => repairedRecommend π x.1 x.2.1 x.2.2) := by
  exact Measurable.ite (recommend_good_measurable π) π.recommend_measurable
    bellman_recommend_measurable

/-- A measurable canonical version that repairs only seed values giving a
nonoptimal action or recommendation at the current state. -/
def repair (π : StatePolicy) (T : ℕ) : StatePolicy where
  draw := repairedDraw π T
  recommend := repairedRecommend π
  draw_measurable := repairedDraw_measurable π T
  recommend_measurable := repairedRecommend_measurable π

theorem repair_pointwiseOptimal (π : StatePolicy) (T : ℕ) : PointwiseOptimal (repair π T) T := by
  constructor
  · intro t c m u _ _ _
    change action (T - t) c m (repairedDraw π T t c m u) = value (T - t + 1) c m
    unfold repairedDraw
    split_ifs with h
    · exact h
    · exact choose_optimal (T - t) c m
  · intro c m u _
    change m (repairedRecommend π c m u) = terminal m
    unfold repairedRecommend
    split_ifs with h
    · exact h
    · exact recommend_max m

theorem repair_draw_ae (π : StatePolicy) (T : ℕ) (hπ : AEOptimal π T)
    (t : ℕ) (c : Counts) (m : Means) (ht : 4 ≤ t) (htT : t ≤ T) (hc : ∀ i, 0 < c i) :
    π.draw t c m =ᵐ[gaussianReal 0 1] (repair π T).draw t c m := by
  filter_upwards [hπ.1 t c m ht htT hc] with u hu
  simp only [repair, repairedDraw, if_pos hu]

theorem repair_recommend_ae (π : StatePolicy) (T : ℕ) (hπ : AEOptimal π T)
    (c : Counts) (m : Means) (hc : ∀ i, 0 < c i) :
    π.recommend c m =ᵐ[gaussianReal 0 1] (repair π T).recommend c m := by
  filter_upwards [hπ.2 c m hc] with u hu
  simp only [repair, repairedRecommend, if_pos hu]

end

end BayesOptimal.Policy

end

/-! ## PolicySeeds -/
section

open MeasureTheory ProbabilityTheory
open scoped ENNReal NNReal

namespace BayesOptimal.Policy

set_option maxHeartbeats 800000

open BayesOptimal.Foundations.BayesianModel

noncomputable section

abbrev SeedArray (n : ℕ) := Fin n → ℝ

def seedLaw (n : ℕ) : Measure (SeedArray n) :=
  Measure.pi (fun _ : Fin n => gaussianReal 0 1)

instance seedLaw_probability (n : ℕ) : IsProbabilityMeasure (seedLaw n) := by
  unfold seedLaw
  infer_instance

def randomizerLaw (T : ℕ) : Measure (SeedArray (T + 1)) := seedLaw (T + 1)

instance randomizerLaw_probability (T : ℕ) : IsProbabilityMeasure (randomizerLaw T) :=
  seedLaw_probability (T + 1)

def extendSeeds (n : ℕ) (u : SeedArray n) : RandomPath :=
  fun j => if h : j < n then u ⟨j, h⟩ else 0

def randomPath (T : ℕ) (u : SeedArray (T + 1)) : RandomPath := extendSeeds (T + 1) u

theorem extendSeeds_measurable (n : ℕ) : Measurable (extendSeeds n) := by
  apply measurable_pi_lambda
  intro j
  by_cases h : j < n
  · simpa only [extendSeeds, dif_pos h] using measurable_pi_apply (⟨j, h⟩ : Fin n)
  · simp only [extendSeeds, dif_neg h]
    exact measurable_const

theorem randomPath_measurable (T : ℕ) : Measurable (randomPath T) := extendSeeds_measurable (T + 1)

def splitSeeds (n : ℕ) : SeedArray (n + 1) ≃ᵐ SeedArray n × ℝ :=
  (MeasurableEquiv.piFinSuccAbove (fun _ : Fin (n + 1) => ℝ) (Fin.last n)).trans
    MeasurableEquiv.prodComm

theorem splitSeeds_apply (n : ℕ) (u : SeedArray (n + 1)) :
    splitSeeds n u = (Fin.init u, u (Fin.last n)) := by
  ext j <;> simp [splitSeeds, MeasurableEquiv.prodComm, Fin.init]

theorem splitSeeds_symm_apply (n : ℕ) (u : SeedArray n) (z : ℝ) :
    (splitSeeds n).symm (u, z) = Fin.snoc u z := by
  apply (splitSeeds n).injective
  rw [(splitSeeds n).apply_symm_apply, splitSeeds_apply, Fin.init_snoc, Fin.snoc_last]

theorem splitSeeds_preserving (n : ℕ) :
    MeasurePreserving (splitSeeds n) (seedLaw (n + 1)) ((seedLaw n).prod (gaussianReal 0 1)) := by
  exact Measure.measurePreserving_swap.comp
    (measurePreserving_piFinSuccAbove (fun _ : Fin (n + 1) => gaussianReal 0 1) (Fin.last n))

/-- Counts after s rewards, with exactly the first s external seeds available.
The first three observations initialize the posterior and use no policy seed. -/
def prefixCounts (π : StatePolicy) (p : Path) : (s : ℕ) → SeedArray s → Counts
  | 0, _ => fun _ => 1
  | s + 1, u =>
    let c := prefixCounts π p s (Fin.init u)
    if 3 ≤ s then advance c (π.draw (s + 1) c (BayesOptimal.Foundations.PolicyPaths.meansAt p c) (u (Fin.last s)))
    else c

theorem prefixCounts_positive (π : StatePolicy) (p : Path) (s : ℕ) (u : SeedArray s) (i : Arm) :
    0 < prefixCounts π p s u i := by
  induction s with
  | zero => norm_num [prefixCounts]
  | succ s ih =>
    simp only [prefixCounts]
    split_ifs
    · simp only [advance]
      have h := ih (Fin.init u)
      omega
    · exact ih (Fin.init u)

theorem prefixCounts_measurable (π : StatePolicy) (p : Path) (s : ℕ) :
    Measurable (prefixCounts π p s) := by
  induction s with
  | zero => exact measurable_const
  | succ s ih =>
    have hinit : Measurable (fun u : SeedArray (s + 1) => Fin.init u) := by
      apply measurable_pi_lambda
      intro j
      exact measurable_pi_apply j.castSucc
    have hc := ih.comp hinit
    have hm := (measurable_of_countable (fun c : Counts => BayesOptimal.Foundations.PolicyPaths.meansAt p c)).comp hc
    have hu : Measurable (fun u : SeedArray (s + 1) => u (Fin.last s)) := measurable_pi_apply _
    have hd := (π.draw_measurable (s + 1)).comp (hc.prodMk (hm.prodMk hu))
    by_cases hs : 3 ≤ s
    · simp only [prefixCounts, if_pos hs]
      exact (measurable_of_countable (fun x : Counts × Arm => advance x.1 x.2)).comp
        (hc.prodMk hd)
    · simpa only [prefixCounts, if_neg hs] using hc

theorem prefixCounts_eq_counts (π : StatePolicy) (p : Path) (u : RandomPath) (s : ℕ) :
    prefixCounts π p s (fun j : Fin s => u j.val) = counts π p u s := by
  induction s with
  | zero => rfl
  | succ s ih =>
    have hi : Fin.init (fun j : Fin (s + 1) => u j.val) = fun j : Fin s => u j.val := rfl
    rw [prefixCounts, hi, ih]
    by_cases hs : 3 ≤ s
    · rw [if_pos hs, counts_update π p u s hs]
      rfl
    · rw [if_neg hs]
      have hs0 : s - 3 = 0 := by omega
      have hs1 : s + 1 - 3 = 0 := by omega
      simp only [counts, hs0, hs1]

theorem prefixCounts_repair_ae (π : StatePolicy) (T : ℕ) (hπ : AEOptimal π T)
    (p : Path) (s : ℕ) (hsT : s ≤ T) :
    prefixCounts π p s =ᵐ[seedLaw s] prefixCounts (repair π T) p s := by
  induction s with
  | zero => exact ae_of_all _ (fun _ => rfl)
  | succ s ih =>
    have hprev := ih (by omega : s ≤ T)
    have hm : MeasurableSet {x : SeedArray s × ℝ |
        prefixCounts π p (s + 1) ((splitSeeds s).symm x) =
          prefixCounts (repair π T) p (s + 1) ((splitSeeds s).symm x)} :=
      measurableSet_eq_fun_of_countable ((prefixCounts_measurable π p (s + 1)).comp (splitSeeds s).symm.measurable)
        ((prefixCounts_measurable (repair π T) p (s + 1)).comp (splitSeeds s).symm.measurable)
    have hp : ∀ᵐ x : SeedArray s × ℝ ∂(seedLaw s).prod (gaussianReal 0 1),
        prefixCounts π p (s + 1) ((splitSeeds s).symm x) =
          prefixCounts (repair π T) p (s + 1) ((splitSeeds s).symm x) := by
      apply (Measure.ae_prod_iff_ae_ae hm).mpr
      filter_upwards [hprev] with u hu
      by_cases hs : 3 ≤ s
      · have ha := repair_draw_ae π T hπ (s + 1) (prefixCounts π p s u)
          (BayesOptimal.Foundations.PolicyPaths.meansAt p (prefixCounts π p s u)) (by omega) (by omega)
          (prefixCounts_positive π p s u)
        filter_upwards [ha] with z hz
        rw [splitSeeds_symm_apply, prefixCounts, prefixCounts, Fin.init_snoc, Fin.snoc_last,
          if_pos hs, if_pos hs, ← hu]
        exact congrArg (advance (prefixCounts π p s u)) hz
      · exact ae_of_all _ (fun z => by
          rw [splitSeeds_symm_apply, prefixCounts, prefixCounts, Fin.init_snoc,
            if_neg hs, if_neg hs]
          exact hu)
    have h := (splitSeeds_preserving s).quasiMeasurePreserving.ae hp
    filter_upwards [h] with u hu
    simpa only [MeasurableEquiv.symm_apply_apply] using hu

def prefixRecommendation (π : StatePolicy) (T : ℕ) (p : Path) (u : SeedArray (T + 1)) : Arm :=
  let c := prefixCounts π p T (Fin.init u)
  π.recommend c (BayesOptimal.Foundations.PolicyPaths.meansAt p c) (u (Fin.last T))

theorem prefixRecommendation_measurable (π : StatePolicy) (T : ℕ) (p : Path) :
    Measurable (prefixRecommendation π T p) := by
  have hinit : Measurable (fun u : SeedArray (T + 1) => Fin.init u) := by
    apply measurable_pi_lambda
    intro j
    exact measurable_pi_apply j.castSucc
  have hc := (prefixCounts_measurable π p T).comp hinit
  have hm := (measurable_of_countable (fun c : Counts => BayesOptimal.Foundations.PolicyPaths.meansAt p c)).comp hc
  have hu : Measurable (fun u : SeedArray (T + 1) => u (Fin.last T)) := measurable_pi_apply _
  exact π.recommend_measurable.comp (hc.prodMk (hm.prodMk hu))

theorem prefixRecommendation_eq (π : StatePolicy) (T : ℕ) (p : Path) (u : SeedArray (T + 1)) :
    prefixRecommendation π T p u = recommendation π T p (randomPath T u) := by
  have hi : (fun j : Fin T => randomPath T u j.val) = Fin.init u := by
    funext j
    simp only [randomPath, extendSeeds, dif_pos (by omega : j.val < T + 1), Fin.init]
    rfl
  have hc := prefixCounts_eq_counts π p (randomPath T u) T
  rw [hi] at hc
  unfold prefixRecommendation recommendation
  rw [hc]
  simp only [randomPath, extendSeeds, dif_pos (by omega : T < T + 1)]
  rfl

/-- The original AE-optimal policy and its pointwise-optimal repair produce
the same recommendation almost surely under independent fresh Gaussian seeds. -/
theorem recommendation_repair_ae (π : StatePolicy) (T : ℕ) (hπ : AEOptimal π T) (p : Path) :
    (fun u : SeedArray (T + 1) => recommendation π T p (randomPath T u)) =ᵐ[randomizerLaw T]
      (fun u : SeedArray (T + 1) => recommendation (repair π T) T p (randomPath T u)) := by
  have hm : MeasurableSet {x : SeedArray T × ℝ |
      prefixRecommendation π T p ((splitSeeds T).symm x) =
        prefixRecommendation (repair π T) T p ((splitSeeds T).symm x)} :=
    measurableSet_eq_fun_of_countable ((prefixRecommendation_measurable π T p).comp (splitSeeds T).symm.measurable)
      ((prefixRecommendation_measurable (repair π T) T p).comp (splitSeeds T).symm.measurable)
  have hp : ∀ᵐ x : SeedArray T × ℝ ∂(seedLaw T).prod (gaussianReal 0 1),
      prefixRecommendation π T p ((splitSeeds T).symm x) =
        prefixRecommendation (repair π T) T p ((splitSeeds T).symm x) := by
    apply (Measure.ae_prod_iff_ae_ae hm).mpr
    filter_upwards [prefixCounts_repair_ae π T hπ p T le_rfl] with u hu
    have ha := repair_recommend_ae π T hπ (prefixCounts π p T u)
      (BayesOptimal.Foundations.PolicyPaths.meansAt p (prefixCounts π p T u)) (prefixCounts_positive π p T u)
    filter_upwards [ha] with z hz
    rw [splitSeeds_symm_apply, prefixRecommendation, prefixRecommendation,
      Fin.init_snoc, Fin.snoc_last, ← hu]
    exact hz
  have h := (splitSeeds_preserving T).quasiMeasurePreserving.ae hp
  filter_upwards [h] with u hu
  simp only [MeasurableEquiv.symm_apply_apply] at hu
  simpa only [prefixRecommendation_eq] using hu

end

end BayesOptimal.Policy

end

/-! ## PolicyAEExecution -/
section

open MeasureTheory ProbabilityTheory

namespace BayesOptimal.Policy

open BayesOptimal.Foundations.BayesianModel

noncomputable section

theorem recommendation_seed_joint_measurable (π : StatePolicy) (T : ℕ) :
    Measurable (fun x : Path × SeedArray (T + 1) =>
      recommendation π T x.1 (randomPath T x.2)) := by
  exact (recommendation_joint_measurable π T).comp
    (measurable_fst.prodMk ((randomPath_measurable T).comp measurable_snd))

theorem recommendation_execution_measurable {Ω : Type*} [MeasurableSpace Ω]
    (π : StatePolicy) (T : ℕ) (p : Ω → Path) (hp : Measurable p) :
    Measurable (fun x : Ω × SeedArray (T + 1) =>
      recommendation π T (p x.1) (randomPath T x.2)) := by
  exact (recommendation_seed_joint_measurable π T).comp
    ((hp.comp measurable_fst).prodMk measurable_snd)

/-- Independent fresh Gaussian randomizers preserve the entire recommendation
law when the state policy is replaced by its canonical pointwise-optimal version.
The reward stack may have any independent s-finite law. -/
theorem recommendation_repair_joint_ae {Ω : Type*} [MeasurableSpace Ω]
    (ν : Measure Ω) [SFinite ν] (π : StatePolicy) (T : ℕ) (hπ : AEOptimal π T)
    (p : Ω → Path) (hp : Measurable p) :
    (fun x : Ω × SeedArray (T + 1) => recommendation π T (p x.1) (randomPath T x.2))
      =ᵐ[ν.prod (randomizerLaw T)]
    (fun x : Ω × SeedArray (T + 1) => recommendation (repair π T) T (p x.1) (randomPath T x.2)) := by
  have hm : MeasurableSet {x : Ω × SeedArray (T + 1) |
      recommendation π T (p x.1) (randomPath T x.2) =
        recommendation (repair π T) T (p x.1) (randomPath T x.2)} :=
    measurableSet_eq_fun_of_countable (recommendation_execution_measurable π T p hp)
      (recommendation_execution_measurable (repair π T) T p hp)
  apply (Measure.ae_prod_iff_ae_ae hm).mpr
  exact ae_of_all _ (fun ω => recommendation_repair_ae π T hπ (p ω))

/-- Any function of the terminal recommendation, including true simple regret,
has exactly the same expectation under the original and repaired policies. -/
theorem recommendation_integral_repair_eq {Ω : Type*} [MeasurableSpace Ω]
    (ν : Measure Ω) [SFinite ν] (π : StatePolicy) (T : ℕ) (hπ : AEOptimal π T)
    (p : Ω → Path) (hp : Measurable p) (f : Arm → ℝ) :
    (∫ x : Ω × SeedArray (T + 1), f (recommendation π T (p x.1) (randomPath T x.2))
        ∂ν.prod (randomizerLaw T)) =
    ∫ x : Ω × SeedArray (T + 1), f (recommendation (repair π T) T (p x.1) (randomPath T x.2))
        ∂ν.prod (randomizerLaw T) := by
  apply integral_congr_ae
  filter_upwards [recommendation_repair_joint_ae ν π T hπ p hp] with x hx
  exact congrArg f hx

end

end BayesOptimal.Policy

end

/-! ## ProbabilityPolynomial -/
section

open MeasureTheory ProbabilityTheory Set
open scoped NNReal ENNReal

namespace BayesOptimal.Probability

open BayesOptimal.Foundations BadEvent

noncomputable section

def underestimationInterval (T : ℕ) (CU : ℝ) : Set ℝ :=
  Icc (-CU * Real.sqrt (Real.log (T : ℝ)) - 1) (-CU * Real.sqrt (Real.log (T : ℝ)))

theorem underestimationPDF_polynomial_lower (T B : ℕ) (Δ CU : ℝ)
    (hT : 5 ≤ T) (hΔ : 0 ≤ Δ) (hCU : 0 ≤ CU) (hB : CU + Δ + 1 ≤ (B : ℝ))
    (x : ℝ) (hx : x ∈ underestimationInterval T CU) :
    underestimationConstant * Rates.invPower (B ^ 2) T ≤ gaussianPDFReal Δ 1 x := by
  have hTp : 0 < (T : ℝ) := by exact_mod_cast (show 0 < T by omega)
  have hlog := Drift.log_horizon_ge_one T hT
  have hsqrt : 1 ≤ Real.sqrt (Real.log (T : ℝ)) := Real.one_le_sqrt.mpr hlog
  have hBpos : 0 ≤ (B : ℝ) := by positivity
  have hBscale := mul_le_mul_of_nonneg_right hB (Real.sqrt_nonneg (Real.log (T : ℝ)))
  have hΔscale := mul_le_mul_of_nonneg_left hsqrt (by positivity : 0 ≤ Δ + 1)
  have hCUscale : 0 ≤ CU * Real.sqrt (Real.log (T : ℝ)) := by positivity
  have hxlower : -(B : ℝ) * Real.sqrt (Real.log (T : ℝ)) ≤ x - Δ := by
    change -CU * Real.sqrt (Real.log (T : ℝ)) - 1 ≤ x ∧
      x ≤ -CU * Real.sqrt (Real.log (T : ℝ)) at hx
    nlinarith only [hx.1, hBscale, hΔscale]
  have hxupper : x - Δ ≤ (B : ℝ) * Real.sqrt (Real.log (T : ℝ)) := by
    change _ ≤ x ∧ x ≤ -CU * Real.sqrt (Real.log (T : ℝ)) at hx
    nlinarith only [hx.2, hΔ, hCUscale, mul_nonneg hBpos (Real.sqrt_nonneg (Real.log (T : ℝ)))]
  have habs : |x - Δ| ≤ (B : ℝ) * Real.sqrt (Real.log (T : ℝ)) :=
    abs_le.mpr ⟨by simpa only [neg_mul] using hxlower, hxupper⟩
  have hsq : (x - Δ) ^ 2 ≤ (B : ℝ) ^ 2 * Real.log (T : ℝ) := by
    have h := (sq_le_sq₀ (abs_nonneg (x - Δ)) (by positivity)).mpr habs
    simpa only [sq_abs, mul_pow, Real.sq_sqrt (by linarith : 0 ≤ Real.log (T : ℝ))] using h
  have hlogprod : 0 ≤ (B : ℝ) ^ 2 * Real.log (T : ℝ) := by positivity
  have he : Real.exp (-((B ^ 2 : ℕ) : ℝ) * Real.log (T : ℝ)) ≤
      Real.exp (-(x - Δ) ^ 2 / 2) := by
    apply Real.exp_le_exp.mpr
    norm_num only [Nat.cast_pow]
    nlinarith only [hsq, hlogprod]
  unfold Rates.invPower
  rw [← PredictiveBound.exp_neg_nat_log (B ^ 2) hTp]
  have hc : 0 ≤ underestimationConstant := underestimationConstant_positive.le
  convert mul_le_mul_of_nonneg_left he hc using 1
  simp [gaussianPDFReal, underestimationConstant]

theorem underestimation_probability_polynomial_lower (T B : ℕ) (Δ CU : ℝ)
    (hT : 5 ≤ T) (hΔ : 0 ≤ Δ) (hCU : 0 ≤ CU) (hB : CU + Δ + 1 ≤ (B : ℝ)) :
    underestimationConstant * Rates.invPower (B ^ 2) T ≤
      (gaussianReal Δ 1).real (underestimationSet T CU) := by
  have hmass : (gaussianReal Δ 1).real (underestimationInterval T CU) =
      ∫ x in underestimationInterval T CU, gaussianPDFReal Δ 1 x := by
    rw [Measure.real, gaussianReal_apply_eq_integral Δ (by norm_num), ENNReal.toReal_ofReal]
    exact integral_nonneg (gaussianPDFReal_nonneg Δ 1)
  have hmono : (∫ _x in underestimationInterval T CU,
      underestimationConstant * Rates.invPower (B ^ 2) T) ≤
      ∫ x in underestimationInterval T CU, gaussianPDFReal Δ 1 x := by
    apply setIntegral_mono_on (integrableOn_const isCompact_Icc.measure_ne_top)
      (integrable_gaussianPDFReal Δ 1).integrableOn measurableSet_Icc
    intro x hx
    exact underestimationPDF_polynomial_lower T B Δ CU hT hΔ hCU hB x hx
  have hconst : (∫ _x in underestimationInterval T CU,
      underestimationConstant * Rates.invPower (B ^ 2) T) =
      underestimationConstant * Rates.invPower (B ^ 2) T := by
    rw [underestimationInterval, setIntegral_const, smul_eq_mul, measureReal_def,
      Real.volume_Icc, ENNReal.toReal_ofReal (by linarith)]
    ring
  rw [hconst, ← hmass] at hmono
  exact hmono.trans (measureReal_mono (by
    intro x hx
    exact hx.2))

theorem goodArmSet3_polynomial_lower (T q : ℕ)
    (hT : 16 ≤ T) (horizon : T = 2 * q + 1) :
    (1 / 8 : ℝ) * Rates.invPower 2 T ≤ (arrayLaw q).real (goodArmSet3 T q) := by
  have hTr : (16 : ℝ) ≤ T := by exact_mod_cast hT
  have hTp : 0 < (T : ℝ) := by linarith
  have hlog : 0 ≤ Real.log (T : ℝ) := Real.log_nonneg (by linarith)
  have hsmall : f3 T ≤ 2 * Rates.invPower 3 T := by
    unfold f3 Rates.invPower
    rw [← PredictiveBound.exp_neg_nat_log 3 hTp]
    apply mul_le_mul_of_nonneg_left _ (by norm_num)
    apply Real.exp_le_exp.mpr
    norm_num
    nlinarith
  have hrate : 2 * Rates.invPower 3 T ≤ (1 / 8 : ℝ) * Rates.invPower 2 T := by
    unfold Rates.invPower
    field_simp [ne_of_gt hTp]
    nlinarith only [hTr]
  have hf2 := f2_polynomial_lower T (by omega)
  have hprob := goodArmSet3_probability_lower T q horizon (by omega)
  linarith

theorem rawBadEvent_polynomial_lower (T q B : ℕ) (Δ CU : ℝ)
    (hT : 16 ≤ T) (horizon : T = 2 * q + 1)
    (hΔ : 0 ≤ Δ) (hCU : 0 ≤ CU) (hB : CU + Δ + 1 ≤ (B : ℝ)) :
    (underestimationConstant / 64) * Rates.invPower (B ^ 2 + 4) T ≤
      (rawArraysLaw T).real (rawBadEvent T q Δ CU (by omega) (by omega)) := by
  rw [rawBadEvent_probability_eq]
  have hX := underestimation_probability_polynomial_lower T B Δ CU (by omega) hΔ hCU hB
  have hY := goodArmSet3_polynomial_lower T q hT horizon
  have hY0 : 0 ≤ (1 / 8 : ℝ) * Rates.invPower 2 T :=
    mul_nonneg (by norm_num) (Rates.invPower_nonneg 2 T)
  have hYs := (sq_le_sq₀ hY0 (measureReal_nonneg)).mpr hY
  have hm := mul_le_mul hX hYs (sq_nonneg _) measureReal_nonneg
  have he : (underestimationConstant / 64) * Rates.invPower (B ^ 2 + 4) T =
      (underestimationConstant * Rates.invPower (B ^ 2) T) *
        ((1 / 8 : ℝ) * Rates.invPower 2 T) ^ 2 := by
    unfold Rates.invPower
    rw [pow_add, mul_inv]
    ring
  rw [he]
  exact hm

end

end BayesOptimal.Probability

end

/-! ## TailRatio -/
section

open MeasureTheory ProbabilityTheory Set Filter
open scoped MeasureTheory NNReal ENNReal Topology

namespace BayesOptimal.TailRatio

noncomputable section

def normalTail (x : ℝ) : ℝ := (gaussianReal 0 1 (Ioi x)).toReal
def phi (x : ℝ) : ℝ := gaussianPDFReal 0 1 x
def normalization : ℝ := (Real.sqrt (2 * Real.pi))⁻¹

theorem phi_eq (x : ℝ) : phi x = normalization * Real.exp (-x ^ 2 / 2) := by
  simp [phi, normalization, gaussianPDFReal]

theorem phi_nonnegative (x : ℝ) : 0 ≤ phi x := gaussianPDFReal_nonneg 0 1 x

theorem normalTail_eq_integral (x : ℝ) : normalTail x = ∫ y in Ioi x, phi y := by
  unfold normalTail phi
  rw [gaussianReal_apply_eq_integral 0 (by norm_num : (1 : ℝ≥0) ≠ 0),
    ENNReal.toReal_ofReal]
  exact integral_nonneg (gaussianPDFReal_nonneg _ _)

/-- The underestimation probability in revised Lemma 3 is the corresponding
standard upper tail. Both boundary conventions agree because Gaussians have no atoms. -/
theorem shifted_left_tail (delta a : ℝ) :
    (gaussianReal delta 1).real (Iic (-a)) = normalTail (a + delta) := by
  letI : NoAtoms (gaussianReal 0 1) := noAtoms_gaussianReal (by norm_num : (1 : ℝ≥0) ≠ 0)
  have hmap : (gaussianReal 0 1).map (fun y : ℝ => delta - y) = gaussianReal delta 1 := by
    simpa only [sub_zero] using gaussianReal_map_const_sub (μ := (0 : ℝ)) (v := 1) delta
  have hpre : (fun y : ℝ => delta - y) ⁻¹' Iic (-a) = Ici (a + delta) := by
    ext y
    change delta - y ≤ -a ↔ a + delta ≤ y
    constructor <;> intro h <;> linarith only [h]
  rw [measureReal_def, ← hmap, Measure.map_apply (by fun_prop) measurableSet_Iic, hpre]
  unfold normalTail
  exact congrArg ENNReal.toReal
    (measure_congr (Ioi_ae_eq_Ici (μ := gaussianReal 0 1) (a := a + delta))).symm

theorem phi_integrable : Integrable phi := integrable_gaussianPDFReal 0 1

theorem hasDerivAt_phi (x : ℝ) : HasDerivAt phi (-x * phi x) x := by
  have he : HasDerivAt (fun y : ℝ => Real.exp (-y ^ 2 / 2))
      (Real.exp (-x ^ 2 / 2) * (-x)) x := by
    convert ((((hasDerivAt_id x).pow 2).neg.div_const 2).exp) using 1
    simp only [id_eq, Pi.pow_apply, Pi.neg_apply]
    ring
  have hf : phi = fun y : ℝ => normalization * Real.exp (-y ^ 2 / 2) := by
    funext y
    exact phi_eq y
  rw [hf]
  convert he.const_mul normalization using 1
  ring

theorem phi_tendsto_zero : Tendsto phi atTop (𝓝 0) := by
  have hsq : Tendsto (fun y : ℝ => y * y) atTop atTop :=
    Tendsto.atTop_mul_atTop₀ tendsto_id tendsto_id
  have hscale : Tendsto (fun y : ℝ => y ^ 2 / 2) atTop atTop := by
    convert (tendsto_const_mul_atTop_of_pos (by norm_num : (0 : ℝ) < 1 / 2)).mpr hsq using 1
    funext y
    ring
  have he := Real.tendsto_exp_atBot.comp (tendsto_neg_atTop_atBot.comp hscale)
  have hf : phi = fun y : ℝ => normalization * Real.exp (-y ^ 2 / 2) := by
    funext y
    exact phi_eq y
  rw [hf]
  simpa only [neg_div, mul_zero] using he.const_mul normalization

def primitive (x : ℝ) : ℝ := -phi x / x
def derivative (x : ℝ) : ℝ := phi x + phi x / x ^ 2
def remainder (x : ℝ) : ℝ := phi x / x ^ 2

theorem primitive_tendsto_zero : Tendsto primitive atTop (𝓝 0) := by
  have h := phi_tendsto_zero.neg.mul tendsto_inv_atTop_zero
  change Tendsto (fun x : ℝ => -phi x / x) atTop (𝓝 0)
  simpa [primitive, div_eq_mul_inv] using h

theorem primitive_hasDerivAt (x : ℝ) (hx : 0 < x) :
    HasDerivAt primitive (derivative x) x := by
  have hd := (hasDerivAt_phi x).neg.div (hasDerivAt_id x) hx.ne'
  convert hd using 1
  simp only [id_eq, Pi.neg_apply]
  unfold derivative
  field_simp [hx.ne']
  ring

theorem derivative_nonnegative (x : ℝ) : 0 ≤ derivative x := by
  unfold derivative
  exact add_nonneg (phi_nonnegative _) (div_nonneg (phi_nonnegative _) (sq_nonneg _))

theorem derivative_integrableOn (x : ℝ) (hx : 0 < x) : IntegrableOn derivative (Ioi x) := by
  apply integrableOn_Ioi_deriv_of_nonneg'
  · intro y hy
    exact primitive_hasDerivAt y (hx.trans_le hy)
  · intro y _
    exact derivative_nonnegative y
  · exact primitive_tendsto_zero

theorem remainder_integrableOn (x : ℝ) (hx : 0 < x) : IntegrableOn remainder (Ioi x) := by
  have h := (derivative_integrableOn x hx).sub phi_integrable.integrableOn
  have he : derivative - phi = remainder := by
    funext y
    simp [derivative, remainder]
  rwa [he] at h

theorem tail_remainder_identity (x : ℝ) (hx : 0 < x) :
    normalTail x + (∫ y in Ioi x, remainder y) = phi x / x := by
  have hd : ∀ y ∈ Ici x, HasDerivAt primitive (derivative y) y := by
    intro y hy
    exact primitive_hasDerivAt y (hx.trans_le hy)
  have h := integral_Ioi_of_hasDerivAt_of_nonneg' hd
    (fun y _ => derivative_nonnegative y) primitive_tendsto_zero
  have he : derivative = fun y : ℝ => phi y + remainder y := rfl
  rw [he, integral_add phi_integrable.integrableOn (remainder_integrableOn x hx)] at h
  rw [normalTail_eq_integral]
  simpa [primitive, neg_div] using h

/-- Revised Lemma 10's Mills upper bound for the actual standard Gaussian tail. -/
theorem mills_upper (x : ℝ) (hx : 0 < x) : normalTail x ≤ (1 / x) * phi x := by
  have hi := tail_remainder_identity x hx
  have hr : 0 ≤ ∫ y in Ioi x, remainder y := by
    apply integral_nonneg
    intro y
    exact div_nonneg (phi_nonnegative y) (sq_nonneg y)
  have he : (1 / x) * phi x = phi x / x := by ring
  rw [he]
  linarith only [hi, hr]

theorem remainder_integral_le (x : ℝ) (hx : 0 < x) :
    (∫ y in Ioi x, remainder y) ≤ (1 / x ^ 2) * normalTail x := by
  have hmono : (∫ y in Ioi x, remainder y) ≤ ∫ y in Ioi x, (1 / x ^ 2) * phi y := by
    apply setIntegral_mono_on (remainder_integrableOn x hx)
      (phi_integrable.const_mul (1 / x ^ 2)).integrableOn measurableSet_Ioi
    intro y hy
    have hysq : x ^ 2 ≤ y ^ 2 := (sq_le_sq₀ hx.le (hx.trans hy).le).mpr hy.le
    have hinv : 1 / y ^ 2 ≤ 1 / x ^ 2 := one_div_le_one_div_of_le (sq_pos_of_pos hx) hysq
    have hm := mul_le_mul_of_nonneg_right hinv (phi_nonnegative y)
    simpa only [remainder, div_eq_mul_inv, one_mul, mul_comm, mul_one] using hm
  rw [integral_const_mul, ← normalTail_eq_integral] at hmono
  exact hmono

/-- Revised Lemma 10's Mills lower bound, valid for every x>0, including the
range x<1 where its printed lower endpoint is negative. -/
theorem mills_lower (x : ℝ) (hx : 0 < x) :
    (1 / x - 1 / x ^ 3) * phi x ≤ normalTail x := by
  have hi := tail_remainder_identity x hx
  have hr := remainder_integral_le x hx
  have hu := mills_upper x hx
  have hm := mul_le_mul_of_nonneg_left hu (show 0 ≤ 1 / x ^ 2 by positivity)
  have he : (1 / x ^ 2) * ((1 / x) * phi x) = phi x / x ^ 3 := by
    field_simp
  rw [he] at hm
  have he' : (1 / x - 1 / x ^ 3) * phi x = phi x / x - phi x / x ^ 3 := by ring
  rw [he']
  linarith only [hi, hr, hm]

end

end BayesOptimal.TailRatio

end

/-! ## ProbabilityExact -/
section

open MeasureTheory ProbabilityTheory Set Filter
open scoped NNReal ENNReal

namespace BayesOptimal.Probability

open BayesOptimal.Foundations BadEvent TailRatio

noncomputable section

/-- The exact f1 printed in revised Lemma 3. -/
def f1 (T : ℕ) (Δ CU : ℝ) : ℝ :=
  (T : ℝ) ^ (-((CU + Δ) ^ 2) / 2) /
    (2 * (CU + Δ) * Real.sqrt (2 * Real.pi * Real.log (T : ℝ)))

theorem lemma3 (T : ℕ) (Δ CU : ℝ) (hT : 5 ≤ T) (hΔ : 0 ≤ Δ) (hCU : 0 < CU)
    (hz : Real.sqrt 2 ≤ CU * Real.sqrt (Real.log (T : ℝ)) + Δ) :
    f1 T Δ CU ≤ (gaussianReal Δ 1).real (underestimationSet T CU) := by
  let z : ℝ := CU * Real.sqrt (Real.log (T : ℝ)) + Δ
  let rateBase : ℝ := CU + Δ
  have hTp : 0 < (T : ℝ) := by exact_mod_cast (show 0 < T by omega)
  have hlog := Drift.log_horizon_ge_one T hT
  have hroot : 1 ≤ Real.sqrt (Real.log (T : ℝ)) := Real.one_le_sqrt.mpr hlog
  have hzpos : 0 < z := (Real.sqrt_pos.mpr (by norm_num : (0 : ℝ) < 2)).trans_le hz
  have hrateBase : 0 < rateBase := by dsimp [rateBase]; linarith
  have hzsq : 2 ≤ z ^ 2 := by
    have hs := (sq_le_sq₀ (Real.sqrt_nonneg 2) hzpos.le).mpr hz
    simpa only [Real.sq_sqrt (by norm_num : (0 : ℝ) ≤ 2)] using hs
  have hfactor : 1 / (2 * z) ≤ 1 / z - 1 / z ^ 3 := by
    field_simp [ne_of_gt hzpos]
    nlinarith only [hzsq, hzpos]
  have hM := (mul_le_mul_of_nonneg_right hfactor (phi_nonnegative z)).trans (mills_lower z hzpos)
  have hΔscale := mul_le_mul_of_nonneg_left hroot hΔ
  have hzupper : z ≤ rateBase * Real.sqrt (Real.log (T : ℝ)) := by
    dsimp [z, rateBase]
    nlinarith only [hΔscale]
  have hsq : z ^ 2 ≤ rateBase ^ 2 * Real.log (T : ℝ) := by
    have h := (sq_le_sq₀ hzpos.le (by positivity)).mpr hzupper
    simpa only [mul_pow, Real.sq_sqrt (by linarith : 0 ≤ Real.log (T : ℝ))] using h
  have he : Real.exp (-(rateBase ^ 2) * Real.log (T : ℝ) / 2) ≤ Real.exp (-z ^ 2 / 2) := by
    apply Real.exp_le_exp.mpr
    linarith only [hsq]
  have hpower : (T : ℝ) ^ (-(rateBase ^ 2) / 2) =
      Real.exp (-(rateBase ^ 2) * Real.log (T : ℝ) / 2) := by
    rw [Real.rpow_def_of_pos hTp]
    congr 1
    ring
  have hn0 : 0 ≤ normalization := by unfold normalization; positivity
  have hdensity : normalization * (T : ℝ) ^ (-(rateBase ^ 2) / 2) ≤ phi z := by
    rw [phi_eq, hpower]
    exact mul_le_mul_of_nonneg_left he hn0
  have hdenom : 1 / (2 * rateBase * Real.sqrt (Real.log (T : ℝ))) ≤ 1 / (2 * z) := by
    apply one_div_le_one_div_of_le (by positivity)
    nlinarith only [hzupper]
  have hm := mul_le_mul hdenom hdensity
    (mul_nonneg hn0 (Real.rpow_nonneg hTp.le _)) (by positivity)
  have heq : f1 T Δ CU = (1 / (2 * rateBase * Real.sqrt (Real.log (T : ℝ)))) *
      (normalization * (T : ℝ) ^ (-(rateBase ^ 2) / 2)) := by
    unfold f1 normalization
    dsimp [rateBase]
    rw [Real.sqrt_mul (by positivity : 0 ≤ 2 * Real.pi)]
    field_simp
  rw [heq]
  have htail : (gaussianReal Δ 1).real (underestimationSet T CU) = normalTail z := by
    simpa [underestimationSet, z, neg_mul] using
      shifted_left_tail Δ (CU * Real.sqrt (Real.log (T : ℝ)))
  rw [htail]
  exact hm.trans hM

theorem lemma3_eventually (Δ CU : ℝ) (hΔ : 0 < Δ) (hCU : 0 < CU) :
    ∀ᶠ T : ℕ in atTop,
      f1 T Δ CU ≤ (gaussianReal Δ 1).real (underestimationSet T CU) := by
  have hl : Tendsto (fun T : ℕ => Real.log (T : ℝ)) atTop atTop :=
    Real.tendsto_log_atTop.comp tendsto_natCast_atTop_atTop
  have he := hl.eventually_ge_atTop ((Real.sqrt 2 / CU) ^ 2)
  filter_upwards [eventually_ge_atTop (5 : ℕ), he] with T hT hlog
  apply lemma3 T Δ CU hT hΔ.le hCU
  have hs := Real.le_sqrt_of_sq_le hlog
  have hm := (div_le_iff₀ hCU).mp hs
  linarith

theorem rawBadEvent_exact_factor_lower (T q : ℕ) (Δ CU : ℝ)
    (hT : 8 ≤ T) (horizon : T = 2 * q + 1) (hΔ : 0 ≤ Δ) (hCU : 0 < CU)
    (hz : Real.sqrt 2 ≤ CU * Real.sqrt (Real.log (T : ℝ)) + Δ) :
    f1 T Δ CU * (SmallBall.f2 (T : ℝ) - f3 T) ^ 2 ≤
      (rawArraysLaw T).real (rawBadEvent T q Δ CU (by omega) (by omega)) := by
  rw [rawBadEvent_probability_eq]
  have hX := lemma3 T Δ CU (by omega) hΔ hCU hz
  have hY := goodArmSet3_probability_lower T q horizon (by omega)
  have hY0 := f2_minus_f3_nonnegative T hT
  have hYs := (sq_le_sq₀ hY0 measureReal_nonneg).mpr hY
  exact mul_le_mul hX hYs (sq_nonneg _) measureReal_nonneg

theorem rawBadEvent_exact_factor_eventually (Δ CU : ℝ) (hΔ : 0 < Δ) (hCU : 0 < CU) :
    ∀ᶠ T : ℕ in atTop, ∀ q : ℕ, ∀ (horizon : T = 2 * q + 1),
      f1 T Δ CU * (SmallBall.f2 (T : ℝ) - f3 T) ^ 2 ≤
        (rawArraysLaw T).real
          (rawBadEvent T q Δ CU (by omega) (by omega)) := by
  filter_upwards [eventually_ge_atTop (8 : ℕ), lemma3_eventually Δ CU hΔ hCU]
    with T hT hX
  intro q horizon
  rw [rawBadEvent_probability_eq]
  have hY := goodArmSet3_probability_lower T q horizon (by omega)
  have hY0 := f2_minus_f3_nonnegative T hT
  have hYs := (sq_le_sq₀ hY0 measureReal_nonneg).mpr hY
  exact mul_le_mul hX hYs (sq_nonneg _) measureReal_nonneg

end

end BayesOptimal.Probability

end

/-! ## RegretExponent -/
section

open Filter
open scoped Topology

namespace BayesOptimal.RegretExponent

noncomputable section

/-- The paper's convention -log(0)=+infinity, normalized by the horizon. -/
def rate (r : ℕ → ℝ) (T : ℕ) : EReal :=
  if r T = 0 then ⊤ else (((-Real.log (r T)) / (T : ℝ) : ℝ) : EReal)

def oddBudget (n : ℕ) : ℕ := 2 * n + 1

theorem oddBudget_tendsto : Tendsto oddBudget atTop atTop := by
  apply tendsto_atTop.mpr
  intro b
  filter_upwards [eventually_ge_atTop b] with n hn
  unfold oddBudget
  omega

theorem rate_lower_bound (r : ℕ → ℝ) (T : ℕ) (Δ : ℝ)
    (hT : 0 < T) (_hΔ : 0 < Δ) (hr : 0 ≤ r T) (hu : r T ≤ Δ) :
    (((-Real.log Δ) / (T : ℝ) : ℝ) : EReal) ≤ rate r T := by
  by_cases hz : r T = 0
  · simp [rate, hz]
  · have hrp : 0 < r T := lt_of_le_of_ne hr (Ne.symm hz)
    have hlog := Real.log_le_log hrp hu
    rw [rate, if_neg hz]
    apply EReal.coe_le_coe
    exact div_le_div_of_nonneg_right (neg_le_neg hlog)
      (by exact_mod_cast hT.le)

theorem rate_upper_bound (r : ℕ → ℝ) (T C : ℕ) (c : ℝ)
    (hT : 0 < T) (hc : 0 < c)
    (hlower : c * BayesOptimal.Foundations.Rates.invPower C T ≤ r T) :
    rate r T ≤ ((((C : ℝ) * Real.log (T : ℝ) - Real.log c) / (T : ℝ) : ℝ) : EReal) := by
  have hTp : 0 < (T : ℝ) := by exact_mod_cast hT
  have hprod : 0 < c * BayesOptimal.Foundations.Rates.invPower C T :=
    mul_pos hc (BayesOptimal.Foundations.Rates.invPower_pos C T hT)
  have hrp : 0 < r T := hprod.trans_le hlower
  have hlog := Real.log_le_log hprod hlower
  unfold BayesOptimal.Foundations.Rates.invPower at hlog
  rw [Real.log_mul (ne_of_gt hc) (by positivity), Real.log_inv, Real.log_pow] at hlog
  rw [rate, if_neg hrp.ne']
  apply EReal.coe_le_coe
  apply div_le_div_of_nonneg_right _ hTp.le
  linarith only [hlog]

theorem upper_bound_tendsto_zero (C : ℕ) (c : ℝ) :
    Tendsto (fun T : ℕ =>
      ((((C : ℝ) * Real.log (T : ℝ) - Real.log c) / (T : ℝ) : ℝ) : EReal))
      atTop (𝓝 0) := by
  have hlog : Tendsto (fun T : ℕ => Real.log (T : ℝ) / (T : ℝ)) atTop (𝓝 0) := by
    simpa using (Real.tendsto_pow_log_div_mul_add_atTop 1 0 1 one_ne_zero).comp
      (tendsto_natCast_atTop_atTop : Tendsto (fun T : ℕ => (T : ℝ)) atTop atTop)
  have hconst := tendsto_const_div_atTop_nhds_zero_nat (Real.log c)
  have hu : Tendsto (fun T : ℕ =>
      ((C : ℝ) * Real.log (T : ℝ) - Real.log c) / (T : ℝ)) atTop (𝓝 0) := by
    simpa only [mul_zero, sub_zero, sub_div, mul_div_assoc] using
      (hlog.const_mul (C : ℝ)).sub hconst
  simpa only [EReal.coe_zero] using EReal.tendsto_coe.mpr hu

/-- The exact consequence of Theorem 2: an odd-horizon polynomial lower
bound forces the full-horizon extended-real limit inferior of the normalized
negative log regret to equal zero, including zero regrets at other horizons. -/
theorem liminf_rate_eq_zero (r : ℕ → ℝ) (Δ c : ℝ) (C : ℕ)
    (hΔ : 0 < Δ) (hc : 0 < c) (hbound : ∀ T, 0 ≤ r T ∧ r T ≤ Δ)
    (hpoly : ∀ᶠ T : ℕ in atTop, Odd T → c * BayesOptimal.Foundations.Rates.invPower C T ≤ r T) :
    liminf (rate r) atTop = 0 := by
  have hlow : Tendsto (fun T : ℕ => (((-Real.log Δ) / (T : ℝ) : ℝ) : EReal))
      atTop (𝓝 0) := by
    simpa only [EReal.coe_zero] using EReal.tendsto_coe.mpr
      (tendsto_const_div_atTop_nhds_zero_nat (-Real.log Δ))
  have hglobal : ∀ᶠ T : ℕ in atTop,
      (((-Real.log Δ) / (T : ℝ) : ℝ) : EReal) ≤ rate r T := by
    filter_upwards [eventually_ge_atTop (1 : ℕ)] with T hT
    exact rate_lower_bound r T Δ (by omega) hΔ (hbound T).1 (hbound T).2
  have hge := liminf_le_liminf hglobal
  rw [hlow.liminf_eq] at hge
  have hodd : ∀ᶠ n : ℕ in atTop,
      rate r (oddBudget n) ≤
        ((((C : ℝ) * Real.log (oddBudget n : ℝ) - Real.log c) /
          (oddBudget n : ℝ) : ℝ) : EReal) := by
    filter_upwards [oddBudget_tendsto.eventually hpoly] with n hn
    apply rate_upper_bound r (oddBudget n) C c (by unfold oddBudget; omega) hc
    apply hn
    exact ⟨n, by unfold oddBudget; omega⟩
  have hoddle := liminf_le_liminf hodd
  have hoddlimit := (upper_bound_tendsto_zero C c).comp oddBudget_tendsto
  simp only [Function.comp_def] at hoddlimit
  rw [hoddlimit.liminf_eq] at hoddle
  have hsub : liminf (rate r) atTop ≤ liminf (rate r) (map oddBudget atTop) :=
    liminf_le_liminf_of_le oddBudget_tendsto
  rw [← liminf_comp] at hsub
  exact le_antisymm (hsub.trans hoddle) hge

end

end BayesOptimal.RegretExponent

end

/-! ## Main -/
section

open MeasureTheory ProbabilityTheory Filter Set

namespace BayesOptimal.Main

open BayesOptimal.Foundations.BayesianModel BayesOptimal.Foundations.BadEvent BayesOptimal.Foundations.Rates
open BayesOptimal.Policy BayesOptimal.Empirical

noncomputable section

abbrev JointSample (T : ℕ) := RawArrays T × SeedArray (T+1)

def jointLaw (T : ℕ) : Measure (JointSample T) := (rawArraysLaw T).prod (randomizerLaw T)

instance jointLaw_probability (T : ℕ) : IsProbabilityMeasure (jointLaw T) := by
  unfold jointLaw
  infer_instance

def actualRecommendation (π : StatePolicy) (T : ℕ) (Δ : ℝ) (ω : JointSample T) : Arm :=
  recommendation π T (empiricalPath Δ ω.1) (randomPath T ω.2)

theorem actualRecommendation_measurable (π : StatePolicy) (T : ℕ) (Δ : ℝ) :
    Measurable (actualRecommendation π T Δ) :=
  recommendation_execution_measurable π T (empiricalPath Δ) (empiricalPath_measurable T Δ)

def wrongEvent (π : StatePolicy) (T : ℕ) (Δ : ℝ) : Set (JointSample T) :=
  {ω | actualRecommendation π T Δ ω ≠ 2}

theorem wrongEvent_measurable (π : StatePolicy) (T : ℕ) (Δ : ℝ) :
    MeasurableSet (wrongEvent π T Δ) :=
  ((actualRecommendation_measurable π T Δ) (measurableSet_singleton 2)).compl

/-- Actual frequentist simple regret under independent reward stacks with
true means (0,0,Delta) and independent fresh standard Gaussian randomizers. -/
def regret (π : StatePolicy) (T : ℕ) (Δ : ℝ) : ℝ :=
  ∫ ω : JointSample T, Δ - trueMean Δ (actualRecommendation π T Δ ω) ∂jointLaw T

theorem regret_eq (π : StatePolicy) (T : ℕ) (Δ : ℝ) :
    regret π T Δ = Δ * (jointLaw T).real (wrongEvent π T Δ) := by
  have hi : (fun ω : JointSample T => Δ - trueMean Δ (actualRecommendation π T Δ ω)) =
      (wrongEvent π T Δ).indicator (fun _ => Δ) := by
    funext ω
    rw [true_gap]
    by_cases h : actualRecommendation π T Δ ω=2 <;> simp [wrongEvent, h]
  rw [regret, hi, integral_indicator_const Δ (wrongEvent_measurable π T Δ), smul_eq_mul, mul_comm]

theorem regret_bounds (π : StatePolicy) (T : ℕ) (Δ : ℝ) (hΔ : 0 ≤ Δ) :
    0 ≤ regret π T Δ ∧ regret π T Δ ≤ Δ := by
  rw [regret_eq]
  exact ⟨mul_nonneg hΔ measureReal_nonneg,
    (mul_le_mul_of_nonneg_left measureReal_le_one hΔ).trans_eq (mul_one Δ)⟩

theorem regret_repair_eq (π : StatePolicy) (T : ℕ) (Δ : ℝ) (hπ : AEOptimal π T) :
    regret π T Δ = regret (repair π T) T Δ :=
  recommendation_integral_repair_eq (rawArraysLaw T) π T hπ
    (empiricalPath Δ) (empiricalPath_measurable T Δ) (fun i => Δ - trueMean Δ i)

def jointBadEvent (T q : ℕ) (Δ CU : ℝ) (hqT : q ≤ T) (hT : 0 < T) : Set (JointSample T) :=
  BayesOptimal.Probability.rawBadEvent T q Δ CU hqT hT ×ˢ univ

theorem jointBadEvent_probability (T q : ℕ) (Δ CU : ℝ) (hqT : q ≤ T) (hT : 0 < T) :
    (jointLaw T).real (jointBadEvent T q Δ CU hqT hT) =
      (rawArraysLaw T).real (BayesOptimal.Probability.rawBadEvent T q Δ CU hqT hT) := by
  unfold jointLaw jointBadEvent Measure.real
  rw [Measure.prod_prod, ENNReal.toReal_mul, measure_univ, ENNReal.toReal_one, mul_one]

theorem eventually_pointwise_event_lower :
    ∃ T0 : ℕ, ∀ T : ℕ, T0 ≤ T → ∀ (q : ℕ) (hTodd : T=2*q+1),
      ∀ (π : StatePolicy), PointwiseOptimal π T → ∀ (Δ : ℝ), 0 ≤ Δ →
      Δ * (rawArraysLaw T).real
        (BayesOptimal.Probability.rawBadEvent T q Δ 33 (by omega) (by omega)) ≤ regret π T Δ := by
  obtain ⟨N, hN⟩ := BayesOptimal.PolicyChoice.eventually_optimal_choices 33 (by norm_num)
  refine ⟨max N 16, ?_⟩
  intro T hlarge q hT π hπ Δ hΔ
  have hNlarge : N ≤ T := (le_max_left N 16).trans hlarge
  have hT16 : 16 ≤ T := (le_max_right N 16).trans hlarge
  have hchoices := hN T hNlarge
  have hsubset : jointBadEvent T q Δ 33 (by omega) (by omega) ⊆ wrongEvent π T Δ := by
    intro ω hω
    have hp := badEvent_goodPath T q Δ 33 (by omega) (by omega) ω.1 hω.1
    exact BayesOptimal.PathInduction.optimal_bad_path_wrong π T q 33 hT (by omega) (by norm_num)
      hπ (empiricalPath Δ ω.1) (randomPath T ω.2) hp
      (fun t c a ht hpre hc hW ha => hchoices.1 q t (BayesOptimal.Foundations.PathInduction.paperPath
        (empiricalPath Δ ω.1)) c a hT ht hpre hc hW ha)
      (fun c a hc hW ha => hchoices.2 q (BayesOptimal.Foundations.PathInduction.paperPath
        (empiricalPath Δ ω.1)) c a hT hc hW ha)
  rw [regret_eq, ← jointBadEvent_probability T q Δ 33 (by omega) (by omega)]
  exact mul_le_mul_of_nonneg_left (measureReal_mono hsubset) hΔ

/-- The complete polynomial lower bound has arbitrary positive gap, every
odd sufficiently large budget, and every randomized posterior-optimal policy.
The constants are chosen before the policy, so are uniform over all policies. -/
theorem theorem2 (Δ : ℝ) (hΔ : 0 < Δ) :
    ∃ (c : ℝ) (C T0 : ℕ), 0 < c ∧ 0 < C ∧
      ∀ T : ℕ, T0 ≤ T → Odd T → ∀ π : StatePolicy, AEOptimal π T →
        c * invPower C T ≤ regret π T Δ := by
  obtain ⟨B, hB⟩ := exists_nat_ge (33 + Δ + 1)
  obtain ⟨N, hN⟩ := eventually_pointwise_event_lower
  refine ⟨Δ * (underestimationConstant/64), B^2+4, max N 16,
    mul_pos hΔ (div_pos underestimationConstant_positive (by norm_num)), by omega, ?_⟩
  intro T hlarge hodd π hπ
  obtain ⟨q, hq⟩ := hodd
  have hT : T=2*q+1 := by omega
  have hT16 : 16 ≤ T := (le_max_right N 16).trans hlarge
  have hp := BayesOptimal.Probability.rawBadEvent_polynomial_lower T q B Δ 33
    hT16 hT hΔ.le (by norm_num) hB
  have he := hN T ((le_max_left N 16).trans hlarge) q hT (repair π T)
    (repair_pointwiseOptimal π T) Δ hΔ.le
  rw [regret_repair_eq π T Δ hπ]
  calc
    (Δ * (underestimationConstant/64)) * invPower (B^2+4) T =
        Δ * ((underestimationConstant/64) * invPower (B^2+4) T) := mul_assoc _ _ _
    _ ≤ Δ * (rawArraysLaw T).real
        (BayesOptimal.Probability.rawBadEvent T q Δ 33 (by omega) (by omega)) :=
      mul_le_mul_of_nonneg_left hp hΔ.le
    _ ≤ regret (repair π T) T Δ := he

theorem theorem2_exponential_rate (Δ : ℝ) (hΔ : 0 < Δ) (family : ℕ → StatePolicy)
    (hfamily : ∀ T, 3 ≤ T → AEOptimal (family T) T) :
    Filter.liminf (BayesOptimal.RegretExponent.rate (fun T => regret (family T) T Δ)) atTop = 0 := by
  obtain ⟨c, C, T0, hc, _, hmain⟩ := theorem2 Δ hΔ
  apply BayesOptimal.RegretExponent.liminf_rate_eq_zero _ Δ c C hΔ hc
    (fun T => regret_bounds (family T) T Δ hΔ.le)
  filter_upwards [eventually_ge_atTop (max T0 3)] with T hT
  intro hodd
  exact hmain T ((le_max_left T0 3).trans hT) hodd (family T)
    (hfamily T ((le_max_right T0 3).trans hT))

end
end BayesOptimal.Main

end

/-! ## ProbabilityExactRate -/
section

open MeasureTheory ProbabilityTheory Set Filter
open scoped NNReal ENNReal

namespace BayesOptimal.Probability

open BayesOptimal.Foundations BadEvent

noncomputable section

/-- A positive constant for the exact real exponent printed in the paper. -/
def exactRateConstant (Δ CU : ℝ) : ℝ :=
  1 / (32 * (CU + Δ) * Real.pi * Real.sqrt (2 * Real.pi))

theorem exactRateConstant_positive (Δ CU : ℝ) (hΔ : 0 < Δ) (hCU : 0 < CU) :
    0 < exactRateConstant Δ CU := by
  unfold exactRateConstant
  positivity

theorem f1_positive (T : ℕ) (Δ CU : ℝ) (hT : 5 ≤ T)
    (hΔ : 0 < Δ) (hCU : 0 < CU) : 0 < f1 T Δ CU := by
  have hTp : 0 < (T : ℝ) := by exact_mod_cast (show 0 < T by omega)
  have hlog := Drift.log_horizon_ge_one T hT
  unfold f1
  positivity

theorem f2_square (t : ℝ) (ht : 0 < t) :
    SmallBall.f2 t ^ 2 = 1 / (4 * Real.pi * t ^ 3) := by
  unfold SmallBall.f2
  rw [mul_pow, Real.sq_sqrt (by positivity)]
  ring

theorem f3_le_half_f2 (T : ℕ) (hT : 8 ≤ T) :
    f3 T ≤ SmallBall.f2 (T : ℝ) / 2 := by
  have hTr : (8 : ℝ) ≤ T := by exact_mod_cast hT
  have hTp : 0 < (T : ℝ) := by linarith
  have hlog : 0 ≤ Real.log (T : ℝ) := Real.log_nonneg (by linarith)
  have hsmall : f3 T ≤ 2 / (T : ℝ) ^ 3 := by
    have heq : 2 / (T : ℝ) ^ 3 = 2 * Real.exp (-(3 : ℝ) * Real.log (T : ℝ)) := by
      have he := PredictiveBound.exp_neg_nat_log 3 hTp
      norm_num at he
      have he' : Real.exp (-(3 : ℝ) * Real.log (T : ℝ)) = ((T : ℝ) ^ 3)⁻¹ := by
        calc
          _ = Real.exp (-((3 : ℝ) * Real.log (T : ℝ))) := by congr 1; ring
          _ = ((T : ℝ) ^ 3)⁻¹ := he
      rw [he']
      ring
    rw [heq]
    unfold f3
    apply mul_le_mul_of_nonneg_left _ (by norm_num)
    apply Real.exp_le_exp.mpr
    norm_num
    nlinarith
  have ht3 : (512 : ℝ) ≤ (T : ℝ) ^ 3 := by
    calc
      (512 : ℝ) = (8 : ℝ) ^ 3 := by norm_num
      _ ≤ (T : ℝ) ^ 3 := by gcongr
  have hsq : (2 / (T : ℝ) ^ 3) ^ 2 ≤ (SmallBall.f2 (T : ℝ) / 2) ^ 2 := by
    simp only [div_pow, f2_square _ hTp]
    have heq : (1 / (4 * Real.pi * (T : ℝ) ^ 3)) / (2 : ℝ) ^ 2 =
        1 / (16 * Real.pi * (T : ℝ) ^ 3) := by ring
    rw [heq]
    apply (div_le_div_iff₀ (by positivity) (by positivity)).mpr
    have hpi : 64 * Real.pi ≤ (T : ℝ) ^ 3 := by linarith [Real.pi_le_four]
    have hm := mul_le_mul_of_nonneg_right hpi (show 0 ≤ (T : ℝ) ^ 3 by positivity)
    nlinarith only [hm]
  exact hsmall.trans ((sq_le_sq₀ (by positivity) (by unfold SmallBall.f2; positivity)).mp hsq)

theorem f2_minus_f3_square_lower (T : ℕ) (hT : 8 ≤ T) :
    1 / (16 * Real.pi * (T : ℝ) ^ 3) ≤
      (SmallBall.f2 (T : ℝ) - f3 T) ^ 2 := by
  have hTp : 0 < (T : ℝ) := by exact_mod_cast (show 0 < T by omega)
  have hhalf := f3_le_half_f2 T hT
  have hf2 : 0 ≤ SmallBall.f2 (T : ℝ) := by unfold SmallBall.f2; positivity
  have hgap : SmallBall.f2 (T : ℝ) / 2 ≤ SmallBall.f2 (T : ℝ) - f3 T := by linarith
  have hs := (sq_le_sq₀ (by unfold SmallBall.f2; positivity) (by linarith)).mpr hgap
  rw [div_pow, f2_square _ hTp] at hs
  norm_num at hs
  convert hs using 1
  ring

theorem f1_polynomial_lower (T : ℕ) (Δ CU : ℝ) (hT : 5 ≤ T)
    (hΔ : 0 < Δ) (hCU : 0 < CU) :
    (T : ℝ) ^ (-((CU + Δ) ^ 2) / 2) /
      (2 * (CU + Δ) * Real.sqrt (2 * Real.pi) * (T : ℝ)) ≤ f1 T Δ CU := by
  have hTp : 0 < (T : ℝ) := by exact_mod_cast (show 0 < T by omega)
  have hTr : (5 : ℝ) ≤ T := by exact_mod_cast hT
  have hlog := Drift.log_horizon_ge_one T hT
  have hroot : Real.sqrt (Real.log (T : ℝ)) ≤ (T : ℝ) := by
    apply Real.sqrt_le_iff.mpr
    refine ⟨hTp.le, ?_⟩
    have hl := Real.log_le_sub_one_of_pos hTp
    nlinarith
  unfold f1
  apply div_le_div_of_nonneg_left (Real.rpow_nonneg hTp.le _)
    (by positivity)
  rw [Real.sqrt_mul (by positivity : 0 ≤ 2 * Real.pi)]
  nlinarith only [mul_le_mul_of_nonneg_left hroot
    (show 0 ≤ 2 * (CU + Δ) * Real.sqrt (2 * Real.pi) by positivity)]

theorem exact_factor_rate_lower (T : ℕ) (Δ CU : ℝ) (hT : 8 ≤ T)
    (hΔ : 0 < Δ) (hCU : 0 < CU) :
    exactRateConstant Δ CU * (T : ℝ) ^ (-((CU + Δ) ^ 2 / 2 + 4)) ≤
      f1 T Δ CU * (SmallBall.f2 (T : ℝ) - f3 T) ^ 2 := by
  have hTp : 0 < (T : ℝ) := by exact_mod_cast (show 0 < T by omega)
  have hsum : 0 < CU + Δ := by linarith
  have hroot : 0 < Real.sqrt (2 * Real.pi) := by positivity
  have hf1 := f1_polynomial_lower T Δ CU (by omega) hΔ hCU
  have hgap := f2_minus_f3_square_lower T hT
  have heq : exactRateConstant Δ CU * (T : ℝ) ^ (-((CU + Δ) ^ 2 / 2 + 4)) =
      ((T : ℝ) ^ (-((CU + Δ) ^ 2) / 2) /
        (2 * (CU + Δ) * Real.sqrt (2 * Real.pi) * (T : ℝ))) *
        (1 / (16 * Real.pi * (T : ℝ) ^ 3)) := by
    have hpow4 : (T : ℝ) ^ (4 : ℝ) = (T : ℝ) ^ (4 : ℕ) := by
      simp
    rw [show -((CU + Δ) ^ 2 / 2 + 4) = -((CU + Δ) ^ 2) / 2 + -(4 : ℝ) by ring,
      Real.rpow_add hTp, Real.rpow_neg hTp.le, hpow4]
    unfold exactRateConstant
    field_simp [ne_of_gt hTp, ne_of_gt hsum, ne_of_gt hroot, Real.pi_ne_zero]
    ring
  rw [heq]
  exact mul_le_mul hf1 hgap (by positivity) (f1_positive T Δ CU (by omega) hΔ hCU).le

theorem exact_factor_rate_eventually (Δ CU : ℝ) (hΔ : 0 < Δ) (hCU : 0 < CU) :
    ∀ᶠ T : ℕ in atTop,
      exactRateConstant Δ CU * (T : ℝ) ^ (-((CU + Δ) ^ 2 / 2 + 4)) ≤
        f1 T Δ CU * (SmallBall.f2 (T : ℝ) - f3 T) ^ 2 := by
  filter_upwards [eventually_ge_atTop (8 : ℕ)] with T hT
  exact exact_factor_rate_lower T Δ CU hT hΔ hCU

theorem rawBadEvent_exact_rate_eventually (Δ CU : ℝ) (hΔ : 0 < Δ) (hCU : 0 < CU) :
    ∀ᶠ T : ℕ in atTop, ∀ q : ℕ, ∀ (horizon : T = 2 * q + 1),
      exactRateConstant Δ CU * (T : ℝ) ^ (-((CU + Δ) ^ 2 / 2 + 4)) ≤
        (rawArraysLaw T).real
          (rawBadEvent T q Δ CU (by omega) (by omega)) := by
  filter_upwards [exact_factor_rate_eventually Δ CU hΔ hCU,
    rawBadEvent_exact_factor_eventually Δ CU hΔ hCU] with T hfactor hraw
  intro q horizon
  exact hfactor.trans (hraw q horizon)

end

end BayesOptimal.Probability

end

/-! ## MainExactRate -/
section

open Filter

namespace BayesOptimal.Main

open BayesOptimal.Foundations.BadEvent BayesOptimal.Policy

noncomputable section

/-- The exponent explicitly proposed in the revised main proof, with CU=33.
The bound holds uniformly over all randomized posterior-optimal policies. -/
theorem theorem2_paper_exponent (Δ : ℝ) (hΔ : 0 < Δ) :
    ∃ (c : ℝ) (T0 : ℕ), 0 < c ∧
      ∀ T : ℕ, T0 ≤ T → Odd T → ∀ π : StatePolicy, AEOptimal π T →
        c * (T : ℝ)^(-((33+Δ)^2/2+4)) ≤ regret π T Δ := by
  obtain ⟨N, hN⟩ := eventually_pointwise_event_lower
  obtain ⟨M, hM⟩ := Filter.eventually_atTop.mp
    (BayesOptimal.Probability.rawBadEvent_exact_rate_eventually Δ 33 hΔ (by norm_num))
  refine ⟨Δ * BayesOptimal.Probability.exactRateConstant Δ 33, max N M,
    mul_pos hΔ (BayesOptimal.Probability.exactRateConstant_positive Δ 33 hΔ (by norm_num)), ?_⟩
  intro T hlarge hodd π hπ
  obtain ⟨q, hq⟩ := hodd
  have hTodd : T=2*q+1 := by omega
  have hp := hM T ((le_max_right N M).trans hlarge) q hTodd
  have he := hN T ((le_max_left N M).trans hlarge) q hTodd (repair π T)
    (repair_pointwiseOptimal π T) Δ hΔ.le
  rw [regret_repair_eq π T Δ hπ]
  calc
    (Δ * BayesOptimal.Probability.exactRateConstant Δ 33) * (T : ℝ)^(-((33+Δ)^2/2+4)) =
        Δ * (BayesOptimal.Probability.exactRateConstant Δ 33 * (T : ℝ)^(-((33+Δ)^2/2+4))) := mul_assoc _ _ _
    _ ≤ Δ * (rawArraysLaw T).real (BayesOptimal.Probability.rawBadEvent T q Δ 33 (by omega) (by omega)) :=
      mul_le_mul_of_nonneg_left hp hΔ.le
    _ ≤ regret (repair π T) T Δ := he

/-- The main theorem in the paper's real-exponent existential form. -/
theorem theorem2_real_exponent (Δ : ℝ) (hΔ : 0 < Δ) :
    ∃ (c C : ℝ) (T0 : ℕ), 0 < c ∧ 0 < C ∧
      ∀ T : ℕ, T0 ≤ T → Odd T → ∀ π : StatePolicy, AEOptimal π T →
        c * (T : ℝ)^(-C) ≤ regret π T Δ := by
  obtain ⟨c, T0, hc, hmain⟩ := theorem2_paper_exponent Δ hΔ
  exact ⟨c, (33+Δ)^2/2+4, T0, hc, by positivity, hmain⟩

end
end BayesOptimal.Main

end

/-! ## RegretRatio -/
section

open Filter
open scoped Topology

namespace BayesOptimal.RegretRatio

open BayesOptimal.Foundations.Rates BayesOptimal.RegretExponent

noncomputable section

/-- The paper assigns +infinity whenever the comparison regret is zero. -/
def ratio (rBayes rFreq : ℕ → ℝ) (T : ℕ) : EReal :=
  if rFreq T = 0 then ⊤ else ((rBayes T / rFreq T : ℝ) : EReal)

theorem ratio_lower (rBayes rFreq : ℕ → ℝ) (T C : ℕ) (c a : ℝ)
    (hT : 0 < T) (hc : 0 < c)
    (hpoly : c * invPower C T ≤ rBayes T)
    (hF : 0 ≤ rFreq T) (hupper : rFreq T ≤ Real.exp (-a * (T : ℝ))) :
    ((c * Real.exp (a * (T : ℝ)) / (T : ℝ) ^ C : ℝ) : EReal) ≤
      ratio rBayes rFreq T := by
  by_cases hz : rFreq T = 0
  · simp [ratio, hz]
  have hFp : 0 < rFreq T := lt_of_le_of_ne hF (Ne.symm hz)
  have hBp : 0 < rBayes T := (mul_pos hc (invPower_pos C T hT)).trans_le hpoly
  rw [ratio, if_neg hz]
  apply EReal.coe_le_coe
  calc
    _ = (c * invPower C T) / Real.exp (-a * (T : ℝ)) := by
      unfold invPower
      rw [neg_mul, Real.exp_neg, div_inv_eq_mul]
      ring
    _ ≤ rBayes T / Real.exp (-a * (T : ℝ)) :=
      div_le_div_of_nonneg_right hpoly (Real.exp_pos _).le
    _ ≤ rBayes T / rFreq T := div_le_div_of_nonneg_left hBp.le hFp hupper

theorem polynomial_exp_ratio_tendsto (C : ℕ) (c a : ℝ) (hc : 0 < c) (ha : 0 < a) :
    Tendsto (fun T : ℕ => c * Real.exp (a * (T : ℝ)) / (T : ℝ) ^ C) atTop atTop := by
  have h := ((tendsto_exp_mul_div_rpow_atTop (C : ℝ) a ha).const_mul_atTop hc).comp
    (tendsto_natCast_atTop_atTop : Tendsto (fun T : ℕ => (T : ℝ)) atTop atTop)
  simpa only [Function.comp_apply, Real.rpow_natCast, mul_div_assoc] using h

/-- Odd-horizon polynomial lower regret dominates any exponential regret
envelope, with the exact zero-denominator convention of Remark 2. -/
theorem limsup_ratio_eq_top_of_exponential_envelope
    (rBayes rFreq : ℕ → ℝ) (C : ℕ) (c a : ℝ) (hc : 0 < c) (ha : 0 < a)
    (hpoly : ∀ᶠ T : ℕ in atTop, Odd T → c * invPower C T ≤ rBayes T)
    (hF : ∀ T, 0 ≤ rFreq T)
    (hupper : ∀ᶠ T : ℕ in atTop, rFreq T ≤ Real.exp (-a * (T : ℝ))) :
    limsup (ratio rBayes rFreq) atTop = ⊤ := by
  have hlarge := (polynomial_exp_ratio_tendsto C c a hc ha).comp oddBudget_tendsto
  have hodd : Tendsto (fun n : ℕ => ratio rBayes rFreq (oddBudget n)) atTop (𝓝 ⊤) := by
    apply EReal.tendsto_nhds_top_iff_real.mpr
    intro x
    filter_upwards [hlarge.eventually_gt_atTop x,
      oddBudget_tendsto.eventually hpoly, oddBudget_tendsto.eventually hupper]
      with n hn hp hu
    have hh : Odd (oddBudget n) := ⟨n, by unfold oddBudget; omega⟩
    have hl := ratio_lower rBayes rFreq (oddBudget n) C c a
      (by unfold oddBudget; omega) hc (hp hh) (hF _) hu
    exact (EReal.coe_lt_coe_iff.mpr hn).trans_le hl
  have hsub : limsup (ratio rBayes rFreq) (map oddBudget atTop) ≤
      limsup (ratio rBayes rFreq) atTop := limsup_le_limsup_of_le oddBudget_tendsto
  rw [← limsup_comp] at hsub
  change limsup (fun n => ratio rBayes rFreq (oddBudget n)) atTop ≤ _ at hsub
  rw [hodd.limsup_eq] at hsub
  exact top_le_iff.mp hsub

/-- A positive extended-real frequentist rate supplies a positive exponential
envelope, even when some regrets are zero. -/
theorem exponential_envelope_of_positive_rate (r : ℕ → ℝ) (hr : ∀ T, 0 ≤ r T)
    (hpositive : 0 < liminf (rate r) atTop) :
    ∃ a : ℝ, 0 < a ∧ ∀ᶠ T : ℕ in atTop, r T ≤ Real.exp (-a * (T : ℝ)) := by
  obtain ⟨a, ha0, ha⟩ := EReal.exists_between_coe_real hpositive
  have hap : 0 < a := EReal.coe_lt_coe_iff.mp (by simpa only [EReal.coe_zero] using ha0)
  refine ⟨a, hap, ?_⟩
  filter_upwards [eventually_lt_of_lt_liminf ha, eventually_ge_atTop (1 : ℕ)]
    with T hrate hT
  by_cases hz : r T = 0
  · rw [hz]
    exact (Real.exp_pos _).le
  have hrp : 0 < r T := lt_of_le_of_ne (hr T) (Ne.symm hz)
  have hTp : 0 < (T : ℝ) := by exact_mod_cast (show 0 < T by omega)
  rw [rate, if_neg hz] at hrate
  have hreal := EReal.coe_lt_coe_iff.mp hrate
  apply (Real.log_le_iff_le_exp hrp).mp
  have hprod := (lt_div_iff₀ hTp).mp hreal
  linarith only [hprod]

theorem limsup_ratio_eq_top_of_positive_rate
    (rBayes rFreq : ℕ → ℝ) (C : ℕ) (c : ℝ) (hc : 0 < c)
    (hpoly : ∀ᶠ T : ℕ in atTop, Odd T → c * invPower C T ≤ rBayes T)
    (hF : ∀ T, 0 ≤ rFreq T) (hpositive : 0 < liminf (rate rFreq) atTop) :
    limsup (ratio rBayes rFreq) atTop = ⊤ := by
  obtain ⟨a, ha, hupper⟩ := exponential_envelope_of_positive_rate rFreq hF hpositive
  exact limsup_ratio_eq_top_of_exponential_envelope rBayes rFreq C c a hc ha hpoly hF hupper

/-- Revised Remark 2 for every posterior-optimal policy family and every
nonnegative comparison regret with a positive frequentist rate. -/
theorem remark2 (Δ : ℝ) (hΔ : 0 < Δ) (family : ℕ → BayesOptimal.Policy.StatePolicy)
    (hfamily : ∀ T, 3 ≤ T → BayesOptimal.Policy.AEOptimal (family T) T)
    (rFreq : ℕ → ℝ) (hF : ∀ T, 0 ≤ rFreq T)
    (hpositive : 0 < liminf (rate rFreq) atTop) :
    limsup (ratio (fun T => BayesOptimal.Main.regret (family T) T Δ) rFreq) atTop = ⊤ := by
  obtain ⟨c, C, T0, hc, _, hmain⟩ := BayesOptimal.Main.theorem2 Δ hΔ
  apply limsup_ratio_eq_top_of_positive_rate _ rFreq C c hc _ hF hpositive
  filter_upwards [eventually_ge_atTop (max T0 3)] with T hT
  intro hodd
  exact hmain T ((le_max_left T0 3).trans hT) hodd (family T)
    (hfamily T ((le_max_right T0 3).trans hT))

end

end BayesOptimal.RegretRatio

end

/-! ## SequentialRisk -/
section

open MeasureTheory ProbabilityTheory Filter
open scoped NNReal ENNReal

namespace BayesOptimal.SequentialRisk

open BayesOptimal.Foundations.BayesianModel
open BayesOptimal.Policy BayesOptimal.PolicyContinuation BayesOptimal.CountModelBridge
open BayesOptimal.EmbeddingRaw BayesOptimal.EmbeddingExecution BayesOptimal.EmbeddingRandomized

noncomputable section

/-- A continuation family sees an independent Gaussian seed for each draw
and for the terminal recommendation. Its raw tree sees only selected rewards. -/
abbrev Family (H : ℕ) := Seeds H → BayesOptimal.FiniteGaussian.Strategy (A := Arm) H

def Feasible {H : ℕ} (s : Family H) : Prop :=
  (∀ u, Regular (s u)) ∧
    Measurable (fun p : Seeds H × RawStream Arm H => run (s p.1) p.2)

/-- Actual posterior expected simple regret, integrated over independent
policy seeds and the latent Gaussian/noise-array world used by rawRisk. -/
def familyRisk {H : ℕ} (s : Family H) (c : Counts) (m : Means) : ℝ :=
  ∫ u, rawRisk (s u) (natPrecisions c) m ∂seedLaw (H + 1)

def continuationRisk (π : StatePolicy) (t H : ℕ) (c : Counts) (m : Means) : ℝ :=
  familyRisk (rawTree π t H c m) c m

/-- This is risk minimization, with no Bellman-action premise. Competitors
are regular Borel raw-history trees with independent Gaussian randomization. -/
def MinimizesActualRisk (π : StatePolicy) (t H : ℕ) (c : Counts) (m : Means) : Prop :=
  ∀ s : Family H, Feasible s → continuationRisk π t H c m ≤ familyRisk s c m

/-- Sequential actual-risk minimization at all proper integer-count states.
The hypothesis is stated in actual posterior regret, not local action values. -/
def SequentialRiskOptimal (π : StatePolicy) (T : ℕ) : Prop :=
  (∀ (t : ℕ) (c : Counts) (m : Means), 4 ≤ t → t ≤ T → (∀ a, 0 < c a) →
    MinimizesActualRisk π t (T - t + 1) c m) ∧
  (∀ (c : Counts) (m : Means), (∀ a, 0 < c a) →
    MinimizesActualRisk π (T + 1) 0 c m)

theorem rawTree_feasible (π : StatePolicy) (t H : ℕ) (c : Counts) (m : Means) :
    Feasible (rawTree π t H c m) := by
  constructor
  · exact rawTree_regular π t H c m
  · exact (rawTree_run_measurable π t H c).comp
      (measurable_const.prodMk measurable_id)

theorem familyRisk_integrable {H : ℕ} (s : Family H) (c : Counts) (m : Means)
    (hs : Feasible s) :
    Integrable (fun u => rawRisk (s u) (natPrecisions c) m) (seedLaw (H + 1)) :=
  randomized_rawRisk_integrable (seedLaw (H + 1)) s (natPrecisions c) m hs.2

theorem familyRisk_eq_joint {H : ℕ} (s : Family H) (c : Counts) (m : Means)
    (hs : Feasible s) :
    familyRisk s c m =
      ∫ p : Seeds H × (BayesOptimal.FiniteGaussian.Means Arm × RawStream Arm H),
        randomizedPayoff s p
        ∂(seedLaw (H + 1)).prod (worldLaw H (natPrecisions c) m) := by
  exact (integral_prod _
    (randomizedPayoff_integrable (seedLaw (H + 1)) s (natPrecisions c) m hs.2)).symm

theorem familyRisk_ge_loss {H : ℕ} (s : Family H) (c : Counts) (m : Means)
    (hs : Feasible s) (hc : ∀ a, 0 < c a) :
    BayesOptimal.FinitePosterior.loss H (natPrecisions c) m ≤ familyRisk s c m :=
  randomized_rawRisk_ge_loss (seedLaw (H + 1)) s (natPrecisions c) m
    (natPrecisions_positive c hc) hs.1 hs.2

def canonicalFamily (H : ℕ) (c : Counts) (m : Means) : Family H :=
  fun _ => rawOfInnovation (BayesOptimal.FiniteModelMeasurable.optimalFirst H (natPrecisions c) m)
    (natPrecisions c) m

theorem canonicalFamily_feasible (H : ℕ) (c : Counts) (m : Means) :
    Feasible (canonicalFamily H c m) := by
  constructor
  · intro _
    exact optimalFirst_raw_regular H (natPrecisions c) m
  · exact (regular_run_measurable _
      (optimalFirst_raw_regular H (natPrecisions c) m)).comp measurable_snd

/-- The comparator risk identity is derived from the actual Gaussian
observation model by the proved raw-observation execution bridge. -/
theorem canonicalFamily_risk (H : ℕ) (c : Counts) (m : Means) (hc : ∀ a, 0 < c a) :
    familyRisk (canonicalFamily H c m) c m =
      BayesOptimal.FinitePosterior.loss H (natPrecisions c) m := by
  unfold familyRisk canonicalFamily
  simp only [optimalFirst_rawRisk H (natPrecisions c) m (natPrecisions_positive c hc)]
  simp

theorem minimizing_risk_le_loss (π : StatePolicy) (t H : ℕ) (c : Counts) (m : Means)
    (hc : ∀ a, 0 < c a) (hπ : MinimizesActualRisk π t H c m) :
    continuationRisk π t H c m ≤ BayesOptimal.FinitePosterior.loss H (natPrecisions c) m := by
  have h := hπ (canonicalFamily H c m) (canonicalFamily_feasible H c m)
  rwa [canonicalFamily_risk H c m hc] at h

theorem minimizing_risk_eq_loss (π : StatePolicy) (t H : ℕ) (c : Counts) (m : Means)
    (hc : ∀ a, 0 < c a) (hπ : MinimizesActualRisk π t H c m) :
    continuationRisk π t H c m = BayesOptimal.FinitePosterior.loss H (natPrecisions c) m :=
  le_antisymm (minimizing_risk_le_loss π t H c m hc hπ)
    (familyRisk_ge_loss _ c m (rawTree_feasible π t H c m) hc)

theorem integrable_finite_selector {Ω : Type*} [MeasurableSpace Ω]
    (μ : Measure Ω) [IsFiniteMeasure μ] (f : Arm → ℝ) (a : Ω → Arm)
    (ha : Measurable a) : Integrable (fun u => f (a u)) μ := by
  have hm : Measurable (fun u => f (a u)) := (measurable_of_countable f).comp ha
  apply (integrable_const (∑ b : Arm, |f b|)).mono' hm.aestronglyMeasurable
  apply Filter.Eventually.of_forall
  intro u
  rw [Real.norm_eq_abs]
  exact Finset.single_le_sum (fun b _ => abs_nonneg (f b)) (Finset.mem_univ (a u))

theorem ae_eq_const_of_lower_integral {Ω : Type*} [MeasurableSpace Ω]
    (μ : Measure Ω) [IsProbabilityMeasure μ] (f : Ω → ℝ) (a : ℝ)
    (hi : Integrable f μ) (hl : ∀ u, a ≤ f u) (hu : (∫ u, f u ∂μ) ≤ a) :
    ∀ᵐ u ∂μ, f u = a := by
  have hlo : (∫ _ : Ω, a ∂μ) ≤ ∫ u, f u ∂μ :=
    integral_mono (integrable_const a) hi hl
  have he : (∫ _ : Ω, a ∂μ) = ∫ u, f u ∂μ := by
    simp only [integral_const, measureReal_univ_eq_one, one_smul] at hlo ⊢
    exact le_antisymm hlo hu
  exact ((integral_eq_iff_of_ae_le (integrable_const a) hi
    (Filter.Eventually.of_forall hl)).mp he).symm

theorem seed_head_ae (H : ℕ) (p : ℝ → Prop) (hp : MeasurableSet {u | p u})
    (h : ∀ᵐ u : Seeds H ∂seedLaw (H + 1), p (u ⟨0, by omega⟩)) :
    ∀ᵐ u : ℝ ∂gaussianReal 0 1, p u := by
  let head : Seeds H → ℝ := fun u => u ⟨0, by omega⟩
  have hm : Measurable head := measurable_pi_apply (⟨0, by omega⟩ : Fin (H + 1))
  have hmap : (seedLaw (H + 1)).map head = gaussianReal 0 1 :=
    (measurePreserving_eval (fun _ : Fin (H + 1) => gaussianReal 0 1)
      (⟨0, by omega⟩ : Fin (H + 1))).map_eq
  have hh : ∀ᵐ u : ℝ ∂(seedLaw (H + 1)).map head, p u :=
    (ae_map_iff hm.aemeasurable hp).mpr h
  rwa [hmap] at hh

theorem minimizing_draw_ae (π : StatePolicy) (t H : ℕ) (c : Counts) (m : Means)
    (hc : ∀ a, 0 < c a) (hπ : MinimizesActualRisk π t (H + 1) c m) :
    ∀ᵐ u : ℝ ∂gaussianReal 0 1,
      action H c m (π.draw t c m u) = value (H + 1) c m := by
  let a : Seeds (H + 1) → Arm := fun u => π.draw t c m (u ⟨0, by omega⟩)
  let f : Seeds (H + 1) → ℝ := fun u =>
    BayesOptimal.FinitePosterior.actionLoss H (natPrecisions c) m (a u)
  have ha : Measurable a := (π.draw_measurable t).comp
    (measurable_const.prodMk (measurable_const.prodMk (measurable_pi_apply _)))
  have hi : Integrable f (seedLaw (H + 2)) :=
    integrable_finite_selector _ _ a ha
  have hpoint (u : Seeds (H + 1)) :
      f u ≤ rawRisk (rawTree π t (H + 1) c m u) (natPrecisions c) m := by
    exact rawRisk_ge_actionLoss (a u) _ (natPrecisions c) m
      (natPrecisions_positive c hc) (rawTree_regular π t (H + 1) c m u)
  have hupper : (∫ u, f u ∂seedLaw (H + 2)) ≤
      BayesOptimal.FinitePosterior.loss (H + 1) (natPrecisions c) m := by
    exact (integral_mono hi
      (familyRisk_integrable _ c m (rawTree_feasible π t (H + 1) c m)) hpoint).trans
      (minimizing_risk_le_loss π t (H + 1) c m hc hπ)
  have he := ae_eq_const_of_lower_integral (seedLaw (H + 2)) f
    (BayesOptimal.FinitePosterior.loss (H + 1) (natPrecisions c) m) hi
    (fun u => BayesOptimal.DecisionRules.actionLoss_minimal H (natPrecisions c) m
      (natPrecisions_positive c hc) (a u)) hupper
  have hh : ∀ᵐ u : Seeds (H + 1) ∂seedLaw (H + 2),
      action H c m (π.draw t c m (u ⟨0, by omega⟩)) = value (H + 1) c m := by
    filter_upwards [he] with u hu
    exact (CountModelBridge.actionLoss_eq_loss_iff H c m (a u) (hc (a u))).mp hu
  have hp : MeasurableSet {u : ℝ |
      action H c m (π.draw t c m u) = value (H + 1) c m} := by
    have hd : Measurable (π.draw t c m) := (π.draw_measurable t).comp
      (measurable_const.prodMk (measurable_const.prodMk measurable_id))
    exact measurableSet_eq_fun ((measurable_of_countable (action H c m)).comp hd)
      measurable_const
  exact seed_head_ae (H + 1) _ hp hh

theorem minimizing_recommend_ae (π : StatePolicy) (t : ℕ) (c : Counts) (m : Means)
    (hc : ∀ a, 0 < c a) (hπ : MinimizesActualRisk π t 0 c m) :
    ∀ᵐ u : ℝ ∂gaussianReal 0 1, m (π.recommend c m u) = terminal m := by
  let a : Seeds 0 → Arm := fun u => π.recommend c m (u ⟨0, by omega⟩)
  let f : Seeds 0 → ℝ := fun u =>
    BayesOptimal.FinitePosterior.terminalRegret (natPrecisions c) m (a u)
  have ha : Measurable a := π.recommend_measurable.comp
    (measurable_const.prodMk (measurable_const.prodMk (measurable_pi_apply _)))
  have hi : Integrable f (seedLaw 1) := integrable_finite_selector _ _ a ha
  have hf (u : Seeds 0) : f u = rawRisk (rawTree π t 0 c m u) (natPrecisions c) m := by
    exact (rawRisk_zero (a u) (natPrecisions c) m).symm
  have hupper : (∫ u, f u ∂seedLaw 1) ≤
      BayesOptimal.FinitePosterior.loss 0 (natPrecisions c) m := by
    simpa only [hf] using minimizing_risk_le_loss π t 0 c m hc hπ
  have hl (u : Seeds 0) : BayesOptimal.FinitePosterior.loss 0 (natPrecisions c) m ≤ f u := by
    rw [hf]
    exact rawRisk_ge_loss _ _ _ (natPrecisions_positive c hc)
      (rawTree_regular π t 0 c m u)
  have he := ae_eq_const_of_lower_integral (seedLaw 1) f
    (BayesOptimal.FinitePosterior.loss 0 (natPrecisions c) m) hi hl hupper
  have hh : ∀ᵐ u : Seeds 0 ∂seedLaw 1,
      m (π.recommend c m (u ⟨0, by omega⟩)) = terminal m := by
    filter_upwards [he] with u hu
    change BayesOptimal.FinitePosterior.terminalRegret (natPrecisions c) m (a u) = _ at hu
    rw [BayesOptimal.FinitePosterior.terminalRegret_eq] at hu
    unfold BayesOptimal.FinitePosterior.loss at hu
    rw [CountModelBridge.value_eq, BayesOptimal.Foundations.BayesianModel.value] at hu
    linarith
  have hp : MeasurableSet {u : ℝ | m (π.recommend c m u) = terminal m} := by
    have hd : Measurable (π.recommend c m) := π.recommend_measurable.comp
      (measurable_const.prodMk (measurable_const.prodMk measurable_id))
    exact measurableSet_eq_fun ((measurable_of_countable m).comp hd) measurable_const
  exact seed_head_ae 0 _ hp hh

/-- Actual sequential posterior-regret minimization implies the local
almost-everywhere Bellman optimality needed by the frequentist main proof. -/
theorem sequentialRiskOptimal_implies_aeOptimal (π : StatePolicy) (T : ℕ)
    (hπ : SequentialRiskOptimal π T) : AEOptimal π T := by
  constructor
  · intro t c m ht htT hc
    exact minimizing_draw_ae π t (T - t) c m hc (hπ.1 t c m ht htT hc)
  · intro c m hc
    exact minimizing_recommend_ae π (T + 1) c m hc (hπ.2 c m hc)

/-- The measurable deterministic Bellman state policy attains the minimum
against all feasible randomized raw-history competitors. -/
theorem deterministicBellman_minimizes_actual_risk (T t H : ℕ) (c : Counts) (m : Means)
    (horizon : t + H = T + 1) (hc : ∀ a, 0 < c a) :
    MinimizesActualRisk (deterministicBellman T) t H c m := by
  intro s hs
  have he : continuationRisk (deterministicBellman T) t H c m =
      BayesOptimal.FinitePosterior.loss H (natPrecisions c) m := by
    unfold continuationRisk familyRisk
    simp only [BayesOptimal.PolicyContinuationOptimal.deterministicBellman_rawRisk T t H c m
      _ horizon hc]
    simp
  rw [he]
  exact familyRisk_ge_loss s c m hs hc

/-- In particular the actual-risk policy class used by the main wrapper has
an explicitly constructed measurable policy at every horizon. -/
theorem deterministicBellman_sequentialRiskOptimal (T : ℕ) :
    SequentialRiskOptimal (deterministicBellman T) T := by
  constructor
  · intro t c m _ htT hc
    exact deterministicBellman_minimizes_actual_risk T t (T - t + 1) c m (by omega) hc
  · intro c m hc
    exact deterministicBellman_minimizes_actual_risk T (T + 1) 0 c m (by omega) hc

theorem exists_sequentialRiskOptimal (T : ℕ) :
    ∃ π : StatePolicy, SequentialRiskOptimal π T :=
  ⟨deterministicBellman T, deterministicBellman_sequentialRiskOptimal T⟩

/-- Main polynomial bound with only actual sequential-risk optimality as
the policy hypothesis. Local Bellman optimality is derived inside Lean. -/
theorem theorem2_sequentialRiskOptimal (Δ : ℝ) (hΔ : 0 < Δ) :
    ∃ (c : ℝ) (C T0 : ℕ), 0 < c ∧ 0 < C ∧
      ∀ T : ℕ, T0 ≤ T → Odd T → ∀ π : StatePolicy, SequentialRiskOptimal π T →
        c * BayesOptimal.Foundations.Rates.invPower C T ≤ BayesOptimal.Main.regret π T Δ := by
  obtain ⟨c, C, T0, hc, hC, hmain⟩ := BayesOptimal.Main.theorem2 Δ hΔ
  exact ⟨c, C, T0, hc, hC, fun T hT ho π hπ =>
    hmain T hT ho π (sequentialRiskOptimal_implies_aeOptimal π T hπ)⟩

theorem theorem2_paper_exponent_sequentialRiskOptimal (Δ : ℝ) (hΔ : 0 < Δ) :
    ∃ (c : ℝ) (T0 : ℕ), 0 < c ∧
      ∀ T : ℕ, T0 ≤ T → Odd T → ∀ π : StatePolicy, SequentialRiskOptimal π T →
        c * (T : ℝ)^(-((33+Δ)^2/2+4)) ≤ BayesOptimal.Main.regret π T Δ := by
  obtain ⟨c, T0, hc, hmain⟩ := BayesOptimal.Main.theorem2_paper_exponent Δ hΔ
  exact ⟨c, T0, hc, fun T hT ho π hπ =>
    hmain T hT ho π (sequentialRiskOptimal_implies_aeOptimal π T hπ)⟩

theorem theorem2_exponential_rate_sequentialRiskOptimal (Δ : ℝ) (hΔ : 0 < Δ)
    (family : ℕ → StatePolicy)
    (hfamily : ∀ T, 3 ≤ T → SequentialRiskOptimal (family T) T) :
    Filter.liminf (BayesOptimal.RegretExponent.rate
      (fun T => BayesOptimal.Main.regret (family T) T Δ)) atTop = 0 :=
  BayesOptimal.Main.theorem2_exponential_rate Δ hΔ family
    (fun T hT => sequentialRiskOptimal_implies_aeOptimal (family T) T (hfamily T hT))

theorem remark2_sequentialRiskOptimal (Δ : ℝ) (hΔ : 0 < Δ)
    (family : ℕ → StatePolicy)
    (hfamily : ∀ T, 3 ≤ T → SequentialRiskOptimal (family T) T)
    (rFreq : ℕ → ℝ) (hF : ∀ T, 0 ≤ rFreq T)
    (hpositive : 0 < liminf (BayesOptimal.RegretExponent.rate rFreq) atTop) :
    limsup (BayesOptimal.RegretRatio.ratio
      (fun T => BayesOptimal.Main.regret (family T) T Δ) rFreq) atTop = ⊤ :=
  BayesOptimal.RegretRatio.remark2 Δ hΔ family
    (fun T hT => sequentialRiskOptimal_implies_aeOptimal (family T) T (hfamily T hT))
    rFreq hF hpositive

end
end BayesOptimal.SequentialRisk

end

/-! ## InitialOptimalDisintegration -/
section

open MeasureTheory ProbabilityTheory
open scoped NNReal ENNReal

namespace BayesOptimal.InitialOptimal

open BayesOptimal.FiniteGaussian BayesOptimal.FinitePosterior
open BayesOptimal.EmbeddingRaw BayesOptimal.EmbeddingExecution

noncomputable section

/-- An almost-sure property of a raw observation and all remaining calendar
noise can be checked in the posterior-innovation representation. -/
theorem observation_ae_transfer {H : ℕ} (c : Precisions BayesOptimal.Foundations.BayesianModel.Arm)
    (m : Means BayesOptimal.Foundations.BayesianModel.Arm) (a : BayesOptimal.Foundations.BayesianModel.Arm)
    (hc : 0 < c a)
    (P : (Means BayesOptimal.Foundations.BayesianModel.Arm × ℝ) ×
      RawStream BayesOptimal.Foundations.BayesianModel.Arm H → Prop)
    (hP : MeasurableSet {p | P p})
    (hpost : ∀ᵐ p ∂((gaussianReal 0 (innovation c a)).prod
      (centeredLaw (advance c a))).prod (arrayLaw H),
      P (ObservationBridge.reconstructedObservation c m a p.1, p.2)) :
    ∀ᵐ p ∂((posteriorLaw c m).prod (gaussianReal 0 1)).prod (arrayLaw H),
      P (ObservationBridge.rawObservation a p.1, p.2) := by
  let f := ObservationBridge.rawObservation a
  let g := ObservationBridge.reconstructedObservation c m a
  have hf : MeasurePreserving f ((posteriorLaw c m).prod (gaussianReal 0 1))
      (((posteriorLaw c m).prod (gaussianReal 0 1)).map f) :=
    ⟨by fun_prop, rfl⟩
  have hg : MeasurePreserving g
      ((gaussianReal 0 (innovation c a)).prod (centeredLaw (advance c a)))
      (((gaussianReal 0 (innovation c a)).prod (centeredLaw (advance c a))).map g) :=
    ⟨by fun_prop, rfl⟩
  have hmap :
      ((((posteriorLaw c m).prod (gaussianReal 0 1)).map f).prod
        (arrayLaw (A := BayesOptimal.Foundations.BayesianModel.Arm) H)) =
      ((((gaussianReal 0 (innovation c a)).prod
        (centeredLaw (advance c a))).map g).prod
          (arrayLaw (A := BayesOptimal.Foundations.BayesianModel.Arm) H)) := by
    rw [ObservationBridge.observation_joint_law c m a hc]
  have hgprod := hg.prod (MeasurePreserving.id (arrayLaw (A := BayesOptimal.Foundations.BayesianModel.Arm) H))
  have hp : ∀ᵐ p ∂((((gaussianReal 0 (innovation c a)).prod
      (centeredLaw (advance c a))).map g).prod (arrayLaw H)), P p := by
    rw [← hgprod.map_eq]
    exact (ae_map_iff hgprod.measurable.aemeasurable hP).mpr hpost
  rw [← hmap] at hp
  exact (hf.prod (MeasurePreserving.id
    (arrayLaw (A := BayesOptimal.Foundations.BayesianModel.Arm) H))).quasiMeasurePreserving.ae hp

/-- Equal conditional recommendations after one actual Gaussian observation
give equal parent recommendations. All remaining observations use the same
latent parameter and the same calendar-noise array. -/
theorem sample_run_ae_of_conditional {H : ℕ}
    (a : BayesOptimal.Foundations.BayesianModel.Arm)
    (s r : ℝ → Strategy (A := BayesOptimal.Foundations.BayesianModel.Arm) H)
    (c : Precisions BayesOptimal.Foundations.BayesianModel.Arm) (m : Means BayesOptimal.Foundations.BayesianModel.Arm)
    (hc : 0 < c a)
    (hs : Measurable (fun p : ℝ × RawStream BayesOptimal.Foundations.BayesianModel.Arm H =>
      run (s p.1) p.2))
    (hr : Measurable (fun p : ℝ × RawStream BayesOptimal.Foundations.BayesianModel.Arm H =>
      run (r p.1) p.2))
    (hcond : ∀ᵐ z ∂gaussianReal 0 (innovation c a),
      ∀ᵐ w ∂worldLaw H (advance c a) (shift m a z),
        run (s (m a + ((c a : ℝ) + 1) * z)) (observations w) =
          run (r (m a + ((c a : ℝ) + 1) * z)) (observations w)) :
    ∀ᵐ w ∂worldLaw (H + 1) c m,
      run (.sample a s) (observations w) = run (.sample a r) (observations w) := by
  let P : (Means BayesOptimal.Foundations.BayesianModel.Arm × ℝ) ×
      RawStream BayesOptimal.Foundations.BayesianModel.Arm H → Prop := fun p =>
    run (s p.1.2) (observations (p.1.1, p.2)) =
      run (r p.1.2) (observations (p.1.1, p.2))
  have hP : MeasurableSet {p | P p} := by
    have hin : Measurable (fun p : (Means BayesOptimal.Foundations.BayesianModel.Arm × ℝ) ×
        RawStream BayesOptimal.Foundations.BayesianModel.Arm H => (p.1.2, observations (p.1.1, p.2))) := by
      unfold observations
      fun_prop
    apply measurableSet_eq_fun_of_countable
    · exact hs.comp hin
    · exact hr.comp hin
  have hpost' : ∀ᵐ p : ℝ ×
      (Means BayesOptimal.Foundations.BayesianModel.Arm × RawStream BayesOptimal.Foundations.BayesianModel.Arm H)
      ∂(gaussianReal 0 (innovation c a)).prod ((centeredLaw (advance c a)).prod (arrayLaw H)),
      P (ObservationBridge.reconstructedObservation c m a (p.1, p.2.1), p.2.2) := by
    apply (Measure.ae_prod_iff_ae_ae (by
      exact hP.preimage (by fun_prop))).mpr
    filter_upwards [hcond] with z hz
    have ht : MeasurePreserving (fun w : Means BayesOptimal.Foundations.BayesianModel.Arm ×
        RawStream BayesOptimal.Foundations.BayesianModel.Arm H => (shift m a z + w.1, w.2))
        ((centeredLaw (advance c a)).prod (arrayLaw H))
        (worldLaw H (advance c a) (shift m a z)) := by
      have htrans : MeasurePreserving (fun v : Means BayesOptimal.Foundations.BayesianModel.Arm =>
          shift m a z + v) (centeredLaw (advance c a))
          (posteriorLaw (advance c a) (shift m a z)) := ⟨by fun_prop, rfl⟩
      exact htrans.prod (MeasurePreserving.id (arrayLaw H))
    exact ht.quasiMeasurePreserving.ae hz
  have hpost : ∀ᵐ p ∂((gaussianReal 0 (innovation c a)).prod
      (centeredLaw (advance c a))).prod (arrayLaw H),
      P (ObservationBridge.reconstructedObservation c m a p.1, p.2) := by
    exact (measurePreserving_prodAssoc (gaussianReal 0 (innovation c a))
      (centeredLaw (advance c a)) (arrayLaw H)).quasiMeasurePreserving.ae hpost'
  have hraw := observation_ae_transfer c m a hc P hP hpost
  have hsplit := (MeasurePreserving.symm MeasurableEquiv.prodAssoc
    (measurePreserving_prodAssoc (posteriorLaw c m) (gaussianReal 0 1) (arrayLaw H))).comp
      ((MeasurePreserving.id (posteriorLaw c m)).prod (selected_noise_split_preserving H a))
  exact hsplit.quasiMeasurePreserving.ae hraw

end
end BayesOptimal.InitialOptimal

end

/-! ## InitialOptimalPaths -/
section

open MeasureTheory ProbabilityTheory
open scoped NNReal ENNReal

namespace BayesOptimal.InitialOptimal

open BayesOptimal.Foundations.BayesianModel
open BayesOptimal.Policy BayesOptimal.PolicyContinuation BayesOptimal.CountModelBridge
open BayesOptimal.EmbeddingRaw BayesOptimal.EmbeddingExecution BayesOptimal.SequentialRisk

noncomputable section

/-- Initial actual-risk minimization forces the risk of almost every fixed
seed tree to equal the Bellman optimum. No local optimality is assumed. -/
theorem minimizing_seed_risk_eq (π : StatePolicy) (t H : ℕ) (c : Counts) (m : Means)
    (hc : ∀ a, 0 < c a) (hπ : MinimizesActualRisk π t H c m) :
    ∀ᵐ u ∂seedLaw (H + 1),
      rawRisk (rawTree π t H c m u) (natPrecisions c) m =
        BayesOptimal.FinitePosterior.loss H (natPrecisions c) m := by
  exact ae_eq_const_of_lower_integral _ _ _
    (familyRisk_integrable _ c m (rawTree_feasible π t H c m))
    (fun u => rawRisk_ge_loss _ _ _ (natPrecisions_positive c hc)
      (rawTree_regular π t H c m u))
    (minimizing_risk_le_loss π t H c m hc hπ)

/-- A fixed seed tree attaining the actual Bayes optimum agrees almost
surely with the measurable pointwise-optimal repair, on its actual Gaussian
execution. The induction derives optimality of every reached decision from
initial risk equality. -/
theorem exact_seed_repair_ae (π : StatePolicy) (T t H : ℕ) (c : Counts) (m : Means)
    (u : Seeds H) (horizon : t + H = T + 1) (ht : 4 ≤ t)
    (hc : ∀ a, 0 < c a)
    (heq : rawRisk (rawTree π t H c m u) (natPrecisions c) m =
      BayesOptimal.FinitePosterior.loss H (natPrecisions c) m) :
    ∀ᵐ w ∂worldLaw H (natPrecisions c) m,
      run (rawTree π t H c m u) (observations w) =
        run (rawTree (repair π T) t H c m u) (observations w) := by
  induction H generalizing t c m with
  | zero =>
      have hgood : m (π.recommend c m (u ⟨0, by omega⟩)) = terminal m := by
        rw [rawTree_zero, rawRisk_zero, BayesOptimal.FinitePosterior.terminalRegret_eq] at heq
        unfold BayesOptimal.FinitePosterior.loss at heq
        rw [value_eq, BayesOptimal.Foundations.BayesianModel.value] at heq
        linarith
      exact Filter.Eventually.of_forall (fun _ => by
        simp only [rawTree, run, repair, repairedRecommend, if_pos hgood])
  | succ H ih =>
      have hremaining : T - t = H := by omega
      let a := π.draw t c m (u ⟨0, by omega⟩)
      let next : ℝ → BayesOptimal.FiniteGaussian.Strategy (A := Arm) H := fun y =>
        rawTree π (t + 1) H (advance c a)
          (shift m a ((y - m a) / ((c a : ℝ) + 1))) (seedTail u)
      have htree : rawTree π t (H + 1) c m u = .sample a next := rfl
      have hreg : Regular (.sample a next) := by
        rw [← htree]
        exact rawTree_regular π t (H + 1) c m u
      have hca : ∀ b, 0 < advance c a b := by
        intro b
        have hb := hc b
        simp only [advance]
        omega
      have hact : BayesOptimal.FinitePosterior.actionLoss H (natPrecisions c) m a =
          BayesOptimal.FinitePosterior.loss (H + 1) (natPrecisions c) m := by
        apply le_antisymm
        · calc
            _ ≤ rawRisk (.sample a next) (natPrecisions c) m :=
              rawRisk_ge_actionLoss a next _ _ (natPrecisions_positive c hc) hreg
            _ = _ := by rw [← htree, heq]
        · exact BayesOptimal.DecisionRules.actionLoss_minimal H _ _
            (natPrecisions_positive c hc) a
      have hgood : action (T - t) c m (π.draw t c m (u ⟨0, by omega⟩)) =
          value (T - t + 1) c m := by
        rw [hremaining]
        exact (actionLoss_eq_loss_iff H c m a (hc a)).mp hact
      have hrepair : (repair π T).draw t c m (u ⟨0, by omega⟩) = a := by
        simp only [repair, repairedDraw, if_pos hgood]
        rfl
      let nextRepair : ℝ → BayesOptimal.FiniteGaussian.Strategy (A := Arm) H := fun y =>
        rawTree (repair π T) (t + 1) H (advance c a)
          (shift m a ((y - m a) / ((c a : ℝ) + 1))) (seedTail u)
      have htreeRepair : rawTree (repair π T) t (H + 1) c m u =
          .sample a nextRepair := by
        simp only [rawTree, hrepair]
        rfl
      have hregRepair : Regular (.sample a nextRepair) := by
        rw [← htreeRepair]
        exact rawTree_regular (repair π T) t (H + 1) c m u
      have hdata := rawRisk_succ_data a next (natPrecisions c) m
        (natPrecisions_positive c hc a) hreg.2
      have hlowint : Integrable (fun z => BayesOptimal.FinitePosterior.loss H
          (BayesOptimal.FiniteGaussian.advance (natPrecisions c) a)
          (BayesOptimal.FiniteGaussian.shift m a z))
          (gaussianReal 0 (BayesOptimal.FiniteGaussian.innovation (natPrecisions c) a)) :=
        (BayesOptimal.FiniteGaussian.shifted_integrable (BayesOptimal.FinitePosterior.potential_lipschitz _)
          m a _).sub (BayesOptimal.FiniteGaussian.action_integrable H (natPrecisions c) m a)
      have hlow (z : ℝ) : BayesOptimal.FinitePosterior.loss H
          (BayesOptimal.FiniteGaussian.advance (natPrecisions c) a)
          (BayesOptimal.FiniteGaussian.shift m a z) ≤
          rawRisk (next (m a + (((natPrecisions c a : ℝ≥0) : ℝ) + 1) * z))
            (BayesOptimal.FiniteGaussian.advance (natPrecisions c) a)
            (BayesOptimal.FiniteGaussian.shift m a z) :=
        rawRisk_ge_loss _ _ _
          (BayesOptimal.FinitePosterior.advance_positive _ a (natPrecisions_positive c hc))
          (hreg.1 _)
      have hchild : ∀ᵐ z ∂gaussianReal 0
          (BayesOptimal.FiniteGaussian.innovation (natPrecisions c) a),
          rawRisk (next (m a + (((natPrecisions c a : ℝ≥0) : ℝ) + 1) * z))
            (BayesOptimal.FiniteGaussian.advance (natPrecisions c) a)
            (BayesOptimal.FiniteGaussian.shift m a z) =
          BayesOptimal.FinitePosterior.loss H
            (BayesOptimal.FiniteGaussian.advance (natPrecisions c) a)
            (BayesOptimal.FiniteGaussian.shift m a z) := by
        apply ((integral_eq_iff_of_ae_le hlowint hdata.2
          (Filter.Eventually.of_forall hlow)).mp ?_).symm
        change BayesOptimal.FinitePosterior.actionLoss H (natPrecisions c) m a = _
        rw [← hdata.1, ← htree, heq, hact]
      rw [htree, htreeRepair]
      apply sample_run_ae_of_conditional a next nextRepair (natPrecisions c) m
        (natPrecisions_positive c hc a) hreg.2 hregRepair.2
      filter_upwards [hchild] with z hz
      have hrecover :
          (m a + (((natPrecisions c a : ℝ≥0) : ℝ) + 1) * z - m a) /
            ((c a : ℝ) + 1) = z := by
        simpa only [natPrecisions, NNReal.coe_natCast] using
          recovered_innovation (natPrecisions c a) (m a) z
      simp only [next, hrecover, advance_natPrecisions, shift_eq] at hz
      simpa only [next, nextRepair, hrecover, advance_natPrecisions, shift_eq] using
        ih (t + 1) (advance c a) (shift m a z) (seedTail u) (by omega) (by omega) hca hz

theorem actual_run_joint_measurable (π : StatePolicy) (t H : ℕ) (c : Counts) (m : Means) :
    Measurable (fun p : Seeds H × (Means × RawStream Arm H) =>
      run (rawTree π t H c m p.1) (observations p.2)) := by
  exact (rawTree_run_measurable π t H c).comp
    (measurable_const.prodMk (measurable_fst.prodMk
      ((observations_measurable H).comp measurable_snd)))

/-- A policy minimizing actual risk at this one starting state has the same
recommendation almost surely as its pointwise Bellman-optimal repair.
Neither sequential optimality nor local a.e. optimality is a premise. -/
theorem minimizing_rawTree_repair_ae (π : StatePolicy) (T t H : ℕ)
    (c : Counts) (m : Means) (horizon : t + H = T + 1) (ht : 4 ≤ t)
    (hc : ∀ a, 0 < c a) (hπ : MinimizesActualRisk π t H c m) :
    ∀ᵐ p ∂(seedLaw (H + 1)).prod (worldLaw H (natPrecisions c) m),
      run (rawTree π t H c m p.1) (observations p.2) =
        run (rawTree (repair π T) t H c m p.1) (observations p.2) := by
  apply (Measure.ae_prod_iff_ae_ae (measurableSet_eq_fun_of_countable
    (actual_run_joint_measurable π t H c m)
    (actual_run_joint_measurable (repair π T) t H c m))).mpr
  filter_upwards [minimizing_seed_risk_eq π t H c m hc hπ] with u hu
  exact exact_seed_repair_ae π T t H c m u horizon ht hc hu

/-- The initialization-only optimality predicate: actual continuation risk
is minimized after the mandatory one observation per arm, for each possible
initial posterior mean. It contains no sequential optimality requirement. -/
def InitialRiskOptimal (π : StatePolicy) (T : ℕ) : Prop :=
  ∀ m : Means, MinimizesActualRisk π 4 (T - 3) (fun _ => 1) m

theorem initialRiskOptimal_repair_pointwiseOptimal (π : StatePolicy) (T : ℕ) :
    PointwiseOptimal (repair π T) T := repair_pointwiseOptimal π T

/-- The posterior-predictive recommendation equivalence needed by the
initialization-only reduction, proved directly from its actual-risk premise. -/
theorem initialRiskOptimal_repair_ae (π : StatePolicy) (T : ℕ) (hT : 3 ≤ T)
    (hπ : InitialRiskOptimal π T) (m : Means) :
    ∀ᵐ p ∂(seedLaw (T - 3 + 1)).prod
      (worldLaw (T - 3) (natPrecisions (fun _ => 1)) m),
      run (rawTree π 4 (T - 3) (fun _ => 1) m p.1) (observations p.2) =
        run (rawTree (repair π T) 4 (T - 3) (fun _ => 1) m p.1) (observations p.2) := by
  exact minimizing_rawTree_repair_ae π T 4 (T - 3) (fun _ => 1) m
    (by omega) (by omega) (by intro a; norm_num) (hπ m)

end
end BayesOptimal.InitialOptimal

end

/-! ## FixedGaussianInitialReduction -/
section

set_option linter.unusedSectionVars false

open MeasureTheory ProbabilityTheory

namespace BayesOptimal.FixedGaussian

open BayesOptimal.Foundations.BayesianModel BayesOptimal.Policy BayesOptimal.PolicyContinuation BayesOptimal.SequentialRisk
open BayesOptimal.CountModelBridge BayesOptimal.EmbeddingRaw BayesOptimal.EmbeddingExecution
open BayesOptimal.InitialOptimal

noncomputable section

/-- Actual-risk minimization at one initial state suffices for agreement with
the sequentially optimal repair under every fixed true mean, not merely under
the Gaussian posterior mixture used in the optimization criterion. -/
theorem minimizing_rawTree_repair_fixed_ae (π : StatePolicy) (T t H : ℕ)
    (c : Counts) (m μ : Means) (horizon : t + H = T + 1) (ht : 4 ≤ t)
    (hc : ∀ a, 0 < c a) (hπ : MinimizesActualRisk π t H c m) :
    ∀ᵐ p ∂(seedLaw (H + 1)).prod (fixedLaw H μ),
      run (rawTree π t H c m p.1) p.2 =
        run (rawTree (repair π T) t H c m p.1) p.2 := by
  apply ae_execution_transfer (seedLaw (H + 1)) H (natPrecisions c) m μ
    (fun p => run (rawTree π t H c m p.1) p.2 =
      run (rawTree (repair π T) t H c m p.1) p.2)
  · apply measurableSet_eq_fun_of_countable
    · exact (rawTree_feasible π t H c m).2
    · exact (rawTree_feasible (repair π T) t H c m).2
  · exact minimizing_rawTree_repair_ae π T t H c m horizon ht hc hπ

theorem initialRiskOptimal_repair_fixed_ae (π : StatePolicy) (T : ℕ) (hT : 3 ≤ T)
    (hπ : InitialRiskOptimal π T) (m μ : Means) :
    ∀ᵐ p ∂(seedLaw (T - 3 + 1)).prod (fixedLaw (T - 3) μ),
      run (rawTree π 4 (T - 3) (fun _ => 1) m p.1) p.2 =
        run (rawTree (repair π T) 4 (T - 3) (fun _ => 1) m p.1) p.2 := by
  exact minimizing_rawTree_repair_fixed_ae π T 4 (T - 3) (fun _ => 1) m μ
    (by omega) (by omega) (by intro a; norm_num) (hπ m)

theorem initialRiskOptimal_fixed_payoff_repair_eq (π : StatePolicy) (T : ℕ)
    (hT : 3 ≤ T) (hπ : InitialRiskOptimal π T) (m μ : Means) (L : Arm → ℝ) :
    (∫ p, L (run (rawTree π 4 (T - 3) (fun _ => 1) m p.1) p.2)
      ∂(seedLaw (T - 3 + 1)).prod (fixedLaw (T - 3) μ)) =
    ∫ p, L (run (rawTree (repair π T) 4 (T - 3) (fun _ => 1) m p.1) p.2)
      ∂(seedLaw (T - 3 + 1)).prod (fixedLaw (T - 3) μ) := by
  apply integral_congr_ae
  exact (initialRiskOptimal_repair_fixed_ae π T hT hπ m μ).mono
    (fun _ hp => congrArg L hp)

end
end BayesOptimal.FixedGaussian

end

/-! ## FixedGaussianStackLaws -/
section

set_option linter.unusedSectionVars false

open MeasureTheory ProbabilityTheory
open scoped NNReal ENNReal

namespace BayesOptimal.FixedGaussian

open FiniteGaussian EmbeddingRaw EmbeddingExecution

variable {A : Type*} [Fintype A] [Nonempty A] [DecidableEq A]

noncomputable section

def arraySplit {E : Type*} [MeasurableSpace E] (a : A) :
    (A → E) ≃ᵐ E × ({b : A // b ≠ a} → E) where
  toFun r := (r a, fun b => r b)
  invFun := MockMeasure.join a
  left_inv r := by ext b; by_cases hb : b = a <;> simp [MockMeasure.join, hb]
  right_inv p := by
    apply Prod.ext
    · simp [MockMeasure.join]
    · funext b
      simp [MockMeasure.join, b.property]
  measurable_toFun := (measurable_pi_apply a).prodMk
    (measurable_pi_lambda _ (fun b => measurable_pi_apply (b : A)))
  measurable_invFun := MockMeasure.join_measurable a

theorem arraySplit_preserving {E : Type*} [MeasurableSpace E]
    (ν : A → Measure E) [∀ a, IsProbabilityMeasure (ν a)] (a : A) :
    MeasurePreserving (arraySplit a) (Measure.pi ν)
      ((ν a).prod (Measure.pi (fun b : {b : A // b ≠ a} => ν b))) := by
  exact (MockMeasure.join_preserving ν a).symm (arraySplit a).symm

theorem gaussian_prefix_preserving (H : ℕ) (x : ℝ) :
    MeasurePreserving (fun r : Fin (H + 1) → ℝ => fun j : Fin H => r j.castSucc)
      (Measure.pi (fun _ : Fin (H + 1) => gaussianReal x 1))
      (Measure.pi (fun _ : Fin H => gaussianReal x 1)) := by
  have hp := (measurePreserving_snd (μ := gaussianReal x 1)
    (ν := Measure.pi (fun _ : Fin H => gaussianReal x 1))).comp
      (measurePreserving_piFinSuccAbove (fun _ : Fin (H + 1) => gaussianReal x 1)
        (Fin.last H))
  convert hp using 1
  funext r j
  simp [MeasurableEquiv.piFinSuccAbove, Fin.init]

def stackTail {H : ℕ} (a : A) (r : RawStream A (H + 1)) : RawStream A H :=
  fun b j => if b = a then r b j.succ else r b j.castSucc

theorem stackTail_measurable (H : ℕ) (a : A) :
    Measurable (stackTail (H := H) a) := by
  unfold stackTail
  apply measurable_pi_lambda
  intro b
  by_cases hb : b = a <;> simp only [hb, if_true, if_false] <;> fun_prop

/-- Taking the next reward from the selected arm and retaining every other
arm's unused prefix leaves the same independent per-arm Gaussian stack law. -/
theorem selected_stack_split_preserving (H : ℕ) (μ : Means A) (a : A) :
    MeasurePreserving (fun r : RawStream A (H + 1) =>
      (r a ⟨0, by omega⟩, stackTail a r)) (fixedLaw (H + 1) μ)
      ((gaussianReal (μ a) 1).prod (fixedLaw H μ)) := by
  have hsplit := arraySplit_preserving
    (fun b : A => Measure.pi (fun _ : Fin (H + 1) => gaussianReal (μ b) 1)) a
  have hhead := measurePreserving_piFinSuccAbove
    (fun _ : Fin (H + 1) => gaussianReal (μ a) 1) ⟨0, by omega⟩
  have hothers := measurePreserving_pi
    (fun b : {b : A // b ≠ a} =>
      Measure.pi (fun _ : Fin (H + 1) => gaussianReal (μ b) 1))
    (fun b : {b : A // b ≠ a} =>
      Measure.pi (fun _ : Fin H => gaussianReal (μ b) 1))
    (fun b => gaussian_prefix_preserving H (μ b))
  have hpair := (hhead.prod hothers).comp hsplit
  have hassoc := measurePreserving_prodAssoc (gaussianReal (μ a) 1)
    (Measure.pi (fun _ : Fin H => gaussianReal (μ a) 1))
    (Measure.pi (fun b : {b : A // b ≠ a} =>
      Measure.pi (fun _ : Fin H => gaussianReal (μ b) 1)))
  letI : IsProbabilityMeasure
      ((Measure.pi (fun _ : Fin H => gaussianReal (μ a) 1)).prod
        (Measure.pi (fun b : {b : A // b ≠ a} =>
          Measure.pi (fun _ : Fin H => gaussianReal (μ b) 1)))) := by infer_instance
  letI : IsFiniteMeasure
      ((Measure.pi (fun _ : Fin H => gaussianReal (μ a) 1)).prod
        (Measure.pi (fun b : {b : A // b ≠ a} =>
          Measure.pi (fun _ : Fin H => gaussianReal (μ b) 1)))) :=
    IsZeroOrProbabilityMeasure.toIsFiniteMeasure _
  letI : SigmaFinite
      ((Measure.pi (fun _ : Fin H => gaussianReal (μ a) 1)).prod
        (Measure.pi (fun b : {b : A // b ≠ a} =>
          Measure.pi (fun _ : Fin H => gaussianReal (μ b) 1)))) :=
    IsFiniteMeasure.toSigmaFinite _
  have hj : MeasurePreserving (MockMeasure.join (E := Fin H → ℝ) a)
      ((Measure.pi (fun _ : Fin H => gaussianReal (μ a) 1)).prod
        (Measure.pi (fun b : {b : A // b ≠ a} =>
          Measure.pi (fun _ : Fin H => gaussianReal (μ b) 1)))) (fixedLaw H μ) :=
    MockMeasure.join_preserving
      (fun b : A => Measure.pi (fun _ : Fin H => gaussianReal (μ b) 1)) a
  have hjoin : MeasurePreserving
      (Prod.map (id : ℝ → ℝ) (MockMeasure.join (E := Fin H → ℝ) a))
      ((gaussianReal (μ a) 1).prod
        ((Measure.pi (fun _ : Fin H => gaussianReal (μ a) 1)).prod
          (Measure.pi (fun b : {b : A // b ≠ a} =>
            Measure.pi (fun _ : Fin H => gaussianReal (μ b) 1)))))
      ((gaussianReal (μ a) 1).prod (fixedLaw H μ)) := by
    exact (MeasurePreserving.id (gaussianReal (μ a) 1)).prod hj
  convert hjoin.comp (hassoc.comp hpair) using 1
  funext r
  apply Prod.ext
  · rfl
  · funext b j
    by_cases hb : b = a
    · subst b
      simp [stackTail, arraySplit, MockMeasure.join, MeasurableEquiv.prodAssoc, Fin.tail]
    · simp [stackTail, arraySplit, MockMeasure.join, hb, MeasurableEquiv.prodAssoc]

/-- Calendar-indexed sampling discards one coordinate from every arm. -/
theorem selected_calendar_split_preserving (H : ℕ) (μ : Means A) (a : A) :
    MeasurePreserving (fun r : RawStream A (H + 1) =>
      (r a ⟨0, by omega⟩, tail r)) (fixedLaw (H + 1) μ)
      ((gaussianReal (μ a) 1).prod (fixedLaw H μ)) := by
  have h1 := measurePreserving_pi
    (fun b : A => Measure.pi (fun _ : Fin (H + 1) => gaussianReal (μ b) 1))
    (fun b : A => (gaussianReal (μ b) 1).prod
      (Measure.pi (fun _ : Fin H => gaussianReal (μ b) 1)))
    (fun b => measurePreserving_piFinSuccAbove
      (fun _ : Fin (H + 1) => gaussianReal (μ b) 1) ⟨0, by omega⟩)
  have h2 := measurePreserving_arrowProdEquivProdArrow ℝ (Fin H → ℝ) A
    (fun b => gaussianReal (μ b) 1)
    (fun b => Measure.pi (fun _ : Fin H => gaussianReal (μ b) 1))
  have h3 := (measurePreserving_eval (fun b : A => gaussianReal (μ b) 1) a).prod
    (MeasurePreserving.id (fixedLaw H μ))
  convert h3.comp (h2.comp h1) using 1

end
end BayesOptimal.FixedGaussian

end

/-! ## FixedGaussianStackExecution -/
section

set_option linter.unusedSectionVars false
set_option maxHeartbeats 800000

open MeasureTheory ProbabilityTheory

namespace BayesOptimal.FixedGaussian

open FiniteGaussian EmbeddingRaw EmbeddingExecution

variable {A : Type*} [Fintype A] [Nonempty A] [DecidableEq A]

noncomputable section

/-- The same raw-observation strategy, now fed rewards indexed by the
number of pulls of each arm rather than by calendar time. -/
def stackRun : {H : ℕ} → Strategy (A := A) H → RawStream A H → A
  | 0, .stop a, _ => a
  | _ + 1, .sample a next, r =>
      stackRun (next (r a ⟨0, by omega⟩)) (stackTail a r)

section Measurable
variable [MeasurableSpace A] [MeasurableSingletonClass A]

def StackRegular : {H : ℕ} → Strategy (A := A) H → Prop
  | 0, .stop _ => True
  | _ + 1, .sample _ next =>
      (∀ y, StackRegular (next y)) ∧
        Measurable (fun p : ℝ × RawStream A _ => stackRun (next p.1) p.2)

theorem stackRegular_run_measurable {H : ℕ} (s : Strategy (A := A) H)
    (hs : StackRegular s) : Measurable (stackRun s) := by
  cases s with
  | stop a => exact measurable_const
  | @sample H a next =>
    exact hs.2.comp ((by fun_prop : Measurable (fun r : RawStream A (H + 1) =>
      r a ⟨0, Nat.zero_lt_succ H⟩)).prodMk (stackTail_measurable H a))

/-- Finite adaptive Gaussian sampling has the same recommendation law under
calendar arrays and per-arm pull stacks. This is a theorem about the actual
execution maps, not an assumed equivalence of sampling conventions. -/
theorem stackRun_law_eq_run {H : ℕ} (s : Strategy (A := A) H)
    (μ : Means A) (hs : Regular s) (hstack : StackRegular s) :
    (fixedLaw H μ).map (stackRun s) = (fixedLaw H μ).map (run s) := by
  induction H with
  | zero => cases s; rfl
  | succ H ih =>
    cases s with
    | sample a next =>
      have hsplit := selected_stack_split_preserving H μ a
      have hcal := selected_calendar_split_preserving H μ a
      have hsm : (fixedLaw (H + 1) μ).map (stackRun (.sample a next)) =
          ((gaussianReal (μ a) 1).prod (fixedLaw H μ)).map
            (fun p : ℝ × RawStream A H => stackRun (next p.1) p.2) := by
        calc
          _ = ((fixedLaw (H + 1) μ).map
              (fun r => (r a ⟨0, by omega⟩, stackTail a r))).map
              (fun p : ℝ × RawStream A H => stackRun (next p.1) p.2) :=
            (Measure.map_map hstack.2 hsplit.measurable).symm
          _ = _ := by rw [hsplit.map_eq]
      have hcm : (fixedLaw (H + 1) μ).map (run (.sample a next)) =
          ((gaussianReal (μ a) 1).prod (fixedLaw H μ)).map
            (fun p : ℝ × RawStream A H => run (next p.1) p.2) := by
        calc
          _ = ((fixedLaw (H + 1) μ).map
              (fun r => (r a ⟨0, by omega⟩, tail r))).map
              (fun p : ℝ × RawStream A H => run (next p.1) p.2) :=
            (Measure.map_map hs.2 hcal.measurable).symm
          _ = _ := by rw [hcal.map_eq]
      rw [hsm, hcm]
      apply Measure.ext
      intro B hB
      rw [Measure.map_apply hstack.2 hB, Measure.map_apply hs.2 hB,
        Measure.prod_apply (hstack.2 hB), Measure.prod_apply (hs.2 hB)]
      apply lintegral_congr
      intro y
      have hy := congrArg (fun ν : Measure A => ν B)
        (ih (next y) (hs.1 y) (hstack.1 y))
      simpa only [Measure.map_apply (stackRegular_run_measurable _ (hstack.1 y)) hB,
        Measure.map_apply (regular_run_measurable _ (hs.1 y)) hB] using hy

end Measurable

open BayesOptimal.Foundations.BayesianModel BayesOptimal.Policy BayesOptimal.PolicyContinuation

theorem rawTree_stackRun_measurable (π : StatePolicy) (t H : ℕ) (c : Counts) :
    Measurable (fun p : Input H => stackRun (rawTree π t H c p.1 p.2.1) p.2.2) := by
  induction H generalizing t c with
  | zero =>
      exact π.recommend_measurable.comp
        (measurable_const.prodMk (measurable_fst.prodMk
          ((measurable_pi_apply (⟨0, by omega⟩ : Fin 1)).comp
            (measurable_fst.comp measurable_snd))))
  | succ H ih =>
      let g : Input (H + 1) × Arm → Arm := fun p =>
        stackRun (rawTree π (t + 1) H (BayesOptimal.Foundations.BayesianModel.advance c p.2)
          (BayesOptimal.Foundations.BayesianModel.shift p.1.1 p.2
            ((p.1.2.2 p.2 ⟨0, by omega⟩ - p.1.1 p.2) / ((c p.2 : ℝ) + 1)))
          (seedTail p.1.2.1)) (stackTail p.2 p.1.2.2)
      have hg : Measurable g := by
        apply measurable_from_prod_countable_left
        intro a
        have hin : Measurable (fun p : Input (H + 1) =>
            (BayesOptimal.Foundations.BayesianModel.shift p.1 a
              ((p.2.2 a ⟨0, by omega⟩ - p.1 a) / ((c a : ℝ) + 1)),
                (seedTail p.2.1, stackTail a p.2.2))) := by
          apply Measurable.prodMk
          · apply measurable_pi_lambda
            intro b
            simp only [BayesOptimal.Foundations.BayesianModel.shift]
            split_ifs <;> fun_prop
          · have hseed : Measurable (fun p : Input (H + 1) => seedTail p.2.1) := by
              unfold seedTail
              fun_prop
            exact hseed.prodMk
              ((stackTail_measurable H a).comp (measurable_snd.comp measurable_snd))
        exact (ih (t + 1) (BayesOptimal.Foundations.BayesianModel.advance c a)).comp hin
      have hdraw : Measurable (fun p : Input (H + 1) =>
          π.draw t c p.1 (p.2.1 ⟨0, by omega⟩)) :=
        (π.draw_measurable t).comp
          (measurable_const.prodMk (measurable_fst.prodMk
            ((measurable_pi_apply (⟨0, by omega⟩ : Fin (H + 2))).comp
              (measurable_fst.comp measurable_snd))))
      exact hg.comp (measurable_id.prodMk hdraw)

theorem rawTree_stackRegular (π : StatePolicy) (t H : ℕ)
    (c : Counts) (m : BayesOptimal.Foundations.BayesianModel.Means) (u : Seeds H) :
    StackRegular (rawTree π t H c m u) := by
  induction H generalizing t c m with
  | zero => trivial
  | succ H ih =>
    constructor
    · intro y
      exact ih (t + 1) _ _ (seedTail u)
    · let a := π.draw t c m (u ⟨0, by omega⟩)
      have hin : Measurable (fun p : ℝ × RawStream Arm H =>
          (BayesOptimal.Foundations.BayesianModel.shift m a ((p.1 - m a) / ((c a : ℝ) + 1)),
            (seedTail u, p.2))) := by
        apply Measurable.prodMk
        · apply measurable_pi_lambda
          intro b
          simp only [BayesOptimal.Foundations.BayesianModel.shift]
          split_ifs <;> fun_prop
        · exact measurable_const.prodMk measurable_snd
      exact (rawTree_stackRun_measurable π (t + 1) H
        (BayesOptimal.Foundations.BayesianModel.advance c a)).comp hin

theorem rawTree_stack_law_eq (π : StatePolicy) (t H : ℕ)
    (c : Counts) (m μ : BayesOptimal.Foundations.BayesianModel.Means) (u : Seeds H) :
    (fixedLaw H μ).map (stackRun (rawTree π t H c m u)) =
      (fixedLaw H μ).map (run (rawTree π t H c m u)) :=
  stackRun_law_eq_run _ μ (rawTree_regular π t H c m u)
    (rawTree_stackRegular π t H c m u)

end
end BayesOptimal.FixedGaussian

end

/-! ## FixedGaussianInitialized -/
section

set_option linter.unusedSectionVars false

open MeasureTheory ProbabilityTheory

namespace BayesOptimal.FixedGaussian

open BayesOptimal.Foundations.BayesianModel BayesOptimal.Policy BayesOptimal.PolicyContinuation BayesOptimal.SequentialRisk
open BayesOptimal.CountModelBridge BayesOptimal.EmbeddingRaw BayesOptimal.EmbeddingExecution
open BayesOptimal.InitialOptimal

noncomputable section

def initializationLaw (μ : Means) : Measure Means :=
  Measure.pi (fun a : Arm => gaussianReal (μ a) 1)

instance initializationLaw_probability (μ : Means) :
    IsProbabilityMeasure (initializationLaw μ) := by unfold initializationLaw; infer_instance

def initializedLaw (H : ℕ) (μ : Means) : Measure (Input H) :=
  (initializationLaw μ).prod ((seedLaw (H + 1)).prod (fixedLaw H μ))

instance initializedLaw_probability (H : ℕ) (μ : Means) :
    IsProbabilityMeasure (initializedLaw H μ) := by unfold initializedLaw; infer_instance

def initializedRun (π : StatePolicy) (H : ℕ) (p : Input H) : Arm :=
  run (rawTree π 4 H (fun _ => 1) p.1 p.2.1) p.2.2

def initializedStackRun (π : StatePolicy) (H : ℕ) (p : Input H) : Arm :=
  stackRun (rawTree π 4 H (fun _ => 1) p.1 p.2.1) p.2.2

theorem initializedRun_measurable (π : StatePolicy) (H : ℕ) :
    Measurable (initializedRun π H) := rawTree_run_measurable π 4 H _

theorem initializedStackRun_measurable (π : StatePolicy) (H : ℕ) :
    Measurable (initializedStackRun π H) := rawTree_stackRun_measurable π 4 H _

theorem seeded_stack_law_eq (π : StatePolicy) (t H : ℕ) (c : Counts) (m μ : Means) :
    ((seedLaw (H + 1)).prod (fixedLaw H μ)).map
        (fun p => stackRun (rawTree π t H c m p.1) p.2) =
      ((seedLaw (H + 1)).prod (fixedLaw H μ)).map
        (fun p => run (rawTree π t H c m p.1) p.2) := by
  have hs : Measurable (fun p : Seeds H × RawStream Arm H =>
      stackRun (rawTree π t H c m p.1) p.2) :=
    (rawTree_stackRun_measurable π t H c).comp (measurable_const.prodMk measurable_id)
  have hc : Measurable (fun p : Seeds H × RawStream Arm H =>
      run (rawTree π t H c m p.1) p.2) :=
    (rawTree_run_measurable π t H c).comp (measurable_const.prodMk measurable_id)
  apply Measure.ext
  intro B hB
  rw [Measure.map_apply hs hB, Measure.map_apply hc hB,
    Measure.prod_apply (hs hB), Measure.prod_apply (hc hB)]
  apply lintegral_congr
  intro u
  have hu := congrArg (fun ν : Measure Arm => ν B) (rawTree_stack_law_eq π t H c m μ u)
  simpa only [Measure.map_apply (stackRegular_run_measurable _
    (rawTree_stackRegular π t H c m u)) hB,
    Measure.map_apply (regular_run_measurable _ (rawTree_regular π t H c m u)) hB] using hu

theorem initialized_stack_law_eq (π : StatePolicy) (H : ℕ) (μ : Means) :
    (initializedLaw H μ).map (initializedStackRun π H) =
      (initializedLaw H μ).map (initializedRun π H) := by
  apply Measure.ext
  intro B hB
  rw [Measure.map_apply (initializedStackRun_measurable π H) hB,
    Measure.map_apply (initializedRun_measurable π H) hB]
  unfold initializedLaw
  rw [Measure.prod_apply ((initializedStackRun_measurable π H) hB),
    Measure.prod_apply ((initializedRun_measurable π H) hB)]
  apply lintegral_congr
  intro m
  have hm := congrArg (fun ν : Measure Arm => ν B)
    (seeded_stack_law_eq π 4 H (fun _ => 1) m μ)
  have hs : Measurable (fun p : Seeds H × RawStream Arm H =>
      stackRun (rawTree π 4 H (fun _ => 1) m p.1) p.2) :=
    (rawTree_stackRun_measurable π 4 H (fun _ => 1)).comp
    (measurable_const.prodMk measurable_id)
  have hc : Measurable (fun p : Seeds H × RawStream Arm H =>
      run (rawTree π 4 H (fun _ => 1) m p.1) p.2) :=
    (rawTree_run_measurable π 4 H (fun _ => 1)).comp
    (measurable_const.prodMk measurable_id)
  simpa only [Measure.map_apply hs hB, Measure.map_apply hc hB] using hm

theorem initialRiskOptimal_initialized_repair_ae (π : StatePolicy) (T : ℕ)
    (hT : 3 ≤ T) (hπ : InitialRiskOptimal π T) (μ : Means) :
    initializedRun π (T - 3) =ᵐ[initializedLaw (T - 3) μ]
      initializedRun (repair π T) (T - 3) := by
  apply (Measure.ae_prod_iff_ae_ae (measurableSet_eq_fun_of_countable
    (initializedRun_measurable π (T - 3))
    (initializedRun_measurable (repair π T) (T - 3)))).mpr
  exact Filter.Eventually.of_forall (fun m => initialRiskOptimal_repair_fixed_ae π T hT hπ m μ)

/-- The complete initialized experiment, with fresh Gaussian initialization,
fresh Gaussian policy seeds, and independent per-pull reward stacks. -/
theorem initialRiskOptimal_initialized_stack_repair_law (π : StatePolicy) (T : ℕ)
    (hT : 3 ≤ T) (hπ : InitialRiskOptimal π T) (μ : Means) :
    (initializedLaw (T - 3) μ).map (initializedStackRun π (T - 3)) =
      (initializedLaw (T - 3) μ).map (initializedStackRun (repair π T) (T - 3)) := by
  rw [initialized_stack_law_eq, initialized_stack_law_eq]
  exact Measure.map_congr (initialRiskOptimal_initialized_repair_ae π T hT hπ μ)

end
end BayesOptimal.FixedGaussian

end

/-! ## FixedGaussianWindows -/
section

set_option linter.unusedSectionVars false

open MeasureTheory ProbabilityTheory

namespace BayesOptimal.FixedGaussian

noncomputable section

/-- Restricting an independent finite array to distinct coordinates preserves
the corresponding product law. This checks the initialization/seed windows. -/
theorem pi_restrict_preserving {I J : Type*} [Fintype I] [Fintype J]
    (ν : I → Measure ℝ) [∀ i, IsProbabilityMeasure (ν i)]
    (f : J → I) (hf : Function.Injective f) :
    MeasurePreserving (fun r : I → ℝ => fun j : J => r (f j))
      (Measure.pi ν) (Measure.pi (fun j => ν (f j))) := by
  have hi : iIndepFun (fun i : I => fun r : I → ℝ => r i) (Measure.pi ν) :=
    iIndepFun_pi (fun _ => measurable_id.aemeasurable)
  have hif := hi.precomp hf
  refine ⟨measurable_pi_lambda _ (fun j => measurable_pi_apply (f j)), ?_⟩
  rw [(iIndepFun_iff_map_fun_eq_pi_map
    (fun j : J => (measurable_pi_apply (f j)).aemeasurable)).mp hif]
  congr 1
  funext j
  exact (measurePreserving_eval ν (f j)).map_eq

theorem gaussian_prefix_castLE_preserving (N H : ℕ) (hHN : H ≤ N) (x : ℝ) :
    MeasurePreserving (fun r : Fin N → ℝ => fun j : Fin H => r (j.castLE hHN))
      (Measure.pi (fun _ : Fin N => gaussianReal x 1))
      (Measure.pi (fun _ : Fin H => gaussianReal x 1)) :=
  pi_restrict_preserving _ _ (fun _ _ h => Fin.ext (congrArg (fun z : Fin N => z.val) h))

open BayesOptimal.FiniteGaussian BayesOptimal.EmbeddingRaw BayesOptimal.EmbeddingExecution

theorem fixed_prefix_preserving {A : Type*} [Fintype A] [Nonempty A] [DecidableEq A]
    (N H : ℕ) (hHN : H ≤ N) (μ : Means A) :
    MeasurePreserving (fun r : RawStream A N => fun a (j : Fin H) => r a (j.castLE hHN))
      (fixedLaw N μ) (fixedLaw H μ) := by
  exact measurePreserving_pi
    (fun a : A => Measure.pi (fun _ : Fin N => gaussianReal (μ a) 1))
    (fun a : A => Measure.pi (fun _ : Fin H => gaussianReal (μ a) 1))
    (fun a => gaussian_prefix_castLE_preserving N H hHN (μ a))

theorem all_heads_split_preserving {A : Type*} [Fintype A] [Nonempty A] [DecidableEq A]
    (H : ℕ) (μ : Means A) :
    MeasurePreserving (fun r : RawStream A (H + 1) =>
      (fun a => r a ⟨0, Nat.zero_lt_succ H⟩, tail r)) (fixedLaw (H + 1) μ)
      ((Measure.pi (fun a : A => gaussianReal (μ a) 1)).prod (fixedLaw H μ)) := by
  have h1 := measurePreserving_pi
    (fun b : A => Measure.pi (fun _ : Fin (H + 1) => gaussianReal (μ b) 1))
    (fun b : A => (gaussianReal (μ b) 1).prod
      (Measure.pi (fun _ : Fin H => gaussianReal (μ b) 1)))
    (fun b => measurePreserving_piFinSuccAbove
      (fun _ : Fin (H + 1) => gaussianReal (μ b) 1) ⟨0, by omega⟩)
  have h2 := measurePreserving_arrowProdEquivProdArrow ℝ (Fin H → ℝ) A
    (fun b => gaussianReal (μ b) 1)
    (fun b => Measure.pi (fun _ : Fin H => gaussianReal (μ b) 1))
  convert h2.comp h1 using 1

end
end BayesOptimal.FixedGaussian

end

/-! ## FixedGaussianStackPath -/
section

set_option autoImplicit false
set_option warningAsError true
set_option maxHeartbeats 1000000

open MeasureTheory ProbabilityTheory

namespace BayesOptimal.FixedGaussian.StackPath

open BayesOptimal.Foundations.BayesianModel BayesOptimal.Policy BayesOptimal.PolicyContinuation
open BayesOptimal.EmbeddingRaw BayesOptimal.Empirical

noncomputable section

def pathSeeds (u : RandomPath) (r H : ℕ) : Seeds H :=
  fun j => u (r + 3 + j.val)

def remainingRewards {T : ℕ} (Δ : ℝ) (ω : BayesOptimal.Foundations.BadEvent.RawArrays T)
    (c : Counts) (H : ℕ) (hb : ∀ a, c a + H ≤ T) : RawStream Arm H :=
  fun a j => observation Δ ω a ⟨c a + j.val, by have := hb a; omega⟩

theorem afterInitial_count_le (π : StatePolicy) (p : Path) (u : RandomPath)
    (r : ℕ) (a : Arm) : afterInitial π p u r a ≤ r + 1 := by
  induction r with
  | zero => exact le_rfl
  | succ r ih =>
    simp only [afterInitial, advance]
    split_ifs <;> omega

theorem afterInitial_count_pos (π : StatePolicy) (p : Path) (u : RandomPath)
    (r : ℕ) (a : Arm) : 0 < afterInitial π p u r a := by
  induction r with
  | zero => exact Nat.zero_lt_one
  | succ r ih =>
    simp only [afterInitial, advance]
    split_ifs <;> omega

theorem remainingRewards_tail {T : ℕ} (Δ : ℝ) (ω : BayesOptimal.Foundations.BadEvent.RawArrays T)
    (c : Counts) (a : Arm) (H : ℕ) (hb : ∀ b, c b + (H + 1) ≤ T)
    (hn : ∀ b, advance c a b + H ≤ T) :
    stackTail a (remainingRewards Δ ω c (H + 1) hb) =
      remainingRewards Δ ω (advance c a) H hn := by
  funext b j
  unfold stackTail remainingRewards advance
  by_cases hba : b = a
  · simp only [if_pos hba]
    congr 2
    simp only [Fin.val_succ]
    omega
  · simp only [if_neg hba]
    rfl

theorem meansAt_empirical_advance {T : ℕ} (Δ : ℝ)
    (ω : BayesOptimal.Foundations.BadEvent.RawArrays T) (c : Counts) (a : Arm)
    (hpos : 0 < c a) (hbound : c a < T) :
    BayesOptimal.Foundations.PolicyPaths.meansAt (empiricalPath Δ ω) (advance c a) =
      shift (BayesOptimal.Foundations.PolicyPaths.meansAt (empiricalPath Δ ω) c) a
        ((observation Δ ω a ⟨c a, hbound⟩ -
          BayesOptimal.Foundations.PolicyPaths.meansAt (empiricalPath Δ ω) c a) / ((c a : ℝ) + 1)) := by
  funext b
  by_cases hba : b = a
  · subst b
    simp only [BayesOptimal.Foundations.PolicyPaths.meansAt, advance, shift, if_true]
    rw [empiricalPath_update Δ ω a (c a) hpos hbound]
    unfold BayesOptimal.Foundations.Gaussian.posteriorMeanUpdate
    field_simp
    ring
  · simp only [BayesOptimal.Foundations.PolicyPaths.meansAt, advance, shift, if_neg hba, add_zero]

/-- Deterministic path identity, including every adaptive per-arm pull index,
posterior mean update, and policy-randomizer index. No probability assertion
or agreement-of-execution assumption occurs in this statement. -/
theorem rawTree_stack_recommendation (π : StatePolicy) (T : ℕ) (Δ : ℝ)
    (ω : BayesOptimal.Foundations.BadEvent.RawArrays T) (u : RandomPath) (r H : ℕ)
    (hbudget : r + H + 3 ≤ T) :
    stackRun (rawTree π (r + 4) H
      (afterInitial π (empiricalPath Δ ω) u r)
      (BayesOptimal.Foundations.PolicyPaths.meansAt (empiricalPath Δ ω)
        (afterInitial π (empiricalPath Δ ω) u r)) (pathSeeds u r H))
      (remainingRewards Δ ω (afterInitial π (empiricalPath Δ ω) u r) H
        (fun a => by have := afterInitial_count_le π (empiricalPath Δ ω) u r a; omega)) =
      π.recommend (afterInitial π (empiricalPath Δ ω) u (r + H))
        (BayesOptimal.Foundations.PolicyPaths.meansAt (empiricalPath Δ ω)
          (afterInitial π (empiricalPath Δ ω) u (r + H))) (u (r + H + 3)) := by
  induction H generalizing r with
  | zero => simp only [rawTree, stackRun, pathSeeds, Nat.add_zero]
  | succ H ih =>
    let p := empiricalPath Δ ω
    let c := afterInitial π p u r
    let m := BayesOptimal.Foundations.PolicyPaths.meansAt p c
    let a := π.draw (r + 4) c m (u (r + 3))
    have hb : ∀ b, c b + (H + 1) ≤ T := by
      intro b
      have := afterInitial_count_le π p u r b
      change c b ≤ r + 1 at this
      omega
    have hn : ∀ b, advance c a b + H ≤ T := by
      intro b
      have := hb b
      unfold advance
      split_ifs <;> omega
    have hnext : afterInitial π p u (r + 1) = advance c a := rfl
    have hm : shift m a
        ((observation Δ ω a ⟨c a, by have := hb a; omega⟩ - m a) / ((c a : ℝ) + 1)) =
        BayesOptimal.Foundations.PolicyPaths.meansAt p (afterInitial π p u (r + 1)) := by
      rw [hnext]
      exact (meansAt_empirical_advance Δ ω c a
        (afterInitial_count_pos π p u r a) (by have := hb a; omega)).symm
    have hseeds : seedTail (pathSeeds u r (H + 1)) = pathSeeds u (r + 1) H := by
      funext j
      unfold seedTail pathSeeds
      congr 1
      simp only [Fin.val_succ]
      omega
    have htail := remainingRewards_tail Δ ω c a H hb hn
    change stackRun (rawTree π ((r + 4) + 1) H (advance c a)
      (shift m a ((observation Δ ω a ⟨c a, by have := hb a; omega⟩ - m a) /
        ((c a : ℝ) + 1))) (seedTail (pathSeeds u r (H + 1))))
      (stackTail a (remainingRewards Δ ω c (H + 1) hb)) = _
    rw [hm, hseeds, htail]
    have hi := ih (r + 1) (by omega)
    have ht : r + 4 + 1 = r + 1 + 4 := by omega
    have hfin : r + (H + 1) = r + 1 + H := by omega
    simpa only [ht, hfin] using hi

def initialMeans (T : ℕ) (Δ : ℝ) (hT : 3 ≤ T)
    (ω : BayesOptimal.Foundations.BadEvent.RawArrays T) : Means :=
  fun a => observation Δ ω a ⟨0, by omega⟩

def seedWindow (T : ℕ) (hT : 3 ≤ T) (u : SeedArray (T + 1)) : Seeds (T - 3) :=
  fun j => u ⟨j.val + 3, by have := j.isLt; omega⟩

def remainingStack (T : ℕ) (Δ : ℝ) (hT : 3 ≤ T)
    (ω : BayesOptimal.Foundations.BadEvent.RawArrays T) : RawStream Arm (T - 3) :=
  fun a j => observation Δ ω a ⟨j.val + 1, by have := j.isLt; omega⟩

def initializedInput (T : ℕ) (Δ : ℝ) (hT : 3 ≤ T)
    (w : BayesOptimal.Main.JointSample T) : Input (T - 3) :=
  (initialMeans T Δ hT w.1, (seedWindow T hT w.2, remainingStack T Δ hT w.1))

/-- Literal equivalence between Main's reward-stack execution and the raw
continuation tree started after the common one-sample-per-arm initialization. -/
theorem recommendation_eq_stackRun (π : StatePolicy) (T : ℕ) (hT : 3 ≤ T)
    (Δ : ℝ) (ω : BayesOptimal.Foundations.BadEvent.RawArrays T) (u : SeedArray (T + 1)) :
    recommendation π T (empiricalPath Δ ω) (randomPath T u) =
      stackRun (rawTree π 4 (T - 3) (fun _ => 1) (initialMeans T Δ hT ω)
        (seedWindow T hT u)) (remainingStack T Δ hT ω) := by
  have hi := rawTree_stack_recommendation π T Δ ω (randomPath T u) 0 (T - 3) (by omega)
  have hm : BayesOptimal.Foundations.PolicyPaths.meansAt (empiricalPath Δ ω) (fun _ => 1) =
      initialMeans T Δ hT ω := by
    funext a
    simp only [BayesOptimal.Foundations.PolicyPaths.meansAt, empiricalPath, initialMeans, observation]
    rw [BayesOptimal.Foundations.BadEvent.sampleMean_one (by omega)]
  have hu : pathSeeds (randomPath T u) 0 (T - 3) = seedWindow T hT u := by
    funext j
    unfold pathSeeds randomPath extendSeeds seedWindow
    rw [dif_pos (by have := j.isLt; omega)]
    congr 1
    apply Fin.ext
    change 0 + 3 + j.val = j.val + 3
    omega
  have hr : remainingRewards Δ ω (fun _ => 1) (T - 3)
      (fun _ => by change 1 + (T - 3) ≤ T; omega) = remainingStack T Δ hT ω := by
    funext a j
    unfold remainingRewards remainingStack
    congr 2
    change 1 + j.val = j.val + 1
    omega
  simp only [Nat.zero_add, afterInitial, hm, hu, hr] at hi
  unfold recommendation counts
  have hlast : randomPath T u (T - 3 + 3) = randomPath T u T := by congr 1; omega
  rw [hlast] at hi
  exact hi.symm

theorem actualRecommendation_eq_stackRun (π : StatePolicy) (T : ℕ) (hT : 3 ≤ T)
    (Δ : ℝ) (ω : BayesOptimal.Main.JointSample T) :
    BayesOptimal.Main.actualRecommendation π T Δ ω =
      stackRun (rawTree π 4 (T - 3) (fun _ => 1) (initialMeans T Δ hT ω.1)
        (seedWindow T hT ω.2)) (remainingStack T Δ hT ω.1) :=
  recommendation_eq_stackRun π T hT Δ ω.1 ω.2

end
end BayesOptimal.FixedGaussian.StackPath

end

/-! ## FixedGaussianMainLaw -/
section

set_option linter.unusedSectionVars false
set_option maxHeartbeats 800000

open MeasureTheory ProbabilityTheory

namespace BayesOptimal.FixedGaussian

open BayesOptimal.Foundations.BayesianModel BayesOptimal.Policy BayesOptimal.PolicyContinuation
open BayesOptimal.EmbeddingRaw BayesOptimal.EmbeddingExecution BayesOptimal.Empirical
open BayesOptimal.InitialOptimal

noncomputable section

theorem initialized_rewards_preserving (T : ℕ) (hT : 3 ≤ T) (μ : Means) :
    MeasurePreserving (fun r : RawStream Arm T =>
      (fun a => r a ⟨0, by omega⟩,
        fun a (j : Fin (T - 3)) => r a ⟨j.val + 1, by have := j.isLt; omega⟩))
      (fixedLaw T μ) ((initializationLaw μ).prod (fixedLaw (T - 3) μ)) := by
  have hp := fixed_prefix_preserving T (T - 3 + 1) (by omega) μ
  have hs := all_heads_split_preserving (T - 3) μ
  convert hs.comp hp using 1

theorem raw_initialized_rewards_preserving (T : ℕ) (Δ : ℝ) (hT : 3 ≤ T) :
    MeasurePreserving (fun r : BayesOptimal.Foundations.BadEvent.RawArrays T =>
      (StackPath.initialMeans T Δ hT r, StackPath.remainingStack T Δ hT r))
      (BayesOptimal.Foundations.BadEvent.rawArraysLaw T)
      ((initializationLaw (trueMean Δ)).prod (fixedLaw (T - 3) (trueMean Δ))) := by
  have hp := (initialized_rewards_preserving T hT (trueMean Δ)).comp
    (shift_noise_preserving T (trueMean Δ))
  convert hp using 1
  funext r
  apply Prod.ext
  · funext a
    simp [StackPath.initialMeans, observation, add_comm]
  · funext a j
    simp [StackPath.remainingStack, observation, add_comm]

theorem seedWindow_preserving (T : ℕ) (hT : 3 ≤ T) :
    MeasurePreserving (StackPath.seedWindow T hT) (randomizerLaw T)
      (seedLaw (T - 3 + 1)) := by
  apply pi_restrict_preserving (fun _ : Fin (T + 1) => gaussianReal 0 1)
    (fun j : Fin (T - 3 + 1) => (⟨j.val + 3, by have := j.isLt; omega⟩ : Fin (T + 1)))
  intro i j h
  apply Fin.ext
  have hi := congrArg (fun z : Fin (T + 1) => z.val) h
  change i.val + 3 = j.val + 3 at hi
  exact Nat.add_right_cancel hi

/-- The exact finite reward and seed arrays used by Main, projected to the
actual initialization and unused reward/seed windows, have the initialized
execution law proved above. -/
theorem initializedInput_preserving (T : ℕ) (Δ : ℝ) (hT : 3 ≤ T) :
    MeasurePreserving (StackPath.initializedInput T Δ hT) (BayesOptimal.Main.jointLaw T)
      (initializedLaw (T - 3) (trueMean Δ)) := by
  have hp := (raw_initialized_rewards_preserving T Δ hT).prod (seedWindow_preserving T hT)
  have ha := measurePreserving_prodAssoc (initializationLaw (trueMean Δ))
    (fixedLaw (T - 3) (trueMean Δ)) (seedLaw (T - 3 + 1))
  have hs := (MeasurePreserving.id (initializationLaw (trueMean Δ))).prod
    (Measure.measurePreserving_swap (μ := fixedLaw (T - 3) (trueMean Δ))
      (ν := seedLaw (T - 3 + 1)))
  convert hs.comp (ha.comp hp) using 1

/-- The legacy per-pull-stack main theorem and the actual initialized raw
strategy have precisely the same recommendation distribution. -/
theorem actualRecommendation_law (π : StatePolicy) (T : ℕ) (Δ : ℝ) (hT : 3 ≤ T) :
    (BayesOptimal.Main.jointLaw T).map (BayesOptimal.Main.actualRecommendation π T Δ) =
      (initializedLaw (T - 3) (trueMean Δ)).map (initializedStackRun π (T - 3)) := by
  have hp := initializedInput_preserving T Δ hT
  calc
    _ = (BayesOptimal.Main.jointLaw T).map
        (initializedStackRun π (T - 3) ∘ StackPath.initializedInput T Δ hT) := by
      congr 1
      funext r
      exact StackPath.actualRecommendation_eq_stackRun π T hT Δ r
    _ = ((BayesOptimal.Main.jointLaw T).map (StackPath.initializedInput T Δ hT)).map
        (initializedStackRun π (T - 3)) :=
      (Measure.map_map (initializedStackRun_measurable π (T - 3)) hp.measurable).symm
    _ = _ := by rw [hp.map_eq]

theorem initialRiskOptimal_actualRecommendation_repair_law (π : StatePolicy) (T : ℕ)
    (Δ : ℝ) (hT : 3 ≤ T) (hπ : InitialRiskOptimal π T) :
    (BayesOptimal.Main.jointLaw T).map (BayesOptimal.Main.actualRecommendation π T Δ) =
      (BayesOptimal.Main.jointLaw T).map (BayesOptimal.Main.actualRecommendation (repair π T) T Δ) := by
  rw [actualRecommendation_law π T Δ hT, actualRecommendation_law (repair π T) T Δ hT]
  exact initialRiskOptimal_initialized_stack_repair_law π T hT hπ (trueMean Δ)

/-- The previously missing initialization-only reduction, for exactly the
frequentist regret definition occurring in the existing Main theorem. -/
theorem initialRiskOptimal_regret_repair_eq (π : StatePolicy) (T : ℕ) (Δ : ℝ)
    (hT : 3 ≤ T) (hπ : InitialRiskOptimal π T) :
    BayesOptimal.Main.regret π T Δ = BayesOptimal.Main.regret (repair π T) T Δ := by
  let L : Arm → ℝ := fun a => Δ - trueMean Δ a
  have hL : Measurable L := measurable_of_countable L
  unfold BayesOptimal.Main.regret
  rw [← integral_map (BayesOptimal.Main.actualRecommendation_measurable π T Δ).aemeasurable
    hL.aestronglyMeasurable,
    initialRiskOptimal_actualRecommendation_repair_law π T Δ hT hπ,
    integral_map (BayesOptimal.Main.actualRecommendation_measurable (repair π T) T Δ).aemeasurable
      hL.aestronglyMeasurable]

end
end BayesOptimal.FixedGaussian

end

/-! ## FixedGaussianMain -/
section

open MeasureTheory ProbabilityTheory Filter

namespace BayesOptimal.FixedGaussian

open BayesOptimal.Foundations.BayesianModel BayesOptimal.Policy BayesOptimal.InitialOptimal

noncomputable section

/-- The full main regret bound with initialization-only actual-risk
optimality. Neither sequential nor local Bellman optimality is a hypothesis. -/
theorem theorem2_initialRiskOptimal (Δ : ℝ) (hΔ : 0 < Δ) :
    ∃ (c : ℝ) (C T0 : ℕ), 0 < c ∧ 0 < C ∧
      ∀ T : ℕ, T0 ≤ T → Odd T → ∀ π : StatePolicy, InitialRiskOptimal π T →
        c * BayesOptimal.Foundations.Rates.invPower C T ≤ BayesOptimal.Main.regret π T Δ := by
  obtain ⟨c, C, T0, hc, hC, hmain⟩ := BayesOptimal.Main.theorem2 Δ hΔ
  refine ⟨c, C, max T0 3, hc, hC, ?_⟩
  intro T hT ho π hπ
  have h3 : 3 ≤ T := (le_max_right T0 3).trans hT
  rw [initialRiskOptimal_regret_repair_eq π T Δ h3 hπ]
  exact hmain T ((le_max_left T0 3).trans hT) ho (repair π T)
    (pointwiseOptimal_aeOptimal _ _ (repair_pointwiseOptimal π T))

theorem theorem2_paper_exponent_initialRiskOptimal (Δ : ℝ) (hΔ : 0 < Δ) :
    ∃ (c : ℝ) (T0 : ℕ), 0 < c ∧
      ∀ T : ℕ, T0 ≤ T → Odd T → ∀ π : StatePolicy, InitialRiskOptimal π T →
        c * (T : ℝ)^(-((33+Δ)^2/2+4)) ≤ BayesOptimal.Main.regret π T Δ := by
  obtain ⟨c, T0, hc, hmain⟩ := BayesOptimal.Main.theorem2_paper_exponent Δ hΔ
  refine ⟨c, max T0 3, hc, ?_⟩
  intro T hT ho π hπ
  have h3 : 3 ≤ T := (le_max_right T0 3).trans hT
  rw [initialRiskOptimal_regret_repair_eq π T Δ h3 hπ]
  exact hmain T ((le_max_left T0 3).trans hT) ho (repair π T)
    (pointwiseOptimal_aeOptimal _ _ (repair_pointwiseOptimal π T))

theorem theorem2_real_exponent_initialRiskOptimal (Δ : ℝ) (hΔ : 0 < Δ) :
    ∃ (c C : ℝ) (T0 : ℕ), 0 < c ∧ 0 < C ∧
      ∀ T : ℕ, T0 ≤ T → Odd T → ∀ π : StatePolicy, InitialRiskOptimal π T →
        c * (T : ℝ)^(-C) ≤ BayesOptimal.Main.regret π T Δ := by
  obtain ⟨c, T0, hc, hmain⟩ := theorem2_paper_exponent_initialRiskOptimal Δ hΔ
  exact ⟨c, (33+Δ)^2/2+4, T0, hc, by positivity, hmain⟩

theorem theorem2_exponential_rate_initialRiskOptimal (Δ : ℝ) (hΔ : 0 < Δ)
    (family : ℕ → StatePolicy) (hfamily : ∀ T, 3 ≤ T → InitialRiskOptimal (family T) T) :
    liminf (BayesOptimal.RegretExponent.rate
      (fun T => BayesOptimal.Main.regret (family T) T Δ)) atTop = 0 := by
  obtain ⟨c, C, T0, hc, _, hmain⟩ := theorem2_initialRiskOptimal Δ hΔ
  apply BayesOptimal.RegretExponent.liminf_rate_eq_zero _ Δ c C hΔ hc
    (fun T => BayesOptimal.Main.regret_bounds (family T) T Δ hΔ.le)
  filter_upwards [eventually_ge_atTop (max T0 3)] with T hT
  intro ho
  exact hmain T ((le_max_left T0 3).trans hT) ho (family T)
    (hfamily T ((le_max_right T0 3).trans hT))

theorem remark2_initialRiskOptimal (Δ : ℝ) (hΔ : 0 < Δ)
    (family : ℕ → StatePolicy) (hfamily : ∀ T, 3 ≤ T → InitialRiskOptimal (family T) T)
    (rFreq : ℕ → ℝ) (hF : ∀ T, 0 ≤ rFreq T)
    (hpositive : 0 < liminf (BayesOptimal.RegretExponent.rate rFreq) atTop) :
    limsup (BayesOptimal.RegretRatio.ratio
      (fun T => BayesOptimal.Main.regret (family T) T Δ) rFreq) atTop = ⊤ := by
  obtain ⟨c, C, T0, hc, _, hmain⟩ := theorem2_initialRiskOptimal Δ hΔ
  apply BayesOptimal.RegretRatio.limsup_ratio_eq_top_of_positive_rate _ rFreq C c hc _ hF hpositive
  filter_upwards [eventually_ge_atTop (max T0 3)] with T hT
  intro ho
  exact hmain T ((le_max_left T0 3).trans hT) ho (family T)
    (hfamily T ((le_max_right T0 3).trans hT))

/-- A concrete witness ensures that the initialization-only policy class is
nonempty; the main theorem is not a statement about an empty hypothesis. -/
theorem exists_initialRiskOptimal (T : ℕ) (hT : 3 ≤ T) :
    ∃ π : StatePolicy, InitialRiskOptimal π T := by
  refine ⟨deterministicBellman T, ?_⟩
  intro m
  exact BayesOptimal.SequentialRisk.deterministicBellman_minimizes_actual_risk T 4 (T - 3)
    (fun _ => 1) m (by omega) (by intro a; norm_num)

end
end BayesOptimal.FixedGaussian

end

/-! ## FixedGaussianFlatInitialization -/
section

set_option linter.unusedSectionVars false

open MeasureTheory ProbabilityTheory
open scoped NNReal ENNReal

namespace BayesOptimal.FixedGaussian.FlatInitialization

open BayesOptimal.FiniteGaussian BayesOptimal.FinitePosterior
open BayesOptimal.EmbeddingRaw BayesOptimal.EmbeddingExecution BayesOptimal.EmbeddingRandomized

noncomputable section

variable {A : Type*} [Fintype A] [Nonempty A] [DecidableEq A]

def dataMeans (n : A → ℕ) (y : (a : A) → Fin (n a) → ℝ) : Means A :=
  fun a => BayesOptimal.FlatPriorInitialization.empiricalMean (y a)

/-- Normalize the likelihood against the improper flat Lebesgue prior after
the mandatory observations. This is a genuine measure, not a stipulated
Gaussian posterior. Positive sample counts make its normalizer finite and
strictly positive, as proved by FlatPriorProduct. -/
def normalizedFlatLaw (n : A → ℕ) (y : (a : A) → Fin (n a) → ℝ) : Measure (Means A) :=
  volume.withDensity (fun θ => ENNReal.ofReal
    (BayesOptimal.FlatPriorProduct.productLikelihood n y θ /
      (∫ x, BayesOptimal.FlatPriorProduct.productLikelihood n y x)))

theorem normalizedFlatLaw_eq_posterior (n : A → ℕ)
    (y : (a : A) → Fin (n a) → ℝ) (hn : ∀ a, 0 < n a) :
    normalizedFlatLaw n y = posteriorLaw (fun a => (n a : ℝ≥0)) (dataMeans n y) :=
  BayesOptimal.FlatPriorProduct.normalized_product_measure n y hn

theorem normalizedFlatLaw_probability (n : A → ℕ)
    (y : (a : A) → Fin (n a) → ℝ) (hn : ∀ a, 0 < n a) :
    IsProbabilityMeasure (normalizedFlatLaw n y) := by
  rw [normalizedFlatLaw_eq_posterior n y hn]
  infer_instance

/-- The actual next raw Gaussian observation from the normalized flat-prior
posterior has the joint innovation/updated-posterior law used by the proof.
Thus the one-step bridge starts from the likelihood normalization itself. -/
theorem normalizedFlat_observation_joint_law (n : A → ℕ)
    (y : (a : A) → Fin (n a) → ℝ) (hn : ∀ a, 0 < n a) (a : A) :
    ((normalizedFlatLaw n y).prod (gaussianReal 0 1)).map
        (BayesOptimal.ObservationBridge.rawObservation a) =
      ((gaussianReal 0 (innovation (fun b => (n b : ℝ≥0)) a)).prod
        (centeredLaw (advance (fun b => (n b : ℝ≥0)) a))).map
          (BayesOptimal.ObservationBridge.reconstructedObservation
            (fun b => (n b : ℝ≥0)) (dataMeans n y) a) := by
  rw [normalizedFlatLaw_eq_posterior n y hn]
  exact BayesOptimal.ObservationBridge.observation_joint_law _ _ a (by exact_mod_cast hn a)

/-- The latent mean is sampled from the normalized flat likelihood, and all
future observation noise coordinates are independent unit Gaussians. -/
def flatWorldLaw (H : ℕ) (n : A → ℕ) (y : (a : A) → Fin (n a) → ℝ) :
    Measure (Means A × RawStream A H) := (normalizedFlatLaw n y).prod (arrayLaw H)

theorem flatWorldLaw_eq_worldLaw (H : ℕ) (n : A → ℕ)
    (y : (a : A) → Fin (n a) → ℝ) (hn : ∀ a, 0 < n a) :
    flatWorldLaw H n y = worldLaw H (fun a => (n a : ℝ≥0)) (dataMeans n y) := by
  unfold flatWorldLaw worldLaw
  rw [normalizedFlatLaw_eq_posterior n y hn]

section Measurable
variable [MeasurableSpace A] [MeasurableSingletonClass A]

theorem flat_rawPayoff_integrable {H : ℕ} (s : Strategy (A := A) H)
    (n : A → ℕ) (y : (a : A) → Fin (n a) → ℝ) (hn : ∀ a, 0 < n a)
    (hs : Measurable (run s)) :
    Integrable (fun w : Means A × RawStream A H =>
      maxAll w.1 - w.1 (run s (observations w))) (flatWorldLaw H n y) := by
  rw [flatWorldLaw_eq_worldLaw H n y hn]
  exact rawRisk_integrable s _ _ hs

theorem flat_rawRisk_eq {H : ℕ} (s : Strategy (A := A) H)
    (n : A → ℕ) (y : (a : A) → Fin (n a) → ℝ) (hn : ∀ a, 0 < n a) :
    (∫ w : Means A × RawStream A H,
      maxAll w.1 - w.1 (run s (observations w)) ∂flatWorldLaw H n y) =
        rawRisk s (fun a => (n a : ℝ≥0)) (dataMeans n y) := by
  rw [flatWorldLaw_eq_worldLaw H n y hn]
  rfl

variable {S : Type*} [MeasurableSpace S]

theorem flat_randomizedPayoff_integrable {H : ℕ}
    (σ : Measure S) [IsProbabilityMeasure σ] (s : S → Strategy (A := A) H)
    (n : A → ℕ) (y : (a : A) → Fin (n a) → ℝ) (hn : ∀ a, 0 < n a)
    (hs : Measurable (fun p : S × RawStream A H => run (s p.1) p.2)) :
    Integrable (randomizedPayoff s) (σ.prod (flatWorldLaw H n y)) := by
  rw [flatWorldLaw_eq_worldLaw H n y hn]
  exact randomizedPayoff_integrable σ s _ _ hs

/-- Actual expected simple regret, including arbitrary independent policy
randomization, equals the risk used in the Gaussian Bellman development. -/
theorem flat_randomizedRisk_eq {H : ℕ}
    (σ : Measure S) [IsProbabilityMeasure σ] (s : S → Strategy (A := A) H)
    (n : A → ℕ) (y : (a : A) → Fin (n a) → ℝ) (hn : ∀ a, 0 < n a)
    (hs : Measurable (fun p : S × RawStream A H => run (s p.1) p.2)) :
    (∫ p, randomizedPayoff s p ∂σ.prod (flatWorldLaw H n y)) =
      ∫ u, rawRisk (s u) (fun a => (n a : ℝ≥0)) (dataMeans n y) ∂σ := by
  rw [flatWorldLaw_eq_worldLaw H n y hn]
  exact integral_prod _ (randomizedPayoff_integrable σ s _ _ hs)

theorem flat_randomizedRisk_ge_loss {H : ℕ}
    (σ : Measure S) [IsProbabilityMeasure σ] (s : S → Strategy (A := A) H)
    (n : A → ℕ) (y : (a : A) → Fin (n a) → ℝ) (hn : ∀ a, 0 < n a)
    (hregular : ∀ u, Regular (s u))
    (hs : Measurable (fun p : S × RawStream A H => run (s p.1) p.2)) :
    loss H (fun a => (n a : ℝ≥0)) (dataMeans n y) ≤
      ∫ p, randomizedPayoff s p ∂σ.prod (flatWorldLaw H n y) := by
  rw [flat_randomizedRisk_eq σ s n y hn hs]
  exact randomized_rawRisk_ge_loss σ s _ _ (fun a => by exact_mod_cast hn a) hregular hs

end Measurable

open BayesOptimal.Foundations.BayesianModel BayesOptimal.Policy BayesOptimal.PolicyContinuation BayesOptimal.SequentialRisk

theorem flat_familyRisk_eq {H : ℕ} (s : Family H) (n : Counts)
    (y : (a : Arm) → Fin (n a) → ℝ) (hn : ∀ a, 0 < n a) (hs : Feasible s) :
    (∫ p, randomizedPayoff s p ∂(seedLaw (H + 1)).prod (flatWorldLaw H n y)) =
      familyRisk s n (dataMeans n y) :=
  flat_randomizedRisk_eq (seedLaw (H + 1)) s n y hn hs.2

/-- In particular the paper's posterior-state policy starts from the actual
normalized flat-prior likelihood, with no separate assumed posterior law. -/
theorem flat_continuationRisk_eq (π : StatePolicy) (t H : ℕ) (n : Counts)
    (y : (a : Arm) → Fin (n a) → ℝ) (hn : ∀ a, 0 < n a) :
    (∫ p, randomizedPayoff (rawTree π t H n (dataMeans n y)) p
      ∂(seedLaw (H + 1)).prod (flatWorldLaw H n y)) =
        continuationRisk π t H n (dataMeans n y) :=
  flat_familyRisk_eq (rawTree π t H n (dataMeans n y)) n y hn
    (rawTree_feasible π t H n (dataMeans n y))

end
end BayesOptimal.FixedGaussian.FlatInitialization

end

/-! ## ProseCorollariesFootnote14 -/
section

set_option autoImplicit false
set_option warningAsError true

open MeasureTheory ProbabilityTheory Set Filter Asymptotics
open scoped NNReal ENNReal

namespace BayesOptimal.ProseCorollaries.Footnote14

noncomputable section

/-- The standard deviation corresponding to the footnote's variance T^-3. -/
def standardDeviation (T : ℕ) : ℝ := (Real.sqrt ((T : ℝ) ^ 3))⁻¹

/-- A threshold larger than every fixed multiple of that standard deviation. -/
def logarithmicGap (T : ℕ) : ℝ := standardDeviation T * Real.sqrt (Real.log (T : ℝ))

theorem standardDeviation_pos (T : ℕ) (hT : 0 < T) : 0 < standardDeviation T := by
  unfold standardDeviation
  have hp : 0 < (T : ℝ) := by exact_mod_cast hT
  positivity

theorem standardDeviation_sq (T : ℕ) :
    standardDeviation T ^ 2 = ((T : ℝ) ^ 3)⁻¹ := by
  unfold standardDeviation
  simpa only [inv_pow] using congrArg Inv.inv (Real.sq_sqrt
    (show 0 ≤ (T : ℝ) ^ 3 by positivity))

/-- A positive polynomial lower bound still holds for the larger threshold
sqrt(log T) times T^-3/2, under the actual Gaussian law of variance T^-3. -/
theorem logarithmicGap_polynomial_tail (T : ℕ) (hT : 5 ≤ T) :
    BayesOptimal.Foundations.BadEvent.underestimationConstant * BayesOptimal.Foundations.Rates.invPower 4 T ≤
      (gaussianReal 0 (((T : ℝ≥0) ^ 3)⁻¹)).real (Ici (logarithmicGap T)) := by
  have hσ := standardDeviation_pos T (by omega)
  have hv : (⟨(-standardDeviation T) ^ 2, sq_nonneg _⟩ : ℝ≥0) * 1 =
      ((T : ℝ≥0) ^ 3)⁻¹ := by
    apply NNReal.coe_injective
    simp only [NNReal.coe_mk, mul_one,
      neg_sq, standardDeviation_sq, NNReal.coe_inv, NNReal.coe_pow, NNReal.coe_natCast]
  have hm := gaussianReal_map_const_mul (μ := (0 : ℝ)) (v := (1 : ℝ≥0))
    (-standardDeviation T)
  rw [mul_zero, hv] at hm
  have hpre : (fun x : ℝ => -standardDeviation T * x) ⁻¹' Ici (logarithmicGap T) =
      BayesOptimal.Probability.underestimationSet T 1 := by
    ext x
    change standardDeviation T * Real.sqrt (Real.log (T : ℝ)) ≤
      -standardDeviation T * x ↔ x ≤ -1 * Real.sqrt (Real.log (T : ℝ))
    constructor <;> intro hx <;> nlinarith
  rw [measureReal_def, ← hm, Measure.map_apply (by fun_prop) measurableSet_Ici, hpre]
  exact BayesOptimal.Probability.underestimation_probability_polynomial_lower T 2 0 1 hT
    (by norm_num) (by norm_num) (by norm_num)

/-- Thus the footnote's claimed necessary O(T^-3/2) scale is stronger than
polynomial-tail probability requires. This is a kernel-checked counterexample,
not a claim about whether the main theorem's enlarged event would work. -/
theorem logarithmicGap_not_bigO_standardDeviation :
    ¬ (logarithmicGap =O[atTop] standardDeviation) := by
  intro h
  obtain ⟨C, _hC, hb⟩ := Asymptotics.isBigO_iff'.mp h
  have hlog : ∀ᶠ T : ℕ in atTop, (C + 1) ^ 2 ≤ Real.log (T : ℝ) :=
    (Real.tendsto_log_atTop.comp tendsto_natCast_atTop_atTop).eventually_ge_atTop _
  obtain ⟨T, hbound, hlarge, hT⟩ :=
    (hb.and (hlog.and (eventually_ge_atTop (5 : ℕ)))).exists
  have hσ := standardDeviation_pos T (by omega)
  have hroot : C + 1 ≤ Real.sqrt (Real.log (T : ℝ)) := Real.le_sqrt_of_sq_le hlarge
  rw [Real.norm_eq_abs, Real.norm_eq_abs, abs_of_nonneg (by
    unfold logarithmicGap
    exact mul_nonneg hσ.le (Real.sqrt_nonneg _)), abs_of_pos hσ] at hbound
  unfold logarithmicGap at hbound
  have hsmall : Real.sqrt (Real.log (T : ℝ)) ≤ C := by
    apply (mul_le_mul_iff_right₀ hσ).mp
    simpa only [mul_comm] using hbound
  linarith

/-- The counterexample combines the positive polynomial constant, its
all-large-integer-horizon tail bound, and failure of the alleged necessary
Big-O condition in one explicit formal statement. -/
theorem counterexample_to_necessary_scale :
    (0 < BayesOptimal.Foundations.BadEvent.underestimationConstant) ∧
      (∀ T : ℕ, 5 ≤ T →
        BayesOptimal.Foundations.BadEvent.underestimationConstant * BayesOptimal.Foundations.Rates.invPower 4 T ≤
          (gaussianReal 0 (((T : ℝ≥0) ^ 3)⁻¹)).real (Ici (logarithmicGap T))) ∧
      ¬ (logarithmicGap =O[atTop] standardDeviation) :=
  ⟨BayesOptimal.Foundations.BadEvent.underestimationConstant_positive,
    logarithmicGap_polynomial_tail, logarithmicGap_not_bigO_standardDeviation⟩

end
end BayesOptimal.ProseCorollaries.Footnote14

end

/-! ## Footnote14Scale -/
section

open Filter Asymptotics
open MeasureTheory ProbabilityTheory Set
open scoped NNReal ENNReal

namespace BayesOptimal.Footnote14Scale

noncomputable section

open BayesOptimal.ProseCorollaries.Footnote14

theorem standardDeviation_eq_paper_scale (T : ℕ) :
    standardDeviation T = (T : ℝ) ^ (-(3 : ℝ) / 2) := by
  unfold standardDeviation
  rw [Real.sqrt_eq_rpow, ← Real.rpow_natCast, ← Real.rpow_mul (Nat.cast_nonneg T),
    ← Real.rpow_neg (Nat.cast_nonneg T)]
  congr 1
  norm_num

theorem logarithmicGap_not_bigO_paper_scale :
    ¬ (logarithmicGap =O[atTop] (fun T : ℕ => (T : ℝ) ^ (-(3 : ℝ) / 2))) := by
  simpa only [← standardDeviation_eq_paper_scale] using logarithmicGap_not_bigO_standardDeviation

def PolynomialTailLowerBound (gap : ℕ → ℝ) : Prop :=
  ∃ c : ℝ, 0 < c ∧ ∃ p : ℕ, ∀ T : ℕ, 5 ≤ T →
    c * BayesOptimal.Foundations.Rates.invPower p T ≤
      (gaussianReal 0 (((T : ℝ≥0) ^ 3)⁻¹)).real (Ici (gap T))

/-- Direct negation of the footnote's asserted necessary condition, even
when every threshold is nonnegative. -/
theorem polynomial_tail_does_not_require_paper_scale :
    ¬ (∀ gap : ℕ → ℝ, (∀ T, 0 ≤ gap T) → PolynomialTailLowerBound gap →
      gap =O[atTop] (fun T : ℕ => (T : ℝ) ^ (-(3 : ℝ) / 2))) := by
  intro h
  apply logarithmicGap_not_bigO_paper_scale
  apply h logarithmicGap
  · intro T
    unfold logarithmicGap standardDeviation
    positivity
  · exact ⟨BayesOptimal.Foundations.BadEvent.underestimationConstant,
      BayesOptimal.Foundations.BadEvent.underestimationConstant_positive, 4, logarithmicGap_polynomial_tail⟩

end
end BayesOptimal.Footnote14Scale

end

/-! ## UniformSamplingTail -/
section

open MeasureTheory ProbabilityTheory Set Filter
open scoped NNReal ENNReal Topology

namespace BayesOptimal.UniformSampling

open BayesOptimal.TailRatio

noncomputable section

theorem normalization_pos : 0 < normalization := by
  unfold normalization
  positivity

theorem tail_sandwich (x : ℝ) (hx : 2 ≤ x) :
    normalization / (2 * x) * Real.exp (-x^2 / 2) ≤ normalTail x ∧
      normalTail x ≤ normalization * Real.exp (-x^2 / 2) := by
  have hxp : 0 < x := by linarith
  have hcoef : 1 / (2 * x) ≤ 1 / x - 1 / x^3 := by
    have hsq : 2 ≤ x^2 := by nlinarith
    apply (div_le_iff₀ (by positivity : 0 < 2 * x)).mpr
    field_simp [ne_of_gt hxp]
    nlinarith
  constructor
  · have hm := mul_le_mul_of_nonneg_right hcoef (phi_nonnegative x)
    rw [phi_eq] at hm
    have he : normalization / (2 * x) * Real.exp (-x^2 / 2) =
        (1 / (2*x)) * (normalization * Real.exp (-x^2/2)) := by ring
    rw [he]
    exact hm.trans (by simpa only [phi_eq] using mills_lower x hxp)
  · have hm := mills_upper x hxp
    have hcoef' : 1 / x ≤ 1 := (div_le_one hxp).mpr (by linarith)
    exact hm.trans (by
      rw [← phi_eq]
      exact (mul_le_mul_of_nonneg_right hcoef' (phi_nonnegative x)).trans_eq (one_mul _))

theorem normalTail_pos_of_two_le (x : ℝ) (hx : 2 ≤ x) : 0 < normalTail x := by
  exact (mul_pos (div_pos normalization_pos (by linarith)) (Real.exp_pos _)).trans_le
    (tail_sandwich x hx).1

theorem normalTail_pos (x : ℝ) : 0 < normalTail x := by
  have hp := normalTail_pos_of_two_le (max x 2) (le_max_right _ _)
  have hm : normalTail (max x 2) ≤ normalTail x :=
    measureReal_mono (fun _ hy => (le_max_left x 2).trans_lt hy)
  exact hp.trans_le hm

theorem tail_log_bounds (x : ℝ) (hx : 2 ≤ x) :
    x^2 / 2 - Real.log normalization ≤ -Real.log (normalTail x) ∧
      -Real.log (normalTail x) ≤
        x^2 / 2 + Real.log 2 + Real.log x - Real.log normalization := by
  have hxp : 0 < x := by linarith
  have hp := normalTail_pos_of_two_le x hx
  have hs := tail_sandwich x hx
  have hl := Real.log_le_log
    (mul_pos (div_pos normalization_pos (by positivity)) (Real.exp_pos _)) hs.1
  have hu := Real.log_le_log hp hs.2
  rw [Real.log_mul (ne_of_gt (div_pos normalization_pos (by positivity)))
    (Real.exp_ne_zero _), Real.log_div normalization_pos.ne'
    (by positivity), Real.log_mul (by norm_num) hxp.ne', Real.log_exp] at hl
  rw [Real.log_mul normalization_pos.ne' (Real.exp_ne_zero _), Real.log_exp] at hu
  constructor <;> linarith

/-- Mills' bounds yield the exact quadratic logarithmic asymptotic of the
actual standard Gaussian tail. -/
theorem tail_log_sq_tendsto :
    Tendsto (fun x : ℝ => -Real.log (normalTail x) / x^2) atTop (𝓝 (1/2)) := by
  have hsq : Tendsto (fun x : ℝ => x^2) atTop atTop := by
    simpa only [pow_two] using Tendsto.atTop_mul_atTop₀ tendsto_id tendsto_id
  have hc (a : ℝ) : Tendsto (fun x : ℝ => a / x^2) atTop (𝓝 0) :=
    tendsto_const_nhds.div_atTop hsq
  have hlog : Tendsto (fun x : ℝ => Real.log x / x) atTop (𝓝 0) := by
    simpa using Real.tendsto_pow_log_div_mul_add_atTop 1 0 1 one_ne_zero
  have hlogsq : Tendsto (fun x : ℝ => Real.log x / x^2) atTop (𝓝 0) := by
    convert hlog.mul tendsto_inv_atTop_zero using 1
    · funext x
      simp only [pow_two, div_eq_mul_inv]
      ring
    · simp
  have hlo : Tendsto (fun x : ℝ => (1/2 : ℝ) - Real.log normalization / x^2)
      atTop (𝓝 (1/2)) := by
    simpa using tendsto_const_nhds.sub (hc (Real.log normalization))
  have hhi : Tendsto (fun x : ℝ => (1/2 : ℝ) + Real.log 2 / x^2 +
      Real.log x / x^2 - Real.log normalization / x^2) atTop (𝓝 (1/2)) := by
    simpa using ((tendsto_const_nhds.add (hc (Real.log 2))).add hlogsq).sub
      (hc (Real.log normalization))
  apply tendsto_of_tendsto_of_tendsto_of_le_of_le' hlo hhi
  · filter_upwards [eventually_ge_atTop (2 : ℝ)] with x hx
    have hb := div_le_div_of_nonneg_right (tail_log_bounds x hx).1 (sq_nonneg x)
    have hxn : x ≠ 0 := by linarith
    have he : x^2 / 2 / x^2 = (1/2 : ℝ) := by field_simp
    simpa only [sub_div, he] using hb
  · filter_upwards [eventually_ge_atTop (2 : ℝ)] with x hx
    have hb := div_le_div_of_nonneg_right (tail_log_bounds x hx).2 (sq_nonneg x)
    have hxn : x ≠ 0 := by linarith
    have he : x^2 / 2 / x^2 = (1/2 : ℝ) := by field_simp
    simpa only [add_div, sub_div, he] using hb

theorem gaussian_tail_rate (x : ℕ → ℝ) (q : ℝ)
    (hx : Tendsto x atTop atTop)
    (hq : Tendsto (fun T => (x T)^2 / (T : ℝ)) atTop (𝓝 q)) :
    Tendsto (fun T => -Real.log (normalTail (x T)) / (T : ℝ)) atTop (𝓝 (q / 2)) := by
  have h := (tail_log_sq_tendsto.comp hx).mul hq
  have h' : Tendsto (fun T => (-Real.log (normalTail (x T)) / (x T)^2) *
      ((x T)^2 / (T : ℝ))) atTop (𝓝 (q / 2)) := by
    have he : (1/2 : ℝ) * q = q / 2 := by ring
    simpa only [Function.comp_def, he] using h
  apply h'.congr'
  filter_upwards [hx.eventually (eventually_gt_atTop (0 : ℝ))] with T hT
  have he : (-Real.log (normalTail (x T)) / (x T)^2) * ((x T)^2 / (T : ℝ)) =
      -Real.log (normalTail (x T)) / (T : ℝ) := by
    field_simp [ne_of_gt hT]
  exact he

end
end BayesOptimal.UniformSampling

end

/-! ## Footnote14Characterization -/
section

set_option autoImplicit false
set_option warningAsError true

open MeasureTheory ProbabilityTheory Set Filter Asymptotics
open scoped NNReal ENNReal

namespace BayesOptimal.Footnote14Characterization

noncomputable section

open BayesOptimal.ProseCorollaries.Footnote14 BayesOptimal.TailRatio

/-- Polynomial lower bound at all sufficiently large integer horizons. -/
def EventuallyPolynomialTail (gap : ℕ → ℝ) : Prop :=
  ∃ c : ℝ, 0 < c ∧ ∃ p : ℕ, ∀ᶠ T : ℕ in atTop,
    c * BayesOptimal.Foundations.Rates.invPower p T ≤
      (gaussianReal 0 (((T : ℝ≥0) ^ 3)⁻¹)).real (Ici (gap T))

theorem tail_standardize (T : ℕ) (hT : 0 < T) (g : ℝ) :
    (gaussianReal 0 (((T : ℝ≥0) ^ 3)⁻¹)).real (Ici g) =
      normalTail (g / standardDeviation T) := by
  have hσ := standardDeviation_pos T hT
  have hv : (⟨standardDeviation T ^ 2, sq_nonneg _⟩ : ℝ≥0) * 1 =
      ((T : ℝ≥0) ^ 3)⁻¹ := by
    apply NNReal.coe_injective
    simp only [NNReal.coe_mk, mul_one, standardDeviation_sq,
      NNReal.coe_inv, NNReal.coe_pow, NNReal.coe_natCast]
  have hm := gaussianReal_map_const_mul (μ := (0 : ℝ)) (v := (1 : ℝ≥0))
    (standardDeviation T)
  rw [mul_zero, hv] at hm
  have hp : (fun x : ℝ => standardDeviation T * x) ⁻¹' Ici g =
      Ici (g / standardDeviation T) := by
    ext x
    change g ≤ standardDeviation T * x ↔ g / standardDeviation T ≤ x
    rw [div_le_iff₀ hσ]
    rw [mul_comm]
  rw [measureReal_def, ← hm, Measure.map_apply (by fun_prop) measurableSet_Ici, hp]
  haveI : NoAtoms (gaussianReal 0 1) := noAtoms_gaussianReal (by norm_num : (1 : ℝ≥0) ≠ 0)
  exact congrArg ENNReal.toReal
    (measure_congr (Ioi_ae_eq_Ici (μ := gaussianReal 0 1)
      (a := g / standardDeviation T))).symm

theorem scaled_logarithmic_tail_lower (T B : ℕ) (C : ℝ) (hT : 5 ≤ T)
    (hC : 0 ≤ C) (hB : C + 1 ≤ (B : ℝ)) :
    BayesOptimal.Foundations.BadEvent.underestimationConstant * BayesOptimal.Foundations.Rates.invPower (B ^ 2) T ≤
      (gaussianReal 0 (((T : ℝ≥0) ^ 3)⁻¹)).real (Ici (C * logarithmicGap T)) := by
  rw [tail_standardize T (by omega)]
  have he : C * logarithmicGap T / standardDeviation T =
      C * Real.sqrt (Real.log (T : ℝ)) := by
    unfold logarithmicGap
    field_simp [(standardDeviation_pos T (by omega)).ne']
  rw [he]
  have hl := BayesOptimal.Probability.underestimation_probability_polynomial_lower
    T B 0 C hT (by norm_num) hC (by simpa using hB)
  simpa only [BayesOptimal.Probability.underestimationSet, neg_mul,
    BayesOptimal.TailRatio.shifted_left_tail, add_zero] using hl

theorem eventuallyPolynomialTail_of_isBigO (gap : ℕ → ℝ)
    (hgap : gap =O[atTop] logarithmicGap) : EventuallyPolynomialTail gap := by
  obtain ⟨C, hC, hbound⟩ := Asymptotics.isBigO_iff'.mp hgap
  obtain ⟨B, hB⟩ := exists_nat_ge (C + 1)
  refine ⟨BayesOptimal.Foundations.BadEvent.underestimationConstant,
    BayesOptimal.Foundations.BadEvent.underestimationConstant_positive, B ^ 2, ?_⟩
  filter_upwards [hbound, eventually_ge_atTop (5 : ℕ)] with T hbound hT
  have hg0 : 0 ≤ logarithmicGap T := by
    unfold logarithmicGap standardDeviation
    positivity
  have hg : gap T ≤ C * logarithmicGap T := by
    rw [Real.norm_eq_abs, Real.norm_eq_abs, abs_of_nonneg hg0] at hbound
    exact (le_abs_self _).trans hbound
  exact (scaled_logarithmic_tail_lower T B C hT hC.le hB).trans
    (measureReal_mono (fun _ hx => hg.trans hx))

theorem standardized_threshold_sq_bound (T p : ℕ) (c g : ℝ)
    (hT : 5 ≤ T) (hc : 0 < c) (hg : 0 ≤ g)
    (hbound : c * BayesOptimal.Foundations.Rates.invPower p T ≤
      (gaussianReal 0 (((T : ℝ≥0) ^ 3)⁻¹)).real (Ici g)) :
    (g / standardDeviation T) ^ 2 ≤
      (4 + 2 * ((p : ℝ) + |Real.log normalization| + |Real.log c|)) *
        Real.log (T : ℝ) := by
  have hTp : 0 < (T : ℝ) := by exact_mod_cast (show 0 < T by omega)
  have hlog := BayesOptimal.Foundations.Drift.log_horizon_ge_one T hT
  have hx : 0 ≤ g / standardDeviation T :=
    div_nonneg hg (standardDeviation_pos T (by omega)).le
  rw [tail_standardize T (by omega)] at hbound
  by_cases hlarge : 2 ≤ g / standardDeviation T
  · have hpoly : 0 < c * BayesOptimal.Foundations.Rates.invPower p T :=
      mul_pos hc (BayesOptimal.Foundations.Rates.invPower_pos p T (by omega))
    have hlogs := Real.log_le_log hpoly hbound
    rw [BayesOptimal.Foundations.Rates.invPower, Real.log_mul hc.ne' (by positivity),
      Real.log_inv, Real.log_pow] at hlogs
    have htail := (BayesOptimal.UniformSampling.tail_log_bounds
      (g / standardDeviation T) hlarge).1
    have hn := le_abs_self (Real.log normalization)
    have hc' := neg_le_abs (Real.log c)
    have hconst : |Real.log normalization| + |Real.log c| ≤
        (|Real.log normalization| + |Real.log c|) * Real.log (T : ℝ) :=
      le_mul_of_one_le_right (by positivity) hlog
    nlinarith
  · have hsmall : g / standardDeviation T < 2 := lt_of_not_ge hlarge
    have hcoef : 0 ≤ (p : ℝ) + |Real.log normalization| + |Real.log c| := by positivity
    nlinarith [mul_nonneg hcoef (show 0 ≤ Real.log (T : ℝ) by linarith)]

theorem isBigO_of_eventuallyPolynomialTail (gap : ℕ → ℝ)
    (hgap : ∀ T, 0 ≤ gap T) (hpoly : EventuallyPolynomialTail gap) :
    gap =O[atTop] logarithmicGap := by
  obtain ⟨c, hc, p, hbound⟩ := hpoly
  let K : ℝ := 4 + 2 * ((p : ℝ) + |Real.log normalization| + |Real.log c|)
  have hK : 0 ≤ K := by dsimp [K]; positivity
  apply Asymptotics.IsBigO.of_bound (Real.sqrt K)
  filter_upwards [hbound, eventually_ge_atTop (5 : ℕ)] with T hbound hT
  have hσ := standardDeviation_pos T (by omega)
  have hlog : 0 ≤ Real.log (T : ℝ) :=
    (by norm_num : (0 : ℝ) ≤ 1).trans (BayesOptimal.Foundations.Drift.log_horizon_ge_one T hT)
  have hsq := standardized_threshold_sq_bound T p c (gap T) hT hc (hgap T) hbound
  have hroot : gap T / standardDeviation T ≤
      Real.sqrt K * Real.sqrt (Real.log (T : ℝ)) := by
    have he : (Real.sqrt K * Real.sqrt (Real.log (T : ℝ))) ^ 2 =
        K * Real.log (T : ℝ) := by rw [mul_pow, Real.sq_sqrt hK, Real.sq_sqrt hlog]
    have hn : 0 ≤ Real.sqrt K * Real.sqrt (Real.log (T : ℝ)) := by positivity
    nlinarith
  have hmul := (div_le_iff₀ hσ).mp hroot
  rw [Real.norm_eq_abs, Real.norm_eq_abs, abs_of_nonneg (hgap T),
    abs_of_nonneg (show 0 ≤ logarithmicGap T by unfold logarithmicGap; positivity)]
  unfold logarithmicGap
  nlinarith only [hmul]

/-- Exact asymptotic characterization for nonnegative thresholds under the actual
Gaussian law with variance T^-3. Polynomial means a positive polynomial lower
bound, with unrestricted constants and exponent at all sufficiently large T. -/
theorem eventuallyPolynomialTail_iff_isBigO (gap : ℕ → ℝ)
    (hgap : ∀ T, 0 ≤ gap T) :
    EventuallyPolynomialTail gap ↔
      gap =O[atTop] (fun T : ℕ => (T : ℝ) ^ (-(3 : ℝ) / 2) *
        Real.sqrt (Real.log (T : ℝ))) := by
  have he : logarithmicGap = (fun T : ℕ => (T : ℝ) ^ (-(3 : ℝ) / 2) *
        Real.sqrt (Real.log (T : ℝ))) := by
    funext T
    rw [logarithmicGap, BayesOptimal.Footnote14Scale.standardDeviation_eq_paper_scale]
  rw [← he]
  exact ⟨isBigO_of_eventuallyPolynomialTail gap hgap,
    eventuallyPolynomialTail_of_isBigO gap⟩

theorem finite_positive_lower_bound (s : Finset ℕ) (f : ℕ → ℝ)
    (hf : ∀ n ∈ s, 0 < f n) : ∃ c : ℝ, 0 < c ∧ ∀ n ∈ s, c ≤ f n := by
  induction s using Finset.induction_on with
  | empty => exact ⟨1, by norm_num, by simp⟩
  | @insert a s _ ih =>
    obtain ⟨c, hc, hb⟩ := ih (fun n hn => hf n (Finset.mem_insert_of_mem hn))
    refine ⟨min c (f a), lt_min hc (hf a (Finset.mem_insert_self a s)), ?_⟩
    intro n hn
    rcases Finset.mem_insert.mp hn with rfl | hn
    · exact min_le_right _ _
    · exact (min_le_left _ _).trans (hb n hn)

/-- Since every finite threshold has positive Gaussian tail probability, the
finite prefix can be absorbed into the positive polynomial constant. -/
theorem polynomialTailLowerBound_iff_eventually (gap : ℕ → ℝ) :
    BayesOptimal.Footnote14Scale.PolynomialTailLowerBound gap ↔ EventuallyPolynomialTail gap := by
  constructor
  · rintro ⟨c, hc, p, hb⟩
    exact ⟨c, hc, p, (eventually_ge_atTop 5).mono (fun T hT => hb T hT)⟩
  · rintro ⟨c, hc, p, hb⟩
    obtain ⟨N, hN⟩ := eventually_atTop.mp hb
    let f : ℕ → ℝ := fun T => if 5 ≤ T then
      (gaussianReal 0 (((T : ℝ≥0) ^ 3)⁻¹)).real (Ici (gap T)) * (T : ℝ) ^ p else 1
    have hf : ∀ T ∈ Finset.range N, 0 < f T := by
      intro T _hT
      dsimp [f]
      split_ifs with hT
      · rw [tail_standardize T (by omega)]
        exact mul_pos (BayesOptimal.UniformSampling.normalTail_pos _)
          (pow_pos (by exact_mod_cast (show 0 < T by omega)) _)
      · norm_num
    obtain ⟨d, hd, hsmall⟩ := finite_positive_lower_bound (Finset.range N) f hf
    refine ⟨min c d, lt_min hc hd, p, ?_⟩
    intro T hT
    by_cases hTN : N ≤ T
    · exact (mul_le_mul_of_nonneg_right (min_le_left c d)
        (BayesOptimal.Foundations.Rates.invPower_nonneg p T)).trans (hN T hTN)
    · have hfT := hsmall T (Finset.mem_range.mpr (by omega))
      dsimp [f] at hfT
      rw [if_pos hT] at hfT
      have hTp : 0 < (T : ℝ) ^ p := pow_pos
        (by exact_mod_cast (show 0 < T by omega)) _
      unfold BayesOptimal.Foundations.Rates.invPower
      rw [← div_eq_mul_inv]
      exact (div_le_iff₀ hTp).mpr ((min_le_right c d).trans hfT)

/-- The same exact characterization using the original definition whose lower
bound is required for every integer T ≥ 5, not just eventually. -/
theorem polynomialTailLowerBound_iff_isBigO (gap : ℕ → ℝ)
    (hgap : ∀ T, 0 ≤ gap T) :
    BayesOptimal.Footnote14Scale.PolynomialTailLowerBound gap ↔
      gap =O[atTop] (fun T : ℕ => (T : ℝ) ^ (-(3 : ℝ) / 2) *
        Real.sqrt (Real.log (T : ℝ))) := by
  rw [polynomialTailLowerBound_iff_eventually, eventuallyPolynomialTail_iff_isBigO gap hgap]

/-- The smaller O(T^-3/2) scale is sufficient, although the separately proved
counterexample shows it is not necessary for a polynomial tail lower bound. -/
theorem polynomialTailLowerBound_of_original_scale (gap : ℕ → ℝ)
    (hgap : gap =O[atTop] (fun T : ℕ => (T : ℝ) ^ (-(3 : ℝ) / 2))) :
    BayesOptimal.Footnote14Scale.PolynomialTailLowerBound gap := by
  apply (polynomialTailLowerBound_iff_eventually gap).mpr
  apply eventuallyPolynomialTail_of_isBigO gap
  apply hgap.trans
  apply Asymptotics.IsBigO.of_bound 1
  filter_upwards [eventually_ge_atTop (5 : ℕ)] with T hT
  rw [← BayesOptimal.Footnote14Scale.standardDeviation_eq_paper_scale,
    Real.norm_eq_abs, Real.norm_eq_abs,
    abs_of_pos (standardDeviation_pos T (by omega)),
    abs_of_nonneg (show 0 ≤ logarithmicGap T by
      unfold logarithmicGap standardDeviation
      positivity), one_mul]
  exact le_mul_of_one_le_right (standardDeviation_pos T (by omega)).le
    (Real.one_le_sqrt.mpr (BayesOptimal.Foundations.Drift.log_horizon_ge_one T hT))

/-- A positive real exponent and an explicit starting horizon give the same
polynomial lower-bound condition as an eventual bound with a natural exponent.
Increasing the exponent handles a natural exponent equal to zero. -/
theorem realExponentPolynomialTail_iff_eventually (gap : ℕ → ℝ) :
    (∃ c : ℝ, 0 < c ∧ ∃ p : ℝ, 0 < p ∧ ∃ T0 : ℕ, ∀ T : ℕ, T0 ≤ T →
      c * (T : ℝ) ^ (-p) ≤
        (gaussianReal 0 (((T : ℝ≥0) ^ 3)⁻¹)).real (Ici (gap T))) ↔
      EventuallyPolynomialTail gap := by
  constructor
  · rintro ⟨c, hc, p, _hp, T0, hbound⟩
    obtain ⟨n, hn⟩ := exists_nat_ge p
    refine ⟨c, hc, n, ?_⟩
    filter_upwards [eventually_ge_atTop T0, eventually_ge_atTop (1 : ℕ)] with T hT hT1
    have hpow : BayesOptimal.Foundations.Rates.invPower n T ≤ (T : ℝ) ^ (-p) := by
      unfold BayesOptimal.Foundations.Rates.invPower
      rw [← Real.rpow_natCast, ← Real.rpow_neg (Nat.cast_nonneg T)]
      exact Real.rpow_le_rpow_of_exponent_le (by exact_mod_cast hT1) (neg_le_neg hn)
    exact (mul_le_mul_of_nonneg_left hpow hc.le).trans (hbound T hT)
  · rintro ⟨c, hc, n, hbound⟩
    obtain ⟨N, hN⟩ := eventually_atTop.mp hbound
    refine ⟨c, hc, (n : ℝ) + 1, by positivity, max N 1, ?_⟩
    intro T hT
    have hT1 : 1 ≤ T := (le_max_right N 1).trans hT
    have hpow : (T : ℝ) ^ (-((n : ℝ) + 1)) ≤ BayesOptimal.Foundations.Rates.invPower n T := by
      unfold BayesOptimal.Foundations.Rates.invPower
      rw [← Real.rpow_natCast, ← Real.rpow_neg (Nat.cast_nonneg T)]
      exact Real.rpow_le_rpow_of_exponent_le (by exact_mod_cast hT1) (by linarith)
    exact (mul_le_mul_of_nonneg_left hpow hc.le).trans
      (hN T ((le_max_left N 1).trans hT))

/-- Exact corrected footnote statement: for every nonnegative threshold sequence,
a positive polynomial lower bound with real constants c > 0 and p > 0, valid
from an explicit natural horizon T0 onward, is equivalent to the sharp
O(T^(-3/2) sqrt(log T)) scale. The probability is the actual Gaussian law. -/
theorem corrected_footnote14_iff (d : ℕ → ℝ) (hd : ∀ T, 0 ≤ d T) :
    (∃ c : ℝ, 0 < c ∧ ∃ p : ℝ, 0 < p ∧ ∃ T0 : ℕ, ∀ T : ℕ, T0 ≤ T →
      c * (T : ℝ) ^ (-p) ≤
        (gaussianReal 0 (((T : ℝ≥0) ^ 3)⁻¹)).real (Ici (d T))) ↔
      d =O[atTop] (fun T : ℕ => (T : ℝ) ^ (-(3 : ℝ) / 2) *
        Real.sqrt (Real.log (T : ℝ))) := by
  rw [realExponentPolynomialTail_iff_eventually,
    eventuallyPolynomialTail_iff_isBigO d hd]

end
end BayesOptimal.Footnote14Characterization

end

/-! ## InitialOptimalHistory -/
section

set_option linter.unusedSectionVars false

open MeasureTheory ProbabilityTheory

namespace BayesOptimal.HistoryPolicy

open BayesOptimal.FiniteGaussian BayesOptimal.EmbeddingRaw BayesOptimal.EmbeddingExecution
open BayesOptimal.PolicyContinuation

noncomputable section

variable {A : Type*} [Fintype A] [Nonempty A] [DecidableEq A]
variable [MeasurableSpace A] [MeasurableSingletonClass A]

/-- The observable history records every chosen arm, its actual reward, and
the randomizer used for that decision. Past randomization is available to
later decisions; no unrevealed reward or latent mean is available. -/
abbrev History (A : Type*) (n : ℕ) := Fin n → A × (ℝ × ℝ)

/-- A general Borel, finite-history adaptive sampling algorithm. Its rules
can use the complete observation and randomization history, not merely a
posterior state. The eventual horizon is fixed by the interpreter. -/
structure Policy (A : Type*) [MeasurableSpace A] where
  draw : (n : ℕ) → History A n → ℝ → A
  recommend : (n : ℕ) → History A n → ℝ → A
  draw_measurable : ∀ n, Measurable (fun p : History A n × ℝ => draw n p.1 p.2)
  recommend_measurable : ∀ n,
    Measurable (fun p : History A n × ℝ => recommend n p.1 p.2)

def append {n : ℕ} (h : History A n) (a : A) (y u : ℝ) : History A (n + 1) :=
  Fin.snoc h (a, (y, u))

theorem append_measurable (n : ℕ) :
    Measurable (fun p : History A n × (A × (ℝ × ℝ)) =>
      append p.1 p.2.1 p.2.2.1 p.2.2.2) := by
  apply measurable_pi_lambda
  intro j
  refine Fin.lastCases ?_ (fun i => ?_) j
  · simpa only [append, Fin.snoc_last] using
      (measurable_snd : Measurable (fun p : History A n × (A × (ℝ × ℝ)) => p.2))
  · simpa only [append, Fin.snoc_castSucc] using
      (measurable_pi_apply i).comp
        (measurable_fst : Measurable (fun p : History A n × (A × (ℝ × ℝ)) => p.1))

/-- Explicit compilation of a history algorithm into a raw-observation
strategy. Exactly one selected raw reward is supplied at each sample node. -/
def toRaw (π : Policy A) (n : ℕ) : (H : ℕ) → History A n → Seeds H → Strategy (A := A) H
  | 0, h, u => .stop (π.recommend n h (u ⟨0, by omega⟩))
  | H + 1, h, u =>
      let a := π.draw n h (u ⟨0, by omega⟩)
      .sample a (fun y => toRaw π (n + 1) H
        (append h a y (u ⟨0, by omega⟩)) (seedTail u))

abbrev Input (A : Type*) (n H : ℕ) := History A n × (Seeds H × RawStream A H)

/-- Compilation is jointly Borel in the initial history, all fresh seeds,
and the entire raw calendar array. This is proved from the policy rules. -/
theorem toRaw_run_measurable (π : Policy A) (n H : ℕ) :
    Measurable (fun p : Input A n H => run (toRaw π n H p.1 p.2.1) p.2.2) := by
  induction H generalizing n with
  | zero =>
      exact (π.recommend_measurable n).comp (measurable_fst.prodMk
        ((measurable_pi_apply (⟨0, by omega⟩ : Fin 1)).comp
          (measurable_fst.comp measurable_snd)))
  | succ H ih =>
      let g : Input A n (H + 1) × A → A := fun p =>
        run (toRaw π (n + 1) H
          (append p.1.1 p.2 (p.1.2.2 p.2 ⟨0, by omega⟩)
            (p.1.2.1 ⟨0, by omega⟩)) (seedTail p.1.2.1)) (tail p.1.2.2)
      have hg : Measurable g := by
        apply measurable_from_prod_countable_left
        intro a
        have hh : Measurable (fun p : Input A n (H + 1) =>
            append p.1 a (p.2.2 a ⟨0, by omega⟩) (p.2.1 ⟨0, by omega⟩)) :=
          (append_measurable n).comp (show Measurable (fun p : Input A n (H + 1) =>
            (p.1, (a, (p.2.2 a ⟨0, by omega⟩, p.2.1 ⟨0, by omega⟩)))) by fun_prop)
        have ht : Measurable (fun p : Input A n (H + 1) =>
            (append p.1 a (p.2.2 a ⟨0, by omega⟩) (p.2.1 ⟨0, by omega⟩),
              (seedTail p.2.1, tail p.2.2))) := by
          apply hh.prodMk
          unfold seedTail tail
          fun_prop
        exact (ih (n + 1)).comp ht
      have ha : Measurable (fun p : Input A n (H + 1) =>
          π.draw n p.1 (p.2.1 ⟨0, by omega⟩)) :=
        (π.draw_measurable n).comp (measurable_fst.prodMk
          ((measurable_pi_apply (⟨0, by omega⟩ : Fin (H + 2))).comp
            (measurable_fst.comp measurable_snd)))
      exact hg.comp (measurable_id.prodMk ha)

/-- Every fixed-seed compiled policy satisfies the raw strategy's recursive
regularity requirements. No regularity assumption is added to the policy. -/
theorem toRaw_regular (π : Policy A) (n H : ℕ) (h : History A n) (u : Seeds H) :
    Regular (toRaw π n H h u) := by
  induction H generalizing n with
  | zero => trivial
  | succ H ih =>
      constructor
      · intro y
        exact ih (n + 1) _ (seedTail u)
      · let a := π.draw n h (u ⟨0, by omega⟩)
        have hh : Measurable (fun p : ℝ × RawStream A H =>
            append h a p.1 (u ⟨0, by omega⟩)) :=
          (append_measurable n).comp (show Measurable (fun p : ℝ × RawStream A H =>
            (h, (a, (p.1, u ⟨0, by omega⟩)))) by fun_prop)
        exact (toRaw_run_measurable π (n + 1) H).comp
          (hh.prodMk (measurable_const.prodMk measurable_snd))

theorem toRaw_budget (π : Policy A) (n H : ℕ) (h : History A n)
    (u : Seeds H) (r : RawStream A H) :
    (trace (toRaw π n H h u) r).length = H := trace_budget _ _

/-- Direct history semantics, independently of the raw-strategy datatype. -/
def recommendation (π : Policy A) (n : ℕ) : (H : ℕ) →
    History A n → Seeds H → RawStream A H → A
  | 0, h, u, _ => π.recommend n h (u ⟨0, by omega⟩)
  | H + 1, h, u, r =>
      let a := π.draw n h (u ⟨0, by omega⟩)
      recommendation π (n + 1) H
        (append h a (r a ⟨0, by omega⟩) (u ⟨0, by omega⟩)) (seedTail u) (tail r)

def sampledArms (π : Policy A) (n : ℕ) : (H : ℕ) →
    History A n → Seeds H → RawStream A H → List A
  | 0, _, _, _ => []
  | H + 1, h, u, r =>
      let a := π.draw n h (u ⟨0, by omega⟩)
      a :: sampledArms π (n + 1) H
        (append h a (r a ⟨0, by omega⟩) (u ⟨0, by omega⟩)) (seedTail u) (tail r)

/-- Pointwise semantic equality, with no probabilistic equivalence premise. -/
theorem toRaw_run_eq (π : Policy A) (n H : ℕ) (h : History A n)
    (u : Seeds H) (r : RawStream A H) :
    run (toRaw π n H h u) r = recommendation π n H h u r := by
  induction H generalizing n with
  | zero => rfl
  | succ H ih =>
      exact ih (n + 1) _ (seedTail u) (tail r)

theorem toRaw_trace_eq (π : Policy A) (n H : ℕ) (h : History A n)
    (u : Seeds H) (r : RawStream A H) :
    trace (toRaw π n H h u) r = sampledArms π n H h u r := by
  induction H generalizing n with
  | zero => rfl
  | succ H ih =>
      exact congrArg (List.cons (π.draw n h (u ⟨0, by omega⟩)))
        (ih (n + 1) _ (seedTail u) (tail r))

/-- Actual latent Gaussian/noise execution of every Borel history algorithm
therefore has the proved Bellman lower bound. This includes arbitrary use
of observed histories and past randomizers. -/
theorem history_risk_ge_loss (π : Policy A) (n H : ℕ) (h : History A n)
    (u : Seeds H) (c : Precisions A) (m : Means A) (hc : ∀ a, 0 < c a) :
    BayesOptimal.FinitePosterior.loss H c m ≤
      ∫ w, maxAll w.1 - w.1 (recommendation π n H h u (observations w))
        ∂worldLaw H c m := by
  simpa only [rawRisk, toRaw_run_eq] using
    rawRisk_ge_loss (toRaw π n H h u) c m hc (toRaw_regular π n H h u)

theorem toRaw_family_measurable (π : Policy A) (n H : ℕ) (h : History A n) :
    Measurable (fun p : Seeds H × RawStream A H => run (toRaw π n H h p.1) p.2) :=
  (toRaw_run_measurable π n H).comp (measurable_const.prodMk measurable_id)

/-- Independent fresh randomization does not change the exact encoding:
the history algorithm is a feasible randomized raw-strategy family. -/
theorem toRaw_family_feasible (π : Policy BayesOptimal.Foundations.BayesianModel.Arm)
    (n H : ℕ) (h : History BayesOptimal.Foundations.BayesianModel.Arm n) :
    BayesOptimal.SequentialRisk.Feasible (fun u => toRaw π n H h u) := by
  exact ⟨fun u => toRaw_regular π n H h u, toRaw_family_measurable π n H h⟩

def actualRisk (π : Policy A) (n H : ℕ) (h : History A n)
    (c : Precisions A) (m : Means A) : ℝ :=
  ∫ u, ∫ w, maxAll w.1 - w.1 (recommendation π n H h u (observations w))
    ∂worldLaw H c m ∂BayesOptimal.Policy.seedLaw (H + 1)

theorem randomized_history_risk_ge_loss (π : Policy A) (n H : ℕ) (h : History A n)
    (c : Precisions A) (m : Means A) (hc : ∀ a, 0 < c a) :
    BayesOptimal.FinitePosterior.loss H c m ≤ actualRisk π n H h c m := by
  simpa only [actualRisk, rawRisk, toRaw_run_eq] using
    BayesOptimal.EmbeddingRandomized.randomized_rawRisk_ge_loss
      (BayesOptimal.Policy.seedLaw (H + 1)) (fun u => toRaw π n H h u) c m hc
      (fun u => toRaw_regular π n H h u) (toRaw_family_measurable π n H h)

theorem familyRisk_eq_actualRisk (π : Policy BayesOptimal.Foundations.BayesianModel.Arm)
    (n H : ℕ) (h : History BayesOptimal.Foundations.BayesianModel.Arm n)
    (c : BayesOptimal.Foundations.BayesianModel.Counts) (m : BayesOptimal.Foundations.BayesianModel.Means) :
    BayesOptimal.SequentialRisk.familyRisk (fun u => toRaw π n H h u) c m =
      actualRisk π n H h (BayesOptimal.CountModelBridge.natPrecisions c) m := by
  simp only [BayesOptimal.SequentialRisk.familyRisk, rawRisk, toRaw_run_eq, actualRisk]

/-- The initialization-only optimality premise competes against every
Borel full-history algorithm above, rather than just posterior-state rules.
This is an actual-risk inequality, using the explicit encoding theorem. -/
theorem minimizing_actualRisk_le_history (π : BayesOptimal.Policy.StatePolicy)
    (t H : ℕ) (c : BayesOptimal.Foundations.BayesianModel.Counts) (m : BayesOptimal.Foundations.BayesianModel.Means)
    (hπ : BayesOptimal.SequentialRisk.MinimizesActualRisk π t H c m)
    (ρ : Policy BayesOptimal.Foundations.BayesianModel.Arm) (n : ℕ)
    (h : History BayesOptimal.Foundations.BayesianModel.Arm n) :
    BayesOptimal.SequentialRisk.continuationRisk π t H c m ≤
      actualRisk ρ n H h (BayesOptimal.CountModelBridge.natPrecisions c) m := by
  have hi := hπ (fun u => toRaw ρ n H h u) (toRaw_family_feasible ρ n H h)
  rwa [familyRisk_eq_actualRisk] at hi

end
end BayesOptimal.HistoryPolicy

end

/-! ## RealPrecisionPolicy -/
section

set_option autoImplicit false
set_option warningAsError true
set_option linter.unusedSectionVars false
set_option maxHeartbeats 1000000

open MeasureTheory ProbabilityTheory
open scoped NNReal ENNReal

namespace BayesOptimal.RealPrecisionPolicy

open BayesOptimal.FiniteGaussian BayesOptimal.FinitePosterior
open BayesOptimal.PolicyContinuation BayesOptimal.EmbeddingRaw BayesOptimal.EmbeddingExecution

variable {A : Type*} [Fintype A] [Nonempty A] [DecidableEq A]
variable [MeasurableSpace A] [MeasurableSingletonClass A]

noncomputable section

/-- Posterior-state rules on the full real-precision Gaussian state space.
The draw index is the number of samples remaining after that draw. A finite
horizon converts this index to the paper's calendar stage. -/
structure Policy (A : Type*) [MeasurableSpace A] where
  draw : ℕ → Precisions A → Means A → ℝ → A
  recommend : Precisions A → Means A → ℝ → A
  draw_measurable : ∀ k, Measurable (fun p : (Precisions A × Means A) × ℝ =>
    draw k p.1.1 p.1.2 p.2)
  recommend_measurable : Measurable (fun p : (Precisions A × Means A) × ℝ =>
    recommend p.1.1 p.1.2 p.2)

/-- Actual raw-observation execution consumes only a fresh seed and the
chosen arm's next reward. Precisions and means undergo the conjugate update. -/
def rawTree (π : Policy A) : (H : ℕ) → Precisions A → Means A → Seeds H → Strategy (A := A) H
  | 0, c, m, u => .stop (π.recommend c m (u ⟨0, by omega⟩))
  | H + 1, c, m, u =>
      let a := π.draw H c m (u ⟨0, by omega⟩)
      .sample a (fun y => rawTree π H (advance c a)
        (shift m a ((y - m a) / ((c a : ℝ) + 1))) (seedTail u))

abbrev Input (A : Type*) (H : ℕ) :=
  (Precisions A × Means A) × (Seeds H × RawStream A H)

theorem updatedState_measurable (H : ℕ) (a : A) :
    Measurable (fun p : Input A (H + 1) =>
      (advance p.1.1 a, shift p.1.2 a
        ((p.2.2 a ⟨0, by omega⟩ - p.1.2 a) / ((p.1.1 a : ℝ) + 1)))) := by
  apply Measurable.prodMk
  · exact (JointGaussianMeasurable.advance_measurable a).comp
      (measurable_fst.comp measurable_fst)
  · have hz : Measurable (fun p : Input A (H + 1) =>
        (p.2.2 a ⟨0, by omega⟩ - p.1.2 a) / ((p.1.1 a : ℝ) + 1)) := by fun_prop
    exact (JointGaussianMeasurable.shift_joint_measurable a).comp
      ((measurable_snd.comp measurable_fst).prodMk hz)

/-- The entire interpreter is jointly Borel in all real precisions, means,
fresh seeds, and raw observations. -/
theorem rawTree_run_measurable (π : Policy A) (H : ℕ) :
    Measurable (fun p : Input A H => run (rawTree π H p.1.1 p.1.2 p.2.1) p.2.2) := by
  induction H with
  | zero =>
    exact π.recommend_measurable.comp (measurable_fst.prodMk
      ((measurable_pi_apply (⟨0, by omega⟩ : Fin 1)).comp
        (measurable_fst.comp measurable_snd)))
  | succ H ih =>
    let g : Input A (H + 1) × A → A := fun p =>
      run (rawTree π H (advance p.1.1.1 p.2)
        (shift p.1.1.2 p.2 ((p.1.2.2 p.2 ⟨0, by omega⟩ - p.1.1.2 p.2) /
          ((p.1.1.1 p.2 : ℝ) + 1))) (seedTail p.1.2.1)) (tail p.1.2.2)
    have hg : Measurable g := by
      apply measurable_from_prod_countable_left
      intro a
      have hin : Measurable (fun p : Input A (H + 1) =>
          ((advance p.1.1 a, shift p.1.2 a
            ((p.2.2 a ⟨0, by omega⟩ - p.1.2 a) / ((p.1.1 a : ℝ) + 1))),
              (seedTail p.2.1, tail p.2.2))) := by
        apply (updatedState_measurable H a).prodMk
        unfold seedTail tail
        fun_prop
      exact ih.comp hin
    have ha : Measurable (fun p : Input A (H + 1) =>
        π.draw H p.1.1 p.1.2 (p.2.1 ⟨0, by omega⟩)) :=
      (π.draw_measurable H).comp (measurable_fst.prodMk
        ((measurable_pi_apply (⟨0, by omega⟩ : Fin (H + 2))).comp
          (measurable_fst.comp measurable_snd)))
    exact hg.comp (measurable_id.prodMk ha)

theorem rawTree_regular (π : Policy A) (H : ℕ) (c : Precisions A) (m : Means A)
    (u : Seeds H) : Regular (rawTree π H c m u) := by
  induction H generalizing c m with
  | zero => trivial
  | succ H ih =>
    constructor
    · intro y
      exact ih _ _ (seedTail u)
    · let a := π.draw H c m (u ⟨0, by omega⟩)
      have hin : Measurable (fun p : ℝ × RawStream A H =>
          ((advance c a, shift m a ((p.1 - m a) / ((c a : ℝ) + 1))), (seedTail u, p.2))) := by
        apply Measurable.prodMk
        · apply (measurable_const : Measurable (fun _ : ℝ × RawStream A H => advance c a)).prodMk
          have hz : Measurable (fun p : ℝ × RawStream A H =>
              ((p.1 - m a) / ((c a : ℝ) + 1))) := by fun_prop
          exact (JointGaussianMeasurable.shift_joint_measurable a).comp
            ((measurable_const : Measurable (fun _ : ℝ × RawStream A H => m)).prodMk hz)
        · exact measurable_const.prodMk measurable_snd
      exact (rawTree_run_measurable π H).comp hin

theorem rawTree_family_measurable (π : Policy A) (H : ℕ) (c : Precisions A) (m : Means A) :
    Measurable (fun p : Seeds H × RawStream A H => run (rawTree π H c m p.1) p.2) := by
  have hin : Measurable (fun p : Seeds H × RawStream A H => ((c, m), p)) :=
    measurable_const.prodMk measurable_id
  exact (rawTree_run_measurable π H).comp hin

theorem rawTree_budget (π : Policy A) (H : ℕ) (c : Precisions A) (m : Means A)
    (u : Seeds H) (r : RawStream A H) : (trace (rawTree π H c m u) r).length = H :=
  trace_budget _ _

/-- Actual posterior expected simple regret, including independent scalar
Gaussian policy seeds and the actual latent-parameter/noise execution. -/
def actualRisk (π : Policy A) (H : ℕ) (c : Precisions A) (m : Means A) : ℝ :=
  ∫ u, rawRisk (rawTree π H c m u) c m ∂BayesOptimal.Policy.seedLaw (H + 1)

theorem actualRisk_eq_joint (π : Policy A) (H : ℕ) (c : Precisions A) (m : Means A) :
    actualRisk π H c m =
      ∫ p : Seeds H × (Means A × RawStream A H),
        maxAll p.2.1 - p.2.1 (run (rawTree π H c m p.1) (observations p.2))
        ∂(BayesOptimal.Policy.seedLaw (H + 1)).prod (worldLaw H c m) := by
  exact (integral_prod _ (EmbeddingRandomized.randomizedPayoff_integrable
    (BayesOptimal.Policy.seedLaw (H + 1)) (fun u => rawTree π H c m u) c m
      (rawTree_family_measurable π H c m))).symm

section Ordered
variable [LinearOrder A]

/-- One globally Borel policy, with the exact minimum-index optimal action
and recommendation at every Gaussian state and every remaining horizon. -/
def canonical : Policy A where
  draw := fun k c m _ => JointGaussianMeasurable.minimumOptimal k c m
  recommend := fun _ m _ => MockTie.minimumMaximizer m
  draw_measurable := fun k =>
    (JointGaussianMeasurable.minimumOptimal_joint_measurable k).comp measurable_fst
  recommend_measurable := MockTie.minimumMaximizer_measurable.comp
    (measurable_snd.comp measurable_fst)

/-- Every fixed-seed execution of the same global real-precision policy
attains the actual posterior loss. The Gaussian observation disintegration
is invoked through rawRisk_succ, rather than assumed. -/
theorem canonical_rawRisk (H : ℕ) (c : Precisions A) (m : Means A)
    (u : Seeds H) (hc : ∀ a, 0 < c a) :
    rawRisk (rawTree (canonical (A := A)) H c m u) c m = loss H c m := by
  induction H generalizing c m with
  | zero =>
    simp only [rawTree, canonical, rawRisk_zero, terminalRegret_eq,
      MockTie.minimumMaximizer_attains, loss, value]
  | succ H ih =>
    let a := JointGaussianMeasurable.minimumOptimal H c m
    let next : ℝ → Strategy (A := A) H := fun y =>
      rawTree canonical H (advance c a)
        (shift m a ((y - m a) / ((c a : ℝ) + 1))) (seedTail u)
    have htree : rawTree (canonical (A := A)) (H + 1) c m u = .sample a next := rfl
    have hreg : Regular (.sample a next) := by
      rw [← htree]
      exact rawTree_regular canonical (H + 1) c m u
    rw [htree, rawRisk_succ a next c m (hc a) hreg.2]
    calc
      _ = ∫ z, loss H (advance c a) (shift m a z) ∂gaussianReal 0 (innovation c a) := by
        apply integral_congr_ae
        apply Filter.Eventually.of_forall
        intro z
        simp only [next, recovered_innovation]
        exact ih _ _ (seedTail u) (advance_positive c a hc)
      _ = loss (H + 1) c m :=
        JointGaussianMeasurable.minimumOptimal_actionLoss H c m hc

theorem canonical_actualRisk (H : ℕ) (c : Precisions A) (m : Means A)
    (hc : ∀ a, 0 < c a) : actualRisk (canonical (A := A)) H c m = loss H c m := by
  unfold actualRisk
  simp only [canonical_rawRisk H c m _ hc]
  simp

/-- Sequential posterior optimality against all concrete Borel history
algorithms, including arbitrary dependence on observed histories and past
randomizers. States here have arbitrary positive REAL precisions. -/
def SequentiallyOptimal (π : Policy A) : Prop :=
  ∀ (H : ℕ) (c : Precisions A) (m : Means A), (∀ a, 0 < c a) →
    ∀ (ρ : HistoryPolicy.Policy A) (n : ℕ) (h : HistoryPolicy.History A n),
      actualRisk π H c m ≤ HistoryPolicy.actualRisk ρ n H h c m

theorem canonical_sequentiallyOptimal : SequentiallyOptimal (canonical (A := A)) := by
  intro H c m hc ρ n h
  rw [canonical_actualRisk H c m hc]
  exact HistoryPolicy.randomized_history_risk_ge_loss ρ n H h c m hc

/-- Existence of a globally Borel sequentially optimal Gaussian-state
policy, not a family of selectors chosen separately at fixed precisions. -/
theorem exists_globally_borel_sequentiallyOptimal :
    ∃ π : Policy A, SequentiallyOptimal π :=
  ⟨canonical, canonical_sequentiallyOptimal⟩

end Ordered
end
end BayesOptimal.RealPrecisionPolicy

end

/-! ## GeneralOptimalityHistory -/
section

set_option autoImplicit false
set_option warningAsError true
set_option linter.unusedSectionVars false
set_option maxHeartbeats 1500000

open MeasureTheory ProbabilityTheory
open scoped NNReal ENNReal

namespace BayesOptimal.GeneralOptimality

open BayesOptimal.FiniteGaussian BayesOptimal.FinitePosterior
open BayesOptimal.PolicyContinuation BayesOptimal.EmbeddingRaw BayesOptimal.EmbeddingExecution

noncomputable section

variable {A : Type*} [Fintype A] [Nonempty A] [DecidableEq A]
variable [MeasurableSpace A] [MeasurableSingletonClass A]

/-- The conjugate update on the full real-precision Gaussian state space,
using only the selected arm and its observed reward. -/
def updateState (a : A) (p : (Precisions A × Means A) × ℝ) : Precisions A × Means A :=
  (advance p.1.1 a, shift p.1.2 a ((p.2 - p.1.2 a) / ((p.1.1 a : ℝ) + 1)))

theorem updateState_measurable (a : A) : Measurable (updateState a) := by
  apply Measurable.prodMk
  · exact (JointGaussianMeasurable.advance_measurable a).comp
      (measurable_fst.comp measurable_fst)
  · exact (JointGaussianMeasurable.shift_joint_measurable a).comp
      ((measurable_snd.comp measurable_fst).prodMk (by fun_prop))

theorem updateState_joint_measurable :
    Measurable (fun p : A × ((Precisions A × Means A) × ℝ) => updateState p.1 p.2) :=
  measurable_from_prod_countable_right updateState_measurable

/-- Reconstruct the posterior from the observed finite history. Past
randomizers are observable but do not enter the Gaussian update. -/
def foldState (c0 : Precisions A) (m0 : Means A) : (n : ℕ) →
    HistoryPolicy.History A n → Precisions A × Means A
  | 0, _ => (c0, m0)
  | n + 1, h =>
      let p := foldState c0 m0 n (Fin.init h)
      let z := h (Fin.last n)
      updateState z.1 (p, z.2.1)

theorem foldState_append (c0 : Precisions A) (m0 : Means A) (n : ℕ)
    (h : HistoryPolicy.History A n) (a : A) (y u : ℝ) :
    foldState c0 m0 (n + 1) (HistoryPolicy.append h a y u) =
      updateState a (foldState c0 m0 n h, y) := by
  simp only [foldState, HistoryPolicy.append, Fin.init_snoc, Fin.snoc_last]

theorem foldState_measurable (c0 : Precisions A) (m0 : Means A) (n : ℕ) :
    Measurable (foldState c0 m0 n) := by
  induction n with
  | zero => exact measurable_const
  | succ n ih =>
    have hh : Measurable (fun h : HistoryPolicy.History A (n + 1) => Fin.init h) := by
      unfold Fin.init
      fun_prop
    have hp := ih.comp hh
    have hz : Measurable (fun h : HistoryPolicy.History A (n + 1) => h (Fin.last n)) :=
      measurable_pi_apply _
    exact updateState_joint_measurable.comp (hz.fst.prodMk (hp.prodMk hz.snd.fst))

/-- A real-precision posterior-state policy is a concrete Borel history
policy. The compiler sees no latent means, future seeds, or unobserved rewards.
The argument N is the fixed total number of draws after the starting state. -/
def compile (π : RealPrecisionPolicy.Policy A) (N : ℕ)
    (c0 : Precisions A) (m0 : Means A) : HistoryPolicy.Policy A where
  draw := fun n h u =>
    let p := foldState c0 m0 n h
    π.draw (N - (n + 1)) p.1 p.2 u
  recommend := fun n h u =>
    let p := foldState c0 m0 n h
    π.recommend p.1 p.2 u
  draw_measurable := by
    intro n
    have hp := (foldState_measurable c0 m0 n).comp
      (measurable_fst : Measurable (fun p : HistoryPolicy.History A n × ℝ => p.1))
    exact (π.draw_measurable (N - (n + 1))).comp (hp.prodMk measurable_snd)
  recommend_measurable := by
    intro n
    have hp := (foldState_measurable c0 m0 n).comp
      (measurable_fst : Measurable (fun p : HistoryPolicy.History A n × ℝ => p.1))
    exact π.recommend_measurable.comp (hp.prodMk measurable_snd)

/-- Exact equality of compiled raw strategies at every reachable stage,
including every selected reward, posterior update, and fresh randomizer. -/
theorem toRaw_compile (π : RealPrecisionPolicy.Policy A) (N n H : ℕ)
    (c0 : Precisions A) (m0 : Means A) (h : HistoryPolicy.History A n)
    (u : Seeds H) (horizon : n + H = N) :
    HistoryPolicy.toRaw (compile π N c0 m0) n H h u =
      RealPrecisionPolicy.rawTree π H
        (foldState c0 m0 n h).1 (foldState c0 m0 n h).2 u := by
  induction H generalizing n with
  | zero => rfl
  | succ H ih =>
    have hindex : N - (n + 1) = H := by omega
    let p := foldState c0 m0 n h
    let a := π.draw H p.1 p.2 (u ⟨0, by omega⟩)
    change Strategy.sample (π.draw (N - (n + 1)) p.1 p.2 (u ⟨0, by omega⟩))
      (fun y => HistoryPolicy.toRaw (compile π N c0 m0) (n + 1) H
        (HistoryPolicy.append h
          (π.draw (N - (n + 1)) p.1 p.2 (u ⟨0, by omega⟩))
          y (u ⟨0, by omega⟩)) (seedTail u)) =
      Strategy.sample a (fun y => RealPrecisionPolicy.rawTree π H (advance p.1 a)
        (shift p.2 a ((y - p.2 a) / ((p.1 a : ℝ) + 1))) (seedTail u))
    simp only [hindex]
    congr 1
    funext y
    rw [ih (n + 1) _ (seedTail u) (by omega), foldState_append]
    rfl

def emptyHistory : HistoryPolicy.History A 0 := Fin.elim0

/-- Exact identity of actual posterior risks, obtained by compilation into
the same latent-Gaussian and raw-observation execution. -/
theorem actualRisk_compile (π : RealPrecisionPolicy.Policy A) (H : ℕ)
    (c : Precisions A) (m : Means A) :
    HistoryPolicy.actualRisk (compile π H c m) 0 H emptyHistory c m =
      RealPrecisionPolicy.actualRisk π H c m := by
  simp only [HistoryPolicy.actualRisk, RealPrecisionPolicy.actualRisk, rawRisk,
    ← HistoryPolicy.toRaw_run_eq]
  apply integral_congr_ae
  apply Filter.Eventually.of_forall
  intro u
  have he := toRaw_compile π H 0 H c m emptyHistory u (by omega)
  simpa only [foldState] using congrArg (fun s : Strategy (A := A) H =>
    ∫ w, maxAll w.1 - w.1 (run s (observations w)) ∂worldLaw H c m) he

end
end BayesOptimal.GeneralOptimality

end

/-! ## GeneralOptimality -/
section

set_option autoImplicit false
set_option warningAsError true
set_option linter.unusedSectionVars false
set_option maxHeartbeats 1500000

open MeasureTheory ProbabilityTheory
open scoped NNReal ENNReal

namespace BayesOptimal.GeneralOptimality

open BayesOptimal.FiniteGaussian BayesOptimal.FinitePosterior
open BayesOptimal.PolicyContinuation BayesOptimal.EmbeddingRaw BayesOptimal.EmbeddingExecution
open BayesOptimal.RealPrecisionPolicy

noncomputable section

variable {A : Type*} [Fintype A] [Nonempty A] [DecidableEq A]
variable [MeasurableSpace A] [MeasurableSingletonClass A] [LinearOrder A]

/-- Actual posterior risk minimization at this single starting state,
against every concrete Borel history policy. This contains no Bellman-action
condition and no optimality assumption at other states or horizons. -/
def MinimizesHistoryRisk (π : Policy A) (H : ℕ) (c : Precisions A) (m : Means A) : Prop :=
  ∀ ρ : HistoryPolicy.Policy A,
    actualRisk π H c m ≤ HistoryPolicy.actualRisk ρ 0 H emptyHistory c m

theorem actualRisk_ge_loss (π : Policy A) (H : ℕ) (c : Precisions A) (m : Means A)
    (hc : ∀ a, 0 < c a) : loss H c m ≤ actualRisk π H c m :=
  EmbeddingRandomized.randomized_rawRisk_ge_loss (BayesOptimal.Policy.seedLaw (H + 1))
    (rawTree π H c m) c m hc (rawTree_regular π H c m)
      (rawTree_family_measurable π H c m)

/-- The optimum is the Gaussian Bellman loss for every finite arm set and
every positive real precision vector. The upper bound uses an explicitly
compiled concrete history competitor, not an abstract selector premise. -/
theorem minimizing_actualRisk_eq_loss (π : Policy A) (H : ℕ)
    (c : Precisions A) (m : Means A) (hc : ∀ a, 0 < c a)
    (hπ : MinimizesHistoryRisk π H c m) : actualRisk π H c m = loss H c m := by
  apply le_antisymm _ (actualRisk_ge_loss π H c m hc)
  have h := hπ (compile (canonical (A := A)) H c m)
  rwa [actualRisk_compile, canonical_actualRisk H c m hc] at h

theorem minimizesHistoryRisk_iff_actualRisk_eq_loss (π : Policy A) (H : ℕ)
    (c : Precisions A) (m : Means A) (hc : ∀ a, 0 < c a) :
    MinimizesHistoryRisk π H c m ↔ actualRisk π H c m = loss H c m := by
  constructor
  · exact minimizing_actualRisk_eq_loss π H c m hc
  · intro he ρ
    rw [he]
    exact HistoryPolicy.randomized_history_risk_ge_loss ρ 0 H emptyHistory c m hc

/-- Minimum actual risk forces almost every fixed-seed raw execution to
attain that same loss. This is derived from integrability and the raw-strategy
lower bound, without assuming any action is optimal. -/
theorem minimizing_rawRisk_eq_loss_ae (π : Policy A) (H : ℕ)
    (c : Precisions A) (m : Means A) (hc : ∀ a, 0 < c a)
    (hπ : MinimizesHistoryRisk π H c m) :
    ∀ᵐ u ∂BayesOptimal.Policy.seedLaw (H + 1),
      rawRisk (rawTree π H c m u) c m = loss H c m := by
  apply SequentialRisk.ae_eq_const_of_lower_integral _ _ _
    (EmbeddingRandomized.randomized_rawRisk_integrable (BayesOptimal.Policy.seedLaw (H + 1))
      (rawTree π H c m) c m (rawTree_family_measurable π H c m))
    (fun u => rawRisk_ge_loss _ c m hc (rawTree_regular π H c m u))
  exact (minimizing_actualRisk_eq_loss π H c m hc hπ).le

/-- Necessity of the Bellman sampling rule for ANY policy minimizing
actual risk at this state: only a null set of its fresh scalar seeds can
choose a nonoptimal action. There is no three-arm or integer-count restriction. -/
theorem minimizing_draw_ae (π : Policy A) (H : ℕ)
    (c : Precisions A) (m : Means A) (hc : ∀ a, 0 < c a)
    (hπ : MinimizesHistoryRisk π (H + 1) c m) :
    ∀ᵐ u : ℝ ∂gaussianReal 0 1,
      action H c m (π.draw H c m u) = value (H + 1) c m := by
  have hh : ∀ᵐ u : Seeds (H + 1) ∂BayesOptimal.Policy.seedLaw (H + 2),
      action H c m (π.draw H c m (u ⟨0, by omega⟩)) = value (H + 1) c m := by
    filter_upwards [minimizing_rawRisk_eq_loss_ae π (H + 1) c m hc hπ] with u hu
    apply (BayesOptimal.DecisionRules.actionLoss_eq_loss_iff H c m _ (hc _)).mp
    apply le_antisymm _ (BayesOptimal.DecisionRules.actionLoss_minimal H c m hc _)
    calc
      _ ≤ rawRisk (rawTree π (H + 1) c m u) c m :=
        rawRisk_ge_actionLoss (π.draw H c m (u ⟨0, by omega⟩)) _ c m hc
          (rawTree_regular π (H + 1) c m u)
      _ = _ := hu
  have hp : MeasurableSet {u : ℝ |
      action H c m (π.draw H c m u) = value (H + 1) c m} := by
    have hd : Measurable (π.draw H c m) := (π.draw_measurable H).comp
      ((measurable_const : Measurable (fun _ : ℝ => (c, m))).prodMk measurable_id)
    exact measurableSet_eq_fun ((measurable_of_countable (action H c m)).comp hd)
      measurable_const
  exact SequentialRisk.seed_head_ae (H + 1) _ hp hh

/-- Theorem 1's sampling rule, with EBI as in Eq. (9), at a single state
and for arbitrary K: any posterior-risk
minimizer samples an arm maximizing expected Bellman improvement almost surely. -/
theorem minimizing_draw_EBI_ae (π : Policy A) (H : ℕ)
    (c : Precisions A) (m : Means A) (hc : ∀ a, 0 < c a)
    (hπ : MinimizesHistoryRisk π (H + 1) c m) :
    ∀ᵐ u : ℝ ∂gaussianReal 0 1,
      ∀ a, BayesOptimal.DecisionRules.EBI H c m a ≤ BayesOptimal.DecisionRules.EBI H c m (π.draw H c m u) := by
  filter_upwards [minimizing_draw_ae π H c m hc hπ] with u hu
  exact (BayesOptimal.DecisionRules.optimal_action_iff_EBI_max H c m _ hc).mp hu

/-- Theorem 1's terminal rule, using the loss of Eq. (6), for arbitrary K: every actual-risk
minimizer recommends a largest posterior mean almost surely. -/
theorem minimizing_recommend_ae (π : Policy A)
    (c : Precisions A) (m : Means A) (hc : ∀ a, 0 < c a)
    (hπ : MinimizesHistoryRisk π 0 c m) :
    ∀ᵐ u : ℝ ∂gaussianReal 0 1, m (π.recommend c m u) = maxAll m := by
  have hh : ∀ᵐ u : Seeds 0 ∂BayesOptimal.Policy.seedLaw 1,
      m (π.recommend c m (u ⟨0, by omega⟩)) = maxAll m := by
    filter_upwards [minimizing_rawRisk_eq_loss_ae π 0 c m hc hπ] with u hu
    simp only [RealPrecisionPolicy.rawTree, rawRisk_zero, terminalRegret_eq, loss, value] at hu
    linarith
  have hp : MeasurableSet {u : ℝ | m (π.recommend c m u) = maxAll m} := by
    have hd : Measurable (π.recommend c m) := π.recommend_measurable.comp
      ((measurable_const : Measurable (fun _ : ℝ => (c, m))).prodMk measurable_id)
    exact measurableSet_eq_fun ((measurable_of_countable m).comp hd) measurable_const
  exact SequentialRisk.seed_head_ae 0 _ hp hh

/-- Sequential risk optimality restricted to one finite horizon N. Only
the remaining horizons 0 through N are quantified, matching a fixed-budget
algorithm; no optimality at larger horizons is assumed. -/
def SequentiallyOptimalUpTo (π : Policy A) (N : ℕ) : Prop :=
  ∀ (H : ℕ), H ≤ N → ∀ (c : Precisions A) (m : Means A), (∀ a, 0 < c a) →
    MinimizesHistoryRisk π H c m

/-- Theorem 1's necessity and risk identity, for arbitrary finite arm sets,
arbitrary positive REAL precisions, and any fixed finite budget. The sampling
and recommendation conclusions are derived from actual-risk optimality. -/
theorem theorem1 (π : Policy A) (N : ℕ) (hπ : SequentiallyOptimalUpTo π N) :
    (∀ H, H ≤ N → ∀ c m, (∀ a, 0 < c a) → actualRisk π H c m = loss H c m) ∧
    (∀ H, H < N → ∀ c m, (∀ a, 0 < c a) →
      ∀ᵐ u : ℝ ∂gaussianReal 0 1,
        ∀ a, BayesOptimal.DecisionRules.EBI H c m a ≤ BayesOptimal.DecisionRules.EBI H c m (π.draw H c m u)) ∧
    (∀ c m, (∀ a, 0 < c a) →
      ∀ᵐ u : ℝ ∂gaussianReal 0 1, m (π.recommend c m u) = maxAll m) := by
  refine ⟨?_, ?_, ?_⟩
  · intro H hH c m hc
    exact minimizing_actualRisk_eq_loss π H c m hc (hπ H hH c m hc)
  · intro H hH c m hc
    exact minimizing_draw_EBI_ae π H c m hc (hπ (H + 1) (by omega) c m hc)
  · intro c m hc
    exact minimizing_recommend_ae π c m hc (hπ 0 (Nat.zero_le N) c m hc)

theorem sequentiallyOptimal_implies_upTo (π : Policy A)
    (hπ : RealPrecisionPolicy.SequentiallyOptimal π) (N : ℕ) :
    SequentiallyOptimalUpTo π N := by
  intro H _ c m hc ρ
  exact hπ H c m hc ρ 0 emptyHistory

/-- The finite-budget class is nonempty: one globally Borel real-precision
policy simultaneously supplies a witness for every finite budget. -/
theorem exists_sequentiallyOptimalUpTo (N : ℕ) :
    ∃ π : Policy A, SequentiallyOptimalUpTo π N :=
  ⟨canonical, sequentiallyOptimal_implies_upTo canonical canonical_sequentiallyOptimal N⟩

end
end BayesOptimal.GeneralOptimality

end

/-! ## GeneralOptimalityProper -/
section

set_option autoImplicit false
set_option warningAsError true
set_option linter.unusedSectionVars false
set_option maxHeartbeats 1500000

open MeasureTheory ProbabilityTheory
open scoped NNReal ENNReal

namespace BayesOptimal.GeneralOptimality.ProperDomain

open BayesOptimal.FiniteGaussian BayesOptimal.FinitePosterior
open BayesOptimal.PolicyContinuation BayesOptimal.EmbeddingRaw BayesOptimal.EmbeddingExecution

noncomputable section

variable {A : Type*} [Fintype A] [Nonempty A] [DecidableEq A]
variable [MeasurableSpace A] [MeasurableSingletonClass A]

/-- Exactly the paper's proper product-Gaussian posterior domain: means
are arbitrary reals and every precision is a strictly positive real. -/
def State (A : Type*) := {p : Precisions A × Means A // ∀ a, 0 < p.1 a}

instance : MeasurableSpace (State A) := inferInstanceAs
  (MeasurableSpace {p : Precisions A × Means A // ∀ a, 0 < p.1 a})

/-- Borel policy rules defined only on proper Gaussian states. No behavior
or regularity is required at zero-precision states. -/
structure Policy (A : Type*) [MeasurableSpace A] where
  draw : ℕ → State A → ℝ → A
  recommend : State A → ℝ → A
  draw_measurable : ∀ k, Measurable (fun p : State A × ℝ => draw k p.1 p.2)
  recommend_measurable : Measurable (fun p : State A × ℝ => recommend p.1 p.2)

theorem proper_input_measurableSet :
    MeasurableSet {p : (Precisions A × Means A) × ℝ | ∀ a, 0 < p.1.1 a} := by
  simp only [Set.setOf_forall]
  exact MeasurableSet.iInter (fun a => measurableSet_lt measurable_const
    ((measurable_pi_apply a).comp (measurable_fst.comp measurable_fst)))

/-- Extend only for interoperability with the globally defined interpreter.
On the unused improper states the policy chooses one fixed arm. -/
def extend (π : Policy A) : RealPrecisionPolicy.Policy A where
  draw := fun k c m u => if hc : ∀ a, 0 < c a then π.draw k ⟨(c, m), hc⟩ u
    else Classical.choice (inferInstance : Nonempty A)
  recommend := fun c m u => if hc : ∀ a, 0 < c a then π.recommend ⟨(c, m), hc⟩ u
    else Classical.choice (inferInstance : Nonempty A)
  draw_measurable := by
    intro k
    let S : Set ((Precisions A × Means A) × ℝ) := {p | ∀ a, 0 < p.1.1 a}
    have hf : Measurable (fun p : S => π.draw k ⟨p.1.1, p.2⟩ p.1.2) := by
      exact (π.draw_measurable k).comp
        (((measurable_fst.comp measurable_subtype_coe).subtype_mk).prodMk
          (measurable_snd.comp measurable_subtype_coe))
    exact hf.dite measurable_const proper_input_measurableSet
  recommend_measurable := by
    let S : Set ((Precisions A × Means A) × ℝ) := {p | ∀ a, 0 < p.1.1 a}
    have hf : Measurable (fun p : S => π.recommend ⟨p.1.1, p.2⟩ p.1.2) := by
      exact π.recommend_measurable.comp
        (((measurable_fst.comp measurable_subtype_coe).subtype_mk).prodMk
          (measurable_snd.comp measurable_subtype_coe))
    exact hf.dite measurable_const proper_input_measurableSet

theorem extend_draw (π : Policy A) (k : ℕ) (s : State A) (u : ℝ) :
    (extend π).draw k s.1.1 s.1.2 u = π.draw k s u := by
  rcases s with ⟨⟨c, m⟩, hc⟩
  simp only [extend, dif_pos hc]

theorem extend_recommend (π : Policy A) (s : State A) (u : ℝ) :
    (extend π).recommend s.1.1 s.1.2 u = π.recommend s u := by
  rcases s with ⟨⟨c, m⟩, hc⟩
  simp only [extend, dif_pos hc]

/-- The actual observed-reward conjugate update remains inside the proper
domain, so an execution never invokes the arbitrary extension branch. -/
def update (s : State A) (a : A) (y : ℝ) : State A :=
  ⟨GeneralOptimality.updateState a (s.1, y), advance_positive s.1.1 a s.2⟩

/-- Direct execution of the policy on its original proper domain. This
definition does not refer to the extension. -/
def rawTree (π : Policy A) : (H : ℕ) → State A → Seeds H → Strategy (A := A) H
  | 0, s, u => .stop (π.recommend s (u ⟨0, by omega⟩))
  | H + 1, s, u =>
      let a := π.draw H s (u ⟨0, by omega⟩)
      .sample a (fun y => rawTree π H (update s a y) (seedTail u))

/-- Pointwise equality of the independently defined direct and extended
executions, for every reward history and every seed array. -/
theorem rawTree_extend (π : Policy A) (H : ℕ) (s : State A) (u : Seeds H) :
    RealPrecisionPolicy.rawTree (extend π) H s.1.1 s.1.2 u = rawTree π H s u := by
  induction H generalizing s with
  | zero => simp only [RealPrecisionPolicy.rawTree, rawTree, extend_recommend]
  | succ H ih =>
    simp only [RealPrecisionPolicy.rawTree, rawTree, extend_draw]
    congr 1
    funext y
    exact ih (update s (π.draw H s (u ⟨0, by omega⟩)) y) (seedTail u)

/-- Actual posterior expected regret of the direct proper-domain policy,
integrated over the latent Gaussian parameter, observations, and fresh seeds. -/
def actualRisk (π : Policy A) (H : ℕ) (s : State A) : ℝ :=
  ∫ u, rawRisk (rawTree π H s u) s.1.1 s.1.2 ∂BayesOptimal.Policy.seedLaw (H + 1)

theorem actualRisk_extend (π : Policy A) (H : ℕ) (s : State A) :
    RealPrecisionPolicy.actualRisk (extend π) H s.1.1 s.1.2 = actualRisk π H s := by
  simp only [RealPrecisionPolicy.actualRisk, actualRisk, rawTree_extend]

/-- Single-state minimization against the concrete continuation policies of
Definition 3, using the directly defined proper-domain execution. -/
def MinimizesHistoryRisk (π : Policy A) (H : ℕ) (s : State A) : Prop :=
  ∀ ρ : HistoryPolicy.Policy A,
    actualRisk π H s ≤ HistoryPolicy.actualRisk ρ 0 H GeneralOptimality.emptyHistory s.1.1 s.1.2

theorem minimizing_extend_iff (π : Policy A) (H : ℕ) (s : State A) :
    GeneralOptimality.MinimizesHistoryRisk (extend π) H s.1.1 s.1.2 ↔
      MinimizesHistoryRisk π H s := by
  simp only [GeneralOptimality.MinimizesHistoryRisk, MinimizesHistoryRisk, actualRisk_extend]

/-- Fixed-budget sequential posterior optimality on exactly the paper's
proper-state domain, requiring only the remaining horizons 0 through N. -/
def SequentiallyOptimalUpTo (π : Policy A) (N : ℕ) : Prop :=
  ∀ H, H ≤ N → ∀ s : State A, MinimizesHistoryRisk π H s

theorem sequentiallyOptimalUpTo_extend (π : Policy A) (N : ℕ)
    (hπ : SequentiallyOptimalUpTo π N) :
    GeneralOptimality.SequentiallyOptimalUpTo (extend π) N := by
  intro H hH c m hc
  exact (minimizing_extend_iff π H ⟨(c, m), hc⟩).mpr (hπ H hH ⟨(c, m), hc⟩)

section Ordered
variable [LinearOrder A]

/-- Theorem 1 for ANY Borel posterior-state policy on the exact proper
Gaussian domain in the manuscript. All three conclusions use its direct
actual-observation execution; extending to improper states is an internal
proved construction, not an extra hypothesis on the paper's policy. -/
theorem theorem1 (π : Policy A) (N : ℕ) (hπ : SequentiallyOptimalUpTo π N) :
    (∀ H, H ≤ N → ∀ s : State A, actualRisk π H s = loss H s.1.1 s.1.2) ∧
    (∀ H, H < N → ∀ s : State A,
      ∀ᵐ u : ℝ ∂gaussianReal 0 1,
        ∀ a, BayesOptimal.DecisionRules.EBI H s.1.1 s.1.2 a ≤
          BayesOptimal.DecisionRules.EBI H s.1.1 s.1.2 (π.draw H s u)) ∧
    (∀ s : State A, ∀ᵐ u : ℝ ∂gaussianReal 0 1,
      s.1.2 (π.recommend s u) = maxAll s.1.2) := by
  obtain ⟨hr, hd, ht⟩ := GeneralOptimality.theorem1 (extend π) N
    (sequentiallyOptimalUpTo_extend π N hπ)
  refine ⟨?_, ?_, ?_⟩
  · intro H hH s
    simpa only [actualRisk_extend] using hr H hH s.1.1 s.1.2 s.2
  · intro H hH s
    simpa only [extend_draw] using hd H hH s.1.1 s.1.2 s.2
  · intro s
    simpa only [extend_recommend] using ht s.1.1 s.1.2 s.2

end Ordered
end
end BayesOptimal.GeneralOptimality.ProperDomain

end

/-! ## GeneralOptimalityFinite -/
section

set_option autoImplicit false
set_option warningAsError true
set_option linter.unusedSectionVars false
set_option maxHeartbeats 1500000

open MeasureTheory ProbabilityTheory
open scoped NNReal ENNReal

namespace BayesOptimal.GeneralOptimality.FiniteHorizon

open BayesOptimal.FiniteGaussian BayesOptimal.FinitePosterior
open BayesOptimal.PolicyContinuation BayesOptimal.EmbeddingRaw BayesOptimal.EmbeddingExecution
open ProperDomain (State)

noncomputable section

variable {A : Type*} [Fintype A] [Nonempty A] [DecidableEq A]
variable [MeasurableSpace A] [MeasurableSingletonClass A]

/-- The manuscript's finite collection of Borel posterior-state rules.
There are exactly N sampling rules and one terminal rule, all defined only
on proper Gaussian posteriors. Index j is the number of draws remaining
after that sampling decision, so the calendar order is N-1,...,0. -/
structure Policy (A : Type*) [MeasurableSpace A] (N : ℕ) where
  draw : Fin N → State A → ℝ → A
  recommend : State A → ℝ → A
  draw_measurable : ∀ j, Measurable (fun p : State A × ℝ => draw j p.1 p.2)
  recommend_measurable : Measurable (fun p : State A × ℝ => recommend p.1 p.2)

variable {N : ℕ}

/-- Pad the finite collection by a constant arm at unused indices. Thus
the paper's policy has no extra rules or Borel requirements outside its budget. -/
def extend (π : Policy A N) : ProperDomain.Policy A where
  draw := fun H s u => if hH : H < N then π.draw ⟨H, hH⟩ s u
    else Classical.choice (inferInstance : Nonempty A)
  recommend := π.recommend
  draw_measurable := by
    intro H
    by_cases hH : H < N
    · simpa only [dif_pos hH] using π.draw_measurable ⟨H, hH⟩
    · simpa only [dif_neg hH] using
        (measurable_const : Measurable (fun _ : State A × ℝ =>
          Classical.choice (inferInstance : Nonempty A)))
  recommend_measurable := π.recommend_measurable

theorem extend_draw (π : Policy A N) (j : Fin N) (s : State A) (u : ℝ) :
    (extend π).draw j.val s u = π.draw j s u := by
  simp only [extend, dif_pos j.isLt]

theorem extend_recommend (π : Policy A N) (s : State A) (u : ℝ) :
    (extend π).recommend s u = π.recommend s u := rfl

/-- Direct raw-observation execution of the finite collection itself.
Every draw index carries its proof of membership in Fin N. -/
def rawTree (π : Policy A N) : (H : ℕ) → H ≤ N →
    State A → Seeds H → Strategy (A := A) H
  | 0, _, s, u => .stop (π.recommend s (u ⟨0, by omega⟩))
  | H + 1, hH, s, u =>
      let a := π.draw ⟨H, by omega⟩ s (u ⟨0, by omega⟩)
      .sample a (fun y => rawTree π H (by omega)
        (ProperDomain.update s a y) (seedTail u))

/-- Padding changes no raw strategy at any stage of the given budget. -/
theorem rawTree_extend (π : Policy A N) (H : ℕ) (hH : H ≤ N)
    (s : State A) (u : Seeds H) :
    ProperDomain.rawTree (extend π) H s u = rawTree π H hH s u := by
  induction H generalizing s with
  | zero => rfl
  | succ H ih =>
    have hlt : H < N := by omega
    simp only [ProperDomain.rawTree, rawTree, extend, dif_pos hlt]
    congr 1
    funext y
    exact ih (by omega) _ (seedTail u)

/-- Actual posterior expected simple regret of the finite policy's direct
latent-parameter and raw-observation execution. -/
def actualRisk (π : Policy A N) (H : ℕ) (hH : H ≤ N) (s : State A) : ℝ :=
  ∫ u, rawRisk (rawTree π H hH s u) s.1.1 s.1.2 ∂BayesOptimal.Policy.seedLaw (H + 1)

theorem actualRisk_extend (π : Policy A N) (H : ℕ) (hH : H ≤ N) (s : State A) :
    ProperDomain.actualRisk (extend π) H s = actualRisk π H hH s := by
  simp only [ProperDomain.actualRisk, actualRisk, rawTree_extend π H hH]

/-- Definition 3's minimization at one proper posterior and one remaining
horizon, against all concrete Borel history continuation policies. -/
def MinimizesHistoryRisk (π : Policy A N) (H : ℕ) (hH : H ≤ N) (s : State A) : Prop :=
  ∀ ρ : HistoryPolicy.Policy A,
    actualRisk π H hH s ≤ HistoryPolicy.actualRisk ρ 0 H
      GeneralOptimality.emptyHistory s.1.1 s.1.2

theorem minimizing_extend_iff (π : Policy A N) (H : ℕ) (hH : H ≤ N) (s : State A) :
    ProperDomain.MinimizesHistoryRisk (extend π) H s ↔
      MinimizesHistoryRisk π H hH s := by
  simp only [ProperDomain.MinimizesHistoryRisk, MinimizesHistoryRisk, actualRisk_extend π H hH]

/-- Equation (2) for a fixed finite collection of posterior-state rules.
There is no premise or policy rule at a horizon larger than N. -/
def SequentiallyOptimal (π : Policy A N) : Prop :=
  ∀ (H : ℕ) (hH : H ≤ N) (s : State A), MinimizesHistoryRisk π H hH s

theorem sequentiallyOptimal_extend (π : Policy A N) (hπ : SequentiallyOptimal π) :
    ProperDomain.SequentiallyOptimalUpTo (extend π) N := by
  intro H hH s
  exact (minimizing_extend_iff π H hH s).mpr (hπ H hH s)

section Ordered
variable [LinearOrder A]

/-- Theorem 1 for the literal finite collection of Borel proper-state
rules: every actual-risk minimizing algorithm has the Bellman risk, chooses
an EBI-maximizing arm, and recommends a largest posterior mean almost surely.
All conclusions concern the direct finite-policy execution. -/
theorem theorem1 (π : Policy A N) (hπ : SequentiallyOptimal π) :
    (∀ (H : ℕ) (hH : H ≤ N) (s : State A),
      actualRisk π H hH s = loss H s.1.1 s.1.2) ∧
    (∀ j : Fin N, ∀ s : State A, ∀ᵐ u : ℝ ∂gaussianReal 0 1,
      ∀ a, BayesOptimal.DecisionRules.EBI j.val s.1.1 s.1.2 a ≤
        BayesOptimal.DecisionRules.EBI j.val s.1.1 s.1.2 (π.draw j s u)) ∧
    (∀ s : State A, ∀ᵐ u : ℝ ∂gaussianReal 0 1,
      s.1.2 (π.recommend s u) = maxAll s.1.2) := by
  obtain ⟨hr, hd, ht⟩ := ProperDomain.theorem1 (extend π) N
    (sequentiallyOptimal_extend π hπ)
  refine ⟨?_, ?_, ?_⟩
  · intro H hH s
    simpa only [actualRisk_extend π H hH] using hr H hH s
  · intro j s
    simpa only [extend_draw] using hd j.val j.isLt s
  · intro s
    simpa only [extend_recommend] using ht s

/-- The minimum-index Bellman selector is a member of the literal finite
paper-policy class, including the case N=0 with only a terminal decision. -/
def canonical : Policy A N where
  draw := fun j s _ => JointGaussianMeasurable.minimumOptimal j.val s.1.1 s.1.2
  recommend := fun s _ => MockTie.minimumMaximizer s.1.2
  draw_measurable := fun j =>
    (JointGaussianMeasurable.minimumOptimal_joint_measurable j.val).comp
      (measurable_subtype_coe.comp measurable_fst)
  recommend_measurable := MockTie.minimumMaximizer_measurable.comp
    (measurable_snd.comp (measurable_subtype_coe.comp measurable_fst))

theorem canonical_rawTree (H : ℕ) (hH : H ≤ N) (s : State A) (u : Seeds H) :
    rawTree (canonical (A := A) (N := N)) H hH s u =
      RealPrecisionPolicy.rawTree RealPrecisionPolicy.canonical H s.1.1 s.1.2 u := by
  induction H generalizing s with
  | zero => rfl
  | succ H ih =>
    simp only [rawTree, canonical, RealPrecisionPolicy.rawTree, RealPrecisionPolicy.canonical]
    congr 1
    funext y
    exact ih (by omega)
      (ProperDomain.update s (JointGaussianMeasurable.minimumOptimal H s.1.1 s.1.2) y)
      (seedTail u)

theorem canonical_actualRisk (H : ℕ) (hH : H ≤ N) (s : State A) :
    actualRisk (canonical (A := A) (N := N)) H hH s = loss H s.1.1 s.1.2 := by
  unfold actualRisk
  simp only [canonical_rawTree, RealPrecisionPolicy.canonical_rawRisk H s.1.1 s.1.2 _ s.2]
  simp

theorem canonical_sequentiallyOptimal :
    SequentiallyOptimal (canonical (A := A) (N := N)) := by
  intro H hH s ρ
  rw [canonical_actualRisk H hH s]
  exact HistoryPolicy.randomized_history_risk_ge_loss ρ 0 H
    GeneralOptimality.emptyHistory s.1.1 s.1.2 s.2

/-- The finite proper-state policy class used by the exact paper theorem
has a concrete Borel minimizing policy for every fixed budget. -/
theorem exists_sequentiallyOptimal (N : ℕ) :
    ∃ π : Policy A N, SequentiallyOptimal π :=
  ⟨canonical, canonical_sequentiallyOptimal⟩

end Ordered
end
end BayesOptimal.GeneralOptimality.FiniteHorizon

end

/-! ## PosteriorStateHistory -/
section

set_option autoImplicit false
set_option warningAsError true
set_option maxHeartbeats 1000000

open MeasureTheory ProbabilityTheory

namespace BayesOptimal.PosteriorStateHistory

open BayesOptimal.Foundations.BayesianModel
open BayesOptimal.Policy BayesOptimal.PolicyContinuation BayesOptimal.CountModelBridge
open BayesOptimal.EmbeddingRaw BayesOptimal.EmbeddingExecution BayesOptimal.SequentialRisk

noncomputable section

def updateData (ca : Counts × Arm) (my : Means × ℝ) : Counts × Means :=
  (advance ca.1 ca.2, shift my.1 ca.2 ((my.2 - my.1 ca.2) / ((ca.1 ca.2 : ℝ) + 1)))

theorem updateData_measurable :
    Measurable (fun p : (Counts × Arm) × (Means × ℝ) => updateData p.1 p.2) := by
  apply measurable_from_prod_countable_right
  intro ca
  change Measurable (fun y : Means × ℝ =>
    (advance ca.1 ca.2, shift y.1 ca.2 ((y.2 - y.1 ca.2) / ((ca.1 ca.2 : ℝ) + 1))))
  refine (measurable_const : Measurable (fun _ : Means × ℝ => advance ca.1 ca.2)).prodMk ?_
  apply measurable_pi_lambda
  intro a
  unfold shift
  split_ifs <;> fun_prop

/-- Fold only observed arm/reward pairs into the sufficient statistic.
The recorded past randomizers are available but the state update ignores them. -/
def foldState (c0 : Counts) (m0 : Means) : (n : ℕ) →
    HistoryPolicy.History Arm n → Counts × Means
  | 0, _ => (c0, m0)
  | n + 1, h =>
      let p := foldState c0 m0 n (Fin.init h)
      let z := h (Fin.last n)
      updateData (p.1, z.1) (p.2, z.2.1)

theorem foldState_append (c0 : Counts) (m0 : Means) (n : ℕ)
    (h : HistoryPolicy.History Arm n) (a : Arm) (y u : ℝ) :
    foldState c0 m0 (n + 1) (HistoryPolicy.append h a y u) =
      updateData ((foldState c0 m0 n h).1, a) ((foldState c0 m0 n h).2, y) := by
  simp only [foldState, HistoryPolicy.append, Fin.init_snoc, Fin.snoc_last]

theorem foldState_measurable (c0 : Counts) (m0 : Means) (n : ℕ) :
    Measurable (foldState c0 m0 n) := by
  induction n with
  | zero => exact measurable_const
  | succ n ih =>
    have hh : Measurable (fun h : HistoryPolicy.History Arm (n + 1) => Fin.init h) := by
      unfold Fin.init
      fun_prop
    have hp := ih.comp hh
    have hz : Measurable (fun h : HistoryPolicy.History Arm (n + 1) => h (Fin.last n)) :=
      measurable_pi_apply _
    exact updateData_measurable.comp
      ((hp.fst.prodMk hz.fst).prodMk (hp.snd.prodMk hz.snd.fst))

/-- A posterior-state policy is explicitly a Borel history policy. The
compiler uses no latent parameter, unobserved reward, or future seed. -/
def compile (π : StatePolicy) (t : ℕ) (c0 : Counts) (m0 : Means) : HistoryPolicy.Policy Arm where
  draw := fun n h u =>
    let p := foldState c0 m0 n h
    π.draw (t + n) p.1 p.2 u
  recommend := fun n h u =>
    let p := foldState c0 m0 n h
    π.recommend p.1 p.2 u
  draw_measurable := by
    intro n
    have hp := (foldState_measurable c0 m0 n).comp
      (measurable_fst : Measurable (fun p : HistoryPolicy.History Arm n × ℝ => p.1))
    exact (π.draw_measurable (t + n)).comp (hp.fst.prodMk (hp.snd.prodMk measurable_snd))
  recommend_measurable := by
    intro n
    have hp := (foldState_measurable c0 m0 n).comp
      (measurable_fst : Measurable (fun p : HistoryPolicy.History Arm n × ℝ => p.1))
    exact π.recommend_measurable.comp (hp.fst.prodMk (hp.snd.prodMk measurable_snd))

/-- The compiled history tree and the original state-policy continuation
are exactly the same raw strategy, including every posterior update. -/
theorem toRaw_compile (π : StatePolicy) (t n H : ℕ) (c0 : Counts) (m0 : Means)
    (h : HistoryPolicy.History Arm n) (u : Seeds H) :
    HistoryPolicy.toRaw (compile π t c0 m0) n H h u =
      rawTree π (t + n) H (foldState c0 m0 n h).1 (foldState c0 m0 n h).2 u := by
  induction H generalizing n with
  | zero => rfl
  | succ H ih =>
    let p := foldState c0 m0 n h
    let a := π.draw (t + n) p.1 p.2 (u ⟨0, by omega⟩)
    change BayesOptimal.FiniteGaussian.Strategy.sample a
      (fun y => HistoryPolicy.toRaw (compile π t c0 m0) (n + 1) H
        (HistoryPolicy.append h a y (u ⟨0, by omega⟩)) (seedTail u)) =
      BayesOptimal.FiniteGaussian.Strategy.sample a
        (fun y => rawTree π (t + n + 1) H (advance p.1 a)
          (shift p.2 a ((y - p.2 a) / ((p.1 a : ℝ) + 1))) (seedTail u))
    congr 1
    funext y
    rw [ih, foldState_append]
    have ht : t + (n + 1) = t + n + 1 := by omega
    simp only [updateData, ht, p]

def emptyHistory : HistoryPolicy.History Arm 0 := Fin.elim0

theorem actualRisk_compile (π : StatePolicy) (t H : ℕ) (c : Counts) (m : Means) :
    HistoryPolicy.actualRisk (compile π t c m) 0 H emptyHistory (natPrecisions c) m =
      continuationRisk π t H c m := by
  rw [← HistoryPolicy.familyRisk_eq_actualRisk]
  unfold continuationRisk
  congr 1
  funext u
  simpa only [Nat.add_zero, foldState] using toRaw_compile π t 0 H c m emptyHistory u

/-- Comparison against the paper's concrete prefix-randomized, Borel
history policies, rather than a raw family with the entire seed array as a
parameter. -/
def MinimizesHistoryRisk (π : StatePolicy) (t H : ℕ) (c : Counts) (m : Means) : Prop :=
  ∀ ρ : HistoryPolicy.Policy Arm,
    continuationRisk π t H c m ≤ HistoryPolicy.actualRisk ρ 0 H emptyHistory (natPrecisions c) m

/-- The two minimization predicates agree. The reverse implication uses a
concrete compiled Bellman history competitor that attains the actual loss;
the larger raw-family class cannot beat that loss by its proved lower bound. -/
theorem minimizesHistoryRisk_iff (π : StatePolicy) (T t H : ℕ) (c : Counts) (m : Means)
    (horizon : t + H = T + 1) (hc : ∀ a, 0 < c a) :
    MinimizesHistoryRisk π t H c m ↔ MinimizesActualRisk π t H c m := by
  constructor
  · intro hπ s hs
    have hp := hπ (compile (deterministicBellman T) t c m)
    rw [actualRisk_compile] at hp
    have he := minimizing_risk_eq_loss (deterministicBellman T) t H c m hc
      (deterministicBellman_minimizes_actual_risk T t H c m horizon hc)
    rw [he] at hp
    exact hp.trans (familyRisk_ge_loss s c m hs hc)
  · intro hπ ρ
    exact HistoryPolicy.minimizing_actualRisk_le_history π t H c m hπ ρ 0 emptyHistory

/-- Initialization-only posterior optimality against all concrete Borel
history algorithms. Each possible initialized mean is quantified separately. -/
def InitialHistoryRiskOptimal (π : StatePolicy) (T : ℕ) : Prop :=
  ∀ m : Means, MinimizesHistoryRisk π 4 (T - 3) (fun _ => 1) m

theorem initialHistoryRiskOptimal_iff (π : StatePolicy) (T : ℕ) (hT : 3 ≤ T) :
    InitialHistoryRiskOptimal π T ↔ InitialOptimal.InitialRiskOptimal π T := by
  constructor <;> intro hπ m
  · exact (minimizesHistoryRisk_iff π T 4 (T - 3) (fun _ => 1) m
      (by omega) (by intro a; norm_num)).mp (hπ m)
  · exact (minimizesHistoryRisk_iff π T 4 (T - 3) (fun _ => 1) m
      (by omega) (by intro a; norm_num)).mpr (hπ m)

end
end BayesOptimal.PosteriorStateHistory

end

/-! ## InitialHistoryMain -/
section

open Filter

namespace BayesOptimal.InitialHistoryMain

noncomputable section

open BayesOptimal.Policy BayesOptimal.PosteriorStateHistory

/-- The exact original frequentist risk is unchanged by the optimal repair
when the premise is minimization against concrete Borel history algorithms. -/
theorem regret_repair_eq (π : StatePolicy) (T : ℕ) (Δ : ℝ) (hT : 3 ≤ T)
    (hπ : InitialHistoryRiskOptimal π T) :
    BayesOptimal.Main.regret π T Δ = BayesOptimal.Main.regret (repair π T) T Δ :=
  BayesOptimal.FixedGaussian.initialRiskOptimal_regret_repair_eq π T Δ hT
    ((initialHistoryRiskOptimal_iff π T hT).mp hπ)

theorem theorem2 (Δ : ℝ) (hΔ : 0 < Δ) :
    ∃ (c : ℝ) (C T0 : ℕ), 0 < c ∧ 0 < C ∧
      ∀ T : ℕ, T0 ≤ T → Odd T → ∀ π : StatePolicy, InitialHistoryRiskOptimal π T →
        c * BayesOptimal.Foundations.Rates.invPower C T ≤ BayesOptimal.Main.regret π T Δ := by
  obtain ⟨c, C, T0, hc, hC, hmain⟩ := BayesOptimal.FixedGaussian.theorem2_initialRiskOptimal Δ hΔ
  refine ⟨c, C, max T0 3, hc, hC, ?_⟩
  intro T hT ho π hπ
  exact hmain T ((le_max_left T0 3).trans hT) ho π
    ((initialHistoryRiskOptimal_iff π T ((le_max_right T0 3).trans hT)).mp hπ)

theorem theorem2_paper_exponent (Δ : ℝ) (hΔ : 0 < Δ) :
    ∃ (c : ℝ) (T0 : ℕ), 0 < c ∧
      ∀ T : ℕ, T0 ≤ T → Odd T → ∀ π : StatePolicy, InitialHistoryRiskOptimal π T →
        c * (T : ℝ)^(-((33+Δ)^2/2+4)) ≤ BayesOptimal.Main.regret π T Δ := by
  obtain ⟨c, T0, hc, hmain⟩ := BayesOptimal.FixedGaussian.theorem2_paper_exponent_initialRiskOptimal Δ hΔ
  refine ⟨c, max T0 3, hc, ?_⟩
  intro T hT ho π hπ
  exact hmain T ((le_max_left T0 3).trans hT) ho π
    ((initialHistoryRiskOptimal_iff π T ((le_max_right T0 3).trans hT)).mp hπ)

theorem theorem2_exponential_rate (Δ : ℝ) (hΔ : 0 < Δ) (family : ℕ → StatePolicy)
    (hfamily : ∀ T, 3 ≤ T → InitialHistoryRiskOptimal (family T) T) :
    liminf (BayesOptimal.RegretExponent.rate
      (fun T => BayesOptimal.Main.regret (family T) T Δ)) atTop = 0 := by
  apply BayesOptimal.FixedGaussian.theorem2_exponential_rate_initialRiskOptimal Δ hΔ family
  intro T hT
  exact (initialHistoryRiskOptimal_iff _ _ hT).mp (hfamily T hT)

theorem remark2 (Δ : ℝ) (hΔ : 0 < Δ) (family : ℕ → StatePolicy)
    (hfamily : ∀ T, 3 ≤ T → InitialHistoryRiskOptimal (family T) T)
    (rFreq : ℕ → ℝ) (hF : ∀ T, 0 ≤ rFreq T)
    (hpositive : 0 < liminf (BayesOptimal.RegretExponent.rate rFreq) atTop) :
    limsup (BayesOptimal.RegretRatio.ratio
      (fun T => BayesOptimal.Main.regret (family T) T Δ) rFreq) atTop = ⊤ := by
  apply BayesOptimal.FixedGaussian.remark2_initialRiskOptimal Δ hΔ family _ rFreq hF hpositive
  intro T hT
  exact (initialHistoryRiskOptimal_iff _ _ hT).mp (hfamily T hT)

theorem exists_initialHistoryRiskOptimal (T : ℕ) (hT : 3 ≤ T) :
    ∃ π : StatePolicy, InitialHistoryRiskOptimal π T := by
  obtain ⟨π, hπ⟩ := BayesOptimal.FixedGaussian.exists_initialRiskOptimal T hT
  exact ⟨π, (initialHistoryRiskOptimal_iff π T hT).mpr hπ⟩

end
end BayesOptimal.InitialHistoryMain

end

/-! ## InitialOptimalTrace -/
section

open MeasureTheory ProbabilityTheory
open scoped NNReal ENNReal

namespace BayesOptimal.InitialOptimal

open BayesOptimal.Foundations.BayesianModel
open BayesOptimal.Policy BayesOptimal.PolicyContinuation BayesOptimal.CountModelBridge
open BayesOptimal.EmbeddingRaw BayesOptimal.EmbeddingExecution BayesOptimal.SequentialRisk

noncomputable section

instance : MeasurableSpace (List Arm) := ⊤

instance : MeasurableSingletonClass (List Arm) where
  measurableSet_singleton _ := trivial

/-- Conditional a.e. properties of an observed reward and remaining raw
observations hold in the parent actual latent/noise execution. -/
theorem conditional_property_ae {H : ℕ} (a : Arm)
    (c : BayesOptimal.FiniteGaussian.Precisions Arm) (m : Means) (hc : 0 < c a)
    (Q : ℝ × RawStream Arm H → Prop) (hQ : MeasurableSet {p | Q p})
    (hcond : ∀ᵐ z ∂gaussianReal 0 (BayesOptimal.FiniteGaussian.innovation c a),
      ∀ᵐ w ∂worldLaw H (BayesOptimal.FiniteGaussian.advance c a)
        (BayesOptimal.FiniteGaussian.shift m a z),
        Q (m a + ((c a : ℝ) + 1) * z, observations w)) :
    ∀ᵐ w ∂worldLaw (H + 1) c m,
      Q (observations w a ⟨0, by omega⟩, tail (observations w)) := by
  let P : (Means × ℝ) × RawStream Arm H → Prop := fun p =>
    Q (p.1.2, observations (p.1.1, p.2))
  have hP : MeasurableSet {p | P p} := hQ.preimage (by
    unfold observations
    fun_prop)
  have hpost' : ∀ᵐ p : ℝ × (Means × RawStream Arm H)
      ∂(gaussianReal 0 (BayesOptimal.FiniteGaussian.innovation c a)).prod
        ((BayesOptimal.FinitePosterior.centeredLaw (BayesOptimal.FiniteGaussian.advance c a)).prod
          (arrayLaw H)),
      P (ObservationBridge.reconstructedObservation c m a (p.1, p.2.1), p.2.2) := by
    apply (Measure.ae_prod_iff_ae_ae (hP.preimage (by fun_prop))).mpr
    filter_upwards [hcond] with z hz
    have htrans : MeasurePreserving (fun v : Means =>
        BayesOptimal.FiniteGaussian.shift m a z + v)
        (BayesOptimal.FinitePosterior.centeredLaw (BayesOptimal.FiniteGaussian.advance c a))
        (BayesOptimal.FinitePosterior.posteriorLaw (BayesOptimal.FiniteGaussian.advance c a)
          (BayesOptimal.FiniteGaussian.shift m a z)) := ⟨by fun_prop, rfl⟩
    exact (htrans.prod (MeasurePreserving.id (arrayLaw H))).quasiMeasurePreserving.ae hz
  have hpost := (measurePreserving_prodAssoc
    (gaussianReal 0 (BayesOptimal.FiniteGaussian.innovation c a))
    (BayesOptimal.FinitePosterior.centeredLaw (BayesOptimal.FiniteGaussian.advance c a))
    (arrayLaw H)).quasiMeasurePreserving.ae hpost'
  have hraw := observation_ae_transfer c m a hc P hP hpost
  have hsplit := (MeasurePreserving.symm MeasurableEquiv.prodAssoc
    (measurePreserving_prodAssoc (BayesOptimal.FinitePosterior.posteriorLaw c m)
      (gaussianReal 0 1) (arrayLaw H))).comp
      ((MeasurePreserving.id (BayesOptimal.FinitePosterior.posteriorLaw c m)).prod
        (selected_noise_split_preserving H a))
  exact hsplit.quasiMeasurePreserving.ae hraw

/-- Exact initial risk equality forces both optimality of the first arm and
exact conditional continuation-risk equality almost everywhere. -/
theorem exact_seed_successor_data (π : StatePolicy) (t H : ℕ) (c : Counts) (m : Means)
    (u : Seeds (H + 1)) (hc : ∀ a, 0 < c a)
    (heq : rawRisk (rawTree π t (H + 1) c m u) (natPrecisions c) m =
      BayesOptimal.FinitePosterior.loss (H + 1) (natPrecisions c) m) :
    let a := π.draw t c m (u ⟨0, by omega⟩)
    action H c m a = value (H + 1) c m ∧
      ∀ᵐ z ∂gaussianReal 0 (innovation c a),
        rawRisk (rawTree π (t + 1) H (advance c a) (shift m a z) (seedTail u))
          (natPrecisions (advance c a)) (shift m a z) =
          BayesOptimal.FinitePosterior.loss H (natPrecisions (advance c a)) (shift m a z) := by
  let a := π.draw t c m (u ⟨0, by omega⟩)
  let next : ℝ → BayesOptimal.FiniteGaussian.Strategy (A := Arm) H := fun y =>
    rawTree π (t + 1) H (advance c a)
      (shift m a ((y - m a) / ((c a : ℝ) + 1))) (seedTail u)
  have htree : rawTree π t (H + 1) c m u = .sample a next := rfl
  have hreg : Regular (.sample a next) := by
    rw [← htree]
    exact rawTree_regular π t (H + 1) c m u
  have hact : BayesOptimal.FinitePosterior.actionLoss H (natPrecisions c) m a =
      BayesOptimal.FinitePosterior.loss (H + 1) (natPrecisions c) m := by
    apply le_antisymm
    · calc
        _ ≤ rawRisk (.sample a next) (natPrecisions c) m :=
          rawRisk_ge_actionLoss a next _ _ (natPrecisions_positive c hc) hreg
        _ = _ := by rw [← htree, heq]
    · exact BayesOptimal.DecisionRules.actionLoss_minimal H _ _ (natPrecisions_positive c hc) a
  constructor
  · exact (actionLoss_eq_loss_iff H c m a (hc a)).mp hact
  · have hdata := rawRisk_succ_data a next (natPrecisions c) m
      (natPrecisions_positive c hc a) hreg.2
    have hlowint : Integrable (fun z => BayesOptimal.FinitePosterior.loss H
        (BayesOptimal.FiniteGaussian.advance (natPrecisions c) a)
        (BayesOptimal.FiniteGaussian.shift m a z))
        (gaussianReal 0 (BayesOptimal.FiniteGaussian.innovation (natPrecisions c) a)) :=
      (BayesOptimal.FiniteGaussian.shifted_integrable (BayesOptimal.FinitePosterior.potential_lipschitz _)
        m a _).sub (BayesOptimal.FiniteGaussian.action_integrable H (natPrecisions c) m a)
    have hlow (z : ℝ) : BayesOptimal.FinitePosterior.loss H
        (BayesOptimal.FiniteGaussian.advance (natPrecisions c) a)
        (BayesOptimal.FiniteGaussian.shift m a z) ≤
        rawRisk (next (m a + (((natPrecisions c a : ℝ≥0) : ℝ) + 1) * z))
          (BayesOptimal.FiniteGaussian.advance (natPrecisions c) a)
          (BayesOptimal.FiniteGaussian.shift m a z) :=
      rawRisk_ge_loss _ _ _
        (BayesOptimal.FinitePosterior.advance_positive _ a (natPrecisions_positive c hc)) (hreg.1 _)
    have he : ∀ᵐ z ∂gaussianReal 0
        (BayesOptimal.FiniteGaussian.innovation (natPrecisions c) a),
        rawRisk (next (m a + (((natPrecisions c a : ℝ≥0) : ℝ) + 1) * z))
          (BayesOptimal.FiniteGaussian.advance (natPrecisions c) a)
          (BayesOptimal.FiniteGaussian.shift m a z) =
        BayesOptimal.FinitePosterior.loss H
          (BayesOptimal.FiniteGaussian.advance (natPrecisions c) a)
          (BayesOptimal.FiniteGaussian.shift m a z) := by
      apply ((integral_eq_iff_of_ae_le hlowint hdata.2
        (Filter.Eventually.of_forall hlow)).mp ?_).symm
      change BayesOptimal.FinitePosterior.actionLoss H (natPrecisions c) m a = _
      rw [← hdata.1, ← htree, heq, hact]
    have hrecover (z : ℝ) :
        (m a + (((natPrecisions c a : ℝ≥0) : ℝ) + 1) * z - m a) /
          ((c a : ℝ) + 1) = z := by
      simpa only [natPrecisions, NNReal.coe_natCast] using
        recovered_innovation (natPrecisions c a) (m a) z
    simpa only [next, hrecover, advance_natPrecisions, shift_eq, innovation_eq] using he

theorem rawTree_trace_measurable (π : StatePolicy) (t H : ℕ) (c : Counts) :
    Measurable (fun p : Input H => trace (rawTree π t H c p.1 p.2.1) p.2.2) := by
  induction H generalizing t c with
  | zero => exact measurable_const
  | succ H ih =>
    let g : Input (H + 1) × Arm → List Arm := fun p =>
      p.2 :: trace (rawTree π (t + 1) H (advance c p.2)
        (shift p.1.1 p.2 ((p.1.2.2 p.2 ⟨0, by omega⟩ - p.1.1 p.2) /
          ((c p.2 : ℝ) + 1))) (seedTail p.1.2.1)) (tail p.1.2.2)
    have hg : Measurable g := by
      apply measurable_from_prod_countable_left
      intro a
      have hin : Measurable (fun p : Input (H + 1) =>
          (shift p.1 a ((p.2.2 a ⟨0, by omega⟩ - p.1 a) / ((c a : ℝ) + 1)),
            (seedTail p.2.1, tail p.2.2))) := by
        apply Measurable.prodMk
        · apply measurable_pi_lambda
          intro b
          simp only [shift]
          split_ifs <;> fun_prop
        · unfold seedTail tail
          fun_prop
      exact (measurable_of_countable (List.cons a)).comp ((ih (t + 1) (advance c a)).comp hin)
    have hdraw : Measurable (fun p : Input (H + 1) =>
        π.draw t c p.1 (p.2.1 ⟨0, by omega⟩)) := by
      exact (π.draw_measurable t).comp (measurable_const.prodMk
        (measurable_fst.prodMk ((measurable_pi_apply (⟨0, by omega⟩ : Fin (H + 2))).comp
          (measurable_fst.comp measurable_snd))))
    exact hg.comp (measurable_id.prodMk hdraw)

/-- The same null-history repair preserves the full ordered list of sampled
arms, rather than only the final recommendation. -/
theorem exact_seed_trace_repair_ae (π : StatePolicy) (T t H : ℕ) (c : Counts) (m : Means)
    (u : Seeds H) (horizon : t + H = T + 1) (ht : 4 ≤ t)
    (hc : ∀ a, 0 < c a)
    (heq : rawRisk (rawTree π t H c m u) (natPrecisions c) m =
      BayesOptimal.FinitePosterior.loss H (natPrecisions c) m) :
    ∀ᵐ w ∂worldLaw H (natPrecisions c) m,
      trace (rawTree π t H c m u) (observations w) =
        trace (rawTree (repair π T) t H c m u) (observations w) := by
  induction H generalizing t c m with
  | zero => exact Filter.Eventually.of_forall (fun _ => rfl)
  | succ H ih =>
      have hremaining : T - t = H := by omega
      let a := π.draw t c m (u ⟨0, by omega⟩)
      have hdata := exact_seed_successor_data π t H c m u hc heq
      have hrepair : (repair π T).draw t c m (u ⟨0, by omega⟩) = a := by
        have hgood : action (T - t) c m (π.draw t c m (u ⟨0, by omega⟩)) =
            value (T - t + 1) c m := by
          rw [hremaining]
          exact hdata.1
        simp only [repair, repairedDraw, if_pos hgood]
        rfl
      have hca : ∀ b, 0 < advance c a b := by
        intro b
        have hb := hc b
        simp only [advance]
        omega
      let Q : ℝ × RawStream Arm H → Prop := fun p =>
        trace (rawTree π (t + 1) H (advance c a)
          (shift m a ((p.1 - m a) / ((c a : ℝ) + 1))) (seedTail u)) p.2 =
        trace (rawTree (repair π T) (t + 1) H (advance c a)
          (shift m a ((p.1 - m a) / ((c a : ℝ) + 1))) (seedTail u)) p.2
      have hQ : MeasurableSet {p | Q p} := by
        have hin : Measurable (fun p : ℝ × RawStream Arm H =>
            (shift m a ((p.1 - m a) / ((c a : ℝ) + 1)), (seedTail u, p.2))) := by
          apply Measurable.prodMk
          · apply measurable_pi_lambda
            intro b
            simp only [shift]
            split_ifs <;> fun_prop
          · exact measurable_const.prodMk measurable_snd
        exact measurableSet_eq_fun_of_countable
          ((rawTree_trace_measurable π (t + 1) H (advance c a)).comp hin)
          ((rawTree_trace_measurable (repair π T) (t + 1) H (advance c a)).comp hin)
      have hcond : ∀ᵐ z ∂gaussianReal 0
          (BayesOptimal.FiniteGaussian.innovation (natPrecisions c) a),
          ∀ᵐ w ∂worldLaw H (BayesOptimal.FiniteGaussian.advance (natPrecisions c) a)
            (BayesOptimal.FiniteGaussian.shift m a z),
            Q (m a + (((natPrecisions c a : ℝ≥0) : ℝ) + 1) * z, observations w) := by
        filter_upwards [hdata.2] with z hz
        have hrecover :
            (m a + (((natPrecisions c a : ℝ≥0) : ℝ) + 1) * z - m a) /
              ((c a : ℝ) + 1) = z := by
          simpa only [natPrecisions, NNReal.coe_natCast] using
            recovered_innovation (natPrecisions c a) (m a) z
        simpa only [Q, hrecover, advance_natPrecisions, shift_eq] using
          ih (t + 1) (advance c a) (shift m a z) (seedTail u) (by omega) (by omega) hca hz
      have hp := conditional_property_ae a (natPrecisions c) m
        (natPrecisions_positive c hc a) Q hQ hcond
      filter_upwards [hp] with w hw
      simp only [rawTree, hrepair, trace]
      exact congrArg (List.cons a) hw

theorem actual_trace_joint_measurable (π : StatePolicy) (t H : ℕ) (c : Counts) (m : Means) :
    Measurable (fun p : Seeds H × (Means × RawStream Arm H) =>
      trace (rawTree π t H c m p.1) (observations p.2)) := by
  exact (rawTree_trace_measurable π t H c).comp
    (measurable_const.prodMk (measurable_fst.prodMk
      ((observations_measurable H).comp measurable_snd)))

/-- Actual-risk minimization at one state preserves the entire sampling
trace under null-history repair, a.e. over both seeds and actual observations. -/
theorem minimizing_trace_repair_ae (π : StatePolicy) (T t H : ℕ)
    (c : Counts) (m : Means) (horizon : t + H = T + 1) (ht : 4 ≤ t)
    (hc : ∀ a, 0 < c a) (hπ : MinimizesActualRisk π t H c m) :
    ∀ᵐ p ∂(seedLaw (H + 1)).prod (worldLaw H (natPrecisions c) m),
      trace (rawTree π t H c m p.1) (observations p.2) =
        trace (rawTree (repair π T) t H c m p.1) (observations p.2) := by
  apply (Measure.ae_prod_iff_ae_ae (measurableSet_eq_fun_of_countable
    (actual_trace_joint_measurable π t H c m)
    (actual_trace_joint_measurable (repair π T) t H c m))).mpr
  filter_upwards [minimizing_seed_risk_eq π t H c m hc hπ] with u hu
  exact exact_seed_trace_repair_ae π T t H c m u horizon ht hc hu

theorem deterministicBellman_initialRiskOptimal (T : ℕ) (hT : 3 ≤ T) :
    InitialRiskOptimal (deterministicBellman T) T := by
  intro m
  exact deterministicBellman_minimizes_actual_risk T 4 (T - 3) (fun _ => 1) m
    (by omega) (by intro a; norm_num)

theorem exists_initialRiskOptimal (T : ℕ) (hT : 3 ≤ T) :
    ∃ π : StatePolicy, InitialRiskOptimal π T :=
  ⟨deterministicBellman T, deterministicBellman_initialRiskOptimal T hT⟩

end
end BayesOptimal.InitialOptimal

end

/-! ## LemmaRates -/
section

open Filter Asymptotics

namespace BayesOptimal.PolicyChoice

open BayesOptimal.Foundations.Counts BayesOptimal.Foundations.DynamicPolicy BayesOptimal.Foundations.Rates BayesOptimal.Foundations.ThreeArmComparison
open BayesOptimal.ExclusionPerm BayesOptimal.ExclusionBounds BayesOptimal.ExclusionTail BayesOptimal.Comparison

noncomputable section

theorem lemma6_absolute_upper (T q t : ℕ) (CU : ℝ) (p : MeanPath) (c : Counts)
    (hT : 5 ≤ T) (hCU : 0 < CU) (hcut : 180 < (CU-6)^2/4)
    (hc : horizonConsistent t c) (hW : newW T q CU p c) :
    |EBI (T-t) (modelCounts c) (modelMeans p c) 2| ≤ paperG0 T CU := by
  have hu := lemma6_upper T q t CU p c hT hCU hcut hc hW
  have hl := binary_EBI_lower (T-t) (modelCounts c) (modelMeans p c) 2
    (modelCounts_positive t c hc)
  rw [twoAction_two] at hl
  have he := lemma11_from_equation11 T q t CU p c hT hCU hcut hc hW
  apply abs_le.mpr
  constructor <;> linarith only [hu, hl, he]

/-- Full uniform Omega bounds of Lemmas 7 and 8 under the paper's exact
cutoff condition. The constants and horizon threshold do not depend on the
round, posterior means, counts, or optimal policy. -/
theorem lemmas7_8_uniform (CU : ℝ) (hCU : 0 < CU) (hcut : 180 < (CU-6)^2/4) :
    ∃ T0 : ℕ, ∀ T : ℕ, T0 ≤ T →
      (∀ (q t : ℕ) (p : MeanPath) (c : Counts), T=2*q+1 → 4 ≤ t → t<T →
        horizonConsistent t c → newW T q CU p c →
        ((gainC/2)*invPower 178 T ≤ EBI (T-t) (modelCounts c) (modelMeans p c) 0 ∧
         (gainC/2)*invPower 178 T ≤ EBI (T-t) (modelCounts c) (modelMeans p c) 1) ∧
        (c.n1=q → (comparisonC/2)*invPower 178 T ≤
          BayesOptimal.Foundations.BayesianModel.action (T-t) (modelCounts c) (modelMeans p c) 1 -
          BayesOptimal.Foundations.BayesianModel.action (T-t) (modelCounts c) (modelMeans p c) 0) ∧
        (c.n2=q → (comparisonC/2)*invPower 178 T ≤
          BayesOptimal.Foundations.BayesianModel.action (T-t) (modelCounts c) (modelMeans p c) 0 -
          BayesOptimal.Foundations.BayesianModel.action (T-t) (modelCounts c) (modelMeans p c) 1)) ∧
      (∀ (q : ℕ) (p : MeanPath) (c : Counts), T=2*q+1 →
        horizonConsistent T c → newW T q CU p c →
        (BayesOptimal.Marginal.terminalConstant/2)*invPower 22 T ≤ EBI 0 (modelCounts c) (modelMeans p c) 0 ∧
        (BayesOptimal.Marginal.terminalConstant/2)*invPower 22 T ≤ EBI 0 (modelCounts c) (modelMeans p c) 1) := by
  have herr := BayesOptimal.ExclusionAsymptotics.paperG0_bigO180_equation11 CU hcut
  have hg := eventual_subtraction_lower_bound gainC_pos (by norm_num : (0 : ℝ)<1)
    (by norm_num : 176<180) herr (Filter.Eventually.of_forall (fun _ => le_rfl))
  have hb := eventual_subtraction_lower_bound comparisonC_pos (by norm_num : (0 : ℝ)<1)
    (by norm_num : 178<180) herr (Filter.Eventually.of_forall (fun _ => le_rfl))
  have ht := eventual_subtraction_lower_bound BayesOptimal.Marginal.terminalConstant_pos
    (by norm_num : (0 : ℝ)<1) (by norm_num : 22<180) herr
    (Filter.Eventually.of_forall (fun _ => le_rfl))
  obtain ⟨T0, hT0⟩ := Filter.eventually_atTop.mp
    (hg.and (hb.and (ht.and (eventually_ge_atTop (9 : ℕ)))))
  refine ⟨T0, ?_⟩
  intro T hlarge
  have hmargin := hT0 T hlarge
  have hT9 := hmargin.2.2.2
  have h10 := cutoff_condition_implies_ten CU hCU hcut
  have hweak : (gainC/2)*invPower 178 T ≤ (gainC/2)*invPower 176 T :=
    mul_le_mul_of_nonneg_left (invPower_antitone (by norm_num) (by omega)) (half_pos gainC_pos).le
  simp only [one_mul] at hmargin
  constructor
  · intro q t p c hTodd ht4 hpre hc hW
    have hi := lemma7_individual_lower T q t CU p c hTodd ht4 hpre h10 hc hW
    refine ⟨⟨(hweak.trans hmargin.1).trans hi.1, (hweak.trans hmargin.1).trans hi.2⟩, ?_, ?_⟩
    · intro hsat
      exact hmargin.2.1.trans (lemma7_saturated_left T q t CU p c hTodd ht4 hpre h10 hc hW hsat)
    · intro hsat
      exact hmargin.2.1.trans (lemma7_saturated_right T q t CU p c hTodd ht4 hpre h10 hc hW hsat)
  · intro q p c hTodd hc hW
    have hi := lemma8_individual_lower T q CU p c hTodd hT9 h10 hc hW
    exact ⟨hmargin.2.2.1.trans hi.1, hmargin.2.2.1.trans hi.2⟩

end
end BayesOptimal.PolicyChoice

end

/-! ## MarginalRates -/
section

open MeasureTheory ProbabilityTheory Set Filter Asymptotics
open scoped MeasureTheory NNReal ENNReal

namespace BayesOptimal.Marginal

noncomputable section

open BayesOptimal.Foundations.Gaussian BayesOptimal.Foundations.Rates BayesOptimal.Foundations.TerminalBounds
open BayesOptimal.Comparison.Gaussian

def intervalConstant : ℝ := Real.exp (-8) * (Real.sqrt (4 * Real.pi))⁻¹
def tailConstant : ℝ := (gaussianReal 0 1 (Icc (1 : ℝ) 2)).toReal
def g1Constant : ℝ := intervalConstant * tailConstant / 2
def g2Constant : ℝ := 5 * intervalConstant ^ 2 * tailConstant / 432

theorem intervalConstant_pos : 0 < intervalConstant := by
  unfold intervalConstant
  positivity

theorem tailConstant_pos : 0 < tailConstant :=
  gaussian_Icc_probability_pos 0 1 2 1 (by norm_num) (by norm_num)

theorem g1Constant_pos : 0 < g1Constant := by
  unfold g1Constant
  exact div_pos (mul_pos intervalConstant_pos tailConstant_pos) (by norm_num)

theorem g2Constant_pos : 0 < g2Constant := by
  unfold g2Constant
  exact div_pos (mul_pos (mul_pos (by norm_num) (pow_pos intervalConstant_pos 2))
    tailConstant_pos) (by norm_num)

/-- A uniform positive lower tail probability whenever the threshold is at
most one standard deviation. The constant is an actual standard Gaussian mass. -/
theorem gaussian_tail_lower (a : ℝ) (v : ℝ≥0) (ha : a ≤ Real.sqrt (v : ℝ)) :
    tailConstant ≤ (gaussianReal 0 v (Ici a)).toReal := by
  let s : ℝ := Real.sqrt (v : ℝ)
  have hs : 0 ≤ s := Real.sqrt_nonneg _
  have hmap : (gaussianReal 0 1).map (fun z : ℝ => s * z) = gaussianReal 0 v := by
    have hv : (⟨s ^ 2, sq_nonneg s⟩ : ℝ≥0) * 1 = v := by
      ext
      simp [s]
    rw [gaussianReal_map_const_mul, mul_zero, hv]
  have hsub : Icc (1 : ℝ) 2 ⊆ (fun z : ℝ => s * z) ⁻¹' Ici a := by
    intro z hz
    change a ≤ s * z
    exact ha.trans (by dsimp [s] at hs ⊢; nlinarith only [hs, hz.1])
  unfold tailConstant
  rw [← hmap, Measure.map_apply (by fun_prop) measurableSet_Ici]
  exact ENNReal.toReal_mono (measure_ne_top _ _) (measure_mono hsub)

/-- Small interval density bound uniform down to variance T^-3. -/
theorem gaussianPDF_small_interval_lower (T : ℕ) (x : ℝ) (v : ℝ≥0)
    (hT : 5 ≤ T) (hv : 0 < v) (hvu : (v : ℝ) ≤ 2)
    (hvl : invPower 3 T ≤ (v : ℝ))
    (hx0 : 0 ≤ x) (hxu : x ≤ 4 * invPower 2 T) :
    intervalConstant ≤ gaussianPDFReal 0 v x := by
  have hTr : 1 ≤ (T : ℝ) := by exact_mod_cast (show 1 ≤ T by omega)
  have hTp : 0 < (T : ℝ) := by linarith
  have hp2 : 0 < (T : ℝ) ^ 2 := by positivity
  have hp3 : 0 < (T : ℝ) ^ 3 := by positivity
  have hi2 : 0 ≤ invPower 2 T := invPower_nonneg _ _
  have hpow : (invPower 2 T) ^ 2 ≤ invPower 3 T := by
    unfold invPower
    rw [inv_pow]
    apply (inv_le_inv₀ (by positivity) (by positivity)).mpr
    calc
      (T : ℝ) ^ 3 ≤ (T : ℝ) ^ 4 := pow_le_pow_right₀ hTr (by norm_num)
      _ = ((T : ℝ) ^ 2) ^ 2 := by ring
  have hsq : x ^ 2 ≤ (4 * invPower 2 T) ^ 2 :=
    (sq_le_sq₀ hx0 (by positivity)).mpr hxu
  have hquad : x ^ 2 ≤ 16 * (v : ℝ) := by nlinarith only [hsq, hpow, hvl]
  have hquot : x ^ 2 / (2 * (v : ℝ)) ≤ 8 := by
    apply (div_le_iff₀ (by positivity)).mpr
    linarith only [hquad]
  have hexp : Real.exp (-8) ≤ Real.exp (-x ^ 2 / (2 * (v : ℝ))) := by
    apply Real.exp_le_exp.mpr
    rw [neg_div]
    linarith only [hquot]
  have hnorm : (Real.sqrt (4 * Real.pi))⁻¹ ≤
      (Real.sqrt (2 * Real.pi * (v : ℝ)))⁻¹ := by
    apply (inv_le_inv₀ (by positivity) (by positivity)).mpr
    apply Real.sqrt_le_sqrt
    nlinarith only [hvu, Real.pi_pos]
  unfold intervalConstant
  rw [mul_comm, gaussianPDFReal]
  simp only [sub_zero]
  exact mul_le_mul hnorm hexp (Real.exp_pos _).le (by positivity)

theorem gaussian_small_interval_lower (T : ℕ) (a b : ℝ) (v : ℝ≥0)
    (hT : 5 ≤ T) (hv : 0 < v) (hvu : (v : ℝ) ≤ 2)
    (hvl : invPower 3 T ≤ (v : ℝ))
    (ha : 0 ≤ a) (hab : a ≤ b) (hb : b ≤ 4 * invPower 2 T) :
    intervalConstant * (b - a) ≤ (gaussianReal 0 v (Icc a b)).toReal := by
  have hmass : (gaussianReal 0 v (Icc a b)).toReal =
      ∫ x in Icc a b, gaussianPDFReal 0 v x := by
    rw [gaussianReal_apply_eq_integral 0 (ne_of_gt hv), ENNReal.toReal_ofReal]
    exact integral_nonneg (gaussianPDFReal_nonneg _ _)
  have hmono : (∫ _ in Icc a b, intervalConstant) ≤
      ∫ x in Icc a b, gaussianPDFReal 0 v x := by
    apply setIntegral_mono_on (integrableOn_const isCompact_Icc.measure_ne_top)
      (integrable_gaussianPDFReal 0 v).integrableOn measurableSet_Icc
    intro x hx
    exact gaussianPDF_small_interval_lower T x v hT hv hvu hvl (ha.trans hx.1)
      (hx.2.trans hb)
  have hconst : (∫ _ in Icc a b, intervalConstant) = intervalConstant * (b - a) := by
    rw [setIntegral_const, smul_eq_mul, measureReal_def, Real.volume_Icc,
      ENNReal.toReal_ofReal (sub_nonneg.mpr hab)]
    ring
  rw [← hconst, hmass]
  exact hmono

theorem tiny_gap_le_sqrt (T : ℕ) (gap : ℝ) (v : ℝ≥0) (hT : 5 ≤ T)
    (hgap : |gap| ≤ 2 * invPower 2 T) (hv : invPower 2 T ≤ (v : ℝ)) :
    |gap| ≤ Real.sqrt (v : ℝ) := by
  have hi : 0 ≤ invPower 2 T := invPower_nonneg _ _
  have hi4 : invPower 2 T ≤ 1 / 4 := by
    have hTr : 5 ≤ (T : ℝ) := by exact_mod_cast hT
    unfold invPower
    rw [inv_eq_one_div]
    apply (div_le_iff₀ (by positivity)).mpr
    nlinarith only [hTr]
  apply Real.le_sqrt_of_sq_le
  have hsq := (sq_le_sq₀ (abs_nonneg gap) (by positivity)).mpr hgap
  nlinarith only [hsq, hi, hi4, hv]

theorem g1_uniform4_variance (T : ℕ) (gap : ℝ) (vL vR : ℝ≥0)
    (hT : 5 ≤ T) (hgapL : invPower 2 T ≤ |gap|)
    (hgapU : |gap| ≤ 2 * invPower 2 T)
    (hl : 0 < vL) (hlu : (vL : ℝ) ≤ 2) (hll : invPower 3 T ≤ (vL : ℝ))
    (hrl : invPower 2 T ≤ (vR : ℝ)) :
    g1Constant * invPower 4 T ≤ newG1 gap vL vR := by
  have hi := invPower_nonneg 2 T
  have hmass := gaussian_small_interval_lower T (3 * |gap| / 2) (2 * |gap|) vL
    hT hl hlu hll (by positivity) (by linarith [abs_nonneg gap]) (by linarith)
  have htail := gaussian_tail_lower |gap| vR (tiny_gap_le_sqrt T gap vR hT hgapU hrl)
  have hp : 0 ≤ (gaussianReal 0 vL (Icc (3 * |gap| / 2) (2 * |gap|))).toReal := by positivity
  have hq : 0 ≤ (gaussianReal 0 vR (Ici |gap|)).toReal := by positivity
  have hmass' : (intervalConstant / 2) * invPower 2 T ≤
      (gaussianReal 0 vL (Icc (3 * |gap| / 2) (2 * |gap|))).toReal := by
    have hmul := mul_le_mul_of_nonneg_left hgapL intervalConstant_pos.le
    nlinarith only [hmass, hmul]
  have hb := mul_le_mul hmass' htail tailConstant_pos.le hp
  have hb' := mul_le_mul hb hgapL hi (mul_nonneg hp hq)
  unfold newG1 g1Constant
  rw [← invPower_product 2 2 T]
  nlinarith only [hb']

theorem g2_uniform6_variance (T : ℕ) (gap : ℝ) (vL vG vR : ℝ≥0)
    (hT : 5 ≤ T) (hgapL : invPower 2 T ≤ |gap|)
    (hgapU : |gap| ≤ 2 * invPower 2 T)
    (hl : 0 < vL) (hlu : (vL : ℝ) ≤ 2) (hll : invPower 3 T ≤ (vL : ℝ))
    (hg : 0 < vG) (hgu : (vG : ℝ) ≤ 2) (hgl : invPower 3 T ≤ (vG : ℝ))
    (hrl : invPower 2 T ≤ (vR : ℝ)) :
    g2Constant * invPower 6 T ≤ newG2 gap vL vG vR := by
  have hi := invPower_nonneg 2 T
  have hlmass := gaussian_small_interval_lower T (|gap| / 4) (|gap| / 3) vL
    hT hl hlu hll (by positivity) (by linarith [abs_nonneg gap]) (by linarith)
  have hgmass := gaussian_small_interval_lower T (9 * |gap| / 8) (4 * |gap| / 3) vG
    hT hg hgu hgl (by positivity) (by linarith [abs_nonneg gap]) (by linarith)
  have htail := gaussian_tail_lower (3 * |gap| / 4) vR
    (by linarith [tiny_gap_le_sqrt T gap vR hT hgapU hrl, abs_nonneg gap])
  have hlmass' : (intervalConstant / 12) * invPower 2 T ≤
      (gaussianReal 0 vL (Icc (|gap| / 4) (|gap| / 3))).toReal := by
    have hmul := mul_le_mul_of_nonneg_left hgapL intervalConstant_pos.le
    nlinarith only [hlmass, hmul]
  have hgmass' : (5 * intervalConstant / 24) * invPower 2 T ≤
      (gaussianReal 0 vG (Icc (9 * |gap| / 8) (4 * |gap| / 3))).toReal := by
    have hmul := mul_le_mul_of_nonneg_left hgapL intervalConstant_pos.le
    nlinarith only [hgmass, hmul]
  have hp : 0 ≤ (gaussianReal 0 vL (Icc (|gap| / 4) (|gap| / 3))).toReal := by positivity
  have hq : 0 ≤ (gaussianReal 0 vG (Icc (9 * |gap| / 8) (4 * |gap| / 3))).toReal := by positivity
  have hr : 0 ≤ (gaussianReal 0 vR (Ici (3 * |gap| / 4))).toReal := by positivity
  have hcpos := intervalConstant_pos
  have hb := mul_le_mul hlmass' hgmass' (by positivity) hp
  have hb' := mul_le_mul hb htail tailConstant_pos.le (mul_nonneg hp hq)
  have hfactor : (2 / 3) * invPower 2 T ≤ 2 * |gap| / 3 := by linarith only [hgapL]
  have hb'' := mul_le_mul hb' hfactor (by positivity) (mul_nonneg (mul_nonneg hp hq) hr)
  unfold newG2 g2Constant
  rw [← invPower_product 4 2 T, ← invPower_product 2 2 T]
  nlinarith only [hb'']

end

end BayesOptimal.Marginal

end

/-! ## MarginalCounts -/
section

open MeasureTheory ProbabilityTheory Set Filter Asymptotics
open scoped MeasureTheory NNReal ENNReal

namespace BayesOptimal.Marginal

noncomputable section

open BayesOptimal.Foundations.Gaussian BayesOptimal.Foundations.Rates BayesOptimal.Foundations.TerminalBounds
open BayesOptimal.Comparison.Gaussian

def g1Count (gap : ℝ) (ni nj : ℕ) : ℝ :=
  newG1 gap (updateVariance (ni : ℝ≥0)) (posteriorVariance ((ni : ℝ≥0) + 1) nj)

def g2Count (gap : ℝ) (ni nj : ℕ) : ℝ :=
  newG2 gap (updateVariance (ni : ℝ≥0))
    (updateVariance (nj : ℝ≥0) - updateVariance (ni : ℝ≥0))
    (posteriorVariance ni ((nj : ℝ≥0) + 1))

theorem posteriorVariance_count_bounds (ni nj T : ℕ) (hT : 1 ≤ T)
    (hi : 1 ≤ ni) (hj : 1 ≤ nj) (hiT : ni ≤ T) (_hjT : nj ≤ T) :
    invPower 2 T ≤ (posteriorVariance (ni : ℝ≥0) nj : ℝ) ∧
      (posteriorVariance (ni : ℝ≥0) nj : ℝ) ≤ 2 := by
  have hir : 1 ≤ (ni : ℝ) := by exact_mod_cast hi
  have hjr : 1 ≤ (nj : ℝ) := by exact_mod_cast hj
  have hTr : 1 ≤ (T : ℝ) := by exact_mod_cast hT
  have hiTr : (ni : ℝ) ≤ T := by exact_mod_cast hiT
  have hilu : (ni : ℝ)⁻¹ ≤ 1 := inv_le_one_of_one_le₀ hir
  have hjlu : (nj : ℝ)⁻¹ ≤ 1 := inv_le_one_of_one_le₀ hjr
  have hlow : invPower 2 T ≤ (ni : ℝ)⁻¹ := by
    unfold invPower
    apply (inv_le_inv₀ (by positivity) (by linarith only [hir])).mpr
    nlinarith only [hiTr, hTr]
  simp only [posteriorVariance, NNReal.coe_add, NNReal.coe_inv, NNReal.coe_natCast]
  constructor
  · exact hlow.trans (le_add_of_nonneg_right (by positivity))
  · linarith only [hilu, hjlu]

theorem updateVariance_positive_nat (n : ℕ) (hn : 1 ≤ n) :
    0 < updateVariance (n : ℝ≥0) := by
  have hp : 0 < (n : ℝ≥0) := by exact_mod_cast (show 0 < n by omega)
  unfold updateVariance
  positivity

theorem lemma15_g1_count_lower (gap : ℝ) (ni nj : ℕ) :
    g1Count gap ni nj ≤ oneStepImprovement gap (updateVariance (ni : ℝ≥0))
      (posteriorVariance ((ni : ℝ≥0) + 1) nj) :=
  lemma15_g1_lower gap _ _

/-- Revised Lemma 15's named g1, with the stronger T^-4 rate before weakening. -/
theorem lemma15_g1_uniform4 (T ni nj : ℕ) (gap : ℝ)
    (hT : 5 ≤ T) (hi : 1 ≤ ni) (hj : 1 ≤ nj) (hiT : ni < T) (hjT : nj < T)
    (hgapL : invPower 2 T ≤ |gap|) (hgapU : |gap| ≤ 2 * invPower 2 T) :
    g1Constant * invPower 4 T ≤ g1Count gap ni nj := by
  have hv := updateVariance_count_bounds ni T hi hiT
  have hr := posteriorVariance_count_bounds (ni + 1) nj T (by omega) (by omega) hj
    (by omega) (by omega)
  unfold g1Count
  apply g1_uniform4_variance T gap _ _ hT hgapL hgapU (updateVariance_positive_nat ni hi)
    (by linarith only [hv.2])
  · exact (invPower_antitone (by norm_num : 2 ≤ 3) (by omega : 1 ≤ T)).trans hv.1
  · simpa only [Nat.cast_add, Nat.cast_one] using hr.1

/-- Revised Lemma 15's exact uniform Omega(T^-6) lower bound. -/
theorem lemma15_g1_uniform6 (T ni nj : ℕ) (gap : ℝ)
    (hT : 5 ≤ T) (hi : 1 ≤ ni) (hj : 1 ≤ nj) (hiT : ni < T) (hjT : nj < T)
    (hgapL : invPower 2 T ≤ |gap|) (hgapU : |gap| ≤ 2 * invPower 2 T) :
    g1Constant * invPower 6 T ≤ g1Count gap ni nj := by
  exact (mul_le_mul_of_nonneg_left
    (invPower_antitone (by norm_num : 4 ≤ 6) (by omega : 1 ≤ T)) g1Constant_pos.le).trans
    (lemma15_g1_uniform4 T ni nj gap hT hi hj hiT hjT hgapL hgapU)

theorem varianceDifference_count_bounds (T ni nj : ℕ)
    (hj : 1 ≤ nj) (hstrict : nj < ni) (hiT : ni < T) :
    0 < updateVariance (nj : ℝ≥0) - updateVariance (ni : ℝ≥0) ∧
      ((updateVariance (nj : ℝ≥0) - updateVariance (ni : ℝ≥0) : ℝ≥0) : ℝ) ≤ 2 ∧
      invPower 3 T ≤ ((updateVariance (nj : ℝ≥0) - updateVariance (ni : ℝ≥0) : ℝ≥0) : ℝ) := by
  have hjp : 0 < (nj : ℝ≥0) := by exact_mod_cast (show 0 < nj by omega)
  have hji : (nj : ℝ≥0) < ni := by exact_mod_cast hstrict
  have hv := updateVariance_strictAntitone (nj : ℝ≥0) ni hjp hji
  have hjb := updateVariance_count_bounds nj T hj (by omega)
  have hl := updateVariance_difference_lower ni nj T hj hstrict hiT
  constructor
  · exact tsub_pos_iff_lt.mpr hv
  rw [NNReal.coe_sub hv.le]
  constructor
  · have hip : 0 ≤ (updateVariance (ni : ℝ≥0) : ℝ) := (updateVariance _).property
    linarith only [hjb.2, hip]
  · exact hl

/-- The exact revised g2 bound on the actual terminal action-loss difference. -/
theorem lemma16_g2_count_lower (gap : ℝ) (ni nj : ℕ)
    (hj : 1 ≤ nj) (hstrict : nj < ni) :
    g2Count gap ni nj ≤
      expectedLossAfterDraw gap (updateVariance (ni : ℝ≥0))
        (posteriorVariance ((ni : ℝ≥0) + 1) nj) -
      expectedLossAfterDraw gap (updateVariance (nj : ℝ≥0))
        (posteriorVariance ((nj : ℝ≥0) + 1) ni) := by
  have hip : 0 < (ni : ℝ≥0) := by exact_mod_cast (show 0 < ni by omega)
  have hjp : 0 < (nj : ℝ≥0) := by exact_mod_cast (show 0 < nj by omega)
  have hji : (nj : ℝ≥0) < ni := by exact_mod_cast hstrict
  have hv := updateVariance_strictAntitone (nj : ℝ≥0) ni hjp hji
  rw [terminal_actionLoss_difference_eq gap _ _ hjp hip]
  unfold g2Count
  simpa only [add_tsub_cancel_of_le hv.le] using
    lemma16_g2_lower gap (updateVariance (ni : ℝ≥0))
      (updateVariance (nj : ℝ≥0) - updateVariance (ni : ℝ≥0))
      (posteriorVariance ni ((nj : ℝ≥0) + 1))

theorem lemma16_g2_uniform6 (T ni nj : ℕ) (gap : ℝ)
    (hT : 5 ≤ T) (hj : 1 ≤ nj) (hstrict : nj < ni) (hiT : ni < T)
    (hgapL : invPower 2 T ≤ |gap|) (hgapU : |gap| ≤ 2 * invPower 2 T) :
    g2Constant * invPower 6 T ≤ g2Count gap ni nj := by
  have hi : 1 ≤ ni := by omega
  have hv := updateVariance_count_bounds ni T hi hiT
  have hg := varianceDifference_count_bounds T ni nj hj hstrict hiT
  have hr := posteriorVariance_count_bounds ni (nj + 1) T (by omega) hi (by omega)
    (by omega) (by omega)
  unfold g2Count
  apply g2_uniform6_variance T gap _ _ _ hT hgapL hgapU (updateVariance_positive_nat ni hi)
    (by linarith only [hv.2])
  · exact (invPower_antitone (by norm_num : 2 ≤ 3) (by omega : 1 ≤ T)).trans hv.1
  · exact hg.1
  · exact hg.2.1
  · exact hg.2.2
  · simpa only [Nat.cast_add, Nat.cast_one] using hr.1

/-- Revised Lemma 16's exact uniform Omega(T^-8) lower bound on its named g2. -/
theorem lemma16_g2_uniform8 (T ni nj : ℕ) (gap : ℝ)
    (hT : 5 ≤ T) (hj : 1 ≤ nj) (hstrict : nj < ni) (hiT : ni < T)
    (hgapL : invPower 2 T ≤ |gap|) (hgapU : |gap| ≤ 2 * invPower 2 T) :
    g2Constant * invPower 8 T ≤ g2Count gap ni nj := by
  exact (mul_le_mul_of_nonneg_left
    (invPower_antitone (by norm_num : 6 ≤ 8) (by omega : 1 ≤ T)) g2Constant_pos.le).trans
    (lemma16_g2_uniform6 T ni nj gap hT hj hstrict hiT hgapL hgapU)

end

end BayesOptimal.Marginal

