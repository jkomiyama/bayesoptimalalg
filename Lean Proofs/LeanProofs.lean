/-!
# Corrected count and final-round statements

These declarations formalize corrected Appendix B arithmetic, the count and
variance arithmetic of Lemma 15, and the actual balanced sampling schedule in
Equation (22). They do not assume or claim the Bellman optimality statement of
Lemma 16 or the nonterminal Gaussian lower bound of Lemma 17.
-/

namespace BayesOptimal.Foundations.Counts

set_option linter.dupNamespace false

open MeasureTheory
open scoped Classical

theorem appendixB_exact_inverse (q : ℕ) (hq : 0 < q) :
    (q : ℝ)⁻¹ = 2 / (((2 * q + 1 : ℕ) : ℝ) - 1) := by
  have hqr : (q : ℝ) ≠ 0 := by exact_mod_cast Nat.ne_of_gt hq
  push_cast
  field_simp
  ring

theorem appendixB_replacement_bound (q : ℕ) (hq : 0 < q) :
    (q : ℝ)⁻¹ ≤ 3 / ((2 * q + 1 : ℕ) : ℝ) := by
  have hqr : 1 ≤ (q : ℝ) := by exact_mod_cast hq
  have hp : 0 < (q : ℝ) := by positivity
  have ht : 0 < ((2 * q + 1 : ℕ) : ℝ) := by positivity
  rw [inv_eq_one_div]
  apply (div_le_div_iff₀ hp ht).mpr
  push_cast
  linarith

/-- The index with the larger count is the argmax, as used by the proof of
Lemma 15. The action-loss inequality is a separate stochastic claim. -/
def IsTwoArmArgmax (ni nj : ℕ) : Prop := nj ≤ ni

theorem lemma15_corrected_argmax (ni nj : ℕ) (hstrict : nj < ni) :
    IsTwoArmArgmax ni nj := by
  exact Nat.le_of_lt hstrict

theorem lemma15_corrected_footnote (q ni nj : ℕ)
    (hq : 0 < q) (hsum : ni + nj = 2 * q - 1) (hstrict : nj < ni) :
    q ≤ ni ∧ nj ≤ q - 1 := by
  omega

noncomputable def varianceDecrement (n : ℕ) : ℝ :=
  1 / ((n : ℝ) * ((n : ℝ) + 1))

theorem varianceDecrement_identity (n : ℕ) (hn : 0 < n) :
    1 / (n : ℝ) - 1 / ((n : ℝ) + 1) = varianceDecrement n := by
  have hn0 : (n : ℝ) ≠ 0 := by exact_mod_cast Nat.ne_of_gt hn
  have hn1 : (n : ℝ) + 1 ≠ 0 := by positivity
  unfold varianceDecrement
  field_simp
  ring

theorem varianceDecrement_positive (n : ℕ) (hn : 0 < n) :
    0 < varianceDecrement n := by
  unfold varianceDecrement
  positivity

theorem varianceDecrement_strict_antitone (ni nj : ℕ)
    (hj : 0 < nj) (hstrict : nj < ni) :
    varianceDecrement ni < varianceDecrement nj := by
  have hjr : 0 < (nj : ℝ) := by exact_mod_cast hj
  have hir : (nj : ℝ) < (ni : ℝ) := by exact_mod_cast hstrict
  have hirpos : 0 < (ni : ℝ) := by linarith
  unfold varianceDecrement
  apply (div_lt_div_iff₀ (by positivity) (by positivity)).mpr
  nlinarith

/-- Sampling the smaller-count arm leaves a strictly smaller sum of posterior
variances. This is a variance comparison, not an action-loss comparison. -/
theorem lemma15_sample_smaller_variance (ni nj : ℕ)
    (hj : 0 < nj) (hstrict : nj < ni) :
    1 / (ni : ℝ) + 1 / ((nj : ℝ) + 1) <
      1 / ((ni : ℝ) + 1) + 1 / (nj : ℝ) := by
  have hi : 0 < ni := by omega
  have hmono := varianceDecrement_strict_antitone ni nj hj hstrict
  rw [← varianceDecrement_identity ni hi,
    ← varianceDecrement_identity nj hj] at hmono
  linarith

structure Counts where
  n1 : ℕ
  n2 : ℕ
  n3 : ℕ
deriving DecidableEq, Repr

def balancedStep (c : Counts) : Counts :=
  if c.n1 ≤ c.n2 then ⟨c.n1 + 1, c.n2, c.n3⟩
  else ⟨c.n1, c.n2 + 1, c.n3⟩

def balancedRun : ℕ → Counts → Counts
  | 0, c => c
  | k + 1, c => balancedRun k (balancedStep c)

theorem balancedStep_sum (c : Counts) :
    (balancedStep c).n1 + (balancedStep c).n2 = c.n1 + c.n2 + 1 := by
  unfold balancedStep
  split_ifs <;> simp only <;> omega

theorem balancedStep_n3 (c : Counts) : (balancedStep c).n3 = c.n3 := by
  unfold balancedStep
  split_ifs <;> rfl

theorem balancedRun_sum (k : ℕ) (c : Counts) :
    (balancedRun k c).n1 + (balancedRun k c).n2 = c.n1 + c.n2 + k := by
  induction k generalizing c with
  | zero => simp [balancedRun]
  | succ k ih =>
      rw [balancedRun, ih, balancedStep_sum]
      omega

theorem balancedRun_n3 (k : ℕ) (c : Counts) :
    (balancedRun k c).n3 = c.n3 := by
  induction k generalizing c with
  | zero => rfl
  | succ k ih => rw [balancedRun, ih, balancedStep_n3]

theorem balancedStep_monotone (c : Counts) :
    c.n1 ≤ (balancedStep c).n1 ∧ c.n2 ≤ (balancedStep c).n2 := by
  unfold balancedStep
  split_ifs <;> simp only <;> omega

theorem balancedRun_monotone (k : ℕ) (c : Counts) :
    c.n1 ≤ (balancedRun k c).n1 ∧ c.n2 ≤ (balancedRun k c).n2 := by
  induction k generalizing c with
  | zero => exact ⟨le_rfl, le_rfl⟩
  | succ k ih =>
      have hstep := balancedStep_monotone c
      have hrun := ih (balancedStep c)
      exact ⟨hstep.1.trans hrun.1, hstep.2.trans hrun.2⟩

noncomputable def transitionVariance (k : ℕ) (c : Counts) : ℝ :=
  (1 / (c.n1 : ℝ) - 1 / ((balancedRun k c).n1 : ℝ)) +
    (1 / (c.n2 : ℝ) - 1 / ((balancedRun k c).n2 : ℝ))

theorem inverse_difference_nonnegative (a b : ℕ) (ha : 0 < a) (hab : a ≤ b) :
    0 ≤ 1 / (a : ℝ) - 1 / (b : ℝ) := by
  have har : 0 < (a : ℝ) := by exact_mod_cast ha
  have hb : 0 < b := by omega
  have hbr : 0 < (b : ℝ) := by exact_mod_cast hb
  have hle : 1 / (b : ℝ) ≤ 1 / (a : ℝ) := by
    apply (div_le_div_iff₀ hbr har).mpr
    norm_num
    exact_mod_cast hab
  linarith

theorem inverse_difference_positive (a b : ℕ) (ha : 0 < a) (hab : a < b) :
    0 < 1 / (a : ℝ) - 1 / (b : ℝ) := by
  have har : 0 < (a : ℝ) := by exact_mod_cast ha
  have hb : 0 < b := by omega
  have hbr : 0 < (b : ℝ) := by exact_mod_cast hb
  have hlt : 1 / (b : ℝ) < 1 / (a : ℝ) := by
    apply (div_lt_div_iff₀ hbr har).mpr
    norm_num
    exact_mod_cast hab
  linarith

theorem inverse_difference_lower_bound (a b T : ℕ)
    (ha : 0 < a) (hab : a < b) (hbt : b ≤ T) :
    1 / (T : ℝ) ^ 2 ≤ 1 / (a : ℝ) - 1 / (b : ℝ) := by
  have har : 0 < (a : ℝ) := by exact_mod_cast ha
  have hbr : 0 < (b : ℝ) := by exact_mod_cast (show 0 < b by omega)
  have htr : 0 < (T : ℝ) := by exact_mod_cast (show 0 < T by omega)
  have habr : 1 ≤ (b : ℝ) - (a : ℝ) := by
    have hnat : a + 1 ≤ b := by omega
    have hcast : (a : ℝ) + 1 ≤ (b : ℝ) := by exact_mod_cast hnat
    linarith
  have hatr : (a : ℝ) ≤ (T : ℝ) := by exact_mod_cast (show a ≤ T by omega)
  have hbtr : (b : ℝ) ≤ (T : ℝ) := by exact_mod_cast hbt
  have hprod : (a : ℝ) * (b : ℝ) ≤ (T : ℝ) ^ 2 := by
    calc
      (a : ℝ) * (b : ℝ) ≤ (T : ℝ) * (T : ℝ) :=
        mul_le_mul hatr hbtr (le_of_lt hbr) (le_of_lt htr)
      _ = (T : ℝ) ^ 2 := by ring
  have hdelta : (T : ℝ) ^ 2 ≤ ((b : ℝ) - (a : ℝ)) * (T : ℝ) ^ 2 := by
    simpa using mul_le_mul_of_nonneg_right habr (sq_nonneg (T : ℝ))
  have hidentity : 1 / (a : ℝ) - 1 / (b : ℝ) =
      ((b : ℝ) - (a : ℝ)) / ((a : ℝ) * (b : ℝ)) := by
    field_simp
  rw [hidentity]
  apply (div_le_div_iff₀ (by positivity) (by positivity)).mpr
  linarith

theorem transitionVariance_nonnegative (k : ℕ) (c : Counts)
    (h1 : 0 < c.n1) (h2 : 0 < c.n2) : 0 ≤ transitionVariance k c := by
  have hmono := balancedRun_monotone k c
  exact add_nonneg (inverse_difference_nonnegative c.n1 _ h1 hmono.1)
    (inverse_difference_nonnegative c.n2 _ h2 hmono.2)

theorem transitionVariance_positive (k : ℕ) (c : Counts)
    (hk : 0 < k) (h1 : 0 < c.n1) (h2 : 0 < c.n2) :
    0 < transitionVariance k c := by
  have hmono := balancedRun_monotone k c
  have hsum := balancedRun_sum k c
  have hpos : c.n1 < (balancedRun k c).n1 ∨ c.n2 < (balancedRun k c).n2 := by
    omega
  unfold transitionVariance
  rcases hpos with hn1 | hn2
  · exact add_pos_of_pos_of_nonneg
      (inverse_difference_positive c.n1 _ h1 hn1)
      (inverse_difference_nonnegative c.n2 _ h2 hmono.2)
  · exact add_pos_of_nonneg_of_pos
      (inverse_difference_nonnegative c.n1 _ h1 hmono.1)
      (inverse_difference_positive c.n2 _ h2 hn2)

theorem transitionVariance_terminal (c : Counts) : transitionVariance 0 c = 0 := by
  simp [transitionVariance, balancedRun]

theorem transitionVariance_ge_inverse_square_of_caps (k T : ℕ) (c : Counts)
    (hk : 0 < k) (h1 : 0 < c.n1) (h2 : 0 < c.n2)
    (hb1 : (balancedRun k c).n1 ≤ T) (hb2 : (balancedRun k c).n2 ≤ T) :
    1 / (T : ℝ) ^ 2 ≤ transitionVariance k c := by
  have hmono := balancedRun_monotone k c
  have hsum := balancedRun_sum k c
  have hpos : c.n1 < (balancedRun k c).n1 ∨ c.n2 < (balancedRun k c).n2 := by
    omega
  unfold transitionVariance
  rcases hpos with hn1 | hn2
  · have hbound := inverse_difference_lower_bound c.n1 _ T h1 hn1 hb1
    have hnonneg := inverse_difference_nonnegative c.n2 _ h2 hmono.2
    linarith
  · have hbound := inverse_difference_lower_bound c.n2 _ T h2 hn2 hb2
    have hnonneg := inverse_difference_nonnegative c.n1 _ h1 hmono.1
    linarith

/-- While fewer than 2q-1 samples have been taken from arms 1 and 2,
the greedy step preserves both caps and cannot newly make arm 2 reach q. -/
theorem balancedStep_preterminal_invariant (q : ℕ) (c : Counts)
    (hq : 0 < q) (h1 : c.n1 ≤ q) (h2 : c.n2 ≤ q)
    (hsum : c.n1 + c.n2 < 2 * q - 1) :
    (balancedStep c).n1 ≤ q ∧ (balancedStep c).n2 ≤ q ∧
      ((balancedStep c).n2 = q ↔ c.n2 = q) := by
  unfold balancedStep
  split_ifs with h
  · change c.n1 + 1 ≤ q ∧ c.n2 ≤ q ∧ (c.n2 = q ↔ c.n2 = q)
    exact ⟨by omega, h2, Iff.rfl⟩
  · change c.n1 ≤ q ∧ c.n2 + 1 ≤ q ∧ (c.n2 + 1 = q ↔ c.n2 = q)
    have hsmaller : c.n2 + 1 < q := by omega
    exact ⟨h1, by omega, by constructor <;> intro <;> omega⟩

theorem balancedRun_preterminal_invariant (q k : ℕ) (c : Counts)
    (hq : 0 < q) (h1 : c.n1 ≤ q) (h2 : c.n2 ≤ q)
    (hsum : c.n1 + c.n2 + k ≤ 2 * q - 1) :
    (balancedRun k c).n1 ≤ q ∧ (balancedRun k c).n2 ≤ q ∧
      ((balancedRun k c).n2 = q ↔ c.n2 = q) := by
  induction k generalizing c with
  | zero => exact ⟨h1, h2, Iff.rfl⟩
  | succ k ih =>
      have hbefore : c.n1 + c.n2 < 2 * q - 1 := by omega
      have hstep := balancedStep_preterminal_invariant q c hq h1 h2 hbefore
      have hnext : (balancedStep c).n1 + (balancedStep c).n2 + k ≤
          2 * q - 1 := by rw [balancedStep_sum]; omega
      have hrun := ih (balancedStep c) hstep.1 hstep.2.1 hnext
      exact ⟨hrun.1, hrun.2.1, hrun.2.2.trans hstep.2.2⟩

theorem balancedStep_preserves_caps (q : ℕ) (c : Counts)
    (h1 : c.n1 ≤ q) (h2 : c.n2 ≤ q) (hsum : c.n1 + c.n2 < 2 * q) :
    (balancedStep c).n1 ≤ q ∧ (balancedStep c).n2 ≤ q := by
  unfold balancedStep
  split_ifs <;> simp only <;> constructor <;> omega

theorem balancedRun_preserves_caps (q k : ℕ) (c : Counts)
    (h1 : c.n1 ≤ q) (h2 : c.n2 ≤ q) (hsum : c.n1 + c.n2 + k ≤ 2 * q) :
    (balancedRun k c).n1 ≤ q ∧ (balancedRun k c).n2 ≤ q := by
  induction k generalizing c with
  | zero => exact ⟨h1, h2⟩
  | succ k ih =>
      have hstep := balancedStep_preserves_caps q c h1 h2 (by omega)
      have hnext : (balancedStep c).n1 + (balancedStep c).n2 + k ≤ 2 * q := by
        rw [balancedStep_sum]
        omega
      exact ih (balancedStep c) hstep.1 hstep.2 hnext

theorem balancedRun_final_counts (q k : ℕ) (c : Counts)
    (h1 : c.n1 ≤ q) (h2 : c.n2 ≤ q) (hsum : c.n1 + c.n2 + k = 2 * q) :
    (balancedRun k c).n1 = q ∧ (balancedRun k c).n2 = q := by
  have hcaps := balancedRun_preserves_caps q k c h1 h2 hsum.le
  have htotal := balancedRun_sum k c
  constructor <;> omega

/-- Corrected Equation (22): the exceptional orientation is forced when arm 2
already has q samples. The theorem covers every permitted initial state. -/
theorem equation22_terminal_counts (q k : ℕ) (c : Counts)
    (hq : 0 < q) (h1 : c.n1 ≤ q) (h2 : c.n2 ≤ q)
    (hsum : c.n1 + c.n2 + k = 2 * q - 1) :
    (balancedRun k c).n1 = (if c.n2 = q then q - 1 else q) ∧
    (balancedRun k c).n2 = (if c.n2 = q then q else q - 1) := by
  have hcaps := balancedRun_preterminal_invariant q k c hq h1 h2 hsum.le
  have htotal := balancedRun_sum k c
  rw [hsum] at htotal
  by_cases h2q : c.n2 = q
  · rw [if_pos h2q, if_pos h2q]
    have ht2 := hcaps.2.2.mpr h2q
    constructor <;> omega
  · rw [if_neg h2q, if_neg h2q]
    have ht2 : (balancedRun k c).n2 ≠ q := by
      exact fun h => h2q (hcaps.2.2.mp h)
    constructor <;> omega

def horizonConsistent (t : ℕ) (c : Counts) : Prop :=
  1 ≤ c.n1 ∧ 1 ≤ c.n2 ∧ c.n3 = 1 ∧ c.n1 + c.n2 + c.n3 = t - 1

/-- The paper's round convention starts round t with t-1 total samples and
uses T-t samples before the terminal decision round T. -/
theorem equation22_horizon_counts (q t : ℕ) (c : Counts)
    (hq : 0 < q) (ht : 4 ≤ t) (horizon : t ≤ 2 * q + 1)
    (hc : horizonConsistent t c) (h1 : c.n1 ≤ q) (h2 : c.n2 ≤ q) :
    (balancedRun (2 * q + 1 - t) c).n1 = (if c.n2 = q then q - 1 else q) ∧
    (balancedRun (2 * q + 1 - t) c).n2 = (if c.n2 = q then q else q - 1) := by
  apply equation22_terminal_counts q (2 * q + 1 - t) c hq h1 h2
  rcases hc with ⟨_, _, h3, htotal⟩
  omega

theorem equation22_corrected_increments (q t : ℕ) (c : Counts)
    (hq : 0 < q) (ht : 4 ≤ t) (horizon : t ≤ 2 * q + 1)
    (hc : horizonConsistent t c) (h1 : c.n1 ≤ q) (h2 : c.n2 ≤ q) :
    (balancedRun (2 * q + 1 - t) c).n1 - c.n1 =
      (if c.n2 = q then q - 1 else q) - c.n1 ∧
    (balancedRun (2 * q + 1 - t) c).n2 - c.n2 =
      (if c.n2 = q then q else q - 1) - c.n2 := by
  have heq := equation22_horizon_counts q t c hq ht horizon hc h1 h2
  rw [heq.1, heq.2]
  exact ⟨rfl, rfl⟩

theorem equation22_generic_horizon (T q t : ℕ) (c : Counts)
    (hT : T = 2 * q + 1) (hq : 0 < q) (ht : 4 ≤ t) (horizon : t ≤ T)
    (hc : horizonConsistent t c) (h1 : c.n1 ≤ q) (h2 : c.n2 ≤ q) :
    (balancedRun (T - t) c).n1 = (if c.n2 = q then q - 1 else q) ∧
    (balancedRun (T - t) c).n2 = (if c.n2 = q then q else q - 1) := by
  subst T
  exact equation22_horizon_counts q t c hq ht horizon hc h1 h2

/-- Including the sample in round T yields equal final counts. -/
theorem balanced_final_horizon_counts (T q t : ℕ) (c : Counts)
    (hT : T = 2 * q + 1) (ht : 4 ≤ t) (horizon : t ≤ T)
    (hc : horizonConsistent t c) (h1 : c.n1 ≤ q) (h2 : c.n2 ≤ q) :
    (balancedRun (T - t + 1) c).n1 = q ∧
    (balancedRun (T - t + 1) c).n2 = q := by
  apply balancedRun_final_counts q (T - t + 1) c h1 h2
  rcases hc with ⟨_, _, h3, htotal⟩
  omega

/-- Corrected Equation (23) has nondegenerate variance only at t<T. This
quantitative bound is obtained from the actual schedule, rather than postulated. -/
theorem lemma17_nonterminal_variance_bound (T q t : ℕ) (c : Counts)
    (hT : T = 2 * q + 1) (hq : 0 < q) (ht : 4 ≤ t) (hpre : t < T)
    (hc : horizonConsistent t c) (h1 : c.n1 ≤ q) (h2 : c.n2 ≤ q) :
    1 / (T : ℝ) ^ 2 ≤ transitionVariance (T - t) c := by
  have hcounts := equation22_generic_horizon T q t c hT hq ht hpre.le hc h1 h2
  have hb1 : (balancedRun (T - t) c).n1 ≤ T := by
    rw [hcounts.1]
    split_ifs <;> omega
  have hb2 : (balancedRun (T - t) c).n2 ≤ T := by
    rw [hcounts.2]
    split_ifs <;> omega
  exact transitionVariance_ge_inverse_square_of_caps (T - t) T c
    (by omega) (Nat.lt_of_lt_of_le (by decide) hc.1)
    (Nat.lt_of_lt_of_le (by decide) hc.2.1) hb1 hb2

theorem lemma17_terminal_variance (T : ℕ) (c : Counts) :
    transitionVariance (T - T) c = 0 := by
  simp [transitionVariance, balancedRun]

abbrev MeanPath := ℕ → ℕ → ℝ

def terminalGap (p : MeanPath) (c : Counts) : ℝ := p 1 c.n1 - p 2 c.n2

def gapBand (T : ℕ) (gap : ℝ) : Prop :=
  1 / (T : ℝ) ^ 2 ≤ gap ∧ gap ≤ 2 / (T : ℝ) ^ 2

/-- At t=T the statistic at T-1 is already determined: its probability is
the indicator of membership in the interval, for every probability measure. -/
theorem lemma17_terminal_probability_indicator {Ω : Type*}
    [MeasurableSpace Ω] (μ : Measure Ω) [IsProbabilityMeasure μ]
    (T : ℕ) (p : MeanPath) (c : Counts) :
    (μ {_ω : Ω | gapBand T (terminalGap p (balancedRun (T - T) c))}).toReal =
      if gapBand T (terminalGap p c) then 1 else 0 := by
  classical
  by_cases h : gapBand T (terminalGap p c)
  · simp [balancedRun, h]
  · simp [balancedRun, h]

theorem lemma17_terminal_band_zero (T : ℕ) (hT : 0 < T) :
    ¬ gapBand T 0 := by
  have hp : 0 < 1 / (T : ℝ) ^ 2 := by positivity
  exact fun h => not_le_of_gt hp h.1

theorem lemma17_terminal_zero_gap_probability {Ω : Type*}
    [MeasurableSpace Ω] (μ : Measure Ω) [IsProbabilityMeasure μ]
    (T : ℕ) (hT : 0 < T) (p : MeanPath) (c : Counts)
    (hgap : terminalGap p c = 0) :
    (μ {_ω : Ω | gapBand T (terminalGap p (balancedRun (T - T) c))}).toReal = 0 := by
  rw [lemma17_terminal_probability_indicator, hgap,
    if_neg (lemma17_terminal_band_zero T hT)]

theorem lemma17_nonterminal_has_remaining_sample (T t : ℕ) (h : t < T) :
    0 < T - t := by omega

theorem lemma17_terminal_has_no_remaining_sample (T : ℕ) : T - T = 0 := by omega

end BayesOptimal.Foundations.Counts

end

/-! ## Foundations.Drift -/
section

namespace BayesOptimal.Foundations.Drift

set_option maxHeartbeats 1000000

open BayesOptimal.Foundations.Counts
open scoped BigOperators

noncomputable def reciprocalSqSum (n q : ℕ) : ℝ :=
  ∑ m ∈ Finset.Ico n q, 1 / (m : ℝ) ^ 2

theorem reciprocalSqSum_nonnegative (n q : ℕ) : 0 ≤ reciprocalSqSum n q := by
  unfold reciprocalSqSum
  exact Finset.sum_nonneg (fun _ _ => by positivity)

theorem reciprocal_square_le_two_decrement (n : ℕ) (hn : 1 ≤ n) :
    1 / (n : ℝ) ^ 2 ≤ 2 * (1 / (n : ℝ) - 1 / ((n : ℝ) + 1)) := by
  have hnr : 1 ≤ (n : ℝ) := by exact_mod_cast hn
  have hp : 0 < (n : ℝ) := by linarith
  have hp1 : 0 < (n : ℝ) + 1 := by positivity
  rw [varianceDecrement_identity n (by omega)]
  unfold varianceDecrement
  rw [← mul_div_assoc]
  apply (div_le_div_iff₀ (by positivity) (by positivity)).mpr
  nlinarith

theorem reciprocalSqSum_bound (n q : ℕ) (hn : 1 ≤ n) (hnq : n ≤ q) :
    reciprocalSqSum n q ≤ 2 * (1 / (n : ℝ) - 1 / (q : ℝ)) := by
  induction q with
  | zero => omega
  | succ q ih =>
      by_cases hnq' : n ≤ q
      · unfold reciprocalSqSum
        rw [Finset.sum_Ico_succ_top hnq']
        have hprev := ih hnq'
        have hstep := reciprocal_square_le_two_decrement q (by omega)
        unfold reciprocalSqSum at hprev
        push_cast
        linarith
      · have hnqeq : n = q + 1 := by omega
        subst n
        simp [reciprocalSqSum]

theorem inverse_difference_preterminal_lower_bound (a b q : ℕ)
    (ha : 1 ≤ a) (hab : a < b) (hbq : b ≤ q) :
    1 / ((q : ℝ) * ((q : ℝ) - 1)) ≤ 1 / (a : ℝ) - 1 / (b : ℝ) := by
  have har : 0 < (a : ℝ) := by exact_mod_cast (show 0 < a by omega)
  have hbr : 0 < (b : ℝ) := by exact_mod_cast (show 0 < b by omega)
  have hqr : 2 ≤ (q : ℝ) := by exact_mod_cast (show 2 ≤ q by omega)
  have hqp : 0 < (q : ℝ) := by linarith
  have hqsubp : 0 < (q : ℝ) - 1 := by linarith
  have haq : (a : ℝ) ≤ (q : ℝ) - 1 := by
    have h : a + 1 ≤ q := by omega
    have hcast : (a : ℝ) + 1 ≤ (q : ℝ) := by exact_mod_cast h
    linarith
  have hbqr : (b : ℝ) ≤ (q : ℝ) := by exact_mod_cast hbq
  have hdelta : 1 ≤ (b : ℝ) - (a : ℝ) := by
    have hcast : (a : ℝ) + 1 ≤ (b : ℝ) := by exact_mod_cast (show a + 1 ≤ b by omega)
    linarith
  have hproduct : (a : ℝ) * (b : ℝ) ≤ ((q : ℝ) - 1) * (q : ℝ) :=
    mul_le_mul haq hbqr (le_of_lt hbr) (by linarith)
  have hscaled : (q : ℝ) * ((q : ℝ) - 1) ≤
      ((b : ℝ) - (a : ℝ)) * ((q : ℝ) * ((q : ℝ) - 1)) := by
    simpa using mul_le_mul_of_nonneg_right hdelta (by positivity :
      0 ≤ (q : ℝ) * ((q : ℝ) - 1))
  have hid : 1 / (a : ℝ) - 1 / (b : ℝ) =
      ((b : ℝ) - (a : ℝ)) / ((a : ℝ) * (b : ℝ)) := by field_simp
  rw [hid]
  apply (div_le_div_iff₀ (by positivity) (by positivity)).mpr
  nlinarith

theorem transitionVariance_residual_bound (q k : ℕ) (c : Counts)
    (hq : 2 ≤ q) (hk : 0 < k) (hc1 : 1 ≤ c.n1) (hc2 : 1 ≤ c.n2)
    (h1 : c.n1 ≤ q) (h2 : c.n2 ≤ q)
    (hsum : c.n1 + c.n2 + k = 2 * q - 1) :
    1 / ((q : ℝ) * ((q : ℝ) - 1)) ≤ transitionVariance k c := by
  have hcaps := balancedRun_preterminal_invariant q k c (by omega) h1 h2 hsum.le
  have hmono := balancedRun_monotone k c
  have htotal := balancedRun_sum k c
  have hprogress : c.n1 < (balancedRun k c).n1 ∨ c.n2 < (balancedRun k c).n2 := by omega
  unfold transitionVariance
  rcases hprogress with hinc1 | hinc2
  · have hb := inverse_difference_preterminal_lower_bound c.n1 _ q hc1 hinc1 hcaps.1
    have hn := inverse_difference_nonnegative c.n2 _ (by omega) hmono.2
    linarith
  · have hb := inverse_difference_preterminal_lower_bound c.n2 _ q hc2 hinc2 hcaps.2.1
    have hn := inverse_difference_nonnegative c.n1 _ (by omega) hmono.1
    linarith

theorem to_anchor_variance_bound (q k : ℕ) (c : Counts)
    (hq : 2 ≤ q) (hk : 0 < k) (hc1 : 1 ≤ c.n1) (hc2 : 1 ≤ c.n2)
    (h1 : c.n1 ≤ q) (h2 : c.n2 ≤ q)
    (hsum : c.n1 + c.n2 + k = 2 * q - 1) :
    (1 / (c.n1 : ℝ) - 1 / (q : ℝ)) +
      (1 / (c.n2 : ℝ) - 1 / (q : ℝ)) ≤ 2 * transitionVariance k c := by
  have hterminal := equation22_terminal_counts q k c (by omega) h1 h2 hsum
  have hresidual := transitionVariance_residual_bound q k c hq hk hc1 hc2 h1 h2 hsum
  have hqr : 2 ≤ (q : ℝ) := by exact_mod_cast hq
  have hqp : (q : ℝ) ≠ 0 := by linarith
  have hqsubp : (q : ℝ) - 1 ≠ 0 := by linarith
  have hqsub : ((q - 1 : ℕ) : ℝ) = (q : ℝ) - 1 := by
    norm_num [Nat.cast_sub (show 1 ≤ q by omega)]
  have hresid : 1 / ((q : ℝ) - 1) - 1 / (q : ℝ) =
      1 / ((q : ℝ) * ((q : ℝ) - 1)) := by
    field_simp
    ring
  unfold transitionVariance at *
  rw [hterminal.1, hterminal.2] at *
  by_cases h2q : c.n2 = q
  · simp only [if_pos h2q, hqsub] at *
    linarith
  · simp only [if_neg h2q, hqsub] at *
    linarith

theorem log_horizon_ge_one (T : ℕ) (hT : 5 ≤ T) : 1 ≤ Real.log (T : ℝ) := by
  have hTr : 5 ≤ (T : ℝ) := by exact_mod_cast hT
  apply (Real.le_log_iff_exp_le (by positivity)).mpr
  have hb := Real.exp_one_lt_d9
  linarith

def eventX (T : ℕ) (CU : ℝ) (p : MeanPath) : Prop :=
  p 3 1 ≤ -CU * Real.sqrt (Real.log (T : ℝ))

def eventY (T q i : ℕ) (p : MeanPath) : Prop := |p i q| ≤ 1 / (T : ℝ) ^ 2

def eventZ (T q i : ℕ) (p : MeanPath) : Prop :=
  ∀ n : ℕ, 1 ≤ n → n ≤ q →
    |p i n - p i q| ≤ 4 * Real.sqrt (Real.log (T : ℝ)) *
      Real.sqrt (reciprocalSqSum n q)

/-- The exact deterministic event W on page 9, including both Y and Z events
with their printed coefficient 4 and all three count restrictions. -/
def paperW (T q : ℕ) (CU : ℝ) (p : MeanPath) (c : Counts) : Prop :=
  eventX T CU p ∧ eventY T q 1 p ∧ eventY T q 2 p ∧
    eventZ T q 1 p ∧ eventZ T q 2 p ∧
    c.n1 ≤ q ∧ c.n2 ≤ q ∧ c.n3 ≤ 1

theorem transitionVariance_le_two (k : ℕ) (c : Counts)
    (hc1 : 1 ≤ c.n1) (hc2 : 1 ≤ c.n2) : transitionVariance k c ≤ 2 := by
  have hn1 : 1 ≤ (c.n1 : ℝ) := by exact_mod_cast hc1
  have hn2 : 1 ≤ (c.n2 : ℝ) := by exact_mod_cast hc2
  have h1 : 1 / (c.n1 : ℝ) ≤ 1 := by
    apply (div_le_iff₀ (by positivity)).mpr
    linarith
  have h2 : 1 / (c.n2 : ℝ) ≤ 1 := by
    apply (div_le_iff₀ (by positivity)).mpr
    linarith
  have hs1 : 0 ≤ 1 / ((balancedRun k c).n1 : ℝ) := by positivity
  have hs2 : 0 ≤ 1 / ((balancedRun k c).n2 : ℝ) := by positivity
  unfold transitionVariance
  linarith

/-- Corrected Equation (24), proved from the complete printed W event.
The residual between the q anchor and the q-1 terminal count is retained.
This yields coefficient 204 with the printed Z coefficient 4. -/
theorem lemma17_fullW_drift_bound (T q t : ℕ) (CU : ℝ) (p : MeanPath) (c : Counts)
    (hT : T = 2 * q + 1) (ht : 4 ≤ t) (hpre : t < T)
    (hc : horizonConsistent t c) (hW : paperW T q CU p c) :
    (terminalGap p c) ^ 2 ≤ 204 * Real.log (T : ℝ) * transitionVariance (T - t) c := by
  rcases hc with ⟨hc1, hc2, hc3, htotal⟩
  rcases hW with ⟨_hX, hY1, hY2, hZ1, hZ2, h1, h2, _h3⟩
  have hq : 2 ≤ q := by omega
  have hT5 : 5 ≤ T := by omega
  have hTreal : 5 ≤ (T : ℝ) := by exact_mod_cast hT5
  have hk : 0 < T - t := by omega
  have hsum : c.n1 + c.n2 + (T - t) = 2 * q - 1 := by omega
  have hlog := log_horizon_ge_one T hT5
  have hlog0 : 0 ≤ Real.log (T : ℝ) := by linarith
  have hS1 := reciprocalSqSum_nonnegative c.n1 q
  have hS2 := reciprocalSqSum_nonnegative c.n2 q
  have hB1 := reciprocalSqSum_bound c.n1 q hc1 h1
  have hB2 := reciprocalSqSum_bound c.n2 q hc2 h2
  have hanchor := to_anchor_variance_bound q (T - t) c hq hk hc1 hc2 h1 h2 hsum
  have hSsum : reciprocalSqSum c.n1 q + reciprocalSqSum c.n2 q ≤
      4 * transitionVariance (T - t) c := by linarith
  have hV0 := transitionVariance_nonnegative (T - t) c (by omega) (by omega)
  have hVl := lemma17_nonterminal_variance_bound T q t c hT (by omega) ht hpre
    ⟨hc1, hc2, hc3, htotal⟩ h1 h2
  have hZ1' := hZ1 c.n1 hc1 h1
  have hZ2' := hZ2 c.n2 hc2 h2
  have hanchors : |p 1 q - p 2 q| ≤ 2 / (T : ℝ) ^ 2 := by
    have habs : |p 1 q - p 2 q| ≤ |p 1 q| + |p 2 q| := by
      simpa only [← sub_eq_add_neg, abs_neg] using abs_add_le (p 1 q) (-p 2 q)
    unfold eventY at hY1 hY2
    calc
      |p 1 q - p 2 q| ≤ |p 1 q| + |p 2 q| := habs
      _ ≤ 1 / (T : ℝ) ^ 2 + 1 / (T : ℝ) ^ 2 := add_le_add hY1 hY2
      _ = 2 / (T : ℝ) ^ 2 := by ring
  have htri1 := abs_sub_le (p 1 c.n1) (p 1 q) (p 2 c.n2)
  have htri2 := abs_sub_le (p 1 q) (p 2 q) (p 2 c.n2)
  rw [abs_sub_comm (p 2 q) (p 2 c.n2)] at htri2
  let A : ℝ := 4 * Real.sqrt (Real.log (T : ℝ)) * Real.sqrt (reciprocalSqSum c.n1 q)
  let B : ℝ := 4 * Real.sqrt (Real.log (T : ℝ)) * Real.sqrt (reciprocalSqSum c.n2 q)
  let C : ℝ := 2 / (T : ℝ) ^ 2
  have hA0 : 0 ≤ A := by dsimp [A]; positivity
  have hB0 : 0 ≤ B := by dsimp [B]; positivity
  have hC0 : 0 ≤ C := by dsimp [C]; positivity
  have habs : |terminalGap p c| ≤ A + B + C := by
    dsimp [A, B, C]
    unfold terminalGap
    linarith only [htri1, htri2, hanchors, hZ1', hZ2']
  have hsq : (terminalGap p c) ^ 2 ≤ (A + B + C) ^ 2 := by
    have h := (sq_le_sq₀ (abs_nonneg (terminalGap p c))
      (show 0 ≤ A + B + C by positivity)).mpr habs
    simpa only [sq_abs] using h
  have hthree : (A + B + C) ^ 2 ≤ 3 * (A ^ 2 + B ^ 2 + C ^ 2) := by
    nlinarith only [sq_nonneg (A - B), sq_nonneg (A - C), sq_nonneg (B - C)]
  have hAsq : A ^ 2 = 16 * Real.log (T : ℝ) * reciprocalSqSum c.n1 q := by
    dsimp [A]
    rw [mul_pow, mul_pow, Real.sq_sqrt hlog0, Real.sq_sqrt hS1]
    norm_num
  have hBsq : B ^ 2 = 16 * Real.log (T : ℝ) * reciprocalSqSum c.n2 q := by
    dsimp [B]
    rw [mul_pow, mul_pow, Real.sq_sqrt hlog0, Real.sq_sqrt hS2]
    norm_num
  have hCsq : C ^ 2 = 4 / (T : ℝ) ^ 4 := by
    dsimp [C]
    rw [div_pow, ← pow_mul]
    norm_num
  have hSscaled := mul_le_mul_of_nonneg_left hSsum hlog0
  have hinv : 1 / (T : ℝ) ^ 4 ≤ 1 / (T : ℝ) ^ 2 := by
    apply (div_le_div_iff₀ (by positivity) (by positivity)).mpr
    have hsquare : 1 ≤ (T : ℝ) ^ 2 := by nlinarith only [hTreal]
    have hpow := mul_le_mul_of_nonneg_right hsquare (sq_nonneg (T : ℝ))
    nlinarith only [hpow]
  have hVscaled : transitionVariance (T - t) c ≤
      Real.log (T : ℝ) * transitionVariance (T - t) c := by
    simpa using mul_le_mul_of_nonneg_right hlog hV0
  have hinvFinal : 1 / (T : ℝ) ^ 4 ≤
      Real.log (T : ℝ) * transitionVariance (T - t) c :=
    hinv.trans (hVl.trans hVscaled)
  have hinvScaled : 4 / (T : ℝ) ^ 4 ≤
      4 * (Real.log (T : ℝ) * transitionVariance (T - t) c) := by
    calc
      4 / (T : ℝ) ^ 4 = 4 * (1 / (T : ℝ) ^ 4) := by ring
      _ ≤ 4 * (Real.log (T : ℝ) * transitionVariance (T - t) c) :=
        mul_le_mul_of_nonneg_left hinvFinal (by norm_num)
  rw [hAsq, hBsq, hCsq] at hthree
  nlinarith only [hsq, hthree, hSscaled, hinvScaled]

end BayesOptimal.Foundations.Drift

end

/-! ## Foundations.Gaussian -/
section

/-!
Corrections of Gaussian formulas in old_version.pdf.

The statements quantify over every real gap/mean and every admissible positive
variance/count. Probability expressions use actual mathlib Gaussian measures.
No statement here is assumed as a paper-specific axiom.
-/

open MeasureTheory ProbabilityTheory Set
open scoped MeasureTheory NNReal ENNReal

namespace BayesOptimal.Foundations.Gaussian

noncomputable section

/-- Bayesian loss written as an expectation with a normalized Gaussian law. -/
def posteriorLoss (gap : ℝ) (variance : ℝ≥0) : ℝ :=
  ∫ x : ℝ, max (x - |gap|) 0 ∂gaussianReal 0 variance

/-- The unnormalized Lebesgue integral printed in Lemma 13. -/
def unnormalizedLoss (gap : ℝ) (variance : ℝ≥0) : ℝ :=
  ∫ x : ℝ, max (x - |gap|) 0 * Real.exp (-x ^ 2 / (2 * variance))

/-- Corrected Lemma 13: retain the Gaussian density's normalization factor. -/
theorem lemma13_normalized (gap : ℝ) (variance : ℝ≥0) (hv : 0 < variance) :
    posteriorLoss gap variance =
      (Real.sqrt (2 * Real.pi * variance))⁻¹ * unnormalizedLoss gap variance := by
  unfold posteriorLoss unnormalizedLoss
  rw [integral_gaussianReal_eq_integral_smul (ne_of_gt hv)]
  simp only [gaussianPDFReal, sub_zero, smul_eq_mul]
  calc
    (∫ x : ℝ, (Real.sqrt (2 * Real.pi * variance))⁻¹ *
        Real.exp (-x ^ 2 / (2 * variance)) * max (x - |gap|) 0) =
        ∫ x : ℝ, (Real.sqrt (2 * Real.pi * variance))⁻¹ *
          (max (x - |gap|) 0 * Real.exp (-x ^ 2 / (2 * variance))) := by
      congr 1
      funext x
      ring
    _ = _ := integral_const_mul _ _

/-- The sample-count-weighted posterior update from Equation (3). -/
def posteriorMeanUpdate (oldMean count sample : ℝ) : ℝ :=
  (count * oldMean + sample) / (count + 1)

theorem posterior_increment_eq (oldMean count sample : ℝ) (hc : count + 1 ≠ 0) :
    posteriorMeanUpdate oldMean count sample - oldMean =
      (sample - oldMean) / (count + 1) := by
  unfold posteriorMeanUpdate
  field_simp [hc]
  ring

/-- Convolution of the posterior and independent unit-variance observation noise. -/
theorem section51_predictive_law (oldMean : ℝ) (count : ℝ≥0) :
    (gaussianReal oldMean count⁻¹) ∗ (gaussianReal 0 1) =
      gaussianReal oldMean (1 + count⁻¹) := by
  rw [gaussianReal_conv_gaussianReal]
  simp only [add_zero, add_comm count⁻¹ 1]

/-- Corrected Section 5.1: the posterior-mean increment has mean zero. -/
theorem section51_increment_law (oldMean : ℝ) (count : ℝ≥0) (hc : 0 < count) :
    (gaussianReal oldMean (1 + count⁻¹)).map
        (fun x => posteriorMeanUpdate oldMean count x - oldMean) =
      gaussianReal 0 (count * (count + 1))⁻¹ := by
  have hcR : 0 < (count : ℝ) := hc
  have hc0 : (count : ℝ) ≠ 0 := ne_of_gt hcR
  have hcp : (count : ℝ) + 1 ≠ 0 := ne_of_gt (by linarith)
  have hf : (fun x : ℝ => posteriorMeanUpdate oldMean count x - oldMean) =
      (fun x : ℝ => ((count : ℝ) + 1)⁻¹ * x) ∘ (fun x : ℝ => x - oldMean) := by
    funext x
    rw [posterior_increment_eq _ _ _ hcp]
    simp only [Function.comp_apply, div_eq_mul_inv, mul_comm]
  rw [hf, ← Measure.map_map (by fun_prop) (by fun_prop),
    gaussianReal_map_sub_const, gaussianReal_map_const_mul]
  congr 1
  · simp
  · ext
    simp only [NNReal.coe_mul, NNReal.coe_mk, NNReal.coe_add, NNReal.coe_one,
      NNReal.coe_inv]
    field_simp [hc0, hcp]

/-- The same corrected law with the paper's positive natural-number sample count. -/
theorem section51_increment_law_nat (oldMean : ℝ) (count : ℕ) (hc : 0 < count) :
    (gaussianReal oldMean (1 + (count : ℝ≥0)⁻¹)).map
        (fun x => posteriorMeanUpdate oldMean count x - oldMean) =
      gaussianReal 0 ((count : ℝ≥0) * (count + 1))⁻¹ := by
  simpa using section51_increment_law oldMean (count : ℝ≥0) (by exact_mod_cast hc)

/-- The probability product displayed as g₁ in Lemma 14. -/
def lemma14_g1 (gap : ℝ) (varianceL varianceR : ℝ≥0) : ℝ :=
  (gaussianReal 0 varianceL (Icc |gap| (2 * |gap|))).toReal *
  (gaussianReal 0 varianceR (Ici |gap|)).toReal * |gap|

theorem lemma14_g1_nonnegative (gap : ℝ) (varianceL varianceR : ℝ≥0) :
    0 ≤ lemma14_g1 gap varianceL varianceR := by
  unfold lemma14_g1
  positivity

theorem lemma14_g1_at_zero (varianceL varianceR : ℝ≥0) :
    lemma14_g1 0 varianceL varianceR = 0 := by
  simp [lemma14_g1]

/-- Every interval of positive length has positive probability under a
positive-variance Gaussian. This uses equivalence of Gaussian and Lebesgue
null sets, rather than numerical quadrature. -/
theorem gaussian_Icc_probability_pos (mean a b : ℝ) (variance : ℝ≥0)
    (hv : 0 < variance) (hab : a < b) :
    0 < (gaussianReal mean variance (Icc a b)).toReal := by
  apply ENNReal.toReal_pos _ (measure_ne_top _ _)
  intro hz
  have hzv := gaussianReal_absolutelyContinuous' mean (ne_of_gt hv) hz
  rw [Real.volume_Icc] at hzv
  exact (ENNReal.ofReal_pos.mpr (sub_pos.mpr hab)).ne' hzv

theorem gaussian_Ici_probability_pos (mean a : ℝ) (variance : ℝ≥0)
    (hv : 0 < variance) :
    0 < (gaussianReal mean variance (Ici a)).toReal := by
  apply ENNReal.toReal_pos _ (measure_ne_top _ _)
  intro hz
  have hsub : Icc a (a + 1) ⊆ Ici a := fun _ hx => hx.1
  have hzcc := measure_mono_null hsub hz
  have hp := gaussian_Icc_probability_pos mean a (a + 1) variance hv (by linarith)
  rw [hzcc, ENNReal.toReal_zero] at hp
  exact (lt_irrefl (0 : ℝ)) hp

/-- Corrected Lemma 14 positivity has the necessary nonzero-gap hypothesis. -/
theorem lemma14_g1_positive (gap : ℝ) (varianceL varianceR : ℝ≥0)
    (hgap : gap ≠ 0) (hl : 0 < varianceL) (hr : 0 < varianceR) :
    0 < lemma14_g1 gap varianceL varianceR := by
  have hg : 0 < |gap| := abs_pos.mpr hgap
  unfold lemma14_g1
  exact mul_pos
    (mul_pos (gaussian_Icc_probability_pos 0 _ _ varianceL hl (by linarith))
      (gaussian_Ici_probability_pos 0 _ varianceR hr)) hg

/-- The exact boundary condition for strict positivity of the printed product. -/
theorem lemma14_g1_positive_iff (gap : ℝ) (varianceL varianceR : ℝ≥0)
    (hl : 0 < varianceL) (hr : 0 < varianceR) :
    0 < lemma14_g1 gap varianceL varianceR ↔ gap ≠ 0 := by
  constructor
  · intro hp hz
    subst gap
    rw [lemma14_g1_at_zero] at hp
    exact (lt_irrefl (0 : ℝ)) hp
  · intro hgap
    exact lemma14_g1_positive gap varianceL varianceR hgap hl hr

/-- Gaussian hinge expectation without taking the absolute value of its center. -/
def hingeLoss (center : ℝ) (variance : ℝ≥0) : ℝ :=
  ∫ x : ℝ, max (x - center) 0 ∂gaussianReal 0 variance

theorem gaussian_id_integrable (mean : ℝ) (variance : ℝ≥0) :
    Integrable (fun x : ℝ => x) (gaussianReal mean variance) := by
  exact memLp_one_iff_integrable.mp (memLp_id_gaussianReal 1)

theorem hinge_integrable (center : ℝ) (variance : ℝ≥0) :
    Integrable (fun x : ℝ => max (x - center) 0) (gaussianReal 0 variance) := by
  exact ((gaussian_id_integrable 0 variance).sub (integrable_const center)).pos_part

theorem hingeLoss_nonnegative (center : ℝ) (variance : ℝ≥0) :
    0 ≤ hingeLoss center variance := by
  exact integral_nonneg (fun _ => le_max_right _ _)

/-- A positive-variance Gaussian has a strictly positive hinge expectation
at every finite threshold, including threshold zero. -/
theorem hingeLoss_positive (center : ℝ) (variance : ℝ≥0) (hv : 0 < variance) :
    0 < hingeLoss center variance := by
  apply (integral_pos_iff_support_of_nonneg (fun _ => le_max_right _ _)
    (hinge_integrable center variance)).mpr
  have hp := gaussian_Icc_probability_pos 0 (center + 1) (center + 2) variance hv
    (by linarith)
  have hm := (ENNReal.toReal_pos_iff.mp hp).1
  apply lt_of_lt_of_le hm (measure_mono ?_)
  intro x hx
  change max (x - center) 0 ≠ 0
  have hxpos : 0 < x - center := by linarith [hx.1]
  rw [max_eq_left hxpos.le]
  exact ne_of_gt hxpos

/-- Gaussian symmetry and the identity u₊-(-u)₊=u. -/
theorem hingeLoss_reflection (center : ℝ) (variance : ℝ≥0) :
    hingeLoss center variance - hingeLoss (-center) variance = -center := by
  have hsym : (gaussianReal 0 variance).map (fun x : ℝ => -x) =
      gaussianReal 0 variance := by simpa using (gaussianReal_map_neg (μ := (0 : ℝ)))
  have href : hingeLoss (-center) variance =
      ∫ x : ℝ, max (-(x - center)) 0 ∂gaussianReal 0 variance := by
    unfold hingeLoss
    calc
      (∫ x : ℝ, max (x - -center) 0 ∂gaussianReal 0 variance) =
          ∫ x : ℝ, max (x - -center) 0
            ∂((gaussianReal 0 variance).map (fun x : ℝ => -x)) := by rw [hsym]
      _ = ∫ x : ℝ, max (-x - -center) 0 ∂gaussianReal 0 variance := by
        rw [integral_map (by fun_prop) (by fun_prop)]
      _ = _ := by
        congr 1
        funext x
        congr 1
        ring
  have hi := ((gaussian_id_integrable 0 variance).sub (integrable_const center))
  have hiNeg : Integrable (fun x : ℝ => max (-(x - center)) 0)
      (gaussianReal 0 variance) := by
    simpa only [Pi.neg_apply, Pi.sub_apply] using hi.neg.pos_part
  rw [href, hingeLoss, ← integral_sub (hinge_integrable center variance) hiNeg]
  calc
    (∫ x : ℝ, (max (x - center) 0 - max (-(x - center)) 0)
        ∂gaussianReal 0 variance) = ∫ x : ℝ, (x - center) ∂gaussianReal 0 variance := by
      congr 1
      funext x
      by_cases hx : 0 ≤ x - center
      · rw [max_eq_left hx, max_eq_right (by linarith)]
        ring
      · rw [max_eq_right (le_of_not_ge hx), max_eq_left (by linarith)]
        ring
    _ = -center := by rw [integral_sub (gaussian_id_integrable 0 variance)
      (integrable_const center), integral_id_gaussianReal]; simp

theorem hingeLoss_sub_abs (center : ℝ) (variance : ℝ≥0) :
    hingeLoss center variance - hingeLoss |center| variance = max (-center) 0 := by
  by_cases hc : 0 ≤ center
  · rw [abs_of_nonneg hc, sub_self, max_eq_right (by linarith)]
  · have hcn : center < 0 := lt_of_not_ge hc
    rw [abs_of_neg hcn, hingeLoss_reflection, max_eq_left (by linarith)]

/-- Expected loss after one draw, with posterior variance varianceR and
independent mean-update variance varianceL. -/
def expectedLossAfterDraw (gap : ℝ) (varianceL varianceR : ℝ≥0) : ℝ :=
  ∫ l : ℝ, posteriorLoss (|gap| - l) varianceR ∂gaussianReal 0 varianceL

/-- Correct one-step improvement, as a Gaussian hinge expectation. -/
def oneStepImprovement (gap : ℝ) (varianceL varianceR : ℝ≥0) : ℝ :=
  posteriorLoss gap (varianceL + varianceR) -
    expectedLossAfterDraw gap varianceL varianceR

/-- The exact loss reduction is independent of the remaining posterior
variance: it equals the expected positive part of the posterior mean update
minus the current gap. -/
theorem oneStepImprovement_eq_hinge (gap : ℝ) (varianceL varianceR : ℝ≥0) :
    oneStepImprovement gap varianceL varianceR = hingeLoss |gap| varianceL := by
  have hconv : (gaussianReal 0 varianceL) ∗ (gaussianReal 0 varianceR) =
      gaussianReal 0 (varianceL + varianceR) := by
    simpa using (gaussianReal_conv_gaussianReal (m₁ := (0 : ℝ)) (m₂ := (0 : ℝ))
      (v₁ := varianceL) (v₂ := varianceR))
  have hi : Integrable (fun x : ℝ => max (x - |gap|) 0)
      ((gaussianReal 0 varianceL) ∗ (gaussianReal 0 varianceR)) := by
    rw [hconv]
    exact hinge_integrable |gap| (varianceL + varianceR)
  have hbefore : posteriorLoss gap (varianceL + varianceR) =
      ∫ l : ℝ, hingeLoss (|gap| - l) varianceR ∂gaussianReal 0 varianceL := by
    unfold posteriorLoss hingeLoss
    rw [← hconv, integral_conv hi]
    congr 1
    funext l
    congr 1
    funext r
    congr 1
    ring
  have hiOuter : Integrable (fun l : ℝ => hingeLoss (|gap| - l) varianceR)
      (gaussianReal 0 varianceL) := by
    have h := (integrable_conv_iff hi.aestronglyMeasurable).mp hi
    have hf : (fun l : ℝ => ∫ r : ℝ, ‖max (l + r - |gap|) 0‖
        ∂gaussianReal 0 varianceR) = (fun l : ℝ => hingeLoss (|gap| - l) varianceR) := by
      funext l
      unfold hingeLoss
      congr 1
      funext r
      rw [Real.norm_eq_abs, abs_of_nonneg (le_max_right _ _)]
      congr 1
      ring
    rw [hf] at h
    exact h.2
  have hpoint : (fun l : ℝ => posteriorLoss (|gap| - l) varianceR) =
      (fun l : ℝ => hingeLoss (|gap| - l) varianceR - max (l - |gap|) 0) := by
    funext l
    have h := hingeLoss_sub_abs (|gap| - l) varianceR
    change hingeLoss (|(|gap| - l)|) varianceR = _
    have hneg : -(|gap| - l) = l - |gap| := by ring
    rw [hneg] at h
    linarith
  unfold oneStepImprovement expectedLossAfterDraw
  rw [hbefore, hpoint, integral_sub hiOuter (hinge_integrable |gap| varianceL)]
  unfold hingeLoss
  ring

/-- Corrected strict improvement holds at every gap, including a tie.
Only the sampled arm's mean-update variance must be positive. -/
theorem oneStepImprovement_positive (gap : ℝ) (varianceL varianceR : ℝ≥0)
    (hl : 0 < varianceL) :
    0 < oneStepImprovement gap varianceL varianceR := by
  rw [oneStepImprovement_eq_hinge]
  exact hingeLoss_positive |gap| varianceL hl

/-- A usable lower bound comes from an interval on which the hinge is at
least epsilon. Unlike the printed g₁, it can remain positive at a tie. -/
theorem hingeLoss_ge_interval (center epsilon : ℝ) (variance : ℝ≥0) :
    epsilon * (gaussianReal 0 variance
      (Icc (center + epsilon) (center + 2 * epsilon))).toReal ≤
    hingeLoss center variance := by
  calc
    _ ≤ ∫ x : ℝ in Icc (center + epsilon) (center + 2 * epsilon),
        max (x - center) 0 ∂gaussianReal 0 variance := by
      exact setIntegral_ge_of_const_le measurableSet_Icc (measure_ne_top _ _)
        (fun x hx => le_trans (by linarith [hx.1]) (le_max_left _ _))
        (hinge_integrable center variance).restrict
    _ ≤ _ := setIntegral_le_integral (hinge_integrable center variance)
      (ae_of_all _ (fun _ => le_max_right _ _))

def correctedImprovementLowerBound (gap epsilon : ℝ) (varianceL : ℝ≥0) : ℝ :=
  epsilon * (gaussianReal 0 varianceL
    (Icc (|gap| + epsilon) (|gap| + 2 * epsilon))).toReal

theorem correctedImprovementLowerBound_positive (gap epsilon : ℝ) (varianceL : ℝ≥0)
    (he : 0 < epsilon) (hl : 0 < varianceL) :
    0 < correctedImprovementLowerBound gap epsilon varianceL := by
  exact mul_pos he (gaussian_Icc_probability_pos 0 _ _ varianceL hl (by linarith))

theorem oneStepImprovement_ge_corrected_bound (gap epsilon : ℝ)
    (varianceL varianceR : ℝ≥0) :
    correctedImprovementLowerBound gap epsilon varianceL ≤
      oneStepImprovement gap varianceL varianceR := by
  rw [oneStepImprovement_eq_hinge]
  exact hingeLoss_ge_interval |gap| epsilon varianceL

def updateVariance (count : ℝ≥0) : ℝ≥0 := (count * (count + 1))⁻¹

def posteriorVariance (countL countR : ℝ≥0) : ℝ≥0 := countL⁻¹ + countR⁻¹

/-- The posterior variance splits into update and remaining variances. -/
theorem posteriorVariance_after_draw (countL countR : ℝ≥0) (hc : 0 < countL) :
    posteriorVariance countL countR =
      updateVariance countL + posteriorVariance (countL + 1) countR := by
  have hcR : 0 < (countL : ℝ) := hc
  have hc0 : (countL : ℝ) ≠ 0 := ne_of_gt hcR
  have hcp : (countL : ℝ) + 1 ≠ 0 := ne_of_gt (by linarith)
  ext
  simp only [posteriorVariance, updateVariance, NNReal.coe_inv, NNReal.coe_add,
    NNReal.coe_mul, NNReal.coe_one]
  field_simp [hc0, hcp]
  ring

/-- Strict terminal loss reduction for every real gap and every positive
sample count of the drawn arm, using the paper's actual variance update. -/
theorem terminal_loss_strictly_reduced (gap : ℝ) (countL countR : ℝ≥0)
    (hc : 0 < countL) :
    expectedLossAfterDraw gap (updateVariance countL)
        (posteriorVariance (countL + 1) countR) <
      posteriorLoss gap (posteriorVariance countL countR) := by
  rw [posteriorVariance_after_draw countL countR hc]
  have hp := oneStepImprovement_positive gap (updateVariance countL)
    (posteriorVariance (countL + 1) countR) (by unfold updateVariance; positivity)
  unfold oneStepImprovement at hp
  exact sub_pos.mp hp

/-- Difference of independent Gaussian posteriors has the sum of variances. -/
theorem posterior_difference_law (meanL meanR : ℝ) (countL countR : ℝ≥0) :
    (gaussianReal meanL countL⁻¹) ∗
      ((gaussianReal meanR countR⁻¹).map (fun x : ℝ => -x)) =
    gaussianReal (meanL - meanR) (posteriorVariance countL countR) := by
  rw [gaussianReal_map_neg, gaussianReal_conv_gaussianReal]
  rfl

/-- Coupling all zero-mean Gaussians by scaling a unit-variance Gaussian. -/
theorem hingeLoss_eq_standard_integral (center : ℝ) (variance : ℝ≥0) :
    hingeLoss center variance =
      ∫ x : ℝ, max (Real.sqrt (variance : ℝ) * x - center) 0
        ∂gaussianReal 0 1 := by
  have hv : (⟨(Real.sqrt (variance : ℝ)) ^ 2, sq_nonneg _⟩ : ℝ≥0) * 1 = variance := by
    ext
    simp only [mul_one]
    exact Real.sq_sqrt variance.property
  have hmap : (gaussianReal 0 1).map (fun x : ℝ => Real.sqrt (variance : ℝ) * x) =
      gaussianReal 0 variance := by
    rw [gaussianReal_map_const_mul, mul_zero, hv]
  unfold hingeLoss
  rw [← hmap, integral_map (by fun_prop) (by fun_prop)]

/-- For a nonnegative gap, increasing the variance strictly increases the
expected gain. The proof couples Gaussians and integrates a pointwise strict
inequality on an interval of positive Gaussian probability. -/
theorem hingeLoss_strictMono_variance (center : ℝ) (hcenter : 0 ≤ center)
    (varianceL varianceR : ℝ≥0) (hv : varianceL < varianceR) :
    hingeLoss center varianceL < hingeLoss center varianceR := by
  let sL := Real.sqrt (varianceL : ℝ)
  let sR := Real.sqrt (varianceR : ℝ)
  have hsL : 0 ≤ sL := Real.sqrt_nonneg _
  have hs : sL < sR := Real.sqrt_lt_sqrt varianceL.property hv
  have hsR : 0 < sR := lt_of_le_of_lt hsL hs
  have hiL : Integrable (fun x : ℝ => max (sL * x - center) 0) (gaussianReal 0 1) :=
    (((gaussian_id_integrable 0 1).const_mul sL).sub (integrable_const center)).pos_part
  have hiR : Integrable (fun x : ℝ => max (sR * x - center) 0) (gaussianReal 0 1) :=
    (((gaussian_id_integrable 0 1).const_mul sR).sub (integrable_const center)).pos_part
  have hmono : ∀ x : ℝ, max (sL * x - center) 0 ≤ max (sR * x - center) 0 := by
    intro x
    by_cases hx : 0 ≤ x
    · exact max_le_max (sub_le_sub_right (mul_le_mul_of_nonneg_right hs.le hx) center) le_rfl
    · have hxn : x ≤ 0 := le_of_lt (lt_of_not_ge hx)
      rw [max_eq_right (by nlinarith : sL * x - center ≤ 0)]
      exact le_max_right _ _
  have hp : 0 < ∫ x : ℝ, (max (sR * x - center) 0 - max (sL * x - center) 0)
      ∂gaussianReal 0 1 := by
    apply (integral_pos_iff_support_of_nonneg
      (fun x => sub_nonneg.mpr (hmono x)) (hiR.sub hiL)).mpr
    let a := (center + 1) / sR
    have ha : 0 < a := div_pos (by linarith) hsR
    have hprob := gaussian_Icc_probability_pos 0 a (a + 1) 1 (by norm_num) (by linarith)
    apply lt_of_lt_of_le (ENNReal.toReal_pos_iff.mp hprob).1 (measure_mono ?_)
    intro x hx
    change max (sR * x - center) 0 - max (sL * x - center) 0 ≠ 0
    have hxpos : 0 < x := lt_of_lt_of_le ha hx.1
    have hxR : center + 1 ≤ sR * x := by
      have hh := (div_le_iff₀ hsR).mp hx.1
      simpa only [mul_comm x sR] using hh
    have hmul : sL * x < sR * x := mul_lt_mul_of_pos_right hs hxpos
    have hmax : max (sL * x - center) 0 < max (sR * x - center) 0 := by
      rw [max_eq_left (by linarith : 0 ≤ sR * x - center)]
      exact max_lt_iff.mpr ⟨by linarith, by linarith⟩
    exact ne_of_gt (sub_pos.mpr hmax)
  rw [integral_sub hiR hiL] at hp
  rw [hingeLoss_eq_standard_integral, hingeLoss_eq_standard_integral]
  exact sub_pos.mp hp

/-- One-step gain is strictly increasing in the update variance. -/
theorem oneStepImprovement_strictMono_updateVariance (gap : ℝ)
    (varianceL varianceL' varianceR varianceR' : ℝ≥0) (hv : varianceL < varianceL') :
    oneStepImprovement gap varianceL varianceR <
      oneStepImprovement gap varianceL' varianceR' := by
  rw [oneStepImprovement_eq_hinge, oneStepImprovement_eq_hinge]
  exact hingeLoss_strictMono_variance |gap| (abs_nonneg _) varianceL varianceL' hv

theorem updateVariance_strictAntitone (countL countR : ℝ≥0)
    (hl : 0 < countL) (hcounts : countL < countR) :
    updateVariance countR < updateVariance countL := by
  have hr : 0 < countR := lt_trans hl hcounts
  unfold updateVariance
  apply inv_lt_inv₀ (by positivity) (by positivity) |>.mpr
  have hlR : 0 < (countL : ℝ) := hl
  have hcountsR : (countL : ℝ) < countR := hcounts
  change (countL : ℝ) * ((countL : ℝ) + 1) <
    (countR : ℝ) * ((countR : ℝ) + 1)
  nlinarith

theorem posteriorVariance_comm (countL countR : ℝ≥0) :
    posteriorVariance countL countR = posteriorVariance countR countL := by
  unfold posteriorVariance
  exact add_comm _ _

/-- Corrected terminal version of Lemma 15: sampling the arm with the
smaller count gives the strictly smaller expected terminal loss. -/
theorem terminal_sample_smaller_count_optimal (gap : ℝ) (countL countR : ℝ≥0)
    (hr : 0 < countR) (hcounts : countR < countL) :
    expectedLossAfterDraw gap (updateVariance countR)
        (posteriorVariance (countR + 1) countL) <
      expectedLossAfterDraw gap (updateVariance countL)
        (posteriorVariance (countL + 1) countR) := by
  have hl : 0 < countL := lt_trans hr hcounts
  have hvariance := updateVariance_strictAntitone countR countL hr hcounts
  have hgain := hingeLoss_strictMono_variance |gap| (abs_nonneg _)
    (updateVariance countL) (updateVariance countR) hvariance
  have hleft := oneStepImprovement_eq_hinge gap (updateVariance countL)
    (posteriorVariance (countL + 1) countR)
  have hright := oneStepImprovement_eq_hinge gap (updateVariance countR)
    (posteriorVariance (countR + 1) countL)
  unfold oneStepImprovement at hleft hright
  rw [← posteriorVariance_after_draw countL countR hl] at hleft
  rw [← posteriorVariance_after_draw countR countL hr,
    posteriorVariance_comm countR countL] at hright
  linarith

theorem gaussian_positivePart_integral (mean : ℝ) (variance : ℝ≥0) :
    (∫ x : ℝ, max x 0 ∂gaussianReal mean variance) = hingeLoss (-mean) variance := by
  have hmap := gaussianReal_map_add_const (μ := (0 : ℝ)) (v := variance) mean
  simp only [zero_add] at hmap
  rw [← hmap, integral_map (by fun_prop) (by fun_prop)]
  unfold hingeLoss
  congr 1
  funext x
  congr 1
  ring

theorem gaussian_negativePart_integral (mean : ℝ) (variance : ℝ≥0) :
    (∫ x : ℝ, max (-x) 0 ∂gaussianReal mean variance) = hingeLoss mean variance := by
  have hmap := gaussianReal_map_neg (μ := mean) (v := variance)
  have hm : (∫ x : ℝ, max (-x) 0 ∂gaussianReal mean variance) =
      ∫ x : ℝ, max x 0 ∂gaussianReal (-mean) variance := by
    rw [← hmap, integral_map (by fun_prop) (by fun_prop)]
  rw [hm, gaussian_positivePart_integral, neg_neg]

/-- Posterior expected simple regret when recommending the arm with the
larger posterior mean (choose the right arm at a tie). The posterior
difference law is Gaussian with the sum of posterior variances. -/
def twoArmPosteriorLoss (meanL meanR : ℝ) (varianceL varianceR : ℝ≥0) : ℝ :=
  if meanL ≤ meanR then
    ∫ d : ℝ, max d 0 ∂gaussianReal (meanL - meanR) (varianceL + varianceR)
  else
    ∫ d : ℝ, max (-d) 0 ∂gaussianReal (meanL - meanR) (varianceL + varianceR)

/-- Corrected Lemma 13 also holds for the explicit two-arm recommendation
loss, for either ordering of the posterior means. -/
theorem twoArmPosteriorLoss_eq (meanL meanR : ℝ) (varianceL varianceR : ℝ≥0) :
    twoArmPosteriorLoss meanL meanR varianceL varianceR =
      posteriorLoss (meanL - meanR) (varianceL + varianceR) := by
  unfold twoArmPosteriorLoss
  by_cases hm : meanL ≤ meanR
  · rw [if_pos hm, gaussian_positivePart_integral]
    unfold posteriorLoss hingeLoss
    rw [abs_of_nonpos (sub_nonpos.mpr hm)]
  · rw [if_neg hm, gaussian_negativePart_integral]
    unfold posteriorLoss hingeLoss
    rw [abs_of_nonneg (sub_nonneg.mpr (le_of_lt (lt_of_not_ge hm)))]

theorem twoArmPosteriorLoss_normalized (meanL meanR : ℝ) (varianceL varianceR : ℝ≥0)
    (hv : 0 < varianceL + varianceR) :
    twoArmPosteriorLoss meanL meanR varianceL varianceR =
      (Real.sqrt (2 * Real.pi * (varianceL + varianceR)))⁻¹ *
        unnormalizedLoss (meanL - meanR) (varianceL + varianceR) := by
  rw [twoArmPosteriorLoss_eq]
  exact lemma13_normalized _ _ hv

end

end BayesOptimal.Foundations.Gaussian

end

/-! ## Foundations.SmallBall -/
section

/-!
Actual Gaussian small-ball bound replacing the flawed variance estimate in
Appendix B. The final probability retains the paper's printed f₂ constant.
-/

open MeasureTheory ProbabilityTheory Set
open scoped MeasureTheory NNReal ENNReal

namespace BayesOptimal.Foundations.SmallBall

noncomputable section

def f2 (t : ℝ) : ℝ := (1 / 2) * Real.sqrt (1 / (Real.pi * t ^ 3))

theorem gaussianPDF_smallBall_lower {t x : ℝ} {v : ℝ≥0}
    (ht : 3 ≤ t) (hv : 0 < v) (hvlower : t⁻¹ ≤ (v : ℝ))
    (hvupper : (v : ℝ) ≤ 3 / t)
    (hx : x ∈ Icc (-(t ^ 2)⁻¹) ((t ^ 2)⁻¹)) :
    (3 / 4) * (Real.sqrt (6 * Real.pi / t))⁻¹ ≤ gaussianPDFReal 0 v x := by
  have htpos : 0 < t := by linarith
  have ht2pos : 0 < t ^ 2 := sq_pos_of_pos htpos
  have hvpos : 0 < (v : ℝ) := hv
  have hrnonneg : 0 ≤ (t ^ 2)⁻¹ := inv_nonneg.mpr ht2pos.le
  have hrhalf : (t ^ 2)⁻¹ ≤ 1 / 2 := by
    rw [← one_div (t ^ 2)]
    apply (div_le_iff₀ ht2pos).mpr
    nlinarith
  have hrv : (t ^ 2)⁻¹ ≤ (v : ℝ) := by
    apply le_trans _ hvlower
    apply (inv_le_inv₀ ht2pos htpos).mpr
    nlinarith
  have hxsq : x ^ 2 ≤ ((t ^ 2)⁻¹) ^ 2 := by
    have hxabs : |x| ≤ (t ^ 2)⁻¹ := abs_le.mpr hx
    simpa only [sq_abs] using (sq_le_sq₀ (abs_nonneg x) hrnonneg).mpr hxabs
  have hquad : x ^ 2 ≤ (v : ℝ) / 2 := by
    nlinarith
  have hquot : x ^ 2 / (2 * (v : ℝ)) ≤ 1 / 4 := by
    apply (div_le_iff₀ (by positivity : 0 < 2 * (v : ℝ))).mpr
    nlinarith
  have hexp : (3 / 4 : ℝ) ≤ Real.exp (-x ^ 2 / (2 * (v : ℝ))) := by
    have he := Real.add_one_le_exp (-x ^ 2 / (2 * (v : ℝ)))
    rw [neg_div] at he ⊢
    linarith
  have hspos : 0 < Real.sqrt (2 * Real.pi * (v : ℝ)) := by positivity
  have hsboundpos : 0 < Real.sqrt (6 * Real.pi / t) := by positivity
  have hnorm : (Real.sqrt (6 * Real.pi / t))⁻¹ ≤
      (Real.sqrt (2 * Real.pi * (v : ℝ)))⁻¹ := by
    apply (inv_le_inv₀ hsboundpos hspos).mpr
    apply Real.sqrt_le_sqrt
    calc
      2 * Real.pi * (v : ℝ) ≤ 2 * Real.pi * (3 / t) := by gcongr
      _ = 6 * Real.pi / t := by ring
  calc
    _ ≤ (Real.sqrt (2 * Real.pi * (v : ℝ)))⁻¹ *
        Real.exp (-x ^ 2 / (2 * (v : ℝ))) := by
      rw [mul_comm (3 / 4 : ℝ)]
      exact mul_le_mul hnorm hexp (by norm_num) (inv_nonneg.mpr hspos.le)
    _ = gaussianPDFReal 0 v x := by simp only [gaussianPDFReal, sub_zero]

theorem smallBall_constant_comparison {t : ℝ} (ht : 0 < t) :
    f2 t ≤ (3 / 2) * (t ^ 2)⁻¹ * (Real.sqrt (6 * Real.pi / t))⁻¹ := by
  let r := Real.sqrt (1 / (Real.pi * t ^ 3))
  let s := Real.sqrt (6 * Real.pi / t)
  have hr : 0 ≤ r := Real.sqrt_nonneg _
  have hs : 0 < s := by dsimp [s]; positivity
  have ht0 : t ≠ 0 := ne_of_gt ht
  have hp0 : Real.pi ≠ 0 := ne_of_gt Real.pi_pos
  have hr2 : r ^ 2 = 1 / (Real.pi * t ^ 3) := Real.sq_sqrt (by positivity)
  have hs2 : s ^ 2 = 6 * Real.pi / t := Real.sq_sqrt (by positivity)
  have hprod : (r * s * t ^ 2) ^ 2 = 6 := by
    rw [mul_pow, mul_pow, hr2, hs2]
    field_simp [ht0, hp0]
  have hprodle : r * s * t ^ 2 ≤ 3 := by nlinarith
  change (1 / 2) * r ≤ (3 / 2) * (t ^ 2)⁻¹ * s⁻¹
  apply (mul_le_mul_iff_left₀ (by positivity : 0 < t ^ 2 * s)).mp
  calc
    ((1 / 2) * r) * (t ^ 2 * s) = (1 / 2) * (r * s * t ^ 2) := by ring
    _ ≤ (1 / 2) * 3 := by gcongr
    _ = ((3 / 2) * (t ^ 2)⁻¹ * s⁻¹) * (t ^ 2 * s) := by
      field_simp [ht0, ne_of_gt hs]

theorem gaussian_smallBall_probability_lower {t : ℝ} {v : ℝ≥0}
    (ht : 3 ≤ t) (hv : 0 < v) (hvlower : t⁻¹ ≤ (v : ℝ))
    (hvupper : (v : ℝ) ≤ 3 / t) :
    f2 t ≤ (gaussianReal 0 v (Icc (-(t ^ 2)⁻¹) ((t ^ 2)⁻¹))).toReal := by
  have htpos : 0 < t := by linarith
  have hrnonneg : 0 ≤ (t ^ 2)⁻¹ := inv_nonneg.mpr (sq_nonneg _)
  have hmass : (gaussianReal 0 v (Icc (-(t ^ 2)⁻¹) ((t ^ 2)⁻¹))).toReal =
      ∫ x in Icc (-(t ^ 2)⁻¹) ((t ^ 2)⁻¹), gaussianPDFReal 0 v x := by
    rw [gaussianReal_apply_eq_integral 0 (ne_of_gt hv), ENNReal.toReal_ofReal]
    exact integral_nonneg (gaussianPDFReal_nonneg _ _)
  have hmono :
      (∫ _ in Icc (-(t ^ 2)⁻¹) ((t ^ 2)⁻¹),
        (3 / 4 : ℝ) * (Real.sqrt (6 * Real.pi / t))⁻¹) ≤
      ∫ x in Icc (-(t ^ 2)⁻¹) ((t ^ 2)⁻¹), gaussianPDFReal 0 v x := by
    apply setIntegral_mono_on (integrableOn_const isCompact_Icc.measure_ne_top)
      (integrable_gaussianPDFReal 0 v).integrableOn measurableSet_Icc
    intro x hx
    exact gaussianPDF_smallBall_lower ht hv hvlower hvupper hx
  have hconst :
      (∫ _ in Icc (-(t ^ 2)⁻¹) ((t ^ 2)⁻¹),
        (3 / 4 : ℝ) * (Real.sqrt (6 * Real.pi / t))⁻¹) =
      (3 / 2) * (t ^ 2)⁻¹ * (Real.sqrt (6 * Real.pi / t))⁻¹ := by
    rw [setIntegral_const, smul_eq_mul, measureReal_def, Real.volume_Icc,
      ENNReal.toReal_ofReal (by linarith : 0 ≤ (t ^ 2)⁻¹ - -(t ^ 2)⁻¹)]
    ring
  rw [← hmass, hconst] at hmono
  exact (smallBall_constant_comparison htpos).trans hmono

/-- Corrected Appendix B/Lemma 4 for the actual variance 1/q, T=2q+1.
The paper's f₂ lower bound survives the corrected variance estimate. -/
theorem appendixB_probability_lower (q : ℕ) (hq : 0 < q) :
    f2 (2 * (q : ℝ) + 1) ≤
      (gaussianReal 0 (q : ℝ≥0)⁻¹
        (Icc (-((2 * (q : ℝ) + 1) ^ 2)⁻¹) (((2 * (q : ℝ) + 1) ^ 2)⁻¹))).toReal := by
  have hqR : (1 : ℝ) ≤ q := by exact_mod_cast (show 1 ≤ q by omega)
  have hqpos : 0 < (q : ℝ) := by linarith
  have htpos : 0 < 2 * (q : ℝ) + 1 := by linarith
  apply gaussian_smallBall_probability_lower (by linarith) (by positivity)
  · simp only [NNReal.coe_inv, NNReal.coe_natCast]
    apply (inv_le_inv₀ htpos hqpos).mpr
    linarith
  · simp only [NNReal.coe_inv, NNReal.coe_natCast]
    rw [← one_div (q : ℝ)]
    apply (div_le_iff₀ hqpos).mpr
    rw [div_mul_eq_mul_div]
    apply (le_div_iff₀ htpos).mpr
    nlinarith

/-- Law of the sum of q independent unit-variance, zero-mean Gaussian
observations, with convolution expressing independence. -/
def standardNormalSum : ℕ → Measure ℝ
  | 0 => gaussianReal 0 0
  | q + 1 => standardNormalSum q ∗ gaussianReal 0 1

theorem standardNormalSum_law (q : ℕ) :
    standardNormalSum q = gaussianReal 0 (q : ℝ≥0) := by
  induction q with
  | zero => simp only [standardNormalSum, Nat.cast_zero]
  | succ q ih =>
    rw [standardNormalSum, ih, gaussianReal_conv_gaussianReal]
    simp only [add_zero, Nat.cast_add, Nat.cast_one]

def standardNormalAverage (q : ℕ) : Measure ℝ :=
  (standardNormalSum q).map (fun x : ℝ => (q : ℝ)⁻¹ * x)

theorem standardNormalAverage_law (q : ℕ) (hq : 0 < q) :
    standardNormalAverage q = gaussianReal 0 (q : ℝ≥0)⁻¹ := by
  have hqpos : 0 < (q : ℝ) := by exact_mod_cast hq
  unfold standardNormalAverage
  rw [standardNormalSum_law, gaussianReal_map_const_mul, mul_zero]
  congr 1
  ext
  simp only [NNReal.coe_mul, NNReal.coe_mk, NNReal.coe_natCast, NNReal.coe_inv]
  field_simp [ne_of_gt hqpos]

/-- Appendix B's lower bound for the actual iid sample-average law. -/
theorem appendixB_sampleAverage_probability_lower (q : ℕ) (hq : 0 < q) :
    f2 (2 * (q : ℝ) + 1) ≤
      (standardNormalAverage q
        {x : ℝ | |x| ≤ ((2 * (q : ℝ) + 1) ^ 2)⁻¹}).toReal := by
  have hset : {x : ℝ | |x| ≤ ((2 * (q : ℝ) + 1) ^ 2)⁻¹} =
      Icc (-((2 * (q : ℝ) + 1) ^ 2)⁻¹) (((2 * (q : ℝ) + 1) ^ 2)⁻¹) := by
    ext x
    simp only [Set.mem_setOf_eq, Set.mem_Icc, abs_le]
  rw [standardNormalAverage_law q hq, hset]
  exact appendixB_probability_lower q hq

end

end BayesOptimal.Foundations.SmallBall

end

/-! ## Foundations.Rates -/
section

/-!
Corrected integer-budget asymptotic algebra for Appendix E.3 and the regret
step of Theorem 2. The hypotheses giving bounds on the actual EBI functions,
event probabilities, and simple regret are explicitly conditional. This file
does not claim those stochastic hypotheses have been established.
-/

open Filter Asymptotics

namespace BayesOptimal.Foundations.Rates

/-- Polynomial rate on the paper's natural-number budget domain. -/
noncomputable def invPower (k : ℕ) (T : ℕ) : ℝ := ((T : ℝ) ^ k)⁻¹

theorem invPower_nonneg (k T : ℕ) : 0 ≤ invPower k T := by
  exact inv_nonneg.mpr (pow_nonneg (Nat.cast_nonneg T) k)

theorem invPower_pos (k T : ℕ) (hT : 0 < T) : 0 < invPower k T := by
  exact inv_pos.mpr (pow_pos (Nat.cast_pos.mpr hT) k)

theorem invPower_antitone {small large T : ℕ} (h : small ≤ large) (hT : 1 ≤ T) :
    invPower large T ≤ invPower small T := by
  have hreal : (1 : ℝ) ≤ T := by exact_mod_cast hT
  have hpos : (0 : ℝ) < T := lt_of_lt_of_le zero_lt_one hreal
  exact (inv_le_inv₀ (pow_pos hpos large) (pow_pos hpos small)).mpr
    (pow_le_pow_right₀ hreal h)

theorem invPower_product (p q T : ℕ) :
    invPower p T * invPower q T = invPower (p + q) T := by
  simp only [invPower]
  rw [← mul_inv, ← pow_add]

/-- Exponents add: 6+110=116, not 110. -/
theorem corrected_g1_g3_exponent (T : ℕ) :
    invPower 6 T * invPower 110 T = invPower 116 T := by
  exact invPower_product 6 110 T

/-- Exponents add: 8+110=118, not 110. -/
theorem corrected_g2_g3_exponent (T : ℕ) :
    invPower 8 T * invPower 110 T = invPower 118 T := by
  exact invPower_product 8 110 T

theorem product_lower_bound {p q T : ℕ} {c d x y : ℝ}
    (hc : 0 ≤ c) (hd : 0 ≤ d)
    (hx : c * invPower p T ≤ x) (hy : d * invPower q T ≤ y) :
    (c * d) * invPower (p + q) T ≤ x * y := by
  have hcP : 0 ≤ c * invPower p T := mul_nonneg hc (invPower_nonneg p T)
  have hdP : 0 ≤ d * invPower q T := mul_nonneg hd (invPower_nonneg q T)
  have h := mul_le_mul hx hy hdP (hcP.trans hx)
  calc
    (c * d) * invPower (p + q) T =
        (c * invPower p T) * (d * invPower q T) := by
      rw [← invPower_product]
      ring
    _ ≤ x * y := h

theorem eventual_product_lower_bound {p q : ℕ} {c d : ℝ} {f g : ℕ → ℝ}
    (hc : 0 ≤ c) (hd : 0 ≤ d)
    (hf : ∀ᶠ T in atTop, c * invPower p T ≤ f T)
    (hg : ∀ᶠ T in atTop, d * invPower q T ≤ g T) :
    ∀ᶠ T in atTop, (c * d) * invPower (p + q) T ≤ f T * g T := by
  filter_upwards [hf, hg] with T hT kT
  exact product_lower_bound hc hd hT kT

theorem inverse_power_littleO_real {small large : ℕ} (h : small < large) :
    (fun t : ℝ => (t ^ large)⁻¹) =o[atTop] (fun t : ℝ => (t ^ small)⁻¹) := by
  apply (Asymptotics.isLittleO_pow_pow_atTop_of_lt (𝕜 := ℝ) h).inv_rev
  filter_upwards [eventually_gt_atTop (0 : ℝ)] with t ht hz
  exact (pow_ne_zero small ht.ne' hz).elim

/-- Faster inverse powers are little-o of slower ones on integer budgets. -/
theorem inverse_power_littleO_nat {small large : ℕ} (h : small < large) :
    invPower large =o[atTop] invPower small := by
  exact (inverse_power_littleO_real h).comp_tendsto
    (tendsto_natCast_atTop_atTop : Tendsto (fun T : ℕ => (T : ℝ)) atTop atTop)

theorem inverse_power_not_bigOmega_nat {small large : ℕ} (h : small < large) :
    ¬ (invPower small =O[atTop] invPower large) := by
  apply (inverse_power_littleO_nat h).not_isBigO
  apply Filter.Eventually.frequently
  filter_upwards [eventually_gt_atTop (0 : ℕ)] with T hT
  exact (invPower_pos large T hT).ne'

/-- Integer-budget countermodels also reject the original exponent 110 inference. -/
theorem rate116_not_rate110 : ¬ (invPower 110 =O[atTop] invPower 116) := by
  exact inverse_power_not_bigOmega_nat (by norm_num)

theorem rate118_not_rate110 : ¬ (invPower 110 =O[atTop] invPower 118) := by
  exact inverse_power_not_bigOmega_nat (by norm_num)

/-- A faster upper error rate is negligible relative to a slower benefit rate. -/
theorem error_littleO {a k : ℕ} {g0 : ℕ → ℝ}
    (hka : k < a) (h0 : g0 =O[atTop] invPower a) :
    g0 =o[atTop] invPower k := by
  exact h0.trans_isLittleO (inverse_power_littleO_nat hka)

/--
Subtracting m*g0 preserves half the lower-bound constant, provided the error
has strictly faster polynomial decay. This repairs both -2*g0 and -4*g0.
-/
theorem eventual_subtraction_lower_bound {a k : ℕ} {c m : ℝ}
    {g0 benefit : ℕ → ℝ} (hc : 0 < c) (hm : 0 < m)
    (hka : k < a) (h0 : g0 =O[atTop] invPower a)
    (hbenefit : ∀ᶠ T in atTop, c * invPower k T ≤ benefit T) :
    ∀ᶠ T in atTop, (c / 2) * invPower k T ≤ benefit T - m * g0 T := by
  have hsmall : ∀ᶠ T in atTop,
      ‖g0 T‖ ≤ (c / (2 * m)) * ‖invPower k T‖ :=
    (error_littleO hka h0).def
      (div_pos hc (mul_pos (by norm_num : (0 : ℝ) < 2) hm))
  filter_upwards [hbenefit, hsmall] with T hT hsmallT
  have hnorm : ‖invPower k T‖ = invPower k T :=
    Real.norm_of_nonneg (invPower_nonneg k T)
  rw [hnorm] at hsmallT
  have hratio : m * (c / (2 * m)) = c / 2 := by
    field_simp
  have herror : m * g0 T ≤ (c / 2) * invPower k T := by
    calc
      m * g0 T ≤ m * ‖g0 T‖ :=
        mul_le_mul_of_nonneg_left (le_abs_self (g0 T)) hm.le
      _ ≤ m * (c / (2 * m) * invPower k T) :=
        mul_le_mul_of_nonneg_left hsmallT hm.le
      _ = (c / 2) * invPower k T := by rw [← mul_assoc, hratio]
  linarith

theorem eventual_subtraction_positive {a k : ℕ} {c m : ℝ}
    {g0 benefit : ℕ → ℝ} (hc : 0 < c) (hm : 0 < m)
    (hka : k < a) (h0 : g0 =O[atTop] invPower a)
    (hbenefit : ∀ᶠ T in atTop, c * invPower k T ≤ benefit T) :
    ∀ᶠ T in atTop, 0 < benefit T - m * g0 T := by
  filter_upwards [eventual_subtraction_lower_bound hc hm hka h0 hbenefit,
    eventually_gt_atTop (0 : ℕ)] with T hT hpos
  exact (mul_pos (half_pos hc) (invPower_pos k T hpos)).trans_le hT

/-- A concrete positive eventual lower bound implies the usual Omega relation. -/
theorem omega_of_eventual_lower_bound {k : ℕ} {c : ℝ} {f : ℕ → ℝ}
    (hc : 0 < c) (hf : ∀ᶠ T in atTop, c * invPower k T ≤ f T) :
    invPower k =O[atTop] f := by
  apply IsBigOWith.isBigO (c := c⁻¹)
  apply IsBigOWith.of_bound
  filter_upwards [hf] with T hT
  rw [Real.norm_of_nonneg (invPower_nonneg k T)]
  have hfpos : 0 ≤ f T := (mul_nonneg hc.le (invPower_nonneg k T)).trans hT
  rw [Real.norm_of_nonneg hfpos]
  calc
    invPower k T = c⁻¹ * (c * invPower k T) := by
      rw [← mul_assoc, inv_mul_cancel₀ hc.ne', one_mul]
    _ ≤ c⁻¹ * f T := mul_le_mul_of_nonneg_left hT (inv_nonneg.mpr hc.le)

theorem subtraction_preserves_omega {a k : ℕ} {c m : ℝ}
    {g0 benefit : ℕ → ℝ} (hc : 0 < c) (hm : 0 < m)
    (hka : k < a) (h0 : g0 =O[atTop] invPower a)
    (hbenefit : ∀ᶠ T in atTop, c * invPower k T ≤ benefit T) :
    invPower k =O[atTop] (fun T => benefit T - m * g0 T) := by
  exact omega_of_eventual_lower_bound (half_pos hc)
    (eventual_subtraction_lower_bound hc hm hka h0 hbenefit)

/-- Explicit corrected first EBI comparison, conditional on its component bounds. -/
theorem corrected_g1_margin {a : ℕ} {c1 c3 : ℝ} {g0 g1 g3 : ℕ → ℝ}
    (hc1 : 0 < c1) (hc3 : 0 < c3) (ha : 116 < a)
    (h0 : g0 =O[atTop] invPower a)
    (h1 : ∀ᶠ T in atTop, c1 * invPower 6 T ≤ g1 T)
    (h3 : ∀ᶠ T in atTop, c3 * invPower 110 T ≤ g3 T) :
    ∀ᶠ T in atTop,
      ((c1 * c3) / 2) * invPower 116 T ≤ g1 T * g3 T - 2 * g0 T := by
  exact eventual_subtraction_lower_bound (mul_pos hc1 hc3) (by norm_num) ha h0
    (eventual_product_lower_bound hc1.le hc3.le h1 h3)

/-- Explicit corrected second EBI comparison, conditional on its component bounds. -/
theorem corrected_g2_margin {a : ℕ} {c2 c3 : ℝ} {g0 g2 g3 : ℕ → ℝ}
    (hc2 : 0 < c2) (hc3 : 0 < c3) (ha : 118 < a)
    (h0 : g0 =O[atTop] invPower a)
    (h2 : ∀ᶠ T in atTop, c2 * invPower 8 T ≤ g2 T)
    (h3 : ∀ᶠ T in atTop, c3 * invPower 110 T ≤ g3 T) :
    ∀ᶠ T in atTop,
      ((c2 * c3) / 2) * invPower 118 T ≤ g2 T * g3 T - 4 * g0 T := by
  exact eventual_subtraction_lower_bound (mul_pos hc2 hc3) (by norm_num) ha h0
    (eventual_product_lower_bound hc2.le hc3.le h2 h3)

/-- The first margin also admits the conservative exponent 118. -/
theorem corrected_g1_margin_conservative {a : ℕ} {c1 c3 : ℝ} {g0 g1 g3 : ℕ → ℝ}
    (hc1 : 0 < c1) (hc3 : 0 < c3) (ha : 116 < a)
    (h0 : g0 =O[atTop] invPower a)
    (h1 : ∀ᶠ T in atTop, c1 * invPower 6 T ≤ g1 T)
    (h3 : ∀ᶠ T in atTop, c3 * invPower 110 T ≤ g3 T) :
    ∀ᶠ T in atTop,
      ((c1 * c3) / 2) * invPower 118 T ≤ g1 T * g3 T - 2 * g0 T := by
  filter_upwards [corrected_g1_margin hc1 hc3 ha h0 h1 h3,
    eventually_ge_atTop (1 : ℕ)] with T hT hpos
  exact (mul_le_mul_of_nonneg_left (invPower_antitone (by norm_num) hpos)
    (half_pos (mul_pos hc1 hc3)).le).trans hT

/-- Both corrected differences are eventually strictly positive. -/
theorem corrected_margins_positive {a : ℕ} {c1 c2 c3 : ℝ}
    {g0 g1 g2 g3 : ℕ → ℝ}
    (hc1 : 0 < c1) (hc2 : 0 < c2) (hc3 : 0 < c3) (ha : 118 < a)
    (h0 : g0 =O[atTop] invPower a)
    (h1 : ∀ᶠ T in atTop, c1 * invPower 6 T ≤ g1 T)
    (h2 : ∀ᶠ T in atTop, c2 * invPower 8 T ≤ g2 T)
    (h3 : ∀ᶠ T in atTop, c3 * invPower 110 T ≤ g3 T) :
    ∀ᶠ T in atTop, 0 < g1 T * g3 T - 2 * g0 T ∧
      0 < g2 T * g3 T - 4 * g0 T := by
  have h116 : 116 < a := by omega
  filter_upwards [eventual_subtraction_positive (mul_pos hc1 hc3)
      (by norm_num : (0 : ℝ) < 2) h116 h0
      (eventual_product_lower_bound hc1.le hc3.le h1 h3),
    eventual_subtraction_positive (mul_pos hc2 hc3)
      (by norm_num : (0 : ℝ) < 4) ha h0
      (eventual_product_lower_bound hc2.le hc3.le h2 h3)] with T hleft hright
  exact ⟨hleft, hright⟩

/-- Conditional transfer from the margins to the actual EBI comparisons. -/
theorem corrected_EBI_comparisons {a : ℕ} {c1 c2 c3 : ℝ}
    {g0 g1 g2 g3 leftComparison rightComparison : ℕ → ℝ}
    (hc1 : 0 < c1) (hc2 : 0 < c2) (hc3 : 0 < c3) (ha : 118 < a)
    (h0 : g0 =O[atTop] invPower a)
    (h1 : ∀ᶠ T in atTop, c1 * invPower 6 T ≤ g1 T)
    (h2 : ∀ᶠ T in atTop, c2 * invPower 8 T ≤ g2 T)
    (h3 : ∀ᶠ T in atTop, c3 * invPower 110 T ≤ g3 T)
    (hleft : ∀ᶠ T in atTop, g1 T * g3 T - 2 * g0 T ≤ leftComparison T)
    (hright : ∀ᶠ T in atTop, g2 T * g3 T - 4 * g0 T ≤ rightComparison T) :
    ∀ᶠ T in atTop, 0 < leftComparison T ∧ 0 < rightComparison T := by
  filter_upwards [corrected_margins_positive hc1 hc2 hc3 ha h0 h1 h2 h3,
    hleft, hright] with T hT hl hr
  exact ⟨hT.1.trans_le hl, hT.2.trans_le hr⟩

/-- Choosing CU=30 leaves the original exponent expression above 118. -/
theorem concrete_CU_rate : (118 : ℝ) < ((30 : ℝ) - 6) ^ 2 / 4 := by
  norm_num

theorem concrete_CU_exponent : ((30 : ℝ) - 6) ^ 2 / 4 = (144 : ℝ) := by
  norm_num

theorem concrete_CU_nat_rate : (118 : ℕ) < 144 := by
  norm_num

/-- The replacement nonterminal probability exponent 206 gives margin 212. -/
theorem repaired_g1_g3_exponent (T : ℕ) :
    invPower 6 T * invPower 206 T = invPower 212 T := by
  exact invPower_product 6 206 T

theorem repaired_g2_g3_exponent (T : ℕ) :
    invPower 8 T * invPower 206 T = invPower 214 T := by
  exact invPower_product 8 206 T

/-- CU=40 accommodates both margins for the replacement probability bound. -/
theorem repaired_CU_exponent : ((40 : ℝ) - 6) ^ 2 / 4 = (289 : ℝ) := by
  norm_num

theorem repaired_CU_nat_rate : (214 : ℕ) < 289 := by
  norm_num

theorem repaired_g1_margin {a : ℕ} {c1 c3 : ℝ} {g0 g1 g3 : ℕ → ℝ}
    (hc1 : 0 < c1) (hc3 : 0 < c3) (ha : 212 < a)
    (h0 : g0 =O[atTop] invPower a)
    (h1 : ∀ᶠ T in atTop, c1 * invPower 6 T ≤ g1 T)
    (h3 : ∀ᶠ T in atTop, c3 * invPower 206 T ≤ g3 T) :
    ∀ᶠ T in atTop,
      ((c1 * c3) / 2) * invPower 212 T ≤ g1 T * g3 T - 2 * g0 T := by
  exact eventual_subtraction_lower_bound (mul_pos hc1 hc3) (by norm_num) ha h0
    (eventual_product_lower_bound hc1.le hc3.le h1 h3)

theorem repaired_g2_margin {a : ℕ} {c2 c3 : ℝ} {g0 g2 g3 : ℕ → ℝ}
    (hc2 : 0 < c2) (hc3 : 0 < c3) (ha : 214 < a)
    (h0 : g0 =O[atTop] invPower a)
    (h2 : ∀ᶠ T in atTop, c2 * invPower 8 T ≤ g2 T)
    (h3 : ∀ᶠ T in atTop, c3 * invPower 206 T ≤ g3 T) :
    ∀ᶠ T in atTop,
      ((c2 * c3) / 2) * invPower 214 T ≤ g2 T * g3 T - 4 * g0 T := by
  exact eventual_subtraction_lower_bound (mul_pos hc2 hc3) (by norm_num) ha h0
    (eventual_product_lower_bound hc2.le hc3.le h2 h3)

theorem repaired_margins_positive {a : ℕ} {c1 c2 c3 : ℝ}
    {g0 g1 g2 g3 : ℕ → ℝ}
    (hc1 : 0 < c1) (hc2 : 0 < c2) (hc3 : 0 < c3) (ha : 214 < a)
    (h0 : g0 =O[atTop] invPower a)
    (h1 : ∀ᶠ T in atTop, c1 * invPower 6 T ≤ g1 T)
    (h2 : ∀ᶠ T in atTop, c2 * invPower 8 T ≤ g2 T)
    (h3 : ∀ᶠ T in atTop, c3 * invPower 206 T ≤ g3 T) :
    ∀ᶠ T in atTop, 0 < g1 T * g3 T - 2 * g0 T ∧
      0 < g2 T * g3 T - 4 * g0 T := by
  have h212 : 212 < a := by omega
  filter_upwards [eventual_subtraction_positive (mul_pos hc1 hc3)
      (by norm_num : (0 : ℝ) < 2) h212 h0
      (eventual_product_lower_bound hc1.le hc3.le h1 h3),
    eventual_subtraction_positive (mul_pos hc2 hc3)
      (by norm_num : (0 : ℝ) < 4) ha h0
      (eventual_product_lower_bound hc2.le hc3.le h2 h3)] with T hleft hright
  exact ⟨hleft, hright⟩

/-- Simple regret retains the positive reward gap multiplying error probability. -/
theorem corrected_regret_lower_bound {gap probability eventProb regret : ℝ}
    (hgap : 0 ≤ gap) (hregret : gap * probability ≤ regret)
    (hevent : eventProb ≤ probability) : gap * eventProb ≤ regret := by
  exact (mul_le_mul_of_nonneg_left hevent hgap).trans hregret

theorem eventual_regret_rate {k : ℕ} {gap c : ℝ}
    {probability eventProb regret : ℕ → ℝ}
    (hgap : 0 < gap)
    (hregret : ∀ᶠ T in atTop, gap * probability T ≤ regret T)
    (hevent : ∀ᶠ T in atTop, eventProb T ≤ probability T)
    (hrate : ∀ᶠ T in atTop, c * invPower k T ≤ eventProb T) :
    ∀ᶠ T in atTop, (gap * c) * invPower k T ≤ regret T := by
  filter_upwards [hregret, hevent, hrate] with T hr he hp
  calc
    (gap * c) * invPower k T = gap * (c * invPower k T) := mul_assoc _ _ _
    _ ≤ gap * eventProb T := mul_le_mul_of_nonneg_left hp hgap.le
    _ ≤ regret T := corrected_regret_lower_bound hgap.le hr he

theorem regret_omega {k : ℕ} {gap c : ℝ}
    {probability eventProb regret : ℕ → ℝ}
    (hgap : 0 < gap) (hc : 0 < c)
    (hregret : ∀ᶠ T in atTop, gap * probability T ≤ regret T)
    (hevent : ∀ᶠ T in atTop, eventProb T ≤ probability T)
    (hrate : ∀ᶠ T in atTop, c * invPower k T ≤ eventProb T) :
    invPower k =O[atTop] regret := by
  exact omega_of_eventual_lower_bound (mul_pos hgap hc)
    (eventual_regret_rate hgap hregret hevent hrate)

section ExpectedRegret

open MeasureTheory

variable {Ω : Type*} [MeasurableSpace Ω]

/-- Expected loss when every incorrect recommendation incurs the same gap. -/
noncomputable def fixedGapRegret (μ : Measure Ω) (wrong : Set Ω) (gap : ℝ) : ℝ :=
  ∫ outcome, wrong.indicator (fun _ => gap) outcome ∂μ

/-- The expectation itself has the factor gap, using the actual Bochner integral. -/
theorem fixedGapRegret_eq (μ : Measure Ω) {wrong : Set Ω}
    (hwrong : MeasurableSet wrong) (gap : ℝ) :
    fixedGapRegret μ wrong gap = gap * μ.real wrong := by
  rw [fixedGapRegret, integral_indicator_const gap hwrong, smul_eq_mul, mul_comm]

/-- An error-forcing event gives a gap-scaled regret lower bound. -/
theorem fixedGapRegret_event_lower_bound (μ : Measure Ω) [IsProbabilityMeasure μ]
    {wrong event : Set Ω} (hwrong : MeasurableSet wrong)
    (hevent : event ⊆ wrong) {gap : ℝ} (hgap : 0 ≤ gap) :
    gap * μ.real event ≤ fixedGapRegret μ wrong gap := by
  rw [fixedGapRegret_eq μ hwrong gap]
  exact mul_le_mul_of_nonneg_left (measureReal_mono hevent) hgap

end ExpectedRegret

end BayesOptimal.Foundations.Rates

end

/-! ## Foundations.PredictiveBound -/
section

/-!
A quantitative replacement for the nonterminal Gaussian probability estimate
in Lemma 17. All probabilities use the actual Gaussian measure. The bound on
the predictive mean is an explicit hypothesis; it is not a custom axiom.
The zero-variance terminal state is deliberately outside this theorem.
-/

open MeasureTheory ProbabilityTheory Set
open Filter Asymptotics
open scoped MeasureTheory NNReal ENNReal

namespace BayesOptimal.Foundations.PredictiveBound

noncomputable section

def lowerConstant : ℝ := Real.exp (-4) * (Real.sqrt (4 * Real.pi))⁻¹

theorem lowerConstant_pos : 0 < lowerConstant := by
  unfold lowerConstant
  exact mul_pos (Real.exp_pos _) (inv_pos.mpr
    (Real.sqrt_pos.mpr (mul_pos (by norm_num) Real.pi_pos)))

theorem exp_neg_nat_log (D : ℕ) {t : ℝ} (ht : 0 < t) :
    Real.exp (-(D : ℝ) * Real.log t) = (t ^ D)⁻¹ := by
  rw [show -(D : ℝ) * Real.log t = -((D : ℝ) * Real.log t) by ring,
    Real.exp_neg, Real.exp_nat_mul, Real.exp_log ht]

theorem gaussianPDF_interval_lower (D : ℕ) {t δ x : ℝ} {v : ℝ≥0}
    (ht : 1 ≤ t) (hv : 0 < v) (hvupper : (v : ℝ) ≤ 2)
    (hvlower : (t ^ 2)⁻¹ ≤ (v : ℝ))
    (hδ : δ ^ 2 ≤ (D : ℝ) * Real.log t * (v : ℝ))
    (hx : x ∈ Icc ((t ^ 2)⁻¹) (2 * (t ^ 2)⁻¹)) :
    lowerConstant * (t ^ D)⁻¹ ≤ gaussianPDFReal δ v x := by
  have htpos : 0 < t := lt_of_lt_of_le zero_lt_one ht
  have hvpos : 0 < (v : ℝ) := hv
  have hqnonneg : 0 ≤ (t ^ 2)⁻¹ := inv_nonneg.mpr (sq_nonneg t)
  have hqle : (t ^ 2)⁻¹ ≤ 1 := by
    exact inv_le_one_of_one_le₀ (one_le_pow₀ ht)
  have hxnonneg : 0 ≤ x := hqnonneg.trans hx.1
  have hxx : x ^ 2 ≤ 4 * (v : ℝ) := by
    have hqq : ((t ^ 2)⁻¹) ^ 2 ≤ (t ^ 2)⁻¹ := by nlinarith
    have hsq : x ^ 2 ≤ (2 * (t ^ 2)⁻¹) ^ 2 :=
      (sq_le_sq₀ hxnonneg (by positivity)).mpr hx.2
    nlinarith
  have hquad : (x - δ) ^ 2 ≤
      ((D : ℝ) * Real.log t + 4) * (2 * (v : ℝ)) := by
    nlinarith [sq_nonneg (x + δ)]
  have hquot : (x - δ) ^ 2 / (2 * (v : ℝ)) ≤ (D : ℝ) * Real.log t + 4 :=
    (div_le_iff₀ (mul_pos (by norm_num) hvpos)).mpr hquad
  have hexp : Real.exp (-(D : ℝ) * Real.log t - 4) ≤
      Real.exp (-(x - δ) ^ 2 / (2 * (v : ℝ))) := by
    apply Real.exp_le_exp.mpr
    rw [neg_div]
    linarith
  have hsqrtpos : 0 < Real.sqrt (2 * Real.pi * (v : ℝ)) := by
    apply Real.sqrt_pos.mpr
    positivity
  have hsqrt4pos : 0 < Real.sqrt (4 * Real.pi) := by
    apply Real.sqrt_pos.mpr
    positivity
  have hnorm : (Real.sqrt (4 * Real.pi))⁻¹ ≤
      (Real.sqrt (2 * Real.pi * (v : ℝ)))⁻¹ := by
    apply (inv_le_inv₀ hsqrt4pos hsqrtpos).mpr
    apply Real.sqrt_le_sqrt
    nlinarith [Real.pi_pos]
  have hexpeq : Real.exp (-(D : ℝ) * Real.log t - 4) =
      Real.exp (-4) * (t ^ D)⁻¹ := by
    rw [sub_eq_add_neg, Real.exp_add, exp_neg_nat_log D htpos, mul_comm]
  calc
    lowerConstant * (t ^ D)⁻¹ =
        (Real.sqrt (4 * Real.pi))⁻¹ * Real.exp (-(D : ℝ) * Real.log t - 4) := by
      rw [hexpeq, lowerConstant]
      ring
    _ ≤ (Real.sqrt (2 * Real.pi * (v : ℝ)))⁻¹ *
        Real.exp (-(x - δ) ^ 2 / (2 * (v : ℝ))) :=
      mul_le_mul hnorm hexp (Real.exp_pos _).le (inv_nonneg.mpr hsqrtpos.le)
    _ = gaussianPDFReal δ v x := rfl

theorem gaussian_interval_probability_lower_real (D : ℕ) {t δ : ℝ} {v : ℝ≥0}
    (ht : 1 ≤ t) (hv : 0 < v) (hvupper : (v : ℝ) ≤ 2)
    (hvlower : (t ^ 2)⁻¹ ≤ (v : ℝ))
    (hδ : δ ^ 2 ≤ (D : ℝ) * Real.log t * (v : ℝ)) :
    lowerConstant * (t ^ (D + 2))⁻¹ ≤
      (gaussianReal δ v (Icc ((t ^ 2)⁻¹) (2 * (t ^ 2)⁻¹))).toReal := by
  have hqnonneg : 0 ≤ (t ^ 2)⁻¹ := inv_nonneg.mpr (sq_nonneg t)
  have hmass :
      (gaussianReal δ v (Icc ((t ^ 2)⁻¹) (2 * (t ^ 2)⁻¹))).toReal =
        ∫ x in Icc ((t ^ 2)⁻¹) (2 * (t ^ 2)⁻¹), gaussianPDFReal δ v x := by
    rw [gaussianReal_apply_eq_integral δ (ne_of_gt hv), ENNReal.toReal_ofReal]
    exact integral_nonneg (gaussianPDFReal_nonneg δ v)
  have hmono :
      (∫ _ in Icc ((t ^ 2)⁻¹) (2 * (t ^ 2)⁻¹), lowerConstant * (t ^ D)⁻¹) ≤
      ∫ x in Icc ((t ^ 2)⁻¹) (2 * (t ^ 2)⁻¹), gaussianPDFReal δ v x := by
    apply setIntegral_mono_on
      (integrableOn_const isCompact_Icc.measure_ne_top)
      (integrable_gaussianPDFReal δ v).integrableOn measurableSet_Icc
    intro x hx
    exact gaussianPDF_interval_lower D ht hv hvupper hvlower hδ hx
  have hconst :
      (∫ _ in Icc ((t ^ 2)⁻¹) (2 * (t ^ 2)⁻¹), lowerConstant * (t ^ D)⁻¹) =
      lowerConstant * (t ^ (D + 2))⁻¹ := by
    rw [setIntegral_const, smul_eq_mul, measureReal_def, Real.volume_Icc,
      ENNReal.toReal_ofReal (by linarith : 0 ≤ 2 * (t ^ 2)⁻¹ - (t ^ 2)⁻¹)]
    rw [pow_add, mul_inv]
    ring
  rw [← hconst, hmass]
  exact hmono

/-- Corrected nonterminal small-gap probability on natural-number budgets. -/
theorem gaussian_interval_probability_lower_nat (D T : ℕ) {δ : ℝ} {v : ℝ≥0}
    (hT : 5 ≤ T) (hv : 0 < v) (hvupper : (v : ℝ) ≤ 2)
    (hvlower : BayesOptimal.Foundations.Rates.invPower 2 T ≤ (v : ℝ))
    (hδ : δ ^ 2 ≤ (D : ℝ) * Real.log (T : ℝ) * (v : ℝ)) :
    lowerConstant * BayesOptimal.Foundations.Rates.invPower (D + 2) T ≤
      (gaussianReal δ v
        (Icc (BayesOptimal.Foundations.Rates.invPower 2 T) (2 * BayesOptimal.Foundations.Rates.invPower 2 T))).toReal := by
  have hTreal : (1 : ℝ) ≤ T := by exact_mod_cast (show 1 ≤ T by omega)
  exact gaussian_interval_probability_lower_real D hTreal hv hvupper hvlower hδ

/-- The quantitative exponent used after bounding the predictive drift by 204. -/
theorem gaussian_interval_probability_drift204 (T : ℕ) {δ : ℝ} {v : ℝ≥0}
    (hT : 5 ≤ T) (hv : 0 < v) (hvupper : (v : ℝ) ≤ 2)
    (hvlower : BayesOptimal.Foundations.Rates.invPower 2 T ≤ (v : ℝ))
    (hδ : δ ^ 2 ≤ 204 * Real.log (T : ℝ) * (v : ℝ)) :
    lowerConstant * BayesOptimal.Foundations.Rates.invPower 206 T ≤
      (gaussianReal δ v
        (Icc (BayesOptimal.Foundations.Rates.invPower 2 T) (2 * BayesOptimal.Foundations.Rates.invPower 2 T))).toReal := by
  exact gaussian_interval_probability_lower_nat 204 T hT hv hvupper hvlower hδ

/-- The same probability bound in the paper's integer-budget Omega notation. -/
theorem gaussian_interval_probability_omega (D : ℕ)
    {δ : ℕ → ℝ} {v : ℕ → ℝ≥0}
    (hv : ∀ᶠ T in atTop, 0 < v T)
    (hvupper : ∀ᶠ T in atTop, (v T : ℝ) ≤ 2)
    (hvlower : ∀ᶠ T in atTop, BayesOptimal.Foundations.Rates.invPower 2 T ≤ (v T : ℝ))
    (hδ : ∀ᶠ T in atTop,
      (δ T) ^ 2 ≤ (D : ℝ) * Real.log (T : ℝ) * (v T : ℝ)) :
    BayesOptimal.Foundations.Rates.invPower (D + 2) =O[atTop]
      (fun T => (gaussianReal (δ T) (v T)
        (Icc (BayesOptimal.Foundations.Rates.invPower 2 T) (2 * BayesOptimal.Foundations.Rates.invPower 2 T))).toReal) := by
  apply BayesOptimal.Foundations.Rates.omega_of_eventual_lower_bound lowerConstant_pos
  filter_upwards [eventually_ge_atTop (5 : ℕ), hv, hvupper, hvlower, hδ]
    with T hT hvT hupperT hlowerT hδT
  exact gaussian_interval_probability_lower_nat D T hT hvT hupperT hlowerT hδT

end

end BayesOptimal.Foundations.PredictiveBound

end

/-! ## Foundations.BadEvent -/
section

/-!
Frequentist sample arrays for means (0,0,1), and probabilities of the bad
empirical-mean event. The raw observations are independent unit-variance
Gaussian coordinates, rather than assumed posterior innovations.
-/

open MeasureTheory ProbabilityTheory Set
open scoped MeasureTheory NNReal ENNReal BigOperators

namespace BayesOptimal.Foundations.BadEvent

noncomputable section

def arrayLaw (q : ℕ) : Measure (Fin q → ℝ) :=
  Measure.pi (fun _ : Fin q => gaussianReal 0 1)

instance arrayLaw_probability (q : ℕ) : IsProbabilityMeasure (arrayLaw q) := by
  unfold arrayLaw
  infer_instance

def weightVariance (a : ℝ) : ℝ≥0 := ⟨a ^ 2, sq_nonneg a⟩

def weightedSum {q : ℕ} (a : Fin q → ℝ) (ω : Fin q → ℝ) : ℝ := ∑ i, a i * ω i

theorem weighted_coordinates_independent {q : ℕ} (a : Fin q → ℝ) :
    iIndepFun (fun i (ω : Fin q → ℝ) => a i * ω i) (arrayLaw q) := by
  exact iIndepFun_pi (fun _ => by fun_prop)

theorem weighted_coordinate_law {q : ℕ} (a : Fin q → ℝ) (i : Fin q) :
    HasLaw (fun ω : Fin q → ℝ => a i * ω i) (gaussianReal 0 (weightVariance (a i))) (arrayLaw q) := by
  have heval : HasLaw (Function.eval i) (gaussianReal 0 1) (arrayLaw q) :=
    (measurePreserving_eval (fun _ : Fin q => gaussianReal 0 1) i).hasLaw
  have hscale : HasLaw (fun x : ℝ => a i * x) (gaussianReal 0 (weightVariance (a i)))
      (gaussianReal 0 1) := by
    constructor
    · exact (by fun_prop : AEMeasurable (fun x : ℝ => a i * x) (gaussianReal 0 1))
    · rw [gaussianReal_map_const_mul, mul_zero, mul_one]
      rfl
  exact hscale.fun_comp heval

theorem weighted_finset_sum_law {q : ℕ} (a : Fin q → ℝ) (s : Finset (Fin q)) :
    HasLaw (fun ω : Fin q → ℝ => ∑ i ∈ s, a i * ω i)
      (gaussianReal 0 (∑ i ∈ s, weightVariance (a i))) (arrayLaw q) := by
  classical
  have hind := weighted_coordinates_independent a
  induction s using Finset.induction_on with
  | empty =>
      constructor
      · simp only [Finset.sum_empty]
        exact aemeasurable_const
      · simp [gaussianReal_zero_var]
  | insert i s hi ih =>
      have hInd := hind.indepFun_finset_sum_of_notMem (fun _ => by fun_prop) hi
      have hInd' : IndepFun (fun ω : Fin q → ℝ => a i * ω i)
          (fun ω : Fin q → ℝ => ∑ j ∈ s, a j * ω j) (arrayLaw q) := by
        simpa only [Finset.sum_fn] using hInd.symm
      have hsum := hInd'.hasLaw_fun_add (weighted_coordinate_law a i) ih
      rw [gaussianReal_conv_gaussianReal, zero_add] at hsum
      simpa only [Finset.sum_insert hi] using hsum

theorem weightedSum_law {q : ℕ} (a : Fin q → ℝ) :
    HasLaw (weightedSum a) (gaussianReal 0 (∑ i, weightVariance (a i))) (arrayLaw q) := by
  exact weighted_finset_sum_law a Finset.univ

def meanCoefficient {q : ℕ} (n : ℕ) (i : Fin q) : ℝ :=
  if (i : ℕ) < n then (n : ℝ)⁻¹ else 0

def sampleMean {q : ℕ} (n : ℕ) (ω : Fin q → ℝ) : ℝ := weightedSum (meanCoefficient n) ω

theorem fin_sum_if_lt (n q : ℕ) (hnq : n ≤ q) (a b : ℝ) :
    (∑ i : Fin q, if (i : ℕ) < n then a else b) = (n : ℝ) * a + ((q - n : ℕ) : ℝ) * b := by
  classical
  have hc : (Finset.univ.filter (fun i : Fin q => (i : ℕ) < n)).card = n := by
    simpa only [Fintype.card_subtype] using Fintype.card_fin_lt_of_le hnq
  have hcomp : (Finset.univ.filter (fun i : Fin q => ¬ ((i : ℕ) < n))).card = q - n := by
    have h := Finset.filter_card_add_filter_neg_card_eq_card
      (s := (Finset.univ : Finset (Fin q))) (fun i => (i : ℕ) < n)
    rw [hc, Finset.card_univ, Fintype.card_fin] at h
    omega
  rw [Finset.sum_ite, Finset.sum_const, Finset.sum_const, hc, hcomp]
  simp only [nsmul_eq_mul]

theorem meanVariance_eq (n q : ℕ) (hn : 0 < n) (hnq : n ≤ q) :
    (∑ i : Fin q, weightVariance (meanCoefficient n i)) = (n : ℝ≥0)⁻¹ := by
  have hn0 : (n : ℝ) ≠ 0 := by exact_mod_cast Nat.ne_of_gt hn
  ext
  simp only [NNReal.coe_sum, weightVariance, NNReal.coe_mk, NNReal.coe_inv, NNReal.coe_natCast]
  have hpoint : ∀ i : Fin q, (meanCoefficient n i) ^ 2 =
      if (i : ℕ) < n then ((n : ℝ)⁻¹) ^ 2 else 0 := by
    intro i
    unfold meanCoefficient
    split_ifs <;> simp
  simp_rw [hpoint]
  rw [fin_sum_if_lt n q hnq]
  field_simp
  ring

theorem sampleMean_law (n q : ℕ) (hn : 0 < n) (hnq : n ≤ q) :
    HasLaw (sampleMean (q := q) n) (gaussianReal 0 (n : ℝ≥0)⁻¹) (arrayLaw q) := by
  have h := weightedSum_law (meanCoefficient (q := q) n)
  rw [meanVariance_eq n q hn hnq] at h
  exact h

def driftCoefficient {q : ℕ} (n : ℕ) (i : Fin q) : ℝ := meanCoefficient n i - (q : ℝ)⁻¹

def driftVariance (n q : ℕ) : ℝ≥0 := ∑ i : Fin q, weightVariance (driftCoefficient n i)

theorem driftVariance_coe (n q : ℕ) (hn : 0 < n) (hnq : n ≤ q) :
    (driftVariance n q : ℝ) = (n : ℝ)⁻¹ - (q : ℝ)⁻¹ := by
  have hn0 : (n : ℝ) ≠ 0 := by exact_mod_cast Nat.ne_of_gt hn
  have hq0 : (q : ℝ) ≠ 0 := by exact_mod_cast (show q ≠ 0 by omega)
  unfold driftVariance
  simp only [NNReal.coe_sum, weightVariance, NNReal.coe_mk]
  have hpoint : ∀ i : Fin q, (driftCoefficient n i) ^ 2 =
      if (i : ℕ) < n then ((n : ℝ)⁻¹ - (q : ℝ)⁻¹) ^ 2 else ((q : ℝ)⁻¹) ^ 2 := by
    intro i
    unfold driftCoefficient meanCoefficient
    split_ifs <;> simp
  simp_rw [hpoint]
  rw [fin_sum_if_lt n q hnq, Nat.cast_sub hnq]
  field_simp
  ring

theorem sampleMean_difference_eq (n q : ℕ) (ω : Fin q → ℝ) :
    sampleMean n ω - sampleMean q ω = weightedSum (driftCoefficient n) ω := by
  unfold sampleMean weightedSum
  rw [← Finset.sum_sub_distrib]
  apply Finset.sum_congr rfl
  intro i _hi
  unfold driftCoefficient
  simp only [meanCoefficient, if_pos i.isLt]
  ring

theorem sampleMean_difference_law (n q : ℕ) :
    HasLaw (fun ω : Fin q → ℝ => sampleMean n ω - sampleMean q ω)
      (gaussianReal 0 (driftVariance n q)) (arrayLaw q) := by
  simpa only [sampleMean_difference_eq] using weightedSum_law (driftCoefficient (q := q) n)

theorem reciprocal_square_ge_decrement (n : ℕ) (hn : 0 < n) :
    (n : ℝ)⁻¹ - ((n : ℝ) + 1)⁻¹ ≤ 1 / (n : ℝ) ^ 2 := by
  have hnr : 0 < (n : ℝ) := by exact_mod_cast hn
  rw [← one_div (n : ℝ), ← one_div ((n : ℝ) + 1),
    Counts.varianceDecrement_identity n hn]
  unfold Counts.varianceDecrement
  apply (div_le_div_iff₀ (by positivity) (by positivity)).mpr
  nlinarith only [hnr]

theorem reciprocalSqSum_ge_variance (n q : ℕ) (hn : 0 < n) (hnq : n ≤ q) :
    (n : ℝ)⁻¹ - (q : ℝ)⁻¹ ≤ Drift.reciprocalSqSum n q := by
  induction q with
  | zero => omega
  | succ q ih =>
      by_cases hnq' : n ≤ q
      · unfold Drift.reciprocalSqSum
        rw [Finset.sum_Ico_succ_top hnq']
        have hprev := ih hnq'
        have hstep := reciprocal_square_ge_decrement q (by omega)
        unfold Drift.reciprocalSqSum at hprev
        push_cast
        linarith only [hprev, hstep]
      · have hEq : n = q + 1 := by omega
        subst n
        simp [Drift.reciprocalSqSum]

theorem gaussian_law_subgaussian {Ω : Type*} [MeasurableSpace Ω]
    {μ : Measure Ω} {X : Ω → ℝ} {v : ℝ≥0} (hLaw : HasLaw X (gaussianReal 0 v) μ) :
    HasSubgaussianMGF X v μ := by
  have hid : HasSubgaussianMGF (fun x : ℝ => x) v (gaussianReal 0 v) := by
    constructor
    · exact fun t => integrable_exp_mul_gaussianReal t
    · intro t
      simp [mgf_fun_id_gaussianReal]
  have hmap : HasSubgaussianMGF (fun x : ℝ => x) v (μ.map X) := by
    rw [hLaw.map_eq]
    exact hid
  have h := HasSubgaussianMGF.of_map (X := fun x : ℝ => x) (Y := X) hLaw.aemeasurable hmap
  simpa only [Function.comp_apply] using h

def driftThreshold (T n q : ℕ) : ℝ :=
  4 * Real.sqrt (Real.log (T : ℝ)) * Real.sqrt (Drift.reciprocalSqSum n q)

def driftFailure (T n q : ℕ) : Set (Fin q → ℝ) :=
  {ω | driftThreshold T n q < |sampleMean n ω - sampleMean q ω|}

theorem driftFailure_probability_le (T n q : ℕ) (hT : 5 ≤ T) (hn : 0 < n) (hnq : n ≤ q) :
    (arrayLaw q).real (driftFailure T n q) ≤ 2 * Rates.invPower 8 T := by
  by_cases hnqeq : n = q
  · subst n
    have hset : driftFailure T q q = ∅ := by
      ext ω
      simp [driftFailure, driftThreshold, Drift.reciprocalSqSum]
    rw [hset]
    simp only [measureReal_empty]
    exact mul_nonneg (by norm_num) (Rates.invPower_nonneg 8 T)
  have hnqlt : n < q := by omega
  have hnr : 0 < (n : ℝ) := by exact_mod_cast hn
  have hqr : 0 < (q : ℝ) := by exact_mod_cast (show 0 < q by omega)
  have hTr : 0 < (T : ℝ) := by exact_mod_cast (show 0 < T by omega)
  have hlog := Drift.log_horizon_ge_one T hT
  have hlog0 : 0 ≤ Real.log (T : ℝ) := by linarith only [hlog]
  have hvarEq := driftVariance_coe n q hn hnq
  have hv : 0 < driftVariance n q := by
    change 0 < (driftVariance n q : ℝ)
    rw [hvarEq]
    exact sub_pos.mpr ((inv_lt_inv₀ hqr hnr).mpr (by exact_mod_cast hnqlt))
  have hVarBound : (driftVariance n q : ℝ) ≤ Drift.reciprocalSqSum n q := by
    rw [hvarEq]
    exact reciprocalSqSum_ge_variance n q hn hnq
  have hthreshold0 : 0 ≤ driftThreshold T n q := by unfold driftThreshold; positivity
  have hthresholdsq : (driftThreshold T n q) ^ 2 =
      16 * Real.log (T : ℝ) * Drift.reciprocalSqSum n q := by
    unfold driftThreshold
    rw [mul_pow, mul_pow, Real.sq_sqrt hlog0,
      Real.sq_sqrt (Drift.reciprocalSqSum_nonnegative n q)]
    norm_num
  have hscaled := mul_le_mul_of_nonneg_left hVarBound hlog0
  have hquot : 8 * Real.log (T : ℝ) ≤ (driftThreshold T n q) ^ 2 / (2 * (driftVariance n q : ℝ)) := by
    apply (le_div_iff₀ (by positivity)).mpr
    rw [hthresholdsq]
    nlinarith only [hscaled]
  have hexp : Real.exp (-(driftThreshold T n q) ^ 2 / (2 * (driftVariance n q : ℝ))) ≤
      Rates.invPower 8 T := by
    unfold Rates.invPower
    rw [← PredictiveBound.exp_neg_nat_log 8 hTr]
    apply Real.exp_le_exp.mpr
    rw [neg_div]
    norm_num
    linarith only [hquot]
  have hsub := gaussian_law_subgaussian (sampleMean_difference_law n q)
  have hright := hsub.measure_ge_le hthreshold0
  have hleft := hsub.neg.measure_ge_le hthreshold0
  have hsubset : driftFailure T n q ⊆
      {ω | driftThreshold T n q ≤ sampleMean n ω - sampleMean q ω} ∪
        {ω | driftThreshold T n q ≤ -(sampleMean n ω - sampleMean q ω)} := by
    intro ω hω
    change driftThreshold T n q < |sampleMean n ω - sampleMean q ω| at hω
    rw [lt_abs] at hω
    rcases hω with hω | hω
    · exact Or.inl (le_of_lt hω)
    · exact Or.inr (le_of_lt hω)
  have hmono := measureReal_mono (μ := arrayLaw q) hsubset
  have hunion := measureReal_union_le (μ := arrayLaw q)
    {ω | driftThreshold T n q ≤ sampleMean n ω - sampleMean q ω}
    {ω | driftThreshold T n q ≤ -(sampleMean n ω - sampleMean q ω)}
  simp only [Pi.neg_apply] at hleft
  linarith only [hmono, hunion, hright, hleft, hexp]

def goodDriftSet (T q : ℕ) : Set (Fin q → ℝ) :=
  {ω | ∀ n : ℕ, 1 ≤ n → n ≤ q →
    |sampleMean n ω - sampleMean q ω| ≤ driftThreshold T n q}

theorem goodDrift_compl_probability_le (T q : ℕ) (hT : 5 ≤ T) (hqT : q ≤ T) :
    (arrayLaw q).real (goodDriftSet T q)ᶜ ≤ 2 * Rates.invPower 7 T := by
  have hsubset : (goodDriftSet T q)ᶜ ⊆ ⋃ i : Fin q, driftFailure T ((i : ℕ) + 1) q := by
    intro ω hω
    simp only [goodDriftSet, Set.mem_compl_iff, Set.mem_setOf_eq] at hω
    push_neg at hω
    rcases hω with ⟨n, hn, hnq, hf⟩
    let i : Fin q := ⟨n - 1, by omega⟩
    apply Set.mem_iUnion.mpr
    refine ⟨i, ?_⟩
    have hi : (i : ℕ) + 1 = n := by dsimp [i]; omega
    rw [hi]
    exact hf
  have hmono := measureReal_mono (μ := arrayLaw q) hsubset
  have hunion := measureReal_iUnion_fintype_le (μ := arrayLaw q)
    (fun i : Fin q => driftFailure T ((i : ℕ) + 1) q)
  have hsum : (∑ i : Fin q, (arrayLaw q).real (driftFailure T ((i : ℕ) + 1) q)) ≤
      (q : ℝ) * (2 * Rates.invPower 8 T) := by
    calc
      _ ≤ ∑ _i : Fin q, 2 * Rates.invPower 8 T := by
        apply Finset.sum_le_sum
        intro i _hi
        exact driftFailure_probability_le T _ q hT (by omega) (by have hi := i.isLt; omega)
      _ = _ := by simp
  have hqTr : (q : ℝ) ≤ (T : ℝ) := by exact_mod_cast hqT
  have hscale := mul_le_mul_of_nonneg_right hqTr
    (mul_nonneg (by norm_num : (0 : ℝ) ≤ 2) (Rates.invPower_nonneg 8 T))
  have hrate : (T : ℝ) * (2 * Rates.invPower 8 T) = 2 * Rates.invPower 7 T := by
    have hT0 : (T : ℝ) ≠ 0 := by exact_mod_cast (show T ≠ 0 by omega)
    unfold Rates.invPower
    field_simp
  rw [hrate] at hscale
  linarith only [hmono, hunion, hsum, hscale]

def goodMeanSet (T q : ℕ) : Set (Fin q → ℝ) :=
  {ω | |sampleMean q ω| ≤ Rates.invPower 2 T}

theorem goodMeanSet_measurable (T q : ℕ) : MeasurableSet (goodMeanSet T q) := by
  unfold goodMeanSet
  apply measurableSet_le
  · unfold sampleMean weightedSum
    fun_prop
  · exact measurable_const

theorem goodDriftSet_measurable (T q : ℕ) : MeasurableSet (goodDriftSet T q) := by
  unfold goodDriftSet
  simp only [Set.setOf_forall]
  apply MeasurableSet.iInter
  intro n
  apply MeasurableSet.iInter
  intro _hn
  apply MeasurableSet.iInter
  intro _hnq
  apply measurableSet_le
  · unfold sampleMean weightedSum
    fun_prop
  · exact measurable_const

theorem f2_polynomial_lower (T : ℕ) (hT : 1 ≤ T) :
    (1 / 4 : ℝ) * Rates.invPower 2 T ≤ SmallBall.f2 (T : ℝ) := by
  have hTr : 1 ≤ (T : ℝ) := by exact_mod_cast hT
  have htpos : 0 < (T : ℝ) := by linarith only [hTr]
  have hpiBound : Real.pi ≤ 4 * (T : ℝ) := by linarith only [Real.pi_le_four, hTr]
  have hmul := mul_le_mul_of_nonneg_right hpiBound (by positivity : 0 ≤ (T : ℝ) ^ 3)
  have hsq : ((1 / 2 : ℝ) * Rates.invPower 2 T) ^ 2 ≤ 1 / (Real.pi * (T : ℝ) ^ 3) := by
    calc
      _ = 1 / (4 * (T : ℝ) ^ 4) := by
        unfold Rates.invPower
        field_simp
        ring
      _ ≤ _ := by
        apply (div_le_div_iff₀ (by positivity) (by positivity)).mpr
        nlinarith only [hmul]
  have hsqrt := Real.le_sqrt_of_sq_le hsq
  unfold SmallBall.f2
  nlinarith only [hsqrt]

theorem goodMean_probability_lower (T q : ℕ) (hT : T = 2 * q + 1) (hq : 0 < q) :
    (1 / 4 : ℝ) * Rates.invPower 2 T ≤ (arrayLaw q).real (goodMeanSet T q) := by
  have hLaw := sampleMean_law q q hq le_rfl
  have hmass : (arrayLaw q).real (goodMeanSet T q) =
      (gaussianReal 0 (q : ℝ≥0)⁻¹ (Icc (-Rates.invPower 2 T) (Rates.invPower 2 T))).toReal := by
    rw [← hLaw.map_eq, Measure.map_apply_of_aemeasurable hLaw.aemeasurable measurableSet_Icc]
    congr 1
    ext ω
    simp only [goodMeanSet, Set.mem_setOf_eq, Set.mem_preimage, Set.mem_Icc, abs_le]
  have h := SmallBall.appendixB_probability_lower q hq
  have hTr : (T : ℝ) = 2 * (q : ℝ) + 1 := by exact_mod_cast hT
  rw [← hTr] at h
  rw [hmass]
  exact (f2_polynomial_lower T (by omega)).trans h

theorem goodMean_probability_lower_general (T q : ℕ)
    (hT : 3 ≤ T) (hq : 0 < q) (hqT : q ≤ T) (hTq : T ≤ 3 * q) :
    (1 / 4 : ℝ) * Rates.invPower 2 T ≤ (arrayLaw q).real (goodMeanSet T q) := by
  have hLaw := sampleMean_law q q hq le_rfl
  have hmass : (arrayLaw q).real (goodMeanSet T q) =
      (gaussianReal 0 (q : ℝ≥0)⁻¹ (Icc (-Rates.invPower 2 T) (Rates.invPower 2 T))).toReal := by
    rw [← hLaw.map_eq, Measure.map_apply_of_aemeasurable hLaw.aemeasurable measurableSet_Icc]
    congr 1
    ext ω
    simp only [goodMeanSet, Set.mem_setOf_eq, Set.mem_preimage, Set.mem_Icc, abs_le]
  have hqr : 0 < (q : ℝ) := by exact_mod_cast hq
  have hTr : 0 < (T : ℝ) := by exact_mod_cast (show 0 < T by omega)
  have hqTr : (q : ℝ) ≤ (T : ℝ) := by exact_mod_cast hqT
  have hTqr : (T : ℝ) ≤ 3 * (q : ℝ) := by exact_mod_cast hTq
  have hvlower : (T : ℝ)⁻¹ ≤ (((q : ℝ≥0)⁻¹) : ℝ) := by
    simp only [NNReal.coe_natCast]
    exact (inv_le_inv₀ hTr hqr).mpr hqTr
  have hvupper : (((q : ℝ≥0)⁻¹) : ℝ) ≤ 3 / (T : ℝ) := by
    simp only [NNReal.coe_natCast]
    rw [inv_eq_one_div]
    apply (div_le_div_iff₀ hqr hTr).mpr
    simpa only [one_mul] using hTqr
  have h := SmallBall.gaussian_smallBall_probability_lower (by exact_mod_cast hT)
    (by positivity : 0 < (q : ℝ≥0)⁻¹) hvlower hvupper
  rw [hmass]
  exact (f2_polynomial_lower T (by omega)).trans h

theorem drift_error_smaller_than_mean_lower (T : ℕ) (hT : 5 ≤ T) :
    2 * Rates.invPower 7 T ≤ (1 / 8 : ℝ) * Rates.invPower 2 T := by
  have hTr : (5 : ℝ) ≤ T := by exact_mod_cast hT
  have htpos : 0 < (T : ℝ) := by linarith only [hTr]
  have hpow : (5 : ℝ) ^ 5 ≤ (T : ℝ) ^ 5 := pow_le_pow_left₀ (by norm_num) hTr 5
  have hInv : 2 * Rates.invPower 5 T ≤ 1 / 8 := by
    unfold Rates.invPower
    rw [← div_eq_mul_inv]
    apply (div_le_iff₀ (by positivity)).mpr
    norm_num at hpow
    linarith only [hpow]
  calc
    2 * Rates.invPower 7 T = (2 * Rates.invPower 5 T) * Rates.invPower 2 T := by
      rw [← Rates.invPower_product 5 2 T]
      ring
    _ ≤ (1 / 8 : ℝ) * Rates.invPower 2 T :=
      mul_le_mul_of_nonneg_right hInv (Rates.invPower_nonneg 2 T)

def goodArmSet (T q : ℕ) : Set (Fin q → ℝ) := goodMeanSet T q ∩ goodDriftSet T q

/-- Actual frequentist Y∩Z probability for one iid Gaussian arm. The Gaussian
drift estimate is proved above, rather than supplied as a comparison premise. -/
theorem goodArm_probability_lower (T q : ℕ) (hT : T = 2 * q + 1) (hq : 2 ≤ q) :
    (1 / 8 : ℝ) * Rates.invPower 2 T ≤ (arrayLaw q).real (goodArmSet T q) := by
  have hmean := goodMean_probability_lower T q hT (by omega)
  have hdrift := goodDrift_compl_probability_le T q (by omega) (by omega)
  have hsmall := drift_error_smaller_than_mean_lower T (by omega)
  have hdecomp := measureReal_inter_add_diff (μ := arrayLaw q)
    (s := goodMeanSet T q) (goodDriftSet_measurable T q)
  have hsubset : goodMeanSet T q \ goodDriftSet T q ⊆ (goodDriftSet T q)ᶜ := by
    exact fun _ h => h.2
  have hdiff := measureReal_mono (μ := arrayLaw q) hsubset
  unfold goodArmSet
  linarith only [hmean, hdrift, hsmall, hdecomp, hdiff]

theorem goodArm_probability_lower_general (T q : ℕ)
    (hT : 5 ≤ T) (hq : 0 < q) (hqT : q ≤ T) (hTq : T ≤ 3 * q) :
    (1 / 8 : ℝ) * Rates.invPower 2 T ≤ (arrayLaw q).real (goodArmSet T q) := by
  have hmean := goodMean_probability_lower_general T q (by omega) hq hqT hTq
  have hdrift := goodDrift_compl_probability_le T q hT hqT
  have hsmall := drift_error_smaller_than_mean_lower T hT
  have hdecomp := measureReal_inter_add_diff (μ := arrayLaw q)
    (s := goodMeanSet T q) (goodDriftSet_measurable T q)
  have hsubset : goodMeanSet T q \ goodDriftSet T q ⊆ (goodDriftSet T q)ᶜ := by
    exact fun _ h => h.2
  have hdiff := measureReal_mono (μ := arrayLaw q) hsubset
  unfold goodArmSet
  linarith only [hmean, hdrift, hsmall, hdecomp, hdiff]

def underestimationInterval (T : ℕ) : Set ℝ :=
  Icc (-40 * Real.sqrt (Real.log (T : ℝ)) - 1) (-40 * Real.sqrt (Real.log (T : ℝ)))

def underestimationConstant : ℝ := (Real.sqrt (2 * Real.pi))⁻¹

theorem underestimationConstant_positive : 0 < underestimationConstant := by
  unfold underestimationConstant
  positivity

theorem underestimationPDF_lower (T : ℕ) (hT : 5 ≤ T) (x : ℝ)
    (hx : x ∈ underestimationInterval T) :
    underestimationConstant * Rates.invPower 882 T ≤ gaussianPDFReal 1 1 x := by
  have htpos : 0 < (T : ℝ) := by exact_mod_cast (show 0 < T by omega)
  have hlog := Drift.log_horizon_ge_one T hT
  have hs0 := Real.sqrt_nonneg (Real.log (T : ℝ))
  have hs1 : 1 ≤ Real.sqrt (Real.log (T : ℝ)) := Real.one_le_sqrt.mpr hlog
  have hsq : (Real.sqrt (Real.log (T : ℝ))) ^ 2 = Real.log (T : ℝ) :=
    Real.sq_sqrt (by linarith only [hlog])
  have hdiff0 : x - 1 ≤ 0 := by linarith only [hx.2, hs0]
  have hdiff : |x - 1| ≤ 42 * Real.sqrt (Real.log (T : ℝ)) := by
    rw [abs_of_nonpos hdiff0]
    linarith only [hx.1, hs1]
  have hquad : (x - 1) ^ 2 ≤ 1764 * Real.log (T : ℝ) := by
    have h := (sq_le_sq₀ (abs_nonneg (x - 1)) (by positivity)).mpr hdiff
    rw [sq_abs] at h
    nlinarith only [h, hsq]
  have hexp : Rates.invPower 882 T ≤ Real.exp (-(x - 1) ^ 2 / 2) := by
    unfold Rates.invPower
    rw [← PredictiveBound.exp_neg_nat_log 882 htpos]
    apply Real.exp_le_exp.mpr
    norm_num
    nlinarith only [hquad]
  have hmul := mul_le_mul_of_nonneg_left hexp underestimationConstant_positive.le
  simpa only [gaussianPDFReal, NNReal.coe_one, mul_one, underestimationConstant] using hmul

theorem underestimation_probability_lower (T : ℕ) (hT : 5 ≤ T) :
    underestimationConstant * Rates.invPower 882 T ≤
      (gaussianReal 1 1).real (underestimationInterval T) := by
  have hmass : (gaussianReal 1 1).real (underestimationInterval T) =
      ∫ x in underestimationInterval T, gaussianPDFReal 1 1 x := by
    rw [measureReal_def, gaussianReal_apply_eq_integral 1 (by norm_num : (1 : ℝ≥0) ≠ 0),
      ENNReal.toReal_ofReal]
    exact integral_nonneg (gaussianPDFReal_nonneg 1 1)
  have hmono : (∫ _ in underestimationInterval T, underestimationConstant * Rates.invPower 882 T) ≤
      ∫ x in underestimationInterval T, gaussianPDFReal 1 1 x := by
    apply setIntegral_mono_on
      (integrableOn_const (by exact isCompact_Icc.measure_ne_top))
      (integrable_gaussianPDFReal 1 1).integrableOn measurableSet_Icc
    intro x hx
    exact underestimationPDF_lower T hT x hx
  have hconst : (∫ _ in underestimationInterval T, underestimationConstant * Rates.invPower 882 T) =
      underestimationConstant * Rates.invPower 882 T := by
    unfold underestimationInterval
    rw [setIntegral_const, smul_eq_mul, measureReal_def, Real.volume_Icc,
      ENNReal.toReal_ofReal (by linarith)]
    ring
  rw [← hconst, hmass]
  exact hmono

abbrev FullSample (q : ℕ) := ℝ × ((Fin q → ℝ) × (Fin q → ℝ))

/-- Actual frequentist model with q iid N(0,1) samples for each inferior arm
and the first N(1,1) sample of the superior arm, independent across arms. -/
def frequentistLaw (q : ℕ) : Measure (FullSample q) :=
  (gaussianReal 1 1).prod ((arrayLaw q).prod (arrayLaw q))

instance frequentistLaw_probability (q : ℕ) : IsProbabilityMeasure (frequentistLaw q) := by
  unfold frequentistLaw
  infer_instance

def badEvent (T q : ℕ) : Set (FullSample q) :=
  underestimationInterval T ×ˢ (goodArmSet T q ×ˢ goodArmSet T q)

theorem badEvent_measurable (T q : ℕ) : MeasurableSet (badEvent T q) := by
  exact measurableSet_Icc.prod
    (((goodMeanSet_measurable T q).inter (goodDriftSet_measurable T q)).prod
      ((goodMeanSet_measurable T q).inter (goodDriftSet_measurable T q)))

theorem badEvent_probability_eq (T q : ℕ) :
    (frequentistLaw q).real (badEvent T q) =
      (gaussianReal 1 1).real (underestimationInterval T) *
        (arrayLaw q).real (goodArmSet T q) * (arrayLaw q).real (goodArmSet T q) := by
  simp only [frequentistLaw, badEvent, Measure.prod_prod, measureReal_def, ENNReal.toReal_mul]
  ring

/-- A concrete polynomial probability bound for the actual bad event,
including both arms' full drift constraints and the superior arm's draw. -/
theorem badEvent_probability_lower (T q : ℕ) (hT : T = 2 * q + 1) (hq : 2 ≤ q) :
    (underestimationConstant / 64) * Rates.invPower 886 T ≤
      (frequentistLaw q).real (badEvent T q) := by
  have hx := underestimation_probability_lower T (by omega)
  have hy := goodArm_probability_lower T q hT hq
  have hprod1 := Rates.product_lower_bound underestimationConstant_positive.le
    (by norm_num : (0 : ℝ) ≤ 1 / 8) hx hy
  have hprod2 := Rates.product_lower_bound
    (mul_nonneg underestimationConstant_positive.le (by norm_num : (0 : ℝ) ≤ 1 / 8))
    (by norm_num : (0 : ℝ) ≤ 1 / 8) hprod1 hy
  rw [badEvent_probability_eq]
  convert hprod2 using 1
  ring

theorem badEvent_probability_lower_general (T q : ℕ)
    (hT : 5 ≤ T) (hq : 0 < q) (hqT : q ≤ T) (hTq : T ≤ 3 * q) :
    (underestimationConstant / 64) * Rates.invPower 886 T ≤
      (frequentistLaw q).real (badEvent T q) := by
  have hx := underestimation_probability_lower T hT
  have hy := goodArm_probability_lower_general T q hT hq hqT hTq
  have hprod1 := Rates.product_lower_bound underestimationConstant_positive.le
    (by norm_num : (0 : ℝ) ≤ 1 / 8) hx hy
  have hprod2 := Rates.product_lower_bound
    (mul_nonneg underestimationConstant_positive.le (by norm_num : (0 : ℝ) ≤ 1 / 8))
    (by norm_num : (0 : ℝ) ≤ 1 / 8) hprod1 hy
  rw [badEvent_probability_eq]
  convert hprod2 using 1
  ring

def rawMeanPath {q : ℕ} (ω : FullSample q) : Counts.MeanPath :=
  fun i n => if i = 1 then sampleMean n ω.2.1 else if i = 2 then sampleMean n ω.2.2 else ω.1

/-- The polynomial-probability bad event entails the exact printed W event
for every count state satisfying its caps. -/
theorem badEvent_implies_W (T q : ℕ) (ω : FullSample q) (c : Counts.Counts)
    (hω : ω ∈ badEvent T q) (h1 : c.n1 ≤ q) (h2 : c.n2 ≤ q) (h3 : c.n3 ≤ 1) :
    Drift.paperW T q 40 (rawMeanPath ω) c := by
  rcases hω with ⟨hx, ⟨hy1, hz1⟩, ⟨hy2, hz2⟩⟩
  refine ⟨?_, ?_, ?_, ?_, ?_, h1, h2, h3⟩
  · simpa only [Drift.eventX, rawMeanPath, show (3 : ℕ) ≠ 1 by decide,
      show (3 : ℕ) ≠ 2 by decide, if_false] using hx.2
  · unfold Drift.eventY rawMeanPath
    norm_num
    simpa only [goodMeanSet, Set.mem_setOf_eq, Rates.invPower, one_div] using hy1
  · unfold Drift.eventY rawMeanPath
    norm_num
    simpa only [goodMeanSet, Set.mem_setOf_eq, Rates.invPower, one_div] using hy2
  · intro n hn hnq
    simpa only [rawMeanPath, if_pos rfl, driftThreshold] using hz1 n hn hnq
  · intro n hn hnq
    simpa only [rawMeanPath, show (2 : ℕ) ≠ 1 by decide, if_false, if_pos rfl,
      driftThreshold] using hz2 n hn hnq

def arrayPrefix {q N : ℕ} (h : q ≤ N) (ω : Fin N → ℝ) : Fin q → ℝ :=
  fun i => ω (Fin.castLE h i)

theorem arrayPrefix_preserving {q N : ℕ} (h : q ≤ N) :
    MeasurePreserving (arrayPrefix h) (arrayLaw N) (arrayLaw q) := by
  have hind0 : iIndepFun (fun i (ω : Fin N → ℝ) => ω i) (arrayLaw N) :=
    iIndepFun_pi (fun _ => aemeasurable_id)
  have hind : iIndepFun (fun i (ω : Fin N → ℝ) => ω (Fin.castLE h i)) (arrayLaw N) :=
    hind0.precomp (Fin.castLE_injective h)
  have hmap := (iIndepFun_iff_map_fun_eq_pi_map
    (fun i => (measurable_pi_apply (Fin.castLE h i)).aemeasurable)).mp hind
  have heval (i : Fin q) : (arrayLaw N).map (fun ω => ω (Fin.castLE h i)) = gaussianReal 0 1 :=
    (measurePreserving_eval (fun _ : Fin N => gaussianReal 0 1) (Fin.castLE h i)).map_eq
  constructor
  · unfold arrayPrefix
    fun_prop
  · simpa only [arrayPrefix, heval] using hmap

theorem sampleMean_arrayPrefix_eq {q N : ℕ} (h : q ≤ N) (n : ℕ) (hnq : n ≤ q)
    (ω : Fin N → ℝ) : sampleMean n (arrayPrefix h ω) = sampleMean n ω := by
  classical
  let e : Fin q ↪ Fin N := ⟨Fin.castLE h, Fin.castLE_injective h⟩
  unfold sampleMean weightedSum arrayPrefix
  calc
    (∑ i : Fin q, meanCoefficient n i * ω (Fin.castLE h i)) =
        ∑ j ∈ Finset.univ.map e, meanCoefficient n j * ω j := by
      rw [Finset.sum_map]
      rfl
    _ = ∑ j : Fin N, meanCoefficient n j * ω j := by
      apply Finset.sum_subset
      · exact fun _ _ => Finset.mem_univ _
      · intro j _hju hjnot
        have hqj : q ≤ (j : ℕ) := by
          by_contra! hjq
          let i : Fin q := ⟨(j : ℕ), hjq⟩
          apply hjnot
          apply Finset.mem_map.mpr
          refine ⟨i, Finset.mem_univ _, ?_⟩
          apply Fin.ext
          rfl
        simp only [meanCoefficient, if_neg (by omega : ¬ ((j : ℕ) < n)), zero_mul]

theorem sampleMean_one {T : ℕ} (hT : 0 < T) (ω : Fin T → ℝ) :
    sampleMean 1 ω = ω ⟨0, hT⟩ := by
  rw [← sampleMean_arrayPrefix_eq (show 1 ≤ T by omega) 1 le_rfl]
  simp [sampleMean, weightedSum, meanCoefficient, arrayPrefix]
  congr 1

abbrev RawArrays (T : ℕ) := Fin 3 → Fin T → ℝ

def rawArraysLaw (T : ℕ) : Measure (RawArrays T) :=
  Measure.pi (fun _ : Fin 3 => arrayLaw T)

instance rawArraysLaw_probability (T : ℕ) : IsProbabilityMeasure (rawArraysLaw T) := by
  unfold rawArraysLaw
  infer_instance

/-- Projection of complete independent raw sample streams to the samples
used in the bad event. Arm indices here are 0,1,2; the superior arm has mean 1. -/
def projectRawArrays (T q : ℕ) (hqT : q ≤ T) (hT : 0 < T) (ω : RawArrays T) : FullSample q :=
  (ω 2 ⟨0, hT⟩ + 1, (arrayPrefix hqT (ω 0), arrayPrefix hqT (ω 1)))

theorem projectRawArrays_preserving (T q : ℕ) (hqT : q ≤ T) (hT : 0 < T) :
    MeasurePreserving (projectRawArrays T q hqT hT) (rawArraysLaw T) (frequentistLaw q) := by
  have hprefix := arrayPrefix_preserving hqT
  have hfirst : MeasurePreserving (fun ω : Fin T → ℝ => ω ⟨0, hT⟩ + 1)
      (arrayLaw T) (gaussianReal 1 1) := by
    have heval := measurePreserving_eval (fun _ : Fin T => gaussianReal 0 1) (⟨0, hT⟩ : Fin T)
    have hshift : MeasurePreserving (fun x : ℝ => x + 1) (gaussianReal 0 1) (gaussianReal 1 1) := by
      constructor
      · fun_prop
      · simpa using (gaussianReal_map_add_const (μ := (0 : ℝ)) (v := (1 : ℝ≥0)) 1)
    exact hshift.comp heval
  have htwo := measurePreserving_piFinTwo (fun _ : Fin 2 => arrayLaw T)
  have hpair := (hprefix.prod hprefix).comp htwo
  have hthree := measurePreserving_piFinSuccAbove (fun _ : Fin 3 => arrayLaw T) (2 : Fin 3)
  have hfull := (hfirst.prod hpair).comp hthree
  convert hfull using 1

def rawBadEvent (T q : ℕ) (hqT : q ≤ T) (hT : 0 < T) : Set (RawArrays T) :=
  (projectRawArrays T q hqT hT) ⁻¹' badEvent T q

theorem rawBadEvent_probability_lower (T q : ℕ) (horizon : T = 2 * q + 1) (hq : 2 ≤ q) :
    (underestimationConstant / 64) * Rates.invPower 886 T ≤
      (rawArraysLaw T).real (rawBadEvent T q (by omega) (by omega)) := by
  have hp := projectRawArrays_preserving T q (by omega) (by omega)
  have heq : (rawArraysLaw T).real (rawBadEvent T q (by omega) (by omega)) =
      (frequentistLaw q).real (badEvent T q) := by
    simp only [measureReal_def]
    rw [← hp.map_eq, Measure.map_apply hp.measurable (badEvent_measurable T q)]
    rfl
  rw [heq]
  exact badEvent_probability_lower T q horizon hq

theorem rawBadEvent_probability_lower_general (T q : ℕ)
    (hT : 5 ≤ T) (hq : 0 < q) (hqT : q ≤ T) (hTq : T ≤ 3 * q) :
    (underestimationConstant / 64) * Rates.invPower 886 T ≤
      (rawArraysLaw T).real (rawBadEvent T q hqT (by omega)) := by
  have hp := projectRawArrays_preserving T q hqT (by omega)
  have heq : (rawArraysLaw T).real (rawBadEvent T q hqT (by omega)) =
      (frequentistLaw q).real (badEvent T q) := by
    simp only [measureReal_def]
    rw [← hp.map_eq, Measure.map_apply hp.measurable (badEvent_measurable T q)]
    rfl
  rw [heq]
  exact badEvent_probability_lower_general T q hT hq hqT hTq

theorem rawBadEvent_even_probability_lower (T q : ℕ) (horizon : T = 2 * q) (hq : 3 ≤ q) :
    (underestimationConstant / 64) * Rates.invPower 886 T ≤
      (rawArraysLaw T).real (rawBadEvent T q (by omega) (by omega)) := by
  exact rawBadEvent_probability_lower_general T q (by omega) (by omega) (by omega) (by omega)

/-- Empirical means computed from the complete raw arrays, with true means
(0,0,1). This uses the paper's one-based arm labels. -/
def fullMeanPath {T : ℕ} (ω : RawArrays T) : Counts.MeanPath :=
  fun i n => if i = 1 then sampleMean n (ω 0)
    else if i = 2 then sampleMean n (ω 1) else sampleMean n (ω 2) + 1

theorem rawBadEvent_implies_full_W (T q : ℕ) (hqT : q ≤ T) (hT : 0 < T)
    (ω : RawArrays T) (c : Counts.Counts)
    (hω : ω ∈ rawBadEvent T q hqT hT)
    (h1 : c.n1 ≤ q) (h2 : c.n2 ≤ q) (h3 : c.n3 ≤ 1) :
    Drift.paperW T q 40 (fullMeanPath ω) c := by
  have hw := badEvent_implies_W T q (projectRawArrays T q hqT hT ω) c hω h1 h2 h3
  rcases hw with ⟨hX, hY1, hY2, hZ1, hZ2, _⟩
  refine ⟨?_, ?_, ?_, ?_, ?_, h1, h2, h3⟩
  · simpa [Drift.eventX, rawMeanPath, fullMeanPath, projectRawArrays, sampleMean_one hT] using hX
  · simpa [Drift.eventY, rawMeanPath, fullMeanPath, projectRawArrays,
      sampleMean_arrayPrefix_eq hqT q le_rfl] using hY1
  · simpa [Drift.eventY, rawMeanPath, fullMeanPath, projectRawArrays,
      sampleMean_arrayPrefix_eq hqT q le_rfl] using hY2
  · intro n hn hnq
    have h := hZ1 n hn hnq
    simpa [rawMeanPath, fullMeanPath, projectRawArrays,
      sampleMean_arrayPrefix_eq hqT n hnq, sampleMean_arrayPrefix_eq hqT q le_rfl] using h
  · intro n hn hnq
    have h := hZ2 n hn hnq
    simpa [rawMeanPath, fullMeanPath, projectRawArrays,
      sampleMean_arrayPrefix_eq hqT n hnq, sampleMean_arrayPrefix_eq hqT q le_rfl] using h

end

end BayesOptimal.Foundations.BadEvent

end

/-! ## Foundations.BadEvent50 -/
section

/-!
The complete frequentist bad event with CU=50. This stronger underestimation
event accommodates the corrected even-budget drift exponent. All raw sample
streams and their Gaussian product laws are reused from BayesOptimal.Foundations.BadEvent.
-/

open MeasureTheory ProbabilityTheory Set
open scoped MeasureTheory NNReal ENNReal

namespace BayesOptimal.Foundations.BadEvent50

open BayesOptimal.Foundations.BadEvent

noncomputable section

def underestimationInterval (T : ℕ) : Set ℝ :=
  Icc (-50 * Real.sqrt (Real.log (T : ℝ)) - 1) (-50 * Real.sqrt (Real.log (T : ℝ)))

theorem underestimationPDF_lower (T : ℕ) (hT : 5 ≤ T) (x : ℝ)
    (hx : x ∈ underestimationInterval T) :
    underestimationConstant * Rates.invPower 1352 T ≤ gaussianPDFReal 1 1 x := by
  have htpos : 0 < (T : ℝ) := by exact_mod_cast (show 0 < T by omega)
  have hlog := Drift.log_horizon_ge_one T hT
  have hs0 := Real.sqrt_nonneg (Real.log (T : ℝ))
  have hs1 : 1 ≤ Real.sqrt (Real.log (T : ℝ)) := Real.one_le_sqrt.mpr hlog
  have hsq : (Real.sqrt (Real.log (T : ℝ))) ^ 2 = Real.log (T : ℝ) :=
    Real.sq_sqrt (by linarith only [hlog])
  have hdiff0 : x - 1 ≤ 0 := by linarith only [hx.2, hs0]
  have hdiff : |x - 1| ≤ 52 * Real.sqrt (Real.log (T : ℝ)) := by
    rw [abs_of_nonpos hdiff0]
    linarith only [hx.1, hs1]
  have hquad : (x - 1) ^ 2 ≤ 2704 * Real.log (T : ℝ) := by
    have h := (sq_le_sq₀ (abs_nonneg (x - 1)) (by positivity)).mpr hdiff
    rw [sq_abs] at h
    nlinarith only [h, hsq]
  have hexp : Rates.invPower 1352 T ≤ Real.exp (-(x - 1) ^ 2 / 2) := by
    unfold Rates.invPower
    rw [← PredictiveBound.exp_neg_nat_log 1352 htpos]
    apply Real.exp_le_exp.mpr
    norm_num
    nlinarith only [hquad]
  have hmul := mul_le_mul_of_nonneg_left hexp underestimationConstant_positive.le
  simpa only [gaussianPDFReal, NNReal.coe_one, mul_one, underestimationConstant] using hmul

theorem underestimation_probability_lower (T : ℕ) (hT : 5 ≤ T) :
    underestimationConstant * Rates.invPower 1352 T ≤
      (gaussianReal 1 1).real (underestimationInterval T) := by
  have hmass : (gaussianReal 1 1).real (underestimationInterval T) =
      ∫ x in underestimationInterval T, gaussianPDFReal 1 1 x := by
    rw [measureReal_def, gaussianReal_apply_eq_integral 1 (by norm_num : (1 : ℝ≥0) ≠ 0),
      ENNReal.toReal_ofReal]
    exact integral_nonneg (gaussianPDFReal_nonneg 1 1)
  have hmono : (∫ _ in underestimationInterval T, underestimationConstant * Rates.invPower 1352 T) ≤
      ∫ x in underestimationInterval T, gaussianPDFReal 1 1 x := by
    apply setIntegral_mono_on
      (integrableOn_const (by exact isCompact_Icc.measure_ne_top))
      (integrable_gaussianPDFReal 1 1).integrableOn measurableSet_Icc
    intro x hx
    exact underestimationPDF_lower T hT x hx
  have hconst : (∫ _ in underestimationInterval T, underestimationConstant * Rates.invPower 1352 T) =
      underestimationConstant * Rates.invPower 1352 T := by
    unfold underestimationInterval
    rw [setIntegral_const, smul_eq_mul, measureReal_def, Real.volume_Icc,
      ENNReal.toReal_ofReal (by linarith)]
    ring
  rw [← hconst, hmass]
  exact hmono

def badEvent (T q : ℕ) : Set (FullSample q) :=
  underestimationInterval T ×ˢ (goodArmSet T q ×ˢ goodArmSet T q)

theorem badEvent_measurable (T q : ℕ) : MeasurableSet (badEvent T q) := by
  exact measurableSet_Icc.prod
    (((goodMeanSet_measurable T q).inter (goodDriftSet_measurable T q)).prod
      ((goodMeanSet_measurable T q).inter (goodDriftSet_measurable T q)))

theorem badEvent_probability_eq (T q : ℕ) :
    (frequentistLaw q).real (badEvent T q) =
      (gaussianReal 1 1).real (underestimationInterval T) *
        (arrayLaw q).real (goodArmSet T q) * (arrayLaw q).real (goodArmSet T q) := by
  simp only [frequentistLaw, badEvent, Measure.prod_prod, measureReal_def, ENNReal.toReal_mul]
  ring

theorem badEvent_probability_lower_general (T q : ℕ)
    (hT : 5 ≤ T) (hq : 0 < q) (hqT : q ≤ T) (hTq : T ≤ 3 * q) :
    (underestimationConstant / 64) * Rates.invPower 1356 T ≤
      (frequentistLaw q).real (badEvent T q) := by
  have hx := underestimation_probability_lower T hT
  have hy := goodArm_probability_lower_general T q hT hq hqT hTq
  have hprod1 := Rates.product_lower_bound underestimationConstant_positive.le
    (by norm_num : (0 : ℝ) ≤ 1 / 8) hx hy
  have hprod2 := Rates.product_lower_bound
    (mul_nonneg underestimationConstant_positive.le (by norm_num : (0 : ℝ) ≤ 1 / 8))
    (by norm_num : (0 : ℝ) ≤ 1 / 8) hprod1 hy
  rw [badEvent_probability_eq]
  convert hprod2 using 1
  ring

theorem badEvent_implies_W (T q : ℕ) (ω : FullSample q) (c : Counts.Counts)
    (hω : ω ∈ badEvent T q) (h1 : c.n1 ≤ q) (h2 : c.n2 ≤ q) (h3 : c.n3 ≤ 1) :
    Drift.paperW T q 50 (rawMeanPath ω) c := by
  rcases hω with ⟨hx, ⟨hy1, hz1⟩, ⟨hy2, hz2⟩⟩
  refine ⟨?_, ?_, ?_, ?_, ?_, h1, h2, h3⟩
  · simpa only [Drift.eventX, rawMeanPath, show (3 : ℕ) ≠ 1 by decide,
      show (3 : ℕ) ≠ 2 by decide, if_false] using hx.2
  · unfold Drift.eventY rawMeanPath
    norm_num
    simpa only [goodMeanSet, Set.mem_setOf_eq, Rates.invPower, one_div] using hy1
  · unfold Drift.eventY rawMeanPath
    norm_num
    simpa only [goodMeanSet, Set.mem_setOf_eq, Rates.invPower, one_div] using hy2
  · intro n hn hnq
    simpa only [rawMeanPath, if_pos rfl, driftThreshold] using hz1 n hn hnq
  · intro n hn hnq
    simpa only [rawMeanPath, show (2 : ℕ) ≠ 1 by decide, if_false, if_pos rfl,
      driftThreshold] using hz2 n hn hnq

def rawBadEvent (T q : ℕ) (hqT : q ≤ T) (hT : 0 < T) : Set (RawArrays T) :=
  (projectRawArrays T q hqT hT) ⁻¹' badEvent T q

theorem rawBadEvent_measurable (T q : ℕ) (hqT : q ≤ T) (hT : 0 < T) :
    MeasurableSet (rawBadEvent T q hqT hT) :=
  (badEvent_measurable T q).preimage (projectRawArrays_preserving T q hqT hT).measurable

theorem rawBadEvent_probability_lower_general (T q : ℕ)
    (hT : 5 ≤ T) (hq : 0 < q) (hqT : q ≤ T) (hTq : T ≤ 3 * q) :
    (underestimationConstant / 64) * Rates.invPower 1356 T ≤
      (rawArraysLaw T).real (rawBadEvent T q hqT (by omega)) := by
  have hp := projectRawArrays_preserving T q hqT (by omega)
  have heq : (rawArraysLaw T).real (rawBadEvent T q hqT (by omega)) =
      (frequentistLaw q).real (badEvent T q) := by
    simp only [measureReal_def]
    rw [← hp.map_eq, Measure.map_apply hp.measurable (badEvent_measurable T q)]
    rfl
  rw [heq]
  exact badEvent_probability_lower_general T q hT hq hqT hTq

theorem rawBadEvent_odd_probability_lower (T q : ℕ) (horizon : T = 2 * q + 1) (hq : 2 ≤ q) :
    (underestimationConstant / 64) * Rates.invPower 1356 T ≤
      (rawArraysLaw T).real (rawBadEvent T q (by omega) (by omega)) := by
  exact rawBadEvent_probability_lower_general T q (by omega) (by omega) (by omega) (by omega)

theorem rawBadEvent_even_probability_lower (T q : ℕ) (horizon : T = 2 * q) (hq : 3 ≤ q) :
    (underestimationConstant / 64) * Rates.invPower 1356 T ≤
      (rawArraysLaw T).real (rawBadEvent T q (by omega) (by omega)) := by
  exact rawBadEvent_probability_lower_general T q (by omega) (by omega) (by omega) (by omega)

theorem rawBadEvent_implies_full_W (T q : ℕ) (hqT : q ≤ T) (hT : 0 < T)
    (ω : RawArrays T) (c : Counts.Counts)
    (hω : ω ∈ rawBadEvent T q hqT hT)
    (h1 : c.n1 ≤ q) (h2 : c.n2 ≤ q) (h3 : c.n3 ≤ 1) :
    Drift.paperW T q 50 (fullMeanPath ω) c := by
  have hw := badEvent_implies_W T q (projectRawArrays T q hqT hT ω) c hω h1 h2 h3
  rcases hw with ⟨hX, hY1, hY2, hZ1, hZ2, _⟩
  refine ⟨?_, ?_, ?_, ?_, ?_, h1, h2, h3⟩
  · simpa [Drift.eventX, rawMeanPath, fullMeanPath, projectRawArrays, sampleMean_one hT] using hX
  · simpa [Drift.eventY, rawMeanPath, fullMeanPath, projectRawArrays,
      sampleMean_arrayPrefix_eq hqT q le_rfl] using hY1
  · simpa [Drift.eventY, rawMeanPath, fullMeanPath, projectRawArrays,
      sampleMean_arrayPrefix_eq hqT q le_rfl] using hY2
  · intro n hn hnq
    have h := hZ1 n hn hnq
    simpa [rawMeanPath, fullMeanPath, projectRawArrays,
      sampleMean_arrayPrefix_eq hqT n hnq, sampleMean_arrayPrefix_eq hqT q le_rfl] using h
  · intro n hn hnq
    have h := hZ2 n hn hnq
    simpa [rawMeanPath, fullMeanPath, projectRawArrays,
      sampleMean_arrayPrefix_eq hqT n hnq, sampleMean_arrayPrefix_eq hqT q le_rfl] using h

end

end BayesOptimal.Foundations.BadEvent50

end

/-! ## Foundations.BayesianModel -/
section

/-!
The three-arm Gaussian posterior decision process. Counts and means are the
paper's sufficient statistics. Values are expected terminal posterior means;
the posterior expectation of the best latent mean is an action-independent
additive constant in expected regret.
-/

open MeasureTheory ProbabilityTheory
open scoped NNReal ENNReal

namespace BayesOptimal.Foundations.BayesianModel

abbrev Arm := Fin 3
abbrev Counts := Arm → ℕ
abbrev Means := Arm → ℝ

noncomputable section

def advance (c : Counts) (i : Arm) : Counts :=
  fun j => c j + if j = i then 1 else 0

def shift (m : Means) (i : Arm) (z : ℝ) : Means :=
  fun j => m j + if j = i then z else 0

def innovation (c : Counts) (i : Arm) : ℝ≥0 :=
  Gaussian.updateVariance (c i : ℝ≥0)

def terminal (m : Means) : ℝ := max (m 0) (max (m 1) (m 2))

def value : ℕ → Counts → Means → ℝ
  | 0, _, m => terminal m
  | k + 1, c, m =>
    let a := fun i : Arm => ∫ z : ℝ,
      value k (advance c i) (shift m i z) ∂gaussianReal 0 (innovation c i)
    max (a 0) (max (a 1) (a 2))

def action (k : ℕ) (c : Counts) (m : Means) (i : Arm) : ℝ :=
  ∫ z : ℝ, value k (advance c i) (shift m i z)
    ∂gaussianReal 0 (innovation c i)

theorem value_succ (k : ℕ) (c : Counts) (m : Means) :
    value (k + 1) c m = max (action k c m 0)
      (max (action k c m 1) (action k c m 2)) := rfl

theorem shift_sub_shift (m n : Means) (i : Arm) (z : ℝ) :
    shift m i z - shift n i z = m - n := by
  ext j
  simp only [shift, Pi.sub_apply]
  ring

theorem shift_lipschitz (i : Arm) (z : ℝ) :
    LipschitzWith 1 (fun m : Means => shift m i z) := by
  apply LipschitzWith.of_dist_le_mul
  intro m n
  simp only [dist_eq_norm, shift_sub_shift, NNReal.coe_one, one_mul, le_refl]

theorem shift_norm_bound (m : Means) (i : Arm) (z : ℝ) :
    ‖shift m i z - m‖ ≤ |z| := by
  apply (pi_norm_le_iff_of_nonneg (abs_nonneg z)).mpr
  intro j
  by_cases h : j = i <;> simp [shift, h, Real.norm_eq_abs]

theorem shift_continuous_noise (m : Means) (i : Arm) :
    Continuous (shift m i) := by
  apply continuous_pi
  intro j
  by_cases h : j = i <;> simp [shift, h] <;> fun_prop

theorem terminal_lipschitz : LipschitzWith 1 terminal := by
  have h (i : Arm) : LipschitzWith 1 (fun m : Means => m i) :=
    LipschitzWith.eval i
  simpa only [max_self] using (h 0).max ((h 1).max (h 2))

theorem shifted_integrable {f : Means → ℝ} (hf : LipschitzWith 1 f)
    (m : Means) (i : Arm) (v : ℝ≥0) :
    Integrable (fun z : ℝ => f (shift m i z)) (gaussianReal 0 v) := by
  have hb (z : ℝ) : ‖f (shift m i z)‖ ≤ |f m| + |z| := by
    have h := hf.dist_le_mul (shift m i z) m
    simp only [NNReal.coe_one, one_mul, dist_eq_norm, Real.norm_eq_abs] at h
    have hn := shift_norm_bound m i z
    calc
      ‖f (shift m i z)‖ = |f (shift m i z)| := Real.norm_eq_abs _
      _ ≤ |f (shift m i z) - f m| + |f m| := by
        simpa only [sub_add_cancel] using abs_add_le (f (shift m i z) - f m) (f m)
      _ ≤ |f m| + |z| := by linarith
  exact ((integrable_const |f m|).add (Gaussian.gaussian_id_integrable 0 v).norm).mono'
    (hf.continuous.comp (shift_continuous_noise m i)).measurable.aestronglyMeasurable
    (Filter.Eventually.of_forall hb)

theorem integral_shift_lipschitz {f : Means → ℝ} (hf : LipschitzWith 1 f)
    (i : Arm) (v : ℝ≥0) :
    LipschitzWith 1 (fun m : Means =>
      ∫ z : ℝ, f (shift m i z) ∂gaussianReal 0 v) := by
  apply LipschitzWith.of_dist_le_mul
  intro m n
  simp only [NNReal.coe_one, one_mul, dist_eq_norm]
  rw [← integral_sub (shifted_integrable hf m i v) (shifted_integrable hf n i v)]
  have hb : ∀ᵐ z : ℝ ∂gaussianReal 0 v,
      ‖f (shift m i z) - f (shift n i z)‖ ≤ ‖m - n‖ := by
    apply Filter.Eventually.of_forall
    intro z
    have h := hf.dist_le_mul (shift m i z) (shift n i z)
    simpa only [dist_eq_norm, shift_sub_shift, NNReal.coe_one, one_mul] using h
  simpa using norm_integral_le_of_norm_le_const hb

theorem value_lipschitz (k : ℕ) (c : Counts) : LipschitzWith 1 (value k c) := by
  induction k generalizing c with
  | zero => exact terminal_lipschitz
  | succ k ih =>
    have h (i : Arm) : LipschitzWith 1 (action k c · i) :=
      integral_shift_lipschitz (ih (advance c i)) i (innovation c i)
    simpa only [value_succ, max_self] using (h 0).max ((h 1).max (h 2))

theorem action_integrable (k : ℕ) (c : Counts) (m : Means) (i : Arm) :
    Integrable (fun z : ℝ => value k (advance c i) (shift m i z))
      (gaussianReal 0 (innovation c i)) :=
  shifted_integrable (value_lipschitz k (advance c i)) m i (innovation c i)

theorem action_lipschitz (k : ℕ) (c : Counts) (i : Arm) :
    LipschitzWith 1 (action k c · i) :=
  integral_shift_lipschitz (value_lipschitz k (advance c i)) i (innovation c i)

theorem action_le_value (k : ℕ) (c : Counts) (m : Means) (i : Arm) :
    action k c m i ≤ value (k + 1) c m := by
  rw [value_succ]
  fin_cases i
  · exact le_max_left _ _
  · exact (le_max_left _ _).trans (le_max_right _ _)
  · exact (le_max_right _ _).trans (le_max_right _ _)

def choose (k : ℕ) (c : Counts) (m : Means) : Arm :=
  if action k c m 0 ≥ max (action k c m 1) (action k c m 2) then 0
  else if action k c m 1 ≥ action k c m 2 then 1 else 2

theorem choose_optimal (k : ℕ) (c : Counts) (m : Means) :
    action k c m (choose k c m) = value (k + 1) c m := by
  rw [value_succ]
  unfold choose
  split_ifs with h₀ h₁
  · exact (max_eq_left h₀).symm
  · rw [max_eq_right (le_of_not_ge h₀), max_eq_left h₁]
  · rw [max_eq_right (le_of_not_ge h₀), max_eq_right (le_of_not_ge h₁)]

def recommend (m : Means) : Arm :=
  if m 0 ≥ max (m 1) (m 2) then 0 else if m 1 ≥ m 2 then 1 else 2

theorem recommend_max (m : Means) : m (recommend m) = terminal m := by
  unfold recommend terminal
  split_ifs with h₀ h₁
  · exact (max_eq_left h₀).symm
  · rw [max_eq_right (le_of_not_ge h₀), max_eq_left h₁]
  · rw [max_eq_right (le_of_not_ge h₀), max_eq_right (le_of_not_ge h₁)]

theorem recommend_greedy (m : Means) (i : Arm) : m i ≤ m (recommend m) := by
  rw [recommend_max m]
  fin_cases i
  · exact le_max_left _ _
  · exact (le_max_left _ _).trans (le_max_right _ _)
  · exact (le_max_right _ _).trans (le_max_right _ _)

end

end BayesOptimal.Foundations.BayesianModel

end

/-! ## Foundations.BellmanAlgebra -/
section

/-!
Algebraic Bellman steps with every probabilistic comparison premise explicit.
These proofs establish no mock-sample coupling or full-policy optimality.
-/

namespace BayesOptimal.Foundations.BellmanAlgebra

noncomputable def ebi (baseline actionLoss : ℝ) : ℝ := baseline - actionLoss

theorem ebi_order (baseline loss₁ loss₂ : ℝ) :
    ebi baseline loss₁ ≤ ebi baseline loss₂ ↔ loss₂ ≤ loss₁ := by
  unfold ebi
  constructor <;> intro h <;> linarith

theorem argmax_ebi_iff_argmin_loss {ι : Type*} (baseline : ℝ)
    (loss : ι → ℝ) (chosen : ι) :
    (∀ i, ebi baseline (loss i) ≤ ebi baseline (loss chosen)) ↔
      (∀ i, loss chosen ≤ loss i) := by
  constructor
  · intro h i
    exact (ebi_order baseline (loss i) (loss chosen)).mp (h i)
  · intro h i
    exact (ebi_order baseline (loss i) (loss chosen)).mpr (h i)

theorem lemma11_from_mock_comparisons (baseline actionLoss mockLoss contribution : ℝ)
    (hoptimal : baseline ≤ mockLoss)
    (hmock : mockLoss ≤ actionLoss + contribution) :
    ebi baseline actionLoss ≤ contribution := by
  unfold ebi
  linarith

theorem lemma12_from_comparisons (loss₃ loss₂ contribution : ℝ)
    (h₁ : loss₃ - loss₂ ≤ contribution) (h₂ : loss₂ - loss₃ ≤ contribution) :
    |loss₃ - loss₂| ≤ contribution := by
  apply abs_le.mpr
  constructor <;> linarith

theorem lemma7_transfer (baseline₃ action₃ baseline₂ action₂ contribution bound : ℝ)
    (hbase : |baseline₃ - baseline₂| ≤ contribution)
    (hact : |action₃ - action₂| ≤ contribution)
    (hbound : bound ≤ ebi baseline₂ action₂) :
    bound - 2 * contribution ≤ ebi baseline₃ action₃ := by
  rcases abs_le.mp hbase with ⟨hbase₁, hbase₂⟩
  rcases abs_le.mp hact with ⟨hact₁, hact₂⟩
  unfold ebi at *
  linarith

theorem lemma7_gap_transfer (b₁ b₂ c₁ c₂ contribution bound : ℝ)
    (h₁ : |b₁ - c₁| ≤ 2 * contribution)
    (h₂ : |b₂ - c₂| ≤ 2 * contribution)
    (hgap : bound ≤ c₁ - c₂) : bound - 4 * contribution ≤ b₁ - b₂ := by
  rcases abs_le.mp h₁ with ⟨h₁a, h₁b⟩
  rcases abs_le.mp h₂ with ⟨h₂a, h₂b⟩
  linarith

end BayesOptimal.Foundations.BellmanAlgebra

end

/-! ## Foundations.PredictiveLaw -/
section

/-!
The forecast law for the corrected deterministic balanced schedule, defined
by convolving the centered Gaussian posterior innovations of Section 5.1.
Its variance is exactly the difference of initial and final posterior
variances. A separate model-identification argument is needed to identify
this measure recursion with the paper's conditional random history.
-/

open MeasureTheory ProbabilityTheory
open scoped MeasureTheory NNReal ENNReal

namespace BayesOptimal.Foundations.PredictiveLaw

open BayesOptimal.Foundations.Counts

noncomputable section

def sampledCount (c : Counts) : ℕ := if c.n1 ≤ c.n2 then c.n1 else c.n2

def innovationVariance (c : Counts) : ℝ≥0 :=
  ((sampledCount c : ℝ≥0) * ((sampledCount c : ℝ≥0) + 1))⁻¹

def accumulatedVariance : ℕ → Counts → ℝ≥0
  | 0, _ => 0
  | k + 1, c => innovationVariance c + accumulatedVariance k (balancedStep c)

/-- The actual measure-valued forecast obtained from independent Gaussian innovations. -/
def balancedPredictiveLaw : ℕ → Counts → ℝ → Measure ℝ
  | 0, _, δ => gaussianReal δ 0
  | k + 1, c, δ => gaussianReal 0 (innovationVariance c) ∗
      balancedPredictiveLaw k (balancedStep c) δ

theorem balancedPredictiveLaw_gaussian (k : ℕ) (c : Counts) (δ : ℝ) :
    balancedPredictiveLaw k c δ = gaussianReal δ (accumulatedVariance k c) := by
  induction k generalizing c with
  | zero => rfl
  | succ k ih =>
      rw [balancedPredictiveLaw, ih, gaussianReal_conv_gaussianReal, zero_add]
      rfl

theorem innovationVariance_coe (c : Counts) :
    (innovationVariance c : ℝ) = varianceDecrement (sampledCount c) := by
  simp [innovationVariance, varianceDecrement, one_div]

theorem transitionVariance_succ (k : ℕ) (c : Counts)
    (h1 : 0 < c.n1) (h2 : 0 < c.n2) :
    transitionVariance (k + 1) c =
      varianceDecrement (sampledCount c) + transitionVariance k (balancedStep c) := by
  unfold transitionVariance
  rw [balancedRun]
  unfold sampledCount
  split_ifs with h
  · rw [← varianceDecrement_identity c.n1 h1]
    simp only [balancedStep, if_pos h, Nat.cast_add, Nat.cast_one]
    ring
  · rw [← varianceDecrement_identity c.n2 h2]
    simp only [balancedStep, if_neg h, Nat.cast_add, Nat.cast_one]
    ring

/-- Every innovation variance telescopes, including the off-by-one terminal counts. -/
theorem accumulatedVariance_coe (k : ℕ) (c : Counts)
    (h1 : 0 < c.n1) (h2 : 0 < c.n2) :
    (accumulatedVariance k c : ℝ) = transitionVariance k c := by
  induction k generalizing c with
  | zero => simp [accumulatedVariance, transitionVariance, balancedRun]
  | succ k ih =>
      have hm := balancedStep_monotone c
      have hnext1 : 0 < (balancedStep c).n1 := h1.trans_le hm.1
      have hnext2 : 0 < (balancedStep c).n2 := h2.trans_le hm.2
      rw [accumulatedVariance, NNReal.coe_add, innovationVariance_coe,
        ih (balancedStep c) hnext1 hnext2, transitionVariance_succ k c h1 h2]

/-- A zero-round forecast is a Dirac measure, explaining the terminal degeneration. -/
theorem balancedPredictiveLaw_terminal (c : Counts) (δ : ℝ) :
    balancedPredictiveLaw 0 c δ = Measure.dirac δ := by
  rw [balancedPredictiveLaw, gaussianReal_zero_var]

end

end BayesOptimal.Foundations.PredictiveLaw

end

/-! ## Foundations.CorrectedLemma17 -/
section

/-!
The repaired nonterminal Lemma 17 for the explicitly defined balanced
Gaussian-innovation forecast. The deterministic W event is the full printed
event, including its anchored Y and Z restrictions. The forecast is an
actual probability measure, not a symbolic probability or numerical model.
Connecting this law to the paper's conditional filtration remains a separate
model-identification obligation.
-/

open MeasureTheory ProbabilityTheory Set
open BayesOptimal.Foundations.Counts BayesOptimal.Foundations.Drift BayesOptimal.Foundations.PredictiveLaw BayesOptimal.Foundations.PredictiveBound

namespace BayesOptimal.Foundations.CorrectedLemma17

noncomputable section

/-- The corrected positive-interval forecast bound on every admissible W state. -/
theorem lemma17_forecast_probability (T q t : ℕ) (CU : ℝ)
    (p : MeanPath) (c : Counts)
    (hT : T = 2 * q + 1) (ht : 4 ≤ t) (hpre : t < T)
    (hc : horizonConsistent t c) (hW : paperW T q CU p c) :
    lowerConstant * BayesOptimal.Foundations.Rates.invPower 206 T ≤
      (balancedPredictiveLaw (T - t) c (terminalGap p c)
        (Icc (BayesOptimal.Foundations.Rates.invPower 2 T) (2 * BayesOptimal.Foundations.Rates.invPower 2 T))).toReal := by
  have hq : 0 < q := by omega
  have hT5 : 5 ≤ T := by omega
  have hk : 0 < T - t := by omega
  have h1 : 0 < c.n1 := by have := hc.1; omega
  have h2 : 0 < c.n2 := by have := hc.2.1; omega
  have hcap1 : c.n1 ≤ q := hW.2.2.2.2.2.1
  have hcap2 : c.n2 ≤ q := hW.2.2.2.2.2.2.1
  have hVcoe := accumulatedVariance_coe (T - t) c h1 h2
  have hv : 0 < accumulatedVariance (T - t) c := by
    have hVr : 0 < (accumulatedVariance (T - t) c : ℝ) := by
      rw [hVcoe]
      exact transitionVariance_positive (T - t) c hk h1 h2
    exact hVr
  have hupper : (accumulatedVariance (T - t) c : ℝ) ≤ 2 := by
    rw [hVcoe]
    exact transitionVariance_le_two (T - t) c hc.1 hc.2.1
  have hlower : BayesOptimal.Foundations.Rates.invPower 2 T ≤
      (accumulatedVariance (T - t) c : ℝ) := by
    rw [BayesOptimal.Foundations.Rates.invPower, inv_eq_one_div, hVcoe]
    exact lemma17_nonterminal_variance_bound T q t c hT hq ht hpre hc hcap1 hcap2
  have hδ : (terminalGap p c) ^ 2 ≤
      204 * Real.log (T : ℝ) * (accumulatedVariance (T - t) c : ℝ) := by
    rw [hVcoe]
    exact lemma17_fullW_drift_bound T q t CU p c hT ht hpre hc hW
  rw [balancedPredictiveLaw_gaussian]
  exact gaussian_interval_probability_drift204 T hT5 hv hupper hlower hδ

/-- The absolute-gap event used by the paper contains the positive interval. -/
theorem lemma17_forecast_absolute_gap_probability (T q t : ℕ) (CU : ℝ)
    (p : MeanPath) (c : Counts)
    (hT : T = 2 * q + 1) (ht : 4 ≤ t) (hpre : t < T)
    (hc : horizonConsistent t c) (hW : paperW T q CU p c) :
    lowerConstant * BayesOptimal.Foundations.Rates.invPower 206 T ≤
      (balancedPredictiveLaw (T - t) c (terminalGap p c)
        {x | gapBand T |x|}).toReal := by
  have hsub : Icc (BayesOptimal.Foundations.Rates.invPower 2 T) (2 * BayesOptimal.Foundations.Rates.invPower 2 T) ⊆
      {x | gapBand T |x|} := by
    intro x hx
    have hxnonneg : 0 ≤ x := (BayesOptimal.Foundations.Rates.invPower_nonneg 2 T).trans hx.1
    change gapBand T |x|
    unfold gapBand
    rw [abs_of_nonneg hxnonneg]
    simpa [BayesOptimal.Foundations.Rates.invPower, one_div, mul_div_assoc] using hx
  have hm := lemma17_forecast_probability T q t CU p c hT ht hpre hc hW
  rw [balancedPredictiveLaw_gaussian] at hm ⊢
  exact hm.trans (measureReal_mono hsub)

end

end BayesOptimal.Foundations.CorrectedLemma17

end

/-! ## Foundations.TwoArmBellman -/
section

/-!
Finite-horizon, two-arm posterior-mean Bellman model. Each action has the
Gaussian innovation law already proved in BayesOptimal.Foundations.Gaussian. The terminal reward
is the larger posterior mean. The recursive maximization is defined explicitly.
-/

open MeasureTheory ProbabilityTheory Set
open scoped MeasureTheory NNReal ENNReal

namespace BayesOptimal.Foundations.TwoArmBellman

open BayesOptimal.Foundations.Gaussian
open BayesOptimal.Foundations.Counts

noncomputable section

def leftStep (c : Counts) : Counts := ⟨c.n1 + 1, c.n2, c.n3⟩
def rightStep (c : Counts) : Counts := ⟨c.n1, c.n2 + 1, c.n3⟩
def variance (c : Counts) : ℝ≥0 := posteriorVariance c.n1 c.n2

def cumulativeVariance : ℕ → Counts → ℝ≥0
  | 0, _ => 0
  | k + 1, c => max
      (updateVariance c.n1 + cumulativeVariance k (leftStep c))
      (updateVariance c.n2 + cumulativeVariance k (rightStep c))

def payoff : ℕ → ℝ → ℝ → Counts → ℝ
  | 0, m1, m2, _ => max m1 m2
  | k + 1, m1, m2, c => max
      (∫ z : ℝ, payoff k (m1 + z) m2 (leftStep c) ∂gaussianReal 0 (updateVariance c.n1))
      (∫ z : ℝ, payoff k m1 (m2 + z) (rightStep c) ∂gaussianReal 0 (updateVariance c.n2))

theorem hinge_smoothing_integrable (center : ℝ) (a b : ℝ≥0) :
    Integrable (fun z : ℝ => hingeLoss (center - z) b) (gaussianReal 0 a) := by
  have hconv : gaussianReal 0 a ∗ gaussianReal 0 b = gaussianReal 0 (a + b) := by
    simpa using (gaussianReal_conv_gaussianReal (m₁ := (0 : ℝ)) (m₂ := (0 : ℝ))
      (v₁ := a) (v₂ := b))
  have hi : Integrable (fun x : ℝ => max (x - center) 0)
      (gaussianReal 0 a ∗ gaussianReal 0 b) := by
    rw [hconv]
    exact hinge_integrable center (a + b)
  have h := (integrable_conv_iff hi.aestronglyMeasurable).mp hi
  have hf : (fun z : ℝ => ∫ r : ℝ, ‖max (z + r - center) 0‖ ∂gaussianReal 0 b) =
      (fun z : ℝ => hingeLoss (center - z) b) := by
    funext z
    unfold hingeLoss
    congr 1
    funext r
    rw [Real.norm_eq_abs, abs_of_nonneg (le_max_right _ _)]
    congr 1
    ring
  rw [hf] at h
  exact h.2

theorem hinge_smoothing (center : ℝ) (a b : ℝ≥0) :
    (∫ z : ℝ, hingeLoss (center - z) b ∂gaussianReal 0 a) =
      hingeLoss center (a + b) := by
  have hconv : gaussianReal 0 a ∗ gaussianReal 0 b = gaussianReal 0 (a + b) := by
    simpa using (gaussianReal_conv_gaussianReal (m₁ := (0 : ℝ)) (m₂ := (0 : ℝ))
      (v₁ := a) (v₂ := b))
  have hi : Integrable (fun x : ℝ => max (x - center) 0)
      (gaussianReal 0 a ∗ gaussianReal 0 b) := by
    rw [hconv]
    exact hinge_integrable center (a + b)
  unfold hingeLoss
  rw [← hconv, integral_conv hi]
  congr 1
  funext z
  congr 1
  funext r
  congr 1
  ring

theorem hinge_smoothing_plus_integrable (center : ℝ) (a b : ℝ≥0) :
    Integrable (fun z : ℝ => hingeLoss (center + z) b) (gaussianReal 0 a) := by
  have hsym : (gaussianReal 0 a).map (fun z : ℝ => -z) = gaussianReal 0 a := by
    simpa using (gaussianReal_map_neg (μ := (0 : ℝ)) (v := a))
  have hi : Integrable (fun z : ℝ => hingeLoss (center - z) b)
      ((gaussianReal 0 a).map (fun z : ℝ => -z)) := by
    rw [hsym]
    exact hinge_smoothing_integrable center a b
  have h := (integrable_map_measure hi.aestronglyMeasurable (by fun_prop)).mp hi
  change Integrable (fun z : ℝ => hingeLoss (center - -z) b) (gaussianReal 0 a) at h
  simpa only [sub_neg_eq_add] using h

theorem hinge_smoothing_plus (center : ℝ) (a b : ℝ≥0) :
    (∫ z : ℝ, hingeLoss (center + z) b ∂gaussianReal 0 a) =
      hingeLoss center (a + b) := by
  have hsym : (gaussianReal 0 a).map (fun z : ℝ => -z) = gaussianReal 0 a := by
    simpa using (gaussianReal_map_neg (μ := (0 : ℝ)) (v := a))
  have hi : AEStronglyMeasurable (fun z : ℝ => hingeLoss (center - z) b)
      ((gaussianReal 0 a).map (fun z : ℝ => -z)) := by
    rw [hsym]
    exact (hinge_smoothing_integrable center a b).aestronglyMeasurable
  have hm := integral_map (μ := gaussianReal 0 a) (by fun_prop) hi
  rw [hsym] at hm
  simp only [sub_neg_eq_add] at hm
  rw [← hm, hinge_smoothing]

theorem hingeLoss_mono_variance (center : ℝ) (a b : ℝ≥0) (hab : a ≤ b) :
    hingeLoss center a ≤ hingeLoss center b := by
  rcases hab.eq_or_lt with h | h
  · rw [h]
  · by_cases hc : 0 ≤ center
    · exact (hingeLoss_strictMono_variance center hc a b h).le
    · have hneg : 0 ≤ -center := by linarith
      have hs := hingeLoss_strictMono_variance (-center) hneg a b h
      have ha := hingeLoss_reflection center a
      have hb := hingeLoss_reflection center b
      linarith

theorem hingeLoss_max_variance (center : ℝ) (a b : ℝ≥0) :
    hingeLoss center (max a b) = max (hingeLoss center a) (hingeLoss center b) := by
  by_cases h : a ≤ b
  · rw [max_eq_right h, max_eq_right (hingeLoss_mono_variance center a b h)]
  · have h' : b ≤ a := le_of_lt (lt_of_not_ge h)
    rw [max_eq_left h', max_eq_left (hingeLoss_mono_variance center b a h')]

theorem left_formula_integrable (m1 m2 : ℝ) (a b : ℝ≥0) :
    Integrable (fun z : ℝ => m2 + hingeLoss (m2 - (m1 + z)) b) (gaussianReal 0 a) := by
  convert (integrable_const m2).add (hinge_smoothing_integrable (m2 - m1) a b) using 1
  funext z
  simp only [Pi.add_apply]
  congr 1
  congr 1
  ring

theorem right_formula_integrable (m1 m2 : ℝ) (a b : ℝ≥0) :
    Integrable (fun z : ℝ => (m2 + z) + hingeLoss ((m2 + z) - m1) b) (gaussianReal 0 a) := by
  convert ((integrable_const m2).add (gaussian_id_integrable 0 a)).add
    (hinge_smoothing_plus_integrable (m2 - m1) a b) using 1
  funext z
  simp only [Pi.add_apply]
  congr 1
  congr 1
  ring

theorem left_formula_integral (m1 m2 : ℝ) (a b : ℝ≥0) :
    (∫ z : ℝ, m2 + hingeLoss (m2 - (m1 + z)) b ∂gaussianReal 0 a) =
      m2 + hingeLoss (m2 - m1) (a + b) := by
  have hf : (fun z : ℝ => m2 + hingeLoss (m2 - (m1 + z)) b) =
      (fun z : ℝ => m2 + hingeLoss ((m2 - m1) - z) b) := by
    funext z
    congr 1
    congr 1
    ring
  rw [hf, integral_add (integrable_const _) (hinge_smoothing_integrable _ _ _),
    integral_const, hinge_smoothing]
  simp

theorem right_formula_integral (m1 m2 : ℝ) (a b : ℝ≥0) :
    (∫ z : ℝ, (m2 + z) + hingeLoss ((m2 + z) - m1) b ∂gaussianReal 0 a) =
      m2 + hingeLoss (m2 - m1) (a + b) := by
  have hf : (fun z : ℝ => (m2 + z) + hingeLoss ((m2 + z) - m1) b) =
      (fun z : ℝ => (m2 + z) + hingeLoss ((m2 - m1) + z) b) := by
    funext z
    congr 1
    congr 1
    ring
  have hiMean : Integrable (fun z : ℝ => m2 + z) (gaussianReal 0 a) :=
    (integrable_const m2).add (gaussian_id_integrable 0 a)
  have hMean : (∫ z : ℝ, m2 + z ∂gaussianReal 0 a) = m2 := by
    have h := integral_add (integrable_const m2) (gaussian_id_integrable 0 a)
    change (∫ z : ℝ, m2 + z ∂gaussianReal 0 a) = _ at h
    rw [h, integral_const, integral_id_gaussianReal]
    simp
  rw [hf, integral_add hiMean
    (hinge_smoothing_plus_integrable _ _ _),
    hMean, hinge_smoothing_plus]

/-- Exact evaluation of the actual binary Bellman recursion, for every horizon. -/
theorem payoff_eq (k : ℕ) (m1 m2 : ℝ) (c : Counts) :
    payoff k m1 m2 c = m2 + hingeLoss (m2 - m1) (cumulativeVariance k c) := by
  induction k generalizing m1 m2 c with
  | zero =>
    simp only [payoff, cumulativeVariance, hingeLoss, gaussianReal_zero_var, integral_dirac]
    by_cases h : m1 ≤ m2
    · rw [max_eq_right h, max_eq_right (by linarith)]
      ring
    · have h' : m2 ≤ m1 := le_of_lt (lt_of_not_ge h)
      rw [max_eq_left h', max_eq_left (by linarith)]
      ring
  | succ k ih =>
    simp only [payoff, ih, left_formula_integral, right_formula_integral, cumulativeVariance]
    rw [hingeLoss_max_variance, add_max]

theorem left_action_integrable (k : ℕ) (m1 m2 : ℝ) (c : Counts) :
    Integrable (fun z : ℝ => payoff k (m1 + z) m2 (leftStep c))
      (gaussianReal 0 (updateVariance c.n1)) := by
  simp only [payoff_eq]
  exact left_formula_integrable _ _ _ _

theorem right_action_integrable (k : ℕ) (m1 m2 : ℝ) (c : Counts) :
    Integrable (fun z : ℝ => payoff k m1 (m2 + z) (rightStep c))
      (gaussianReal 0 (updateVariance c.n2)) := by
  simp only [payoff_eq]
  exact right_formula_integrable _ _ _ _

theorem cumulativeVariance_horizon_mono (k : ℕ) (c : Counts) :
    cumulativeVariance k c ≤ cumulativeVariance (k + 1) c := by
  induction k generalizing c with
  | zero => exact zero_le _
  | succ k ih =>
    simp only [cumulativeVariance]
    exact max_le_max (add_le_add_left (ih (leftStep c)) _)
      (add_le_add_left (ih (rightStep c)) _)

theorem payoff_horizon_mono (k : ℕ) (m1 m2 : ℝ) (c : Counts) :
    payoff k m1 m2 c ≤ payoff (k + 1) m1 m2 c := by
  rw [payoff_eq, payoff_eq]
  exact add_le_add_left (hingeLoss_mono_variance _ _ _
    (cumulativeVariance_horizon_mono k c)) _

theorem cumulativeVariance_third_irrelevant (k n1 n2 n3 n3' : ℕ) :
    cumulativeVariance k ⟨n1, n2, n3⟩ = cumulativeVariance k ⟨n1, n2, n3'⟩ := by
  induction k generalizing n1 n2 n3 n3' with
  | zero => rfl
  | succ k ih =>
    simp only [cumulativeVariance, leftStep, rightStep]
    rw [ih (n1 + 1) n2 n3 n3', ih n1 (n2 + 1) n3 n3']

theorem payoff_third_irrelevant (k : ℕ) (m1 m2 : ℝ) (n1 n2 n3 n3' : ℕ) :
    payoff k m1 m2 ⟨n1, n2, n3⟩ = payoff k m1 m2 ⟨n1, n2, n3'⟩ := by
  rw [payoff_eq, payoff_eq, cumulativeVariance_third_irrelevant]

theorem balancedStep_max (c : Counts) :
    max (balancedStep c).n1 (balancedStep c).n2 =
      max (max c.n1 c.n2) ((c.n1 + c.n2 + 2) / 2) := by
  unfold balancedStep
  split_ifs <;> simp only <;> omega

/-- The largest final count under greedy balancing has the smallest value
allowed by the initial counts and the final total. -/
theorem balancedRun_max (k : ℕ) (c : Counts) :
    max (balancedRun k c).n1 (balancedRun k c).n2 =
      max (max c.n1 c.n2) ((c.n1 + c.n2 + k + 1) / 2) := by
  induction k generalizing c with
  | zero => simp only [balancedRun]; omega
  | succ k ih =>
    rw [balancedRun, ih, balancedStep_max, balancedStep_sum]
    omega

theorem balancedRun_max_le_allocation (k : ℕ) (c : Counts) (a b : ℕ)
    (ha : c.n1 ≤ a) (hb : c.n2 ≤ b) (hs : a + b = c.n1 + c.n2 + k) :
    max (balancedRun k c).n1 (balancedRun k c).n2 ≤ max a b := by
  rw [balancedRun_max]
  omega

theorem product_le_of_same_sum_max {a b x y : ℝ}
    (hs : a + b = x + y) (hm : max a b ≤ max x y) : x * y ≤ a * b := by
  by_cases hab : a ≤ b <;> by_cases hxy : x ≤ y
  · rw [max_eq_right hab, max_eq_right hxy] at hm
    have hxb : x ≤ b := by linarith
    have hp := mul_nonneg (sub_nonneg.mpr hm) (sub_nonneg.mpr hxb)
    nlinarith [congrArg (fun z : ℝ => z * b) hs]
  · have hyx : y ≤ x := le_of_lt (lt_of_not_ge hxy)
    rw [max_eq_right hab, max_eq_left hyx] at hm
    have hyb : y ≤ b := by linarith
    have hp := mul_nonneg (sub_nonneg.mpr hm) (sub_nonneg.mpr hyb)
    nlinarith [congrArg (fun z : ℝ => z * b) hs]
  · have hba : b ≤ a := le_of_lt (lt_of_not_ge hab)
    rw [max_eq_left hba, max_eq_right hxy] at hm
    have hxa : x ≤ a := by linarith
    have hp := mul_nonneg (sub_nonneg.mpr hm) (sub_nonneg.mpr hxa)
    nlinarith [congrArg (fun z : ℝ => z * a) hs]
  · have hba : b ≤ a := le_of_lt (lt_of_not_ge hab)
    have hyx : y ≤ x := le_of_lt (lt_of_not_ge hxy)
    rw [max_eq_left hba, max_eq_left hyx] at hm
    have hya : y ≤ a := by linarith
    have hp := mul_nonneg (sub_nonneg.mpr hm) (sub_nonneg.mpr hya)
    nlinarith [congrArg (fun z : ℝ => z * a) hs]

/-- Greedy balancing minimizes terminal posterior variance over every
allocation of the remaining observations. -/
theorem balancedRun_variance_le_allocation (k : ℕ) (c : Counts) (a b : ℕ)
    (h1 : 0 < c.n1) (h2 : 0 < c.n2) (ha : c.n1 ≤ a) (hb : c.n2 ≤ b)
    (hs : a + b = c.n1 + c.n2 + k) :
    variance (balancedRun k c) ≤ posteriorVariance a b := by
  have hmono := balancedRun_monotone k c
  have hsum := balancedRun_sum k c
  have hmax := balancedRun_max_le_allocation k c a b ha hb hs
  have hsumR : ((balancedRun k c).n1 : ℝ) + ((balancedRun k c).n2 : ℝ) =
      (a : ℝ) + b := by exact_mod_cast (hsum.trans hs.symm)
  have hmaxR : max ((balancedRun k c).n1 : ℝ) ((balancedRun k c).n2 : ℝ) ≤
      max (a : ℝ) (b : ℝ) := by exact_mod_cast hmax
  have hprod := product_le_of_same_sum_max hsumR hmaxR
  have hp1 : 0 < ((balancedRun k c).n1 : ℝ) := by
    exact_mod_cast (show 0 < (balancedRun k c).n1 by omega)
  have hp2 : 0 < ((balancedRun k c).n2 : ℝ) := by
    exact_mod_cast (show 0 < (balancedRun k c).n2 by omega)
  have hpa : 0 < (a : ℝ) := by exact_mod_cast (show 0 < a by omega)
  have hpb : 0 < (b : ℝ) := by exact_mod_cast (show 0 < b by omega)
  have hleft : ((balancedRun k c).n1 : ℝ)⁻¹ + ((balancedRun k c).n2 : ℝ)⁻¹ =
      (((balancedRun k c).n1 : ℝ) + ((balancedRun k c).n2 : ℝ)) /
        (((balancedRun k c).n1 : ℝ) * ((balancedRun k c).n2 : ℝ)) := by
    field_simp
    ring
  have hright : (a : ℝ)⁻¹ + (b : ℝ)⁻¹ = ((a : ℝ) + b) / ((a : ℝ) * b) := by
    field_simp
    ring
  change ((balancedRun k c).n1 : ℝ)⁻¹ + ((balancedRun k c).n2 : ℝ)⁻¹ ≤
    (a : ℝ)⁻¹ + (b : ℝ)⁻¹
  rw [hleft, hright, hsumR]
  exact div_le_div_of_nonneg_left (by positivity) (mul_pos hpa hpb) hprod

def balancedInnovation (c : Counts) : ℝ≥0 :=
  if c.n1 ≤ c.n2 then updateVariance c.n1 else updateVariance c.n2

def balancedCumulative : ℕ → Counts → ℝ≥0
  | 0, _ => 0
  | k + 1, c => balancedInnovation c + balancedCumulative k (balancedStep c)

theorem leftStep_variance (c : Counts) (h1 : 0 < c.n1) :
    variance c = updateVariance c.n1 + variance (leftStep c) := by
  simpa only [variance, leftStep, Nat.cast_add, Nat.cast_one] using
    posteriorVariance_after_draw (c.n1 : ℝ≥0) (c.n2 : ℝ≥0) (by exact_mod_cast h1)

theorem rightStep_variance (c : Counts) (h2 : 0 < c.n2) :
    variance c = updateVariance c.n2 + variance (rightStep c) := by
  have h := posteriorVariance_after_draw (c.n2 : ℝ≥0) (c.n1 : ℝ≥0)
    (by exact_mod_cast h2)
  rw [posteriorVariance_comm (c.n2 : ℝ≥0) (c.n1 : ℝ≥0),
    posteriorVariance_comm ((c.n2 : ℝ≥0) + 1) (c.n1 : ℝ≥0)] at h
  simpa only [variance, rightStep, Nat.cast_add, Nat.cast_one] using h

theorem balancedStep_variance (c : Counts) (h1 : 0 < c.n1) (h2 : 0 < c.n2) :
    variance c = balancedInnovation c + variance (balancedStep c) := by
  by_cases h : c.n1 ≤ c.n2
  · simpa only [balancedInnovation, balancedStep, if_pos h, leftStep] using leftStep_variance c h1
  · simpa only [balancedInnovation, balancedStep, if_neg h, rightStep] using rightStep_variance c h2

/-- Independent mean innovations telescope exactly against terminal
posterior variance along the greedy policy. -/
theorem balancedCumulative_decomposition (k : ℕ) (c : Counts)
    (h1 : 0 < c.n1) (h2 : 0 < c.n2) :
    balancedCumulative k c + variance (balancedRun k c) = variance c := by
  induction k generalizing c with
  | zero => simp only [balancedCumulative, balancedRun, zero_add]
  | succ k ih =>
    have hmono := balancedStep_monotone c
    have hi := ih (balancedStep c) (by omega) (by omega)
    rw [balancedCumulative, balancedRun, add_assoc, hi]
    exact (balancedStep_variance c h1 h2).symm

theorem left_balanced_variance_le (k : ℕ) (c : Counts)
    (h1 : 0 < c.n1) (h2 : 0 < c.n2) :
    variance (balancedRun (k + 1) c) ≤ variance (balancedRun k (leftStep c)) := by
  have hmono := balancedRun_monotone k (leftStep c)
  have hsum := balancedRun_sum k (leftStep c)
  apply balancedRun_variance_le_allocation (k + 1) c _ _ h1 h2
  · exact (Nat.le_succ c.n1).trans hmono.1
  · exact hmono.2
  · change (balancedRun k (leftStep c)).n1 + (balancedRun k (leftStep c)).n2 =
      (c.n1 + 1) + c.n2 + k at hsum
    omega

theorem right_balanced_variance_le (k : ℕ) (c : Counts)
    (h1 : 0 < c.n1) (h2 : 0 < c.n2) :
    variance (balancedRun (k + 1) c) ≤ variance (balancedRun k (rightStep c)) := by
  have hmono := balancedRun_monotone k (rightStep c)
  have hsum := balancedRun_sum k (rightStep c)
  apply balancedRun_variance_le_allocation (k + 1) c _ _ h1 h2
  · exact hmono.1
  · exact (Nat.le_succ c.n2).trans hmono.2
  · change (balancedRun k (rightStep c)).n1 + (balancedRun k (rightStep c)).n2 =
      c.n1 + (c.n2 + 1) + k at hsum
    omega

theorem left_balancedCumulative_le (k : ℕ) (c : Counts)
    (h1 : 0 < c.n1) (h2 : 0 < c.n2) :
    updateVariance c.n1 + balancedCumulative k (leftStep c) ≤
      balancedCumulative (k + 1) c := by
  have hl := balancedCumulative_decomposition k (leftStep c)
    (by simp only [leftStep]; omega) (by simpa only [leftStep] using h2)
  have hd : (updateVariance c.n1 + balancedCumulative k (leftStep c)) +
      variance (balancedRun k (leftStep c)) = variance c := by
    rw [add_assoc, hl, ← leftStep_variance c h1]
  have hb := balancedCumulative_decomposition (k + 1) c h1 h2
  have hf := left_balanced_variance_le k c h1 h2
  apply (add_le_add_iff_right (variance (balancedRun (k + 1) c))).mp
  calc
    _ ≤ (updateVariance c.n1 + balancedCumulative k (leftStep c)) +
        variance (balancedRun k (leftStep c)) := add_le_add_left hf _
    _ = _ := hd.trans hb.symm

theorem right_balancedCumulative_le (k : ℕ) (c : Counts)
    (h1 : 0 < c.n1) (h2 : 0 < c.n2) :
    updateVariance c.n2 + balancedCumulative k (rightStep c) ≤
      balancedCumulative (k + 1) c := by
  have hr := balancedCumulative_decomposition k (rightStep c)
    (by simpa only [rightStep] using h1) (by simp only [rightStep]; omega)
  have hd : (updateVariance c.n2 + balancedCumulative k (rightStep c)) +
      variance (balancedRun k (rightStep c)) = variance c := by
    rw [add_assoc, hr, ← rightStep_variance c h2]
  have hb := balancedCumulative_decomposition (k + 1) c h1 h2
  have hf := right_balanced_variance_le k c h1 h2
  apply (add_le_add_iff_right (variance (balancedRun (k + 1) c))).mp
  calc
    _ ≤ (updateVariance c.n2 + balancedCumulative k (rightStep c)) +
        variance (balancedRun k (rightStep c)) := add_le_add_left hf _
    _ = _ := hd.trans hb.symm

/-- The variance maximization arising from the actual Bellman recursion is
achieved by the deterministic smaller-count rule. -/
theorem cumulativeVariance_eq_balancedCumulative (k : ℕ) (c : Counts)
    (h1 : 0 < c.n1) (h2 : 0 < c.n2) :
    cumulativeVariance k c = balancedCumulative k c := by
  induction k generalizing c with
  | zero => rfl
  | succ k ih =>
    rw [cumulativeVariance,
      ih (leftStep c) (by simp only [leftStep]; omega) (by simpa only [leftStep] using h2),
      ih (rightStep c) (by simpa only [rightStep] using h1) (by simp only [rightStep]; omega)]
    apply le_antisymm
    · exact max_le (left_balancedCumulative_le k c h1 h2) (right_balancedCumulative_le k c h1 h2)
    · by_cases h : c.n1 ≤ c.n2
      · simp only [balancedCumulative, balancedInnovation, balancedStep, if_pos h]
        exact le_max_left _ _
      · simp only [balancedCumulative, balancedInnovation, balancedStep, if_neg h]
        exact le_max_right _ _

def balancedPayoff : ℕ → ℝ → ℝ → Counts → ℝ
  | 0, m1, m2, _ => max m1 m2
  | k + 1, m1, m2, c =>
    if c.n1 ≤ c.n2 then
      ∫ z : ℝ, balancedPayoff k (m1 + z) m2 (leftStep c) ∂gaussianReal 0 (updateVariance c.n1)
    else
      ∫ z : ℝ, balancedPayoff k m1 (m2 + z) (rightStep c) ∂gaussianReal 0 (updateVariance c.n2)

theorem balancedPayoff_eq (k : ℕ) (m1 m2 : ℝ) (c : Counts) :
    balancedPayoff k m1 m2 c = m2 + hingeLoss (m2 - m1) (balancedCumulative k c) := by
  induction k generalizing m1 m2 c with
  | zero =>
    have h := payoff_eq 0 m1 m2 c
    simpa only [payoff, cumulativeVariance, balancedPayoff, balancedCumulative] using h
  | succ k ih =>
    simp only [balancedPayoff, ih, left_formula_integral, right_formula_integral]
    by_cases h : c.n1 ≤ c.n2
    · simp only [if_pos h, balancedCumulative, balancedInnovation, balancedStep]
      rfl
    · simp only [if_neg h, balancedCumulative, balancedInnovation, balancedStep]
      rfl

/-- Full finite-horizon two-arm optimality (corrected Lemma 16), proved
against the actual recursive Bellman maximum rather than assumed. -/
theorem balanced_policy_optimal (k : ℕ) (m1 m2 : ℝ) (c : Counts)
    (h1 : 0 < c.n1) (h2 : 0 < c.n2) :
    balancedPayoff k m1 m2 c = payoff k m1 m2 c := by
  rw [balancedPayoff_eq, payoff_eq, cumulativeVariance_eq_balancedCumulative k c h1 h2]

theorem payoff_eq_balanced_formula (k : ℕ) (m1 m2 : ℝ) (c : Counts)
    (h1 : 0 < c.n1) (h2 : 0 < c.n2) :
    payoff k m1 m2 c = m2 + hingeLoss (m2 - m1) (balancedCumulative k c) := by
  rw [payoff_eq, cumulativeVariance_eq_balancedCumulative k c h1 h2]

/-- The exact multiround Gaussian variance used by Lemma 17 is certified
for the optimal two-arm policy. -/
theorem cumulativeVariance_eq_transitionVariance (k : ℕ) (c : Counts)
    (h1 : 0 < c.n1) (h2 : 0 < c.n2) :
    (cumulativeVariance k c : ℝ) = transitionVariance k c := by
  have hd := balancedCumulative_decomposition k c h1 h2
  have hdR := congrArg (fun x : ℝ≥0 => (x : ℝ)) hd
  rw [cumulativeVariance_eq_balancedCumulative k c h1 h2]
  simp only [NNReal.coe_add, variance, posteriorVariance, NNReal.coe_inv, NNReal.coe_natCast] at hdR
  unfold transitionVariance
  simp only [one_div]
  linarith

def leftAction (k : ℕ) (m1 m2 : ℝ) (c : Counts) : ℝ :=
  ∫ z : ℝ, payoff k (m1 + z) m2 (leftStep c) ∂gaussianReal 0 (updateVariance c.n1)

def rightAction (k : ℕ) (m1 m2 : ℝ) (c : Counts) : ℝ :=
  ∫ z : ℝ, payoff k m1 (m2 + z) (rightStep c) ∂gaussianReal 0 (updateVariance c.n2)

theorem leftAction_eq (k : ℕ) (m1 m2 : ℝ) (c : Counts) :
    leftAction k m1 m2 c = m2 + hingeLoss (m2 - m1)
      (updateVariance c.n1 + cumulativeVariance k (leftStep c)) := by
  unfold leftAction
  simp only [payoff_eq]
  exact left_formula_integral _ _ _ _

theorem rightAction_eq (k : ℕ) (m1 m2 : ℝ) (c : Counts) :
    rightAction k m1 m2 c = m2 + hingeLoss (m2 - m1)
      (updateVariance c.n2 + cumulativeVariance k (rightStep c)) := by
  unfold rightAction
  simp only [payoff_eq]
  exact right_formula_integral _ _ _ _

theorem smaller_count_left_optimal (k : ℕ) (m1 m2 : ℝ) (c : Counts)
    (h1 : 0 < c.n1) (h2 : 0 < c.n2) (h : c.n1 ≤ c.n2) :
    payoff (k + 1) m1 m2 c = leftAction k m1 m2 c := by
  rw [payoff_eq_balanced_formula _ _ _ _ h1 h2, leftAction_eq,
    cumulativeVariance_eq_balancedCumulative k (leftStep c)
      (by simp only [leftStep]; omega) (by simpa only [leftStep] using h2)]
  simp only [balancedCumulative, balancedInnovation, balancedStep, if_pos h]
  rfl

theorem smaller_count_right_optimal (k : ℕ) (m1 m2 : ℝ) (c : Counts)
    (h1 : 0 < c.n1) (h2 : 0 < c.n2) (h : c.n2 < c.n1) :
    payoff (k + 1) m1 m2 c = rightAction k m1 m2 c := by
  have hn : ¬ c.n1 ≤ c.n2 := by omega
  rw [payoff_eq_balanced_formula _ _ _ _ h1 h2, rightAction_eq,
    cumulativeVariance_eq_balancedCumulative k (rightStep c)
      (by simpa only [rightStep] using h1) (by simp only [rightStep]; omega)]
  simp only [balancedCumulative, balancedInnovation, balancedStep, if_neg hn]
  rfl

end

end BayesOptimal.Foundations.TwoArmBellman

end

/-! ## Foundations.ThreeArmComparison -/
section

/-!
Perfect-information slack for adding a third arm to the two-arm Bellman
problem. The slack is the genuine posterior expectation of the positive
part of the third arm's advantage over the first. It is preserved in
expectation by either arm's Gaussian posterior innovation.
-/

open MeasureTheory ProbabilityTheory
open scoped MeasureTheory NNReal ENNReal

namespace BayesOptimal.Foundations.ThreeArmComparison

open BayesOptimal.Foundations.Gaussian

noncomputable section

theorem hingeLoss_shift_integrable (center : ℝ) (innovation residual : ℝ≥0) :
    Integrable (fun z : ℝ => hingeLoss (center - z) residual)
      (gaussianReal 0 innovation) := by
  have hconv : gaussianReal 0 innovation ∗ gaussianReal 0 residual =
      gaussianReal 0 (innovation + residual) := by
    simpa using gaussianReal_conv_gaussianReal (m₁ := (0 : ℝ)) (m₂ := (0 : ℝ))
      (v₁ := innovation) (v₂ := residual)
  have hi : Integrable (fun x : ℝ => max (x - center) 0)
      (gaussianReal 0 innovation ∗ gaussianReal 0 residual) := by
    rw [hconv]
    exact hinge_integrable center (innovation + residual)
  have h := (integrable_conv_iff hi.aestronglyMeasurable).mp hi
  have hf : (fun z : ℝ => ∫ r : ℝ, ‖max (z + r - center) 0‖
      ∂gaussianReal 0 residual) = (fun z : ℝ => hingeLoss (center - z) residual) := by
    funext z
    unfold hingeLoss
    congr 1
    funext r
    rw [Real.norm_eq_abs, abs_of_nonneg (le_max_right _ _)]
    congr 1
    ring
  rw [hf] at h
  exact h.2

theorem hingeLoss_shift_tower (center : ℝ) (innovation residual : ℝ≥0) :
    (∫ z : ℝ, hingeLoss (center - z) residual ∂gaussianReal 0 innovation) =
      hingeLoss center (innovation + residual) := by
  have hconv : gaussianReal 0 innovation ∗ gaussianReal 0 residual =
      gaussianReal 0 (innovation + residual) := by
    simpa using gaussianReal_conv_gaussianReal (m₁ := (0 : ℝ)) (m₂ := (0 : ℝ))
      (v₁ := innovation) (v₂ := residual)
  have hi : Integrable (fun x : ℝ => max (x - center) 0)
      (gaussianReal 0 innovation ∗ gaussianReal 0 residual) := by
    rw [hconv]
    exact hinge_integrable center (innovation + residual)
  unfold hingeLoss
  rw [← hconv, integral_conv hi]
  congr 1
  funext z
  congr 1
  funext r
  congr 1
  ring

theorem hingeLoss_add_integrable (center : ℝ) (innovation residual : ℝ≥0) :
    Integrable (fun z : ℝ => hingeLoss (center + z) residual)
      (gaussianReal 0 innovation) := by
  have hsym : (gaussianReal 0 innovation).map (fun z : ℝ => -z) =
      gaussianReal 0 innovation := by simpa using gaussianReal_map_neg (μ := (0 : ℝ))
  have h := hingeLoss_shift_integrable center innovation residual
  rw [← hsym] at h
  have hh := h.comp_measurable (by fun_prop)
  simpa only [Function.comp_def, sub_neg_eq_add] using hh

theorem hingeLoss_add_tower (center : ℝ) (innovation residual : ℝ≥0) :
    (∫ z : ℝ, hingeLoss (center + z) residual ∂gaussianReal 0 innovation) =
      hingeLoss center (innovation + residual) := by
  have hsym : (gaussianReal 0 innovation).map (fun z : ℝ => -z) =
      gaussianReal 0 innovation := by simpa using gaussianReal_map_neg (μ := (0 : ℝ))
  have hi := hingeLoss_shift_integrable center innovation residual
  have hm := hi.aestronglyMeasurable
  rw [← hsym] at hm
  have htower := hingeLoss_shift_tower center innovation residual
  calc
    (∫ z : ℝ, hingeLoss (center + z) residual ∂gaussianReal 0 innovation) =
        ∫ z : ℝ, hingeLoss (center - z) residual
          ∂((gaussianReal 0 innovation).map (fun z : ℝ => -z)) := by
      rw [integral_map (by fun_prop) hm]
      simp only [sub_neg_eq_add]
    _ = hingeLoss center (innovation + residual) := by rw [hsym]; exact htower

theorem positivePart_le_hingeLoss (center : ℝ) (variance : ℝ≥0) :
    max (-center) 0 ≤ hingeLoss center variance := by
  apply max_le
  · have h := hingeLoss_reflection center variance
    have hn := hingeLoss_nonnegative (-center) variance
    linarith
  · exact hingeLoss_nonnegative center variance

/-- Genuine posterior expected positive advantage of arm 3 over arm 1. -/
def slack (mean1 mean3 : ℝ) (count1 count3 : ℕ) : ℝ :=
  hingeLoss (mean1 - mean3) (posteriorVariance (count1 : ℝ≥0) (count3 : ℝ≥0))

theorem slack_nonnegative (mean1 mean3 : ℝ) (count1 count3 : ℕ) :
    0 ≤ slack mean1 mean3 count1 count3 := hingeLoss_nonnegative _ _

theorem slack_bounds_terminal (mean1 mean2 mean3 : ℝ) (count1 count3 : ℕ) :
    max mean1 (max mean2 mean3) ≤
      max mean1 mean2 + slack mean1 mean3 count1 count3 := by
  have hs := positivePart_le_hingeLoss (mean1 - mean3)
    (posteriorVariance (count1 : ℝ≥0) (count3 : ℝ≥0))
  change max (-(mean1 - mean3)) 0 ≤ slack mean1 mean3 count1 count3 at hs
  have hs0 := slack_nonnegative mean1 mean3 count1 count3
  have hm1 := le_max_left mean1 mean2
  have hm2 := le_max_right mean1 mean2
  have hm3 := le_max_left (-(mean1 - mean3)) (0 : ℝ)
  apply max_le
  · linarith
  · apply max_le <;> linarith

theorem slack_first_draw_integrable (mean1 mean3 : ℝ) (count1 count3 : ℕ) :
    Integrable (fun z : ℝ => slack (mean1 + z) mean3 (count1 + 1) count3)
      (gaussianReal 0 (updateVariance (count1 : ℝ≥0))) := by
  have h := hingeLoss_add_integrable (mean1 - mean3) (updateVariance (count1 : ℝ≥0))
    (posteriorVariance ((count1 + 1 : ℕ) : ℝ≥0) (count3 : ℝ≥0))
  unfold slack
  convert h using 1
  funext z
  congr 1
  ring

theorem slack_first_draw_tower (mean1 mean3 : ℝ) (count1 count3 : ℕ)
    (hc1 : 0 < count1) :
    (∫ z : ℝ, slack (mean1 + z) mean3 (count1 + 1) count3
      ∂gaussianReal 0 (updateVariance (count1 : ℝ≥0))) =
        slack mean1 mean3 count1 count3 := by
  have h := hingeLoss_add_tower (mean1 - mean3) (updateVariance (count1 : ℝ≥0))
    (posteriorVariance ((count1 + 1 : ℕ) : ℝ≥0) (count3 : ℝ≥0))
  have hv := posteriorVariance_after_draw (count1 : ℝ≥0) (count3 : ℝ≥0)
    (by exact_mod_cast hc1)
  push_cast at h
  rw [← hv] at h
  unfold slack
  push_cast
  convert h using 1
  congr 1
  funext z
  congr 1
  ring

theorem slack_third_draw_integrable (mean1 mean3 : ℝ) (count1 count3 : ℕ) :
    Integrable (fun z : ℝ => slack mean1 (mean3 + z) count1 (count3 + 1))
      (gaussianReal 0 (updateVariance (count3 : ℝ≥0))) := by
  have h := hingeLoss_shift_integrable (mean1 - mean3) (updateVariance (count3 : ℝ≥0))
    (posteriorVariance (count1 : ℝ≥0) ((count3 + 1 : ℕ) : ℝ≥0))
  unfold slack
  convert h using 1
  funext z
  congr 1
  ring

theorem slack_third_draw_tower (mean1 mean3 : ℝ) (count1 count3 : ℕ)
    (hc3 : 0 < count3) :
    (∫ z : ℝ, slack mean1 (mean3 + z) count1 (count3 + 1)
      ∂gaussianReal 0 (updateVariance (count3 : ℝ≥0))) =
        slack mean1 mean3 count1 count3 := by
  have h := hingeLoss_shift_tower (mean1 - mean3) (updateVariance (count3 : ℝ≥0))
    (posteriorVariance (count1 : ℝ≥0) ((count3 + 1 : ℕ) : ℝ≥0))
  have hv := posteriorVariance_after_draw (count3 : ℝ≥0) (count1 : ℝ≥0)
    (by exact_mod_cast hc3)
  push_cast at h
  have hvdesired : updateVariance (count3 : ℝ≥0) +
      posteriorVariance (count1 : ℝ≥0) ((count3 : ℝ≥0) + 1) =
        posteriorVariance (count1 : ℝ≥0) (count3 : ℝ≥0) := by
    rw [posteriorVariance_comm (count1 : ℝ≥0) ((count3 : ℝ≥0) + 1), ← hv,
      posteriorVariance_comm (count3 : ℝ≥0) (count1 : ℝ≥0)]
  rw [hvdesired] at h
  unfold slack
  push_cast
  convert h using 1
  congr 1
  funext z
  congr 1
  ring

abbrev ModelCounts := BayesOptimal.Foundations.BayesianModel.Counts
abbrev ModelMeans := BayesOptimal.Foundations.BayesianModel.Means
abbrev ModelArm := BayesOptimal.Foundations.BayesianModel.Arm

def projectCounts (c : ModelCounts) : BayesOptimal.Foundations.Counts.Counts := ⟨c 0, c 1, 0⟩

def twoValue (k : ℕ) (c : ModelCounts) (m : ModelMeans) : ℝ :=
  BayesOptimal.Foundations.TwoArmBellman.payoff k (m 0) (m 1) (projectCounts c)

def twoAction (k : ℕ) (c : ModelCounts) (m : ModelMeans) (i : ModelArm) : ℝ :=
  ∫ z : ℝ, twoValue k (BayesOptimal.Foundations.BayesianModel.advance c i)
      (BayesOptimal.Foundations.BayesianModel.shift m i z)
    ∂gaussianReal 0 (BayesOptimal.Foundations.BayesianModel.innovation c i)

def stateSlack (c : ModelCounts) (m : ModelMeans) : ℝ := slack (m 0) (m 2) (c 0) (c 2)

theorem twoAction_zero (k : ℕ) (c : ModelCounts) (m : ModelMeans) :
    twoAction k c m 0 = ∫ z : ℝ,
      BayesOptimal.Foundations.TwoArmBellman.payoff k (m 0 + z) (m 1)
        (BayesOptimal.Foundations.TwoArmBellman.leftStep (projectCounts c))
      ∂gaussianReal 0 (updateVariance (c 0 : ℝ≥0)) := by
  simp [twoAction, twoValue, projectCounts, BayesOptimal.Foundations.TwoArmBellman.leftStep,
    BayesOptimal.Foundations.BayesianModel.advance, BayesOptimal.Foundations.BayesianModel.shift, BayesOptimal.Foundations.BayesianModel.innovation]

theorem twoAction_one (k : ℕ) (c : ModelCounts) (m : ModelMeans) :
    twoAction k c m 1 = ∫ z : ℝ,
      BayesOptimal.Foundations.TwoArmBellman.payoff k (m 0) (m 1 + z)
        (BayesOptimal.Foundations.TwoArmBellman.rightStep (projectCounts c))
      ∂gaussianReal 0 (updateVariance (c 1 : ℝ≥0)) := by
  simp [twoAction, twoValue, projectCounts, BayesOptimal.Foundations.TwoArmBellman.rightStep,
    BayesOptimal.Foundations.BayesianModel.advance, BayesOptimal.Foundations.BayesianModel.shift, BayesOptimal.Foundations.BayesianModel.innovation]

theorem twoAction_two (k : ℕ) (c : ModelCounts) (m : ModelMeans) :
    twoAction k c m 2 = twoValue k c m := by
  simp [twoAction, twoValue, projectCounts, BayesOptimal.Foundations.BayesianModel.advance,
    BayesOptimal.Foundations.BayesianModel.shift]

theorem twoValue_succ (k : ℕ) (c : ModelCounts) (m : ModelMeans) :
    twoValue (k + 1) c m = max (twoAction k c m 0) (twoAction k c m 1) := by
  rw [twoAction_zero, twoAction_one]
  rfl

theorem twoAction_integrable (k : ℕ) (c : ModelCounts) (m : ModelMeans) (i : ModelArm) :
    Integrable (fun z : ℝ => twoValue k (BayesOptimal.Foundations.BayesianModel.advance c i)
      (BayesOptimal.Foundations.BayesianModel.shift m i z))
      (gaussianReal 0 (BayesOptimal.Foundations.BayesianModel.innovation c i)) := by
  fin_cases i
  · simpa [twoValue, projectCounts, BayesOptimal.Foundations.BayesianModel.advance,
      BayesOptimal.Foundations.BayesianModel.shift, BayesOptimal.Foundations.BayesianModel.innovation,
      BayesOptimal.Foundations.TwoArmBellman.leftStep] using
      BayesOptimal.Foundations.TwoArmBellman.left_action_integrable k (m 0) (m 1) (projectCounts c)
  · simpa [twoValue, projectCounts, BayesOptimal.Foundations.BayesianModel.advance,
      BayesOptimal.Foundations.BayesianModel.shift, BayesOptimal.Foundations.BayesianModel.innovation,
      BayesOptimal.Foundations.TwoArmBellman.rightStep] using
      BayesOptimal.Foundations.TwoArmBellman.right_action_integrable k (m 0) (m 1) (projectCounts c)
  · simp [twoValue, projectCounts, BayesOptimal.Foundations.BayesianModel.advance,
      BayesOptimal.Foundations.BayesianModel.shift]

theorem twoAction_le_next_value (k : ℕ) (c : ModelCounts) (m : ModelMeans) (i : ModelArm) :
    twoAction k c m i ≤ twoValue (k + 1) c m := by
  fin_cases i
  · rw [twoValue_succ]; exact le_max_left _ _
  · rw [twoValue_succ]; exact le_max_right _ _
  · change twoAction k c m 2 ≤ twoValue (k + 1) c m
    rw [twoAction_two]
    exact BayesOptimal.Foundations.TwoArmBellman.payoff_horizon_mono k (m 0) (m 1) (projectCounts c)

theorem stateSlack_integrable (c : ModelCounts) (m : ModelMeans) (i : ModelArm) :
    Integrable (fun z : ℝ => stateSlack (BayesOptimal.Foundations.BayesianModel.advance c i)
      (BayesOptimal.Foundations.BayesianModel.shift m i z))
      (gaussianReal 0 (BayesOptimal.Foundations.BayesianModel.innovation c i)) := by
  fin_cases i
  · simpa [stateSlack, BayesOptimal.Foundations.BayesianModel.advance, BayesOptimal.Foundations.BayesianModel.shift,
      BayesOptimal.Foundations.BayesianModel.innovation] using slack_first_draw_integrable (m 0) (m 2) (c 0) (c 2)
  · simp [stateSlack, BayesOptimal.Foundations.BayesianModel.advance, BayesOptimal.Foundations.BayesianModel.shift]
  · simpa [stateSlack, BayesOptimal.Foundations.BayesianModel.advance, BayesOptimal.Foundations.BayesianModel.shift,
      BayesOptimal.Foundations.BayesianModel.innovation] using slack_third_draw_integrable (m 0) (m 2) (c 0) (c 2)

theorem stateSlack_tower (c : ModelCounts) (m : ModelMeans) (i : ModelArm)
    (hc : ∀ j, 0 < c j) :
    (∫ z : ℝ, stateSlack (BayesOptimal.Foundations.BayesianModel.advance c i)
      (BayesOptimal.Foundations.BayesianModel.shift m i z)
      ∂gaussianReal 0 (BayesOptimal.Foundations.BayesianModel.innovation c i)) = stateSlack c m := by
  fin_cases i
  · simpa [stateSlack, BayesOptimal.Foundations.BayesianModel.advance, BayesOptimal.Foundations.BayesianModel.shift,
      BayesOptimal.Foundations.BayesianModel.innovation] using
      slack_first_draw_tower (m 0) (m 2) (c 0) (c 2) (hc 0)
  · simp [stateSlack, BayesOptimal.Foundations.BayesianModel.advance, BayesOptimal.Foundations.BayesianModel.shift]
  · simpa [stateSlack, BayesOptimal.Foundations.BayesianModel.advance, BayesOptimal.Foundations.BayesianModel.shift,
      BayesOptimal.Foundations.BayesianModel.innovation] using
      slack_third_draw_tower (m 0) (m 2) (c 0) (c 2) (hc 2)

theorem positive_advance (c : ModelCounts) (hc : ∀ j, 0 < c j) (i : ModelArm) :
    ∀ j, 0 < BayesOptimal.Foundations.BayesianModel.advance c i j := by
  intro j
  have h := hc j
  unfold BayesOptimal.Foundations.BayesianModel.advance
  omega

/-- Exact dynamic-programming perturbation bound, derived by Bellman induction. -/
theorem value_comparison (k : ℕ) (c : ModelCounts) (m : ModelMeans)
    (hc : ∀ j, 0 < c j) :
    twoValue k c m ≤ BayesOptimal.Foundations.BayesianModel.value k c m ∧
      BayesOptimal.Foundations.BayesianModel.value k c m ≤ twoValue k c m + stateSlack c m := by
  induction k generalizing c m with
  | zero =>
      constructor
      · change max (m 0) (m 1) ≤ max (m 0) (max (m 1) (m 2))
        exact max_le_max le_rfl (le_max_left _ _)
      · exact slack_bounds_terminal (m 0) (m 1) (m 2) (c 0) (c 2)
  | succ k ih =>
      have ha (i : ModelArm) :
          twoAction k c m i ≤ BayesOptimal.Foundations.BayesianModel.action k c m i ∧
          BayesOptimal.Foundations.BayesianModel.action k c m i ≤ twoAction k c m i + stateSlack c m := by
        have hlower := integral_mono (twoAction_integrable k c m i)
          (BayesOptimal.Foundations.BayesianModel.action_integrable k c m i)
          (fun z => (ih (BayesOptimal.Foundations.BayesianModel.advance c i)
            (BayesOptimal.Foundations.BayesianModel.shift m i z) (positive_advance c hc i)).1)
        have hupper := integral_mono (BayesOptimal.Foundations.BayesianModel.action_integrable k c m i)
          ((twoAction_integrable k c m i).add (stateSlack_integrable c m i))
          (fun z => (ih (BayesOptimal.Foundations.BayesianModel.advance c i)
            (BayesOptimal.Foundations.BayesianModel.shift m i z) (positive_advance c hc i)).2)
        simp only [Pi.add_apply] at hupper
        rw [integral_add (twoAction_integrable k c m i) (stateSlack_integrable c m i),
          stateSlack_tower c m i hc] at hupper
        exact ⟨hlower, hupper⟩
      constructor
      · rw [twoValue_succ]
        exact max_le ((ha 0).1.trans (BayesOptimal.Foundations.BayesianModel.action_le_value k c m 0))
          ((ha 1).1.trans (BayesOptimal.Foundations.BayesianModel.action_le_value k c m 1))
      · rw [BayesOptimal.Foundations.BayesianModel.value_succ]
        have hb (i : ModelArm) : BayesOptimal.Foundations.BayesianModel.action k c m i ≤
            twoValue (k + 1) c m + stateSlack c m :=
          (ha i).2.trans (add_le_add_right (twoAction_le_next_value k c m i) _)
        exact max_le (hb 0) (max_le (hb 1) (hb 2))

/-- Every actual three-arm Bellman action is between its binary value and that value plus slack. -/
theorem action_comparison (k : ℕ) (c : ModelCounts) (m : ModelMeans) (i : ModelArm)
    (hc : ∀ j, 0 < c j) :
    twoAction k c m i ≤ BayesOptimal.Foundations.BayesianModel.action k c m i ∧
      BayesOptimal.Foundations.BayesianModel.action k c m i ≤ twoAction k c m i + stateSlack c m := by
  have hlower := integral_mono (twoAction_integrable k c m i)
    (BayesOptimal.Foundations.BayesianModel.action_integrable k c m i)
    (fun z => (value_comparison k (BayesOptimal.Foundations.BayesianModel.advance c i)
      (BayesOptimal.Foundations.BayesianModel.shift m i z) (positive_advance c hc i)).1)
  have hupper := integral_mono (BayesOptimal.Foundations.BayesianModel.action_integrable k c m i)
    ((twoAction_integrable k c m i).add (stateSlack_integrable c m i))
    (fun z => (value_comparison k (BayesOptimal.Foundations.BayesianModel.advance c i)
      (BayesOptimal.Foundations.BayesianModel.shift m i z) (positive_advance c hc i)).2)
  simp only [Pi.add_apply] at hupper
  rw [integral_add (twoAction_integrable k c m i) (stateSlack_integrable c m i),
    stateSlack_tower c m i hc] at hupper
  exact ⟨hlower, hupper⟩

theorem third_never_chosen (k : ℕ) (c : ModelCounts) (m : ModelMeans)
    (hc : ∀ j, 0 < c j)
    (hgain : stateSlack c m < twoValue (k + 1) c m - twoValue k c m) :
    BayesOptimal.Foundations.BayesianModel.choose k c m ≠ 2 := by
  intro hchoose
  have hopt := BayesOptimal.Foundations.BayesianModel.choose_optimal k c m
  rw [hchoose] at hopt
  have hb := (action_comparison k c m 2 hc).2
  rw [twoAction_two] at hb
  have hlower := (value_comparison (k + 1) c m hc).1
  linarith

theorem inferior_action_never_chosen (k : ℕ) (c : ModelCounts) (m : ModelMeans)
    (i j : ModelArm) (hc : ∀ a, 0 < c a)
    (hgap : stateSlack c m < twoAction k c m j - twoAction k c m i) :
    BayesOptimal.Foundations.BayesianModel.choose k c m ≠ i := by
  intro hchoose
  have hopt := BayesOptimal.Foundations.BayesianModel.choose_optimal k c m
  rw [hchoose] at hopt
  have hb := (action_comparison k c m i hc).2
  have hlower := (action_comparison k c m j hc).1
  have hj := BayesOptimal.Foundations.BayesianModel.action_le_value k c m j
  linarith

theorem deficient_action_never_chosen (k : ℕ) (c : ModelCounts) (m : ModelMeans)
    (i : ModelArm) (hc : ∀ a, 0 < c a)
    (hgap : stateSlack c m < twoValue (k + 1) c m - twoAction k c m i) :
    BayesOptimal.Foundations.BayesianModel.choose k c m ≠ i := by
  intro hchoose
  have hopt := BayesOptimal.Foundations.BayesianModel.choose_optimal k c m
  rw [hchoose] at hopt
  have hb := (action_comparison k c m i hc).2
  have hlower := (value_comparison (k + 1) c m hc).1
  linarith

end

end BayesOptimal.Foundations.ThreeArmComparison

end

/-! ## Foundations.TerminalBounds -/
section

/-!
# Quantitative corrected terminal loss bounds

The bounds use the actual Gaussian measures and loss definitions proved in
BayesOptimal.Foundations.Gaussian. In particular the lower bound for Lemma 14 is valid at gap
zero, where the product printed in the paper vanishes.
-/

open MeasureTheory ProbabilityTheory Set
open Filter Asymptotics
open scoped MeasureTheory NNReal ENNReal

namespace BayesOptimal.Foundations.TerminalBounds

noncomputable section

open BayesOptimal.Foundations.Gaussian BayesOptimal.Foundations.Rates

def gainConstant : ℝ := Real.exp (-5) * (Real.sqrt (4 * Real.pi))⁻¹

theorem gainConstant_positive : 0 < gainConstant := by
  unfold gainConstant
  exact mul_pos (Real.exp_pos _) (inv_pos.mpr (Real.sqrt_pos.mpr (by positivity)))

theorem terminal_gaussianPDF_lower (T : ℕ) (gap x : ℝ) (v : ℝ≥0)
    (hT : 5 ≤ T) (hgap : |gap| ≤ 2 * invPower 2 T)
    (hv : 0 < v) (hvupper : (v : ℝ) ≤ 2) (hvlower : invPower 2 T ≤ (v : ℝ))
    (hx : x ∈ Icc (|gap| + invPower 2 T) (|gap| + 2 * invPower 2 T)) :
    gainConstant ≤ gaussianPDFReal 0 v x := by
  have hTp : 0 < T := by omega
  have hTr : 5 ≤ (T : ℝ) := by exact_mod_cast hT
  have hvp : 0 < (v : ℝ) := hv
  have hep := invPower_pos 2 T hTp
  have hehalf : invPower 2 T ≤ 1 / 2 := by
    unfold invPower
    rw [inv_eq_one_div]
    apply (div_le_iff₀ (by positivity)).mpr
    nlinarith only [hTr]
  have hx0 : 0 ≤ x := by linarith only [hx.1, abs_nonneg gap, hep]
  have hxupper : x ≤ 4 * invPower 2 T := by linarith only [hx.2, hgap]
  have hxsq : x ^ 2 ≤ (4 * invPower 2 T) ^ 2 :=
    (sq_le_sq₀ hx0 (by positivity)).mpr hxupper
  have heq : (invPower 2 T) ^ 2 ≤ (invPower 2 T) / 2 := by
    nlinarith only [hehalf, hep]
  have hquad : x ^ 2 ≤ 10 * (v : ℝ) := by
    nlinarith only [hxsq, heq, hvlower, hep]
  have hquot : x ^ 2 / (2 * (v : ℝ)) ≤ 5 := by
    apply (div_le_iff₀ (by positivity)).mpr
    linarith only [hquad]
  have hexp : Real.exp (-5) ≤ Real.exp (-x ^ 2 / (2 * (v : ℝ))) := by
    apply Real.exp_le_exp.mpr
    rw [neg_div]
    linarith only [hquot]
  have hsqrtp : 0 < Real.sqrt (2 * Real.pi * (v : ℝ)) := by positivity
  have hsqrt4p : 0 < Real.sqrt (4 * Real.pi) := by positivity
  have hnorm : (Real.sqrt (4 * Real.pi))⁻¹ ≤
      (Real.sqrt (2 * Real.pi * (v : ℝ)))⁻¹ := by
    apply (inv_le_inv₀ hsqrt4p hsqrtp).mpr
    apply Real.sqrt_le_sqrt
    nlinarith only [hvupper, Real.pi_pos]
  calc
    gainConstant = (Real.sqrt (4 * Real.pi))⁻¹ * Real.exp (-5) := by
      unfold gainConstant
      ring
    _ ≤ (Real.sqrt (2 * Real.pi * (v : ℝ)))⁻¹ *
        Real.exp (-x ^ 2 / (2 * (v : ℝ))) :=
      mul_le_mul hnorm hexp (Real.exp_pos _).le (inv_nonneg.mpr hsqrtp.le)
    _ = gaussianPDFReal 0 v x := by simp only [gaussianPDFReal, sub_zero]

theorem terminal_gaussian_interval_lower (T : ℕ) (gap : ℝ) (v : ℝ≥0)
    (hT : 5 ≤ T) (hgap : |gap| ≤ 2 * invPower 2 T)
    (hv : 0 < v) (hvupper : (v : ℝ) ≤ 2) (hvlower : invPower 2 T ≤ (v : ℝ)) :
    gainConstant * invPower 2 T ≤
      (gaussianReal 0 v (Icc (|gap| + invPower 2 T)
        (|gap| + 2 * invPower 2 T))).toReal := by
  have he0 := invPower_nonneg 2 T
  have hmass : (gaussianReal 0 v (Icc (|gap| + invPower 2 T)
        (|gap| + 2 * invPower 2 T))).toReal =
      ∫ x in Icc (|gap| + invPower 2 T) (|gap| + 2 * invPower 2 T), gaussianPDFReal 0 v x := by
    rw [gaussianReal_apply_eq_integral 0 (ne_of_gt hv), ENNReal.toReal_ofReal]
    exact integral_nonneg (gaussianPDFReal_nonneg 0 v)
  have hmono : (∫ _ in Icc (|gap| + invPower 2 T) (|gap| + 2 * invPower 2 T), gainConstant) ≤
      ∫ x in Icc (|gap| + invPower 2 T) (|gap| + 2 * invPower 2 T), gaussianPDFReal 0 v x := by
    apply setIntegral_mono_on
      (integrableOn_const isCompact_Icc.measure_ne_top)
      (integrable_gaussianPDFReal 0 v).integrableOn measurableSet_Icc
    intro x hx
    exact terminal_gaussianPDF_lower T gap x v hT hgap hv hvupper hvlower hx
  have hconst : (∫ _ in Icc (|gap| + invPower 2 T) (|gap| + 2 * invPower 2 T), gainConstant) =
      gainConstant * invPower 2 T := by
    rw [setIntegral_const, smul_eq_mul, measureReal_def, Real.volume_Icc,
      ENNReal.toReal_ofReal (by linarith)]
    ring
  rw [← hconst, hmass]
  exact hmono

/-- Corrected Lemma 14: a uniform lower bound on the actual improvement,
including when the two posterior means are tied. -/
theorem lemma14_uniform_gain_lower (T : ℕ) (gap : ℝ) (varianceL varianceR : ℝ≥0)
    (hT : 5 ≤ T) (hgap : |gap| ≤ 2 * invPower 2 T)
    (hv : 0 < varianceL) (hvupper : (varianceL : ℝ) ≤ 2)
    (hvlower : invPower 2 T ≤ (varianceL : ℝ)) :
    gainConstant * invPower 4 T ≤ oneStepImprovement gap varianceL varianceR := by
  have hmass := terminal_gaussian_interval_lower T gap varianceL hT hgap hv hvupper hvlower
  have hscale := mul_le_mul_of_nonneg_left hmass (invPower_nonneg 2 T)
  have hbound := oneStepImprovement_ge_corrected_bound gap (invPower 2 T) varianceL varianceR
  unfold correctedImprovementLowerBound at hbound
  calc
    gainConstant * invPower 4 T =
        invPower 2 T * (gainConstant * invPower 2 T) := by
      rw [← invPower_product 2 2 T]
      ring
    _ ≤ invPower 2 T *
        (gaussianReal 0 varianceL (Icc (|gap| + invPower 2 T)
          (|gap| + 2 * invPower 2 T))).toReal := hscale
    _ ≤ oneStepImprovement gap varianceL varianceR := hbound

theorem lemma14_uniform_gain_conservative (T : ℕ) (gap : ℝ) (varianceL varianceR : ℝ≥0)
    (hT : 5 ≤ T) (hgap : |gap| ≤ 2 * invPower 2 T)
    (hv : 0 < varianceL) (hvupper : (varianceL : ℝ) ≤ 2)
    (hvlower : invPower 2 T ≤ (varianceL : ℝ)) :
    gainConstant * invPower 6 T ≤ oneStepImprovement gap varianceL varianceR := by
  exact (mul_le_mul_of_nonneg_left
    (invPower_antitone (by norm_num : 4 ≤ 6) (by omega : 1 ≤ T))
    gainConstant_positive.le).trans
      (lemma14_uniform_gain_lower T gap varianceL varianceR hT hgap hv hvupper hvlower)

theorem updateVariance_count_bounds (n T : ℕ) (hn : 1 ≤ n) (hnT : n < T) :
    invPower 2 T ≤ (updateVariance (n : ℝ≥0) : ℝ) ∧
      (updateVariance (n : ℝ≥0) : ℝ) ≤ 1 / 2 := by
  have hnr : 1 ≤ (n : ℝ) := by exact_mod_cast hn
  have hTr : 1 ≤ (T : ℝ) := by exact_mod_cast (show 1 ≤ T by omega)
  have hnTr : (n : ℝ) + 1 ≤ (T : ℝ) := by exact_mod_cast (show n + 1 ≤ T by omega)
  simp only [updateVariance, NNReal.coe_inv, NNReal.coe_mul, NNReal.coe_add,
    NNReal.coe_natCast, NNReal.coe_one, invPower]
  constructor
  · apply (inv_le_inv₀ (by positivity) (by positivity)).mpr
    nlinarith only [hnTr, hnr, hTr]
  · rw [inv_eq_one_div]
    apply (div_le_iff₀ (by positivity)).mpr
    nlinarith only [hnr]

/-- Lemma 14's quantitative conclusion for the paper's actual sampled arm
variance, with no variance lower bound supplied as a hypothesis. -/
theorem lemma14_sample_count_lower (T n : ℕ) (gap : ℝ) (varianceR : ℝ≥0)
    (hT : 5 ≤ T) (hn : 1 ≤ n) (hnT : n < T)
    (hgap : |gap| ≤ 2 * invPower 2 T) :
    gainConstant * invPower 6 T ≤
      oneStepImprovement gap (updateVariance (n : ℝ≥0)) varianceR := by
  have hb := updateVariance_count_bounds n T hn hnT
  apply lemma14_uniform_gain_conservative T gap _ varianceR hT hgap
  · unfold updateVariance
    have hnp : 0 < (n : ℝ≥0) := by exact_mod_cast (show 0 < n by omega)
    positivity
  · linarith only [hb.2]
  · exact hb.1

def comparisonConstant : ℝ := (gaussianReal 0 1 (Icc (1 : ℝ) 2)).toReal / 2

theorem comparisonConstant_positive : 0 < comparisonConstant := by
  exact div_pos (gaussian_Icc_probability_pos 0 1 2 1 (by norm_num) (by norm_num))
    (by norm_num)

/-- A quantitative form of the standard-Gaussian coupling used in Lemma 15.
On x∈[1,2] both hinges are linear if the smaller standard deviation is at
least the center, and their difference is at least the standard deviation gap. -/
theorem hingeLoss_difference_ge_standard_interval (center : ℝ) (vL vR : ℝ≥0)
    (hcenter : 0 ≤ center) (hsmall : center ≤ Real.sqrt (vL : ℝ)) (hv : vL ≤ vR) :
    (Real.sqrt (vR : ℝ) - Real.sqrt (vL : ℝ)) *
        (gaussianReal 0 1 (Icc (1 : ℝ) 2)).toReal ≤
      hingeLoss center vR - hingeLoss center vL := by
  let sL := Real.sqrt (vL : ℝ)
  let sR := Real.sqrt (vR : ℝ)
  have hsL : 0 ≤ sL := Real.sqrt_nonneg _
  have hsR : 0 ≤ sR := Real.sqrt_nonneg _
  have hs : sL ≤ sR := Real.sqrt_le_sqrt hv
  have hiL : Integrable (fun x : ℝ => max (sL * x - center) 0) (gaussianReal 0 1) :=
    (((gaussian_id_integrable 0 1).const_mul sL).sub (integrable_const center)).pos_part
  have hiR : Integrable (fun x : ℝ => max (sR * x - center) 0) (gaussianReal 0 1) :=
    (((gaussian_id_integrable 0 1).const_mul sR).sub (integrable_const center)).pos_part
  have hmono : ∀ x : ℝ, 0 ≤ max (sR * x - center) 0 - max (sL * x - center) 0 := by
    intro x
    apply sub_nonneg.mpr
    by_cases hx : 0 ≤ x
    · exact max_le_max (sub_le_sub_right (mul_le_mul_of_nonneg_right hs hx) center) le_rfl
    · rw [max_eq_right (by nlinarith only [hsL, hcenter, hx] : sL * x - center ≤ 0)]
      exact le_max_right _ _
  have hinterval : ∀ x ∈ Icc (1 : ℝ) 2,
      sR - sL ≤ max (sR * x - center) 0 - max (sL * x - center) 0 := by
    intro x hx
    have hSLcenter : center ≤ sL := hsmall
    have hx0 : 0 ≤ x := by linarith only [hx.1]
    have hleft : 0 ≤ sL * x - center := by nlinarith only [hx.1, hsL, hSLcenter]
    have hright : 0 ≤ sR * x - center := by nlinarith only [hx.1, hsR, hs, hSLcenter]
    rw [max_eq_left hleft, max_eq_left hright]
    nlinarith only [hx.1, hs]
  have hint : (sR - sL) * (gaussianReal 0 1 (Icc (1 : ℝ) 2)).toReal ≤
      ∫ x : ℝ, (max (sR * x - center) 0 - max (sL * x - center) 0) ∂gaussianReal 0 1 := by
    calc
      _ ≤ ∫ x : ℝ in Icc (1 : ℝ) 2,
          (max (sR * x - center) 0 - max (sL * x - center) 0) ∂gaussianReal 0 1 := by
        exact setIntegral_ge_of_const_le measurableSet_Icc (measure_ne_top _ _)
          hinterval (hiR.sub hiL).restrict
      _ ≤ _ := setIntegral_le_integral (hiR.sub hiL) (ae_of_all _ hmono)
  rw [integral_sub hiR hiL] at hint
  rw [hingeLoss_eq_standard_integral, hingeLoss_eq_standard_integral]
  exact hint

theorem updateVariance_difference_lower (ni nj T : ℕ)
    (hj : 1 ≤ nj) (hstrict : nj < ni) (hiT : ni < T) :
    invPower 3 T ≤ (updateVariance (nj : ℝ≥0) : ℝ) -
      (updateVariance (ni : ℝ≥0) : ℝ) := by
  have hjr : 1 ≤ (nj : ℝ) := by exact_mod_cast hj
  have hir : 1 ≤ (ni : ℝ) := by exact_mod_cast (show 1 ≤ ni by omega)
  have hTr : 1 ≤ (T : ℝ) := by exact_mod_cast (show 1 ≤ T by omega)
  have hji : (nj : ℝ) + 1 ≤ (ni : ℝ) := by exact_mod_cast (show nj + 1 ≤ ni by omega)
  have hiTr : (ni : ℝ) + 1 ≤ (T : ℝ) := by exact_mod_cast (show ni + 1 ≤ T by omega)
  have hjTr : (nj : ℝ) ≤ (T : ℝ) := by linarith only [hji, hiTr]
  have hj1Tr : (nj : ℝ) + 1 ≤ (T : ℝ) := by linarith only [hji, hiTr]
  have hnum : (ni : ℝ) ≤ (ni : ℝ) * ((ni : ℝ) + 1) - (nj : ℝ) * ((nj : ℝ) + 1) := by
    have hprod1 := mul_le_mul_of_nonneg_left hji (by linarith : 0 ≤ (nj : ℝ))
    have hprod2 := mul_le_mul_of_nonneg_left (show (nj : ℝ) ≤ (ni : ℝ) by linarith)
      (by linarith : 0 ≤ (ni : ℝ))
    nlinarith only [hprod1, hprod2]
  have hnjprod : (nj : ℝ) * ((nj : ℝ) + 1) ≤ (T : ℝ) ^ 2 := by
    have hp := mul_le_mul hjTr hj1Tr (by linarith : 0 ≤ (nj : ℝ) + 1) (by linarith : 0 ≤ (T : ℝ))
    nlinarith only [hp]
  have hden : ((nj : ℝ) * ((nj : ℝ) + 1)) * ((ni : ℝ) * ((ni : ℝ) + 1)) ≤
      (ni : ℝ) * (T : ℝ) ^ 3 := by
    have hiTproduct : (ni : ℝ) * ((ni : ℝ) + 1) ≤ (ni : ℝ) * (T : ℝ) :=
      mul_le_mul_of_nonneg_left hiTr (by linarith)
    have hp := mul_le_mul hnjprod hiTproduct (by positivity : 0 ≤ (ni : ℝ) * ((ni : ℝ) + 1))
      (by positivity : 0 ≤ (T : ℝ) ^ 2)
    nlinarith only [hp]
  have hscale := mul_le_mul_of_nonneg_right hnum (by positivity : 0 ≤ (T : ℝ) ^ 3)
  simp only [updateVariance, NNReal.coe_inv, NNReal.coe_mul, NNReal.coe_add,
    NNReal.coe_natCast, NNReal.coe_one, invPower]
  have hid : ((nj : ℝ) * ((nj : ℝ) + 1))⁻¹ - ((ni : ℝ) * ((ni : ℝ) + 1))⁻¹ =
      ((ni : ℝ) * ((ni : ℝ) + 1) - (nj : ℝ) * ((nj : ℝ) + 1)) /
        (((nj : ℝ) * ((nj : ℝ) + 1)) * ((ni : ℝ) * ((ni : ℝ) + 1))) := by
    have hjp : (nj : ℝ) ≠ 0 := by linarith
    have hip : (ni : ℝ) ≠ 0 := by linarith
    have hj1p : (nj : ℝ) + 1 ≠ 0 := by linarith
    have hi1p : (ni : ℝ) + 1 ≠ 0 := by linarith
    field_simp
  rw [hid, inv_eq_one_div]
  apply (div_le_div_iff₀ (by positivity) (by positivity)).mpr
  linarith only [hden, hscale]

theorem sqrt_variance_difference_ge_half (vL vR : ℝ≥0)
    (hv : vL ≤ vR) (hupper : (vR : ℝ) ≤ 1) :
    ((vR : ℝ) - (vL : ℝ)) / 2 ≤ Real.sqrt (vR : ℝ) - Real.sqrt (vL : ℝ) := by
  have hsL := Real.sqrt_nonneg (vL : ℝ)
  have hsR := Real.sqrt_nonneg (vR : ℝ)
  have hsqL : (Real.sqrt (vL : ℝ)) ^ 2 = (vL : ℝ) := Real.sq_sqrt vL.property
  have hsqR : (Real.sqrt (vR : ℝ)) ^ 2 = (vR : ℝ) := Real.sq_sqrt vR.property
  have hs := Real.sqrt_le_sqrt (show (vL : ℝ) ≤ (vR : ℝ) from hv)
  have hsR1 : Real.sqrt (vR : ℝ) ≤ 1 := Real.sqrt_le_one.mpr hupper
  have hsum : Real.sqrt (vR : ℝ) + Real.sqrt (vL : ℝ) ≤ 2 := by linarith only [hsR1, hs]
  have hprod := mul_le_mul_of_nonneg_right hsum (sub_nonneg.mpr hs)
  nlinarith only [hprod, hsqL, hsqR]

theorem terminal_actionLoss_difference_eq (gap : ℝ) (ni nj : ℝ≥0)
    (hj : 0 < nj) (hi : 0 < ni) :
    expectedLossAfterDraw gap (updateVariance ni) (posteriorVariance (ni + 1) nj) -
        expectedLossAfterDraw gap (updateVariance nj) (posteriorVariance (nj + 1) ni) =
      hingeLoss |gap| (updateVariance nj) - hingeLoss |gap| (updateVariance ni) := by
  have hleft := oneStepImprovement_eq_hinge gap (updateVariance ni) (posteriorVariance (ni + 1) nj)
  have hright := oneStepImprovement_eq_hinge gap (updateVariance nj) (posteriorVariance (nj + 1) ni)
  unfold oneStepImprovement at hleft hright
  rw [← posteriorVariance_after_draw ni nj hi] at hleft
  rw [← posteriorVariance_after_draw nj ni hj, posteriorVariance_comm nj ni] at hright
  linarith only [hleft, hright]

/-- Corrected Lemma 15 has a uniform polynomial lower bound on the actual
action-loss gap, with the larger-count arm i and smaller-count arm j. -/
theorem lemma15_terminal_action_gap_lower (T ni nj : ℕ) (gap : ℝ)
    (hT : 5 ≤ T) (hj : 1 ≤ nj) (hstrict : nj < ni) (hiT : ni < T)
    (hgap : |gap| ≤ 2 * invPower 2 T) :
    comparisonConstant * invPower 3 T ≤
      expectedLossAfterDraw gap (updateVariance (ni : ℝ≥0))
          (posteriorVariance ((ni : ℝ≥0) + 1) (nj : ℝ≥0)) -
        expectedLossAfterDraw gap (updateVariance (nj : ℝ≥0))
          (posteriorVariance ((nj : ℝ≥0) + 1) (ni : ℝ≥0)) := by
  have hi : 1 ≤ ni := by omega
  have hjT : nj < T := by omega
  have hip : 0 < (ni : ℝ≥0) := by exact_mod_cast (show 0 < ni by omega)
  have hjp : 0 < (nj : ℝ≥0) := by exact_mod_cast (show 0 < nj by omega)
  have hcounts : (nj : ℝ≥0) < (ni : ℝ≥0) := by exact_mod_cast hstrict
  have hv := updateVariance_strictAntitone (nj : ℝ≥0) (ni : ℝ≥0) hjp hcounts
  have hbL := updateVariance_count_bounds ni T hi hiT
  have hbR := updateVariance_count_bounds nj T hj hjT
  have he0 := invPower_nonneg 2 T
  have hequarter : invPower 2 T ≤ 1 / 4 := by
    have hTr : 5 ≤ (T : ℝ) := by exact_mod_cast hT
    unfold invPower
    rw [inv_eq_one_div]
    apply (div_le_iff₀ (by positivity)).mpr
    nlinarith only [hTr]
  have hcenter : |gap| ≤ Real.sqrt (updateVariance (ni : ℝ≥0) : ℝ) := by
    apply le_trans hgap
    apply Real.le_sqrt_of_sq_le
    nlinarith only [hequarter, he0, hbL.1]
  have hhinge := hingeLoss_difference_ge_standard_interval |gap|
    (updateVariance (ni : ℝ≥0)) (updateVariance (nj : ℝ≥0)) (abs_nonneg _) hcenter hv.le
  have hsig := sqrt_variance_difference_ge_half (updateVariance (ni : ℝ≥0))
    (updateVariance (nj : ℝ≥0)) hv.le (by linarith only [hbR.2])
  have hvar := updateVariance_difference_lower ni nj T hj hstrict hiT
  have hmass : 0 ≤ (gaussianReal 0 1 (Icc (1 : ℝ) 2)).toReal := by positivity
  have hscale := mul_le_mul_of_nonneg_right hsig hmass
  have hscale2 := mul_le_mul_of_nonneg_right hvar (div_nonneg hmass (by norm_num : (0 : ℝ) ≤ 2))
  rw [terminal_actionLoss_difference_eq gap (ni : ℝ≥0) (nj : ℝ≥0) hjp hip]
  unfold comparisonConstant
  nlinarith only [hhinge, hscale, hscale2]

theorem lemma15_terminal_action_gap_conservative (T ni nj : ℕ) (gap : ℝ)
    (hT : 5 ≤ T) (hj : 1 ≤ nj) (hstrict : nj < ni) (hiT : ni < T)
    (hgap : |gap| ≤ 2 * invPower 2 T) :
    comparisonConstant * invPower 8 T ≤
      expectedLossAfterDraw gap (updateVariance (ni : ℝ≥0))
          (posteriorVariance ((ni : ℝ≥0) + 1) (nj : ℝ≥0)) -
        expectedLossAfterDraw gap (updateVariance (nj : ℝ≥0))
          (posteriorVariance ((nj : ℝ≥0) + 1) (ni : ℝ≥0)) := by
  exact (mul_le_mul_of_nonneg_left
    (invPower_antitone (by norm_num : 3 ≤ 8) (by omega : 1 ≤ T))
    comparisonConstant_positive.le).trans
      (lemma15_terminal_action_gap_lower T ni nj gap hT hj hstrict hiT hgap)

end

end BayesOptimal.Foundations.TerminalBounds

end

/-! ## Foundations.TwoArmGain -/
section

open MeasureTheory ProbabilityTheory Set
open scoped MeasureTheory NNReal ENNReal

namespace BayesOptimal.Foundations.TwoArmGain

open BayesOptimal.Foundations.Gaussian BayesOptimal.Foundations.Counts BayesOptimal.Foundations.TwoArmBellman

noncomputable section

theorem absolute_hinge_smoothing_integrable (center : ℝ) (a b : ℝ≥0) :
    Integrable (fun z : ℝ => hingeLoss |center - z| b) (gaussianReal 0 a) := by
  have hf : (fun z : ℝ => hingeLoss |center - z| b) =
      (fun z : ℝ => hingeLoss (center - z) b - max (z - center) 0) := by
    funext z
    have h := hingeLoss_sub_abs (center - z) b
    have he : -(center - z) = z - center := by ring
    rw [he] at h
    linarith
  rw [hf]
  exact (hinge_smoothing_integrable center a b).sub (hinge_integrable center a)

theorem absolute_hinge_gaussian_integrable (mean : ℝ) (a b : ℝ≥0) :
    Integrable (fun x : ℝ => hingeLoss |x| b) (gaussianReal mean a) := by
  have hmap := gaussianReal_map_add_const (μ := (0 : ℝ)) (v := a) mean
  simp only [zero_add] at hmap
  rw [← hmap]
  apply (Homeomorph.addRight mean).measurableEmbedding.integrable_map_iff.mpr
  have h := absolute_hinge_smoothing_integrable (-mean) a b
  convert h using 1
  funext x
  change hingeLoss |x + mean| b = hingeLoss |-mean - x| b
  have he : -mean - x = -(x + mean) := by ring
  rw [he, abs_neg]

/-- Gaussian smoothing converts a terminal one-step gain into the exact
increase of an earlier value function. -/
theorem hinge_variance_increment_integral (center : ℝ) (a b : ℝ≥0) :
    hingeLoss center (a + b) - hingeLoss center a =
      ∫ x : ℝ, hingeLoss |x| b ∂gaussianReal (-center) a := by
  have hf : (fun z : ℝ => hingeLoss |center - z| b) =
      (fun z : ℝ => hingeLoss (center - z) b - max (z - center) 0) := by
    funext z
    have h := hingeLoss_sub_abs (center - z) b
    have he : -(center - z) = z - center := by ring
    rw [he] at h
    linarith
  have hsmall : (∫ z : ℝ, hingeLoss |center - z| b ∂gaussianReal 0 a) =
      hingeLoss center (a + b) - hingeLoss center a := by
    rw [hf, integral_sub (hinge_smoothing_integrable center a b) (hinge_integrable center a),
      hinge_smoothing]
    rfl
  have hmap := gaussianReal_map_add_const (μ := (0 : ℝ)) (v := a) (-center)
  simp only [zero_add] at hmap
  rw [← hmap, integral_map (by fun_prop) (by
    rw [hmap]
    exact (absolute_hinge_gaussian_integrable (-center) a b).aestronglyMeasurable)]
  rw [← hsmall]
  congr 1
  funext x
  have he : x + -center = -(center - x) := by ring
  rw [he, abs_neg]

theorem balancedRun_succ_tail (k : ℕ) (c : Counts) :
    balancedRun (k + 1) c = balancedStep (balancedRun k c) := by
  induction k generalizing c with
  | zero => rfl
  | succ k ih =>
    rw [balancedRun, ih, balancedRun]

theorem balancedCumulative_succ_tail (k : ℕ) (c : Counts) :
    balancedCumulative (k + 1) c =
      balancedCumulative k c + balancedInnovation (balancedRun k c) := by
  induction k generalizing c with
  | zero => simp only [balancedCumulative, balancedRun, add_zero, zero_add]
  | succ k ih =>
    change balancedInnovation c + balancedCumulative (k + 1) (balancedStep c) =
      (balancedInnovation c + balancedCumulative k (balancedStep c)) +
        balancedInnovation (balancedRun (k + 1) c)
    rw [ih (balancedStep c), balancedRun]
    ac_rfl

theorem cumulativeVariance_succ_tail (k : ℕ) (c : Counts)
    (h1 : 0 < c.n1) (h2 : 0 < c.n2) :
    cumulativeVariance (k + 1) c =
      cumulativeVariance k c + balancedInnovation (balancedRun k c) := by
  rw [cumulativeVariance_eq_balancedCumulative _ _ h1 h2,
    cumulativeVariance_eq_balancedCumulative _ _ h1 h2,
    balancedCumulative_succ_tail]

theorem cumulativeVariance_eq_accumulatedVariance (k : ℕ) (c : Counts)
    (h1 : 0 < c.n1) (h2 : 0 < c.n2) :
    cumulativeVariance k c = BayesOptimal.Foundations.PredictiveLaw.accumulatedVariance k c := by
  apply NNReal.coe_injective
  rw [cumulativeVariance_eq_transitionVariance _ _ h1 h2,
    BayesOptimal.Foundations.PredictiveLaw.accumulatedVariance_coe _ _ h1 h2]

/-- Actual two-arm horizon gain is the terminal hinge gain averaged under
the exact balanced Gaussian forecast already used in corrected Lemma 17. -/
theorem payoff_horizon_gain_integral (k : ℕ) (m1 m2 : ℝ) (c : Counts)
    (h1 : 0 < c.n1) (h2 : 0 < c.n2) :
    payoff (k + 1) m1 m2 c - payoff k m1 m2 c =
      ∫ x : ℝ, hingeLoss |x| (balancedInnovation (balancedRun k c))
        ∂BayesOptimal.Foundations.PredictiveLaw.balancedPredictiveLaw k c (m1 - m2) := by
  rw [payoff_eq, payoff_eq, cumulativeVariance_succ_tail _ _ h1 h2]
  have he : m2 + hingeLoss (m2 - m1)
      (cumulativeVariance k c + balancedInnovation (balancedRun k c)) -
      (m2 + hingeLoss (m2 - m1) (cumulativeVariance k c)) =
      hingeLoss (m2 - m1) (cumulativeVariance k c + balancedInnovation (balancedRun k c)) -
        hingeLoss (m2 - m1) (cumulativeVariance k c) := by ring
  rw [he, hinge_variance_increment_integral,
    cumulativeVariance_eq_accumulatedVariance _ _ h1 h2,
    BayesOptimal.Foundations.PredictiveLaw.balancedPredictiveLaw_gaussian]
  congr 2
  ring

theorem leftAction_variance_decomposition (k : ℕ) (c : Counts)
    (h1 : 0 < c.n1) (h2 : 0 < c.n2) :
    (updateVariance c.n1 + cumulativeVariance k (leftStep c)) +
      variance (balancedRun k (leftStep c)) = variance c := by
  rw [cumulativeVariance_eq_balancedCumulative k (leftStep c)
    (by simp only [leftStep]; omega) (by simpa only [leftStep] using h2),
    add_assoc, balancedCumulative_decomposition k (leftStep c)
    (by simp only [leftStep]; omega) (by simpa only [leftStep] using h2)]
  exact (leftStep_variance c h1).symm

theorem rightAction_variance_decomposition (k : ℕ) (c : Counts)
    (h1 : 0 < c.n1) (h2 : 0 < c.n2) :
    (updateVariance c.n2 + cumulativeVariance k (rightStep c)) +
      variance (balancedRun k (rightStep c)) = variance c := by
  rw [cumulativeVariance_eq_balancedCumulative k (rightStep c)
    (by simpa only [rightStep] using h1) (by simp only [rightStep]; omega),
    add_assoc, balancedCumulative_decomposition k (rightStep c)
    (by simpa only [rightStep] using h1) (by simp only [rightStep]; omega)]
  exact (rightStep_variance c h2).symm

theorem cumulativeVariance_decomposition (k : ℕ) (c : Counts)
    (h1 : 0 < c.n1) (h2 : 0 < c.n2) :
    cumulativeVariance k c + variance (balancedRun k c) = variance c := by
  rw [cumulativeVariance_eq_balancedCumulative _ _ h1 h2]
  exact balancedCumulative_decomposition _ _ h1 h2

theorem hinge_variance_comparison_integral (center : ℝ) (a small large : ℝ≥0) :
    hingeLoss center (a + large) - hingeLoss center (a + small) =
      ∫ x : ℝ, (hingeLoss |x| large - hingeLoss |x| small)
        ∂gaussianReal (-center) a := by
  rw [integral_sub (absolute_hinge_gaussian_integrable _ _ _)
    (absolute_hinge_gaussian_integrable _ _ _),
    ← hinge_variance_increment_integral, ← hinge_variance_increment_integral]
  ring

theorem balancedRun_right_only (k : ℕ) (c : Counts) (h : c.n2 + k ≤ c.n1) :
    balancedRun k c = ⟨c.n1, c.n2 + k, c.n3⟩ := by
  induction k generalizing c with
  | zero => simp only [balancedRun, Nat.add_zero]
  | succ k ih =>
    have hn : ¬ c.n1 ≤ c.n2 := by omega
    have hstep : balancedStep c = rightStep c := by
      simp only [balancedStep, rightStep, if_neg hn]
    have hnext : (rightStep c).n2 + k ≤ (rightStep c).n1 := by
      change (c.n2 + 1) + k ≤ c.n1
      omega
    rw [balancedRun, hstep, ih (rightStep c) hnext]
    change (⟨c.n1, (c.n2 + 1) + k, c.n3⟩ : Counts) = ⟨c.n1, c.n2 + (k + 1), c.n3⟩
    congr 1
    omega

theorem balancedRun_left_only (k : ℕ) (c : Counts) (h : c.n1 + k ≤ c.n2) :
    balancedRun k c = ⟨c.n1 + k, c.n2, c.n3⟩ := by
  induction k generalizing c with
  | zero => simp only [balancedRun, Nat.add_zero]
  | succ k ih =>
    have hn : c.n1 ≤ c.n2 := by omega
    have hstep : balancedStep c = leftStep c := by
      simp only [balancedStep, leftStep, if_pos hn]
    have hnext : (leftStep c).n1 + k ≤ (leftStep c).n2 := by
      change (c.n1 + 1) + k ≤ c.n2
      omega
    rw [balancedRun, hstep, ih (leftStep c) hnext]
    change (⟨(c.n1 + 1) + k, c.n2, c.n3⟩ : Counts) = ⟨c.n1 + (k + 1), c.n2, c.n3⟩
    congr 1
    omega

theorem balancedRun_left_commute (k : ℕ) (c : Counts) (h : c.n2 + k ≤ c.n1) :
    balancedRun k (leftStep c) = leftStep (balancedRun k c) := by
  have hnext : (leftStep c).n2 + k ≤ (leftStep c).n1 := by
    change c.n2 + k ≤ c.n1 + 1
    omega
  rw [balancedRun_right_only k c h, balancedRun_right_only k (leftStep c) hnext]
  rfl

theorem balancedRun_right_commute (k : ℕ) (c : Counts) (h : c.n1 + k ≤ c.n2) :
    balancedRun k (rightStep c) = rightStep (balancedRun k c) := by
  have hnext : (rightStep c).n1 + k ≤ (rightStep c).n2 := by
    change c.n1 + k ≤ c.n2 + 1
    omega
  rw [balancedRun_left_only k c h, balancedRun_left_only k (rightStep c) hnext]
  rfl

theorem leftAction_variance_eq_append (k : ℕ) (c : Counts)
    (h1 : 0 < c.n1) (h2 : 0 < c.n2)
    (hcomm : balancedRun k (leftStep c) = leftStep (balancedRun k c)) :
    updateVariance c.n1 + cumulativeVariance k (leftStep c) =
      cumulativeVariance k c + updateVariance (balancedRun k c).n1 := by
  have hmono := balancedRun_monotone k c
  have hstep := leftStep_variance (balancedRun k c) (by omega)
  have hcum := cumulativeVariance_decomposition k c h1 h2
  have hact := leftAction_variance_decomposition k c h1 h2
  rw [hcomm] at hact
  apply add_right_cancel (b := variance (leftStep (balancedRun k c)))
  calc
    _ = variance c := hact
    _ = cumulativeVariance k c + variance (balancedRun k c) := hcum.symm
    _ = _ := by rw [hstep]; ac_rfl

theorem rightAction_variance_eq_append (k : ℕ) (c : Counts)
    (h1 : 0 < c.n1) (h2 : 0 < c.n2)
    (hcomm : balancedRun k (rightStep c) = rightStep (balancedRun k c)) :
    updateVariance c.n2 + cumulativeVariance k (rightStep c) =
      cumulativeVariance k c + updateVariance (balancedRun k c).n2 := by
  have hmono := balancedRun_monotone k c
  have hstep := rightStep_variance (balancedRun k c) (by omega)
  have hcum := cumulativeVariance_decomposition k c h1 h2
  have hact := rightAction_variance_decomposition k c h1 h2
  rw [hcomm] at hact
  apply add_right_cancel (b := variance (rightStep (balancedRun k c)))
  calc
    _ = variance c := hact
    _ = cumulativeVariance k c + variance (balancedRun k c) := hcum.symm
    _ = _ := by rw [hstep]; ac_rfl

/-- Sampling an arm already saturated at the larger count has a loss gap
equal to the averaged terminal comparison under the exact Gaussian forecast. -/
theorem saturated_left_action_gap_integral (k : ℕ) (m1 m2 : ℝ) (c : Counts)
    (h1 : 0 < c.n1) (h2 : 0 < c.n2) (h : c.n2 + k ≤ c.n1) :
    payoff (k + 1) m1 m2 c - leftAction k m1 m2 c =
      ∫ x : ℝ, (hingeLoss |x| (balancedInnovation (balancedRun k c)) -
        hingeLoss |x| (updateVariance (balancedRun k c).n1))
        ∂BayesOptimal.Foundations.PredictiveLaw.balancedPredictiveLaw k c (m1 - m2) := by
  rw [payoff_eq, leftAction_eq, cumulativeVariance_succ_tail _ _ h1 h2,
    leftAction_variance_eq_append _ _ h1 h2 (balancedRun_left_commute k c h)]
  have he : m2 + hingeLoss (m2 - m1)
      (cumulativeVariance k c + balancedInnovation (balancedRun k c)) -
      (m2 + hingeLoss (m2 - m1)
        (cumulativeVariance k c + updateVariance (balancedRun k c).n1)) =
      hingeLoss (m2 - m1) (cumulativeVariance k c + balancedInnovation (balancedRun k c)) -
        hingeLoss (m2 - m1) (cumulativeVariance k c + updateVariance (balancedRun k c).n1) := by ring
  rw [he, hinge_variance_comparison_integral,
    cumulativeVariance_eq_accumulatedVariance _ _ h1 h2,
    BayesOptimal.Foundations.PredictiveLaw.balancedPredictiveLaw_gaussian]
  congr 2
  ring

theorem saturated_right_action_gap_integral (k : ℕ) (m1 m2 : ℝ) (c : Counts)
    (h1 : 0 < c.n1) (h2 : 0 < c.n2) (h : c.n1 + k ≤ c.n2) :
    payoff (k + 1) m1 m2 c - rightAction k m1 m2 c =
      ∫ x : ℝ, (hingeLoss |x| (balancedInnovation (balancedRun k c)) -
        hingeLoss |x| (updateVariance (balancedRun k c).n2))
        ∂BayesOptimal.Foundations.PredictiveLaw.balancedPredictiveLaw k c (m1 - m2) := by
  rw [payoff_eq, rightAction_eq, cumulativeVariance_succ_tail _ _ h1 h2,
    rightAction_variance_eq_append _ _ h1 h2 (balancedRun_right_commute k c h)]
  have he : m2 + hingeLoss (m2 - m1)
      (cumulativeVariance k c + balancedInnovation (balancedRun k c)) -
      (m2 + hingeLoss (m2 - m1)
        (cumulativeVariance k c + updateVariance (balancedRun k c).n2)) =
      hingeLoss (m2 - m1) (cumulativeVariance k c + balancedInnovation (balancedRun k c)) -
        hingeLoss (m2 - m1) (cumulativeVariance k c + updateVariance (balancedRun k c).n2) := by ring
  rw [he, hinge_variance_comparison_integral,
    cumulativeVariance_eq_accumulatedVariance _ _ h1 h2,
    BayesOptimal.Foundations.PredictiveLaw.balancedPredictiveLaw_gaussian]
  congr 2
  ring

theorem balancedInnovation_preterminal (q k : ℕ) (c : Counts)
    (hq : 0 < q) (hcap1 : c.n1 ≤ q) (hcap2 : c.n2 ≤ q)
    (hs : c.n1 + c.n2 + k = 2 * q - 1) :
    balancedInnovation (balancedRun k c) = updateVariance ((q - 1 : ℕ) : ℝ≥0) := by
  have hc := equation22_terminal_counts q k c hq hcap1 hcap2 hs
  unfold balancedInnovation
  by_cases hn : c.n2 = q
  · simp only [if_pos hn] at hc
    rw [hc.1, hc.2, if_pos (by omega : q - 1 ≤ q)]
  · simp only [if_neg hn] at hc
    rw [hc.1, hc.2, if_neg (by omega : ¬ q ≤ q - 1)]

theorem payoff_horizon_gain_preterminal (q k : ℕ) (m1 m2 : ℝ) (c : Counts)
    (hq : 0 < q) (h1 : 0 < c.n1) (h2 : 0 < c.n2)
    (hcap1 : c.n1 ≤ q) (hcap2 : c.n2 ≤ q)
    (hs : c.n1 + c.n2 + k = 2 * q - 1) :
    payoff (k + 1) m1 m2 c - payoff k m1 m2 c =
      ∫ x : ℝ, hingeLoss |x| (updateVariance ((q - 1 : ℕ) : ℝ≥0))
        ∂BayesOptimal.Foundations.PredictiveLaw.balancedPredictiveLaw k c (m1 - m2) := by
  rw [payoff_horizon_gain_integral _ _ _ _ h1 h2,
    balancedInnovation_preterminal _ _ _ hq hcap1 hcap2 hs]

theorem saturated_left_prefix_counts (q k : ℕ) (c : Counts)
    (hq : 0 < q) (hsaturated : c.n1 = q)
    (hs : c.n1 + c.n2 + k = 2 * q - 1) :
    (balancedRun k c).n1 = q ∧ (balancedRun k c).n2 = q - 1 := by
  have htot : c.n2 + k = q - 1 := by omega
  have hright : c.n2 + k ≤ c.n1 := by omega
  rw [balancedRun_right_only _ _ hright]
  exact ⟨hsaturated, htot⟩

theorem saturated_right_prefix_counts (q k : ℕ) (c : Counts)
    (hq : 0 < q) (hsaturated : c.n2 = q)
    (hs : c.n1 + c.n2 + k = 2 * q - 1) :
    (balancedRun k c).n1 = q - 1 ∧ (balancedRun k c).n2 = q := by
  have htot : c.n1 + k = q - 1 := by omega
  have hleft : c.n1 + k ≤ c.n2 := by omega
  rw [balancedRun_left_only _ _ hleft]
  exact ⟨htot, hsaturated⟩

theorem saturated_left_gap_preterminal (q k : ℕ) (m1 m2 : ℝ) (c : Counts)
    (hq : 0 < q) (h1 : 0 < c.n1) (h2 : 0 < c.n2)
    (hsaturated : c.n1 = q) (hs : c.n1 + c.n2 + k = 2 * q - 1) :
    payoff (k + 1) m1 m2 c - leftAction k m1 m2 c =
      ∫ x : ℝ, (hingeLoss |x| (updateVariance ((q - 1 : ℕ) : ℝ≥0)) -
        hingeLoss |x| (updateVariance (q : ℝ≥0)))
        ∂BayesOptimal.Foundations.PredictiveLaw.balancedPredictiveLaw k c (m1 - m2) := by
  have hc := saturated_left_prefix_counts q k c hq hsaturated hs
  have hright : c.n2 + k ≤ c.n1 := by omega
  rw [saturated_left_action_gap_integral _ _ _ _ h1 h2 hright]
  have hb : balancedInnovation (balancedRun k c) =
      updateVariance ((q - 1 : ℕ) : ℝ≥0) := by
    unfold balancedInnovation
    rw [hc.1, hc.2, if_neg (by omega : ¬ q ≤ q - 1)]
  rw [hb, hc.1]

theorem saturated_right_gap_preterminal (q k : ℕ) (m1 m2 : ℝ) (c : Counts)
    (hq : 0 < q) (h1 : 0 < c.n1) (h2 : 0 < c.n2)
    (hsaturated : c.n2 = q) (hs : c.n1 + c.n2 + k = 2 * q - 1) :
    payoff (k + 1) m1 m2 c - rightAction k m1 m2 c =
      ∫ x : ℝ, (hingeLoss |x| (updateVariance ((q - 1 : ℕ) : ℝ≥0)) -
        hingeLoss |x| (updateVariance (q : ℝ≥0)))
        ∂BayesOptimal.Foundations.PredictiveLaw.balancedPredictiveLaw k c (m1 - m2) := by
  have hc := saturated_right_prefix_counts q k c hq hsaturated hs
  have hleft : c.n1 + k ≤ c.n2 := by omega
  rw [saturated_right_action_gap_integral _ _ _ _ h1 h2 hleft]
  have hb : balancedInnovation (balancedRun k c) =
      updateVariance ((q - 1 : ℕ) : ℝ≥0) := by
    unfold balancedInnovation
    rw [hc.1, hc.2, if_pos (by omega : q - 1 ≤ q)]
  rw [hb, hc.2]

end

end BayesOptimal.Foundations.TwoArmGain

end

/-! ## Foundations.DynamicGain -/
section

open MeasureTheory ProbabilityTheory Set
open scoped NNReal ENNReal

namespace BayesOptimal.Foundations.DynamicGain

open BayesOptimal.Foundations.Gaussian BayesOptimal.Foundations.Rates BayesOptimal.Foundations.TerminalBounds BayesOptimal.Foundations.PredictiveBound

noncomputable section

theorem gaussian_integral_band_lower {mean : ℝ} {v : ℝ≥0} {T r : ℕ} {c : ℝ}
    {f : ℝ → ℝ} (hf : Integrable f (gaussianReal mean v))
    (hf0 : ∀ x, 0 ≤ f x)
    (hband : ∀ x ∈ Icc (invPower 2 T) (2 * invPower 2 T), c * invPower r T ≤ f x) :
    (c * invPower r T) *
      (gaussianReal mean v (Icc (invPower 2 T) (2 * invPower 2 T))).toReal ≤
        ∫ x : ℝ, f x ∂gaussianReal mean v := by
  have hi : Integrable
      ((Icc (invPower 2 T) (2 * invPower 2 T)).indicator (fun _ : ℝ => c * invPower r T))
      (gaussianReal mean v) := (integrable_const _).indicator measurableSet_Icc
  have hm := integral_mono hi hf (fun x => by
    by_cases hx : x ∈ Icc (invPower 2 T) (2 * invPower 2 T)
    · rw [indicator_of_mem hx]
      exact hband x hx
    · rw [indicator_of_notMem hx]
      exact hf0 x)
  rw [integral_indicator_const _ measurableSet_Icc, smul_eq_mul] at hm
  simpa only [measureReal_def, mul_comm] using hm

theorem nonterminal_hinge_gain_lower (T n : ℕ) (δ : ℝ) (a : ℝ≥0)
    (hT : 5 ≤ T) (hn : 1 ≤ n) (hnT : n < T)
    (ha : 0 < a) (haupper : (a : ℝ) ≤ 2) (halower : invPower 2 T ≤ (a : ℝ))
    (hδ : δ ^ 2 ≤ 204 * Real.log (T : ℝ) * (a : ℝ)) :
    (gainConstant * lowerConstant) * invPower 212 T ≤
      ∫ x : ℝ, hingeLoss |x| (updateVariance (n : ℝ≥0)) ∂gaussianReal δ a := by
  have hmass := gaussian_interval_probability_drift204 T hT ha haupper halower hδ
  have hband := gaussian_integral_band_lower
    (BayesOptimal.Foundations.TwoArmGain.absolute_hinge_gaussian_integrable δ a (updateVariance (n : ℝ≥0)))
    (fun x => hingeLoss_nonnegative |x| _) (r := 6)
    (fun x hx => by
      have hx0 : 0 ≤ x := (invPower_nonneg 2 T).trans hx.1
      have hsmall : |x| ≤ 2 * invPower 2 T := by rw [abs_of_nonneg hx0]; exact hx.2
      have hg := lemma14_sample_count_lower T n x 0 hT hn hnT hsmall
      rw [oneStepImprovement_eq_hinge] at hg
      exact hg)
  have hp := mul_le_mul_of_nonneg_left hmass
    (mul_nonneg gainConstant_positive.le (invPower_nonneg 6 T))
  have he : (gainConstant * invPower 6 T) * (lowerConstant * invPower 206 T) =
      (gainConstant * lowerConstant) * invPower 212 T := by
    rw [← invPower_product 6 206 T]
    ring
  rw [he] at hp
  exact hp.trans hband

theorem nonterminal_hinge_difference_lower (T ni nj : ℕ) (δ : ℝ) (a : ℝ≥0)
    (hT : 5 ≤ T) (hj : 1 ≤ nj) (hstrict : nj < ni) (hiT : ni < T)
    (ha : 0 < a) (haupper : (a : ℝ) ≤ 2) (halower : invPower 2 T ≤ (a : ℝ))
    (hδ : δ ^ 2 ≤ 204 * Real.log (T : ℝ) * (a : ℝ)) :
    (comparisonConstant * lowerConstant) * invPower 214 T ≤
      ∫ x : ℝ,
        hingeLoss |x| (updateVariance (nj : ℝ≥0)) -
        hingeLoss |x| (updateVariance (ni : ℝ≥0)) ∂gaussianReal δ a := by
  have hip : 0 < (ni : ℝ≥0) := by exact_mod_cast (show 0 < ni by omega)
  have hjp : 0 < (nj : ℝ≥0) := by exact_mod_cast (show 0 < nj by omega)
  have hv := updateVariance_strictAntitone (nj : ℝ≥0) (ni : ℝ≥0) hjp
    (by exact_mod_cast hstrict)
  have hi := (BayesOptimal.Foundations.TwoArmGain.absolute_hinge_gaussian_integrable δ a
    (updateVariance (nj : ℝ≥0))).sub
    (BayesOptimal.Foundations.TwoArmGain.absolute_hinge_gaussian_integrable δ a (updateVariance (ni : ℝ≥0)))
  have hmass := gaussian_interval_probability_drift204 T hT ha haupper halower hδ
  have hband := gaussian_integral_band_lower hi
    (fun x => sub_nonneg.mpr (hingeLoss_strictMono_variance |x| (abs_nonneg _) _ _ hv).le)
    (r := 8) (fun x hx => by
      have hx0 : 0 ≤ x := (invPower_nonneg 2 T).trans hx.1
      have hsmall : |x| ≤ 2 * invPower 2 T := by rw [abs_of_nonneg hx0]; exact hx.2
      have hg := lemma15_terminal_action_gap_conservative T ni nj x hT hj hstrict hiT hsmall
      rw [terminal_actionLoss_difference_eq x (ni : ℝ≥0) (nj : ℝ≥0) hjp hip] at hg
      exact hg)
  have hp := mul_le_mul_of_nonneg_left hmass
    (mul_nonneg comparisonConstant_positive.le (invPower_nonneg 8 T))
  have he : (comparisonConstant * invPower 8 T) * (lowerConstant * invPower 206 T) =
      (comparisonConstant * lowerConstant) * invPower 214 T := by
    rw [← invPower_product 8 206 T]
    ring
  rw [he] at hp
  exact hp.trans hband

/-- A terminal gap of order sqrt(log T) standard deviations still gives a polynomial gain. -/
theorem terminal_hinge_gain_lower (T : ℕ) (gap : ℝ) (v : ℝ≥0)
    (hT : 5 ≤ T) (hv : 0 < v) (hvupper : (v : ℝ) ≤ 2)
    (hvlower : invPower 2 T ≤ (v : ℝ))
    (hgap : gap ^ 2 ≤ 204 * Real.log (T : ℝ) * (v : ℝ)) :
    lowerConstant * invPower 208 T ≤ hingeLoss |gap| v := by
  have hmean : (-|gap|) ^ 2 ≤ 204 * Real.log (T : ℝ) * (v : ℝ) := by
    simpa only [neg_sq, sq_abs] using hgap
  have hmass := gaussian_interval_probability_drift204 T hT hv hvupper hvlower hmean
  have hband := gaussian_integral_band_lower
    ((gaussian_id_integrable (-|gap|) v).pos_part)
    (fun x => le_max_right x 0) (c := 1) (T := T) (r := 2)
    (fun x hx => by simpa only [one_mul] using hx.1.trans (le_max_left x 0))
  have hp := mul_le_mul_of_nonneg_left hmass (invPower_nonneg 2 T)
  have he : invPower 2 T * (lowerConstant * invPower 206 T) =
      lowerConstant * invPower 208 T := by
    rw [← invPower_product 2 206 T]
    ring
  rw [he] at hp
  simp only [one_mul] at hband
  have h := hp.trans hband
  rw [gaussian_positivePart_integral] at h
  simpa only [neg_neg] using h

theorem terminal_hinge_difference_lower (T ni nj : ℕ) (gap : ℝ)
    (hT : 5 ≤ T) (hj : 1 ≤ nj) (hstrict : nj < ni) (hiT : ni < T)
    (hgap : gap ^ 2 ≤ 204 * Real.log (T : ℝ) * (updateVariance (ni : ℝ≥0) : ℝ)) :
    (lowerConstant / 2) * invPower 211 T ≤
      hingeLoss |gap| (updateVariance (nj : ℝ≥0)) -
        hingeLoss |gap| (updateVariance (ni : ℝ≥0)) := by
  let vL := updateVariance (ni : ℝ≥0)
  let vR := updateVariance (nj : ℝ≥0)
  let sL := Real.sqrt (vL : ℝ)
  let sR := Real.sqrt (vR : ℝ)
  let a := |gap| / sL
  have hjp : 0 < (nj : ℝ≥0) := by exact_mod_cast (show 0 < nj by omega)
  have hip : 0 < (ni : ℝ≥0) := by exact_mod_cast (show 0 < ni by omega)
  have hvL : 0 < vL := by dsimp [vL, updateVariance]; positivity
  have hsL : 0 < sL := Real.sqrt_pos.mpr hvL
  have hsR : 0 ≤ sR := Real.sqrt_nonneg _
  have ha0 : 0 ≤ a := div_nonneg (abs_nonneg _) hsL.le
  have haeq : sL * a = |gap| := by dsimp [a]; field_simp
  have hvar : vL < vR := updateVariance_strictAntitone (nj : ℝ≥0) (ni : ℝ≥0)
    hjp (by exact_mod_cast hstrict)
  have hs : sL ≤ sR := Real.sqrt_le_sqrt hvar.le
  have hbound := updateVariance_count_bounds nj T hj (by omega)
  have hsig := sqrt_variance_difference_ge_half vL vR hvar.le (by
    dsimp [vR]; linarith only [hbound.2])
  have hdiff := updateVariance_difference_lower ni nj T hj hstrict hiT
  have hsiglower : (1 / 2 : ℝ) * invPower 3 T ≤ sR - sL := by
    dsimp [sL, sR, vL, vR] at *
    linarith only [hsig, hdiff]
  have haLog : (-a) ^ 2 ≤ 204 * Real.log (T : ℝ) := by
    dsimp [a, sL]
    rw [neg_sq, div_pow, sq_abs, Real.sq_sqrt (show 0 ≤ (vL : ℝ) from hvL.le)]
    exact (div_le_iff₀ (show 0 < (vL : ℝ) from hvL)).mpr hgap
  have hmass := gaussian_interval_probability_drift204 T (δ := -a) (v := 1) hT
    (by norm_num) (by norm_num) (by
      simpa [invPower] using invPower_antitone (show 0 ≤ 2 by omega) (by omega : 1 ≤ T))
    (by simpa only [NNReal.coe_one, mul_one] using haLog)
  let f := fun y : ℝ => max (sR * (y + a) - |gap|) 0 - max (sL * (y + a) - |gap|) 0
  have hiR : Integrable (fun y : ℝ => max (sR * (y + a) - |gap|) 0)
      (gaussianReal (-a) 1) :=
    ((((gaussian_id_integrable (-a) 1).add (integrable_const a)).const_mul sR).sub
      (integrable_const |gap|)).pos_part
  have hiL : Integrable (fun y : ℝ => max (sL * (y + a) - |gap|) 0)
      (gaussianReal (-a) 1) :=
    ((((gaussian_id_integrable (-a) 1).add (integrable_const a)).const_mul sL).sub
      (integrable_const |gap|)).pos_part
  have hf0 : ∀ y, 0 ≤ f y := by
    intro y
    dsimp [f]
    apply sub_nonneg.mpr
    by_cases hy : 0 ≤ y + a
    · exact max_le_max (sub_le_sub_right (mul_le_mul_of_nonneg_right hs hy) _) le_rfl
    · have hy' : y + a ≤ 0 := le_of_not_ge hy
      rw [max_eq_right (by nlinarith [mul_nonpos_of_nonneg_of_nonpos hsR hy', abs_nonneg gap]),
        max_eq_right (by nlinarith [mul_nonpos_of_nonneg_of_nonpos hsL.le hy', abs_nonneg gap])]
  have hband := gaussian_integral_band_lower (hiR.sub hiL) hf0 (c := 1 / 2) (T := T) (r := 5)
    (fun y hy => by
      have hy0 : 0 ≤ y := (invPower_nonneg 2 T).trans hy.1
      have hx : a ≤ y + a := by linarith
      have hlinL : 0 ≤ sL * (y + a) - |gap| := by nlinarith [mul_nonneg hsL.le hy0]
      have hlinR : 0 ≤ sR * (y + a) - |gap| := by
        have hmul := mul_le_mul_of_nonneg_right hs (show 0 ≤ y + a by positivity)
        linarith
      dsimp [f]
      rw [max_eq_left hlinL, max_eq_left hlinR]
      have hp1 := mul_le_mul_of_nonneg_right hsiglower (show 0 ≤ y + a by positivity)
      have hp2 := mul_le_mul_of_nonneg_left (hy.1.trans (by linarith : y ≤ y + a))
        (mul_nonneg (by norm_num : (0 : ℝ) ≤ 1 / 2) (invPower_nonneg 3 T))
      have he : (1 / 2 : ℝ) * invPower 5 T =
          ((1 / 2 : ℝ) * invPower 3 T) * invPower 2 T := by
        rw [← invPower_product 3 2 T]
        ring
      rw [he]
      nlinarith only [hp1, hp2])
  have hp := mul_le_mul_of_nonneg_left hmass
    (mul_nonneg (by norm_num : (0 : ℝ) ≤ 1 / 2) (invPower_nonneg 5 T))
  have he : ((1 / 2 : ℝ) * invPower 5 T) * (lowerConstant * invPower 206 T) =
      (lowerConstant / 2) * invPower 211 T := by
    rw [← invPower_product 5 206 T]
    ring
  rw [he] at hp
  have hlow := hp.trans hband
  change (lowerConstant / 2) * invPower 211 T ≤ ∫ y : ℝ, f y ∂gaussianReal (-a) 1 at hlow
  have hmap : (gaussianReal 0 1).map (fun x : ℝ => x - a) = gaussianReal (-a) 1 := by
    simpa using gaussianReal_map_sub_const (μ := (0 : ℝ)) (v := 1) a
  have heq : (∫ y : ℝ, f y ∂gaussianReal (-a) 1) =
      hingeLoss |gap| vR - hingeLoss |gap| vL := by
    rw [← hmap, integral_map (by fun_prop) (by fun_prop)]
    simp only [f, sub_add_cancel]
    have hiR0 : Integrable (fun x : ℝ => max (sR * x - |gap|) 0) (gaussianReal 0 1) := by
      simpa only [Pi.sub_apply] using
        ((((gaussian_id_integrable 0 1).const_mul sR).sub (integrable_const |gap|)).pos_part)
    have hiL0 : Integrable (fun x : ℝ => max (sL * x - |gap|) 0) (gaussianReal 0 1) := by
      simpa only [Pi.sub_apply] using
        ((((gaussian_id_integrable 0 1).const_mul sL).sub (integrable_const |gap|)).pos_part)
    rw [integral_sub hiR0 hiL0,
      hingeLoss_eq_standard_integral, hingeLoss_eq_standard_integral]
  rw [heq] at hlow
  exact hlow

end

end BayesOptimal.Foundations.DynamicGain

