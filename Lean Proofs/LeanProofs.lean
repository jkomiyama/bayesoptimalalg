/-! ## Probability -/
section

open MeasureTheory ProbabilityTheory Set
open scoped NNReal ENNReal

namespace BayesOptimal.Probability

open BayesOptimal.Foundations BadEvent

noncomputable section

def f3 (T : ℕ) : ℝ := 2 * Real.exp (-(7 / 2 : ℝ) * Real.log (T : ℝ))

theorem f3_eq_rpow (T : ℕ) (hT : 0 < T) :
    f3 T = 2 * (T : ℝ) ^ (-(7 / 2 : ℝ)) := by
  rw [f3, Real.rpow_def_of_pos (by exact_mod_cast hT)]
  congr 1
  congr 1
  ring

def driftThreshold3 (T n q : ℕ) : ℝ :=
  3 * Real.sqrt (Real.log (T : ℝ)) * Real.sqrt (Drift.reciprocalSqSum n q)

def driftFailure3 (T n q : ℕ) : Set (Fin q → ℝ) :=
  {ω | driftThreshold3 T n q < |sampleMean n ω - sampleMean q ω|}

def goodDriftSet3 (T q : ℕ) : Set (Fin q → ℝ) :=
  {ω | ∀ n : ℕ, 1 ≤ n → n ≤ q →
    |sampleMean n ω - sampleMean q ω| ≤ driftThreshold3 T n q}

def goodArmSet3 (T q : ℕ) : Set (Fin q → ℝ) :=
  goodMeanSet T q ∩ goodDriftSet3 T q

theorem goodDriftSet3_measurable (T q : ℕ) : MeasurableSet (goodDriftSet3 T q) := by
  unfold goodDriftSet3
  simp only [Set.setOf_forall]
  apply MeasurableSet.iInter
  intro n
  apply MeasurableSet.iInter
  intro _hn
  apply MeasurableSet.iInter
  intro _hnq
  apply measurableSet_le
  · unfold sampleMean weightedSum
    fun_prop
  · exact measurable_const

theorem goodArmSet3_measurable (T q : ℕ) : MeasurableSet (goodArmSet3 T q) :=
  (goodMeanSet_measurable T q).inter (goodDriftSet3_measurable T q)

theorem driftFailure3_probability_le (T n q : ℕ) (hT : 5 ≤ T) (hn : 0 < n) (hnq : n ≤ q) :
    (arrayLaw q).real (driftFailure3 T n q) ≤ 2 * Real.exp (-(9 / 2 : ℝ) * Real.log (T : ℝ)) := by
  by_cases hnqeq : n = q
  · subst n
    have hset : driftFailure3 T q q = ∅ := by
      ext ω
      simp [driftFailure3, driftThreshold3, Drift.reciprocalSqSum]
    rw [hset]
    simp only [measureReal_empty]
    exact mul_nonneg (by norm_num) (Real.exp_pos _).le
  have hnqlt : n < q := by omega
  have hnr : 0 < (n : ℝ) := by exact_mod_cast hn
  have hqr : 0 < (q : ℝ) := by exact_mod_cast (show 0 < q by omega)
  have hTr : 0 < (T : ℝ) := by exact_mod_cast (show 0 < T by omega)
  have hlog := Drift.log_horizon_ge_one T hT
  have hlog0 : 0 ≤ Real.log (T : ℝ) := by linarith only [hlog]
  have hvarEq := driftVariance_coe n q hn hnq
  have hv : 0 < driftVariance n q := by
    change 0 < (driftVariance n q : ℝ)
    rw [hvarEq]
    exact sub_pos.mpr ((inv_lt_inv₀ hqr hnr).mpr (by exact_mod_cast hnqlt))
  have hVarBound : (driftVariance n q : ℝ) ≤ Drift.reciprocalSqSum n q := by
    rw [hvarEq]
    exact reciprocalSqSum_ge_variance n q hn hnq
  have hthreshold0 : 0 ≤ driftThreshold3 T n q := by unfold driftThreshold3; positivity
  have hthresholdsq : (driftThreshold3 T n q) ^ 2 =
      9 * Real.log (T : ℝ) * Drift.reciprocalSqSum n q := by
    unfold driftThreshold3
    rw [mul_pow, mul_pow, Real.sq_sqrt hlog0,
      Real.sq_sqrt (Drift.reciprocalSqSum_nonnegative n q)]
    norm_num
  have hscaled := mul_le_mul_of_nonneg_left hVarBound hlog0
  have hquot : (9 / 2 : ℝ) * Real.log (T : ℝ) ≤ (driftThreshold3 T n q) ^ 2 / (2 * (driftVariance n q : ℝ)) := by
    apply (le_div_iff₀ (by positivity)).mpr
    rw [hthresholdsq]
    nlinarith only [hscaled]
  have hexp : Real.exp (-(driftThreshold3 T n q) ^ 2 / (2 * (driftVariance n q : ℝ))) ≤
      Real.exp (-(9 / 2 : ℝ) * Real.log (T : ℝ)) := by
    apply Real.exp_le_exp.mpr
    rw [neg_div]
    norm_num
    linarith only [hquot]
  have hsub := gaussian_law_subgaussian (sampleMean_difference_law n q)
  have hright := hsub.measure_ge_le hthreshold0
  have hleft := hsub.neg.measure_ge_le hthreshold0
  have hsubset : driftFailure3 T n q ⊆
      {ω | driftThreshold3 T n q ≤ sampleMean n ω - sampleMean q ω} ∪
        {ω | driftThreshold3 T n q ≤ -(sampleMean n ω - sampleMean q ω)} := by
    intro ω hω
    change driftThreshold3 T n q < |sampleMean n ω - sampleMean q ω| at hω
    rw [lt_abs] at hω
    rcases hω with hω | hω
    · exact Or.inl (le_of_lt hω)
    · exact Or.inr (le_of_lt hω)
  have hmono := measureReal_mono (μ := arrayLaw q) hsubset
  have hunion := measureReal_union_le (μ := arrayLaw q)
    {ω | driftThreshold3 T n q ≤ sampleMean n ω - sampleMean q ω}
    {ω | driftThreshold3 T n q ≤ -(sampleMean n ω - sampleMean q ω)}
  simp only [Pi.neg_apply] at hleft
  linarith only [hmono, hunion, hright, hleft, hexp]

theorem goodDriftSet3_compl_probability_le (T q : ℕ) (hT : 5 ≤ T) (hqT : q ≤ T) :
    (arrayLaw q).real (goodDriftSet3 T q)ᶜ ≤ f3 T := by
  have hsubset : (goodDriftSet3 T q)ᶜ ⊆ ⋃ i : Fin q, driftFailure3 T ((i : ℕ) + 1) q := by
    intro ω hω
    simp only [goodDriftSet3, Set.mem_compl_iff, Set.mem_setOf_eq] at hω
    push_neg at hω
    rcases hω with ⟨n, hn, hnq, hf⟩
    let i : Fin q := ⟨n - 1, by omega⟩
    apply Set.mem_iUnion.mpr
    refine ⟨i, ?_⟩
    have hi : (i : ℕ) + 1 = n := by dsimp [i]; omega
    rw [hi]
    exact hf
  have hmono := measureReal_mono (μ := arrayLaw q) hsubset
  have hunion := measureReal_iUnion_fintype_le (μ := arrayLaw q)
    (fun i : Fin q => driftFailure3 T ((i : ℕ) + 1) q)
  have hsum : (∑ i : Fin q, (arrayLaw q).real (driftFailure3 T ((i : ℕ) + 1) q)) ≤
      (q : ℝ) * (2 * Real.exp (-(9 / 2 : ℝ) * Real.log (T : ℝ))) := by
    calc
      _ ≤ ∑ _i : Fin q, 2 * Real.exp (-(9 / 2 : ℝ) * Real.log (T : ℝ)) := by
        apply Finset.sum_le_sum
        intro i _hi
        exact driftFailure3_probability_le T _ q hT (by omega) (by have hi := i.isLt; omega)
      _ = _ := by simp
  have hqTr : (q : ℝ) ≤ (T : ℝ) := by exact_mod_cast hqT
  have hscale := mul_le_mul_of_nonneg_right hqTr
    (mul_nonneg (by norm_num : (0 : ℝ) ≤ 2)
      (Real.exp_pos (-(9 / 2 : ℝ) * Real.log (T : ℝ))).le)
  have hrate : (T : Real) * (2 * Real.exp (-(9 / 2 : Real) * Real.log (T : Real))) = f3 T := by
    unfold f3
    calc
      _ = 2 * (Real.exp (Real.log (T : Real)) * Real.exp (-(9 / 2 : Real) * Real.log (T : Real))) := by
        rw [Real.exp_log (by exact_mod_cast (show 0 < T by omega))]
        ring
      _ = 2 * Real.exp (Real.log (T : Real) + -(9 / 2 : Real) * Real.log (T : Real)) := by rw [Real.exp_add]
      _ = _ := by congr 2; ring
  rw [hrate] at hscale
  linarith only [hmono, hunion, hsum, hscale]

theorem lemma5 (T q : ℕ) (hT : 5 ≤ T) (hqT : q ≤ T) :
    (arrayLaw q).real (goodMeanSet T q ∩ (goodDriftSet3 T q)ᶜ) ≤
      2 * (T : ℝ) ^ (-(7 / 2 : ℝ)) := by
  rw [← f3_eq_rpow T (by omega)]
  exact (measureReal_mono (inter_subset_right)).trans
    (goodDriftSet3_compl_probability_le T q hT hqT)

theorem lemma4 (T q : ℕ) (hT : T = 2 * q + 1) (hq : 0 < q) :
    SmallBall.f2 (T : ℝ) ≤ (arrayLaw q).real (goodMeanSet T q) := by
  have hLaw := sampleMean_law q q hq le_rfl
  have hmass : (arrayLaw q).real (goodMeanSet T q) =
      (gaussianReal 0 (q : ℝ≥0)⁻¹ (Icc (-Rates.invPower 2 T) (Rates.invPower 2 T))).toReal := by
    rw [← hLaw.map_eq, Measure.map_apply_of_aemeasurable hLaw.aemeasurable measurableSet_Icc]
    congr 1
    ext ω
    simp only [goodMeanSet, Set.mem_setOf_eq, Set.mem_preimage, Set.mem_Icc, abs_le]
  have h := SmallBall.appendixB_probability_lower q hq
  have hTr : (T : ℝ) = 2 * (q : ℝ) + 1 := by exact_mod_cast hT
  rw [← hTr] at h
  rw [hmass]
  exact h

theorem goodArmSet3_probability_lower (T q : ℕ)
    (horizon : T = 2 * q + 1) (hq : 2 ≤ q) :
    SmallBall.f2 (T : ℝ) - f3 T ≤ (arrayLaw q).real (goodArmSet3 T q) := by
  have hmean := lemma4 T q horizon (by omega)
  have hdrift := goodDriftSet3_compl_probability_le T q (by omega) (by omega)
  have hdecomp := measureReal_inter_add_diff (μ := arrayLaw q)
    (s := goodMeanSet T q) (goodDriftSet3_measurable T q)
  have hsubset : goodMeanSet T q \ goodDriftSet3 T q ⊆ (goodDriftSet3 T q)ᶜ := by
    exact fun _ h => h.2
  have hdiff := measureReal_mono (μ := arrayLaw q) hsubset
  unfold goodArmSet3
  linarith only [hmean, hdrift, hdecomp, hdiff]

theorem f2_minus_f3_nonnegative (T : ℕ) (hT : 8 ≤ T) :
    0 ≤ SmallBall.f2 (T : ℝ) - f3 T := by
  have hTr : (8 : ℝ) ≤ T := by exact_mod_cast hT
  have hTp : 0 < (T : ℝ) := by linarith
  have hlog : 0 ≤ Real.log (T : ℝ) := Real.log_nonneg (by linarith)
  have hsmall : f3 T ≤ 2 * Rates.invPower 3 T := by
    unfold f3 Rates.invPower
    rw [← PredictiveBound.exp_neg_nat_log 3 hTp]
    apply mul_le_mul_of_nonneg_left _ (by norm_num)
    apply Real.exp_le_exp.mpr
    norm_num
    nlinarith
  have hrate : 2 * Rates.invPower 3 T ≤ (1 / 4 : ℝ) * Rates.invPower 2 T := by
    unfold Rates.invPower
    field_simp [ne_of_gt hTp]
    nlinarith only [hTr]
  have hf2 := f2_polynomial_lower T (by omega)
  linarith

end

end BayesOptimal.Probability

end

/-! ## ProbabilityModel -/
section

open MeasureTheory ProbabilityTheory Set
open scoped NNReal ENNReal

namespace BayesOptimal.Probability

open BayesOptimal.Foundations BadEvent

noncomputable section

def frequentistLawDelta (q : ℕ) (Δ : ℝ) : Measure (FullSample q) :=
  (gaussianReal Δ 1).prod ((arrayLaw q).prod (arrayLaw q))

instance frequentistLawDelta_probability (q : ℕ) (Δ : ℝ) :
    IsProbabilityMeasure (frequentistLawDelta q Δ) := by
  unfold frequentistLawDelta
  infer_instance

def underestimationSet (T : ℕ) (CU : ℝ) : Set ℝ :=
  Iic (-CU * Real.sqrt (Real.log (T : ℝ)))

def badEvent (T q : ℕ) (CU : ℝ) : Set (FullSample q) :=
  underestimationSet T CU ×ˢ (goodArmSet3 T q ×ˢ goodArmSet3 T q)

theorem badEvent_measurable (T q : ℕ) (CU : ℝ) : MeasurableSet (badEvent T q CU) :=
  measurableSet_Iic.prod ((goodArmSet3_measurable T q).prod (goodArmSet3_measurable T q))

def projectRawArraysDelta (T q : ℕ) (Δ : ℝ) (hqT : q ≤ T) (hT : 0 < T)
    (ω : RawArrays T) : FullSample q :=
  (ω 2 ⟨0, hT⟩ + Δ, (arrayPrefix hqT (ω 0), arrayPrefix hqT (ω 1)))

theorem projectRawArraysDelta_preserving (T q : ℕ) (Δ : ℝ)
    (hqT : q ≤ T) (hT : 0 < T) :
    MeasurePreserving (projectRawArraysDelta T q Δ hqT hT)
      (rawArraysLaw T) (frequentistLawDelta q Δ) := by
  have hprefix := arrayPrefix_preserving hqT
  have hfirst : MeasurePreserving (fun ω : Fin T → ℝ => ω ⟨0, hT⟩ + Δ)
      (arrayLaw T) (gaussianReal Δ 1) := by
    have heval := measurePreserving_eval (fun _ : Fin T => gaussianReal 0 1) (⟨0, hT⟩ : Fin T)
    have hshift : MeasurePreserving (fun x : ℝ => x + Δ) (gaussianReal 0 1) (gaussianReal Δ 1) := by
      constructor
      · fun_prop
      · simpa using (gaussianReal_map_add_const (μ := (0 : ℝ)) (v := (1 : ℝ≥0)) Δ)
    exact hshift.comp heval
  have htwo := measurePreserving_piFinTwo (fun _ : Fin 2 => arrayLaw T)
  have hpair := (hprefix.prod hprefix).comp htwo
  have hthree := measurePreserving_piFinSuccAbove (fun _ : Fin 3 => arrayLaw T) (2 : Fin 3)
  have hfull := (hfirst.prod hpair).comp hthree
  convert hfull using 1

def rawBadEvent (T q : ℕ) (Δ CU : ℝ) (hqT : q ≤ T) (hT : 0 < T) : Set (RawArrays T) :=
  projectRawArraysDelta T q Δ hqT hT ⁻¹' badEvent T q CU

theorem rawBadEvent_measurable (T q : ℕ) (Δ CU : ℝ) (hqT : q ≤ T) (hT : 0 < T) :
    MeasurableSet (rawBadEvent T q Δ CU hqT hT) :=
  (projectRawArraysDelta_preserving T q Δ hqT hT).measurable
    (badEvent_measurable T q CU)

def rawMeanPath {T : ℕ} (Δ : ℝ) (ω : RawArrays T) : Counts.MeanPath :=
  fun i n => if i = 1 then sampleMean n (ω 0)
    else if i = 2 then sampleMean n (ω 1) else sampleMean n (ω 2) + Δ

theorem rawBadEvent_implies_newW (T q : ℕ) (Δ CU : ℝ) (hqT : q ≤ T) (hT : 0 < T)
    (ω : RawArrays T) (hω : ω ∈ rawBadEvent T q Δ CU hqT hT)
    (c : Counts.Counts) (hc1 : c.n1 ≤ q) (hc2 : c.n2 ≤ q) (hc3 : c.n3 ≤ 1) :
    BayesOptimal.Comparison.newW T q CU (rawMeanPath Δ ω) c := by
  change (projectRawArraysDelta T q Δ hqT hT ω).1 ∈ underestimationSet T CU ∧
    (projectRawArraysDelta T q Δ hqT hT ω).2.1 ∈ goodArmSet3 T q ∧
    (projectRawArraysDelta T q Δ hqT hT ω).2.2 ∈ goodArmSet3 T q at hω
  rcases hω with ⟨hX, ⟨hY1, hZ1⟩, ⟨hY2, hZ2⟩⟩
  unfold BayesOptimal.Comparison.newW
  refine ⟨?_, ?_, ?_, ?_, ?_, hc1, hc2, hc3⟩
  · unfold Drift.eventX rawMeanPath
    norm_num
    rw [sampleMean_one hT]
    simpa [projectRawArraysDelta, underestimationSet] using hX
  · unfold Drift.eventY rawMeanPath
    norm_num
    have he := sampleMean_arrayPrefix_eq hqT q le_rfl (ω 0)
    simpa [goodMeanSet, projectRawArraysDelta, he, Rates.invPower, one_div] using hY1
  · unfold Drift.eventY rawMeanPath
    norm_num
    have he := sampleMean_arrayPrefix_eq hqT q le_rfl (ω 1)
    simpa [goodMeanSet, projectRawArraysDelta, he, Rates.invPower, one_div] using hY2
  · intro n hn hnq
    have h := hZ1 n hn hnq
    have hen := sampleMean_arrayPrefix_eq hqT n hnq (ω 0)
    have heq := sampleMean_arrayPrefix_eq hqT q le_rfl (ω 0)
    simpa [rawMeanPath, projectRawArraysDelta, driftThreshold3, hen, heq] using h
  · intro n hn hnq
    have h := hZ2 n hn hnq
    have hen := sampleMean_arrayPrefix_eq hqT n hnq (ω 1)
    have heq := sampleMean_arrayPrefix_eq hqT q le_rfl (ω 1)
    simpa [rawMeanPath, projectRawArraysDelta, driftThreshold3, hen, heq] using h

theorem badEvent_probability_eq (T q : ℕ) (Δ CU : ℝ) :
    (frequentistLawDelta q Δ).real (badEvent T q CU) =
      (gaussianReal Δ 1).real (underestimationSet T CU) *
        ((arrayLaw q).real (goodArmSet3 T q)) ^ 2 := by
  unfold frequentistLawDelta badEvent Measure.real
  rw [Measure.prod_prod, Measure.prod_prod, ENNReal.toReal_mul, ENNReal.toReal_mul]
  ring

theorem rawBadEvent_probability_eq (T q : ℕ) (Δ CU : ℝ) (hqT : q ≤ T) (hT : 0 < T) :
    (rawArraysLaw T).real (rawBadEvent T q Δ CU hqT hT) =
      (gaussianReal Δ 1).real (underestimationSet T CU) *
        ((arrayLaw q).real (goodArmSet3 T q)) ^ 2 := by
  have hp := projectRawArraysDelta_preserving T q Δ hqT hT
  have h := hp.measure_preimage (badEvent_measurable T q CU).nullMeasurableSet
  change rawArraysLaw T (rawBadEvent T q Δ CU hqT hT) =
    frequentistLawDelta q Δ (badEvent T q CU) at h
  unfold Measure.real
  rw [h]
  exact badEvent_probability_eq T q Δ CU

end

end BayesOptimal.Probability

end

/-! ## Policy -/
section

open MeasureTheory ProbabilityTheory

namespace BayesOptimal.Policy

set_option maxHeartbeats 800000

open BayesOptimal.Foundations.BayesianModel

noncomputable section

/-- Posterior-state policies can use the fresh external real randomizer. The
decision maps contain no latent parameter or unrevealed reward argument. -/
structure StatePolicy where
  draw : ℕ → Counts → Means → ℝ → Arm
  recommend : Counts → Means → ℝ → Arm
  draw_measurable : ∀ t, Measurable (fun x : Counts × Means × ℝ => draw t x.1 x.2.1 x.2.2)
  recommend_measurable : Measurable (fun x : Counts × Means × ℝ => recommend x.1 x.2.1 x.2.2)

def PointwiseOptimal (π : StatePolicy) (T : ℕ) : Prop :=
  (∀ (t : ℕ) (c : Counts) (m : Means) (u : ℝ), 4 ≤ t → t ≤ T →
    (∀ i, 0 < c i) → action (T - t) c m (π.draw t c m u) = value (T - t + 1) c m) ∧
  (∀ (c : Counts) (m : Means) (u : ℝ), (∀ i, 0 < c i) →
    m (π.recommend c m u) = terminal m)

abbrev Path := BayesOptimal.Foundations.PolicyPaths.Path
abbrev RandomPath := ℕ → ℝ

def afterInitial (π : StatePolicy) (p : Path) (u : RandomPath) : ℕ → Counts
  | 0 => fun _ => 1
  | r + 1 =>
    let c := afterInitial π p u r
    advance c (π.draw (r + 4) c (BayesOptimal.Foundations.PolicyPaths.meansAt p c) (u (r + 3)))

def counts (π : StatePolicy) (p : Path) (u : RandomPath) (s : ℕ) : Counts :=
  afterInitial π p u (s - 3)

def selected (π : StatePolicy) (p : Path) (u : RandomPath) (t : ℕ) : Arm :=
  let c := counts π p u (t - 1)
  π.draw t c (BayesOptimal.Foundations.PolicyPaths.meansAt p c) (u (t - 1))

def recommendation (π : StatePolicy) (T : ℕ) (p : Path) (u : RandomPath) : Arm :=
  let c := counts π p u T
  π.recommend c (BayesOptimal.Foundations.PolicyPaths.meansAt p c) (u T)

theorem counts_initial (π : StatePolicy) (p : Path) (u : RandomPath) (i : Arm) :
    counts π p u 3 i = 1 := rfl

theorem counts_update (π : StatePolicy) (p : Path) (u : RandomPath) (s : ℕ) (hs : 3 ≤ s) :
    counts π p u (s + 1) = advance (counts π p u s) (selected π p u (s + 1)) := by
  have he : s + 1 - 3 = (s - 3) + 1 := by omega
  have ht : (s - 3) + 4 = s + 1 := by omega
  have hu : (s - 3) + 3 = s := by omega
  simp only [counts, he, afterInitial, selected, Nat.add_sub_cancel, ht, hu]

theorem counts_positive (π : StatePolicy) (p : Path) (u : RandomPath) (s : ℕ) (i : Arm) :
    0 < counts π p u s i := by
  unfold counts
  generalize s - 3 = r
  induction r with
  | zero => norm_num [afterInitial]
  | succ r ih =>
    simp only [afterInitial, advance]
    omega

theorem selected_optimal (π : StatePolicy) (T : ℕ) (hπ : PointwiseOptimal π T)
    (p : Path) (u : RandomPath) (t : ℕ) (ht : 4 ≤ t) (htT : t ≤ T) :
    action (T - t) (counts π p u (t - 1))
      (BayesOptimal.Foundations.PolicyPaths.meansAt p (counts π p u (t - 1))) (selected π p u t) =
    value (T - t + 1) (counts π p u (t - 1))
      (BayesOptimal.Foundations.PolicyPaths.meansAt p (counts π p u (t - 1))) := by
  exact hπ.1 t _ _ _ ht htT (counts_positive π p u (t - 1))

theorem recommendation_greedy (π : StatePolicy) (T : ℕ) (hπ : PointwiseOptimal π T)
    (p : Path) (u : RandomPath) (i : Arm) :
    BayesOptimal.Foundations.PolicyPaths.meansAt p (counts π p u T) i ≤
      BayesOptimal.Foundations.PolicyPaths.meansAt p (counts π p u T) (recommendation π T p u) := by
  rw [show BayesOptimal.Foundations.PolicyPaths.meansAt p (counts π p u T) (recommendation π T p u) =
      terminal (BayesOptimal.Foundations.PolicyPaths.meansAt p (counts π p u T)) from
    hπ.2 _ _ _ (counts_positive π p u T)]
  exact (recommend_greedy _ i).trans_eq (recommend_max _)

theorem afterInitial_joint_measurable (π : StatePolicy) (r : ℕ) :
    Measurable (fun x : Path × RandomPath => afterInitial π x.1 x.2 r) := by
  induction r with
  | zero => exact measurable_const
  | succ r ih =>
    have hp : Measurable (fun x : Path × RandomPath => x.1) := measurable_fst
    have hm := BayesOptimal.Foundations.PolicyPaths.meansAt_joint_measurable.comp (ih.prodMk hp)
    have hu : Measurable (fun x : Path × RandomPath => x.2 (r + 3)) :=
      (measurable_pi_apply (r + 3)).comp measurable_snd
    have ha := (π.draw_measurable (r + 4)).comp (ih.prodMk (hm.prodMk hu))
    simp only [afterInitial]
    exact (measurable_of_countable (fun x : Counts × Arm => advance x.1 x.2)).comp
      (ih.prodMk ha)

theorem counts_joint_measurable (π : StatePolicy) (s : ℕ) :
    Measurable (fun x : Path × RandomPath => counts π x.1 x.2 s) :=
  afterInitial_joint_measurable π (s - 3)

theorem recommendation_joint_measurable (π : StatePolicy) (T : ℕ) :
    Measurable (fun x : Path × RandomPath => recommendation π T x.1 x.2) := by
  have hc := counts_joint_measurable π T
  have hp : Measurable (fun x : Path × RandomPath => x.1) := measurable_fst
  have hm := BayesOptimal.Foundations.PolicyPaths.meansAt_joint_measurable.comp (hc.prodMk hp)
  have hu : Measurable (fun x : Path × RandomPath => x.2 T) :=
    (measurable_pi_apply T).comp measurable_snd
  exact π.recommend_measurable.comp (hc.prodMk (hm.prodMk hu))

theorem bellman_draw_measurable (T t : ℕ) :
    Measurable (fun x : Counts × Means × ℝ =>
      BayesOptimal.Foundations.BayesianModel.choose (T - t) x.1 x.2.1) := by
  apply measurable_from_prod_countable_right
  intro c
  exact (BayesOptimal.Foundations.PolicyPaths.choose_measurable (T - t) c).comp
    (measurable_fst : Measurable (fun x : Means × ℝ => x.1))

theorem bellman_recommend_measurable :
    Measurable (fun x : Counts × Means × ℝ => BayesOptimal.Foundations.BayesianModel.recommend x.2.1) := by
  have hm : Measurable (fun x : Counts × Means × ℝ => x.2.1) :=
    measurable_fst.comp measurable_snd
  exact BayesOptimal.Foundations.PolicyPaths.recommend_measurable.comp hm

def deterministicBellman (T : ℕ) : StatePolicy where
  draw := fun t c m _ => BayesOptimal.Foundations.BayesianModel.choose (T - t) c m
  recommend := fun _ m _ => BayesOptimal.Foundations.BayesianModel.recommend m
  draw_measurable := bellman_draw_measurable T
  recommend_measurable := bellman_recommend_measurable

theorem deterministicBellman_optimal (T : ℕ) : PointwiseOptimal (deterministicBellman T) T := by
  constructor
  · intro t c m u _ _ _
    exact choose_optimal (T - t) c m
  · intro c m u _
    exact recommend_max m

end
end BayesOptimal.Policy

end

/-! ## PathInduction -/
section

namespace BayesOptimal.PathInduction

open BayesOptimal.Foundations.BayesianModel BayesOptimal.Foundations.PolicyPaths BayesOptimal.Foundations.DynamicPolicy
open BayesOptimal.Foundations.PathInduction
open BayesOptimal.Foundations.MainBridge (invariant)
open BayesOptimal.Comparison

noncomputable section

def GoodPath (T q : ℕ) (CU : ℝ) (p : Path) : Prop :=
  BayesOptimal.Foundations.Drift.eventX T CU (paperPath p) ∧ BayesOptimal.Foundations.Drift.eventY T q 1 (paperPath p) ∧
  BayesOptimal.Foundations.Drift.eventY T q 2 (paperPath p) ∧ newZ T q 1 (paperPath p) ∧ newZ T q 2 (paperPath p)

theorem modelCounts_project (c : Counts) : modelCounts (projectCounts c) = c := by
  ext i
  fin_cases i <;> simp [modelCounts, projectCounts]

theorem modelMeans_project (p : Path) (c : Counts) :
    modelMeans (paperPath p) (projectCounts c) = meansAt p c := by
  ext i
  fin_cases i <;> simp [modelMeans, projectCounts, paperPath, meansAt]

theorem GoodPath_W (T q s : ℕ) (CU : ℝ) (p : Path) (c : Counts)
    (hp : GoodPath T q CU p) (hc : invariant q s c) :
    newW T q CU (paperPath p) (projectCounts c) :=
  ⟨hp.1, hp.2.1, hp.2.2.1, hp.2.2.2.1, hp.2.2.2.2, hc.1, hc.2.1, hc.2.2.1.le⟩

theorem projected_consistent (t : ℕ) (c : Counts) (hcpos : ∀ i, 0 < c i)
    (hc3 : c 2 = 1) (hs : c 0 + c 1 + c 2 = t-1) :
    BayesOptimal.Foundations.Counts.horizonConsistent t (projectCounts c) := by
  exact ⟨hcpos 0, hcpos 1, hc3, hs⟩

theorem counts_invariant_before_terminal (π : BayesOptimal.Policy.StatePolicy) (T q : ℕ)
    (hq : 2 ≤ q) (p : Path) (u : BayesOptimal.Policy.RandomPath)
    (hpolicy : ∀ s, 3 ≤ s → s < T-1 →
      invariant q s (BayesOptimal.Policy.counts π p u s) →
      BayesOptimal.Foundations.MainBridge.admissible q (BayesOptimal.Policy.counts π p u s)
        (BayesOptimal.Policy.selected π p u (s+1))) :
    ∀ s, 3 ≤ s → s ≤ T-1 → invariant q s (BayesOptimal.Policy.counts π p u s) := by
  intro s
  induction s using Nat.strong_induction_on with
  | h s ih =>
    intro hlo hhi
    by_cases hbase : s = 3
    · subst s
      change (1 : ℕ) ≤ q ∧ 1 ≤ q ∧ 1 = 1 ∧ 1+1+1=3
      omega
    · have hprev : 3 ≤ s-1 := by omega
      have he : s-1+1=s := by omega
      have hc := ih (s-1) (by omega) hprev (by omega)
      have ha := hpolicy (s-1) hprev (by omega) hc
      rw [← he, BayesOptimal.Policy.counts_update π p u (s-1) hprev]
      simpa only [he] using BayesOptimal.Foundations.MainBridge.advance_invariant q (s-1)
        (BayesOptimal.Policy.counts π p u (s-1)) (BayesOptimal.Policy.selected π p u s) hc
        (by simpa only [he] using ha)

theorem optimal_bad_path_wrong (π : BayesOptimal.Policy.StatePolicy) (T q : ℕ) (CU : ℝ)
    (hT : T=2*q+1) (hlarge : 9 ≤ T) (hCU : 33 ≤ CU)
    (hπ : BayesOptimal.Policy.PointwiseOptimal π T) (p : Path) (u : BayesOptimal.Policy.RandomPath)
    (hp : GoodPath T q CU p)
    (hbefore : ∀ (t : ℕ) (c : BayesOptimal.Foundations.Counts.Counts) (a : Arm),
      4 ≤ t → t < T → BayesOptimal.Foundations.Counts.horizonConsistent t c → newW T q CU (paperPath p) c →
      action (T-t) (modelCounts c) (modelMeans (paperPath p) c) a =
        value (T-t+1) (modelCounts c) (modelMeans (paperPath p) c) →
      BayesOptimal.Foundations.DynamicPolicy.admissible q c a)
    (hlast : ∀ (c : BayesOptimal.Foundations.Counts.Counts) (a : Arm),
      BayesOptimal.Foundations.Counts.horizonConsistent T c → newW T q CU (paperPath p) c →
      action 0 (modelCounts c) (modelMeans (paperPath p) c) a =
        value 1 (modelCounts c) (modelMeans (paperPath p) c) → a ≠ 2) :
    BayesOptimal.Policy.recommendation π T p u ≠ 2 := by
  have hq : 2 ≤ q := by omega
  have hinv := counts_invariant_before_terminal π T q hq p u (fun s hs hsT hc => by
    have hc' := projected_consistent (s+1) (BayesOptimal.Policy.counts π p u s)
      (BayesOptimal.Policy.counts_positive π p u s) hc.2.2.1
      (by simpa only [Nat.add_sub_cancel] using hc.2.2.2)
    have hW := GoodPath_W T q s CU p (BayesOptimal.Policy.counts π p u s) hp hc
    have ho := BayesOptimal.Policy.selected_optimal π T hπ p u (s+1) (by omega) (by omega)
    simp only [Nat.add_sub_cancel] at ho
    have ha := hbefore (s+1) (projectCounts (BayesOptimal.Policy.counts π p u s))
      (BayesOptimal.Policy.selected π p u (s+1)) (by omega) (by omega) hc' hW
      (by simpa only [modelCounts_project, modelMeans_project] using ho)
    exact ha)
  have hc := hinv (T-1) (by omega) le_rfl
  have hc' := projected_consistent T (BayesOptimal.Policy.counts π p u (T-1))
    (BayesOptimal.Policy.counts_positive π p u (T-1)) hc.2.2.1 hc.2.2.2
  have hW := GoodPath_W T q (T-1) CU p (BayesOptimal.Policy.counts π p u (T-1)) hp hc
  have ho := BayesOptimal.Policy.selected_optimal π T hπ p u T (by omega) le_rfl
  simp only [Nat.sub_self, zero_add] at ho
  have ha := hlast (projectCounts (BayesOptimal.Policy.counts π p u (T-1)))
    (BayesOptimal.Policy.selected π p u T) hc' hW
    (by simpa only [modelCounts_project, modelMeans_project] using ho)
  have hu := BayesOptimal.Policy.counts_update π p u (T-1) (by omega)
  have ht : T-1+1=T := by omega
  rw [ht] at hu
  have hthird : BayesOptimal.Policy.counts π p u T 2 = 1 := by
    rw [hu]
    simp only [BayesOptimal.Foundations.BayesianModel.advance, if_neg ha.symm, add_zero]
    exact hc.2.2.1
  have hanchor : ∃ i : Arm, (i=0 ∨ i=1) ∧ BayesOptimal.Policy.counts π p u T i ≤ q := by
    have hcases : BayesOptimal.Policy.selected π p u T = 0 ∨
        BayesOptimal.Policy.selected π p u T = 1 := by
      generalize _he : BayesOptimal.Policy.selected π p u T = a at ha
      fin_cases a
      · exact Or.inl rfl
      · exact Or.inr rfl
      · exact False.elim (ha rfl)
    rcases hcases with h | h
    · refine ⟨1, Or.inr rfl, ?_⟩
      rw [hu, h]
      simpa [BayesOptimal.Foundations.BayesianModel.advance] using hc.2.1
    · refine ⟨0, Or.inl rfl, ?_⟩
      rw [hu, h]
      simpa [BayesOptimal.Foundations.BayesianModel.advance] using hc.1
  obtain ⟨i, hi, hcap⟩ := hanchor
  have hlow : |p i (BayesOptimal.Policy.counts π p u T i)| ≤
      6 * Real.sqrt (Real.log (T : ℝ)) := by
    rcases hi with h | h
    · subst i
      simpa [paperPath] using BayesOptimal.ExclusionTail.mean_bound6_newZ T q 1
        (BayesOptimal.Policy.counts π p u T 0) (paperPath p) (by omega)
        (BayesOptimal.Policy.counts_positive π p u T 0) hcap hp.2.1 hp.2.2.2.1
    · subst i
      simpa [paperPath] using BayesOptimal.ExclusionTail.mean_bound6_newZ T q 2
        (BayesOptimal.Policy.counts π p u T 1) (paperPath p) (by omega)
        (BayesOptimal.Policy.counts_positive π p u T 1) hcap hp.2.2.1 hp.2.2.2.2
  have hx : p 2 1 ≤ -CU * Real.sqrt (Real.log (T : ℝ)) := by
    simpa [BayesOptimal.Foundations.Drift.eventX, paperPath] using hp.1
  have hsqrt : 1 ≤ Real.sqrt (Real.log (T : ℝ)) :=
    Real.one_le_sqrt.mpr (BayesOptimal.Foundations.Drift.log_horizon_ge_one T (by omega))
  have hsep : p 2 1 < p i (BayesOptimal.Policy.counts π p u T i) := by
    have h := (abs_le.mp hlow).1
    nlinarith only [h, hx, hsqrt, hCU]
  intro hr
  have hg := BayesOptimal.Policy.recommendation_greedy π T hπ p u i
  change p i (BayesOptimal.Policy.counts π p u T i) ≤
    p (BayesOptimal.Policy.recommendation π T p u)
      (BayesOptimal.Policy.counts π p u T (BayesOptimal.Policy.recommendation π T p u)) at hg
  rw [hr, hthird] at hg
  exact not_le_of_gt hsep hg

end
end BayesOptimal.PathInduction

