Junpei.InitialOptimal.InitialRiskOptimal (π : Junpei.Policy.StatePolicy) (T : ℕ) : Prop
Junpei.InitialOptimal.initialRiskOptimal_repair_ae (π : Junpei.Policy.StatePolicy) (T : ℕ) (hT : 3 ≤ T)
  (hπ : Junpei.InitialOptimal.InitialRiskOptimal π T) (m : Draft0.BayesianModel.Means) :
  ∀ᵐ (p :
    Junpei.Policy.SeedArray (T - 3 + 1) ×
      Junpei.FiniteGaussian.Means Draft0.BayesianModel.Arm ×
        Junpei.EmbeddingRaw.RawStream Draft0.BayesianModel.Arm
          (T -
            3)) ∂(Junpei.Policy.seedLaw (T - 3 + 1)).prod
      (Junpei.EmbeddingExecution.worldLaw (T - 3) (Junpei.CountModelBridge.natPrecisions fun x => 1) m),
    Junpei.EmbeddingRaw.run (Junpei.PolicyContinuation.rawTree π 4 (T - 3) (fun x => 1) m p.1)
        (Junpei.EmbeddingExecution.observations p.2) =
      Junpei.EmbeddingRaw.run
        (Junpei.PolicyContinuation.rawTree (Junpei.Policy.repair π T) 4 (T - 3) (fun x => 1) m p.1)
        (Junpei.EmbeddingExecution.observations p.2)
Junpei.InitialOptimal.minimizing_trace_repair_ae (π : Junpei.Policy.StatePolicy) (T t H : ℕ)
  (c : Draft0.BayesianModel.Counts) (m : Draft0.BayesianModel.Means) (horizon : t + H = T + 1) (ht : 4 ≤ t)
  (hc : ∀ (a : Draft0.BayesianModel.Arm), 0 < c a) (hπ : Junpei.SequentialRisk.MinimizesActualRisk π t H c m) :
  ∀ᵐ (p :
    Junpei.Policy.SeedArray (H + 1) ×
      Junpei.FiniteGaussian.Means Draft0.BayesianModel.Arm ×
        Junpei.EmbeddingRaw.RawStream Draft0.BayesianModel.Arm
          H) ∂(Junpei.Policy.seedLaw (H + 1)).prod
      (Junpei.EmbeddingExecution.worldLaw H (Junpei.CountModelBridge.natPrecisions c) m),
    Junpei.EmbeddingRaw.trace (Junpei.PolicyContinuation.rawTree π t H c m p.1)
        (Junpei.EmbeddingExecution.observations p.2) =
      Junpei.EmbeddingRaw.trace (Junpei.PolicyContinuation.rawTree (Junpei.Policy.repair π T) t H c m p.1)
        (Junpei.EmbeddingExecution.observations p.2)
Junpei.HistoryPolicy.minimizing_actualRisk_le_history (π : Junpei.Policy.StatePolicy) (t H : ℕ)
  (c : Draft0.BayesianModel.Counts) (m : Draft0.BayesianModel.Means)
  (hπ : Junpei.SequentialRisk.MinimizesActualRisk π t H c m) (ρ : Junpei.HistoryPolicy.Policy Draft0.BayesianModel.Arm)
  (n : ℕ) (h : Junpei.HistoryPolicy.History Draft0.BayesianModel.Arm n) :
  Junpei.SequentialRisk.continuationRisk π t H c m ≤
    Junpei.HistoryPolicy.actualRisk ρ n H h (Junpei.CountModelBridge.natPrecisions c) m
'Junpei.InitialOptimal.initialRiskOptimal_repair_ae' depends on axioms: [propext, Classical.choice, Quot.sound]
'Junpei.InitialOptimal.minimizing_trace_repair_ae' depends on axioms: [propext, Classical.choice, Quot.sound]
'Junpei.HistoryPolicy.toRaw_family_feasible' depends on axioms: [propext, Classical.choice, Quot.sound]
'Junpei.HistoryPolicy.randomized_history_risk_ge_loss' depends on axioms: [propext, Classical.choice, Quot.sound]
'Junpei.HistoryPolicy.minimizing_actualRisk_le_history' depends on axioms: [propext, Classical.choice, Quot.sound]
