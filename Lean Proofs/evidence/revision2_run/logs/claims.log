Junpei.GeneralOptimality.theorem1.{u_1} {A : Type u_1} [Fintype A] [Nonempty A] [DecidableEq A] [MeasurableSpace A]
  [MeasurableSingletonClass A] [LinearOrder A] (π : Junpei.RealPrecisionPolicy.Policy A) (N : ℕ)
  (hπ : Junpei.GeneralOptimality.SequentiallyOptimalUpTo π N) :
  (∀ H ≤ N,
      ∀ (c : Junpei.FiniteGaussian.Precisions A) (m : Junpei.FiniteGaussian.Means A),
        (∀ (a : A), 0 < c a) → Junpei.RealPrecisionPolicy.actualRisk π H c m = Junpei.FinitePosterior.loss H c m) ∧
    (∀ H < N,
        ∀ (c : Junpei.FiniteGaussian.Precisions A) (m : Junpei.FiniteGaussian.Means A),
          (∀ (a : A), 0 < c a) →
            ∀ᵐ (u : ℝ) ∂ProbabilityTheory.gaussianReal 0 1,
              ∀ (a : A), Junpei.BayesOptimal.EBI H c m a ≤ Junpei.BayesOptimal.EBI H c m (π.draw H c m u)) ∧
      ∀ (c : Junpei.FiniteGaussian.Precisions A) (m : Junpei.FiniteGaussian.Means A),
        (∀ (a : A), 0 < c a) →
          ∀ᵐ (u : ℝ) ∂ProbabilityTheory.gaussianReal 0 1, m (π.recommend c m u) = Junpei.FiniteGaussian.maxAll m
Junpei.GeneralOptimality.exists_sequentiallyOptimalUpTo.{u_1} {A : Type u_1} [Fintype A] [Nonempty A] [DecidableEq A]
  [MeasurableSpace A] [MeasurableSingletonClass A] [LinearOrder A] (N : ℕ) :
  ∃ π, Junpei.GeneralOptimality.SequentiallyOptimalUpTo π N
Junpei.GeneralOptimality.ProperDomain.theorem1.{u_1} {A : Type u_1} [Fintype A] [Nonempty A] [DecidableEq A]
  [MeasurableSpace A] [MeasurableSingletonClass A] [LinearOrder A] (π : Junpei.GeneralOptimality.ProperDomain.Policy A)
  (N : ℕ) (hπ : Junpei.GeneralOptimality.ProperDomain.SequentiallyOptimalUpTo π N) :
  (∀ H ≤ N,
      ∀ (s : Junpei.GeneralOptimality.ProperDomain.State A),
        Junpei.GeneralOptimality.ProperDomain.actualRisk π H s = Junpei.FinitePosterior.loss H (↑s).1 (↑s).2) ∧
    (∀ H < N,
        ∀ (s : Junpei.GeneralOptimality.ProperDomain.State A),
          ∀ᵐ (u : ℝ) ∂ProbabilityTheory.gaussianReal 0 1,
            ∀ (a : A),
              Junpei.BayesOptimal.EBI H (↑s).1 (↑s).2 a ≤ Junpei.BayesOptimal.EBI H (↑s).1 (↑s).2 (π.draw H s u)) ∧
      ∀ (s : Junpei.GeneralOptimality.ProperDomain.State A),
        ∀ᵐ (u : ℝ) ∂ProbabilityTheory.gaussianReal 0 1, (↑s).2 (π.recommend s u) = Junpei.FiniteGaussian.maxAll (↑s).2
Junpei.GeneralOptimality.FiniteHorizon.SequentiallyOptimal.{u_1} {A : Type u_1} [Fintype A] [Nonempty A] [DecidableEq A]
  [MeasurableSpace A] {N : ℕ} (π : Junpei.GeneralOptimality.FiniteHorizon.Policy A N) : Prop
Junpei.GeneralOptimality.FiniteHorizon.theorem1.{u_1} {A : Type u_1} [Fintype A] [Nonempty A] [DecidableEq A]
  [MeasurableSpace A] [MeasurableSingletonClass A] {N : ℕ} [LinearOrder A]
  (π : Junpei.GeneralOptimality.FiniteHorizon.Policy A N)
  (hπ : Junpei.GeneralOptimality.FiniteHorizon.SequentiallyOptimal π) :
  (∀ (H : ℕ) (hH : H ≤ N) (s : Junpei.GeneralOptimality.ProperDomain.State A),
      Junpei.GeneralOptimality.FiniteHorizon.actualRisk π H hH s = Junpei.FinitePosterior.loss H (↑s).1 (↑s).2) ∧
    (∀ (j : Fin N) (s : Junpei.GeneralOptimality.ProperDomain.State A),
        ∀ᵐ (u : ℝ) ∂ProbabilityTheory.gaussianReal 0 1,
          ∀ (a : A),
            Junpei.BayesOptimal.EBI (↑j) (↑s).1 (↑s).2 a ≤ Junpei.BayesOptimal.EBI (↑j) (↑s).1 (↑s).2 (π.draw j s u)) ∧
      ∀ (s : Junpei.GeneralOptimality.ProperDomain.State A),
        ∀ᵐ (u : ℝ) ∂ProbabilityTheory.gaussianReal 0 1, (↑s).2 (π.recommend s u) = Junpei.FiniteGaussian.maxAll (↑s).2
Junpei.GeneralOptimality.FiniteHorizon.exists_sequentiallyOptimal.{u_1} {A : Type u_1} [Fintype A] [Nonempty A]
  [DecidableEq A] [MeasurableSpace A] [MeasurableSingletonClass A] [LinearOrder A] (N : ℕ) :
  ∃ π, Junpei.GeneralOptimality.FiniteHorizon.SequentiallyOptimal π
Junpei.BayesOptimal.optimal_action_iff_EBI_max.{u_1} {A : Type u_1} [Fintype A] [Nonempty A] [DecidableEq A] (k : ℕ)
  (c : Junpei.FiniteGaussian.Precisions A) (m : Junpei.FiniteGaussian.Means A) (i : A) (hc : ∀ (j : A), 0 < c j) :
  Junpei.FiniteGaussian.action k c m i = Junpei.FiniteGaussian.value (k + 1) c m ↔
    ∀ (j : A), Junpei.BayesOptimal.EBI k c m j ≤ Junpei.BayesOptimal.EBI k c m i
Junpei.BayesOptimal.terminal_recommendation_iff.{u_1} {A : Type u_1} [Fintype A] [Nonempty A]
  (c : Junpei.FiniteGaussian.Precisions A) (m : Junpei.FiniteGaussian.Means A) (i : A) :
  (∀ (j : A), Junpei.FinitePosterior.terminalRegret c m i ≤ Junpei.FinitePosterior.terminalRegret c m j) ↔
    m i = Junpei.FiniteGaussian.maxAll m
Junpei.BayesOptimal.optimal_posterior_loss.{u_1} {A : Type u_1} [Fintype A] [Nonempty A] [DecidableEq A] (k : ℕ)
  (c : Junpei.FiniteGaussian.Precisions A) (m : Junpei.FiniteGaussian.Means A) (hc : ∀ (i : A), 0 < c i) :
  Junpei.FinitePosterior.expectedRegret (Junpei.FiniteGaussian.optimal k c m) c m = Junpei.FinitePosterior.loss k c m
Junpei.Main.theorem2 (Δ : ℝ) (hΔ : 0 < Δ) :
  ∃ c C T0,
    0 < c ∧
      0 < C ∧
        ∀ (T : ℕ),
          T0 ≤ T →
            Odd T →
              ∀ (π : Junpei.Policy.StatePolicy),
                Junpei.Policy.AEOptimal π T → c * Draft0.Rates.invPower C T ≤ Junpei.Main.regret π T Δ
Junpei.Main.theorem2_paper_exponent (Δ : ℝ) (hΔ : 0 < Δ) :
  ∃ c T0,
    0 < c ∧
      ∀ (T : ℕ),
        T0 ≤ T →
          Odd T →
            ∀ (π : Junpei.Policy.StatePolicy),
              Junpei.Policy.AEOptimal π T → c * ↑T ^ (-((33 + Δ) ^ 2 / 2 + 4)) ≤ Junpei.Main.regret π T Δ
Junpei.Main.theorem2_real_exponent (Δ : ℝ) (hΔ : 0 < Δ) :
  ∃ c C T0,
    0 < c ∧
      0 < C ∧
        ∀ (T : ℕ),
          T0 ≤ T →
            Odd T →
              ∀ (π : Junpei.Policy.StatePolicy), Junpei.Policy.AEOptimal π T → c * ↑T ^ (-C) ≤ Junpei.Main.regret π T Δ
Junpei.Main.theorem2_exponential_rate (Δ : ℝ) (hΔ : 0 < Δ) (family : ℕ → Junpei.Policy.StatePolicy)
  (hfamily : ∀ (T : ℕ), 3 ≤ T → Junpei.Policy.AEOptimal (family T) T) :
  Filter.liminf (Junpei.RegretExponent.rate fun T => Junpei.Main.regret (family T) T Δ) Filter.atTop = 0
Junpei.RegretRatio.remark2 (Δ : ℝ) (hΔ : 0 < Δ) (family : ℕ → Junpei.Policy.StatePolicy)
  (hfamily : ∀ (T : ℕ), 3 ≤ T → Junpei.Policy.AEOptimal (family T) T) (rFreq : ℕ → ℝ) (hF : ∀ (T : ℕ), 0 ≤ rFreq T)
  (hpositive : 0 < Filter.liminf (Junpei.RegretExponent.rate rFreq) Filter.atTop) :
  Filter.limsup (Junpei.RegretRatio.ratio (fun T => Junpei.Main.regret (family T) T Δ) rFreq) Filter.atTop = ⊤
Junpei.Probability.lemma3_eventually (Δ CU : ℝ) (hΔ : 0 < Δ) (hCU : 0 < CU) :
  ∀ᶠ (T : ℕ) in Filter.atTop,
    Junpei.Probability.f1 T Δ CU ≤
      (ProbabilityTheory.gaussianReal Δ 1).real (Junpei.Probability.underestimationSet T CU)
Junpei.Probability.lemma4 (T q : ℕ) (hT : T = 2 * q + 1) (hq : 0 < q) :
  Draft0.SmallBall.f2 ↑T ≤ (Draft0.BadEvent.arrayLaw q).real (Draft0.BadEvent.goodMeanSet T q)
Junpei.Probability.lemma5 (T q : ℕ) (hT : 5 ≤ T) (hqT : q ≤ T) :
  (Draft0.BadEvent.arrayLaw q).real (Draft0.BadEvent.goodMeanSet T q ∩ (Junpei.Probability.goodDriftSet3 T q)ᶜ) ≤
    2 * ↑T ^ (-(7 / 2))
Junpei.PolicyChoice.lemma6_absolute_upper (T q t : ℕ) (CU : ℝ) (p : Draft0.Counts.MeanPath) (c : Draft0.Counts.Counts)
  (hT : 5 ≤ T) (hCU : 0 < CU) (hcut : 180 < (CU - 6) ^ 2 / 4) (hc : Draft0.Counts.horizonConsistent t c)
  (hW : JunpeiComparison.newW T q CU p c) :
  |Junpei.ExclusionPerm.EBI (T - t) (Draft0.DynamicPolicy.modelCounts c) (Draft0.DynamicPolicy.modelMeans p c) 2| ≤
    Junpei.ExclusionTail.paperG0 T CU
Junpei.PolicyChoice.lemmas7_8_uniform (CU : ℝ) (hCU : 0 < CU) (hcut : 180 < (CU - 6) ^ 2 / 4) :
  ∃ T0,
    ∀ (T : ℕ),
      T0 ≤ T →
        (∀ (q t : ℕ) (p : Draft0.Counts.MeanPath) (c : Draft0.Counts.Counts),
            T = 2 * q + 1 →
              4 ≤ t →
                t < T →
                  Draft0.Counts.horizonConsistent t c →
                    JunpeiComparison.newW T q CU p c →
                      (Junpei.PolicyChoice.gainC / 2 * Draft0.Rates.invPower 178 T ≤
                            Junpei.ExclusionPerm.EBI (T - t) (Draft0.DynamicPolicy.modelCounts c)
                              (Draft0.DynamicPolicy.modelMeans p c) 0 ∧
                          Junpei.PolicyChoice.gainC / 2 * Draft0.Rates.invPower 178 T ≤
                            Junpei.ExclusionPerm.EBI (T - t) (Draft0.DynamicPolicy.modelCounts c)
                              (Draft0.DynamicPolicy.modelMeans p c) 1) ∧
                        (c.n1 = q →
                            Junpei.PolicyChoice.comparisonC / 2 * Draft0.Rates.invPower 178 T ≤
                              Draft0.BayesianModel.action (T - t) (Draft0.DynamicPolicy.modelCounts c)
                                  (Draft0.DynamicPolicy.modelMeans p c) 1 -
                                Draft0.BayesianModel.action (T - t) (Draft0.DynamicPolicy.modelCounts c)
                                  (Draft0.DynamicPolicy.modelMeans p c) 0) ∧
                          (c.n2 = q →
                            Junpei.PolicyChoice.comparisonC / 2 * Draft0.Rates.invPower 178 T ≤
                              Draft0.BayesianModel.action (T - t) (Draft0.DynamicPolicy.modelCounts c)
                                  (Draft0.DynamicPolicy.modelMeans p c) 0 -
                                Draft0.BayesianModel.action (T - t) (Draft0.DynamicPolicy.modelCounts c)
                                  (Draft0.DynamicPolicy.modelMeans p c) 1)) ∧
          ∀ (q : ℕ) (p : Draft0.Counts.MeanPath) (c : Draft0.Counts.Counts),
            T = 2 * q + 1 →
              Draft0.Counts.horizonConsistent T c →
                JunpeiComparison.newW T q CU p c →
                  Junpei.Marginal.terminalConstant / 2 * Draft0.Rates.invPower 22 T ≤
                      Junpei.ExclusionPerm.EBI 0 (Draft0.DynamicPolicy.modelCounts c)
                        (Draft0.DynamicPolicy.modelMeans p c) 0 ∧
                    Junpei.Marginal.terminalConstant / 2 * Draft0.Rates.invPower 22 T ≤
                      Junpei.ExclusionPerm.EBI 0 (Draft0.DynamicPolicy.modelCounts c)
                        (Draft0.DynamicPolicy.modelMeans p c) 1
Junpei.TailRatio.mills_lower (x : ℝ) (hx : 0 < x) :
