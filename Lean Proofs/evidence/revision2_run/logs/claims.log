  [MeasurableSpace A] [MeasurableSingletonClass A] [LinearOrder A] (π : Junpei.RealPrecisionPolicy.Policy A) (H : ℕ)
  (c : Junpei.FiniteGaussian.Precisions A) (m : Junpei.FiniteGaussian.Means A) (hc : ∀ (a : A), 0 < c a)
  (hπ : Junpei.GeneralOptimality.MinimizesHistoryRisk π (H + 1) c m) :
  ∀ᵐ (u : ℝ) ∂ProbabilityTheory.gaussianReal 0 1,
