Junpei.GeneralOptimality.minimizing_recommend_ae.{u_1} {A : Type u_1} [Fintype A] [Nonempty A] [DecidableEq A]
  [MeasurableSpace A] [MeasurableSingletonClass A] [LinearOrder A] (π : Junpei.RealPrecisionPolicy.Policy A)
  (c : Junpei.FiniteGaussian.Precisions A) (m : Junpei.FiniteGaussian.Means A) (hc : ∀ (a : A), 0 < c a)
  (hπ : Junpei.GeneralOptimality.MinimizesHistoryRisk π 0 c m) :
