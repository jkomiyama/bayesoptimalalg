Junpei.FixedGaussian.finite_pi_absolutelyContinuous.{u_1, u_2} {I : Type u_1} {B : Type u_2} [Fintype I]
  [MeasurableSpace B] (μ ν : I → MeasureTheory.Measure B) [∀ (i : I), MeasureTheory.SigmaFinite (μ i)]
  [∀ (i : I), MeasureTheory.SigmaFinite (ν i)] (h : ∀ (i : I), (μ i).AbsolutelyContinuous (ν i)) :
  (MeasureTheory.Measure.pi μ).AbsolutelyContinuous (MeasureTheory.Measure.pi ν)
Junpei.FixedGaussian.fixed_predictive_equivalent.{u_1} {A : Type u_1} [Fintype A] [Nonempty A] [DecidableEq A] (H : ℕ)
  (c : Junpei.FiniteGaussian.Precisions A) (m μ : Junpei.FiniteGaussian.Means A) :
  (Junpei.FixedGaussian.fixedLaw H μ).AbsolutelyContinuous (Junpei.FixedGaussian.predictiveLaw H c m) ∧
    (Junpei.FixedGaussian.predictiveLaw H c m).AbsolutelyContinuous (Junpei.FixedGaussian.fixedLaw H μ)
Junpei.FixedGaussian.seeded_fixed_predictive_equivalent.{u_1, u_2} {A : Type u_1} [Fintype A] [Nonempty A]
  [DecidableEq A] {S : Type u_2} [MeasurableSpace S] (σ : MeasureTheory.Measure S) (H : ℕ)
  (c : Junpei.FiniteGaussian.Precisions A) (m μ : Junpei.FiniteGaussian.Means A) :
  (σ.prod (Junpei.FixedGaussian.fixedLaw H μ)).AbsolutelyContinuous
      (σ.prod (Junpei.FixedGaussian.predictiveLaw H c m)) ∧
    (σ.prod (Junpei.FixedGaussian.predictiveLaw H c m)).AbsolutelyContinuous
      (σ.prod (Junpei.FixedGaussian.fixedLaw H μ))
Junpei.FixedGaussian.adaptive_map_equivalent.{u_1, u_2, u_3} {A : Type u_1} [Fintype A] [Nonempty A] [DecidableEq A]
  {S : Type u_2} {B : Type u_3} [MeasurableSpace S] [MeasurableSpace B] (σ : MeasureTheory.Measure S) (H : ℕ)
  (c : Junpei.FiniteGaussian.Precisions A) (m μ : Junpei.FiniteGaussian.Means A)
  (f : S × Junpei.EmbeddingRaw.RawStream A H → B) (hf : Measurable f) :
  (MeasureTheory.Measure.map f (σ.prod (Junpei.FixedGaussian.fixedLaw H μ))).AbsolutelyContinuous
      (MeasureTheory.Measure.map f (σ.prod (Junpei.FixedGaussian.predictiveLaw H c m))) ∧
    (MeasureTheory.Measure.map f (σ.prod (Junpei.FixedGaussian.predictiveLaw H c m))).AbsolutelyContinuous
      (MeasureTheory.Measure.map f (σ.prod (Junpei.FixedGaussian.fixedLaw H μ)))
Junpei.FixedGaussian.ae_execution_transfer.{u_1, u_2} {A : Type u_1} [Fintype A] [Nonempty A] [DecidableEq A]
  {S : Type u_2} [MeasurableSpace S] (σ : MeasureTheory.Measure S) [MeasureTheory.SFinite σ] (H : ℕ)
  (c : Junpei.FiniteGaussian.Precisions A) (m μ : Junpei.FiniteGaussian.Means A)
  (P : S × Junpei.EmbeddingRaw.RawStream A H → Prop) (hP : MeasurableSet {p | P p})
  (h :
    ∀ᵐ (p :
      S ×
        Junpei.FiniteGaussian.Means A ×
          Junpei.EmbeddingRaw.RawStream A H) ∂σ.prod (Junpei.EmbeddingExecution.worldLaw H c m),
      P (p.1, Junpei.EmbeddingExecution.observations p.2)) :
  ∀ᵐ (p : S × Junpei.EmbeddingRaw.RawStream A H) ∂σ.prod (Junpei.FixedGaussian.fixedLaw H μ), P p
Junpei.FixedGaussian.recommendation_law_eq.{u_1, u_2, u_3} {A : Type u_1} [Fintype A] [Nonempty A] [DecidableEq A]
  {S : Type u_2} {B : Type u_3} [MeasurableSpace S] [MeasurableSpace B] [Countable B] [MeasurableSingletonClass B]
  (σ : MeasureTheory.Measure S) [MeasureTheory.SFinite σ] (H : ℕ) (c : Junpei.FiniteGaussian.Precisions A)
  (m μ : Junpei.FiniteGaussian.Means A) (f g : S × Junpei.EmbeddingRaw.RawStream A H → B) (hf : Measurable f)
  (hg : Measurable g)
  (h :
    ∀ᵐ (p :
      S ×
        Junpei.FiniteGaussian.Means A ×
          Junpei.EmbeddingRaw.RawStream A H) ∂σ.prod (Junpei.EmbeddingExecution.worldLaw H c m),
      f (p.1, Junpei.EmbeddingExecution.observations p.2) = g (p.1, Junpei.EmbeddingExecution.observations p.2)) :
  MeasureTheory.Measure.map f (σ.prod (Junpei.FixedGaussian.fixedLaw H μ)) =
    MeasureTheory.Measure.map g (σ.prod (Junpei.FixedGaussian.fixedLaw H μ))
Junpei.FixedGaussian.minimizing_rawTree_repair_fixed_ae (π : Junpei.Policy.StatePolicy) (T t H : ℕ)
  (c : Draft0.BayesianModel.Counts) (m μ : Draft0.BayesianModel.Means) (horizon : t + H = T + 1) (ht : 4 ≤ t)
  (hc : ∀ (a : Draft0.BayesianModel.Arm), 0 < c a) (hπ : Junpei.SequentialRisk.MinimizesActualRisk π t H c m) :
  ∀ᵐ (p :
    Junpei.Policy.SeedArray (H + 1) ×
      Junpei.EmbeddingRaw.RawStream Draft0.BayesianModel.Arm
        H) ∂(Junpei.Policy.seedLaw (H + 1)).prod (Junpei.FixedGaussian.fixedLaw H μ),
    Junpei.EmbeddingRaw.run (Junpei.PolicyContinuation.rawTree π t H c m p.1) p.2 =
      Junpei.EmbeddingRaw.run (Junpei.PolicyContinuation.rawTree (Junpei.Policy.repair π T) t H c m p.1) p.2
Junpei.FixedGaussian.initialRiskOptimal_repair_fixed_ae (π : Junpei.Policy.StatePolicy) (T : ℕ) (hT : 3 ≤ T)
  (hπ : Junpei.InitialOptimal.InitialRiskOptimal π T) (m μ : Draft0.BayesianModel.Means) :
