    ∫ (p : Junpei.Policy.SeedArray (T - 3 + 1) × Junpei.EmbeddingRaw.RawStream Draft0.BayesianModel.Arm (T - 3)),
      L
        (Junpei.EmbeddingRaw.run
          (Junpei.PolicyContinuation.rawTree (Junpei.Policy.repair π T) 4 (T - 3) (fun x => 1) m p.1)
          p.2) ∂(Junpei.Policy.seedLaw (T - 3 + 1)).prod (Junpei.FixedGaussian.fixedLaw (T - 3) μ)
