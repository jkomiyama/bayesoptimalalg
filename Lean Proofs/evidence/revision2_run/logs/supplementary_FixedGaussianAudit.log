Junpei.FixedGaussian.selected_stack_split_preserving.{u_1} {A : Type u_1} [Fintype A] [Nonempty A] [DecidableEq A]
  (H : ℕ) (μ : Junpei.FiniteGaussian.Means A) (a : A) :
  MeasureTheory.MeasurePreserving (fun r => (r a ⟨0, ⋯⟩, Junpei.FixedGaussian.stackTail a r))
    (Junpei.FixedGaussian.fixedLaw (H + 1) μ)
    ((ProbabilityTheory.gaussianReal (μ a) 1).prod (Junpei.FixedGaussian.fixedLaw H μ))
Junpei.FixedGaussian.rawTree_stack_law_eq (π : Junpei.Policy.StatePolicy) (t H : ℕ) (c : Draft0.BayesianModel.Counts)
  (m μ : Draft0.BayesianModel.Means) (u : Junpei.PolicyContinuation.Seeds H) :
  MeasureTheory.Measure.map (Junpei.FixedGaussian.stackRun (Junpei.PolicyContinuation.rawTree π t H c m u))
      (Junpei.FixedGaussian.fixedLaw H μ) =
    MeasureTheory.Measure.map (Junpei.EmbeddingRaw.run (Junpei.PolicyContinuation.rawTree π t H c m u))
      (Junpei.FixedGaussian.fixedLaw H μ)
Junpei.FixedGaussian.initializedInput_preserving (T : ℕ) (Δ : ℝ) (hT : 3 ≤ T) :
  MeasureTheory.MeasurePreserving (Junpei.FixedGaussian.StackPath.initializedInput T Δ hT) (Junpei.Main.jointLaw T)
    (Junpei.FixedGaussian.initializedLaw (T - 3) (Junpei.Empirical.trueMean Δ))
Junpei.FixedGaussian.actualRecommendation_law (π : Junpei.Policy.StatePolicy) (T : ℕ) (Δ : ℝ) (hT : 3 ≤ T) :
  MeasureTheory.Measure.map (Junpei.Main.actualRecommendation π T Δ) (Junpei.Main.jointLaw T) =
    MeasureTheory.Measure.map (Junpei.FixedGaussian.initializedStackRun π (T - 3))
      (Junpei.FixedGaussian.initializedLaw (T - 3) (Junpei.Empirical.trueMean Δ))
Junpei.FixedGaussian.initialRiskOptimal_regret_repair_eq (π : Junpei.Policy.StatePolicy) (T : ℕ) (Δ : ℝ) (hT : 3 ≤ T)
  (hπ : Junpei.InitialOptimal.InitialRiskOptimal π T) :
  Junpei.Main.regret π T Δ = Junpei.Main.regret (Junpei.Policy.repair π T) T Δ
Junpei.FixedGaussian.theorem2_initialRiskOptimal (Δ : ℝ) (hΔ : 0 < Δ) :
  ∃ c C T0,
    0 < c ∧
      0 < C ∧
        ∀ (T : ℕ),
          T0 ≤ T →
            Odd T →
              ∀ (π : Junpei.Policy.StatePolicy),
                Junpei.InitialOptimal.InitialRiskOptimal π T → c * Draft0.Rates.invPower C T ≤ Junpei.Main.regret π T Δ
Junpei.FixedGaussian.theorem2_paper_exponent_initialRiskOptimal (Δ : ℝ) (hΔ : 0 < Δ) :
  ∃ c T0,
    0 < c ∧
      ∀ (T : ℕ),
        T0 ≤ T →
          Odd T →
            ∀ (π : Junpei.Policy.StatePolicy),
              Junpei.InitialOptimal.InitialRiskOptimal π T →
                c * ↑T ^ (-((33 + Δ) ^ 2 / 2 + 4)) ≤ Junpei.Main.regret π T Δ
Junpei.FixedGaussian.theorem2_exponential_rate_initialRiskOptimal (Δ : ℝ) (hΔ : 0 < Δ)
  (family : ℕ → Junpei.Policy.StatePolicy)
  (hfamily : ∀ (T : ℕ), 3 ≤ T → Junpei.InitialOptimal.InitialRiskOptimal (family T) T) :
  Filter.liminf (Junpei.RegretExponent.rate fun T => Junpei.Main.regret (family T) T Δ) Filter.atTop = 0
Junpei.FixedGaussian.remark2_initialRiskOptimal (Δ : ℝ) (hΔ : 0 < Δ) (family : ℕ → Junpei.Policy.StatePolicy)
  (hfamily : ∀ (T : ℕ), 3 ≤ T → Junpei.InitialOptimal.InitialRiskOptimal (family T) T) (rFreq : ℕ → ℝ)
  (hF : ∀ (T : ℕ), 0 ≤ rFreq T) (hpositive : 0 < Filter.liminf (Junpei.RegretExponent.rate rFreq) Filter.atTop) :
  Filter.limsup (Junpei.RegretRatio.ratio (fun T => Junpei.Main.regret (family T) T Δ) rFreq) Filter.atTop = ⊤
