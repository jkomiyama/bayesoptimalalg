  (f : Junpei.FiniteGaussian.Means A × ℝ → ℝ) (hf : Measurable f) :
  ∫ (x : Junpei.FiniteGaussian.Means A × ℝ),
      f
        (Junpei.ObservationBridge.rawObservation i
          x) ∂(Junpei.FinitePosterior.posteriorLaw c m).prod (ProbabilityTheory.gaussianReal 0 1) =
    ∫ (x : ℝ × Junpei.FiniteGaussian.Means A),
      f
        (Junpei.ObservationBridge.reconstructedObservation c m i
          x) ∂(ProbabilityTheory.gaussianReal 0 (Junpei.FiniteGaussian.innovation c i)).prod
        (Junpei.FinitePosterior.centeredLaw (Junpei.FiniteGaussian.advance c i))
