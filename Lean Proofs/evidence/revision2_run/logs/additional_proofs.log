  (c : Junpei.FiniteGaussian.Precisions A) (m : Junpei.FiniteGaussian.Means A) (i : A) (hc : 0 < c i) :
  MeasureTheory.Measure.map (Junpei.ObservationBridge.rawObservation i)
      ((Junpei.FinitePosterior.posteriorLaw c m).prod (ProbabilityTheory.gaussianReal 0 1)) =
    MeasureTheory.Measure.map (Junpei.ObservationBridge.reconstructedObservation c m i)
      ((ProbabilityTheory.gaussianReal 0 (Junpei.FiniteGaussian.innovation c i)).prod
        (Junpei.FinitePosterior.centeredLaw (Junpei.FiniteGaussian.advance c i)))
