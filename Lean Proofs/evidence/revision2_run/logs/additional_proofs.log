Junpei.ObservationBridge.update_joint_law (c : NNReal) (hc : 0 < c) :
  MeasureTheory.Measure.map (⇑(Junpei.ObservationBridge.updateLinear c))
      ((ProbabilityTheory.gaussianReal 0 c⁻¹).prod (ProbabilityTheory.gaussianReal 0 1)) =
    (ProbabilityTheory.gaussianReal 0 (Draft0.Gaussian.updateVariance c)).prod
      (ProbabilityTheory.gaussianReal 0 (c + 1)⁻¹)
