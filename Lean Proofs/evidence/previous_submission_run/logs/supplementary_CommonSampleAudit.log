Junpei.CommonSample.risk_depends_only_terminal_counts (s u : List Bool) (c : Draft0.Counts.Counts) (m1 m2 : ℝ)
  (h1 : 0 < c.n1) (h2 : 0 < c.n2) (hfinal : Junpei.CommonSample.finalCounts s c = Junpei.CommonSample.finalCounts u c) :
  Junpei.CommonSample.risk s c m1 m2 = Junpei.CommonSample.risk u c m1 m2
Junpei.CommonSample.terminalMeans_permutation (s u : List Bool) (h : s.Perm u) (c : Draft0.Counts.Counts) (m : ℝ × ℝ)
  (z : Junpei.CommonSample.Stream) :
  Junpei.CommonSample.terminalMeans s c m z = Junpei.CommonSample.terminalMeans u c m z
Junpei.CommonSample.observation_predictive_law (n : ℕ) (m : ℝ) (hn : 0 < n) :
  MeasureTheory.Measure.map (Junpei.CommonSample.observation n m)
      (ProbabilityTheory.gaussianReal 0 (Draft0.Gaussian.updateVariance ↑n)) =
    ProbabilityTheory.gaussianReal m (1 + (↑n)⁻¹)
Junpei.CommonSample.terminalRisk_is_actual_regret (c : Draft0.Counts.Counts) (m1 m2 : ℝ) :
  Junpei.CommonSample.terminalRisk c m1 m2 =
    Junpei.FinitePosterior.terminalRegret (Junpei.TwoArmOptimal.pairPrecisions c.n1 c.n2)
      (Junpei.TwoArmOptimal.pairMeans m1 m2) (if m1 ≤ m2 then 1 else 0)
Junpei.CommonSample.terminal_gap_law (N : ℕ) (s : List Bool) (c : Draft0.Counts.Counts) (m1 m2 : ℝ)
  (hN1 : (Junpei.CommonSample.finalCounts s c).n1 ≤ N) (hN2 : (Junpei.CommonSample.finalCounts s c).n2 ≤ N) :
  ProbabilityTheory.HasLaw
    (fun x =>
      (Junpei.CommonSample.terminalMeans s c (m1, m2) (Junpei.CommonSample.finiteStream N x)).1 -
        (Junpei.CommonSample.terminalMeans s c (m1, m2) (Junpei.CommonSample.finiteStream N x)).2)
    (ProbabilityTheory.gaussianReal (m1 - m2) (Junpei.CommonSample.allocationVariance s c))
    (Junpei.CommonSample.streamLaw N)
Junpei.CommonSample.stream_integral_eq_recursive_risk (N : ℕ) (s : List Bool) (c : Draft0.Counts.Counts) (m1 m2 : ℝ)
  (h1 : 0 < c.n1) (h2 : 0 < c.n2) (hN1 : (Junpei.CommonSample.finalCounts s c).n1 ≤ N)
  (hN2 : (Junpei.CommonSample.finalCounts s c).n2 ≤ N) :
  ∫ (x : Bool × Fin N → ℝ), Junpei.CommonSample.streamTerminalRisk N s c m1 m2 x ∂Junpei.CommonSample.streamLaw N =
    Junpei.CommonSample.risk s c m1 m2
Junpei.CommonSample.streamTerminalRisk_integrable (N : ℕ) (s : List Bool) (c : Draft0.Counts.Counts) (m1 m2 : ℝ)
  (hN1 : (Junpei.CommonSample.finalCounts s c).n1 ≤ N) (hN2 : (Junpei.CommonSample.finalCounts s c).n2 ≤ N) :
  MeasureTheory.Integrable (Junpei.CommonSample.streamTerminalRisk N s c m1 m2) (Junpei.CommonSample.streamLaw N)
Junpei.Coupling19.same_rule_left_common_then_last (q k : ℕ) (c : Draft0.Counts.Counts) (hq : 0 < q) (hcap1 : c.n1 ≤ q)
  (hcap2 : c.n2 ≤ q) (hs : c.n1 + c.n2 + k = 2 * q - 1) :
  (true :: Junpei.Coupling19.schedule Junpei.Coupling19.rightTie k (Draft0.TwoArmBellman.leftStep c)).Perm
    (Junpei.Coupling19.schedule Junpei.Coupling19.rightTie k c ++ [true])
Junpei.Coupling19.forced_right_is_common_then_last (q k : ℕ) (c : Draft0.Counts.Counts) (hq : 0 < q) (hcap1 : c.n1 ≤ q)
  (hcap2 : c.n2 ≤ q) (hs : c.n1 + c.n2 + k = 2 * q - 1) :
  (false :: Junpei.Coupling19.schedule Junpei.Coupling19.leftTie k (Draft0.TwoArmBellman.rightStep c)).Perm
    (Junpei.Coupling19.schedule Junpei.Coupling19.leftTie k c ++ [false])
Junpei.Coupling19.common_prefix_last_gain (s : List Bool) (i : Bool) (c : Draft0.Counts.Counts) (m1 m2 : ℝ)
  (h1 : 0 < c.n1) (h2 : 0 < c.n2) :
  Junpei.CommonSample.risk s c m1 m2 - Junpei.CommonSample.risk (s ++ [i]) c m1 m2 =
    ∫ (x : ℝ),
      Draft0.Gaussian.hingeLoss |x|
        (Draft0.Gaussian.updateVariance
          ↑(Junpei.CommonSample.sampled i
              (Junpei.CommonSample.finalCounts s
                c))) ∂ProbabilityTheory.gaussianReal (m1 - m2) (Junpei.CommonSample.allocationVariance s c)
Junpei.Coupling19.paired_forced_action_gap_identity (r : ℕ → ℕ → Bool) (k : ℕ) (c : Draft0.Counts.Counts) (m1 m2 : ℝ)
  (h1 : 0 < c.n1) (h2 : 0 < c.n2)
  (hleft :
    (true :: Junpei.Coupling19.schedule Junpei.Coupling19.leftTie k (Draft0.TwoArmBellman.leftStep c)).Perm
      (Junpei.Coupling19.schedule r k c ++ [true]))
  (hright :
    (false :: Junpei.Coupling19.schedule Junpei.Coupling19.leftTie k (Draft0.TwoArmBellman.rightStep c)).Perm
      (Junpei.Coupling19.schedule r k c ++ [false])) :
  Draft0.TwoArmBellman.rightAction k m1 m2 c - Draft0.TwoArmBellman.leftAction k m1 m2 c =
    ∫ (x : ℝ),
      Draft0.Gaussian.hingeLoss |x| (Draft0.Gaussian.updateVariance ↑(Junpei.Forecast.ruleRun r k c).n2) -
        Draft0.Gaussian.hingeLoss |x|
          (Draft0.Gaussian.updateVariance
            ↑(Junpei.Forecast.ruleRun r k
                  c).n1) ∂ProbabilityTheory.gaussianReal (m1 - m2) (Junpei.Forecast.ruleAccumulatedVariance r k c)
Junpei.Coupling19.left_common_product_gain (N q k : ℕ) (c : Draft0.Counts.Counts) (m1 m2 : ℝ) (hq : 0 < q)
  (h1 : 0 < c.n1) (h2 : 0 < c.n2) (hcap1 : c.n1 ≤ q) (hcap2 : c.n2 ≤ q) (hs : c.n1 + c.n2 + k = 2 * q - 1)
  (hN : q + 1 ≤ N) :
  ∫ (x : Bool × Fin N → ℝ),
      Junpei.CommonSample.streamTerminalRisk N (Junpei.Coupling19.schedule Junpei.Coupling19.rightTie k c) c m1 m2 x -
        Junpei.CommonSample.streamTerminalRisk N (Junpei.Coupling19.schedule Junpei.Coupling19.rightTie k c ++ [true]) c
          m1 m2 x ∂Junpei.CommonSample.streamLaw N =
    Draft0.TwoArmBellman.leftAction k m1 m2 c - Draft0.TwoArmBellman.payoff k m1 m2 c
Junpei.Coupling19.right_common_product_gain (N q k : ℕ) (c : Draft0.Counts.Counts) (m1 m2 : ℝ) (hq : 0 < q)
  (h1 : 0 < c.n1) (h2 : 0 < c.n2) (hcap1 : c.n1 ≤ q) (hcap2 : c.n2 ≤ q) (hs : c.n1 + c.n2 + k = 2 * q - 1)
  (hN : q + 1 ≤ N) :
  ∫ (x : Bool × Fin N → ℝ),
      Junpei.CommonSample.streamTerminalRisk N (Junpei.Coupling19.schedule Junpei.Coupling19.leftTie k c) c m1 m2 x -
        Junpei.CommonSample.streamTerminalRisk N (Junpei.Coupling19.schedule Junpei.Coupling19.leftTie k c ++ [false]) c
          m1 m2 x ∂Junpei.CommonSample.streamLaw N =
    Draft0.TwoArmBellman.rightAction k m1 m2 c - Draft0.TwoArmBellman.payoff k m1 m2 c
Junpei.Coupling19.lemma19_individual_gains_via_coupling (T q t : ℕ) (CU : ℝ) (p : Draft0.Counts.MeanPath)
  (c : Draft0.Counts.Counts) (hT : T = 2 * q + 1) (ht : 4 ≤ t) (hpre : t < T) (hc : Draft0.Counts.horizonConsistent t c)
  (hW : JunpeiComparison.newW T q CU p c) :
  Draft0.TerminalBounds.gainConstant * Draft0.PredictiveBound.lowerConstant * Draft0.Rates.invPower 176 T ≤
      Draft0.TwoArmBellman.leftAction (T - t) (p 1 c.n1) (p 2 c.n2) c -
        Draft0.TwoArmBellman.payoff (T - t) (p 1 c.n1) (p 2 c.n2) c ∧
    Draft0.TerminalBounds.gainConstant * Draft0.PredictiveBound.lowerConstant * Draft0.Rates.invPower 176 T ≤
      Draft0.TwoArmBellman.rightAction (T - t) (p 1 c.n1) (p 2 c.n2) c -
        Draft0.TwoArmBellman.payoff (T - t) (p 1 c.n1) (p 2 c.n2) c
Junpei.Coupling19.lemma19_saturated_left_gap_via_coupling (T q t : ℕ) (CU : ℝ) (p : Draft0.Counts.MeanPath)
  (c : Draft0.Counts.Counts) (hT : T = 2 * q + 1) (ht : 4 ≤ t) (hpre : t < T) (hc : Draft0.Counts.horizonConsistent t c)
  (hW : JunpeiComparison.newW T q CU p c) (hsat : c.n1 = q) :
  Draft0.TerminalBounds.comparisonConstant * Draft0.PredictiveBound.lowerConstant * Draft0.Rates.invPower 178 T ≤
    Draft0.TwoArmBellman.rightAction (T - t) (p 1 c.n1) (p 2 c.n2) c -
      Draft0.TwoArmBellman.leftAction (T - t) (p 1 c.n1) (p 2 c.n2) c
Junpei.Coupling19.lemma19_saturated_right_gap_via_coupling (T q t : ℕ) (CU : ℝ) (p : Draft0.Counts.MeanPath)
  (c : Draft0.Counts.Counts) (hT : T = 2 * q + 1) (ht : 4 ≤ t) (hpre : t < T) (hc : Draft0.Counts.horizonConsistent t c)
  (hW : JunpeiComparison.newW T q CU p c) (hsat : c.n2 = q) :
  Draft0.TerminalBounds.comparisonConstant * Draft0.PredictiveBound.lowerConstant * Draft0.Rates.invPower 178 T ≤
    Draft0.TwoArmBellman.leftAction (T - t) (p 1 c.n1) (p 2 c.n2) c -
      Draft0.TwoArmBellman.rightAction (T - t) (p 1 c.n1) (p 2 c.n2) c
Junpei.Coupling19.fixed_tie_same_forced_arm_assertion_false (q : ℕ) (hq : 2 ≤ q) :
  Draft0.Counts.balancedRun (2 * q - 3) (Draft0.TwoArmBellman.leftStep { n1 := 1, n2 := 1, n3 := 1 }) ≠
    Draft0.TwoArmBellman.leftStep (Draft0.Counts.balancedRun (2 * q - 3) { n1 := 1, n2 := 1, n3 := 1 })
Junpei.Coupling19.counterexample_within_lemma19_domain (q : ℕ) (hq : 2 ≤ q) (CU : ℝ) :
  Draft0.Counts.horizonConsistent 4 { n1 := 1, n2 := 1, n3 := 1 } ∧
    4 < 2 * q + 1 ∧
      2 * q + 1 - 4 = 2 * q - 3 ∧
        JunpeiComparison.newW (2 * q + 1) q CU (Junpei.Coupling19.counterexamplePath (2 * q + 1) CU)
          { n1 := 1, n2 := 1, n3 := 1 }
