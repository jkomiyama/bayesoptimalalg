Junpei.UniformSampling.observedEmpirical_eq_empirical.{u_1} {A : Type u_1} [Fintype A] [Nonempty A] [DecidableEq A]
  [MeasurableSpace A] [MeasurableSingletonClass A] (T : ℕ) (μ : Junpei.FiniteGaussian.Means A) (n : A → ℕ)
