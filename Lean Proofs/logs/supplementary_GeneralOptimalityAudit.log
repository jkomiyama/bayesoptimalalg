  (c : Junpei.FiniteGaussian.Precisions A) (m : Junpei.FiniteGaussian.Means A) :
  Junpei.HistoryPolicy.actualRisk (Junpei.GeneralOptimality.compile π H c m) 0 H Junpei.GeneralOptimality.emptyHistory c
      m =
