  (hπ : Junpei.GeneralOptimality.MinimizesHistoryRisk π (H + 1) c m) :
  ∀ᵐ (u : ℝ) ∂ProbabilityTheory.gaussianReal 0 1,
    ∀ (a : A), Junpei.BayesOptimal.EBI H c m a ≤ Junpei.BayesOptimal.EBI H c m (π.draw H c m u)
Junpei.GeneralOptimality.minimizing_recommend_ae.{u_1} {A : Type u_1} [Fintype A] [Nonempty A] [DecidableEq A]
