  (c : Junpei.FiniteGaussian.Precisions A) (m : Junpei.FiniteGaussian.Means A) (hc : ∀ (a : A), 0 < c a)
  (hπ : Junpei.GeneralOptimality.MinimizesHistoryRisk π 0 c m) :
  ∀ᵐ (u : ℝ) ∂ProbabilityTheory.gaussianReal 0 1, m (π.recommend c m u) = Junpei.FiniteGaussian.maxAll m
