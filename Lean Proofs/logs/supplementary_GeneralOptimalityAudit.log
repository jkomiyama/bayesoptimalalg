def Junpei.GeneralOptimality.MinimizesHistoryRisk.{u_1} : {A : Type u_1} →
  [Fintype A] →
    [Nonempty A] →
      [DecidableEq A] →
        [inst : MeasurableSpace A] →
          Junpei.RealPrecisionPolicy.Policy A →
            ℕ → Junpei.FiniteGaussian.Precisions A → Junpei.FiniteGaussian.Means A → Prop :=
fun {A} [Fintype A] [Nonempty A] [DecidableEq A] [MeasurableSpace A] π H c m =>
  ∀ (ρ : Junpei.HistoryPolicy.Policy A),
    Junpei.RealPrecisionPolicy.actualRisk π H c m ≤
      Junpei.HistoryPolicy.actualRisk ρ 0 H Junpei.GeneralOptimality.emptyHistory c m
def Junpei.GeneralOptimality.SequentiallyOptimalUpTo.{u_1} : {A : Type u_1} →
  [Fintype A] →
    [Nonempty A] → [DecidableEq A] → [inst : MeasurableSpace A] → Junpei.RealPrecisionPolicy.Policy A → ℕ → Prop :=
fun {A} [Fintype A] [Nonempty A] [DecidableEq A] [MeasurableSpace A] π N =>
  ∀ H ≤ N,
    ∀ (c : Junpei.FiniteGaussian.Precisions A) (m : Junpei.FiniteGaussian.Means A),
      (∀ (a : A), 0 < c a) → Junpei.GeneralOptimality.MinimizesHistoryRisk π H c m
Junpei.GeneralOptimality.toRaw_compile.{u_1} {A : Type u_1} [Fintype A] [Nonempty A] [DecidableEq A] [MeasurableSpace A]
  [MeasurableSingletonClass A] (π : Junpei.RealPrecisionPolicy.Policy A) (N n H : ℕ)
  (c0 : Junpei.FiniteGaussian.Precisions A) (m0 : Junpei.FiniteGaussian.Means A) (h : Junpei.HistoryPolicy.History A n)
  (u : Junpei.PolicyContinuation.Seeds H) (horizon : n + H = N) :
  Junpei.HistoryPolicy.toRaw (Junpei.GeneralOptimality.compile π N c0 m0) n H h u =
    Junpei.RealPrecisionPolicy.rawTree π H (Junpei.GeneralOptimality.foldState c0 m0 n h).1
      (Junpei.GeneralOptimality.foldState c0 m0 n h).2 u
Junpei.GeneralOptimality.actualRisk_compile.{u_1} {A : Type u_1} [Fintype A] [Nonempty A] [DecidableEq A]
