Junpei.ProseCorollaries.Footnote14.counterexample_to_necessary_scale :
  0 < Draft0.BadEvent.underestimationConstant ∧
    (∀ (T : ℕ),
        5 ≤ T →
          Draft0.BadEvent.underestimationConstant * Draft0.Rates.invPower 4 T ≤
            (ProbabilityTheory.gaussianReal 0 (↑T ^ 3)⁻¹).real
              (Set.Ici (Junpei.ProseCorollaries.Footnote14.logarithmicGap T))) ∧
      ¬Junpei.ProseCorollaries.Footnote14.logarithmicGap =O[Filter.atTop]
          Junpei.ProseCorollaries.Footnote14.standardDeviation
Junpei.Footnote14Scale.polynomial_tail_does_not_require_paper_scale :
  ¬∀ (gap : ℕ → ℝ),
      (∀ (T : ℕ), 0 ≤ gap T) →
        Junpei.Footnote14Scale.PolynomialTailLowerBound gap → gap =O[Filter.atTop] fun T => ↑T ^ (-3 / 2)
