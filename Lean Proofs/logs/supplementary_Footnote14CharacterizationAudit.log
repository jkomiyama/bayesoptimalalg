def Junpei.ProseCorollaries.Footnote14.standardDeviation : ℕ → ℝ :=
fun T => (√(↑T ^ 3))⁻¹
def Junpei.ProseCorollaries.Footnote14.logarithmicGap : ℕ → ℝ :=
fun T => Junpei.ProseCorollaries.Footnote14.standardDeviation T * √(Real.log ↑T)
def Junpei.Footnote14Characterization.EventuallyPolynomialTail : (ℕ → ℝ) → Prop :=
fun gap =>
  ∃ c,
    0 < c ∧
      ∃ p,
        ∀ᶠ (T : ℕ) in Filter.atTop,
          c * Draft0.Rates.invPower p T ≤ (ProbabilityTheory.gaussianReal 0 (↑T ^ 3)⁻¹).real (Set.Ici (gap T))
Junpei.Footnote14Scale.standardDeviation_eq_paper_scale (T : ℕ) :
  Junpei.ProseCorollaries.Footnote14.standardDeviation T = ↑T ^ (-3 / 2)
Junpei.Footnote14Characterization.tail_standardize (T : ℕ) (hT : 0 < T) (g : ℝ) :
  (ProbabilityTheory.gaussianReal 0 (↑T ^ 3)⁻¹).real (Set.Ici g) =
    Junpei.TailRatio.normalTail (g / Junpei.ProseCorollaries.Footnote14.standardDeviation T)
Junpei.Footnote14Characterization.eventuallyPolynomialTail_of_isBigO (gap : ℕ → ℝ)
  (hgap : gap =O[Filter.atTop] Junpei.ProseCorollaries.Footnote14.logarithmicGap) :
  Junpei.Footnote14Characterization.EventuallyPolynomialTail gap
Junpei.Footnote14Characterization.isBigO_of_eventuallyPolynomialTail (gap : ℕ → ℝ) (hgap : ∀ (T : ℕ), 0 ≤ gap T)
  (hpoly : Junpei.Footnote14Characterization.EventuallyPolynomialTail gap) :
  gap =O[Filter.atTop] Junpei.ProseCorollaries.Footnote14.logarithmicGap
Junpei.Footnote14Characterization.eventuallyPolynomialTail_iff_isBigO (gap : ℕ → ℝ) (hgap : ∀ (T : ℕ), 0 ≤ gap T) :
  Junpei.Footnote14Characterization.EventuallyPolynomialTail gap ↔
    gap =O[Filter.atTop] fun T => ↑T ^ (-3 / 2) * √(Real.log ↑T)
Junpei.Footnote14Characterization.realExponentPolynomialTail_iff_eventually (gap : ℕ → ℝ) :
  (∃ c,
      0 < c ∧
        ∃ p,
          0 < p ∧
            ∃ T0,
              ∀ (T : ℕ),
                T0 ≤ T → c * ↑T ^ (-p) ≤ (ProbabilityTheory.gaussianReal 0 (↑T ^ 3)⁻¹).real (Set.Ici (gap T))) ↔
    Junpei.Footnote14Characterization.EventuallyPolynomialTail gap
Junpei.Footnote14Characterization.corrected_footnote14_iff (d : ℕ → ℝ) (hd : ∀ (T : ℕ), 0 ≤ d T) :
  (∃ c,
      0 < c ∧
        ∃ p,
          0 < p ∧
            ∃ T0,
              ∀ (T : ℕ), T0 ≤ T → c * ↑T ^ (-p) ≤ (ProbabilityTheory.gaussianReal 0 (↑T ^ 3)⁻¹).real (Set.Ici (d T))) ↔
    d =O[Filter.atTop] fun T => ↑T ^ (-3 / 2) * √(Real.log ↑T)
