def Junpei.SequentialRisk.MinimizesActualRisk : Junpei.Policy.StatePolicy →
  ℕ → ℕ → Draft0.BayesianModel.Counts → Draft0.BayesianModel.Means → Prop :=
fun π t H c m =>
  ∀ (s : Junpei.SequentialRisk.Family H),
    Junpei.SequentialRisk.Feasible s →
      Junpei.SequentialRisk.continuationRisk π t H c m ≤ Junpei.SequentialRisk.familyRisk s c m
def Junpei.SequentialRisk.SequentialRiskOptimal : Junpei.Policy.StatePolicy → ℕ → Prop :=
fun π T =>
  (∀ (t : ℕ) (c : Draft0.BayesianModel.Counts) (m : Draft0.BayesianModel.Means),
      4 ≤ t →
        t ≤ T →
          (∀ (a : Draft0.BayesianModel.Arm), 0 < c a) → Junpei.SequentialRisk.MinimizesActualRisk π t (T - t + 1) c m) ∧
    ∀ (c : Draft0.BayesianModel.Counts) (m : Draft0.BayesianModel.Means),
      (∀ (a : Draft0.BayesianModel.Arm), 0 < c a) → Junpei.SequentialRisk.MinimizesActualRisk π (T + 1) 0 c m
