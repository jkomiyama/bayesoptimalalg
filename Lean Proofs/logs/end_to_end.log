  (c : Draft0.BayesianModel.Counts) :
  Measurable fun p => Junpei.EmbeddingRaw.run (Junpei.PolicyContinuation.rawTree π t H c p.1 p.2.1) p.2.2
Junpei.PolicyContinuation.rawTree_regular (π : Junpei.Policy.StatePolicy) (t H : ℕ) (c : Draft0.BayesianModel.Counts)
  (m : Draft0.BayesianModel.Means) (u : Junpei.PolicyContinuation.Seeds H) :
  Junpei.EmbeddingExecution.Regular (Junpei.PolicyContinuation.rawTree π t H c m u)
Junpei.CountModelBridge.actionLoss_eq_loss_iff (k : ℕ) (c : Draft0.BayesianModel.Counts)
  (m : Draft0.BayesianModel.Means) (a : Draft0.BayesianModel.Arm) (hc : 0 < c a) :
  Junpei.FinitePosterior.actionLoss k (Junpei.CountModelBridge.natPrecisions c) m a =
      Junpei.FinitePosterior.loss (k + 1) (Junpei.CountModelBridge.natPrecisions c) m ↔
    Draft0.BayesianModel.action k c m a = Draft0.BayesianModel.value (k + 1) c m
Junpei.SequentialRisk.familyRisk_eq_joint {H : ℕ} (s : Junpei.SequentialRisk.Family H) (c : Draft0.BayesianModel.Counts)
  (m : Draft0.BayesianModel.Means) (hs : Junpei.SequentialRisk.Feasible s) :
  Junpei.SequentialRisk.familyRisk s c m =
    ∫ (p :
      Junpei.PolicyContinuation.Seeds H ×
        Junpei.FiniteGaussian.Means Draft0.BayesianModel.Arm ×
          Junpei.EmbeddingRaw.RawStream Draft0.BayesianModel.Arm H),
      Junpei.EmbeddingRandomized.randomizedPayoff s
        p ∂(Junpei.Policy.seedLaw (H + 1)).prod
        (Junpei.EmbeddingExecution.worldLaw H (Junpei.CountModelBridge.natPrecisions c) m)
Junpei.SequentialRisk.familyRisk_ge_loss {H : ℕ} (s : Junpei.SequentialRisk.Family H) (c : Draft0.BayesianModel.Counts)
  (m : Draft0.BayesianModel.Means) (hs : Junpei.SequentialRisk.Feasible s)
  (hc : ∀ (a : Draft0.BayesianModel.Arm), 0 < c a) :
  Junpei.FinitePosterior.loss H (Junpei.CountModelBridge.natPrecisions c) m ≤ Junpei.SequentialRisk.familyRisk s c m
Junpei.SequentialRisk.canonicalFamily_risk (H : ℕ) (c : Draft0.BayesianModel.Counts) (m : Draft0.BayesianModel.Means)
  (hc : ∀ (a : Draft0.BayesianModel.Arm), 0 < c a) :
  Junpei.SequentialRisk.familyRisk (Junpei.SequentialRisk.canonicalFamily H c m) c m =
    Junpei.FinitePosterior.loss H (Junpei.CountModelBridge.natPrecisions c) m
Junpei.SequentialRisk.minimizing_draw_ae (π : Junpei.Policy.StatePolicy) (t H : ℕ) (c : Draft0.BayesianModel.Counts)
  (m : Draft0.BayesianModel.Means) (hc : ∀ (a : Draft0.BayesianModel.Arm), 0 < c a)
