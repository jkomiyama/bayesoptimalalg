Junpei.SequentialRisk.minimizing_recommend_ae (π : Junpei.Policy.StatePolicy) (t : ℕ) (c : Draft0.BayesianModel.Counts)
  (m : Draft0.BayesianModel.Means) (hc : ∀ (a : Draft0.BayesianModel.Arm), 0 < c a)
